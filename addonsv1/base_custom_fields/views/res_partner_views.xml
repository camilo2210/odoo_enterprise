<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_compliance" model="ir.ui.view">
        <field name="name">res.partner.form.compliance</field>
        <field name="model">res.partner</field>
        <!-- Heredamos la vista estándar del formulario de contactos -->
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!--
                Insertamos la pestaña DESPUÉS de "Ventas y Compras".
                XPath: busca el notebook y añade una nueva página al final.
                Alternativa: usar `position="after"` sobre una página existente.
            -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Compliance y DD" name="compliance_due_diligence">

                    <group string="Consultas y Autorizaciones">
                        <group>
                            <field name="autoriza_consulta_centrales"/>
                            <field name="autoriza_reporte_centrales"/>
                        </group>
                        <group>
                            <field name="consulta_bienes_registro"/>
                            <field name="consulta_vehiculos_transito"/>
                        </group>
                    </group>

                    <group string="Due Diligence">
                        <group>
                            <!--
                                Odoo 17+ / 19: NO usar attrs="{...}"
                                Usar expresiones inline directas:
                                  - invisible="expresion_python"
                                  - required="expresion_python"
                                  - readonly="expresion_python"
                            -->
                            <field name="due_diligence"/>
                            <field
                                name="due_diligence_date"
                                required="due_diligence"
                                invisible="not due_diligence"
                                readonly="not due_diligence"
                            />
                        </group>
                    </group>

                    <!-- Botón utilitario del mixin, visible solo si DD activo -->
                    <footer invisible="not due_diligence">
                        <button
                            name="action_reset_due_diligence"
                            string="Reiniciar Due Diligence"
                            type="object"
                            class="btn-secondary"
                            confirm="¿Desea reiniciar el proceso de Due Diligence para este contacto?"
                        />
                    </footer>

                </page>
            </xpath>

        </field>
    </record>
</odoo>

