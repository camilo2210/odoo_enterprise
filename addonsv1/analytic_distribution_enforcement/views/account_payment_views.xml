<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- account.payment — Payment form                                -->
    <!-- Add analytic_distribution widget to the payment form          -->
    <!-- ============================================================ -->
    <record id="view_account_payment_form_analytic" model="ir.ui.view">
        <field name="name">account.payment.form.analytic.enforcement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Add analytic_distribution after the journal_id
                 field in the payment form -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       required="1"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- account.payment — Payment list view                           -->
    <!-- Add analytic_distribution as optional column                   -->
    <!-- ============================================================ -->
    <record id="view_account_payment_tree_analytic" model="ir.ui.view">
        <field name="name">account.payment.list.analytic.enforcement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount']" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>
