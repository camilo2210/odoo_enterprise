<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- account.move — Invoice / Bill / Journal Entry form            -->
    <!-- Ensure analytic_distribution is visible on journal items tab  -->
    <!-- ============================================================ -->
    <record id="view_move_form_analytic_enforcement" model="ir.ui.view">
        <field name="name">account.move.form.analytic.enforcement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Make analytic_distribution visible by default on
                 the invoice lines list (optional → show) -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']"
                   position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

        </field>
    </record>

</odoo>
