<odoo>
    <record id="voip_call_view_form_inherit" model="ir.ui.view">
        <field name="name">voip.call.form.inherit</field>
        <field name="model">voip.call</field>
        <field name="inherit_id" ref="voip.voip_call_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" groups="sales_team.group_sale_salesman" type="object" name="action_open_subscription" icon="refresh" invisible="not partner_id">
                    <field string="Subscriptions" name="commercial_partner_subscription_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='activity_res_model']" position="after">
                <field name="is_related_activity_document_subscription" invisible="True"/> <!-- for many2one_reference_icon -->
            </xpath>
        </field>
    </record>

    <record id="voip_call_view_list_inherit" model="ir.ui.view">
        <field name="name">voip.call.list.inherit</field>
        <field name="model">voip.call</field>
        <field name="inherit_id" ref="voip.voip_call_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_res_model']" position="after">
                <field name="is_related_activity_document_subscription" column_invisible="True"/> <!-- for many2one_reference_icon -->
            </xpath>
        </field>
    </record>
</odoo>
