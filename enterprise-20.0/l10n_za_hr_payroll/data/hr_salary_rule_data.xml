    <record id="l10n_za_regular_pay_overtime_work_days" model="hr.salary.rule">
        <field name="name">Overtime - Work Days</field>
        <field name="category_ids" eval="[Command.set([ref('hr_payroll.ALW')])]"/>
        <field name="code">OVERTIME</field>
        <field name="sequence">20</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = '040.00' in worked_days</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
overtime_rate = worked_days['040.00'].work_entry_type_id.amount_rate or 1.0
result_qty = worked_days['040.00'].number_of_hours
result_rate = overtime_rate * 100
result = 0
if overtime_rate and result_qty:
    result = worked_days['040.00'].amount / (overtime_rate * result_qty)
        </field>
        <field name="struct_ids" eval="[Command.set([ref('l10n_za_hr_payroll.hr_payroll_structure_za_employee_salary')])]"/>
        <field name="appears_on_payslip">non_zero</field>
        <field name="country_id" ref="base.za"/>
    </record>

