    <!-- INCOME TAX -->

    <record id="l10n_za_employee_salary_income_tax" model="hr.salary.rule">
        <field name="category_ids" eval="[Command.set([ref('hr_payroll.DED')])]"/>
        <field name="name">Income Tax</field>
        <field name="code">INCOME_TAX</field>
        <field name="sequence">120</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="amount_python_compute">
if not employee.birthday:
    raise UserError(_("Employee %s has no birthday set. Birthday is required to compute income tax.") % employee.name)
annual_taxable = result_rules['GROSS_TAXABLE']['total'] * 12
reference_date = payslip.date_to
birthday = employee.birthday
age = reference_date.year - birthday.year - (
    (reference_date.month, reference_date.day) &lt; (birthday.month, birthday.day)
)
income_tax_thresholds = payslip._rule_parameter('l10n_za_income_tax_thresholds')
threshold = 0
for max_age, value in income_tax_thresholds:
    if max_age == 'inf' or age &lt; max_age:
        threshold = value
        break
if annual_taxable &lt;= threshold:
    result = 0
else:
    income_tax_breakdown = payslip._rule_parameter('l10n_za_income_tax_breakdown')
    lower_limit = 0
    for upper_limit, base_tax, rate in income_tax_breakdown:
        if upper_limit == 'inf' or annual_taxable &lt;= float(upper_limit):
            annual_tax = base_tax + (annual_taxable - lower_limit) * rate
            result = annual_tax / 12
            break
        lower_limit = float(upper_limit)
        </field>
        <field name="struct_ids" eval="[Command.set([ref('l10n_za_hr_payroll.hr_payroll_structure_za_employee_salary')])]"/>
        <field name="country_id" ref="base.za"/>
    </record>

    <!-- TAX REBATES -->

    <record id="l10n_za_employee_salary_income_tax_rebate" model="hr.salary.rule">
        <field name="category_ids" eval="[Command.set([ref('l10n_za_hr_payroll.ZA_TAX_REBATE')])]"/>
        <field name="name">Income Tax Rebate</field>
        <field name="code">INCOME_TAX_REBATE</field>
        <field name="sequence">130</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="amount_python_compute">
if not employee.birthday:
    raise UserError(_("Employee %s has no birthday set. Birthday is required to compute the income tax rebate.") % employee.name)
reference_date = payslip.date_to
birthday = employee.birthday
age = reference_date.year - birthday.year - (
    (reference_date.month, reference_date.day) &lt;
    (birthday.month, birthday.day)
)
rebates = payslip._rule_parameter('l10n_za_income_tax_rebates')
rebate = 0
for minimum_age, amount in rebates:
    if age &gt;= minimum_age:
        rebate += amount
result = rebate / 12
        </field>
        <field name="struct_ids" eval="[Command.set([ref('l10n_za_hr_payroll.hr_payroll_structure_za_employee_salary')])]"/>
        <field name="country_id" ref="base.za"/>
    </record>

    <record id="l10n_za_employee_salary_medical_tax_credit" model="hr.salary.rule">
        <field name="category_ids" eval="[Command.set([ref('l10n_za_hr_payroll.ZA_TAX_REBATE')])]"/>
        <field name="name">Medical Scheme Fees Tax Credit</field>
        <field name="code">MEDICAL_TAX_CREDIT</field>
        <field name="sequence">131</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = (
    version.l10n_za_employee_medical_scheme_contribution
    + version.l10n_za_dependant_medical_scheme_contribution
    * version.l10n_za_employee_dependant_count
    ) &gt; 0
</field>
        <field name="amount_select">code</field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="amount_python_compute">
first_member_credit, second_member_credit, additional_member_credit = payslip._rule_parameter(
    'l10n_za_medical_tax_credit'
)
dependants = version.l10n_za_employee_dependant_count or 0
total_members = dependants + 1
if total_members == 1:
    result = first_member_credit
elif total_members == 2:
    result = first_member_credit + second_member_credit
elif total_members &gt; 2:
    result = first_member_credit + second_member_credit + (total_members - 2) * additional_member_credit
else:
    result = 0
        </field>
        <field name="struct_ids" eval="[Command.set([ref('l10n_za_hr_payroll.hr_payroll_structure_za_employee_salary')])]"/>
        <field name="country_id" ref="base.za"/>
    </record>

