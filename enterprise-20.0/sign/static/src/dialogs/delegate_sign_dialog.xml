<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.DelegateSignDialog">
        <Dialog t-props="this.dialogProps">
            <t t-set-slot="header">
                <h4 class="modal-title text-break text-center">
                    Delegate
                </h4>
                <button class="btn btn-close shadow-none float-end" t-on-click="this.props.close"/>
            </t>
            <div class="model-body">
                <div class="mb-3 row">
                    <label for="o_sign_delegate_signer_name_input" class="col-lg-1 col-form-label">
                        Name
                    </label>
                    <div class="col-lg-11">
                        <input type="text" t-ref="this.nameRef" id="o_sign_delegate_signer_name_input" class="form-control o_formview_input"/>
                    </div>
                </div>
                <div class="mb-3 row">
                    <label for="o_sign_delegate_signer_mail_input" class="col-lg-1 col-form-label">
                        Email
                    </label>
                    <div class="col-lg-11">
                        <input type="email" t-ref="this.mailRef" id="o_sign_delegate_signer_mail_input" class="form-control o_formview_input"/>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.submit">
                    Delegate
                </button>
                <button class="btn btn-secondary" t-on-click="this.props.close">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="sign.DelegateSignSuccessDialog">
        <Dialog t-props="this.dialogProps">
            <t t-set-slot="header">
                <h4 class="modal-title text-break text-center">
                    Done!
                </h4>
                <button class="btn btn-close shadow-none float-end" t-on-click="this.onClickClose"/>
            </t>
            <div class="d-flex flex-column align-items-center gap-4 mb-3">
                <i class="oi oi-2x p-2 rounded-circle text-success bg-success-subtle" data-icon="check" role="img"/>
                <div class="o_thankyou_message text-center">
                    The person you have delegated your signature to has been notified by email.
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onClickClose">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
