<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sign.Many2XBinarySignRequest">
        <FileInput
            acceptedFileExtensions="this.props.acceptedFileExtensions"
            multiUpload="this.props.multiUpload"
            onUpload.bind="this.props.onFileUploaded"
            resModel="this.props.record.resModel"
            resId="this.props.record.resId or 0"
        >
            <button class="btn btn-light w-auto" data-tooltip="Add Attachment" data-hotkey="u">
                <span class="oi" data-icon="attach_file" aria-label="Attach"/>
            </button>
        </FileInput>
    </t>

</templates>
