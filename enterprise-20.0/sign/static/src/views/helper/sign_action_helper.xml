<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.SignActionHelper">
        <div class="o_view_nocontent">
            <div class="o_nocontent_help">
                <p class="o_view_nocontent_sign">
                    <div t-if="this.props.resModel === 'sign.template'">Create a template </div>
                    <div t-else="">Request a signature</div>
                    <span class="fs-4 text-muted mobile-hide">
                        Drag &amp; drop <span class="fw-normal">or </span>
                        <span class="btn btn-link p-0 pb-1 fs-4" t-on-click="() => this.onClickUpload('sign_send_request')">
                            Upload
                        </span> <span class="fw-normal">a file </span>
                    </span>
                </p>
                <button class="btn btn-primary o_sign_sample" t-on-click="this.onClickSampleSign">
                    <t t-if="this.props.resModel === 'sign.request'">Try a sample document</t>
                    <t t-else="">Try a sample template</t>
                </button>
            </div>
            <input
                t-ref="this.signButtons.uploadFileInputRef"
                type="file"
                multiple="true"
                accept="application/pdf, application/x-pdf, application/vnd.cups-pdf"
                class="o_sign_template_file_input o_input_file o_hidden mobile-hide"
            />
        </div>
    </t>
</templates>
