<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignViews.buttons">
        <input
            type="file"
            multiple="true"
            t-ref="this.signButtons.uploadFileInputRef"
            accept="application/pdf, application/x-pdf, application/vnd.cups-pdf"
            class="o_sign_template_file_input o_input_file o_hidden"
        />
        <t t-if="(this.props.resModel === 'sign.template') or (this.props.resModel === 'sign.request' and this.props.context.show_upload_button)" t-call="sign.SignViews.sign_upload_pdf.buttons"/>
        <t t-if="this.props.signTemplateId" t-call="sign.SignViews.sign_bundle.buttons"/>
    </t>

    <t t-name="sign.SignViews.sign_upload_pdf.buttons">
        <button class="btn btn-primary"
                title="Upload new PDF"
                t-on-click="() => this.signButtons.requestFile('sign_send_request')"
                data-hotkey="i">
            Upload PDF
        </button>
    </t>

    <t t-name="sign.SignViews.sign_bundle.buttons">
        <button class="btn btn-link"
                title="Upload documents"
                t-on-click="() => this.signButtons.requestFile('sign_send_request')"
                data-hotkey="i">
            Add
        </button>
    </t>
</templates>
