<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.KanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="class" add="o_sign_view" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <div t-if="this.dragState.showDragZone" class="o_dropzone">
                <i class="oi oi-10x" data-icon="upload"/>
            </div>
        </xpath>
        <ActionHelper position="replace">
            <t t-if="this.showNoContentHelper">
                <SignActionHelper resModel="this.props.list.resModel"/>
            </t>
        </ActionHelper>
    </t>
</templates>
