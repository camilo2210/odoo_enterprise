<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.TemplateAlertDialog">
        <Dialog size="'md'" title="this.props.title" contentClass="this.props.contentClass">
            <p>The uploaded files cannot be read, they may be corrupted or encrypted.</p>
            <p t-out="this.props.body"/>
            <t t-set-slot="footer">
              <button class="btn btn-primary" t-on-click="this._confirm" t-out="this.props.confirmLabel"/>
            </t>
        </Dialog>
    </t>
</templates>
