<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Signer name display is shared between desktop and mobile signer row -->
    <t t-name="sign.SignTemplateSidebarRoleItems.NameEditor">
        <div t-attf-class="{{ (this.props.hasSignRequests || this.props.isCollapsed || !this.state.canEditSignerName) ? 'd-none' : 'o_sign_sidebar_signer_header' }} d-flex flex-grow-1">
            <div class="o_sign_sidebar_role_input_container w-100 mx-1">
                <input type="text"
                    t-att-data-role-id="this.props.roleId"
                    t-att-value="this.state.roleName"
                    t-attf-class="o_input form-control bg-transparent rounded-0 pe-1"
                    t-on-change="ev => this.onChangeRoleName(ev.target.value)"
                    t-on-blur="this.onSignerNameInputBlur"
                    t-on-keyup="ev => this.props.onFieldNameInputKeyUp(ev)"
                    t-ref="this.roleInputRef"
                />
            </div>
        </div>
        <span
            t-attf-class="{{ (this.props.hasSignRequests || this.props.isCollapsed || !this.state.canEditSignerName) ? '' : 'd-none' }} o_sign_sidebar_signer_name d-flex align-items-center gap-2"
            t-att-data-role-id="this.props.roleId"
        >
            <span t-att-title="this.state.roleName" class="mx-1">
                <t t-out="this.state.roleName"/>
            </span>
        </span>
    </t>

    <!-- Rename pencil, avatar and items-count badge are shared between desktop and mobile signer row. -->
    <t t-name="sign.SignTemplateSidebarRoleItems.AvatarBadge">
        <div class="o_sign_item_container">
            <i
                t-if="!this.props.hasSignRequests &amp; !this.props.isCollapsed"
                class="oi oi-filled me-2"
                data-icon="edit"
                t-on-click="this.onSignerNameTextClick"
            />
            <img
                t-att-src="this.state.profilePic"
                alt="User"
                class="o_sign_profile_pic"
                t-if="this.state.profilePic"
            />
            <div t-attf-class="{{ 'o_color_responsible_' + this.props.colorId}} o_sign_item_count">
                <t t-out="this.props.itemsCount" />
            </div>
        </div>
    </t>

    <!-- Signer actions dropdown is shared between desktop and mobile signer row. -->
    <t t-name="sign.SignTemplateSidebarRoleItems.Dropdown">
        <t t-if="!this.props.hasSignRequests">
            <div>
                <Dropdown>
                    <button class="btn o_sign_sidebar_icon">
                        <i class="oi" data-icon="more_vert"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem onSelected="() => this.openSignRoleRecord()">
                            <i class="oi oi-filled oi-fw" data-icon="edit"/>
                            Edit
                        </DropdownItem>
                        <t t-if="this.props.hasMultipleSigners">
                            <DropdownItem onSelected="() => this.props.onMoveUp()">
                                <i class="oi oi-fw" data-icon="arrow_upward"/>
                                Move Up
                            </DropdownItem>
                            <DropdownItem onSelected="() => this.props.onMoveDown()">
                                <i class="oi oi-fw" data-icon="arrow_downward"/>
                                Move Down
                            </DropdownItem>
                        </t>
                        <DropdownItem onSelected="() => this.onDeleteDialog()">
                            <span class="text-danger">
                                <i class="oi oi-fw" data-icon="delete"/>
                                Delete
                            </span>

                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </t>
    </t>

    <t t-name="sign.SignTemplateSidebarRoleItems">
        <div t-attf-class="o_sign_sidebar_signer {{ this.props.isCollapsed || this.props.hasSignRequests ? '' : 'o_sign_sidebar_signer_selected' }}" t-on-click="() => this.onExpandSigner(this.props.id)">
            <div class="o_sign_sidebar_signer_header">
                <t t-call="sign.SignTemplateSidebarRoleItems.NameEditor"/>
                <t t-call="sign.SignTemplateSidebarRoleItems.AvatarBadge"/>
                <t t-call="sign.SignTemplateSidebarRoleItems.Dropdown"/>
            </div>
            <div t-attf-class="o_sign_sidebar_signer_content {{ this.props.isCollapsed || this.props.hasSignRequests? 'd-none' : ''}}">
                <!-- Sign items for the selected role. -->
                <div t-attf-class="o_sign_field_type_toolbar_items mt-1">
                    <div class="o_sign_sidebar_item_grid">
                        <t t-foreach="this.state.signItemTypes" t-as="itemType" t-key="itemType.id">
                            <button
                                type="button"
                                class="o_sign_field_type_button btn btn-secondary border-0 small text-break"
                                t-attf-class="{{ 'o_color_responsible_' + this.props.colorId }}"
                                t-att-data-color-id="this.props.colorId"
                                t-att-data-role-id="this.props.roleId"
                                t-att-data-item-type-id="itemType.id"
                                t-att-data-signer-id="this.props.id"
                                t-att-data-role-name="this.state.roleName"
                                title="Drag and Drop a field in the PDF">
                                <span class="o_sign_field_type_button_content d-flex align-items-center justify-content-start gap-1">
                                    <i
                                        class="oi oi-fw me-2"
                                        t-att-class="{'oi-filled': itemType.icon === 'calendar_today' || this.icon_type[itemType.item_type] === 'calendar_today'}"
                                        t-attf-data-icon="#{itemType.icon ? itemType.icon : this.icon_type[itemType.item_type]}"
                                        role="img"/>
                                    <span class="text-start"><t t-out="itemType.name"/></span>
                                </span>
                            </button>
                        </t>
                        <!-- 'Add Field' button: shown for administrators for adding fields in-place. -->
                        <t t-if="this.state.isAdmin">
                            <button
                                type="button"
                                class="btn btn-secondary border-0 small text-break"
                                title="Click to add a new custom field"
                                t-attf-class="{{ 'o_color_responsible_' + this.props.colorId }}"
                                t-att-data-color-id="this.props.colorId"
                                t-on-click="this.onAddCustomField">
                                <span class="d-flex align-items-center justify-content-start gap-1">
                                    <i class="oi oi-fw me-2" data-icon="add" role="img"/>
                                    <span class="text-start">Add Field</span>
                                </span>
                            </button>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
