<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignTemplateControlPanel">
        <ControlPanel display="this.controlPanelDisplay">
            <t t-set-slot="control-panel-buttons">
                <button t-if="['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-primary o_sign_template_send" t-on-click="this.onSendClick" data-hotkey="w">Send</button>
                <button t-if="['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-primary o_sign_template_sign_now text-nowrap" t-on-click="this.onSignNowClick" data-hotkey="q">Sign Now</button>
                <button t-if="this.showShareButton and ['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-secondary o_sign_template_share" t-on-click="this.onShareClick" data-hotkey="a">Share</button>
                <button t-if="this.props.actionType === 'sign_template_edit'" type="button" class="btn btn-primary o_sign_template_save" t-on-click="this.props.goBackToKanban" data-hotkey="s">Save</button>
                <button t-if="this.nextTemplate and this.props.actionType === 'sign_template_edit'" type="button" class="btn btn-primary o_sign_template_next" t-on-click="this.onNextDocumentClick" data-hotkey="n">
                    Next Document
                </button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <SignTemplateCustomCogMenu t-props="this.customCogMenuProps"/>
                <SignStatusIndicator 
                    isDirty="this.props.signStatus.isTemplateChanged"
                    save="() => this.props.signStatus.save()"
                    discard="() => this.props.signStatus.discardChanges()"
                />
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <t t-if="this.templateHeaderTagsProps">
                    <div class="me-4"> 
                        <SignHeaderTags t-props="this.templateHeaderTagsProps"/>
                    </div>                
                </t>
            </t>
        </ControlPanel>
    </t>
</templates>
