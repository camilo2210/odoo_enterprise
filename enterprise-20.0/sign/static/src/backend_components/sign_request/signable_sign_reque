<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.SignSignableRequestControlPanel" t-inherit="sign.SignRequestControlPanel">
        <xpath expr="//div[hasclass('signer-status')]" position="after">
            <div class="dropdown d-flex align-items-center justify-content-center">
                <button
                    class="btn btn-primary dropdown-toggle btn-sm"
                    data-bs-toggle="dropdown"
                    aria-label="Dropdown menu"
                    title="Dropdown menu"
                >
                    Options
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item o_sign_refuse_document_button" t-on-click="this.refuseDocument" href="#">Decline to sign</a></li>
                    <li t-if="this.signInfo.get('showDelegateButton')"><a class="dropdown-item" t-on-click="this.delegateDocument" href="#">Delegate</a></li>
                    <li><a class="dropdown-item" t-on-click="this.downloadDocument" href="#">Download</a></li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//DropdownItem[@onSelected.bind='this.cancelDocument']" position="after">
            <DropdownItem class="'o_menu_item'" onSelected.bind="this.downloadDocument">
                Download PDF
            </DropdownItem>
        </xpath>
    </t>
</templates>
