<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_alert_sign" model="portal.entry">
        <field name="name">Document(s) to sign</field>
        <field name="url">/my/signatures?filterby=tosign</field>
        <field name="placeholder_count">to_sign_count</field>
        <field name="category">alert</field>
    </record>

    <record id="portal_client_sign" model="portal.entry">
        <field name="name">Signature requests</field>
        <field name="description">Access your signed documents</field>
        <field name="url">/my/signatures</field>
        <field name="image" type="bytes" file="sign/static/img/sign_template.svg"/>
        <field name="placeholder_count">sign_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="30"/>
    </record>
</odoo>
