<?xml version="1.0"?>
<odoo>
    <record id="uom_uom_view_form" model="ir.ui.view">
        <field name="name">uom.uom.view.form.inherit.l10n.pe.edi</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="l10n_pe_edi_measure_unit_code" invisible="'PE' not in fiscal_country_codes"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
