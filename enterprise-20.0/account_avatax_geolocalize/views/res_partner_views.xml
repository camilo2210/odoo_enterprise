<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='geo_localize'][@icon='refresh']" position="before">
                <field name="is_avatax_valid" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='geo_localize'][@icon='refresh']" position="attributes">
                <attribute name="invisible">is_avatax_valid or (partner_latitude == 0 and partner_longitude == 0)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
