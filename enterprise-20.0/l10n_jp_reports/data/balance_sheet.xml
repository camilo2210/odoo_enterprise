<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_financial_report_jp_bs" model="account.report">
        <field name="name">Balance Sheet</field>
        <field name="name@ja_JP">貸借対照表</field>
        <field name="root_report_id" ref="account_reports.balance_sheet"/>
        <field name="groupby">account_id</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_hierarchy">by_default</field>
        <field name="country_id" ref="base.jp"/>
        <field name="filter_multi_company">selector</field>
        <field name="custom_handler_model_id" ref="account_reports.model_account_balance_sheet_report_handler"/>
        <field name="column_ids">
            <record id="account_financial_report_jp_bs_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="name@ja_JP">残高</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_financial_report_jp_bs_jp_assets" model="account.report.line">
                <field name="name">Assets</field>
                <field name="name@ja_JP">資産</field>
                <field name="code">JP_ASSETS</field>
                <field name="hierarchy_level">0</field>
                <field name="foldability">never_unfolded</field>
                <field name="expression_ids">
                    <record id="account_financial_report_jp_bs_jp_assets_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">JP_CURRENT_ASSETS.balance + JP_FIXED_ASSETS.balance + JP_DEFERRED_ASSETS.balance</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_financial_report_jp_bs_jp_current_assets" model="account.report.line">
                        <field name="name">Current Assets</field>
                        <field name="name@ja_JP">流動資産</field>
                        <field name="code">JP_CURRENT_ASSETS</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_jp_bs_jp_current_assets_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', 'in', ['asset_current', 'asset_prepayments', 'asset_cash', 'asset_receivable'])]"/>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_jp_bs_jp_fixed_assets" model="account.report.line">
                        <field name="name">Fixed Assets</field>
                        <field name="name@ja_JP">固定資産</field>
                        <field name="code">JP_FIXED_ASSETS</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">never_unfolded</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_jp_bs_jp_fixed_assets_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">JP_TANGIBLE_FIXED_ASSETS.balance + JP_INTANGIBLE_FIXED_ASSETS.balance + JP_INVESTMENT_AND_OTHER_ASSETS.balance</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="account_financial_report_jp_bs_jp_tangible_fixed_assets" model="account.report.line">
                                <field name="name">Tangible Fixed Assets</field>
                                <field name="name@ja_JP">有形固定資産</field>
                                <field name="code">JP_TANGIBLE_FIXED_ASSETS</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_tangible_fixed_assets_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'asset_fixed')]"/>
                                        <field name="subformula">sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_jp_bs_jp_intangible_fixed_assets" model="account.report.line">
                                <field name="name">Intangible Fixed Assets</field>
                                <field name="name@ja_JP">無形固定資産</field>
                                <field name="code">JP_INTANGIBLE_FIXED_ASSETS</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_intangible_fixed_assets_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'asset_non_current'), ('account_id.tag_ids', 'not in', [ref('l10n_jp.account_tag_investment_and_other_assets'), ref('l10n_jp.account_tag_deferred_assets')])]"/>
                                        <field name="subformula">sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_jp_bs_jp_investment_and_other_assets" model="account.report.line">
                                <field name="name">Investment and Other Assets</field>
                                <field name="name@ja_JP">投資その他の資産</field>
                                <field name="code">JP_INVESTMENT_AND_OTHER_ASSETS</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_investment_and_other_assets_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'asset_non_current'), ('account_id.tag_ids', 'in', [ref('l10n_jp.account_tag_investment_and_other_assets')])]"/>
                                        <field name="subformula">sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_jp_bs_jp_deferred_assets" model="account.report.line">
                        <field name="name">Deferred Assets</field>
                        <field name="name@ja_JP">繰延資産</field>
                        <field name="code">JP_DEFERRED_ASSETS</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="hide_if_zero" eval="True"/>
                        <field name="expression_ids">
                            <record id="account_financial_report_jp_bs_jp_deferred_assets_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'asset_non_current'), ('account_id.tag_ids', 'in', [ref('l10n_jp.account_tag_deferred_assets')])]"/>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_financial_report_jp_bs_jp_liabilities_and_equity" model="account.report.line">
                <field name="name">Total Liabilities and Equity</field>
                <field name="name@ja_JP">負債及び純資産合計</field>
                <field name="code">JP_LIABILITIES_AND_EQUITY</field>
                <field name="hierarchy_level">0</field>
                <field name="foldability">never_unfolded</field>
                <field name="expression_ids">
                    <record id="account_financial_report_jp_bs_jp_liabilities_and_equity_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">JP_LIABILITIES.balance + JP_NET_WORTH.balance</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_financial_report_jp_bs_jp_liabilities" model="account.report.line">
                        <field name="name">Liabilities</field>
                        <field name="name@ja_JP">負債</field>
                        <field name="code">JP_LIABILITIES</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">never_unfolded</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_jp_bs_jp_liabilities_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">JP_CURRENT_LIABILITIES.balance + JP_NON_CURRENT_LIABILITIES.balance</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="account_financial_report_jp_bs_jp_current_liabilities" model="account.report.line">
                                <field name="name">Current Liabilities</field>
                                <field name="name@ja_JP">流動負債</field>
                                <field name="code">JP_CURRENT_LIABILITIES</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_current_liabilities_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', 'in', ['liability_payable', 'liability_credit_card', 'liability_current'])]"/>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_jp_bs_jp_non_current_liabilities" model="account.report.line">
                                <field name="name">Non Current Liabilities</field>
                                <field name="name@ja_JP">固定負債</field>
                                <field name="code">JP_NON_CURRENT_LIABILITIES</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_non_current_liabilities_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'liability_non_current')]"/>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_jp_bs_jp_net_worth" model="account.report.line">
                        <field name="name">Net Worth</field>
                        <field name="name@ja_JP">純資産</field>
                        <field name="code">JP_NET_WORTH</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">never_unfolded</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_jp_bs_jp_net_worth_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">JP_EQUITY.balance + JP_UNALLOCATED_EARNINGS.balance</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="account_financial_report_jp_bs_jp_equity" model="account.report.line">
                                <field name="name">Shareholders' Equity</field>
                                <field name="name@ja_JP">株主資本</field>
                                <field name="code">JP_EQUITY</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_equity_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'equity')]"/>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_jp_bs_jp_unallocated_earnings" model="account.report.line">
                                <field name="name">Unallocated Earnings</field>
                                <field name="name@ja_JP">未処分利益</field>
                                <field name="code">JP_UNALLOCATED_EARNINGS</field>
                                <field name="hierarchy_level">2</field>
                                <field name="foldability">always_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_jp_bs_jp_unallocated_earnings_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">aggregation</field>
                                        <field name="formula">JP_UNALLOCATED_EARNINGS_CURRENT_YEAR.balance + JP_UNALLOCATED_EARNINGS_PREVIOUS_YEARS.balance</field>
                                    </record>
                                </field>
                                <field name="children_ids">
                                    <record id="account_financial_report_jp_bs_jp_unallocated_earnings_current_year" model="account.report.line">
                                        <field name="name">Current Year Unallocated Earnings</field>
                                        <field name="name@ja_JP">当期未処分利益(当期未処理損失)</field>
                                        <field name="code">JP_UNALLOCATED_EARNINGS_CURRENT_YEAR</field>
                                        <field name="hierarchy_level">3</field>
                                        <field name="foldability">always_unfolded</field>
                                        <field name="expression_ids">
                                            <record id="account_financial_report_jp_bs_jp_unallocated_earnings_current_year_balance" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">domain</field>
                                                <field name="formula" eval="[('account_id.account_type', 'in', ['income', 'income_other', 'expense_direct_cost', 'expense', 'expense_depreciation', 'expense_other', 'equity_unaffected'])]"/>
                                                <field name="subformula">-sum</field>
                                                <field name="date_scope">from_fiscalyear</field>
                                            </record>
                                        </field>
                                    </record>
                                    <record id="account_financial_report_jp_bs_jp_unallocated_earnings_previous_years" model="account.report.line">
                                        <field name="name">Previous Years Unallocated Earnings</field>
                                        <field name="name@ja_JP">前期繰越未処分利益(前期繰越未処理損失)</field>
                                        <field name="code">JP_UNALLOCATED_EARNINGS_PREVIOUS_YEARS</field>
                                        <field name="hierarchy_level">3</field>
                                        <field name="foldability">always_unfolded</field>
                                        <field name="hide_if_zero" eval="True"/>
                                        <field name="expression_ids">
                                            <record id="account_financial_report_jp_bs_jp_unallocated_earnings_previous_years_balance" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">domain</field>
                                                <field name="formula" eval="[('account_id.account_type', 'in', ['income', 'income_other', 'expense_direct_cost', 'expense', 'expense_depreciation', 'expense_other', 'equity_unaffected'])]"/>
                                                <field name="subformula">-sum</field>
                                                <field name="date_scope">to_beginning_of_fiscalyear</field>
                                            </record>
                                        </field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
