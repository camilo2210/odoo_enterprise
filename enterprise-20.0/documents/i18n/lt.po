#. module: documents
#: model:mail.template,body_html:documents.mail_template_document_share
msgid ""
"<t>\n"
"<t t-set=\"documents\" t-value=\"ctx.get('documents', "
"object.env['documents.document'])\"/>\n"
"<t t-set=\"access_urls_by_partner\" t-"
"value=\"ctx.get('access_urls_by_partner', {})\"/>\n"
"<t t-set=\"access_urls\" t-value=\"access_urls_by_partner.get(object) or {}"
"\"/>\n"
"Hello <t t-out=\"object.name\"/>,\n"
"<br/><br/>\n"
"<t t-if=\"len(documents) &lt;= 1\">\n"
"    <t t-if=\"documents.type == 'folder'\" t-set=\"share_message\">shared "
"the following folder with you</t>\n"
"    <t t-else=\"\" t-set=\"share_message\">shared the following document "
"with you</t>\n"
"</t>\n"
"<t t-elif=\"len(documents) &gt; 1\">\n"
"    <t t-set=\"document_types\" t-value=\"set(documents.mapped('type'))\"/>\n"
"    <t t-if=\"document_types == {'folder'}\" t-set=\"share_message\">shared "
"the following folders with you</t>\n"
"    <t t-elif=\"'folder' not in document_types\" t-"
"set=\"share_message\">shared the following documents with you</t>\n"
"    <t t-else=\"\" t-set=\"share_message\">shared the following documents/"
"folders with you</t>\n"
"</t>\n"
"<t t-out=\"user.name or ''\">OdooBot</t> (<t t-out=\"user.email or "
"''\">odoobot@example.com</t>) <t t-out=\"share_message\"/>:\n"
"<br/><br/>\n"
"<center t-if=\"len(documents) &lt;= 1\">\n"
"    <div t-if=\"len(documents) == 1\">\n"
"        <b t-out=\"documents.name\"/>\n"
"    </div>\n"
"    <div t-if=\"ctx.get('message')\">\n"
"        <i t-out=\"ctx['message']\"/>\n"
"    </div>\n"
"    <br/>\n"
"    <div style=\"margin: 16px 0px 16px 0px;\">\n"
"        <a t-att-href=\"access_urls.get(documents)\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 20px 30px 20px 30px; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"            <b>Get your files</b>\n"
"        </a>\n"
"    </div>\n"
"</center>\n"
"<t t-elif=\"len(documents) &gt; 1\">\n"
"    <div t-if=\"ctx.get('message')\">\n"
"        <i t-out=\"ctx['message']\"/>\n"
"    </div>\n"
"    <ul>\n"
"        <li t-foreach=\"documents\" t-as=\"document\">\n"
"            <a t-att-href=\"access_urls.get(document)\" t-attf-"
"style=\"color: {{user.company_id.email_secondary_color or '#875A7B'}}; font-"
"size:13px;\">\n"
"                <b>Get <t t-out=\"document.name\"/></b>\n"
"            </a>\n"
"        </li>\n"
"    </ul>\n"
"</t>\n"
"\n"
"<br/>\n"
"<t t-if=\"user and user.signature\">\n"
"    <br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature\"/></div>\n"
"    <br data-o-mail-quote=\"1\"/>\n"
"</t>\n"
"            </t>"
msgstr ""

#. module: documents
#: model:mail.template,body_html:documents.mail_template_document_request
msgid ""
"<t>\n"
"Hello <t t-out=\"object.requestee_partner_id.name or ''\">OdooBot</t>,\n"
"<br/><br/>\n"
"<t t-out=\"object.create_uid.name or ''\">OdooBot</t> (<t t-"
"out=\"object.create_uid.email or ''\">odoobot@example.com</t>) asks you to "
"provide the following document:\n"
"<br/><br/>\n"
"<center>\n"
"    <div>\n"
"        <t t-if=\"object.name\">\n"
"            <b t-out=\"object.name or ''\">Inbox Financial</b>\n"
"        </t>\n"
"    </div>\n"
"    <div>\n"
"        <t t-if=\"object.request_activity_id.note\">\n"
"            <i t-out=\"object.request_activity_id.note or ''\">Example of a "
"note.</i>\n"
"        </t>\n"
"    </div>\n"
"    <br/>\n"
"    <div style=\"margin: 16px 0px 16px 0px;\">\n"
"        <a t-att-href=\"object.access_url\" t-attf-style=\"background-color: "
"{{user.company_id.email_secondary_color or '#875A7B'}}; padding: 20px 30px "
"20px 30px; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"            Upload the requested document\n"
"        </a>\n"
"    </div>\n"
"</center><br/>\n"
"Please provide us with the missing document before <t t-"
"out=\"object.request_activity_id.date_deadline\">2021-05-17</t>.\n"
"<t t-if=\"user and user.signature\">\n"
"    <br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    <br data-o-mail-quote=\"1\"/>\n"
"</t>\n"
"            </t>"
msgstr ""

