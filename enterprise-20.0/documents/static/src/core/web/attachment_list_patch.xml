<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Attachment-unlink')]" position="after">
            <button t-if="this.documentService.canAddAttachmentToDocuments(attachment)"
                class="btn btn-secondary"
                t-att-class="{ 'bg-action': !!attachment.linked_document_id }"
                t-att-title="attachment.documentHelperText" t-on-click.stop="(ev) => this.documentService.onClickAddAttachmentToDocuments(attachment, ev)">
                <i class="oi oi-filled fw-bolder" t-att-data-icon="attachment.documentIcon" role="img" t-att-aria-label="attachment.documentHelperText"/>
            </button>
        </xpath>
    </t>
</templates>
