<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="documents.FolderAction">
        <DropdownItem onSelected.bind="this.onItemSelected">
            <i class="oi oi-fw me-1" t-att-class="this.iconClass" t-att-data-icon="this.icon" aria-hidden="true"></i><t t-out="this.label"/>
        </DropdownItem>
    </t>
</templates>
