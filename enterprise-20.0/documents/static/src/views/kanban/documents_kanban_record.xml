<?xml version="1.0"?>
<templates>
<t t-name="documents.DocumentsKanbanRecord">
    <div
        role="article"
        tabindex="0"
        t-att-class="this.getCardClasses()"
        t-att-data-id="this.props.record.id"
        t-att-data-value-id="this.props.record.data.id"
        t-on-click.synthetic="this.onGlobalClick"
        t-on-touchstart="this.onTouchStart"
        t-on-touchmove="this.onTouchMoveOrCancel"
        t-on-touchcancel="this.onTouchMoveOrCancel"
        t-on-touchend="this.onTouchEnd"
        t-on-contextmenu.prevent.stop="this.onContextMenu"
        t-ref="this.rootRef"
    >
        <span t-if="this.props.selectionAvailable" class="o_record_selection_tooltip d-none position-absolute p-2 rounded-3 start-50 top-50">Click to select</span>
        <t t-call="{{ this.templates[this.constructor.CARD_ATTRIBUTE] }}" t-call-context="this.renderingContext"/>
    </div>
</t>
</templates>
