<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ErrorDialog" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='footer']//button" position="after">
            <button t-if="this.documentService.userIsInternal" class="btn btn-secondary"
                t-on-click="this.shareTraceback" t-att-disabled="this.state.processed">
                Share
            </button>
            <div t-if="this.state.tracebackUrl" class="d-flex gap-2 min-w-0 p-1 border rounded-2">
                <span class="text-truncate" t-out="this.state.tracebackUrl"/>
                <CopyButton className="'flex-basis-0 btn-sm p-0'" content="this.state.tracebackUrl" icon="'assignment'"
                    successText.translate="The document URL has been copied to your clipboard."/>
            </div>
        </xpath>
    </t>
</templates>
