<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="document_creation_message_template" name="Document creation message">
            Document created <br/>
            <t t-if="creator">
                <i class="oi oi-fw oi-filled me-1" data-icon="person"/>
                <span> Creator: </span>
                <b t-out="creator"/><br/>
            </t>
            <t t-if="name">
                <i class="oi oi-fw oi-filled me-1" data-icon="description"/>
                <span> Original Name: </span>
                <b t-out="name"/><br/>
            </t>
            <t t-if="source">
                <i class="oi oi-fw me-1" data-icon="share"/>
                <span> Source: </span>
                <b t-out="source"/><br/>
            </t>
            <t t-if="notes">
                <i class="oi oi-fw me-1" data-icon="link"/>
                <span> Notes: </span>
                <span t-out="notes"/><br/>
            </t>
    </template>
</data>
</odoo>
