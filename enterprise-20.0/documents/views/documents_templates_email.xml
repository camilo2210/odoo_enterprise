<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="content_email" name="Thumbnail / Preview for email attachments">
        <html>
            <head>
                <t t-call-assets="documents.assets_email" t-js="false"/>
            </head>
            <body>
                <div class="o_email_preview">
                    <iframe class="o_email_preview_content" t-att-srcdoc="content"
                        sandbox="" t-att-scrolling="'no' if is_thumbnail else None"/>
                    <svg class="o_email_preview_watermark" viewBox="0 0 100 26"
                         preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                        <text x="50" y="21" text-anchor="middle">EMAIL</text>
                    </svg>
                </div>
            </body>
        </html>
    </template>
</odoo>
