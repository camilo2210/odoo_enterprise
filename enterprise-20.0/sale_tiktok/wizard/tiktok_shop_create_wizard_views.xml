<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tiktok_shop_create_wizard_view_form" model="ir.ui.view">
        <field name="name">tiktok.shop.create.wizard.form</field>
        <field name="model">tiktok.shop.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create TikTok Shop">
                <group string="App Credentials">
                    <group>
                        <field
                            name="app_key"
                            options="{'enable_formatting': false}"
                            required="True"
                        />
                        <field
                            name="app_secret"
                            password="True"
                            required="True"
                        />
                        <field
                            name="service_extern_id"
                            options="{'enable_formatting': false}"
                            required="True"
                        />
                    </group>
                </group>

                <!-- Help Text for Credentials -->
                <div class="alert alert-info" role="alert">
                    <strong>Where to find your API credentials:</strong><br/>
                    1. Go to TikTok Shop Partner Center<br/>
                    2. Navigate to Apps &amp; Service → Create New App or use existing<br/>
                    3. Grant the App permissions to access your shop data<br/>
                    4. Get your Service ID, App key and App secret<br/>
                </div>

                <footer>
                    <button
                        name="action_create_shop"
                        type="object"
                        string="Connect Shop &amp; Authorize"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tiktok_shop_create_wizard" model="ir.actions.act_window">
        <field name="name">Create TikTok Shop</field>
        <field name="res_model">tiktok.shop.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
