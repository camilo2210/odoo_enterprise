#. module: sale_tiktok
#: model:ir.module.module,description:base.module_sale_tiktok
msgid ""
"\n"
"Import your TikTok Shop orders in Odoo and synchronize deliveries\n"
"=================================================================\n"
"\n"
"Key Features\n"
"------------\n"
"* Import orders from multiple shops\n"
"* Orders are matched with Odoo products based on their internal reference\n"
"  (SKU in TikTok Shop)\n"
"* Support for Fulfillment by Seller (FBS)\n"
msgstr ""

#. module: sale_tiktok
#. odoo-python
#: code:addons/sale_tiktok/wizard/tiktok_shop_create_wizard.py:0
msgid "(Pending Authorization)"
msgstr "(Oczekuje na autoryzację)"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.order_sync_failure
msgid ""
"<div>\n"
"                <p>\n"
"                    The synchronization of the TikTok Shop order with "
"reference\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    encountered an error and was not completed.\n"
"                </p>\n"
"                <p>\n"
"                    Unless the order is canceled in TikTok Shop, no other "
"synchronization will be attempted.\n"
"                </p>\n"
"                <p>\n"
"                    To schedule a new synchronization attempt, proceed as "
"follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the TikTok Shop on which the "
"order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>\n"
"                            Set a date for <em>Last Order Synchronization "
"Date</em> that is before the last status update of the order.\n"
"                        </li>\n"
"                        <li>Save the changes and click on the <em>SYNC "
"ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    If the problem persists, contact\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</"
"a>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    Synchronizacja zamówienia w TikTok Shop z numerem "
"referencyjnym\n"
"                   <t t-out=\"ctx.get('tiktok_order_ref') or ''\"> REF</t>\n"
"                    zakończyła się błędem i nie została dokończona.\n"
"               </p>\n"
"                <p> \n"
"                    O ile zamówienie nie zostanie anulowane w TikTok Shop, "
"nie będą podejmowane żadne kolejne próby synchronizacji.\n"
"               </p>\n"
"                <p> \n"
"                    Aby zaplanować nową próbę synchronizacji, postępuj w "
"następujący sposób:\n"
"                   </p><ol> \n"
"                       <li> Wejdź do narzędzi deweloperskich.</li>\n"
"                        <li>Otwórz formularz TikTok Shop, w którym złożono "
"zamówienie.</li>\n"
"                        <li>Przejdź do zakładki „Śledzenie zamówień”.</li>\n"
"                        <li>\n"
"                            Ustaw datę <em>Ostatniej synchronizacji "
"zamówienia</em> wcześniejszą niż data ostatniej aktualizacji statusu "
"zamówienia.\n"
"                       </li>\n"
"                        <li> Zapisz zmiany i kliknij przycisk <em>„"
"SYNCHRONIZUJ ZAMÓWIENIA”</em>.</li>\n"
"                    </ol>\n"
"                \n"
"               <p> \n"
"                    Jeśli problem nadal występuje, skontaktuj się z\n"
"                   <a href=\"https://www.odoo.com/help/\"> działem pomocy "
"technicznej Odoo</a>.\n"
"               </p>\n"
"            </div> \n"
"        "

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_form
msgid ""
"<strong>Authorization Failed: </strong>\n"
"                    An unexpected error occurred during authorization. "
"Please try again."
msgstr ""
"<strong>Autoryzacja nie powiodła się: </strong>\n"
"                    W trakcie autoryzacji wystąpił nieoczekiwany błąd. "
"Spróbuj ponownie."

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or "
"use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/"
">\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>Gdzie znaleźć poświadczenia API:</strong><br/>\n"
"                    1. Przejdź do centrum partnerskiego TikTok Shop<br/>\n"
"                    2. Przejdź do sekcji Aplikacje &amp; Usługi → Utwórz "
"nową aplikację lub użyj istniejącej<br/>\n"
"                    3. Przyznaj aplikacji uprawnienia dostępu do danych "
"Twojego sklepu<br/>\n"
"                    4. Pobierz identyfikator usługi (Service ID), klucz "
"aplikacji (App key) i tajny klucz aplikacji (App secret)<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the "
"synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/"
"\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    Synchronizacja magazynu dla TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    napotkała pewne błędy i nie została ukończona.\n"
"                </p>\n"
"                <p>Oto błędy wysłane przez TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Wewnętrzne referencje produktów</th>\n"
"                            <th>Wiadomość</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    Podczas synchronizacji z TikTok Shop "
"wystąpił nieznany błąd.\n"
"                                    Musisz sprawdzić ręcznie czy dostępna "
"ilość produktu jest poprawna.\n"
"                                    Jeśli problem będzie się powtarzać, "
"skontaktuj się ze\n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"wsparciem Odoo</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

