<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tiktok_item_list" model="ir.ui.view">
        <field name="name">tiktok.shop.item.list</field>
        <field name="model">tiktok.item</field>
        <field name="arch" type="xml">
            <list string="TikTok Shop Items" editable="top">
                <field name="product_id" options="{'no_create': True}"/>
                <field
                    name="shop_id"
                    options="{'no_create': True, 'no_open': True}"
                    column_invisible="context.get('default_shop_id')"
                />
                <field name="tiktok_seller_sku"/>
                <field name="sync_to_tiktok"/>
                <field name="tiktok_sku_extern_id" groups="base.group_no_one"/>
                <field name="tiktok_item_extern_id" groups="base.group_no_one"/>
                <field name="last_inventory_sync_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="tiktok_item_search" model="ir.ui.view">
        <field name="name">tiktok.shop.item.search</field>
        <field name="model">tiktok.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="tiktok_seller_sku"/>
                <field name="tiktok_sku_extern_id" groups="base.group_no_one"/>
                <field name="tiktok_item_extern_id" groups="base.group_no_one"/>
                <field name="shop_id" invisible="context.get('default_shop_id')"/>
                <field name="product_id"/>
                <filter
                    string="TikTok Shop"
                    name="group_by_shop"
                    context="{'group_by': 'shop_id'}"
                />
                <filter
                    string="Product"
                    name="group_by_product"
                    context="{'group_by': 'product_tmpl_id'}"
                />
                <separator/>
            </search>
        </field>
    </record>

</odoo>
