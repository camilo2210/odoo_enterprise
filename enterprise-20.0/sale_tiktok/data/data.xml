<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="default_sale_product" model="product.product">
        <field name="name">TikTok Shop Sale</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
    </record>

    <record id="default_shipping_product" model="product.product">
        <field name="name">TikTok Shop Shipping</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
    </record>

    <record id="default_adjustment_product" model="product.product">
        <field name="name">TikTok Amount Adjustment</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok">False</field>
        <field name="purchase_ok">False</field>
    </record>

    <function model="product.product" name="_configure_for_tiktok">
        <value eval="[
            ref('sale_tiktok.default_sale_product'), ref('sale_tiktok.default_shipping_product'), ref('sale_tiktok.default_adjustment_product')
        ]"/>
    </function>

</odoo>
