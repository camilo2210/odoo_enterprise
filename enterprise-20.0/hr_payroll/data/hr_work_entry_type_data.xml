<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <function model="hr.work.entry.type" name="write">
            <value model="hr.work.entry.type" eval="obj().sudo().search([('code', 'in', ['LEAVE100', 'LEAVE105', '002.08', '158.00', '013.00', '016.00'])]).ids"/>
            <value eval="{'round_days_type': 'DOWN'}"/>
        </function>

        <function model="hr.work.entry.type" name="write">
            <value model="hr.work.entry.type" eval="obj().sudo().search([('code', '=', '000.00')]).ids"/>
            <value eval="{'round_days_type': 'HALF-UP'}"/>
        </function>

        <record id="hr_work_entry.generic_work_entry_type_attendance" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.BASIC')])]"/>
        </record>

        <function model="hr.work.entry.type" name="write">
            <value model="hr.work.entry.type" eval="obj().sudo().search([('code', '=', '040.00')]).ids"/>
            <value eval="{'category_ids': [(4, ref('hr_payroll.EXTRA_HOURS'))]}"/>
        </function>
    </data>
</odoo>
