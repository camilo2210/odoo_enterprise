<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_type_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.type.view.list.inherit.l10_be_hr_payroll</field>
        <field name="model">hr.employee.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="payroll_closing_date" optional="show"/>
                <field name="payroll_auto_post" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.contract.type.view.form.inherit</field>
        <field name="model">hr.employee.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="payroll_closing_date"/>
                <field name="payroll_auto_post"/>
            </xpath>
        </field>
    </record>
</odoo>
