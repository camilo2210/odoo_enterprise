<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">hr.payslip.list</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips" default_order="state_display, employee_id"
                    edit="1" sample="1" multi_edit="1" duplicate="0" js_class="hr_payroll_payslip_list">
                <header>
                    <button string="Off-Cycle" name="action_move_to_off_cycle" type="object" class="btn-primary"
                        confirm="This will detach the selected payslip(s) from the pay run and send them to Off-Cycle. Are you sure?"/>
                    <button string="Validate" name="action_validate" type="object" class="oe_highlight" context="{'payslip_generate_pdf': True}" groups="hr_payroll.group_hr_payroll_officer"/>
                    <button string="Compute" name="compute_sheet" type="object" class="oe_highlight"/>
                    <button string="Mark as Paid" name="action_payslip_paid" type="object" class="oe_highlight"/>
                    <button string="Print" name="action_print_payslip" type="object"/>
                    <button string="Correct" name="action_adjust_payslip" type="object"
                        context="{'default_is_button_action': True, 'correct_paid_payslips': True}"/>
                </header>
                <field name="company_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="employee_id" widget="many2one_avatar_employee_payroll" width="300" readonly="state != 'draft'"/>
                <field name="date_from" string="Period" widget="daterange" options="{'end_date_field': 'date_to', 'payrun_optional': 'hide'}" readonly="1"/>
                <field name="date_to" invisible="1" column_invisible="1" readonly="1"/>
                <field name="payslip_run_id" optional='show' widget="many2one" readonly="state != 'draft'" options="{'payrun_optional': 'hide', 'no_open': 0}" placeholder="Off-Cycle"/>
                <field name="struct_id" optional="hide" readonly="state in ['cancel', 'validated', 'paid']"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
                <field name="sum_worked_paid_days" optional="show"/>
                <field name="sum_worked_paid_hours" optional="hide"/>
                <field name="employer_cost" string="Total Cost" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" sum="Total Cost"/>
                <field name="basic_wage" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" sum="Total Basic"/>
                <field name="gross_wage" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" sum="Total Gross"/>
                <field name="net_wage" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" optional="show" sum="Total Net"/>
                <field
                    name="state_display" widget="badge"
                    decoration-info="state_display == '03_draft'"
                    decoration-success="state_display == '04_validated'"
                    decoration-primary="state_display == '05_paid'"
                    decoration-warning="state_display == '02_warning'"
                    decoration-danger="state_display == '01_error'"/>
                <field name="issues" width="600" widget="actionable_warnings" string="Warnings"/>
                <button string="Off-Cycle" help="Detach the payslip from the pay run to send it to the Off-Cycle" name="action_move_to_off_cycle" type="object"
                    icon="east" invisible="1"/>             
            </list>
        </field>
    </record>

    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip" duplicate="0">
            <header>
                <button string="Validate" name="action_payslip_done" type="object" invisible="state != 'draft' or not line_ids" class="oe_highlight" context="{'payslip_generate_pdf': True}" groups="hr_payroll.group_hr_payroll_officer"/>
                <button string="Pay" name="action_payslip_payment_report" type="object" class="oe_highlight" invisible="state != 'validated'"/>
                <button string="Correct" name="action_adjust_payslip" type='object' invisible="credit_note or state != 'paid'" context="{'default_is_button_action': True}"/>
                <button string="Set to Draft" name="action_payslip_draft" type="object" invisible="state != 'cancel'"/>
                <button string="Mark Unpaid" name="action_payslip_unpaid" type="object" invisible="state != 'paid'"/>
                <button string="Compute" name="compute_sheet" type="object" invisible="state != 'draft' or line_ids or credit_note" class="oe_highlight" help="Recompute the payslip lines only, not the worked days / input lines"/>
                <button string="Compute" name="compute_sheet" type="object" invisible="state != 'draft' or not line_ids or credit_note" help="Recompute the payslip lines only, not the worked days / input lines"/>
                <button string="Print" name="action_print_payslip" type="object" invisible= "not line_ids"/>
                <button string="Cancel" name="action_payslip_cancel" type="object" invisible="state not in ('draft', 'validated')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,validated,paid"/>
            </header>
            <field name="issues" class="w-100" widget="actionable_warnings" invisible="not issues"/>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button type="object" class="oe_stat_button" name="action_open_employee_calendar" id="open_employee_calendar"
                        string="Calendar" icon="calendar_today" icon_class="oi-filled" invisible="not employee_id" >
                    </button>
                    <button type="object" class="oe_stat_button" name="action_open_related_payslips" id="open_related_payslips"
                        icon="content_copy" invisible="related_payslip_count == 0">
                        <field name="related_payslip_count" widget="statinfo" string="Related Payslips"/>
                    </button>
                    <button type="object" class="oe_stat_button" name="action_open_salary_attachments" id="open_salary_attachments"
                        icon="content_copy" invisible="salary_attachment_count == 0">
                        <field name="salary_attachment_count" widget="statinfo" string="Payslip Adjustments"/>
                    </button>
                </div>
                <div class="d-flex flex-column-reverse flex-sm-row align-items-sm-start gap-3 gap-md-5 mb-3 mb-lg-0">
                    <div name="employee_structure_widget" class="oe_title flex-grow-1">
                        <h1 class="d-flex flex-row align-items-center mb-1">
                            <field name="employee_id" widget="many2one_avatar_employee_payroll" placeholder="Employee"
                                readonly="state != 'draft'" options="{'no_create': True}" context="{'form_view_ref': 'hr_payroll.hr_employee_payroll_focused_form_view'}"/>
                        </h1>
                        <div class="d-block mb-2" style="padding-left: 66px;">
                            <field name="struct_id" class="w-100 d-block" required="1" readonly="state in ['cancel', 'validated', 'paid']"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                placeholder="Select the pay structure"/>
                        </div>
                    </div>
                    <div name="payslip_summary_widget" class="d-flex flex-grow-1 gap-2 justify-content-end">
                        <div class="flex-basis-50 flex-basis-sm-auto min-w-0 bg-100 p-2 px-lg-4 border rounded text-center"
                            invisible="ignore_worked_day_lines or is_company_executive">
                            <div class="mb-2 fw-bold">Worked days</div>
                            <div class="fs-2 lh-1">
                                <field name="sum_worked_paid_days" nolabel="1" class="mb-1 me-1"/>days
                            </div>
                            <div class="text-muted">
                                <field name="sum_worked_paid_hours" widget="float_time" nolabel="1"/>
                            </div>
                        </div>
                        <div class="flex-basis-50 flex-basis-sm-auto min-w-0 bg-100 p-2 px-lg-4 border rounded text-center">
                            <div class="mb-2 fw-bold">Wage</div>
                            <div invisible="ignore_worked_day_lines">
                                <field name="basic_wage" nolabel="1" class="justify-content-center mb-1 fs-2 lh-1 text-break"/>
                            </div>
                            <div class="text-muted" invisible="ignore_worked_day_lines">
                                <field name="net_wage" nolabel="1"/>
                                <span class="text-muted ms-1">Net</span>
                            </div>
                            <div class="text-muted" invisible="not ignore_worked_day_lines">
                                <field name="net_wage" nolabel="1" class="justify-content-center mb-1 fs-2 lh-1 text-break"/>
                                <span class="text-muted ms-1">Net</span>
                            </div>
                        </div>
                    </div>
                </div>
                <group name="top">
                    <group name="top_left">
                        <field name="company_id" invisible="1"/>
                        <field name="version_id" context="{'default_employee_id': employee_id, 'list_view_ref': 'hr_payroll.hr_version_list_search_more_view'}"
                            required="1" string="Contract"
                            invisible="not employee_id or employee_version_ids_count &lt;= 1"
                            options="{
                                'no_create': True,
                                'no_create_edit': True,
                            }"
                        />
                        <field name="country_id" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                        <field name="payslip_run_id" string="Pay Run" placeholder="Off-Cycle" context="{'default_date_start': date_from, 'default_date_end': date_to}" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="salary_attachment_ids" invisible="1" force_save="1"/>
                        <field name="wage_type" invisible="1"/>
                        <field name="sum_worked_hours" invisible="1"/>
                        <field name="credit_note" invisible="1" readonly="state != 'draft'"/>
                        <field name="is_superuser"  invisible="1"/>
                        <field name="ignore_worked_day_lines" invisible="1"/>
                        <field name="payment_report_filename" invisible="1"/>
                        <field name="payment_report" filename="payment_report_filename" invisible="not payment_report"/>
                        <label for="date_from" string="Period"/>
                        <div name="period">
                            <field name="date_from" class="oe_inline" readonly="state in ['cancel', 'validated', 'paid']"/>
                            <i class="oi px-2" data-icon="east" title="arrow"></i>
                            <field name="date_to" class="oe_inline" readonly="state in ['cancel', 'validated', 'paid']"/>
                        </div>
                    </group>
                </group>
                <notebook class="o_payslip_notebook">
                    <field name="country_code" invisible="1"/>
                    <page string="Worked Days" name="worked_days" class="o_hr_payroll_worked_days" invisible="ignore_worked_day_lines or is_company_executive">
                        <field name="worked_days_line_ids" readonly="state in ['cancel', 'validated', 'paid']">
                            <list string="Worked Days" editable="bottom" create="0" delete="0">
                                <field name="work_entry_type_id" readonly="1" force_save="1" optional="hide"/>
                                <field name="code" readonly="1" force_save="1"/>
                                <field name="version_id" groups="base.group_no_one" readonly="1" force_save="1"/>
                                <field name="name"/>
                                <field name="period_start_date" optional="hide"/>
                                <field name="period_end_date" optional="hide"/>
                                <field name="resource_calendar_id" optional="hide"/>
                                <field name="reference_calendar_id" optional="hide"/>
                                <field name="category_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                                <field name="category_options_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                                <field name="number_of_days" sum="Total Working Days" force_save="1" string="Days"/>
                                <field name="number_of_hours"  widget="float_time" sum="Total Working Hours" force_save="1" string="Hours"/>
                                <field name="amount" sum="Total Amount" force_save="1" column_invisible="parent.country_code in ['AE', 'SA']"/>
                                <field name="ytd" readonly="1" force_save="1"
                                    column_invisible="not parent.ytd_computation"
                                    optional="show"/>
                                <field name="is_paid" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                    <page string="Salary Inputs" class="o_hr_payroll_worked_days" name="salary_inputs">
                        <field name="input_line_ids" colspan="4" nolabel="1" readonly="state in ['cancel', 'validated', 'paid']">
                            <list string="Input Data" editable="bottom">
                                <!--
                                    Required 0 to force client to send on change request even when not defined,
                                    so the salary_rule_id domain (parent.struct_id) is evaluated properly.
                                -->
                                <field name="payslip_id" required="0" column_invisible="True"/>
                                <field name="salary_rule_id"/>
                                <field name="user_instructions" widget="explanation_tooltip" string=" " width="30px"/>
                                <field name="name"/>
                                <field name="amount" widget="float_with_suffix"/>
                                <field name="version_id" column_invisible="True"/>
                                <field name="sequence" column_invisible="True"/>
                            </list>
                        </field>
                        <field name="currency_id" invisible="1"/>
                    </page>
                    <page string="Salary Computation" name="salary_computation" class="o_hr_payroll_salary_computation">
                        <div class="o_payslip_show_all_toggle d-flex gap-2">
                            <span class="mb-0 fw-normal text-muted">Show all</span>
                            <widget name="payslip_show_all_toggle"/>
                        </div>
                        <field name="line_ids" colspan="4" nolabel="1" readonly="state != 'draft'" widget="payslip_lines_2many">
                            <list string="Salary Structure" editable="bottom" decoration-bf="manually_modified" decoration-muted="total == 0" create="0" delete="0" limit="200">
                                <field name="name"/>
                                <field name="code" readonly="1" force_save="1" optional="hide"/>
                                <field name="category_ids" widget="many2many_tags" readonly="1" force_save="1" optional="hide"/>
                                <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="quantity" force_save="1" optional="show" is_default_value="quantity == 1.0"/>
                                <field name="rate" options="{'hide_trailing_zeros': True}" force_save="1" optional="show" is_default_value="rate == 100.0"/>
                                <field name="salary_rule_id" groups="base.group_no_one" readonly="1" force_save="1" optional="hide"/>
                                <field name="hide_amount" column_invisible="True"/>
                                <field name="amount" force_save="1" optional="show" is_default_value="amount == total" invisible="hide_amount"/>
                                <field name="total" readonly="not(amount == total and rate == 100.0 and quantity == 1.0)" force_save="1"/>
                                <field name="ytd" readonly="1" force_save="1"
                                    column_invisible="not parent.ytd_computation"
                                    optional="show"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="appears_on_payslip" column_invisible="True"/>
                                <field name="explanation" widget="explanation_tooltip" string=" " width="30px"/>
                            </list>
                        </field>
                    </page>
                    <page string="Other Info" name="account_info">
                        <group>
                            <group>
                                <field name="name" invisible="1"/>
                                <field name="title" placeholder="Default" readonly="state in ['cancel', 'validated', 'paid']"/>
                                <field name="ignore_worked_day_lines" readonly="state in ['cancel', 'validated', 'paid']"
                                    string="No Worked Days" invisible="not struct_use_worked_day_lines"/>
                                <div colspan="2">
                                    <label for="note" string="Note"/>
                                    <field name="note" class="oe_inline" placeholder="Add a note on the printed payslip." readonly="state != 'draft'"/>
                                </div>
                            </group>
                            <group name="accounting">
                                <field name="paid_date"/>
                                <field name="paid" invisible="1" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                </sheet>
                <div class="o_attachment_preview" groups="hr_payroll.group_payslip_display"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_payslip_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.pivot</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <pivot string="Payslips" sample="1">
                <field name="net_wage" type="measure"/>
                <field name="department_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_payslip_filter" model="ir.ui.view">
        <field name="name">hr.payslip.select</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <search string="Search Payslips">
                <field name="employee_id"/>
                <field name="employee_id" string="Employee Reference" filter_domain="[('employee_id.registration_number', 'ilike', self)]"/>
                <field name="date_from"/>
                <field name="version_id"/>
                <field name="payslip_run_id"/>
                <field name="struct_id"/>
                <field name="activity_user_id" string="Activities of"/>
                <field name="activity_type_id" string="Activity type"/>
                <filter
                    string="Has Issues" name="filter_issue"
                    domain="['|', ('error_count', '>', 0), ('warning_count', '>', 0)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" help="Draft Slip"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]" help="Done Slip"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]" help="Paid Slip"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]" help="Canceled Slip"/>
                <separator/>
                <filter string="Date" name="date_filter" date="date_to" default_period="month-1"/>
                <separator/>
                <filter string="Off-Cycle" name="filter_off_cycle" domain="[('payslip_run_id', '=', False)]"/>
                <filter string="Credit Notes" name="credit_note" domain="[('credit_note', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Pay Run" name="group_by_batch" context="{'group_by': 'payslip_run_id'}"/>
                    <filter string="Employee" name="group_by_employee_id" context="{'group_by': 'employee_id'}"/>
                    <filter string="Employee Type" name="group_by_employee_type_id" context="{'group_by': 'employee_type_id'}"/>
                    <filter string="Structure" name="group_by_structure" context="{'group_by': 'struct_id'}"/>
                    <filter string="Payslip Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department_id" context="{'group_by':'department_id'}"/>
                    <filter string="Job Position" name="group_by_job_id" context="{'group_by':'job_id'}"/>
                    <filter string="Company" name="group_by_company_id" groups="base.group_multi_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Date From" name="group_by_date_from" context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_payslip_list_employee_payslips" model="ir.ui.view">
        <field name="name">hr.payslip.view.list.employee</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="expand">1</attribute>
                <attribute name="default_order">date_from desc, state_display</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_hr_payslip_new" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_view_hr_payslip_month_form" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="path">payslips</field>
        <field name="view_mode">list,form,activity</field>
        <field name="search_view_id" ref="view_hr_payslip_filter"/>
    </record>

    <record id="act_hr_employee_payslip_list" model="ir.actions.act_window">
        <field name="res_model">hr.payslip</field>
        <field name="name">Payslips</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_employee_id': [active_id], 'default_employee_id': active_id}</field>
    </record>

    <record model="ir.actions.server" id="action_add_salary_adjustments">
        <field name="name">Add Payslip Adjustments</field>
        <field name="sequence" eval="5"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('hr_payroll.action_hr_salary_attachment_generate_multi_wizard').read()[0]
action['context'] = {
    'default_employee_ids': records.employee_id.ids,
}
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_draft">
        <field name="name">Set to Draft</field>
        <field name="sequence" eval="10"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.action_payslip_draft()
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_compute_payroll">
        <field name="name">Compute</field>
        <field name="sequence" eval="20"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
result = records.compute_sheet()
if isinstance(result, dict):
    action = result
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_confirm_payroll">
        <field name="name">Validate</field>
        <field name="sequence" eval="30"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.with_context(payslip_generate_pdf=True).action_payslip_done()
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_cancel_payroll">
        <field name="name">Cancel</field>
        <field name="sequence" eval="40"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_payslip_cancel()
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_recompute_whole_sheet">
        <field name="name">Reset</field>
        <field name="sequence" eval="50"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_refresh_from_work_entries()
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_remove_from_payrun">
        <field name="name">Send to Off-Cycle</field>
        <field name="sequence" eval="50"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records.action_move_to_off_cycle()
        </field>
    </record>

    <record model="ir.actions.server" id="action_hr_payroll_generate_pdf">
        <field name="name">Generate PDF</field>
        <field name="sequence" eval="50"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
