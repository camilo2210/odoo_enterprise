<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_time_rule_view_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.time.rule.form.inherit.hr.payroll</field>
        <field name="model">hr.time.rule</field>
        <field name="inherit_id" ref="hr_work_entry.hr_time_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_entry_type_id']/.." position="after">
                <field name="premium_pay_category_ids" widget="many2many_tags"
                    options="{'no_create': True}"
                    groups="hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>
</odoo>
