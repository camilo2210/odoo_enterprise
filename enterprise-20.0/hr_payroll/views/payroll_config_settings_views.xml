<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="payroll_config_settings_view_form" model="ir.ui.view">
        <field name="name">payroll.config.settings.form</field>
        <field name="model">payroll.config.settings</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="company_id" widget="payroll_config_timeline" invisible="not id" options="{'clickable': True}" readonly="False"/>
                </header>
                <sheet>
                    <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                        <field readonly="1" name="company_logo" widget="contact_image" class="oe_avatar text-start float-none" nolabel="1" options="{'size': [100,100], 'img_class': 'rounded-4'}"/>
                        <div class="oe_title w-100">
                            <label for="company_name"/>
                            <h1 class="o_outlined">
                                <field readonly="1" name="company_name"/>
                            </h1>
                        </div>
                    </div>
                    <group name="payroll_settings">
                        <field name="date_version" class="o_hr_narrow_field"/>
                        <field name="parent_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="payroll_config_settings_view_list" model="ir.ui.view">
        <field name="name">payroll.config.settings.list</field>
        <field name="model">payroll.config.settings</field>
        <field name="arch" type="xml">
            <list string="Records" multi_edit="1" default_order='date_version DESC' type="object" class="o_hr_version_list_view">
                <field name="date_version" readonly="False" string="Effective Date"/>
                <field name="date_start" string="Start"/>
                <field name="date_end" string="End"/>
                <field name="company_id" optional="show"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="write_uid" optional="hide" readonly="1"/>
                <field name="write_date" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>
</odoo>
