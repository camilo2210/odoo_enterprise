<?xml version="1.0"?>
<odoo>
<template id="report_light_payslip">
    <t t-call="web.basic_layout">
        <div class="header d-flex flex-row pb-0 mb-0" id="header">
            <div class="me-5">
                <img t-if="o.company_id.logo" class="o_company_logo_big" t-att-src="image_data_uri(o.company_id.logo)"/>
            </div>
            <div class="d-flex flex-column flex-grow-1" style="border-bottom: 2px solid black">
                <div t-field="o.company_id" style="font-size: large" class="mb-2"/>
                <div t-field="o.name" style="font-size: x-large"/>
            </div>
        </div>
        <div class="page">
            <div id="infos_table">
                <table class="table table-sm table-borderless">
                    <tr id="employee_name">
                        <td>Name:</td>
                        <td class="text-end"><strong t-field="o.employee_id"/></td>
                    </tr>
                    <tr id="employee_job_position" t-if="o.version_id.job_id">
                        <td>Job Position:</td>
                        <td class="text-end"><strong t-field="o.version_id.job_id"/></td>
                    </tr>
                    <tr id="employee_department" t-if="o.version_id.department_id">
                        <td>Department:</td>
                        <td class="text-end"><strong t-field="o.version_id.department_id"/></td>
                    </tr>
                    <tr id="pay_period">
                        <td>Pay Period:</td>
                        <td class="text-end fw-bold">
                            <span t-if="o.version_id.date_start and o.date_from &lt; o.version_id.date_start" t-field="o.version_id.date_start"/>
                            <span t-else="" t-field="o.date_from"/>
                            -
                            <span t-if="o.version_id.date_end and o.date_to &gt; o.version_id.date_end" t-field="o.version_id.date_end"/>
                            <span t-else="" t-field="o.date_to"/>
                        </td>
                    </tr>
                </table>
            </div>
            <t t-set="is_correction" t-value="o.is_correction_payslip"/>
            <t t-if="is_correction">
                <t t-set="orig_lines_by_code" t-value="{l.code: l for l in o.origin_payslip_id.line_ids}"/>
            </t>
            <t t-else="">
                <t t-set="orig_lines_by_code" t-value="{}"/>
            </t>
            <div id="payslip_lines_table">
                <table class="table table-sm table-borderless">
                    <thead>
                        <tr>
                            <th id="line_header_name"/>
                            <th id="line_header_currency" class="text-end">
                                <strong t-field="o.company_id.currency_id"/>
                            </th>
                            <th id="line_header_ytd" class="text-end" t-if="o.ytd_computation and not is_correction">
                                <strong>YTD</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip in ('always', 'non_zero'))" t-as="line">
                            <t t-set="orig_line" t-value="orig_lines_by_code.get(line.code)"/>
                            <t t-set="disp_total" t-value="line.total - (orig_line.total if orig_line else 0.0)"/>
                            <t t-if="line.appears_on_payslip == 'always' or (not is_correction and round(line.amount, 2) != 0) or (is_correction and disp_total != 0)">
                                <t t-set="line_styling" t-value="line.get_payslip_styling_dict()"/>
                                <t t-set="line_style" t-value="line_styling['line_style']"/>
                                <t t-set="line_class" t-value="line_styling['line_class']"/>
                                <t t-set="o_title" t-value="line_styling['o_title']"/>
                                <tr id="line_display">
                                    <td id="payslip_line_name" t-att-class="line_class" t-att-style="line_style">
                                        <span t-field="line.name" t-if="is_html_empty(line.salary_rule_id.note)" class="d-block"/>
                                        <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)" t-attf-class="#{line_class} d-inline-block ps-1" style="max-width: 500px; font-size: 0.875em;"/>
                                    </td>
                                    <td id="payslip_line_total" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-out="disp_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                    <td id="payslip_line_ytd" t-if="o.ytd_computation and not is_correction" t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                        <span t-out="line.ytd" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </span>
                    </tbody>
                </table>
            </div>
            <div id="to_pay">
                <t t-set="net_to_pay" t-value="o.correction_net_delta if (is_correction and o.origin_payslip_id.state == 'paid') else o.net_wage"/>
                <t t-if="net_to_pay &gt;= 0">
                    <t t-set="payments" t-value="o.generate_payments_dict()"/>
                    <t t-foreach="payments" t-as="payment">
                        <p>
                            Paid to
                            <span class="fw-bold"
                                t-out="('X' * (len(payment['account_num']) - 4) + payment['account_num'][-4:])
                                        if payment['account_num'] else 'xxxxxxxxxxxx'"/>
                            <span t-out="payment['partner']"/>:
                            <span t-out="payment['amount']"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                class="fw-bold"/>
                            <br/>
                        </p>
                    </t>
                    <t t-if="not payments">
                        Amount to be paid to <span class="fst-italic" t-field="o.employee_id.legal_name"/>: <span t-out="net_to_pay" t-options='{"widget": "monetary", "display_currency": o.currency_id}' class="fw-bold"/>
                    </t>
                </t>
                <p t-else="">
                    The net amount will be recovered from the first positive remuneration established after this.
                </p>
            </div>
        </div>
        <div id="note" t-if="o.note" t-field="o.note" />
        <div class="footer" id="footer" style="font-size: large"/>
    </t>
</template>

<template id="report_light_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="hr_payroll.report_light_payslip"/>
        </t>
    </t>
</template>
</odoo>
