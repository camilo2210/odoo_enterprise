<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="resource_calendar_leave_view_form" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.form.inherit.hr.payroll</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_work_entry.resource_calendar_leave_view_form"/>
        <field name="arch" type="xml">
            <field name="work_entry_type_id" position="after">
                <field name="count_as"/>
                <field name="options_on_work_entry_type_ids" invisible="1"/>
                <field name="category_options_ids" widget="many2many_tags" options="{'no_create': True}"
                       invisible="not options_on_work_entry_type_ids"/>
            </field>
        </field>
    </record>

    <record id="resource_calendar_leave_view_tree" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.inherit.hr.payroll</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_work_entry.resource_calendar_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="work_entry_type_id" position="after">
                <field name="count_as" optional="hidden"/>
                <field name="category_options_ids" widget="many2many_tags" optional="hidden"/>
            </field>
        </field>
    </record>
</odoo>
