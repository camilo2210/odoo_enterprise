<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_message_view_list_payroll_audit" model="ir.ui.view">
        <field name="name">mail.message.view.list.payroll.audit</field>
        <field name="model">mail.message</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list edit="0" delete="0" create="0" action="action_open_document" type="object">
                <field name="date"/>
                <field name="author_id" widget="many2one_avatar"/>
                <field name="res_id" string="Name"/>
                <field name="body" string="Description" class="o_track"/>
            </list>
        </field>
    </record>

    <record id="mail_message_view_search_payroll_audit" model="ir.ui.view">
        <field name="name">mail.message.view.search.payroll.audit</field>
        <field name="model">mail.message</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Messages Search">
                <field name="body" string="Description"/>
                <field name="author_id"/>
                <field name="date"/>
                <filter string="Partners" name="res_partner" domain="[('model', '=', 'res.partner')]"/>
                <filter string="Company" name="res_company" domain="[('model', '=', 'res.company')]"/>
                <filter string="Employee" name="hr_employee" domain="[('model', '=', 'hr.employee')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter string="Date" name="group_by_date" domain="[]" context="{'group_by': 'date'}"/>
                    <filter string="Updated Data" name="group_by_res_id" domain="[]" context="{'group_by': 'res_id'}"/>
                    <filter string="Author" name="group_by_author_id" domain="[]" context="{'group_by': 'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mail_message_action_payroll_audit" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">mail.message</field>
        <field name="view_id" ref="mail_message_view_list_payroll_audit"/>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">This is the Audit Trail Report</p>
        </field>
        <field name="domain">[
            ('message_type', 'in', ('notification', 'tracking')),
            ('model', 'in', ('hr.payslip', 'hr.employee', 'res.partner', 'res.company')),
        ]</field>
        <field name="context">{'search_default_hr_employee': 1}</field>
        <field name="search_view_id" ref="mail_message_view_search_payroll_audit"/>
    </record>
</odoo>
