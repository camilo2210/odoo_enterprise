<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.payroll</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="45"/>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Payroll" string="Payroll" name="hr_payroll" groups="hr_payroll.group_hr_payroll_manager">
                        <block title="Payroll" id="hr_payroll_settings">
                            <setting string="Contract Expiration Notice Period" id="contract_notice_period">
                                <span>Warn me </span><field name="contract_expiration_notice_period" class="w-25"/><span>days before end of contract.</span>
                            </setting>
                            <setting string="Work Permit Expiration Notice Period" id="work_permit_notice_period">
                                <span>Warn me </span><field name="work_permit_expiration_notice_period" class="w-25"/><span>days before expiration of the Work Permit.</span>
                            </setting>
                            <setting string="YTD Reset Date" id="ytd_reset_date"
                                title="Day where the 'Year To Date' will be reset every year.">
                                <div class="content-group">
                                    <field name="ytd_reset_day" class="o_light_label" style="width: 3ch;"/>
                                    <field name="ytd_reset_month" class="o_light_label"/>
                                </div>
                            </setting>
                            <setting string="First Payrun Date" id="first_payrun_configuration"
                                help="Choose the date when you plan to start using Odoo for your Payroll.">
                                <div class="content-group">
                                    <field name="first_payrun_date"/>
                                </div>
                            </setting>
                            <setting string="Send payslips to employees" id="payslip_generate_and_send_trigger"
                                help="Define when payslips are printed and sent to employees">
                                <div class="content-group">
                                    <field name="payslip_generate_and_send_trigger" class="o_light_label"/>
                                </div>
                            </setting>
                            <setting string="Payroll Closing Date" id="payrun_configuration"
                                help="Choose a company closing date for your monthly payruns.">
                                <div class="content-group">
                                    <field name="payroll_closing_date"/>
                                </div>
                            </setting>
                        </block>
                        <block title="Accounting" id="hr_payroll_accountant">
                            <setting name="module_hr_payroll_account_iso20022" string="Payroll SEPA" help="Create SEPA payment" invisible="'SEPA' not in company_country_group_codes">
                                <field name="module_hr_payroll_account_iso20022"/>
                            </setting>
                        </block>
                        <block title="Time Off" id="hr_payroll_time_off_settings">
                            <setting string="Deferred Time Off" help="Postpone time off after payslip validation">
                                <div class="content-group">
                                    <div class="row mt16 ms-2">
                                        <label string="Responsible" for="deferred_time_off_manager"
                                            class="col-md-6 p-0 m-0 o_light_label"/>
                                        <field name="deferred_time_off_manager" class="col-lg-6 p-0" placeholder="No one will be notified"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_hr_payroll_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'hr_payroll'}</field>
        </record>

</odoo>
