<?xml version="1.0"?>
<odoo>
    <record id="hr_payroll_set_schedule_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.set.schedule.wizard.view.form</field>
        <field name="model">hr.payroll.set.schedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p class="text-muted o_form_label">
                        In order to setup reminders, please provide the first pay period to be processed in Odoo, and the day you plan to close the payruns.
                    </p>
                    <group name="schedule_details">
                        <field name="hide_resource_calendar_id" invisible="1"/>
                        <field name="first_payrun_date" widget="datetime" options="{'min_precision': 'months'}"/>
                        <field name="payroll_closing_date" string="Usual Closing Date"/>
                        <field name="resource_calendar_id" string="Working Hours" placeholder="Default working hours used for this company" invisible="hide_resource_calendar_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object" class="btn btn-primary" data-hotkey="q">Save</button>
                    <button special="cancel" class="btn btn-secondary" data-hotkey="x">Cancel</button>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_payroll_set_schedule_action" model="ir.actions.act_window">
        <field name="name">Set Schedule</field>
        <field name="res_model">hr.payroll.set.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>
</odoo>
