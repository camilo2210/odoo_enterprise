<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payslip_correction_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.correction.wizard.view.form</field>
        <field name="model">hr.payslip.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Payslip Correction">
                <field name="employee_ids" invisible="1"/>
                <div class="alert alert-warning d-flex align-items-center" role="alert" invisible="is_button_action">
                    <button type="object" class="btn btn-link me-1 p-0" name="action_show_related_payslips">
                        <field name="payslip_count"/><span invisible="is_multi_payslip"> payslip has</span><span invisible="not is_multi_payslip"> payslips have</span>
                    </button>
                    been affected by this version's changes.
                </div>
                <div name="description" invisible="is_multi_payslip or is_button_action">
                    Choose whether to correct this payslip, only revert it or keep it as it is
                </div>
                <field name="correction_choice" widget="radio" invisible="not is_multi_payslip or is_button_action"/>
                <div name="description" invisible="not is_button_action or is_multi_payslip">
                    Do you want to correct this payslip or only revert it?
                </div>
                <div name="description" invisible="not is_button_action or not is_multi_payslip">
                    Do you want to correct those payslips or only revert them?
                </div>
                <footer>
                    <button name="action_correct_payslips" string="Correct" type="object" class="oe_highlight"/>
                    <button name="action_revert_payslips" string="Revert only" type="object" class="btn-secondary"/>
                    <button name="action_keep_wrong_version" string="Keep it as is" invisible="is_button_action" type="object" class="btn-secondary"/>
                    <button special="cancel" data-hotkey="x" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
