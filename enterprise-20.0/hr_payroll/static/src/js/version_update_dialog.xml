<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_be_hr_payroll.VersionUpdateDialog">
        <Dialog title.translate="Version update">
            <t t-set-slot="header">
                <button type="button" class="btn-close" aria-label="Close" tabindex="-1" t-on-click="this.onDiscard"/>
            </t>
            <div class="p-3">
                <div class="row align-items-start g-3">
                    <div class="col-md-7">
                        <p class="fw-bold fs-5 mb-0 flex-grow-1">
                            You are editing an employee version with existing payslips.<br/>
                            What do you want to do ?
                        </p>
                         <div class="form-check my-2">
                            <input class="form-check-input" type="radio" id="mode_new" value="create_new_version" name="version_mode"
                                t-att-checked="this.mode() === 'create_new_version'"
                                t-on-change="(ev) => this.mode.set(ev.currentTarget.value)"/>
                            <label class="form-check-label fw-bold" for="mode_new">Create new version</label>
                        </div>
                        <div class="form-check my-2">
                            <input class="form-check-input" type="radio" id="mode_correct" value="correct_current_version" name="version_mode"
                                t-att-checked="this.mode() === 'correct_current_version'"
                                t-on-change="(ev) => this.mode.set(ev.currentTarget.value)"/>
                            <label class="form-check-label fw-bold" for="mode_correct">Correct the current version</label>
                        </div>
                         <t t-if="this.mode() === 'create_new_version'">
                            <div class="d-flex align-items-center my-3">
                                <label class="me-2 fw-bold">New version from</label>
                                <input type="date" class="form-control w-auto" t-model="this.dateStart" />
                            </div>
                        </t>
                    </div>
                    <div class="col-md-5">
                        <t t-if="this.mode() === 'create_new_version'">
                            <div class="alert alert-info mt-3 mb-0" role="alert">
                                <span class="fs-4 me-2">⭐ <strong>Tips</strong></span>
                                <div class="small">
                                    You can create a new version using the button
                                    <span class="badge bg-300 px-2 py-1">+</span> in the top right corner
                                </div>
                            </div>
                        </t>
                        <t t-if="this.mode() === 'correct_current_version'">
                            <div class="alert alert-warning mt-3 mb-0" role="alert">
                                This change may impact <t t-esc="this.props.payslipsCount or 'existing'"/> payslips that you will need to correct
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onApply">Apply</button>
                <button class="btn btn-secondary" t-on-click="this.onDiscard">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
