<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AvatarCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('card-body')]" position="after">
            <t t-set="payrollInfo" t-value="this.payrollInfo"/>
            <div class="o_avatar_card_details card-footer d-flex flex-column rounded-bottom bg-100" t-if="payrollInfo">
                <span class="fw-bold">Payroll</span>
                <table class="mt-1 w-100">
                    <tr t-if="payrollInfo.wage">
                        <td class="text-muted pe-2">Wage</td>
                        <td t-out="payrollInfo.wage"/>
                    </tr>
                    <tr t-if="payrollInfo.category">
                        <td class="text-muted pe-2">Category</td>
                        <td t-out="payrollInfo.category"/>
                    </tr>
                    <tr t-if="payrollInfo.seniority">
                        <td class="text-muted pe-2">Seniority</td>
                        <td t-out="payrollInfo.seniority"/>
                    </tr>
                </table>
            </div>
        </xpath>
    </t>

    <t t-name="hr_payroll.PayrollAvatar" t-inherit="mail.Avatar">
        <xpath expr="//div[hasclass('o-mail-Avatar')]/img" position="attributes">
            <attribute name="t-on-click.stop.prevent"/>
            <attribute name="t-on-click.prevent">this.onClickAvatar</attribute>
        </xpath>
    </t>
</templates>
