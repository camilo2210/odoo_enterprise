<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr_payroll.PayRunDetailsSheet">
        <div class="o_payrun_sheet d-flex flex-column gap-3 pb-2" t-if="this.state.templates">
            <div class="o_payrun_sheet_header d-flex align-items-start justify-content-between gap-3 flex-shrink-0">
                <div class="o_payrun_sheet_meta min-w-0" t-if="'payrun_name' in this.state.templates">
                    <t t-call="{{ this.state.templates['payrun_name'] }}" t-call-context="this.state.renderingContext"/>
                </div>
                <div class="o_payrun_sheet_actions flex-shrink-0" t-if="'menu' in this.state.templates">
                    <t t-call="{{ this.state.templates['menu'] }}" t-call-context="this.state.renderingContext"/>
                </div>
            </div>
            <div class="o_payrun_sheet_kpis flex-grow-1">
                <t t-call="{{ this.state.templates['card'] }}" t-call-context="this.state.renderingContext"/>
            </div>
        </div>
    </t>
</templates>
