<t t-name="hr_payroll.ArchiveWarningDialog">
    <Dialog title.translate="Hide this warning?" size="'md'">
        <div>
            <p>You are about to hide the warning: <strong t-out="this.props.warningTitle"/></p>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    id="neverShowAgainCheckbox"
                    t-model.proxy="this.state.neverShowAgain"
                />
                <label class="form-check-label fw-semibold" for="neverShowAgainCheckbox">
                    Never show it again
                </label>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" tabindex="-1" t-on-click="this.confirmHide" data-hotkey="q">Hide</button>
            <button class="btn btn-secondary" tabindex="-1" t-on-click="this.props.close" data-hotkey="x">Cancel</button>
        </t>
    </Dialog>
</t>
