<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr_payroll.PayslipBatchFormView.Buttons">
        <button class="btn btn-primary" t-on-click="this.selectEmployees">
            Continue
        </button>
        <button class="btn btn-secondary" t-on-click="this.discard">
            Discard
        </button>
    </t>
</templates>
