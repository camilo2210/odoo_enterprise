<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_l10n_ec_edi_pos" model="ir.ui.view">
            <field name="name">res.config.settings.l10n.ec.edi.pos</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block id="pos_bills_and_receipts_section" position="inside">
                    <setting id="l10n_ec_edi_pos"
                             invisible="country_code != 'EC'"
                             help="Ecuador: Maximum amount allowed for issuing invoices to an unidentified Final Consumer.">
                        <field name="l10n_ec_pos_consumer_final_limit"/>
                    </setting>
                </block>
            </field>
        </record>
    </data>
</odoo>
