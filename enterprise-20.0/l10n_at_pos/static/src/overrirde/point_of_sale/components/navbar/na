<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_at_pos.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_burger_menu_buttons')]" position="inside">
            <t t-call="point_of_sale.BurgerDialogMenuButton"
                t-if="this.pos.company.l10n_at_is_fon_authenticated"
                onClick="() => this.printClosingReceipts()"
                btnLabel="this.menuLabel"
            />
        </xpath>
    </t>
</templates>
