<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_at_pos.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <div name="header" position="inside">
                <div t-if="conditions.get('l10n_at_cash_regid')" class="text-center">Fiskaly Register ID: <t t-out="extra_data.get('l10n_at_cash_regid')"/></div>
                <div t-if="conditions.get('l10n_at_pos_order_receipt_number')" class="text-center">Fiskaly Receipt No: <t t-out="conditions.get('l10n_at_pos_order_receipt_number')"/></div>
                <div t-translation="off" t-if="not order.get('is_fiskaly_order_receipt_signed') and conditions.get('l10n_at_cash_regid')" class="fw-bolder text-center">Sicherheitseinrichtung ausgefallen</div>
            </div>
        </template>
        <template id="l10n_at_pos.pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer">
            <div name="footer" position="before">
                <div t-if="image.get('l10n_at_pos_order_receipt_qr_data')" class="w-100 text-center">
                    <img t-att-src="image['l10n_at_pos_order_receipt_qr_data']" alt="QR Code" class="w-50" />
                </div>
            </div>
        </template>
    </data>
</odoo>
