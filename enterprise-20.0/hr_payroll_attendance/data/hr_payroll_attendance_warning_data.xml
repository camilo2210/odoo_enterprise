<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="hr_payroll_warning_attendance_discrepancies" model="hr.payroll.warning">
            <field name="name">Attendance Discrepancies</field>
            <field name="description">
Some employees have attendances but their payslips are not Attendance Based.
            </field>
            <field name="country_id" eval="False"/>
            <field name="model_id" ref="hr_payroll.model_hr_employee"/>
            <field name="warning_type">domain</field>
            <field name="warning_domain">[('attendance_based', '=', False), ('attendance_ids', '!=', False)]</field>
            <field name="button_name">Review Employees</field>
            <field name="visible_to">assistant</field>
        </record>
    </data>
</odoo>
