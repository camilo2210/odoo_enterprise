<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_barcode.DigipadTemplate">
        <div class="o_digipad_widget container p-0">
            <div class="o_digipad_digit_buttons row g-2">
                <div t-att-class="this.buttonContainerClass">
                    <button t-on-click="this.erase" t-att-disabled="this.quantity &lt;= 0" class="o_digipad_erase btn btn-secondary w-100">0</button>
                </div>
                <div t-att-class="this.buttonContainerClass">
                    <button t-on-click="this.decrement" t-att-disabled="this.quantity &lt;= 0" class="o_digipad_decrement btn btn-secondary w-100">-1</button>
                </div>
                <div t-att-class="this.buttonContainerClass">
                    <button t-on-click="this.increment" class="o_digipad_increment btn btn-secondary w-100">+1</button>
                </div>
                <div t-if="this.fulfillQuantity" class="col-3">
                    <button t-on-click="this.fulfill"
                            class="o_digipad_fufill w-100 btn"
                            t-att-class="this.buttonFulfillClass">
                        <t t-if="this.quantityToFulfill &gt; 0" t-out="'+' + this.quantityToFulfill"/>
                        <t t-elif="this.quantityToFulfill &lt; 0" t-out="this.quantityToFulfill"/>
                        <span t-else="" class="oi oi-lg" data-icon="check"/>
                    </button>
                </div>
                <t t-foreach="this.state.packagingButtons" t-as="packaging" t-key="packaging.id">
                    <div class="col-6">
                        <button t-on-click="() => this._increment(packaging.factor / (this.productUom ? this.productUom.factor : 1), this.quantity === 1, packaging.id)"
                                class="btn btn-secondary w-100" t-out="packaging.name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
