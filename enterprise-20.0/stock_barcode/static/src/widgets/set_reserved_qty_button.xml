<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <button t-name="stock_barcode.SetReservedQuantityButtonTemplate"
        class="o_button_qty_done d-flex btn btn-secondary rounded-end"
        t-on-click="this._setQuantity" t-att-disabled="!this.props.record.data[this.props.name]">
        <t t-if="this.props.record.data[this.props.name]">
            / <span name="product_uom_qty" class="ms-1" t-out="this.props.record.data[this.props.name]"/>
        </t>
        <span t-if="this.displayUOM" name="uom_id" class="text-capitalize ms-1" t-out="this.uom.name"/>
    </button>

</templates>
