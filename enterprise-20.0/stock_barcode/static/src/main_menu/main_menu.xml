<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_barcode.MainMenu">
        <div class="o_home_menu_background h-100 w-100 pt-sm-3">
            <div class="o_stock_barcode_main_menu container d-flex flex-column h-100 h-sm-auto bg-view shadow">
                <header>
                    <div class="d-flex align-items-center justify-content-between my-3 column-gap-2">
                        <a t-if="!this.pwaService.isScopedApp" href="#" class="o_stock_barcode_home_menu oi me-3 text-dark" data-icon="apps"
                            t-on-click="() => this.home.toggle(true)"/>
                        <span class="fs-2 me-auto">Barcode Scanner</span>
                        <a t-if="!this.pwaService.isScopedApp and this.pwaService.isSupportedOnBrowser"
                           title="Install Barcode PWA" aria-label="Install Barcode PWA" role="button"
                           class="btn btn-secondary d-flex align-items-center justify-content-center oi" data-icon="download"
                           href="/scoped_app?app_id=stock_barcode&amp;path=scoped_app/barcode" target="_blank"/>
                        <button t-if="this.pwaService.isScopedApp or this.uiService.isSmall"
                                title="Logout" aria-label="Logout"
                                class="btn btn-secondary oi" data-icon="logout" t-on-click="this.logout"/>
                    </div>
                </header>
                <main class="flex-grow-1">
                    <div t-if="this.state.displayDemoMessage" class="o_barcode_demo_message alert alert-info alert-dismissible" role="status">
                        <p class="m-0">
                            <t t-out="this.demoMessage"/>
                        </p>
                        <button t-on-click="this.removeDemoMessage" type="button" class="btn-close" title="Close"/>
                    </div>
                    <div class="mb-2">
                        <BarcodeView
                            facingMode="'environment'"
                            onInputSubmit.bind="this._onScannerResult"
                            onResult.bind="this._onScannerResult"
                            onError.bind="this._onScannerError"
                            bgClass="'text-bg-view'"
                        >
                            <t t-set-slot="barcode_open_button">
                                <div class="d-flex flex-column">
                                    <div class="o_barcode_tap_to_scan m-auto mw-50 cursor-pointer">
                                        <img src="/stock_barcode/static/img/barcode.png" alt="Barcode" class="my-1"/>
                                        <div class="o_stock_barcode_laser"/>
                                    </div>
                                    <div class="o_stock_mobile_barcode fw-bold">
                                        <p class="h2 text-primary">Scan or tap</p>
                                    </div>
                                </div>
                            </t>
                        </BarcodeView>
                    </div>
                    <ul>
                        <t t-foreach="this.barcodeHomeHelper" t-as="help_line" t-key="help_line_index">
                            <li><t t-out="help_line"/></li>
                        </t>
                    </ul>
                </main>
                <footer>
                    <button class="o_button_operations btn btn-primary mb-3 p-3 w-100"
                            t-on-click="() => this.actionService.doAction('stock_barcode.stock_picking_type_action_kanban')">
                        Operations
                    </button>
                    <button t-attf-class="o_button_inventory btn btn-{{this.quantCount ? 'info' : 'secondary'}} mb-3 p-3 w-100"
                            t-on-click="() => this.actionService.doAction('stock_barcode.stock_barcode_inventory_client_action')">
                        Count Inventory
                        <span t-if="this.quantCount" class="ms-2 p-1 px-2 bg-light rounded-circle text-primary" t-out="this.quantCount"/>
                    </button>
                </footer>
            </div>
        </div>
    </t>

</templates>
