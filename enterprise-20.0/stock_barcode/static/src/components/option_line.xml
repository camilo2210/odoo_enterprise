<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="stock_barcode.OptionLine" class="o_barcode_option_line list-group-item"
        t-on-click="this.select" t-attf-class="
            {{this.isSelected ? 'o_selected o_highlight' : ''}}
            {{this.props.additionalClass}}">
        <div>
            <i class="oi oi-fw me-2 text-muted" data-icon="local_shipping"/>
            <span class="o_barcode_line_title me-2" t-out="this.props.line.name"/>
            <span t-if="this.props.line.batch_id" class="badge rounded-pill text-capitalize fw-bold px-0 me-2">
                ( <t t-out="this.props.line.batch_id.name"/> )
            </span>
            <span t-if="this.props.line.partner_id">
                <span>-</span>
                <span t-out="this.props.line.partner_id.name"
                    class="badge rounded-pill text-capitalize fw-bold"/>
            </span>
        </div>
        <div t-if="this.props.responsible" name="Responsible">
            <i class="oi oi-fw oi-filled me-2 text-muted" data-icon="person"/>
            <span class="o_barcode_picking_user" t-out="this.props.responsible"/>
        </div>
    </div>
</templates>
