<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <record model="res.groups.privilege" id="res_groups_privilege_barcode">
        <field name="name">Barcode</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_barcode_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_barcode"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Inventory users keep an unrestricted access to the Barcode app. -->
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('stock_barcode.group_barcode_user'))]"/>
    </record>

</data>
</odoo>
