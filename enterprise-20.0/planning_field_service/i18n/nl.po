#. module: planning_field_service
#: model:mail.template,body_html:planning_field_service.mail_template_data_intervention_details
msgid ""
"<div>\n"
"    <t t-set=\"date_begin\" t-value=\"format_datetime(object.start_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_begin\" t-value=\"format_time(object.start_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"    <t t-set=\"date_end\" t-value=\"format_datetime(object.end_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_end\" t-value=\"format_time(object.end_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\"/>,<br/><br/>\n"
"    <t t-if=\"date_begin and date_end\">\n"
"        <t t-if=\"object.start_datetime.date() == object.end_datetime.date()"
"\">\n"
"            Your intervention is scheduled for <t t-out=\"date_begin or "
"''\">Nov 17</t> from <t t-out=\"time_begin or ''\">8 AM</t> to <t t-"
"out=\"time_end or ''\">10 AM</t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Your intervention is scheduled from <t t-out=\"date_begin or "
"''\">Nov 17</t> at <t t-out=\"time_begin or ''\">8 AM</t> to <t t-"
"out=\"date_end or ''\">Nov 18</t> at <t t-out=\"time_end or ''\">10 AM</t>.\n"
"        </t>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        Your intervention is scheduled.\n"
"    </t>\n"
"    <br/><br/>\n"
"    Best regards,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <t t-set=\"date_begin\" t-value=\"format_datetime(object.start_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_begin\" t-value=\"format_time(object.start_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"    <t t-set=\"date_end\" t-value=\"format_datetime(object.end_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_end\" t-value=\"format_time(object.end_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"\n"
"    Beste <t t-out=\"object.partner_id.name or 'customer'\"/>,<br/><br/>\n"
"    <t t-if=\"date_begin and date_end\">\n"
"        <t t-if=\"object.start_datetime.date() == object.end_datetime.date()"
"\">\n"
"            Je interventie staat gepland op <t t-out=\"date_begin or ''\">17 "
"nov</t> van <t t-out=\"time_begin or ''\">8:00</t> tot <t t-out=\"time_end "
"or ''\">10:00</t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Je interventie staat gepland van <t t-out=\"date_begin or "
"''\">17 nov</t> om <t t-out=\"time_begin or ''\">8:00</t> tot <t t-"
"out=\"date_end or ''\">18 nov</t> om <t t-out=\"time_end or ''\">10:00</t>.\n"
"        </t>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        Je interventie is ingepland.\n"
"    </t>\n"
"    <br/><br/>\n"
"    Met vriendelijke groet,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "

