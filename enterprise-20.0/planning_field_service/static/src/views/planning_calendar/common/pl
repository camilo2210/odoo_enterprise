<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="planning.PlanningCalendarCommonPopover.DefaultFooterButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-if='this.canUnschedule']" position="before">
            <button t-if="this.displayMapNavigationButton" class="btn btn-secondary" href="#" t-on-click="this.onOpenMapNavigation">
                Navigate
            </button>
            <button t-if="this.canStart" class="btn btn-sm btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.onStart())">
                Start
            </button>
            <button t-if="this.canComplete" class="btn btn-sm btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.onComplete())">
                Complete
            </button>
        </xpath>
    </t>
</templates>
