<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="planning.PlanningGanttRendererControls.ToolbarContent" t-inherit-mode="extension">

        <xpath expr="//div[@name='ganttToolbar']" position="after">
            <button class="o_gantt_button_update_travel_times btn btn-secondary"
                    t-if="this.model.canUpdateTravelTimes and this.model.shouldUpdateTravelTimes"
                    t-att-title="this.updateTravelTimesTitle"
                    t-on-click="() => this.model.updateTravelTimes()"
                    data-hotkey="r"
            >
                <i class="oi" data-icon="refresh"/>
                <span class="ms-1">Travel Times</span>
            </button>
        </xpath>

        <xpath expr="//DropdownItem[last()]" position="after">
            <t t-if="this.model.canUpdateTravelTimes and this.model.shouldUpdateTravelTimes">
                <DropdownItem onSelected="() => this.model.updateTravelTimes()" data-hotkey="r">
                    <i class="oi" data-icon="refresh"/>
                    <span class="ms-2">Travel Times</span>
                </DropdownItem>
            </t>
        </xpath>

    </t>

</templates>
