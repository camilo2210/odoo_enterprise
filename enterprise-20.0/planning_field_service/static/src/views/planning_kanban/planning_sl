<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="planning_field_service.PlanningSlotAction">
        <t t-if="this.isKanbanView and this.displayButtons">
            <a t-if="this.props.record.data.state === '2_published'" href="#" class="btn btn-link p-0 px-1" name="action_sign_in" t-on-click="this.onSignIn">Start</a>
            <a t-elif="this.props.record.data.state === '3_in_progress'" href="#" class="btn btn-link p-0 px-1" name="action_complete" t-on-click="this.onComplete">Complete</a>
        </t>
    </t>

</templates>
