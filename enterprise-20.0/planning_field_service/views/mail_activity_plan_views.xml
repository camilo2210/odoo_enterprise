<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_activity_plan_view_form_field_service" model="ir.ui.view">
            <field name="name">mail.activity.plan.view.form.field_service</field>
            <field name="model">mail.activity.plan</field>
            <field name="mode">primary</field>
            <field name="priority">32</field>
            <field name="inherit_id" ref="mail.mail_activity_plan_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='res_model']" position="attributes">
                    <attribute name="widget">filterable_selection</attribute>
                    <attribute name="options">{'whitelisted_values': ['planning.slot']}</attribute>
                </xpath>
                <xpath expr="//field[@name='template_ids']/list" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
            </field>
        </record>

        <record id="mail_activity_plan_action_config_field_service_plan" model="ir.actions.act_window">
            <field name="name">Activity Plans</field>
            <field name="res_model">mail.activity.plan</field>
            <field name="path">field-service-activity-plans</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="mail.mail_activity_plan_view_search"/>
            <field name="context">{'default_res_model': 'planning.slot'}</field>
            <field name="domain">[('res_model', '=', 'planning.slot')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Shift Activity Plan
                </p>
                <p>
                    Activity plans are used to assign a list of activities in just a few clicks
                    (e.g. "Progress Report", "Stand-up Meeting", ...)
                </p>
            </field>
        </record>

        <record id="mail_activity_plan_action_field_service_view_tree" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="mail.mail_activity_plan_view_tree"/>
            <field name="act_window_id" ref="planning_field_service.mail_activity_plan_action_config_field_service_plan"/>
        </record>

        <record id="mail_activity_plan_action_field_service_view_form" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="mail_activity_plan_view_form_field_service"/>
            <field name="act_window_id" ref="planning_field_service.mail_activity_plan_action_config_field_service_plan"/>
        </record>
    </data>
</odoo>
