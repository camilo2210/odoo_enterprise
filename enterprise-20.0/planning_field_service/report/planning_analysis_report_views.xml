<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_analysis_report_view_search_inherit_field_service" model="ir.ui.view">
        <field name="name">planning.slot.report.search.inherit.field.service</field>
        <field name="model">planning.analysis.report</field>
        <field name="inherit_id" ref="planning.planning_analysis_report_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role_id']" position="after">
                <field name="priority" groups="planning.group_planning_manager"/>
            </xpath>
            <xpath expr="//group/filter[@name='group_by_role']" position="after">
                <filter name="group_by_priority" string="Priority" context="{'group_by': 'priority'}" groups="planning.group_planning_manager"/>
            </xpath>
            <xpath expr="//filter[@name='status']" position="before">
                <separator/>
                <filter name="priority" string="Priority" groups="planning.group_planning_manager">
                    <filter string="Urgent" domain="[('priority', '=', '3')]" name="urgent_priority"/>
                    <filter string="High" domain="[('priority', '=', '2')]" name="high_priority"/>
                    <filter string="Medium" domain="[('priority', '=', '1')]" name="medium_priority"/>
                    <filter string="Low" domain="[('priority', '=', '0')]" name="low_priority"/>
                </filter>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
