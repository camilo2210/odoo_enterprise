<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mail_template_data_intervention_details" model="mail.template">
        <field name="name">Field Service: Shift Scheduled</field>
        <field name="model_id" ref="planning.model_planning_slot"/>
        <field name="subject">Intervention scheduled {{ object.start_datetime and 'for ' + format_datetime(object.start_datetime, dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang) + ' at ' + format_time(object.start_datetime, time_format='short', tz=object.partner_id.tz, lang_code=object.partner_id.lang) or '' }}</field>
        <field name="use_default_to" eval="True"/>
        <field name="description">Sent to customers when a shift is published</field>
        <field name="email_layout_xmlid">mail.mail_notification_light</field>
        <field name="body_html" type="html">
<div>
    <t t-set="date_begin" t-value="format_datetime(object.start_datetime, dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"/>
    <t t-set="time_begin" t-value="format_time(object.start_datetime, time_format='short', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"/>
    <t t-set="date_end" t-value="format_datetime(object.end_datetime, dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"/>
    <t t-set="time_end" t-value="format_time(object.end_datetime, time_format='short', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"/>

    Dear <t t-out="object.partner_id.name or 'customer'"></t>,<br/><br/>
    <t t-if="date_begin and date_end">
        <t t-if="object.start_datetime.date() == object.end_datetime.date()">
            Your intervention is scheduled for <t t-out="date_begin or ''">Nov 17</t> from <t t-out="time_begin or ''">8 AM</t> to <t t-out="time_end or ''">10 AM</t>.
        </t>
        <t t-else="">
            Your intervention is scheduled from <t t-out="date_begin or ''">Nov 17</t> at <t t-out="time_begin or ''">8 AM</t> to <t t-out="date_end or ''">Nov 18</t> at <t t-out="time_end or ''">10 AM</t>.
        </t>
    </t>
    <t t-else="">
        Your intervention is scheduled.
    </t>
    <br/><br/>
    Best regards,
    <t t-if="user.signature">
        <br/>
        <div>--<br/><t t-out="user.signature or ''">Mitchell Admin</t></div>
    </t>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_data_intervention_report" model="mail.template">
        <field name="name">Field Service: Report</field>
        <field name="model_id" ref="planning.model_planning_slot"/>
        <field name="subject">Field Service Report</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Email sent when the shift is completed.</field>
        <field name="email_layout_xmlid">mail.mail_notification_layout</field>
        <field name="body_html" type="html">
            <p>
                Dear <t t-out="object.partner_id.name or 'Customer'"></t>,<br/><br/>
                Please find attached the field service report for the recent intervention. <br/><br/>
                If you have any questions, please don't hesitate to contact us.<br/><br/>
                Best regards,<br/><br/>
            </p>
        </field>
        <field name="report_template_ids" eval="[(4, ref('planning_field_service.intervention_report'))]"/>
    </record>

    <record id="rating_shift_request_email_template" model="mail.template">
        <field name="active" model="res.groups" eval="obj()._is_feature_enabled('planning.group_field_service_allow_customer_ratings')"/>
        <field name="name">Field Service: Shift Rating Request</field>
        <field name="model_id" ref="planning.model_planning_slot"/>
        <field name="subject">{{ object.company_id.name or object.user_id.company_id.name }}: Service Rating Request</field>
        <field name="email_from">{{ object.company_id.email_formatted or object._rating_get_operator().email_formatted or user.email_formatted }}</field>
        <field name="use_default_to" eval="True"/>
        <field name="description">Sent to customers to collect ratings after a shift is completed</field>
        <field name="email_layout_xmlid">mail.mail_notification_light</field>
        <field name="body_html" type="html">
            <t t-set="access_token" t-value="object._rating_get_access_token()"/>
            <t t-set="partner" t-value="object._rating_get_partner()"/>
            <t t-set="date_start" t-value="format_datetime(object.start_datetime, dt_format='MMM d', tz=partner.tz, lang_code=partner.lang)"/>
            <t t-set="date_end" t-value="format_datetime(object.end_datetime, dt_format='MMM d', tz=partner.tz, lang_code=partner.lang)"/>
            <div>
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0;">
                    <tbody>
                        <tr><td valign="top" style="font-size: 14px;">
                            Hello <t t-out="partner.name or ''">Brandon Freeman</t>,<br/><br/>
                            Please take a moment to rate your experience with the field service intervention on <t t-out="date_end or date_start or ''">Nov 25</t>.
                        </td></tr>
                        <tr><td style="text-align: center;">
                            <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin: 32px 0px 32px 0px; display: inline-table;">
                                <tr><td style="font-size: 14px; text-align:center;">
                                    <strong>How satisfied were you with the intervention?</strong><br/>
                                    <span style="text-color: #888888">(click one of the smileys below to let us know)</span>
                                </td></tr>
                                <tr><td style="font-size: 14px;">
                                    <table style="width:100%;text-align:center;margin-top:2rem;">
                                        <tr>
                                            <td>
                                                <a t-attf-href="/rate/{{ access_token }}/5" t-att-class="'pe-none' if object._rating_get_operator() else ''">
                                                    <img alt="Happy" src="/rating/static/src/img/rating_5.png" title="Happy"/>
                                                </a>
                                            </td>
                                            <td>
                                                <a t-attf-href="/rate/{{ access_token }}/3" t-att-class="'pe-none' if object._rating_get_operator() else ''">
                                                    <img alt="Neutral" src="/rating/static/src/img/rating_3.png" title="Neutral"/>
                                                </a>
                                            </td>
                                            <td>
                                                <a t-attf-href="/rate/{{ access_token }}/1" t-att-class="'pe-none' if object._rating_get_operator() else ''">
                                                    <img alt="Unhappy" src="/rating/static/src/img/rating_1.png" title="Unhappy"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td></tr>
                            </table>
                        </td></tr>
                        <tr><td valign="top" style="font-size: 14px;">
                            We appreciate your feedback. It helps us continuously improve.
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </field>
        <field name="lang">{{ object.partner_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
