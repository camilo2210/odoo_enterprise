<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="general_ledger_report_l10n_vn" model="account.report">
        <field name="name">General Ledger - S03b-DN</field>
        <field name="load_more_limit" eval="80"/>
        <field name="search_bar" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="root_report_id" ref="account_reports.general_ledger_report"/>
        <field name="filter_journals" eval="True"/>
        <field name="country_id" ref="base.vn"/>
        <field name="custom_handler_model_id" ref="model_l10n_vn_account_general_ledger_report_handler"/>
        <field name="column_ids">
            <record id="general_ledger_report_l10n_vn_date" model="account.report.column">
                <field name="name">Date</field>
                <field name="expression_label">date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="general_ledger_report_l10n_vn_partner_name" model="account.report.column">
                <field name="name">Partner</field>
                <field name="expression_label">partner_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="general_ledger_report_l10n_vn_counterpart_account" model="account.report.column">
                <field name="name">Counterpart</field>
                <field name="expression_label">counterpart_account</field>
                <field name="figure_type">string</field>
            </record>
            <record id="general_ledger_report_l10n_vn_amount_currency" model="account.report.column">
                <field name="name">Currency</field>
                <field name="expression_label">amount_currency</field>
            </record>
            <record id="general_ledger_report_l10n_vn_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="general_ledger_report_l10n_vn_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="general_ledger_report_l10n_vn_balance_debit" model="account.report.column">
                <field name="name">Debit Balance</field>
                <field name="expression_label">balance_debit</field>
            </record>
            <record id="general_ledger_report_l10n_vn_balance_credit" model="account.report.column">
                <field name="name">Credit Balance</field>
                <field name="expression_label">balance_credit</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="general_ledger_custom_engine_line_l10n_vn" model="account.report.line">
                <field name="name">General Ledger</field>
                <field name="foldability">always_unfolded</field>
                <field name="groupby">account_id, id_with_accumulated_balance</field>
                <field name="expression_ids">
                    <record id="general_ledger_line_l10n_vn_date" model="account.report.expression">
                        <field name="label">date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">date</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_partner_name" model="account.report.expression">
                        <field name="label">partner_name</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">partner_name</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_counterpart_account" model="account.report.expression">
                        <field name="label">counterpart_account</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">counterpart_account</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_amount_currency" model="account.report.expression">
                        <field name="label">amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">amount_currency</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_amount_currency_currency_id" model="account.report.expression">
                        <field name="label">_currency_amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">currency_id</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">debit</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">credit</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_balance_debit" model="account.report.expression">
                        <field name="label">balance_debit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">balance_debit</field>
                    </record>
                    <record id="general_ledger_line_l10n_vn_balance_credit" model="account.report.expression">
                        <field name="label">balance_credit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_s03b_dn</field>
                        <field name="subformula">balance_credit</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
