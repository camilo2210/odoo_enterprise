<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="form_01_gtgt_xml_export_template">
        <HSoThueDTu xmlns="http://kekhaithue.gdt.gov.vn/TKhaiThue"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <HSoKhaiThue>
                <TTinChung>
                    <TTinDVu>
                        <maDVu><t t-out="service_provider_code"/></maDVu>
                        <tenDVu><t t-out="service_provider_name"/></tenDVu>
                        <pbanDVu><t t-out="service_provider_version"/></pbanDVu>
                        <ttinNhaCCapDVu><t t-out="service_provider_info"/></ttinNhaCCapDVu>
                    </TTinDVu>
                    <TTinTKhaiThue>
                        <TKhaiThue>
                            <maTKhai><t t-out="declaration_code"/></maTKhai>
                            <tenTKhai><t t-out="declaration_name"/></tenTKhai>
                            <moTaBMau/>
                            <pbanTKhaiXML><t t-out="declaration_xml_version"/></pbanTKhaiXML>
                            <loaiTKhai><t t-out="declaration_type"/></loaiTKhai>
                            <soLan><t t-out="submission_count"/></soLan>
                            <KyKKhaiThue>
                                <kieuKy><t t-out="period_type"/></kieuKy>
                                <kyKKhai><t t-out="period_label"/></kyKKhai>
                                <kyKKhaiTuNgay><t t-out="period_date_from"/></kyKKhaiTuNgay>
                                <kyKKhaiDenNgay><t t-out="period_date_to"/></kyKKhaiDenNgay>
                                <kyKKhaiTuThang/>
                                <kyKKhaiDenThang/>
                            </KyKKhaiThue>
                            <maCQTNoiNop/>
                            <tenCQTNoiNop/>
                            <ngayLapTKhai><t t-out="declaration_date"/></ngayLapTKhai>
                            <GiaHan>
                                <maLyDoGiaHan/>
                                <lyDoGiaHan/>
                            </GiaHan>
                            <nguoiKy><t t-out="signatory"/></nguoiKy>
                            <ngayKy><t t-out="sign_date"/></ngayKy>
                            <nganhNgheKD/>
                        </TKhaiThue>
                        <NNT>
                            <mst><t t-out="taxpayer_vat"/></mst>
                            <tenNNT><t t-out="taxpayer_name"/></tenNNT>
                            <dchiNNT><t t-out="taxpayer_address"/></dchiNNT>
                            <phuongXa/>
                            <maHuyenNNT><t t-out="taxpayer_city_code"/></maHuyenNNT>
                            <tenHuyenNNT><t t-out="taxpayer_city_name"/></tenHuyenNNT>
                            <maTinhNNT><t t-out="taxpayer_state_code"/></maTinhNNT>
                            <tenTinhNNT><t t-out="taxpayer_state_name"/></tenTinhNNT>
                            <dthoaiNNT><t t-out="taxpayer_phone"/></dthoaiNNT>
                            <faxNNT/>
                            <emailNNT><t t-out="taxpayer_email"/></emailNNT>
                        </NNT>
                    </TTinTKhaiThue>
                </TTinChung>
                <t t-call="l10n_vn_reports.form_01_gtgt_xml_export_main_section"/>
                <PLuc t-if="appendix_142">
                    <t t-call="l10n_vn_reports.form_01_gtgt_xml_export_appendix_142"/>
                </PLuc>
            </HSoKhaiThue>
        </HSoThueDTu>
    </template>

    <template id="form_01_gtgt_xml_export_main_section">
        <CTieuTKhaiChinh>
            <ma_NganhNghe><t t-out="business_activity_code"/></ma_NganhNghe>
            <ten_NganhNghe><t t-out="business_activity_label"/></ten_NganhNghe>
            <tieuMucHachToan>1701</tieuMucHachToan>
            <Header>
                <ct09><t t-out="ct09"/></ct09>
                <ct10><t t-out="ct10"/></ct10>
                <DiaChiHDSXKDKhacTinhNDTSC>
                    <ct11a_phuongXa_ma><t t-out="ct11a_code"/></ct11a_phuongXa_ma>
                    <ct11a_phuongXa_ten><t t-out="ct11a_name"/></ct11a_phuongXa_ten>
                    <ct11b_quanHuyen_ma><t t-out="ct11b_code"/></ct11b_quanHuyen_ma>
                    <ct11b_quanHuyen_ten><t t-out="ct11b_name"/></ct11b_quanHuyen_ten>
                    <ct11c_tinhTP_ma><t t-out="ct11c_code"/></ct11c_tinhTP_ma>
                    <ct11c_tinhTP_ten><t t-out="ct11c_name"/></ct11c_tinhTP_ten>
                </DiaChiHDSXKDKhacTinhNDTSC>
            </Header>
            <ct21><t t-out="lines['ct21']"/></ct21>
            <ct22><t t-out="lines['ct22']"/></ct22>
            <GiaTriVaThueGTGTHHDVMuaVao>
                <ct23><t t-out="lines['ct23']"/></ct23>
                <ct24><t t-out="lines['ct24']"/></ct24>
            </GiaTriVaThueGTGTHHDVMuaVao>
            <HangHoaDichVuNhapKhau>
                <ct23a><t t-out="lines['ct23a']"/></ct23a>
                <ct24a><t t-out="lines['ct24a']"/></ct24a>
            </HangHoaDichVuNhapKhau>
            <ct25><t t-out="lines['ct25']"/></ct25>
            <ct26><t t-out="lines['ct26']"/></ct26>
            <HHDVBRaChiuThueGTGT>
                <ct27><t t-out="lines['ct27']"/></ct27>
                <ct28><t t-out="lines['ct28']"/></ct28>
            </HHDVBRaChiuThueGTGT>
            <ct29><t t-out="lines['ct29']"/></ct29>
            <HHDVBRaChiuTSuat5>
                <ct30><t t-out="lines['ct30']"/></ct30>
                <ct31><t t-out="lines['ct31']"/></ct31>
            </HHDVBRaChiuTSuat5>
            <HHDVBRaChiuTSuat10>
                <ct32><t t-out="lines['ct32']"/></ct32>
                <ct33><t t-out="lines['ct33']"/></ct33>
            </HHDVBRaChiuTSuat10>
            <ct32a><t t-out="lines['ct32a']"/></ct32a>
            <TongDThuVaThueGTGTHHDVBRa>
                <ct34><t t-out="lines['ct34']"/></ct34>
                <ct35><t t-out="lines['ct35']"/></ct35>
            </TongDThuVaThueGTGTHHDVBRa>
            <ct36><t t-out="lines['ct36']"/></ct36>
            <ct37><t t-out="lines['ct37']"/></ct37>
            <ct38><t t-out="lines['ct38']"/></ct38>
            <ct39a><t t-out="lines['ct39a']"/></ct39a>
            <ct40a><t t-out="lines['ct40a']"/></ct40a>
            <ct40b><t t-out="lines['ct40b']"/></ct40b>
            <ct40><t t-out="lines['ct40']"/></ct40>
            <ct41><t t-out="lines['ct41']"/></ct41>
            <ct42><t t-out="lines['ct42']"/></ct42>
            <ct43><t t-out="lines['ct43']"/></ct43>
        </CTieuTKhaiChinh>
    </template>

    <template id="form_01_gtgt_xml_export_appendix_142">
        <PL_NQ142_GTGT>
            <HH_DV_MuaVaoTrongKy t-if="appendix_142['purchases']">
                <BangKeTenHHDV t-foreach="appendix_142['purchases']" t-as="row" t-att-ID="str(row_index + 1)">
                    <tenHHDVMuaVao><t t-out="row['name']"/></tenHHDVMuaVao>
                    <giaTriHHDVMuaVao><t t-out="row['base']"/></giaTriHHDVMuaVao>
                    <thueGTGTHHDV><t t-out="row['vat']"/></thueGTGTHHDV>
                </BangKeTenHHDV>
                <tongCongGiaTriHHDVMuaVao><t t-out="appendix_142['purchases_total_base']"/></tongCongGiaTriHHDVMuaVao>
                <tongCongThueGTGTHHDV><t t-out="appendix_142['purchases_total_vat']"/></tongCongThueGTGTHHDV>
            </HH_DV_MuaVaoTrongKy>
            <HH_DV_BanRaTrongKy t-if="appendix_142['sales']">
                <BangKeTenHHDV t-foreach="appendix_142['sales']" t-as="row" t-att-ID="str(row_index + 1)">
                    <tenHHDV><t t-out="row['name']"/></tenHHDV>
                    <giaTriHHDV><t t-out="row['base']"/></giaTriHHDV>
                    <thueSuatTheoQuyDinh>10</thueSuatTheoQuyDinh>
                    <thueSuatSauGiam>8</thueSuatSauGiam>
                    <thueGTGTDuocGiam><t t-out="row['vat']"/></thueGTGTDuocGiam>
                </BangKeTenHHDV>
                <tongCongGiaTriHHDV><t t-out="appendix_142['sales_total_base']"/></tongCongGiaTriHHDV>
                <tongCongThueGTGTDuocGiam><t t-out="appendix_142['sales_total_vat']"/></tongCongThueGTGTDuocGiam>
            </HH_DV_BanRaTrongKy>
            <ChenhLech>
                <ct9><t t-out="appendix_142['difference']"/></ct9>
            </ChenhLech>
        </PL_NQ142_GTGT>
    </template>

</odoo>
