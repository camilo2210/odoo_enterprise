<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_repair_order_form_inherit_quality" model="ir.ui.view">
        <field name="name">repair.form.inherit.quality</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <button name="action_repair_cancel" position="before">
                <button name="action_check_quality" invisible="not quality_check_todo" type="object" string="Quality Checks" class="oe_highlight" data-hotkey="shift+z"/>
                <button name="action_open_quality_alerts" type="object" string="Quality Alert" context="{'default_repair_id': id}" invisible="not quality_check_ids or quality_check_fail and quality_alert_count == 0"/>
                <button name="action_open_quality_alerts" type="object" string="Quality Alert" context="{'default_repair_id': id}" class="oe_highlight" invisible="not quality_check_fail or quality_alert_count != 0"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_open_quality_alerts" type="object" class="oe_stat_button" icon="notifications" icon_class="oi-filled" invisible="quality_alert_count == 0" context="{'search_default_repair_id': id}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_alert_count"/></span>
                        <span class="o_stat_text">Quality Alerts</span>
                    </div>
                </button>
                <button name="action_open_quality_checks" invisible="not quality_check_ids or quality_check_fail or not quality_check_todo" type="object" class="oe_stat_button" icon="check">
                    <span class="o_stat_text">Quality Checks</span>
                </button>
                <button name="action_open_quality_checks" invisible="not quality_check_ids or quality_check_fail or quality_check_todo" type="object" class="oe_stat_button text-success" icon="check">
                    <span class="o_stat_text text-success">Quality Checks</span>
                </button>
                <button name="action_open_quality_checks" invisible="not quality_check_ids or not quality_check_fail" type="object" class="oe_stat_button text-danger" icon="check">
                    <span class="o_stat_text text-danger">Quality Checks</span>
                </button>
            </div>
        </field>
    </record>

    <record id="action_create_quality_check_on_demand" model="ir.actions.server">
        <field name="name">Quality Check</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
action = env['ir.actions.act_window']._for_xml_id('quality_control.quality_check_action_main')
action.update({
    'views': [(False, 'form')],
    'context': {
        'default_repair_id': record.id,
        'default_product_id': record.product_id.id,
    },
})
        </field>
    </record>

</odoo>
