<?xml version="1.0"?>
<odoo>

    <record id="appointment_leave_view_list" model="ir.ui.view">
        <field name="name">appointment.leave.view.list.inherit.pos.appointment</field>
        <field name="model">appointment.leave</field>
        <field name="inherit_id" ref="appointment.appointment_leave_view_list"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="attributes">
                <attribute name="widget">many2many_tags</attribute>
            </field>
        </field>
    </record>

    <record id="appointment_leave_view_form" model="ir.ui.view">
        <field name="name">appointment.leave.view.form.inherit.pos.appointment</field>
        <field name="model">appointment.leave</field>
        <field name="inherit_id" ref="appointment.appointment_leave_view_form"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="attributes">
                <attribute name="widget">many2many_tags</attribute>
            </field>
        </field>
    </record>

</odoo>
