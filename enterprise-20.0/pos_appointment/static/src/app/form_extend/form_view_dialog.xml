<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_appointment.QuickCreateButtons" t-inherit="web.FormViewDialog.ToOne.buttons">
        <xpath expr="//button[hasclass('o_form_button_cancel')]" position="after">
            <div class="d-flex gap-1 ms-auto o_appointment_status_btns_container">
                <button class="btn"
                    t-attf-class="{{ this.getButtonClass('booked') }}"
                    t-on-click="() => this.onClickAppointmentStatus('booked')">
                    Booked
                </button>
                <button class="btn"
                    t-attf-class="{{ this.getButtonClass('attended') }}"
                    t-on-click="() => this.onClickAppointmentStatus('attended')">
                    Check In
                </button>
                <button class="btn"
                    t-attf-class="{{ this.getButtonClass('no_show') }}"
                    t-on-click="() => this.onClickAppointmentStatus('no_show')">
                    No Show
                </button>
            </div>
            <button t-if="this.props.resId"
                class="btn btn-secondary ms-auto"
                t-on-click="() => this.onClickAppointmentStatus('cancelled')">
                <i class="oi oi-filled" data-icon="delete"/>
            </button>
        </xpath>
    </t>
</templates>
