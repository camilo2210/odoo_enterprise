<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_appointment.PosAppointmentControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="after" >
            <span class="booking-label d-flex align-items-center fs-4 ">Bookings</span>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="attributes" >
            <attribute name="t-att-class">{"flex-wrap": this.ui.isSmall}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="attributes">
            <attribute name="t-if">this.pos.accessRight.canCreateBooking</attribute>
        </xpath>
    </t>
</templates>
