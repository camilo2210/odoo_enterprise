<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="planning_shift_ics_description_inherit" inherit_id="planning.planning_shift_ics_description">
        <xpath expr="//t[@name='role']" position="after">
<t t-if="shift['project']">
<t t-if="is_google_url"><b>Project:</b></t>
<t t-else="">Project:</t>
<t t-out="shift['project']"/>
</t>
<t t-if="shift['task']">
<t t-if="is_google_url"><b>Task:</b></t>
<t t-else="">Task:</t>
<t t-out="shift['task']"/>
</t>
        </xpath>
    </template>
</odoo>
