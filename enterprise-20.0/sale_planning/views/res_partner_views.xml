<?xml version="1.0"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sale_planning</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="8"/>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_planning_slots"
                    class="oe_stat_button" type="object"
                    invisible="not scheduled_datetime"
                    groups="planning.group_planning_user"
                    icon="clear_all">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planning</span>
                        <span class="o_stat_value">
                            <field name="scheduled_datetime" nolabel="1"/>
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
