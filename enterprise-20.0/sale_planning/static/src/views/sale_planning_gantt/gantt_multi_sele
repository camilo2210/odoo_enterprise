<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sale_planning.GanttMultiSelectionButtons" t-inherit="web_gantt.GanttMultiSelectionButtons" t-inherit-mode="primary">
        <xpath expr="//button[@data-tooltip='Plan']" position="attributes">
            <attribute name="t-if">
                this.props.reactive.onPlan and this.props.reactive.hasAvailableSOL
            </attribute>
        </xpath>
    </t>

</templates>
