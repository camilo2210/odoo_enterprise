<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_dmfa_view_form_inherit_sandbox" model="ir.ui.view">
        <field name="name">l10n_be_hr_payroll.dmfa.report.inherit.sandbox</field>
        <field name="model">l10n_be.dmfa</field>
        <field name="inherit_id" ref="l10n_be_hr_payroll.l10n_be_dmfa_view_form"/>
        <field name="arch" type="xml">
            <button name="action_post_onss_declaration" position="after">
                <button
                    name="action_open_dmfa_sandbox_answer_wizard"
                    string="Simulate ONSS Answer"
                    type="object"
                    invisible="declaration_method != 'batch' or environment != 'S' or not onss_declaration_count"/>
            </button>
        </field>
    </record>

    <record id="l10n_be_onss_declaration_view_form_inherit_sandbox" model="ir.ui.view">
        <field name="name">l10n.be.onss.declaration.view.form.inherit.sandbox</field>
        <field name="model">l10n.be.onss.declaration</field>
        <field name="inherit_id" ref="l10n_be_hr_payroll.l10n_be_onss_declaration_view_form"/>
        <field name="arch" type="xml">
            <button name="action_test_sftp_connection" position="after">
                <button
                    name="action_open_dmfa_sandbox_answer_wizard"
                    string="Simulate ONSS Answer"
                    type="object"
                    invisible="environment != 'S'"/>
            </button>
        </field>
    </record>
</odoo>
