<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_multiple_payruns_wizard_view_form" model="ir.ui.view">
        <field name="name">test.l10n.be.multiple.payruns.wizard.view.form</field>
        <field name="model">test.l10n.be.multiple.payruns</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': 1, 'no_quick_create': 1}" placeholder="Select a company for this Pay Run" domain="[('id', 'in', allowed_company_ids)]" invisible="context.get('allowed_company_ids', []).length &lt; 2"/>
                        <field name="employee_type_ids" widget="many2many_tags" placeholder="All employee types"/>
                        <field name="structure_domain" invisible="1"/> <!-- Used to dynamically filter the structure_id domain -->
                        <field name="structure_id" domain="structure_domain" placeholder="Select a structure"/>
                        <label for="date_start" string="Period"/>
                        <div class="o_row">
                            <field name="date_start" class="oe_inline"/>
                            <i class="oi mx-2" data-icon="east" aria-label="Arrow icon" title="Arrow"/>
                            <field name="date_end" class="oe_inline" readonly="(not date_start)"/>
                        </div>
                        <button name="action_prepare_monthly_batches" string="Continue" type="object" class="btn btn-primary"/>
                    </group>
                </sheet>
                <footer/>
            </form>
        </field>
    </record>
</odoo>
