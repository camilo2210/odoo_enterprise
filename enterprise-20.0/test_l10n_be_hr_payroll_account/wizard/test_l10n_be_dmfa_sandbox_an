<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="test_l10n_be_dmfa_sandbox_answer_view_form" model="ir.ui.view">
        <field name="name">test.l10n.be.dmfa.sandbox.answer.view.form</field>
        <field name="model">test.l10n.be.dmfa.sandbox.answer</field>
        <field name="arch" type="xml">
            <form string="Simulate ONSS Answer">
                <div role="alert" class="alert alert-info">
                    Sandbox mode: adapt the sample XML below (or paste your own) to craft the
                    answer the ONSS would send back for this Test Declaration (S). It will be
                    processed exactly like a real answer fetched from the ONSS SFTP server.
                </div>
                <group>
                    <group>
                        <field name="onss_declaration_id" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="batch_declaration_id"/>
                        <field name="declaration_state"/>
                    </group>
                </group>
                <field name="answer_xml" widget="code" options="{'mode': 'xml'}"/>
                <footer>
                    <button name="action_simulate_answer" string="Process Answer" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
