<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.inter.company.rules</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_purchase_inter_company_rules.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='module_inter_company_rules_set_so_po']" position="after">
                <div groups="base.group_no_one">
                    <field name="intercompany_sync_delivery_receipt" class="o_light_label oe_inline"/>
                    <label for="intercompany_sync_delivery_receipt" class="oe_inline o_light_label ps-1 me-0"/>
                    <div class="oi" data-icon="help" title="When confirming an Sale or Purchase Order with another company, will try to link the delivery/receipt with its corresponding receipt/delivery in the other company."/>
                </div>
                <div>
                    <p class="text-muted">
                        Route to resupply a company/branch's warehouse from another's via transfers (without SO/PO link) can be activated in the warehouse.
                    </p>
                    <div class="mt8" invisible="not group_stock_adv_location">
                        <button name="%(stock.action_warehouse_form)d" data-icon="east" type="action" string="Configure Warehouses" class="btn-link"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
