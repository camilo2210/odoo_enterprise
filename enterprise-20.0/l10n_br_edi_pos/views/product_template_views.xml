<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="l10n_br_edi.product_template_view_form"/>
        <field name="arch" type="xml">
            <div name="taxes_div" position="after">
                <field string="" name="l10n_br_pos_warning" class="alert alert-warning" role="alert" invisible="'BR' not in fiscal_country_codes or not l10n_br_pos_warning"/>
            </div>
            <field name="l10n_br_operation_type_purchases_id" position="after">
                <field name="l10n_br_operation_type_pos_id" invisible="'BR' not in fiscal_country_codes or not available_in_pos or l10n_br_transport_cost_type"/>
            </field>
        </field>
    </record>
</odoo>
