<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="obox_kiosk_pin_wizard_form" model="ir.ui.view">
        <field name="name">obox.kiosk.pin.wizard.form</field>
        <field name="model">obox.kiosk.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Kiosk PIN">
                <p class="text-muted">
                    The PIN unlocks the admin screen on the device.
                </p>
                <group>
                    <field name="kiosk_pin" password="True"/>
                    <field name="kiosk_pin_confirm" password="True"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Set PIN" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
