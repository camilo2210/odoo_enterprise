<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_departure_view_form_inherit_l10n_in" model="ir.ui.view">
        <field name="name">hr.employee.departure.view.form.inherit.l10n_in</field>
        <field name="model">hr.employee.departure</field>
        <field name="inherit_id" ref="hr.hr_employee_departure_view_form"/>
        <field name="arch" type="xml">
            <group name="header_group" position="after">
                <notebook invisible="country_code != 'IN'">
                <page string="Notice Period" name="l10n_in_notice_period">
                    <group>
                        <field name="l10n_in_notice_period_start"/>
                        <field name="departure_date" string="Notice Period End"/>
                        <field name="l10n_in_notice_duration"/>
                    </group>
                </page>
                </notebook>
            </group>
            <button special="save" position="attributes">
                <attribute name="invisible" add="country_code == 'IN'" separator="or"/>
            </button>
            <button special="save" position="after">
                <button name="action_schedule" string="Schedule" type="object" class="oe_highlight"
                    invisible="apply_immediately or country_code != 'IN'"/>
            </button>
            <button name="action_register" position="attributes">
                <attribute name="invisible" add="country_code == 'IN'" separator="or"/>
            </button>
            <button name="action_register" position="after">
                <button name="action_register" string="Apply &amp; FNF Payslip" type="object" class="oe_highlight"
                    invisible="not apply_immediately or country_code != 'IN'"/>
            </button>
        </field>
    </record>
</odoo>
