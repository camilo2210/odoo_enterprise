<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_salary_statement">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div t-if="report_data" class="page">
                    <h2>
                        <span t-field="employee.company_id">IN Company</span>
                    </h2>
                    <h2>Salary Statement Report,
                    <span t-out="report_data['month']">May</span>
                    <span t-out="report_data['year']">2024</span>
                    </h2>
                    <div class="border-bottom border-dark my-2"></div>
                    <table class="table table-sm table-borderless my-2">
                        <tbody>
                            <tr>
                                <td class="pe-0"><strong>Employee Name</strong> :</td>
                                <td class="ps-0"><span t-field="employee.name">Lakshya</span></td>
                                <td class="pe-0"><strong>Date of Joining</strong> :</td>
                                <td class="ps-0"><span t-field="employee.version_id.date_start">01/01/2024</span></td>
                            </tr>
                            <tr>
                                <td class="pe-0"><strong>Designation</strong> :</td>
                                <td class="ps-0"><span t-field="employee.job_title">Software Developer</span></td>
                                <td class="pe-0"><strong>Salary Effective from</strong> :</td>
                                <td class="ps-0"><span t-out="report_data['date']">01/05/2024</span></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="border-bottom border-dark my-2"></div>
                    <div class="p-2 fw-bold rounded my-2 o_salary_statement_report_header_bg">
                        <span t-out="report_data['structure'].name"/>
                    </div>

                    <table class="table table-sm table-borderless">
                        <thead style="display: table-row-group;">
                            <tr class="border-bottom border-dark">
                                <th class="text-start fw-bold">Salary Components</th>
                                <th class="text-end fw-bold">Monthly Amount (₹)</th>
                                <th class="text-end fw-bold">Yearly Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-bottom o_salary_statement_report_grey_border">
                                <td colspan="3"><h5 class="mb-0 mt-2"><strong>Allowance:</strong></h5></td>
                            </tr>
                            <t t-foreach="report_data['allow_rules']" t-as="rule">
                                <t t-set="value" t-value="report_data['allow_rules'][rule]"/>
                                <tr class="border-bottom o_salary_statement_report_grey_border">
                                    <td><t t-out="value['name']">Basic Salary</t></td>
                                    <td class="text-end"><t t-out="value['total']"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        10000</t>
                                    </td>
                                    <td class="text-end"><t t-out="round(value['total_annual'],2)"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        120000</t>
                                    </td>
                                </tr>
                            </t>
                            <tr class="border-bottom o_salary_statement_report_grey_border">
                                <td colspan="3"><h5 class="mb-0 mt-2"><strong>Deduction:</strong></h5></td>
                            </tr>
                            <t t-foreach="report_data['deduct_rules']" t-as="rule">
                                <t t-set="value" t-value="report_data['deduct_rules'][rule]"/>
                                <tr class="border-bottom o_salary_statement_report_grey_border">
                                    <td><t t-out="value['name']">PF</t></td>
                                    <td class="text-end">
                                        <t t-out="value['total']"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        -1000</t>
                                    </td>
                                    <td class="text-end">
                                        <t t-out="round(value['total_annual'],2)"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        -12000</t>
                                    </td>
                                </tr>
                            </t>
                            <tr class="border-bottom o_salary_statement_report_grey_border">
                                <td>Total Deduction</td>
                                <td class="text-end">
                                    <t t-out="report_data['total_deduct_monthly']"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}"/>
                                </td>
                                <td class="text-end">
                                    <t t-out="report_data['total_deduct_yearly']"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}"/>
                                </td>
                            </tr>
                            <tr class="border-bottom border-dark">
                                <td><strong>Net Salary</strong></td>
                                <td class="text-end">
                                    <strong><t t-out="report_data['net_salary']"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        10000</t>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong><t t-out="round(report_data['net_salary_annual'],2)"
                                        t-options="{'widget': 'monetary', 'display_currency': report_data['currency']}">
                                        120000</t>
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
