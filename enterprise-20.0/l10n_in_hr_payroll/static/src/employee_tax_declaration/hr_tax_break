<?xml version="1.0" encoding="utf-8"?>
<template xml:space="preserve">
    <t t-name="l10n_in_hr_payroll.hr_tax_breakup_popover">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>Income Tax Slab</th>
                    <th>Tax Rate</th>
                    <th>Tax Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="this.props.taxBreakup" t-as="rate" t-key="rate.id">
                    <tr>
                        <td><t t-out="rate.lower_limit"/> to <t t-out="rate.upper_limit"/></td>
                        <td class="text-end"><t t-out="rate.tax_rate"/>%</td>
                        <td class="text-end"><t t-out="rate.tax_amount"/></td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2" class="fw-bold">Total Tax Amount</td>
                    <td class="fw-bold"><t t-out="this.props.totalTax"/></td>
                </tr>
            </tfoot>
        </table>
    </t>
</template>
