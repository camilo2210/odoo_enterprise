<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t
        t-name="l10n_in_hr_payroll.ChallanPayslipListController.Buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="." position="inside">
            <button
                class="btn btn-primary"
                t-on-click="this.onAddToChallan"
                t-att-disabled="this.model.root.selection.length &lt; 1 || this.state.disabled"
            >
                Add to Challan
            </button>
            <button class="btn btn-secondary" t-on-click="this.onDiscard" t-att-disabled="this.state.disabled">
                Discard
            </button>
        </xpath>
    </t>
</templates>
