<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="l10n_in_hr_payroll.Form138KanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="class">o_form_138_kanban o_renderer flex-grow-1 justify-content-center</attribute>
        </xpath>
    </t>

    <t t-name="l10n_in_hr_payroll.Form138KanbanHeader" t-inherit="web.KanbanHeader" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o_column_unfold')]" position="replace">
        </xpath>
        <xpath expr="//div[hasclass('o_column_title')][2]" position="attributes">
            <attribute name="class" remove="text-900" add="fw-medium py-2 cursor-pointer" separator=" "/>
            <attribute name="t-on-click.stop">this.group.toggle.bind(this.group)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_column_title')][2]/*[1]" position="before">
            <i class="align-self-center oi" data-icon="arrow_drop_down"/>
        </xpath>
        <xpath expr="//div[hasclass('o_column_title')][1]" position="attributes">
            <attribute name="class" remove="lh-1 pt-1" add="fw-medium cursor-pointer" separator=" "/>
            <attribute name="t-on-click.stop">this.group.toggle.bind(this.group)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_column_title')][1]/*[1]" position="before">
            <i class="align-self-center oi" data-icon="arrow_right"/>
        </xpath>
        <xpath expr="//t[@t-out='this.odoomark(this.group.displayName)']" position="replace">
            <span class="text-truncate" t-out="this.odoomark(this.group.displayName)"/>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_header')]" position="attributes">
            <attribute name="class" remove="position-sticky" separator=" "/>
        </xpath>
    </t>
</templates>
