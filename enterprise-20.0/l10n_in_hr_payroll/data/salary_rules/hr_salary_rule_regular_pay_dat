    <record id="l10n_in_hr_salary_rule_pt" model="hr.salary.rule">
        <field name="code">PT</field>
        <field name="name">Professional Tax</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.DED')])]"/>
        <field name="sequence" eval="104"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(version.l10n_in_pt and version.pt_rule_parameter_id and payslip._l10n_in_apply_professional_tax_deduction('PT'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = 0
tax_slabs = payslip._rule_parameter(version.pt_rule_parameter_id.code)
if isinstance(tax_slabs, dict):
    gender = version.sex if version.sex in ['male', 'female'] else 'male'
    slabs = tax_slabs.get(gender, [])
else:
    slabs = tax_slabs
for amount, (lower, upper) in slabs:
    if float(lower) &lt;= categories['GROSS'] &lt;= float(upper):
        result = -amount
        break
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_in_hr_payroll.hr_payroll_structure_in_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.in"/>
    </record>

