<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aw_rule_github" model="aw.rule">
        <field name="sequence">10</field>
        <field name="name">Github</field>
        <field name="regex">(.+) (?:by .*) · Pull Request #\d+ · (.+)\|https:\/\/github\.com</field>
        <field name="type">development</field>
        <field name="template">Working on $2</field>
        <field name="description">Working on $1</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_gmail_inbox" model="aw.rule">
        <field name="sequence">20</field>
        <field name="name">Gmail</field>
        <field name="regex">https:\/\/mail\.google\.com\/.+inbox</field>
        <field name="type">email</field>
        <field name="template">Reading Emails</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_gmail_inbox_group" model="aw.rule">
        <field name="sequence">22</field>
        <field name="name">Google Chat</field>
        <field name="regex">^(.+)\s-\s(?:Chat|.*\s-\s.*)\|https:\/\/(?:chat|mail)\.google\.com\/(?:app\/chat\/[A-Za-z0-9_-]+|.+chat)</field>
        <field name="type">messaging</field>
        <field name="template">Messaging $1</field>
        <field name="always_active" eval="0"/>
        <field name="side_activity" eval="1"/>
    </record>

    <record id="aw_rule_gmail_home_inbox_group" model="aw.rule">
        <field name="sequence">23</field>
        <field name="name">Google Chat Home</field>
        <field name="regex">^(?:.+)\|https:\/\/(?:chat|mail)\.google\.com\/(?:.+chat\/home|app\/home)</field>
        <field name="type">messaging</field>
        <field name="template">Google Chat</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_gdoc" model="aw.rule">
        <field name="sequence">30</field>
        <field name="name">Google Docs</field>
        <field name="regex">(.+) - Google\sDocs\|https:\/\/docs\.google\.com</field>
        <field name="type">document</field>
        <field name="template">Working on $1</field>
        <field name="always_active" eval="0"/>
    </record>

     <record id="aw_rule_gsheet" model="aw.rule">
        <field name="sequence">31</field>
        <field name="name">Google Sheets</field>
        <field name="regex">(.+) - Google\sSheets\|https:\/\/docs\.google\.com</field>
        <field name="type">spreadsheet</field>
        <field name="template">Working on $1</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_gslide" model="aw.rule">
        <field name="sequence">32</field>
        <field name="name">Google Slides</field>
        <field name="regex">(.+) - Google\sSlides\|https:\/\/docs\.google\.com</field>
        <field name="type">presentation</field>
        <field name="template">Working on $1</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_discord" model="aw.rule">
        <field name="sequence">40</field>
        <field name="name">Discord</field>
        <field name="regex">^(.+)\s-\s*Discord\|</field>
        <field name="type">messaging</field>
        <field name="template">Messaging $1</field>
        <field name="always_active" eval="0"/>
        <field name="side_activity" eval="1"/>
    </record>

    <record id="aw_rule_discord_web" model="aw.rule">
        <field name="sequence">42</field>
        <field name="name">Discord (web)</field>
        <field name="regex">(?:\(\d+\)\s)?Discord\s\|\s(.*?)\|https:\/\/discord\.com\/channels\/.*</field>
        <field name="type">messaging</field>
        <field name="template">Messaging $1</field>
        <field name="always_active" eval="0"/>
        <field name="side_activity" eval="1"/>
    </record>

    <record id="aw_rule_odoo_discuss" model="aw.rule">
        <field name="sequence">45</field>
        <field name="name">Odoo Discuss Chat</field>
        <field name="regex">^(?:\(\d+\)\s)?(?:(.+)\|)?https:\/\/(?:www\.)?(?!(?:www|runbot|pad|mergebot)\.)[^\/]+\/odoo\/(?:.+\/|)discuss</field>
        <field name="type">messaging</field>
        <field name="template">Messaging $1</field>
        <field name="always_active" eval="0"/>
        <field name="side_activity" eval="1"/>
    </record>

    <record id="aw_rule_odoo_main" model="aw.rule">
        <field name="sequence">50</field>
        <field name="name">Odoo Database</field>
        <field name="regex">https:\/\/(?:www\.)?(?!(?:www|runbot|pad|mergebot)\.)([^\/.]+)(?:\.[^\/.]+)*\.odoo\.com(?:\/\S*)?</field>
        <field name="type">odoo</field>
        <field name="template">Working on database: $1</field>
        <field name="always_active" eval="0"/>
    </record>
    <record id="aw_rule_odoo_discuss_inbox" model="aw.rule">
        <field name="sequence">44</field>
        <field name="name">Odoo Discuss Inbox</field>
        <field name="regex">^(?:\(\d+\)\s)?(?:(.+)\|)?https:\/\/(?:www\.)?(?!(?:www|runbot|pad|mergebot)\.)[^\/]+\/odoo\/(?:.*\/|)discuss\?.*active_id=mail\.</field>
        <field name="type">messaging</field>
        <field name="template">Checking $1</field>
        <field name="always_active" eval="0"/>
        <field name="side_activity" eval="1"/>
    </record>

    <record id="aw_rule_google_meet" model="aw.rule">
        <field name="sequence">60</field>
        <field name="name">Google Meet</field>
        <field name="regex">Meet [-–] (.*)\|https:\/\/meet\.google\.com(?!landing.*)</field>
        <field name="type">meeting</field>
        <field name="template">Google Meet: $1</field>
        <field name="always_active" eval="1"/>
    </record>

    <record id="aw_rule_excalidraw" model="aw.rule">
        <field name="sequence">70</field>
        <field name="name">Excalidraw</field>
        <field name="regex">(.+?)(?: — Excalidraw Plus)?\|https:\/\/(?:app\.)?excalidraw\.com</field>
        <field name="type">document</field>
        <field name="template">Working on $1</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_youtube" model="aw.rule">
        <field name="sequence">80</field>
        <field name="name">Youtube</field>
        <field name="regex">^(.+)(?:\s-\sYouTube)\|https:\/\/www\.youtube\.com\/watch\?</field>
        <field name="type">presentation</field>
        <field name="template">$1</field>
        <field name="always_active" eval="1"/>
    </record>

    <record id="aw_rule_public_documentation" model="aw.rule">
        <field name="sequence">90</field>
        <field name="name">Documentation</field>
        <field name="regex">^(.+)\s—\s(?:.+)\|https:\/\/www\.odoo\.com\/documentation</field>
        <field name="type">document</field>
        <field name="template">Reading documentation on "$1"</field>
        <field name="always_active" eval="0"/>
    </record>

    <record id="aw_rule_e_learning" model="aw.rule">
        <field name="sequence">100</field>
        <field name="name">eLearning</field>
        <field name="regex">^(.+)\s\|\s(?:.+)\|https:\/\/www\.odoo\.com\/(?:.+?\/|)slides</field>
        <field name="type">presentation</field>
        <field name="template">Learning about "$1"</field>
        <field name="always_active" eval="1"/>
    </record>
    <record id="aw_rule_zoom" model="aw.rule">
        <field name="sequence">110</field>
        <field name="name">Zoom (web)</field>
        <field name="regex">(.+)\|https:\/\/app\.zoom\.us\/</field>
        <field name="type">meeting</field>
        <field name="template">$1</field>
        <field name="always_active" eval="1"/>
    </record>
    <record id="aw_rule_zoom_app" model="aw.rule">
        <field name="sequence">110</field>
        <field name="name">Zoom (app)</field>
        <field name="regex">Meeting\|[Zz]oom(?:\.exe)?$</field>
        <field name="type">meeting</field>
        <field name="template">Zoom Meeting</field>
        <field name="always_active" eval="1"/>
    </record>
</odoo>
