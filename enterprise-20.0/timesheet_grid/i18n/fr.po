#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add a description</b> <br/> <i>Briefly summarize your activity, e.g., "
"\"Metting with the customer.\"</i>"
msgstr ""
"<b>Ajouter une description</b> <br/> <i>Résumez brièvement votre activité, "
"par exemple : \"Réunion avec le client.\"</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add time in the Grid view</b> <br/> <i>Click a cell to enter hours. Press "
"Tab or Enter to navigate easily.</i>"
msgstr ""
"<b>Ajouter du temps dans la vue Grille</b> <br/> <i>Cliquez sur une cellule "
"pour saisir des heures. Appuyez sur Tab ou Entrée pour naviguer facilement.</"
"i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Create the timesheet</b> <br/> <i>Once saved, the timer automatically "
"restarts for your next activity.</i>"
msgstr ""
"<b>Créer la feuille de temps</b> <br/> <i>Une fois enregistrée, le minuteur "
"redémarre automatiquement pour votre prochaine activité.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Select a project</b> <br/> <i>Choose the relevant project, such as a "
"customer or team project.</i>"
msgstr ""
"<b>Sélectionner un projet</b> <br/> <i>Choisissez le projet pertinent, comme "
"un projet client ou d'équipe.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Start managing your timesheets</b> <br/> <i>Everything you track begins "
"here.</i>"
msgstr ""
"<b>Commencer à gérer vos feuilles de temps</b> <br/> <i>Tout ce que vous "
"suivez commence ici.</i>"

#. module: timesheet_grid
#: model_terms:digest.tip,tip_description:timesheet_grid.digest_tip_timesheet_grid_0
msgid "<b>Tip: Let the Timesheets Assistant do the hard work</b>"
msgstr ""

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Use the timer to track your activities</b> <br/> <i>Start the timer, then "
"log a timesheet when your activity ends. It restarts automatically for the "
"next task.</i>"
msgstr ""
"<b>Utiliser le minuteur pour suivre vos activités</b> <br/> <i>Démarrez le "
"minuteur, puis enregistrez une feuille de temps lorsque votre activité se "
"termine. Il redémarre automatiquement pour la tâche suivante.</i>"

