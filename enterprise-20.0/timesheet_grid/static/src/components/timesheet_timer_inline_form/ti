<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="timesheet_grid.TimesheetTimerInlineForm" t-inherit="timesheet_grid.TimesheetInlineForm" t-inherit-mode="primary">
        <div name="unit_amount_field_container" position="attributes">
            <attribute name="class" add="o_wrap_input_full_width" separator=" "/>
        </div>
        <label name="name_label" position="attributes">
            <attribute name="class" add="d-md-none" separator=" "/>
        </label>
        <label name="name_label" position="after">
            <i class="d-none d-md-inline oi oi-fw oi-filled" data-icon="chat_bubble"/>
        </label>
        <label name="project_id_label" position="attributes">
            <attribute name="class" add="d-md-none" separator=" "/>
        </label>
        <label name="project_id_label" position="after">
            <i class="d-none d-md-inline oi oi-fw" data-icon="checklist"/>
        </label>
        <label name="task_id_label" position="attributes">
            <attribute name="class" add="d-md-none" separator=" "/>
        </label>
        <label name="unit_amount_label" position="attributes">
            <attribute name="class" add="d-md-none" separator=" "/>
        </label>
        <label name="unit_amount_label" position="after">
            <i class="d-none d-md-inline oi oi-fw" data-icon="schedule"/>
        </label>
    </t>
</templates>
