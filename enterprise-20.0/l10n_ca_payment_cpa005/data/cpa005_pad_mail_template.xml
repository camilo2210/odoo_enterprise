<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="email_template_cpa005_pad_mandate" model="mail.template">
            <field name="name">CPA 005 PAD Agreement Sending</field>
            <field name="description">Email requesting the customer to sign the PAD agreement attached</field>
            <field name="model_id" ref="account_direct_debit.model_account_mandate_send_wizard"/>
            <field name="subject">{{ object.partner_id.display_name }} Pre-Authorized Debit (PAD) Agreement</field>
            <field name="use_default_to" eval="True"/>
            <field name="lang">{{ object.partner_id.lang or user.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.display_name or ''">Azure Interior</t>
                        <br/><br/>
                        Please find attached your Pre-Authorized Debit (PAD) Agreement to sign, authorizing
                        <t t-out="object.company_id.display_name or ''">YourCompany</t>
                        to debit your bank account for the amounts due on your invoices in accordance with the agreement.
                        Do not hesitate to contact us if you have any questions.
                        <br/>
                        Best regards,
                        <t t-if="not is_html_empty(user.signature)">
                            <br/><br/>
                            <div>--<br/><t t-out="user.signature">Mitchell Admin</t></div>
                        </t>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
