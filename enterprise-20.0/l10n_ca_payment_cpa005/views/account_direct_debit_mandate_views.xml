<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_direct_debit_mandate_form_inherit_l10n_ca_payment_cpa005" model="ir.ui.view">
        <field name="name">account.direct.debit.mandate.form.inherit.l10n_ca_payment_cpa005</field>
        <field name="model">account.direct.debit.mandate</field>
        <field name="inherit_id" ref="account_direct_debit.account_direct_debit_mandate_form"/>
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="after">
                <field name="l10n_ca_cpa005_pad_category"
                       readonly="state != 'draft'"
                       invisible="mandate_type != 'cpa005_pad'"
                       required="mandate_type == 'cpa005_pad'"/>
            </field>
        </field>
    </record>
</odoo>
