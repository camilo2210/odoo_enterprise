<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.PivotRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pivot')]" position="attributes">
            <attribute name="t-ref">this.rootRef</attribute>
        </xpath>

        <xpath expr="//td[hasclass('o_pivot_cell_value')]" position="attributes">
            <attribute name="class" remove="bg-100" separator=" "/>
        </xpath>
    </t>

    <t t-inherit="web.PivotHeader.title" t-inherit-mode="extension">
        <xpath expr="//th" position="attributes">
            <attribute name="class" remove="bg-view" separator=" "/>
        </xpath>
    </t>

    <t t-inherit="web.PivotMeasure" t-inherit-mode="extension">
        <xpath expr="//th" position="attributes">
            <attribute name="class" remove="bg-view" separator=" "/>
        </xpath>
    </t>

</templates>
