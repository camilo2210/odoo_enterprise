.o-form-buttonbox { 
  --o-stat-button-color: currentColor;
  --o-stat-text-color: #{o-text-color('primary')};

  .o_bottom_sheet & {
    --o-stat-button-border-color: #{$o-gray-400};
  }

  .btn-outline-secondary {
    --#{$prefix}btn-hover-border-color: #{$o-gray-400};
  }

  &.o_dropdown_more .btn-outline-secondary {
    --#{$prefix}btn-hover-bg: #{$dropdown-link-hover-bg};
  }
}
