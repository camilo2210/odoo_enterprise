<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-inherit="web.CalendarSidePanel" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_calendar_sidepanel_container')]" position="attributes">
        <attribute name="class" remove="bg-view" add="px-0 pe-md-3" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_calendar_unschedule_zone')]" position="attributes">
        <attribute name="class" remove="m-3" add="rounded-4 mb-3" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_calendar_sidepanel_content')]" position="attributes">
        <attribute name="class" add="px-md-0 me-md-2" separator=" "/>
    </xpath>
</t>

</templates>
