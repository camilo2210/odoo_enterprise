<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-inherit="web.ControlPanel" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_control_panel_actions')]" position="attributes">
        <attribute name="class" add="h-lg-100" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="attributes">
        <attribute name="class" add="align-items-lg-center" separator=" "/>
    </xpath>
    <xpath expr="//nav[hasclass('o_cp_switch_buttons')]" position="attributes">
        <attribute name="class" add="o_switcher" separator=" "/>
        <attribute name="t-attf-style">
            --SwitchButtons-activeIndex: {{ this.activeViewIndex }};
            --SwitchButtons-count: {{ this.env.config.viewSwitcherEntries.length }};
            --SwitchButtons-slideFrom: {{ this.slideFromIndex }};
        </attribute>
    </xpath>
</t>

</templates>
