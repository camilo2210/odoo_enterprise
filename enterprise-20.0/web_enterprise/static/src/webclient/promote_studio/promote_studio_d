<?xml version="1.0" encoding="UTF-8"?>
<template>

    <t t-name="web_enterprise.PromoteStudioDialog">
        <Dialog title="this.props.title" modalRef="this.modalRef">
            <div class="modal-studio">
                <div id="studio_install_dialog"
                    class="d-flex flex-row align-items-center flex-wrap">
                    <div id="studio_dialog_pitch"
                        class="w-100 w-md-50">
                        <h4>Want to tailor-make your Odoo?</h4>
                        <p>Unleash the power of Odoo Studio:</p>
                        <ul>
                            <li>Automate jobs</li>
                            <li>Customize any screen</li>
                            <li>Auto-fill fields with AI</li>
                            <li>Customize or build new reports</li>
                            <li>Build new apps from scratch</li>
                            <li>Define webhooks</li>
                            <li>and more!</li>
                        </ul>
                    </div>
                    <div id="studio_video" class="o_video_embed w-100 w-md-50 ratio ratio-16x9">
                        <iframe class="embed-responsive-item"
                            t-attf-src="https://www.youtube.com/embed/IRbj-SzTcrY?autoplay=1"
                            allow="autoplay" frameborder="0" allowfullscreen="true" />
                    </div>
                </div>

                <t t-set-slot="footer">
                    <button class="btn btn-primary o_install_studio"
                        t-on-click.stop="this.onClickInstallStudio"
                        data-tooltip="Install Odoo Studio and its dependencies">
                        Start using Odoo Studio
                    </button>

                    <a role="button" class="btn btn-secondary"
                        href="https://www.odoo.com/app/studio" target="_blank"> Learn More <i
                            class="oi" data-icon="open_in_new" />
                    </a>

                    <button class="btn btn-secondary"
                        t-on-click="this.props.close">
                        Discard
                    </button>
                </t>
            </div>
        </Dialog>
    </t>


    <t t-name="web_enterprise.PromoteStudioAutomationDialog"
        t-inherit="web_enterprise.PromoteStudioDialog" t-inherit-mode="primary">
        <xpath expr="//div[@id='studio_video']" position="replace">
            <img class="w-100 w-md-50"
                src="/web_enterprise/static/img/automation.svg" />
        </xpath>
    </t>

</template>
