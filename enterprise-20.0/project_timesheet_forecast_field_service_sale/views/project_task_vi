<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form" model="ir.ui.view">
        <field name="name">project.task.view.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_forecast.project_task_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_get_project_forecast_by_user']" position="before">
                <button
                    class="oe_stat_button"
                    icon="clear_all"
                    name="action_get_project_forecast_by_user"
                    type="object"
                    context="{'default_task_id': id, 'default_project_id': project_id}"
                    invisible="scheduled_datetime or not project_id"
                    groups="planning.group_planning_manager"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">To Schedule</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
