<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="vies_summary_export_template">
        <dokument>
            <hlavicka>
                <identifikacneCislo>
                    <kodStatu t-out="header['kod_statu']"/>
                    <dic t-out="header['dic']"/>
                </identifikacneCislo>
                <danovyUrad t-out="header['danovy_urad']"/>
                <druhSV>
                    <riadny t-out="header['riadny']"/>
                    <opravny t-out="header['opravny']"/>
                    <dodatocny t-out="header['dodatocny']"/>
                </druhSV>
                <obdobie>
                    <mesiac t-out="header['mesiac']"/>
                    <stvrtrok t-out="header['stvrtrok']"/>
                    <rok t-out="header['rok']"/>
                </obdobie>
                <obchodneMeno>
                    <riadok t-foreach="header['obchodne_meno']" t-as="name_line" t-out="name_line"/>
                </obchodneMeno>
                <adresa>
                    <ulica t-out="header['ulica']"/>
                    <cislo t-out="header['cislo']"/>
                    <psc t-out="header['psc']"/>
                    <obec t-out="header['obec']"/>
                    <tel t-out="header['tel']"/>
                    <email t-out="header['email']"/>
                </adresa>
                <celkovaHodnota t-out="header['celkova_hodnota']"/>
                <konatel t-out="header['konatel']"/>
                <konatelTel t-out="header['konatel_tel']"/>
                <konatelEmail t-out="header['konatel_email']"/>
                <datumVyhlasenia>
                    <den t-out="header['datum_den']"/>
                    <mesiac t-out="header['datum_mesiac']"/>
                    <rok t-out="header['datum_rok']"/>
                </datumVyhlasenia>
            </hlavicka>
            <telo>
                <t t-foreach="pages" t-as="page">
                    <strana>
                        <t t-foreach="page" t-as="line">
                            <zaznam>
                                <kodStatu t-out="line.get('country_code', '')"/>
                                <idCislo t-out="line.get('vat_number', '')"/>
                                <hodnota t-out="line.get('total_value', '')"/>
                                <kod t-out="line.get('transaction_code', '')"/>
                            </zaznam>
                        </t>
                        <t t-foreach="range(12)" t-as="i">
                            <zaznamCast2>
                                <kodStatu/>
                                <idCislo/>
                                <idCislo2/>
                                <vratenieTovaru/>
                                <oprava/>
                            </zaznamCast2>
                        </t>
                    </strana>
                </t>
            </telo>
        </dokument>
    </template>
</odoo>
