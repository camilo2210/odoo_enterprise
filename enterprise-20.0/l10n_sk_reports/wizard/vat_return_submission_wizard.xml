<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_sk_reports_vat_return_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_sk_reports.vat.return.submission.wizard.form</field>
            <field name="model">l10n_sk_reports.vat.return.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group id="instructions">
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download the VAT statement</span><br/>
                                    <button string="Download XML" name="print_xml" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <li>Log in to <a href="https://www.financnasprava.sk/sk/titulna-stranka" target="_blank">Finančná správa</a> using eID or KEP.</li>
                            <li>Open the Catalog of Forms, choose VAT Return (DP DPH), then use Load from file (Načítať zo súboru) to upload your XML.</li>
                            <li>Click Check (Kontrolovať), then electronically sign the form.</li>
                            <li>Validate the VAT return</li>
                        </ol>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
