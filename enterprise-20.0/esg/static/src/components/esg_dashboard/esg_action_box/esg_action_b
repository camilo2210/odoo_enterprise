<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="esg.ActionBox">
        <div class="card p-3">
            <div class="d-flex justify-content-start mb-2">
                <a href="#" class="fs-4 fw-bold" t-on-click="() => this.openActions()">
                    Actions
                </a>
            </div>

            <div class="d-flex justify-content-start mb-2 pt-2 gap-1">
                <button class="btn btn-primary" t-on-click="this.openActionForm">
                    Create Action
                </button>
            </div>

            <div class="d-flex justify-content-around mt-auto">
                <a href="#" class="d-flex flex-column align-items-center fs-4" t-on-click="() => this.openActions('reached')">
                    <span class="fw-bold"><t t-out="this.props.data.reached_count"/></span>
                    <span class="text-muted">Reached</span>
                </a>
                <a href="#" class="d-flex flex-column align-items-center fs-4" t-on-click="() => this.openActions('not_reached')">
                    <span class="fw-bold"><t t-out="this.props.data.not_reached_count"/></span>
                    <span class="text-muted">Not Reached</span>
                </a>
                <a href="#" class="d-flex flex-column align-items-center fs-4" t-on-click="() => this.openActions('undefined')">
                    <span class="fw-bold"><t t-out="this.props.data.undefined_count"/></span>
                    <span class="text-muted">No Target Set</span>
                </a>
                <a href="#" class="d-none d-sm-flex flex-column align-items-center fs-4" t-on-click="() => this.openActions()">
                    <span class="fw-bold"><t t-out="this.props.data.total_count"/></span>
                    <span class="text-muted">Total</span>
                </a>
            </div>
        </div>
    </t>
</templates>
