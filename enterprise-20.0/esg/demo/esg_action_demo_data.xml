            <field name="date_end" eval="(DateTime.today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="type">negative_impact</field>
            <field name="status">potential</field>
            <field name="gap_analysis">missing</field>
            <field name="impact_severity_score">3</field>
            <field name="financial_severity_score">2</field>
            <field name="stakeholder_impact_severity_score">4</field>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_ghg_reduction')), (4, ref('esg_tag_demo_scope_3'))]"/>
        </record>
