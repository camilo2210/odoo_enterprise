        <!-- Actions linked to VSME -->

        <record id="esg_action_demo_low_carbon_commuting" model="esg.action">
            <field name="name">Shift to Low-Carbon Commuting</field>
            <field name="priority">2</field>
            <field name="responsible_user_id" ref="base.user_admin"/>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_mobility')), (4, ref('esg_tag_demo_ghg_reduction')), (4, ref('esg_tag_demo_scope_3'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="esg.esg_uom_kg_co2"/>
            <field name="baseline_value">300000</field>
            <field name="baseline_start_date" eval="(DateTime.today() - relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="baseline_end_date" eval="(DateTime.today() - relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="target_value">240000</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Encourage and support employees to switch from single-passenger car use to walking, cycling, public transport, or carpooling. Monitor participation through monthly employee surveys.</p>
                <ul>
                    <li><strong>Estimation:</strong> Assume 100 employees each reduce 10 km of car commuting/day for 20 days/month → 20,000 km avoided.</li>
                    <li><strong>Emission factor:</strong> 0.25 kgCO₂e/km → 20,000 km x 0.25 = 5,000 kgCO₂e/month → 60,000 kgCO₂e/year saved.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=8, day=1)).strftime('%Y-%m-%d'), 'value': 240000})]"/>
        </record>
        <record id="esg_action_demo_furniture_procurement" model="esg.action">
            <field name="name">Sustainable Procurement of Office Furniture</field>
            <field name="priority">1</field>
            <field name="responsible_user_id" ref="base.user_admin"/>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_circular_economy')), (4, ref('esg_tag_demo_scope_3')), (4, ref('esg_tag_demo_ghg_reduction'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="esg.esg_uom_kg_co2"/>
            <field name="baseline_value">2000</field>
            <field name="baseline_start_date" eval="(DateTime.today() - relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="baseline_end_date" eval="(DateTime.today() - relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="target_value">1280</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Update procurement policy to prioritize reused, refurbished, or sustainably certified furniture (e.g., FSC-certified wood, low-emission manufacturing). Conduct a replacement plan based on lifecycle assessments (LCA) to reduce embodied carbon in furniture purchases.</p>
                <ul>
                    <li><strong>Estimation:</strong> Replacing 10 standard office desks with reused ones instead of new ones saves ~72 kgCO₂e per desk (based on embodied carbon of ~100 kgCO₂e for new vs. ~28 kgCO₂e for reused) → 720 kgCO₂e saved per 10 desks.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=7, day=1)).strftime('%Y-%m-%d'), 'value': 1120})]"/>
        </record>
        <record id="esg_action_demo_standby_power" model="esg.action">
            <field name="name">Reduce Standby Power Consumption</field>
            <field name="priority">3</field>
            <field name="responsible_user_id" ref="base.user_admin"/>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_energy_efficiency')), (4, ref('esg_tag_demo_scope_2')), (4, ref('esg_tag_demo_it_policy')), (4, ref('esg_tag_demo_operational_excellence'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="uom.product_uom_kwh"/>
            <field name="baseline_value">3000</field>
            <field name="baseline_start_date" eval="(DateTime.today() - relativedelta(years=2, month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="baseline_end_date" eval="(DateTime.today() - relativedelta(years=2, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="target_value">600</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=2, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Implement a company-wide policy requiring all non-critical IT and office equipment (monitors, PCs, printers) to be shut down outside working hours. Install smart meters to track compliance.</p>
                <ul>
                    <li><strong>Estimation:</strong> 100 devices x 50W x 2 hours/day x 20 days = 200 kWh/month → 2,400 kWh/year saved.</li>
                    <li>EU electricity factor ~0.233 kgCO₂e/kWh → 559.2 kgCO₂e/year avoided.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=7, day=1)).strftime('%Y-%m-%d'), 'value': 1700})]"/>
        </record>
        <record id="esg_action_demo_data_storage" model="esg.action">
            <field name="name">Data Storage Optimization</field>
            <field name="priority">0</field>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_digital_efficiency')), (4, ref('esg_tag_demo_it_policy')), (4, ref('esg_tag_demo_scope_2')), (4, ref('esg_tag_demo_carbon_footprint'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="esg.esg_uom_kg_co2"/>
            <field name="baseline_value">3000</field>
            <field name="baseline_start_date" eval="(DateTime.today() - relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="baseline_end_date" eval="(DateTime.today() - relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="target_value">500</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=1, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Conduct a company-wide cleanup of unused digital files, archived email, and inactive databases to reduce cloud and on-prem storage energy consumption.</p>
                <ul>
                    <li><strong>Estimation:</strong> 1 GB stored/year = ~5 kgCO₂e.</li>
                    <li>Deleting 500 GB = 2,500 kgCO₂e/year saved.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=4, day=1)).strftime('%Y-%m-%d'), 'value': 2850})]"/>
        </record>
        <record id="esg_action_demo_short_haul_flights" model="esg.action">
            <field name="name">Eliminate Short-Haul Flights where Rail is Viable</field>
            <field name="priority">2</field>
            <field name="responsible_user_id" ref="base.user_admin"/>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_business_travel')), (4, ref('esg_tag_demo_scope_3')), (4, ref('esg_tag_demo_ghg_reduction'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="baseline_value">150</field>
            <field name="baseline_start_date" eval="(DateTime.today() - relativedelta(years=3, month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="baseline_end_date" eval="(DateTime.today() - relativedelta(years=3, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="target_value">50</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=3, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Introduce a travel policy mandating the use of rail instead of air for trips under 800 km where feasible. Apply through HR and travel booking systems, and review compliance quarterly.</p>
                <ul>
                    <li><strong>Estimation:</strong> 100 avoided flights/year → (250 kgCO₂e - 20 kgCO₂e) x 100 = 23,000 kgCO₂e saved.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=9, day=1)).strftime('%Y-%m-%d'), 'value': 120})]"/>
        </record>
        <record id="esg_action_demo_climate_awareness" model="esg.action">
            <field name="name">Internal Awareness Training on Climate Change</field>
            <field name="priority">0</field>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_awareness')), (4, ref('esg_tag_demo_governance')), (4, ref('esg_tag_demo_scope_3'))]"/>
            <field name="measure_type">physically</field>
            <field name="uom_id" ref="esg.esg_uom_kg_co2"/>
            <field name="baseline_value">0</field>
            <field name="target_value">10000</field>
            <field name="target_start_date" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="target_end_date" eval="(DateTime.today() + relativedelta(years=2, month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="description" type="html">
                <p>Organize structured climate education sessions (e.g., Climate Fresk or equivalent science-based workshop) for staff to build understanding of climate science, causes, and business relevance. Target core departments like procurement, HR, and operations to support informed sustainability decisions.</p>
                <ul>
                    <li><strong>Estimation (indirect impact):</strong> Assume the training leads to behavior or decision shifts in key roles. For example, if 10 trained procurement staff shift 10% of future purchases to lower-carbon options, this could lead to ~500-1,000 kgCO₂e avoided annually per person.</li>
                    <li>The impact is indirect but measurable through follow-up actions or policy changes.</li>
                </ul>
            </field>
            <field name="value_history_ids" eval="[(0, 0, {'date': (DateTime.today() + relativedelta(month=8, day=1)).strftime('%Y-%m-%d'), 'value': 3000})]"/>
        </record>
