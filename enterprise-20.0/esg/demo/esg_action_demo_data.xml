        <!-- Metrics (used when CSRD reporting is enabled) -->

        <record id="esg_metric_demo_ghg" model="esg.metric">
            <field name="name">Annual Carbon Footprint Assessment</field>
            <field name="esrs_id" ref="esg.E1-6"/>
            <field name="date_start" eval="(DateTime.today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d')"/>
            <field name="type">negative_impact</field>
            <field name="status">actual</field>
            <field name="gap_analysis">available</field>
            <field name="impact_severity_score">4</field>
            <field name="financial_severity_score">3</field>
            <field name="stakeholder_impact_severity_score">4</field>
            <field name="stakeholder_financial_severity_score">3</field>
            <field name="tag_ids" eval="[(4, ref('esg_tag_demo_ghg_reduction'))]"/>
        </record>
        <record id="esg_metric_demo_ghg_scope3" model="esg.metric">
            <field name="name">Value Chain Emissions Tracking</field>
            <field name="esrs_id" ref="esg.E1-6"/>
