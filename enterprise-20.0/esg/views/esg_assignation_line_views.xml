<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="esg_assignation_line_form_view" model="ir.ui.view">
        <field name="name">esg.assignation.line.form</field>
        <field name="model">esg.assignation.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="esg_emission_factor_id" context="{'search_default_my_country_filter': True, 'search_default_group_by_country': True}"/>
                        <field name="account_id" options="{'no_quick_create': True}" context="{'from_emission_factor_line': True}"/>
                        <field name="partner_id"/>
                        <field name="product_category_id"/>
                        <field name="product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esg_assignation_line_list_view" model="ir.ui.view">
        <field name="name">esg.assignation.line.list</field>
        <field name="model">esg.assignation.line</field>
        <field name="arch" type="xml">
            <list editable="top" multi_edit="1">
                <field name="esg_emission_factor_id"/>
                <field name="account_id" options="{'no_quick_create': True}" context="{'from_emission_factor_line': True}"/>
                <field name="partner_id"/>
                <field name="product_category_id"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="esg_assignation_line_search_view" model="ir.ui.view">
        <field name="name">esg.assignation.line.search</field>
        <field name="model">esg.assignation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="esg_emission_factor_id"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="product_category_id"/>
                <field name="product_id"/>
                <separator/>
                <group>
                    <filter name="group_by_emission_factor" context="{'group_by': 'esg_emission_factor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_view_assignation_rule" model="ir.actions.act_window">
        <field name="name">Assignation Rules</field>
        <field name="res_model">esg.assignation.line</field>
        <field name="path">esg-assignation-rules</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_emission_factor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and configure assignation rules.
            </p>
            <p>
                Assignation rules help you automatically link emission factors to your emissions based on specific criteria such as account, partner, product category, or product.
            </p>
        </field>
    </record>
</odoo>
