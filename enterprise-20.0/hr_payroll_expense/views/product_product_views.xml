<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_expense_form_view" model="ir.ui.view">
        <field name="name">product.product.expense.view.form.payroll</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="hr_expense.product_product_expense_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='product_details']" position="inside">
                <group string="Payroll">
                    <field name="salary_rule_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'on_tag_click': 'open_form'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_product_expense_categories_tree_view" model="ir.ui.view">
        <field name="name">product.product.expense.categories.view.list</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="hr_expense.product_product_expense_categories_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="salary_rule_ids" optional="hide" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'on_tag_click': 'open_form'}"/>
            </xpath>
        </field>
    </record>
</odoo>
