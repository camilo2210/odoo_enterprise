<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.expense.view.form.payroll</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="payslip_id" invisible="1"/>
                <field name="refund_in_payslip" invisible="1"/>
                <button class="oe_stat_button" name="action_open_payslip" type="object" icon="attach_money" invisible="not payslip_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payslip</span>
                    </div>
                </button>
            </div>
            <xpath expr="//button[hasclass('o_expense_approve_highlight')]" position="after">
                <button name="action_remove_from_payslip" string="Remove from Payslip" type="object"
                        groups="account.group_account_invoice,hr_payroll.group_hr_payroll_user"
                        invisible="nb_attachment == 0 or not refund_in_payslip or not payslip_id or state in ('posted', 'in_payment', 'paid') or payment_mode != 'payslip_account'"
                        class="oe_highlight" data-hotkey="g"/>
            </xpath>
            <xpath expr="//button[hasclass('o_expense_approve')]" position="after">
                <button name="action_remove_from_payslip" string="Remove from Payslip" type="object"
                        groups="account.group_account_invoice,hr_payroll.group_hr_payroll_user" data-hotkey="g"
                        invisible="nb_attachment  &gt;= 1 or not refund_in_payslip or not payslip_id or state in ('posted', 'in_payment', 'paid') or payment_mode != 'payslip_account'"/>
            </xpath>
            <xpath expr="//button[hasclass('o_expense_refuse')]" position="attributes">
                <attribute name="invisible">state not in ('submitted', 'approved') or refund_in_payslip</attribute>
            </xpath>
            <xpath expr="//button[hasclass('o_expense_split_user')]" position="attributes">
                <attribute name="invisible">state != 'draft' or product_has_cost or refund_in_payslip</attribute>
            </xpath>
            <xpath expr="//button[hasclass('o_expense_split_manager')]" position="attributes">
                <attribute name="invisible">state in ('in_payment', 'paid', 'refused', 'posted') or product_has_cost or refund_in_payslip</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_expenses_analysis_tree_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.expense.view.tree.payroll</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="payslip_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_search" model="ir.ui.view">
        <field name="name">hr.expense.view.search</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='by_employee']" position="attributes">
                <attribute name="domain">[('payment_mode', 'in', ['own_account', 'payslip_account'])]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
