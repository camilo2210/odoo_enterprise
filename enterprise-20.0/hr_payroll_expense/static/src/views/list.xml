<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hr_payroll_expense.ListButtons" t-inherit="hr_expense.ListButtons" t-inherit-mode="extension">
        <xpath expr="//button[@title='Refuse']" position="after">
            <button t-if="this.displayRemove()" class="d-none d-md-block btn btn-secondary" t-on-click="() => this.onClick('action_remove_from_payslip')">
                Remove from Payslip
            </button>
        </xpath>
    </t>
</templates>
