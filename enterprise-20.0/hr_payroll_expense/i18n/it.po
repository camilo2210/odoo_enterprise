#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid ""
"The '%(account_name)s' account for the salary rule '%(rule_name)s' must be "
"of type 'Payable'."
msgstr ""
"Il conto \"%(account_name)s\" per la regola retributiva \"%(rule_name)s\" "
"deve essere di tipo \"Debito\"."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"The salary rules linked to a product must have a debit account of type "
"'Liability Payable'.\n"
"Please fix the following salary rule(s): %s"
msgstr ""
"Le regole salariali associate a un prodotto devono avere un conto di debito "
"di tipo \"Passività dovute\".\n"
"Correggi le seguenti regole salariali: %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "There are no valid expenses selected."
msgstr "Non sono state selezionate spese valide."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"You cannot assign multiple salary rules to the same structure for this "
"product.\n"
"Please fix the following structure(s): %s"
msgstr ""
"Non è possibile assegnare più regole salariali alla stessa struttura per "
"questo prodotto.\n"
"Correggi le seguenti strutture: %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"You cannot remove an expense from a payslip that has already been "
"validated.\n"
"Expenses can only be removed from draft or canceled payslips."
msgstr ""
"Non è possibile eliminare una spese da una busta paga già validata.\n"
"Le spese possono essere eliminate solo da buste paga in bozza o annullate."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "You do not have permission to add this expense to a payslip."
msgstr "Non hai i permessi per aggiungere questa spesa a una busta paga."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid ""
"You don't have the access rights to link an expense to a payslip. You need "
"to be a payroll officer to do that."
msgstr ""
"Non hai i diritti di accesso necessari per collegare una spesa a una busta "
"paga. È necessario essere un responsabile buste paga per farlo."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid "You don't have the access rights to post an invoice."
msgstr "Diritti di accesso non sufficienti per registrare una fattura."

