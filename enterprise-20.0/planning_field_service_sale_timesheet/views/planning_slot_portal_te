<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="worksheet_time_and_material">
        <t t-set="order" t-value="doc.sale_order_id"/>
        <t t-set="final_subtotal" t-value="0"/>
        <t t-set="final_tax" t-value="0"/>
        <t t-set="final_total" t-value="0"/>
        <t t-set="amount_due" t-value="0"/>
        <t t-set="is_any_total_discount_line" t-value="False"/>
        <t t-set="hide_price" t-value="doc.env['res.groups']._is_feature_enabled('planning.group_field_service_hide_price')"/>
        <t t-foreach="order.order_line" t-as="line">
            <t t-set="is_intervention" t-value="line == doc.sale_line_id"/>
            <t t-set="use_qty_delivered" t-value="is_intervention and line.product_id.service_policy != 'ordered_prepaid'"/>
            <t t-if="use_qty_delivered">
                <t t-set="final_subtotal" t-value="final_subtotal + line.delivered_price_subtotal"/>
                <t t-set="final_tax" t-value="final_tax + line.delivered_price_tax"/>
                <t t-set="amount_due" t-value="amount_due + line.delivered_price_total - sum(line.invoice_lines.mapped('price_total'))"/>
                <t t-set="is_any_total_discount_line" t-value="is_any_total_discount_line or (line.discount and line.price_unit != 0 and line.delivered_price_total == 0)"/>
            </t>
            <t t-else="">
                <t t-set="final_subtotal" t-value="final_subtotal + line.price_subtotal"/>
                <t t-set="final_tax" t-value="final_tax + line.price_tax"/>
                <t t-set="amount_due" t-value="amount_due + line.price_total - sum(line.invoice_lines.mapped('price_total'))"/>
                <t t-set="is_any_total_discount_line" t-value="is_any_total_discount_line or (line.discount and line.price_unit != 0 and line.price_total == 0)"/>
            </t>
        </t>
        <t t-set="display_discount" t-value="any(line.discount for line in order.order_line)"/>
        <t t-if="order and (final_subtotal != 0 or is_any_total_discount_line)">
            <div>
                <table class="table table-sm table-borderless o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Product</th>
                            <th class="text-end">Quantity</th>
                            <th t-if="not hide_price and final_subtotal != 0 or is_any_total_discount_line" class="text-end">Unit Price</th>
                            <th t-if="not hide_price and final_tax" class="text-end">Taxes</th>
                            <th t-if="not hide_price and display_discount" class="text-end">
                                <span>Disc.%</span>
                            </th>
                            <th class="text-end" t-if="not hide_price">
                                <span t-if="final_subtotal != 0 or is_any_total_discount_line">Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="order.order_line" t-as="line">
                            <t t-set="is_intervention" t-value="line == doc.sale_line_id"/>
                            <t t-set="use_qty_delivered" t-value="is_intervention and line.product_id.service_policy != 'ordered_prepaid'"/>
                            <t t-if="use_qty_delivered">
                                <t t-set="is_total_discount" t-value="line.discount and line.price_unit != 0 and line.delivered_price_total == 0"/>
                            </t>
                            <t t-else="">
                                <t t-set="is_total_discount" t-value="line.discount and line.price_unit != 0 and line.price_total == 0"/>
                            </t>
                            <t t-if="(is_intervention and line.delivered_price_total > 0) or ((not use_qty_delivered and line.price_total > 0)) or (not is_intervention and line.price_total > 0) or is_total_discount">
                                <t t-if="use_qty_delivered">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.delivered_price_subtotal"/>
                                </t>
                                <t t-else="">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                </t>

                                <tr t-att-class="'fw-bolder o_line_section' if line.display_type == 'line_section' else 'fw-bold o_line_subsection' if line.display_type == 'line_subsection' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''" t-att-style="'background-color: #F1F1F1;' if line_index % 2 == 0 else ''">
                                    <t t-if="not line.display_type and not line.is_downpayment">
                                        <td><span t-field="line.label"/></td>
                                        <td class="text-end">
                                            <span t-if="use_qty_delivered" t-field="line.qty_delivered"/>
                                            <span t-else="" t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-end" t-if="not hide_price">
                                            <span t-options='{"widget": "monetary"}' t-if="(is_intervention and line.delivered_price_total != 0) or (not use_qty_delivered and line.price_total != 0) or (not is_intervention and line.price_total != 0) or is_total_discount" t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="not hide_price and final_tax" class="text-end">
                                            <span t-out="', '.join(map(lambda x: x._get_description_plaintext() or x.name, line.tax_ids))"/>
                                        </td>
                                        <td t-if="not hide_price and display_discount" class="text-end">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-end o_price_total" t-if="not hide_price">
                                            <t t-if="use_qty_delivered">
                                                <span t-if="line.delivered_price_subtotal != 0 or is_total_discount" t-field="line.delivered_price_subtotal"/>
                                            </t>
                                            <t t-else="">
                                                <span t-if="line.price_subtotal != 0 or is_total_discount" t-field="line.price_subtotal"/>
                                            </t>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type in ('line_section', 'line_subsection')">
                                        <td colspan="99">
                                            <span t-field="line.label"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.label"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                            <t t-if="current_section and (line_last or doc.sale_order_id.order_line[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-out="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": doc.sale_order_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="container_subtotal" name="so_total_summary" t-if="not hide_price">
                <div id="total" class="row justify-content-end" name="total">
                    <div t-attf-class="#{'col-6' if report_type == 'pdf' else 'col-auto'}">
                        <table t-if="final_subtotal != 0 or is_any_total_discount_line" class="table table-sm table-borderless">
                            <tr t-if="final_tax" class="o_subtotal" style="">
                                <td><strong>Untaxed amount</strong></td>
                                <td class="text-end">
                                    <span t-out="final_subtotal" t-options='{"widget": "monetary", "display_currency": doc.sale_order_id.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-if="final_tax">
                                <td><strong>Taxes</strong></td>
                                <td class="text-end">
                                    <span t-out="final_tax" t-options='{"widget": "monetary", "display_currency": doc.sale_order_id.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Total</strong></td>
                                <td class="text-end">
                                    <span t-out="final_subtotal + final_tax" t-options='{"widget": "monetary", "display_currency": doc.sale_order_id.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Amount Due: </strong></td>
                                <td class="text-end">
                                    <span t-out="amount_due" t-options='{"widget": "monetary", "display_currency": doc.sale_order_id.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_field_service_report_form" inherit_id="planning_field_service.portal_my_field_service_report_form">
        <xpath expr="//t[@id='intervention-nav-time-material']" position="replace">
            <li t-if="show_portal_materials" class="nav-item">
                <a class="nav-link p-0" href="#time_and_material">
                    Time &amp; Materials
                </a>
            </li>
        </xpath>
        <xpath expr="//t[@id='intervention-nav-ts']" position="replace">
            <li t-if="show_portal_timesheets and intervention.sudo().allow_timesheets and intervention.sudo().intervention_timesheet_ids" class="nav-item">
                <a class="nav-link p-0" href="#intervention_timesheets">
                    Timesheets
                </a>
            </li>
        </xpath>
        <xpath expr="//div[@id='intervention_content']//div[@id='intervention_time_material']" position="replace">
            <t t-set="doc" t-value="intervention"/>
            <div class="container" t-if="show_portal_materials">
                <hr class="mt-4 mb-4"/>
                <h3 id="time_and_material" class="mt-2 mb-2" data-anchor="true">Time &amp; Materials</h3>
                <t t-call="planning_field_service_sale_timesheet.worksheet_time_and_material"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='intervention_content']//div[@id='intervention_ts']" position="replace">
            <t t-set="timesheets" t-value="show_portal_timesheets and intervention.sudo().allow_timesheets and intervention.sudo().intervention_timesheet_ids"/>
            <div class="container" t-if="timesheets">
                <h3 id="intervention_timesheets" class="mt-2 mb-2" data-anchor="true">Timesheets</h3>
                <t t-call="hr_timesheet.portal_timesheet_table"/>
            </div>
        </xpath>
    </template>
</odoo>
