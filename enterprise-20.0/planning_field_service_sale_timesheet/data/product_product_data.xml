<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="field_service_product" model="product.product">
            <field name="name">Field Service</field>
            <field name="service_tracking">no</field>
            <field name="type">service</field>
            <field name="categ_id" eval="ref('product.product_category_services', raise_if_not_found=False)"/>
            <field name="list_price">100</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="service_policy">delivered_timesheet</field>
            <field name="planning_enabled" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="planning_role_id" ref="planning_field_service_sale_timesheet.field_service_technician_role"/>
        </record>
        <record id="field_service_product_travel_invoice" model="product.template">
            <field name="name">Travel Fees</field>
            <field name="type">service</field>
            <field name="list_price">1</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="service_policy">delivered_manual</field>
            <field name="purchase_ok" eval="False"/>
            <field name="sale_ok" eval="True"/>
        </record>
	</data>
</odoo>
