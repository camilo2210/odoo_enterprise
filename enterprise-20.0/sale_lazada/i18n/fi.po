#. module: sale_lazada
#: model:mail.template,body_html:sale_lazada.inventory_sync_failure
msgid ""
"<style>\n"
"                .lazada_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .lazada_table th,\n"
"                .lazada_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .lazada_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .lazada_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .lazada_table tbody th,\n"
"                .lazada_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>The synchronization of the inventory for Lazada Shop\n"
"                    <b><t t-out=\"ctx.get('lazada_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.</p>\n"
"                <p>Here are the errors sent by Lazada: </p>\n"
"                <table class=\"lazada_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th><t t-out=\"', '.join(error['default_codes'])"
"\"/></th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">An unknown error occurred "
"during the synchronisation with Lazada.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact <a "
"href=\"https://www.odoo.com/help/\">Odoo support </a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .lazada_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .lazada_table th,\n"
"                .lazada_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .lazada_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .lazada_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .lazada_table tbody th,\n"
"                .lazada_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>Varastoinnin synkronoinnissa Lazada-kaupan\n"
"                    <b><t t-out=\"ctx.get('lazada_shop') or ''\">VIITE</t></"
"b>\n"
"                    kanssa tapahtui virhe, eikä sitä suoritettu loppuun.</p>"
"\n"
"                <p>Tässä Lazadan lähettämät virheilmoitukset: </p>\n"
"                <table class=\"lazada_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Tuotteen sisäinen viite/viitteet</th>\n"
"                            <th>Viesti</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th><t t-out=\"', '.join(error['default_codes'])"
"\"/></th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">Lazada-synkronoinnin aikana "
"tapahtui tuntematon virhe.\n"
"                                    Sinun on tarkastettava manuaalisesti, "
"onko tuotteen saatavilla oleva määrä oikea vai ei.\n"
"                                    Jos ongelma jatkuu, ota yhteyttä <a "
"href=\"https://www.odoo.com/help/\">Odoon tukipalveluun </a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

