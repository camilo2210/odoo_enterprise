<templates>
    <t t-name="hr_expense_stripe.InputVerificationCode">
        <div class="row w-50 mx-auto d-flex justify-content-center">
            <t t-foreach="Array(this.props.nbInputs)" t-as="i" t-key="i_index">
                <input class="col rounded border-0 mx-1 my-0 p-0 text-center validation-buttons" type="text"
                       inputmode="numeric" maxlength="1" t-ref="this.inputRefs" t-on-input="this.onInput" t-on-keydown="this.onKeydown"
                       t-on-focus="this.onFocus" t-on-paste="this.onPaste"
                />
            </t>
        </div>
    </t>
</templates>
