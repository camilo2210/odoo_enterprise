msgstr ""

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/controllers/main.py:0
msgid "You cannot download stripe attachment for the given model."
msgstr ""

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot duplicate an expense that was created from a Stripe card "
"transaction."
msgstr ""
"Não é possível duplicar uma despesa criada a partir de uma transação com "
"cartão do Stripe."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid "You cannot edit the security fields of an expense manually"
msgstr ""
"Não é possível editar manualmente os campos de segurança de uma despesa"

#. module: hr_expense_stripe
#: model:ir.model.constraint,message:hr_expense_stripe.constraint_res_company_constraint_journal_stripe_activated
msgid ""
"You cannot remove the journal used by Stripe Issuing when it is activated"
msgstr ""
"Não é possível remover o diário usado pelo Stripe Issuing quando ele está "
"ativado"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/product_product.py:0
msgid ""
"You cannot set a cost on a product that is used as an Expense card category. "
"Please duplicate it instead."
msgstr ""
"Não é possível definir um custo para um produto usado como categoria de "
"cartão de despesas. Em vez disso, duplique-o."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot split an expense that is reserved. Please wait for the "
"transaction to be captured."
msgstr ""
"Não é possível dividir uma despesa que está reservada. Aguarde até que a "
"transação seja registrada."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot submit an expense that is reserved. Please wait for the "
"transaction to be captured."
msgstr ""
"Você não pode enviar uma despesa que esteja reservada. Aguarde até que a "
"transação seja registrada."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/__init__.py:0
msgid ""
"You cannot uninstall the 'Expense cards' module while there are active or "
"inactive Stripe cards. Please manually block all cards before uninstalling "
"the module."
msgstr ""
"Você não pode desinstalar o módulo 'Cartões de despesas' enquanto houver "
"cartões Stripe ativos ou inativos. Bloqueie manualmente todos os cartões "
"antes de desinstalar o módulo."

