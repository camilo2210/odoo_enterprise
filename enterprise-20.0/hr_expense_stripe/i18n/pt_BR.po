#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid "You can't change the delivery address once the card has been shipped."
msgstr ""
"Não é possível alterar o endereço de entrega depois que o cartão tiver sido "
"enviado."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid ""
"You can't change the employee of an active card. Please create a new card "
"instead."
msgstr ""
"Não é possível alterar o funcionário de um cartão ativo. Crie um novo cartão."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid ""
"You can't delete a card that already exists for Stripe, please block it "
"instead"
msgstr ""
"Não é possível excluir um cartão que já exista no Stripe; em vez disso, "
"bloqueie-o"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid "You can't set the card state back to draft."
msgstr "Não é possível redefinir o estado do cartão para rascunho."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/account_payment_method_line.py:0
msgid ""
"You cannot delete a payment method line that is used by an active/paused "
"card."
msgstr ""
"Não é possível excluir uma linha de método de pagamento que seja usada por "
"um cartão ativo/pausado."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot delete an expense that was created from a Stripe card transaction."
msgstr ""
"Não é possível excluir uma despesa criada a partir de uma transação com "
"cartão do Stripe."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_dispute.py:0
