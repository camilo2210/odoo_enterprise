<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ar_reports.L10nArReportsFilterTaxType">
        <Dropdown>
            <button class="btn btn-secondary">
                <span class="oi oi-filled me-1" data-icon="filter_alt"/>Tax Type: <t t-out="this.selectedTaxType"/>
            </button>

            <t t-set-slot="content">
                <t t-foreach="Object.entries(this.controller.cachedFilterOptions().ar_vat_book_tax_types_available)" t-as="taxType" t-key="taxType[0]">
                    <DropdownItem
                        class="{ 'selected': taxType[1]['selected'] }"
                        onSelected="() => this.selectArVatBookTaxType(taxType[0])"
                        closingMode="'none'"
                    >
                        <t t-out="taxType[1]['name']"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
