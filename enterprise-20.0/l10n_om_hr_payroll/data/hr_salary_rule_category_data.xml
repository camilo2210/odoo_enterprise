<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_om_category_total_wage" model="hr.salary.rule.category">
            <field name="name">Total Wage</field>
            <field name="code">TOTAL_WAGE</field>
            <field name="country_id" ref="base.om"/>
        </record>

        <record id="l10n_om_category_basic" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
            <field name="country_id" ref="base.om"/>
            <field name="parent_id" ref="l10n_om_category_total_wage"/>
        </record>

        <record id="l10n_om_category_allowance" model="hr.salary.rule.category">
            <field name="name">Allowance</field>
            <field name="code">ALW</field>
            <field name="country_id" ref="base.om"/>
            <field name="parent_id" ref="l10n_om_category_total_wage"/>
        </record>

        <record id="l10n_om_category_provision_payout" model="hr.salary.rule.category">
            <field name="name">Provision Payout</field>
            <field name="code">OM_PROVPAY</field>
            <field name="country_id" ref="base.om"/>
            <field name="parent_id" ref="l10n_om_category_total_wage"/>
        </record>

        <record id="l10n_om_category_net_cost" model="hr.salary.rule.category">
            <field name="name">Oman Net Cost</field>
            <field name="code">OM_NETCOST</field>
            <field name="country_id" ref="base.om"/>
        </record>
    </data>
</odoo>
