<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group name="l10n_om_hr_payroll_contributions" string="End Of Service Benifit" invisible="country_code != 'OM'" colspan="2">
                    <field name="l10n_om_employee_is_eos_eligible" string="Is Eligible" class="mw-25"/>
                </group>
                <group name="l10n_om_hr_payroll_contributions" string="SPF" invisible="country_code != 'OM'" colspan="2">
                    <group name="l10n_om_hr_payroll_contributions_company" string="Employer Contributions">
                        <field name="l10n_om_company_old_age_disability_death_insurance_percentage" string="Old Age, Disability and Death Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_company_work_injury_insurance_percentage" string="Work Injury and Occupational Disease Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_company_unemployment_insurance_percentage" string="Employment Security Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_company_sick_leave_insurance_percentage" string="Sick and Other Leaves Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_company_maternity_leave_insurance_percentage" string="Maternity Leave Insurance" class="mw-25" widget="percentage"/>
                    </group>
                    <group name="l10n_om_hr_payroll_contributions_employee" string="Employee Contributions">
                        <field name="l10n_om_employee_old_age_disability_death_insurance_percentage" string="Old Age, Disability and Death Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_employee_work_injury_insurance_percentage" string="Work Injury and Occupational Disease Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_employee_unemployment_insurance_percentage" string="Employment Security Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_employee_sick_leave_insurance_percentage" string="Sick and Other Leaves Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_om_employee_maternity_leave_insurance_percentage" string="Maternity Leave Insurance" class="mw-25" widget="percentage"/>
                    </group>
                </group>
            </group>

            <field name="identification_id" position="before">
                <field name="l10n_om_identification_type" invisible="country_code != 'OM'"/>
            </field>
        </field>
    </record>
</odoo>
