<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <block title="Oman Payroll" id="oman_payroll_wps_settings" invisible="company_country_code != 'OM'">
                    <setting string="Annual Leave Time-off Type" help="Set the time off type used as Annual Leave">
                        <field name="l10n_om_annual_work_entry_type_id"/>
                    </setting>
                    <setting string="Company MOL Number" help="Used to define the MOL number of the company registered under the WPS program">
                        <field name="l10n_om_company_mol_number"/>
                    </setting>
                    <setting string="Salary Payer" help="Used to define the entity that is registered under the WPS program and is actually paying the salaries">
                        <field name="l10n_om_salary_payer"/>
                    </setting>
                    <setting string="Salary Payer MOL Number" invisible="not l10n_om_salary_payer" help="Used to define the MOL number of the entity that is registered under the WPS program and is actually paying the salaries">
                        <field name="l10n_om_salary_payer_mol_number"/>
                    </setting>
                    <setting string="WPS Disbursement Bank Account" invisible="not l10n_om_salary_payer" help="Bank account from which salaries are paid in the WPS export. Must belong to the Salary Payer previously configured." id="l10n_om_bank_account_id">
                        <field name="l10n_om_bank_account_id" context="{'default_partner_id': l10n_om_salary_payer}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
