<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_interactive_composer_view_form" model="ir.ui.view">
        <field name="name">whatsapp.interactive.composer.view.form</field>
        <field name="model">whatsapp.interactive.composer</field>
        <field name="arch" type="xml">
            <form string="Send Interactive Template">
                <sheet>
                    <group>
                        <group>
                            <field name="wa_interactive_id"
                                options="{'no_create_edit': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <div colspan="2">
                                <field name="preview_whatsapp" no_label="1" invisible="not preview_whatsapp"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Send Message" type="object" class="oe_highlight" name="action_send_whatsapp_interactive"/>
                    <button name="cancel" special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
