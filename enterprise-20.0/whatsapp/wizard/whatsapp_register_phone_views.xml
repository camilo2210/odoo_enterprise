<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_register_phone_form" model="ir.ui.view">
        <field name="name">whatsapp.register.phone.view.form</field>
        <field name="model">whatsapp.register.phone</field>
        <field name="arch" type="xml">
            <form string="Register your Phone number">
                <sheet>
                    <h5>Enter a two-step verification PIN to register phone.</h5>
                    <group>
                        <field name="pin" required="1" password="True" placeholder="e.g. 123456"/>
                    </group>
                    <footer>
                        <button string="Register Phone" name="action_register_phone" type="object" class="btn btn-primary"/>
                        <button class="btn-secondary" special="cancel" string="Cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
