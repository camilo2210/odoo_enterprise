<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="authorization_error" name="Authorization Error">
        <!-- Variables:
            - error_message: The reason for the error.
            - account_url: The URL to the WhatsApp accounts view.
        -->
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="no_livechat" t-value="True"/>
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h1 class="h3 mb-3">An error occurred</h1>
                                <p class="text-muted">
                                    An error occurred while connecting your WhatsApp account.
                                </p>
                                <div class="alert alert-danger">
                                    <strong>Details</strong>
                                    <div class="mt-2">
                                        <t t-out="error_message"/>
                                    </div>
                                </div>
                                <a t-att-href="account_url" class="btn btn-primary mt-3">
                                    Back to WhatsApp accounts
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
