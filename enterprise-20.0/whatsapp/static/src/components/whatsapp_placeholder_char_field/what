<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="whatsapp.WhatsappPlaceholderCharField" t-inherit="web.CharField">
        <xpath expr="//input" position="attributes">
            <attribute name="t-att-placeholder">this.placeholders.values[this.props.name] || ""</attribute>
        </xpath>
    </t>

</templates>
