<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//Thread" position="before">
            <div t-if="this.showAiPreviousChatSuggestion" class="d-flex align-items-center gap-2 px-3 py-2 border-bottom text-info bg-info-subtle">
                <span class="small text-truncate flex-grow-1">
                    New chat started.
                    <a href="#" class="link-info fw-semibold" t-on-click.prevent="this.reopenSuggestedAiChannel">
                        Resume previous chat
                        <i role="img" class="oi o-xsmaller ms-1" data-icon="chevron_right"/>
                    </a>
                </span>
                <button class="btn btn-link btn-sm p-0 text-muted flex-shrink-0" type="button" title="Dismiss" t-on-click="this.dismissAiPreviousChatSuggestion">
                    <i class="oi" data-icon="close"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
