<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="ai.AiModelFieldSelectorPopover" t-inherit="web.ModelFieldSelectorPopover" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_model_field_selector_popover_body')]" position="before">
            <div>
                <div
                    class="badge bg-primary m-1 text-white rounded d-inline-flex flex-row align-items-center text-break"
                    t-foreach="this.aiFieldsState.selected"
                    t-as="field"
                    t-key="field.map(f => f.name).join('.')"
                >
                    <span class="text-wrap" t-out="field.map(f => f.string).join(' > ')"/>
                    <a href="#" class="oi ms-1 text-white my-0 py-0"  data-icon="close" t-on-click="() => this.onRemoveField(field[0])"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-out='fieldDef.string']" position="replace">
            <t t-if="this.isFieldSelected(fieldDef)">
                <strong t-out="fieldDef.string"/>
            </t>
            <t t-else="">
                <t t-out="fieldDef.string"/>
            </t>
            <i class="oi text-success ms-2" data-icon="check" t-if="this.isFieldSelected(fieldDef)"/>
        </xpath>
        <xpath expr="//div[hasclass('o_model_field_selector_popover_body')]//t[@t-if='fieldDef.record_name']" position="attributes">
            <attribute name="t-if">fieldDef.record_name &amp;&amp; (!fieldDef.is_property || this.state.page.previousPage?.previousPage)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_model_field_selector_popover_footer')]" position="replace">
            <div t-if="this.aiFieldsState.selected.length" class="d-flex flex-row m-2">
                <button class="btn btn-primary me-2" t-on-click="this.onInsert">
                    Insert
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Discard
                </button>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_model_field_selector_popover')]" position="attributes">
            <attribute name="class" add="o_ai_model_field_selector_popover" separator=" "/>
        </xpath>
    </t>
</templates>
