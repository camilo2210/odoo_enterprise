<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ai.AudioVisualizer">
        <div t-ref="this.barsWrapperRef" class="d-flex flex-grow-1 gap-1 justify-content-center align-items-center px-1">
            <t t-foreach="this.barHeights()" t-as="frequency" t-key="frequency_index">
                <div class="o-ai-audio-visualizer-bar" t-attf-style="height: {{frequency}}px;"></div>
            </t>
        </div>
    </t>
</templates>
