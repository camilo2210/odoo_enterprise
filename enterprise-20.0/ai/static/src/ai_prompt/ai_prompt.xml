<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="ai.AiPrompt">
        <span t-if="this.props.readonly" class="o_readonly_ai_prompt" t-out="this.value"/>
        <t t-else="">
            <div class="o_ai_prompt border-bottom" t-on-click="this.onClick">
                <Wysiwyg
                    config="this.getConfig()"
                    onBlur.bind="this.onBlur"
                    onLoad.bind="this.onEditorLoad"
                    t-key="this.state.key"/>
            </div>
            <div t-if="this.missingRecordsWarning" t-out="this.missingRecordsWarning" class="alert alert-warning mt-1 mb-0" role="alert"/>
        </t>
    </t>

    <t t-name="ai.AiPromptDialog">
        <Dialog size="this.md" bodyClass="'o_ai_prompt_dialog'" title.translate="Edit Prompt">
            <AiPrompt t-props="this.aiPromptProps"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.confirm">
                    Save
                </button>
                <button class="btn btn-secondary" t-on-click="this.props.close">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
