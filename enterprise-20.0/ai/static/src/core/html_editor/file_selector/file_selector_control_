<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ai_html_editor.FileSelectorControlPanel" t-inherit="html_editor.FileSelectorControlPanel" t-inherit-mode="extension">
        <xpath expr="//input[@name='url']" position="before">
            <t t-if="this.aiControlPanelProps.allowAI">
                <button
                    class="border-0 bg-transparent"
                    t-on-click="this.openAIChat"
                    title="Generate Image with AI"
                >
                    <img src="/ai/static/description/icon.png" style="height: 22px;" alt="AI"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>
