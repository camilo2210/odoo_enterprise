<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ec_sales_list_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_ro_reports_d390.ec.sales.list.submission.wizard.form</field>
            <field name="model">l10n_ro_reports_d390.ec.sales.list.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download your EC Sales List (Form 390 VIES) data.</span><br/>
                                        <button string='Download XML (D390)' name="print_xml" type="object" class="btn-secondary"/>
                                    </div>
                                </li>
                                <li>Download the latest official PDF software for 'Declarația 390' from the <a href="https://static.anaf.ro/static/10/Anaf/Declaratii_R/390.html" target="_blank">ANAF website</a>.</li>
                                <li>Open the official PDF and use the 'Import XML' function to load the file you downloaded from Odoo.</li>
                                <li>Validate the data and generate the final declaration file (XML).</li>
                                <li>Log in to <a href="https://www.anaf.ro/anaf/internet/ANAF/servicii_online/declaratii_electronice" target="_blank">Spațiul Privat Virtual (SPV)</a> and upload the file using your qualified digital signature.</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
