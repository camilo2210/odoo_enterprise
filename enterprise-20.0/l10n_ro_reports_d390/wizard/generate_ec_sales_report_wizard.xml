<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="generate_ec_sales_report_wizard_form" model="ir.ui.view">
            <field name="name">l10n_ro_reports_d390.generate.ec.sales.report.wizard.form</field>
            <field name="model">l10n_ro_reports_d390.generate.ec.sales.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="l10n_ro_declarant_name" required="1"/>
                        <field name="l10n_ro_declarant_surname" required="1"/>
                        <field name="l10n_ro_declarant_role" required="1"/>
                        <field name="l10n_ro_fiscal_address"/>
                        <field name="l10n_ro_fax"/>
                        <field name="l10n_ro_d390_corrective_declaration"/>
                    </group>
                    <footer>
                        <button name="generate_xml" string="Download XML (D390)" type="object" class="btn-primary"  data-hotkey="q"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
               </form>
            </field>
        </record>
    </data>
</odoo>
