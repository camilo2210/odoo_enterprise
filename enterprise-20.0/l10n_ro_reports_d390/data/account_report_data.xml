<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- We are changing the existing expression with balance to include aggregation of the other two
             expression's balances, because at a time there can only be one expression with balance as a label. -->
        <record id="l10n_ro.account_tax_report_ro_baza_rd1_tag" model="account.report.expression">
            <field name="engine">aggregation</field>
            <field name="formula">tax_ro_baza_rd1.balance_01 + tax_ro_baza_rd1.balance_01T</field>
        </record>

        <!-- Above we are changing the engine and formula of that expression, so now we need to create a new
             expression with previous configurations. -->
        <record id="account_tax_report_ro_baza_rd1_tax_tag" model="account.report.expression">
            <field name="report_line_id" ref="l10n_ro.account_tax_report_ro_baza_rd1"/>
            <field name="label">balance_01</field>
            <field name="engine">tax_tags</field>
            <field name="formula">-01 - TAX BASE</field>
        </record>

        <record id="account_tax_report_ro_baza_rd1T_tax_tag" model="account.report.expression">
            <field name="report_line_id" ref="l10n_ro.account_tax_report_ro_baza_rd1"/>
            <field name="label">balance_01T</field>
            <field name="engine">tax_tags</field>
            <field name="formula">-01T - TAX BASE</field>
        </record>

    </data>
</odoo>
