<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_exogenous_category_list" model="ir.ui.view">
            <field name="name">l10n_co.exogenous.category.list</field>
            <field name="model">l10n_co.exogenous.category</field>
            <field name="arch" type="xml">
                <list string="Exogenous Report Category" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="report_type"/>
                </list>
            </field>
        </record>

        <record id="view_exogenous_category_form" model="ir.ui.view">
            <field name="name">l10n_co.exogenous.category.form</field>
            <field name="model">l10n_co.exogenous.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="Exogenous Report Category">
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="report_type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_exogenous_category_search" model="ir.ui.view">
            <field name="name">l10n_co.exogenous.category.search</field>
            <field name="model">l10n_co.exogenous.category</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="report_type"/>
                    <group>
                        <filter string="Report Type" name="group_by_categ_report" context="{'group_by': 'report_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_exogenous_category" model="ir.actions.act_window">
            <field name="name">Exogenous Report Category</field>
            <field name="res_model">l10n_co.exogenous.category</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_categ_report': 1}</field>
            <field name="path">exogenous-report-category</field>
        </record>

        <menuitem 
            action="action_exogenous_category"
            name=" Colombian Exogenous Report Category"
            id="exogenous_category_menu"
            parent="account.account_account_menu"
            sequence="100"/>
    </data>
</odoo>
