<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_form_exogenous_config_inherit" model="ir.ui.view">
        <field name="name">account.account.form.exogenous.config.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='mapping']" position="after">
                <page name="exogenous_configs" string="Exogenous Report Mapping" invisible="company_fiscal_country_code != 'CO'">
                    <field name="l10n_co_exogenous_config_ids" string="Exogenous Report Mapping">
                        <list>
                            <field name="report_type"/>
                            <field name="exogenous_category_id" widget="many2one"/>
                            <field name="concept" invisible="not show_concept" required="show_concept"/>
                            <field name="value_to_report"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="report_type"/>
                                        <field name="concept" invisible="not show_concept" required="show_concept"/>
                                    </group>
                                    <group>
                                        <field name="value_to_report"/>
                                        <field name="exogenous_category_id" widget="many2one" domain="[('report_type','=',report_type)]"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    </data>
</odoo>
