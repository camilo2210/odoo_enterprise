<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="product_accounts" position="after">
                <setting id="purchase_accrual_accounts" string="Purchase Accruals:"
                         title="Accounts used by the inventory valuation report to accrue the value of goods received but not billed yet, or billed but not received yet.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="account_bills_to_receive_id" class="col-lg-5 o_light_label" string="Bills to Receive"/>
                            <field name="account_bills_to_receive_id" decoration-muted="not account_bills_to_receive_active"/>
                        </div>
                        <div class="row mt8">
                            <label for="account_billed_not_received_id" class="col-lg-5 o_light_label" string="Billed Not Received"/>
                            <field name="account_billed_not_received_id" decoration-muted="not account_billed_not_received_active"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
