#. module: pos_iot
#. odoo-javascript
#: code:addons/pos_iot/static/src/app/utils/printer/iot_printer.js:0
msgid ""
"The IoT Box is connected, but the receipt printer isn't. In order to "
"continue, ensure your printer is connected:\n"
"\n"
"1/ for USB printers, check the cable between the IoT Box and the receipt "
"printer\n"
"2/ for network printers, ensure the printer is connected to the internet."
msgstr ""
"La caja IoT está conectada, pero la impresora de recibos no. Para continuar, "
"asegúrate de que la impresora esté conectada:\n"
"\n"
"1/ Para impresoras USB, revisa el cable entre la caja IoT y la impresora de "
"recibos.\n"
"2/ Para impresoras inalámbricas, verifica que la impresora esté conectada a "
"internet."

