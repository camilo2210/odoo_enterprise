<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_iot.DebugWidget" t-inherit="point_of_sale.DebugWidget" t-inherit-mode="extension">
        <xpath expr="//div[@data-tooltip='Print cash receipt']" position="before">
            <div data-tooltip="Test IoT Box" data-tooltip-delay="0">
                <button class="btn btn-secondary btn-sm text-nowrap" t-on-click="this.testIotBoxes">
                    <i class="oi" data-icon="wifi" aria-hidden="true" /> Test IoT Box
                </button>
            </div>
        </xpath>
    </t>
</templates>
