<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_iot.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//button[@title='Local Network Access']" position="after">
            <div class="d-flex align-items-center gap-1 p-1 " t-if="this.pos.config.use_iot_box">
                <i class="oi oi-fw"
                    t-att-class="this.pos.iotHttp.status === 'offline' ? ' text-danger' : ' text-success'"
                    t-att-data-icon="this.pos.iotHttp.status === 'websocket' ? 'public' : this.pos.iotHttp.status === 'offline' ? 'close' : 'account_tree'"
                    style="--oi-font-size: 0.7rem;" 
                    aria-hidden="true"/>
                <span class="fs-3">IoT Box</span>
                <small t-if="this.connectionStatus() and this.state.iotStatus" t-out="this.state.iotStatus"/>
            </div>
        </xpath>
    </t>
</templates>
