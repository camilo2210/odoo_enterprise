<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_iot_config_view_form" model="ir.ui.view">
        <field name="name">pos.iot.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="IoT Box" help="Connect devices using an IoT Box">
                    <field name="use_iot_box"/>
                    <!-- The domain declared for iot_scale_id uses `company_id`. -->
                    <field name="company_id" invisible="1" />
                    <div class="content-group pos_iot_config ms-3" invisible="not use_iot_box">
                        <div class="row">
                            <label string="Customer Display" for="iot_display_id" class="col-lg-5 o_light_label"/>
                            <field name="iot_display_id" placeholder="none"/>
                        </div>
                        <div class="row iot_barcode_scanner">
                            <label string="Scanner" for="iot_scanner_ids" class="col-lg-5 o_light_label"/>
                            <field name="iot_scanner_ids" widget="many2many_tags" placeholder="none"/>
                        </div>
                        <div class="row" name="row_scale">
                            <label string="Electronic Scale" for="iot_scale_id" class="col-lg-5 o_light_label"/>
                            <field name="iot_scale_id" placeholder="none"/>
                        </div>
                        <div>
                            <button name="%(iot.iot_device_action)d" icon="east" type="action" string="IoT Devices" class="btn-link mt8"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
