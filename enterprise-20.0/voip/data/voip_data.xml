<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="default_voip_provider" model="voip.provider">
            <field name="name">Demo</field>
            <field name="ws_server"></field>
            <field name="pbx_ip"></field>
            <field name="mode">demo</field>
            <field name="voicemail_code">*98</field>
            <field name="company_id" eval="False"/>
        </record>
