<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_voip_cleanup_stuck_calls" model="ir.cron">
            <field name="name">VoIP: Cleanup stuck calls</field>
            <field name="model_id" ref="model_voip_call"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_stuck_calls()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
        </record>

        <record id="ir_cron_voip_link_orphan_cost_lines" model="ir.cron">
            <field name="name">VoIP: Link Orphan Call Cost Lines</field>
            <field name="model_id" ref="model_voip_call_cost_line"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_link_orphan_cost_lines()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_voip_sync_number_statuses" model="ir.cron">
            <field name="name">VoIP: Sync DID Number Statuses</field>
            <field name="model_id" ref="model_voip_did_number"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_number_statuses()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

        <record id="ir_cron_voip_sync_number_requests" model="ir.cron">
            <field name="name">VoIP: Sync Number Requests</field>
            <field name="model_id" ref="model_voip_did_number_request"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_number_requests()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_voip_heal_provisioning" model="ir.cron">
            <field name="name">VoIP: Heal Incomplete DID Provisioning</field>
            <field name="model_id" ref="model_voip_did_number"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_heal_provisioning()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_voip_sync_webhook_event_url" model="ir.cron">
            <field name="name">VoIP: Sync Webhook URL</field>
            <field name="model_id" ref="base.model_ir_config_parameter"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_webhook_event_url()</field>
            <field name="interval_number">9999</field> <!--Only executed via cron trigger-->
            <field name="interval_type">months</field>
        </record>
    </data>
</odoo>
