                                <field name="voip_disconnected_destination_ref" widget="voip_pbx_forward_destination_ref" options="{'kind_field': 'voip_disconnected_destination_kind'}" nolabel="1" class="oe_inline flex-grow-1" invisible="voip_disconnected_destination_type != 'forward' or voip_disconnected_destination_kind in (False, 'external')" required="voip_disconnected_destination_type == 'forward' and voip_disconnected_destination_kind not in (False, 'external')"/>
