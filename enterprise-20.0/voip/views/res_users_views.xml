                                <field name="voip_busy_outcall_number" nolabel="1" class="oe_inline flex-grow-1" invisible="voip_busy_destination_type != 'forward' or voip_busy_destination_kind != 'external'" required="voip_busy_destination_type == 'forward' and voip_busy_destination_kind == 'external'" placeholder="+14155550123"/>
