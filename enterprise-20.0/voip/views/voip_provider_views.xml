<?xml version="1.0"?>
<odoo>
    <record id="voip_provider_tree_view" model="ir.ui.view">
        <field name="name">VoIP Provider List View</field>
        <field name="model">voip.provider</field>
        <field name="arch" type="xml">
            <list string="VoIP Providers" editable="bottom" duplicate="false">
                <field name="name"/>
                <field name="ws_server" required="mode == 'prod'"/>
                <field name="pbx_ip" required="mode == 'prod'"/>
                <field name="mode"/>
                <field name="cloud_storage_provider" column_invisible="True"/>
                <field name="recording_policy" string="Call Recording"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" placeholder="Visible to all"/>
            </list>
        </field>
    </record>

    <record id="voip_provider_view_form" model="ir.ui.view">
        <field name="name">voip.provider.view.form</field>
        <field name="model">voip.provider</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="ws_server" required="mode == 'prod'"/>
                            <field name="pbx_ip" required="mode == 'prod'"/>
                            <field name="voicemail_code" placeholder="e.g., *98"/>
                        </group>
                    </group>
                    <div class="o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="recording_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="recording_enabled" string="Call Recording"/>
                            <p class="text-muted">
                                Record VoIP calls. An indicator is displayed during calls. There is no vocal announcement by default.
                            </p>
                            <div invisible="cloud_storage_provider" class="text-danger mt-1">
                                <i class="oi" data-icon="warning" role="img" aria-label="Warning" title="Warning"/> 
                                Cloud storage is not configured. Call recording is disabled.
                            </div>
                            <field name="recording_policy_option" widget="radio" readonly="not recording_enabled"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voip_provider_view" model="ir.actions.act_window">
        <field name="name">VoIP Providers</field>
        <field name="res_model">voip.provider</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="voip_provider_tree_view"/>
        <field name="help" type="html">
            <div>
                <div class="position-relative mb-3">
                    <span class="o_view_nocontent_voip_bg_shape o_view_nocontent_voip_provider_bg position-absolute bg-primary"/>
                    <img class="position-relative mw-100" src="/voip/static/src/img/voip_provider.svg" alt="Ready to Start Calling?"/>
                </div>
                <h2>Ready to Start Calling?</h2>
                <p>Connect Odoo to your VoIP service by adding a provider.</p>
            </div>
        </field>
    </record>

    <menuitem id="voip_provider_view_menu"
        name="VoIP Providers"
        parent="phone_validation.phone_menu_main"
        sequence="4"
        groups="voip.group_voip_admin"
        action="action_voip_provider_view"/>
</odoo>
