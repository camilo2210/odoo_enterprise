<?xml version="1.0"?>
<odoo>
    <record id="voip_music_on_hold_view_list" model="ir.ui.view">
        <field name="name">voip.music.on.hold.view.list</field>
        <field name="model">voip.music.on.hold</field>
        <field name="arch" type="xml">
            <list string="Music on Hold" duplicate="false">
                <field name="name"/>
                <field name="sort"/>
            </list>
        </field>
    </record>

    <record id="voip_music_on_hold_view_form" model="ir.ui.view">
        <field name="name">voip.music.on.hold.view.form</field>
        <field name="model">voip.music.on.hold</field>
        <field name="arch" type="xml">
            <form string="Music on Hold" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" default_focus="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sort"/>
                    </group>
                    <field name="track_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="audio_message_id" domain="[('data', '!=', False)]" options="{'no_create': True}"/>
                            <field name="filename" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voip_music_on_hold" model="ir.actions.act_window">
        <field name="name">Music on Hold</field>
        <field name="res_model">voip.music.on.hold</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Create your first music on hold playlist</p>
        </field>
    </record>
</odoo>
