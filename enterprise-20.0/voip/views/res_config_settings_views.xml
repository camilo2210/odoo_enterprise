<?xml version="1.0"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.voip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting help="Schedule &amp; make calls from your database">
                    <field name="module_voip"/>
                    <div class="content-group" invisible="not module_voip">
                        <button name="%(voip.action_voip_provider_view)d" icon="east" type="action" string="Manage Providers" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="cloud_storage_error_settings_action" model="ir.actions.act_url">
        <field name="name">Cloud Storage Error - Settings</field>
        <field name="url">/odoo/settings#cloud_storage_provider</field>
        <field name="target">new</field>
    </record>

    <record id="cloud_storage_error_apps_action" model="ir.actions.act_window">
        <field name="name">Install Cloud Storage</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_name': 'cloud_storage'}</field>
        <field name="target">new</field>
    </record>

</odoo>
