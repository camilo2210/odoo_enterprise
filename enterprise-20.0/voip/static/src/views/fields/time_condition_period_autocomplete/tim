<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.TimeConditionPeriodAutocomplete">
        <span t-if="this.props.readonly" t-out="this.readonlyValue"/>
        <Dropdown t-else="" menuClass="'o_voip_time_condition_period_autocomplete_menu p-0'">
            <button type="button" class="o_voip_time_condition_period_autocomplete o_input d-flex align-items-center text-start w-100">
                <span class="text-truncate flex-grow-1" t-out="this.displayValue"/>
                <i class="oi ms-2" data-icon="arrow_drop_down" aria-hidden="true"/>
            </button>
            <t t-set-slot="content">
                <div class="o_voip_time_condition_period_autocomplete_actions d-flex gap-3 px-3 py-2 border-bottom">
                    <button type="button" class="btn btn-link btn-sm p-0" t-att-disabled="this.isAllSelected" t-on-click.stop.prevent="this.selectAll">Select all</button>
                    <button type="button" class="btn btn-link btn-sm p-0" t-att-disabled="this.isEmpty" t-on-click.stop.prevent="this.clearAll">Clear all</button>
                </div>
                <div class="o_voip_time_condition_period_autocomplete_options py-1">
                    <CheckboxItem t-foreach="this.options" t-as="option" t-key="option.value" class="'d-flex'" checked="option.checked" closingMode="'none'" onSelected="() => this.toggle(option.value)">
                        <span class="flex-grow-1" t-out="option.label"/>
                        <i t-if="option.checked" class="oi ms-3" data-icon="check" aria-hidden="true"/>
                    </CheckboxItem>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
