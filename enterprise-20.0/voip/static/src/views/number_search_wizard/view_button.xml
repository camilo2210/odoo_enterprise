<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="voip.NumberSearchViewButton"
       t-inherit="web.views.ViewButton"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-tag='this.props.tag']" position="attributes">
            <attribute name="t-on-pointerdown">(ev) => this.props.record?.resModel === 'voip.did.number.search.wizard' &amp;&amp; ev.preventDefault()</attribute>
        </xpath>
    </t>

</templates>
