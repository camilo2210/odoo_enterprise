<?xml version="1.0"?>
<templates>
    <t t-name="voip.VoipCallIndicatorsField">
        <t t-foreach="this.icons" t-as="icon" t-key="window.JSON.stringify(icon)">
            <i class="oi" t-att-class="icon.classes" t-att-data-icon="icon.name" t-att-title="icon.label" t-att-aria-label="icon.label"/>
        </t>
    </t>
</templates>
