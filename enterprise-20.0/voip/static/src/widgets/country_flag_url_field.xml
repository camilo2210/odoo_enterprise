<?xml version="1.0"?>
<templates>
    <t t-name="voip.CountryFlagUrlField" t-inherit="web.ImageUrlField" t-inherit-mode="primary">
        <xpath expr="//img" position="attributes">
            <attribute name="t-att-alt">this.altText</attribute>
            <attribute name="t-att-data-tooltip">this.tooltip</attribute>
        </xpath>
    </t>
</templates>
