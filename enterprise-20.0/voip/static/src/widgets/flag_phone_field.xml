<templates>
    <t t-name="voip.FlagPhoneField">
        <t t-if="this.props.record.data.country_flag_url">
            <img class="img-fluid me-1" t-att-data-tooltip="this.tooltip" t-att-alt="this.imgAlt" t-att-src="this.props.record.data.country_flag_url" t-att-height="this.height" t-att-width="this.width"/>
        </t>
        <t t-out="this.props.record.data[this.props.name]"/>
    </t>
</templates>
