<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="voip.TTSVoiceSelectionField">
        <div class="o-voip-TTSVoiceSelectionField d-flex flex-row gap-2 align-items-start">
            <SelectMenu t-if="!this.props.readonly and this.state.languages.length"
                class="'o-voip-TTSVoiceSelectionField-language border-0'"
                menuClass="'o_field_selection_menu'"
                value="this.state.languageFilter"
                choices="this.languageChoices"
                onSelect.bind="this.onLanguageChange"
                placeholder="this.languagePlaceholder"
                searchable="!this.isBottomSheet"
                required="true"
            />
            <div class="o-voip-TTSVoiceSelectionField-voice flex-grow-1">
                <t t-call="web.SelectionField"/>
            </div>
        </div>
    </t>

</templates>
