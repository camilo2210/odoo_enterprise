<?xml version="1.0"?>
<templates>
<t t-name="voip.AddCallView">
    <div class="o-voip-AddCallView d-flex flex-column h-100 w-100">
        <t t-if="this.props.state.activeView === 'keypad'">
            <Dialer
                state="this.props.state.keypad"
                onClickBack.bind="this.props.onClickBack"
            />
        </t>
        <t t-if="this.props.state.activeView === 'contacts'">
            <AddressBook
                contactsFilter="this.props.contactExcludeFilter"
                onClickBack.bind="this.props.onClickBack"
            />
        </t>
    </div>
</t>
</templates>
