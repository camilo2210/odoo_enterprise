<?xml version="1.0"?>
<templates>
    <t t-name="voip.SearchBar">
        <div class="d-flex align-items-center py-2 border-bottom">
            <button t-if="this.props.onClickBack" title="Back" class="btn btn-secondary d-flex p-2 me-2 ms-3" t-on-click="() => this.props.onClickBack()">
                <i class="oi" data-icon="west" aria-hidden="true"/>
            </button>
            <input id="o-voip-Tab-searchInput" class="form-control flex-grow-1 border-0" t-att-placeholder="this.props.placeholder" t-model.proxy="this.props.state.searchInputValue" t-on-input="this.props.onInputSearch" t-ref="this.softphone.searchInput"/>
            <button t-if="this.props.onTrailingIconClick" type="button" class="btn btn-sm btn-light px-2 mx-2" t-att-title="this.trailingIconTitle" t-att-aria-label="this.trailingIconTitle" t-on-click="this.props.onTrailingIconClick">
                <i class="oi" t-att-class="this.searchBarIconClasses" t-att-data-icon="this.searchBarIcon" aria-hidden="true"/>
            </button>
            <label t-else="" for="o-voip-Tab-searchInput" class="border border-transparent px-2 mx-2">
                <i class="oi" t-att-class="this.searchBarIconClasses" t-att-data-icon="this.searchBarIcon" aria-hidden="true"/>
            </label>
        </div>
    </t>
</templates>
