<?xml version="1.0"?>
<templates>
<t t-name="voip.ContactInfo">
    <div class="o-voip-ContactInfo w-100 d-flex flex-column align-items-center gap-2" t-att-class="this.props.extraClass">
        <div class="position-relative">
            <DiscussAvatar t-if="this.contact?.partner_share === false" record="this.contact" size="40"/>
            <img t-else="" class="o_avatar rounded-2 object-fit-contain" t-att-class="{ 'o-voip-avatar-bg': this.avatarUrl }" t-att-src="this.avatarUrl or '/base/static/img/avatar_grey.png'" alt=""/>
        </div>
        <div class="w-100 text-center">
            <p t-if="this.contactName" class="mb-0 fs-4 fw-bold text-truncate" t-att-data-tooltip="this.contactName" t-out="this.contactName"/>
            <p t-if="this.contactInfo" class="mb-0 opacity-75 text-truncate" t-out="this.contactInfo"/>
        </div>
    </div>
</t>
</templates>
