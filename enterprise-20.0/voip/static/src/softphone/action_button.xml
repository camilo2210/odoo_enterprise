<?xml version="1.0"?>
<templates>
<t t-name="voip.ActionButton">
    <button t-if="this.props.inCallPad" class="btn d-flex flex-column justify-content-center align-items-center p-2" t-attf-class="{{ this.props.type ? 'btn-' + this.props.type : '' }} {{ this.props.disabled and 'opacity-25' }} {{ this.props.extraClass or '' }}" t-att-title="this.props.title or this.props.name" t-att-disabled="this.props.disabled" t-on-click="this.props.onClick">
        <i class="o-voip-ActionButton-icon oi p-1" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon" aria-hidden="true"/>
        <span t-if="!this.props.hideLabel" class="text-center smaller text-truncate" t-out="this.props.name"/>
    </button>
    <div t-else="" class="position-relative d-flex flex-column align-items-center gap-1" t-att-class="this.props.extraClass">
        <button class="o-voip-ActionButton btn d-flex" t-attf-class="{{ this.props.type ? 'btn-' + this.props.type : '' }} {{ this.props.isSmall ? 'p-2' : 'p-3' }} {{ this.props.innerExtraClass || 'rounded-circle' }}" t-att-class="{ 'o-label-hidden': this.props.hideLabel, active: this.props.isOpen }" t-att-title="this.props.title or this.props.name" t-on-click="this.props.onClick" t-att-disabled="this.props.disabled">
            <i class="o-voip-ActionButton-icon oi" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon" aria-hidden="true"/>
        </button>
        <span t-if="!this.props.hideLabel" class="text-center smaller" t-out="this.props.name"/>
    </div>
</t>
</templates>
