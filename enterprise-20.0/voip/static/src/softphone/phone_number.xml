<?xml version="1.0"?>
<templates>
<t t-name="voip.PhoneNumber">
    <p class="mb-0 opacity-75 text-truncate">
        <span t-if="this.flagUrl" class="o-voip-countryFlag-wrapper d-inline-block me-1 align-middle">
            <img class="o-voip-countryFlag mx-auto" t-att-src="this.flagUrl" t-att-alt="this.flagAlt" t-att-data-tooltip="this.flagTooltip"/>
        </span>
        <i t-else="" class="oi oi-fw oi-filled me-1" data-icon="phone" aria-hidden="true"/>
        <span t-att-class="{ 'align-middle': this.flagUrl }" t-out="this.props.number"/>
    </p>
</t>
</templates>
