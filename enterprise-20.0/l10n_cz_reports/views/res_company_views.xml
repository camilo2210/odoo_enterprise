<odoo>
    <record id="l10n_cz_res_company_form_view_onboarding" model="ir.ui.view">
        <field name="name">l10n_cz.res.company.form.view.onboarding.cz</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.res_company_form_view_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_cz_tax_office_id" invisible="country_code != 'CZ'"/>
            </xpath>
        </field>
    </record>
</odoo>
