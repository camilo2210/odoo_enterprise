<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_tyro.pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
            <tr class="payment-line" position="after">
                <tr t-if="payment.get('tyro_merchant_receipt')" class="pos-payment-terminal-receipt">
                    <td>
                        <pre t-out="payment['tyro_merchant_receipt']"/>
                    </td>
                </tr>
            </tr>
        </template>
    </data>
</odoo>
