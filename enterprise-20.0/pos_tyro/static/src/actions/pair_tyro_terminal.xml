<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="pos_tyro.PairTyroTerminal">
        <div class="d-flex flex-column align-items-center m-4">
            <h2>
                <t t-if="this.state.status !== 'inProgress'" t-out="this.state.status.toUpperCase() + ': '"/>
                <t t-out="this.state.message"/>
            </h2>
            <div style="height: 10px">
                <i t-if="this.state.status === 'inProgress'" class="oi oi-spin" data-icon="progress_activity"></i>
            </div>
        </div>
        <footer class="modal-footer justify-content-around justify-content-md-start flex-wrap gap-1 w-100">
            <button class="btn btn-primary" t-on-click="this.dialog.closeAll" t-att-disabled="this.state.status === 'inProgress'">Close</button>
        </footer>
    </t>

</templates>
