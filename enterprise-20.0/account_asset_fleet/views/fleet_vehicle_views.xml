<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <group>
                    <field name="license_plate" placeholder="Unregistered"/>
                    <field name="color" placeholder="Color"/>
                    <field name="fuel_type" placeholder="Fuel Type"/>
                    <field name="co2" placeholder="CO₂ Emissions"/>
                    <field name="co2_standard" placeholder="Emission Standard"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
