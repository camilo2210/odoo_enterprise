<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mock_account_move_wizard_form" model="ir.ui.view">
        <field name="name">mock.account.move.wizard.form</field>
        <field name="model">mock.account.move.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="not reference">
                    <group>
                        <group>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="accounting_date"/>
                            <field name="journal_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal Items">
                            <field name="line_ids">
                                <list>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="account"/>
                                    <field name="partner"/>
                                    <field name="label"/>
                                    <field name="debit" sum="Total Credit"/>
                                    <field name="credit" sum="Total Debit"/>
                                    <field name="tax_tag_ids" invisible="not tax_tag_ids" widget="many2many_tags"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="account"/>
                                            <field name="partner"/>
                                            <field name="label"/>
                                        </group>
                                        <group>
                                            <field name="debit" sum="Total Credit"/>
                                            <field name="credit" sum="Total Debit"/>
                                            <field name="tax_tag_ids" invisible="not tax_tag_ids" widget="many2many_tags"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <footer/>
                </group>
                <span invisible="reference">No payrun id passed in context.</span>
            </form>
        </field>
    </record>

    <record id="action_open_payrun_move_preview" model="ir.actions.act_window">
        <field name="name">Preview of Journal Entry</field>
        <field name="res_model">mock.account.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>
