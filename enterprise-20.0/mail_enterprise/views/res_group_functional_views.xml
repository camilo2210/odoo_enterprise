<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_group_functional_view_form" model="ir.ui.view">
            <field name="name">res.group.functional.view.form</field>
            <field name="model">res.group.functional</field>
            <field name="arch" type="xml">
                <form string="Group Functional">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options='{"preview_image": "avatar_128"}'/>
                        <div class="oe_title">
                            <label for="name" string="Group Name"/>
                            <h1><field name="name" placeholder="e.g. HR Group"/></h1>
                        </div>
                        <group>
                            <field name="responsible_ids"
                                widget="many2many_avatar_user"
                                options="{'no_create': True}"/>
                            <field name="user_ids"
                                widget="many2many_tags_res_group_users"
                                options="{'no_create': True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="res_group_functional_view_list" model="ir.ui.view">
            <field name="name">res.group.functional.view.list</field>
            <field name="model">res.group.functional</field>
            <field name="arch" type="xml">
                <list string="Group Functional">
                    <field name="name"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                </list>
            </field>
        </record>
        <record id="res_group_functional_action" model="ir.actions.act_window">
            <field name="name">Group</field>
            <field name="res_model">res.group.functional</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
