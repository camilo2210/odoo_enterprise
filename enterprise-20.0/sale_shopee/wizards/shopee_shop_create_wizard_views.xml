<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopee_shop_create_wizard_form" model="ir.ui.view">
        <field name="name">Create Shopee Shop Wizard Form</field>
        <field name="model">shopee.shop.create</field>
        <field name="arch" type="xml">
            <form string="Authorize New Shop">
                <p>
                    Select the Shopee account on which to authorize the new shop, or register another account.
                </p>
                <group>
                    <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div>
                    <button
                        string="Manage Accounts"
                        type="object"
                        name="action_view_accounts"
                        icon="east"
                        class="btn-link ps-0"
                    />
                </div>
                <footer>
                    <button
                        string="Authorize Shop"
                        type="object"
                        name="action_authorize_shop"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="New Account"
                        type="object"
                        name="action_create_account"
                        class="btn-secondary"
                    />
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="shopee_shop_create_wizard_action" model="ir.actions.act_window">
        <field name="name">New Shop</field>
        <field name="res_model">shopee.shop.create</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="shopee_shop_create_wizard_form"/>
    </record>
</odoo>
