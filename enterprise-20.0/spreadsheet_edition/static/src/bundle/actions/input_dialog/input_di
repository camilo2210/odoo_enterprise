<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="spreadsheet_edition.InputDialog">
        <Dialog title="this.props.title || this.defaultTitle" size="'md'">
            <div t-if="this.props.body" t-out="this.props.body"/>
            <input t-att-type="this.props.inputType" class="form-control" t-model.proxy="this.state.inputValue" />
            <span t-if="this.state.error.length" class="text-danger" t-out="this.state.error"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.confirm">Confirm</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
