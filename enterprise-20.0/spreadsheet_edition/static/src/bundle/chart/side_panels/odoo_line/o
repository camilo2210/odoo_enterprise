<odoo>
    <t t-name="spreadsheet_edition.OdooLineChartConfigPanel"
        t-inherit="o-spreadsheet-LineConfigPanel"
        t-inherit-mode="extension"
    >
        <xpath expr="//Checkbox[@name=&quot;'cumulative'&quot;]" position="after">
            <div class="ms-3" t-if="this.props.definition.dataSource?.type === 'odoo'">
                <Checkbox
                    t-if="this.props.definition.cumulative"
                    name="'cumulatedStart'"
                    label.translate="Include historical data"
                    value="this.props.definition.dataSource.cumulatedStart"
                    onChange.bind="this.onUpdateCumulatedStart"
                />
            </div>
        </xpath>
    </t>
</odoo>
