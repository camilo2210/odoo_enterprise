<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-inherit="web.GraphView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('btn-group')][1]" position="after">
            <t t-if="this.canInsertChart and !this.uiService.isSmall">
                <div class="btn-group" role="toolbar" aria-label="Spreadsheet">
                    <button class="btn btn-secondary o_graph_insert_spreadsheet" t-att-disabled="!this.model.hasData() or this.model.useSampleModel" t-on-click="this.onInsertInSpreadsheet">
                        Spreadsheet
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
