<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_subscription.SubscriptionPlanSelector">
        <div class="d-flex justify-content-end mt-2 mb-2 w-100">
            <select class="form-select form-select-sm w-auto" t-att-disabled="this.props.isLocked" t-on-change="this.onChange">
                <option t-foreach="this.props.plans" t-as="plan" t-key="plan.id" t-att-value="plan.id"
                        t-att-selected="plan.id === this.props.selectedPlanId" t-out="plan.display_name"/>
            </select>
        </div>
    </t>

    <t t-inherit="sale.product_price" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='this.props.price_info']" position="replace">
            <t t-if="this.props.optional
                     and this.props.subscription_plans
                     and this.props.subscription_plans.length
                     and this.env.subscriptionState">
                <SubscriptionPlanSelector
                    plans="this.props.subscription_plans"
                    selectedPlanId="this.env.subscriptionState.selectedPlanId"
                    isLocked="!!this.env.subscriptionState.lockedPlanId"
                />
                <div t-if="this.env.subscriptionState.selectedPlanId
                           and !this.props.subscription_plans.find(
                               p => p.id === this.env.subscriptionState.selectedPlanId
                           )"
                     class="text-danger small text-end text-nowrap w-100">
                    <i class="oi me-1" data-icon="warning"/>Plan not available
                </div>
            </t>
            <t t-elif="this.props.price_info">
                <div t-out="this.props.price_info" class="text-muted"/>
            </t>
        </xpath>
    </t>
</templates>
