<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_contract_salary_view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <label for="l10n_sa_iqama_annual_amount" string="Iqama" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'"/>
                <div class="o_row" name="l10n_sa_iqama_annual_amount" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'">
                    <field name="l10n_sa_iqama_annual_amount" class="o_hr_narrow_field"/>
                    <span>/ year</span>
                </div>
                <label for="l10n_sa_medical_insurance_annual_amount" string="Medical Insurance" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'"/>
                <div class="o_row" name="l10n_sa_medical_insurance_annual_amount" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'">
                    <field name="l10n_sa_medical_insurance_annual_amount" class="o_hr_narrow_field"/>
                    <span>/ year</span>
                </div>
                <label for="l10n_sa_work_permit_annual_amount" string="Work Permit" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'"/>
                <div class="o_row" name="l10n_sa_work_permit_annual_amount" invisible="nationality_country_code == 'SA' or company_country_code != 'SA'">
                    <field name="l10n_sa_work_permit_annual_amount" class="o_hr_narrow_field"/>
                    <span>/ year</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
