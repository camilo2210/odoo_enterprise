<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_return_kanban_view" model="ir.ui.view">
        <field name="name">l10n_be.account.return.kanban</field>
        <field name="model">account.return</field>
        <field name="inherit_id" ref="account_reports.account_return_kanban_view"/>
        <field name="arch" type="xml">
            <kanban js_class="account_return_kanban" position="inside">
                <field name="l10n_be_isoc_payment_form_id" invisible="1"/>
            </kanban>
            <a name="action_reset_tax_return_common" position="before">
                <a invisible="state not in ['submitted', 'paid'] or type_external_id != 'l10n_be_reports.be_vat_return_type'"
                   class="dropdown-item"
                   type="object"
                   name="l10n_be_action_fetch_from_intervat"
                   string="Fetch from Intervat"/>
            </a>
            <a name="action_reset_tax_return_common" position="after">
                <a invisible="not state and not is_completed or type_external_id != 'l10n_be_reports.be_isoc_prepayment_return_type'" class="dropdown-item" type="object" name="l10n_be_reset_tax_prepayment" string="Reset"/>
                <a invisible="not state and not is_completed or type_external_id != 'l10n_be_reports.be_vat_listing_return_type'" class="dropdown-item" type="object" name="action_reset_2_states" string="Reset"/>
            </a>

            <div id="return_amount_to_pay" position="attributes">
                <attribute name="invisible" add="type_external_id != 'l10n_be_reports.be_isoc_prepayment_return_type' or (type_external_id == 'l10n_be_reports.be_isoc_prepayment_return_type' and state != 'paid')" separator="and"/>
            </div>

            <field name="period_amount_to_pay" position="attributes">
                <attribute name="invisible">type_external_id == 'l10n_be_reports.be_isoc_prepayment_return_type'</attribute>
            </field>

            <xpath expr="//div[@id='return_amount_to_pay']/div[hasclass('o_account_return_amount')]" position="inside">
                <field name="total_amount_to_pay"
                       invisible="type_external_id != 'l10n_be_reports.be_isoc_prepayment_return_type'"/>
            </xpath>

            <xpath expr="//t[@id='default_buttons']" position="replace">
                <t id="default_buttons">
                    <t t-if="record.type_external_id.raw_value == 'l10n_be_reports.be_isoc_prepayment_return_type' &amp;&amp; in_checks_view &amp;&amp; !record.is_completed.raw_value">
                        <field name="l10n_be_isoc_mute_buttons" invisible="1"/>
                        <t t-if="record.l10n_be_isoc_mute_buttons.raw_value">
                            <button
                                name="action_be_isoc_send_email"
                                type="object"
                                string="Send Email"
                                class="btn btn-secondary readonly"
                                disabled="1"
                            />
                            <button
                                name="action_be_isoc_mark_paid"
                                type="object"
                                string="Mark Paid"
                                class="btn btn-primary readonly"
                                disabled="1"
                            />
                        </t>
                        <t t-else="">
                            <!-- Enabled version -->
                            <button
                                name="action_be_isoc_send_email"
                                type="object"
                                string="Send Email"
                                class="btn btn-secondary readonly"
                            />
                            <button
                                name="action_be_isoc_mark_paid"
                                type="object"
                                string="Mark Paid"
                                class="btn btn-primary readonly"
                            />
                        </t>
                        
                    </t>
                    <t t-else="">$0</t>
                </t>
            </xpath>

            <xpath expr="//div[@id='return_amount_to_pay']/span" position="attributes">
                <attribute name="t-att-class">{
                    'invisible': record.total_amount_to_pay.raw_value == record.period_amount_to_pay.raw_value
                        or record.type_external_id.raw_value == 'l10n_be_reports.be_isoc_prepayment_return_type'
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
