#. module: l10n_be_reports
#: model:mail.template,body_html:l10n_be_reports.email_template_vat_payment_instructions
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Dear <t t-out=\"object.company_id.name\">BE Company CoA</"
"t>,\n"
"                </p>\n"
"                <p>\n"
"                    Based on the documents and information received, the VAT "
"return of <t t-out=\"object.company_id.name\">BE Company CoA</t>\n"
"                    for period <t t-"
"out=\"object.type_id._get_period_name(object.company_id, object.date_from, "
"object.date_to)\"/> has been submitted.\n"
"                </p>\n"
"                <p>\n"
"                    It has been determined that an amount of <t t-"
"out=\"format_amount(object.total_amount_to_pay, "
"object.amount_to_pay_currency_id)\"/> remains payable.\n"
"                </p>\n"
"                <t t-call=\"l10n_be_reports.vat_payment_details_table\"/>\n"
"                <p>Kind regards,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Geachte <t t-out=\"object.company_id.name\">BE Company "
"CoA</t>,\n"
"                </p>\n"
"                <p>\n"
"                    Op basis van de ontvangen documenten en informatie is de "
"btw-aangifte van <t t-out=\"object.company_id.name\">BE Company CoA</t>\n"
"                    over de periode <t t-"
"out=\"object.type_id._get_period_name(object.company_id, object.date_from, "
"object.date_to)\"/> ingediend.\n"
"                </p>\n"
"                <p>\n"
"                    Vastgesteld is dat een bedrag van <t t-"
"out=\"format_amount(object.total_amount_to_pay, "
"object.amount_to_pay_currency_id)\"/> verschuldigd blijft.\n"
"                </p>\n"
"                <t t-call=\"l10n_be_reports.vat_payment_details_table\"/>\n"
"                <p>Met vriendelijke groeten,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "

#. module: l10n_be_reports
#: model:mail.template,body_html:l10n_be_reports.email_template_vai_payment_instructions
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Dear <t t-out=\"object.company_id.name\">BE Company CoA</"
"t>,\n"
"                </p>\n"
"                <p>\n"
"                    Your upcoming <t t-"
"out=\"object.type_id._get_period_name(object.company_id, object.date_from, "
"object.date_to)\"/> Advance Tax Payment is due on <t t-"
"out=\"format_date(object.date_deadline) or ''\"/>\n"
"                    To avoid any penalties or interest charges, we recommend "
"making the payment before this date.\n"
"                </p>\n"
"                <t t-call=\"l10n_be_reports.vat_payment_details_table\"/>\n"
"                <p>Kind regards,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
