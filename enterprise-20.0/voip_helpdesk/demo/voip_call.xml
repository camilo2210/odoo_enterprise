<?xml version="1.0"?>
<odoo noupdate="0">

<record id="voip_helpdesk_activity_demo" model="mail.activity">
    <field name="res_id" ref="helpdesk.helpdesk_ticket_12"/>
    <field name="res_model_id" ref="helpdesk.model_helpdesk_ticket"/>
    <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
    <field name="summary">Call back about the claim follow-up</field>
    <field name="date_deadline" eval="(datetime.now() - timedelta(days=12)).date()"/>
    <field name="active" eval="False"/>
    <field name="create_uid" ref="base.user_admin"/>
    <field name="user_id" ref="base.user_admin"/>
</record>

<record id="voip_activity_message_demo_helpdesk" model="mail.message">
    <field name="model">helpdesk.ticket</field>
    <field name="res_id" ref="helpdesk.helpdesk_ticket_12"/>
    <field name="subtype_id" ref="mail.mt_activities"/>
    <field name="message_type">notification</field>
    <field name="author_id" ref="base.partner_admin"/>
    <field name="mail_activity_type_id" ref="mail.mail_activity_data_call"/>
    <field name="date" eval="datetime.now().replace(hour=7, minute=50, second=13, microsecond=0) - timedelta(days=12)"/>
    <field name="body" model="mail.render.mixin" eval="obj().env['mail.render.mixin']._render_template_qweb_view('voip.message_call_activity_done', 'helpdesk.ticket', [ref('helpdesk.helpdesk_ticket_12')], add_context={'activity': obj().env.ref('voip_helpdesk.voip_helpdesk_activity_demo'), 'feedback': False, 'display_assignee': False})[ref('helpdesk.helpdesk_ticket_12')]"/>
</record>

<record id="voip.voip_call_demo_helpdesk_logged" model="voip.call">
    <field name="activity_id" ref="voip_helpdesk_activity_demo"/>
    <field name="activity_mail_message_id" ref="voip_activity_message_demo_helpdesk"/>
</record>

<function model="voip.call" name="update_activity_message" eval="[[ref('voip.voip_call_demo_helpdesk_logged')]]"/>

</odoo>
