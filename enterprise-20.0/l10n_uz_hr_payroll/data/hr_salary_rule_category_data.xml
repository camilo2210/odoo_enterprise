<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uz_category_gross" model="hr.salary.rule.category">
        <field name="name">Gross</field>
        <field name="code">GROSS</field>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="l10n_uz_category_total_wage" model="hr.salary.rule.category">
        <field name="name">Total Wage</field>
        <field name="code">TOTAL_WAGE</field>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="l10n_uz_category_basic" model="hr.salary.rule.category">
        <field name="name">Basic</field>
        <field name="code">UZ_BASIC</field>
        <field name="country_id" ref="base.uz"/>
        <field name="parent_id" ref="l10n_uz_hr_payroll.l10n_uz_category_total_wage"/>
    </record>

    <record id="l10n_uz_category_allowance" model="hr.salary.rule.category">
        <field name="name">Allowance</field>
        <field name="code">ALW</field>
        <field name="country_id" ref="base.uz"/>
        <field name="parent_id" ref="l10n_uz_hr_payroll.l10n_uz_category_total_wage"/>
    </record>

    <record id="l10n_uz_category_tax_base" model="hr.salary.rule.category">
        <field name="name">Tax Base</field>
        <field name="code">TAX_BASE</field>
        <field name="country_id" ref="base.uz"/>
        <field name="parent_id" ref="l10n_uz_hr_payroll.l10n_uz_category_gross"/>
    </record>

</odoo>
