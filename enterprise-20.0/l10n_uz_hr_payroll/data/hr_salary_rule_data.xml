<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uz_monthly_pay_basic_salary" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_category_basic')])]"/>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['BASIC']
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_monthly_pay_structure')])]"/>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="l10n_uz_monthly_pay_seniority_supplement" model="hr.salary.rule">
        <field name="name">Seniority Supplement</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_category_allowance')])]"/>
        <field name="code">SENIORITY_SUPPLEMENT</field>
        <field name="sequence">10</field>
        <field name="input_usage_payslip" eval="False"/>
        <field name="input_usage_employee" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'SENIORITY_SUPPLEMENT' in inputs</field>
        <field name="input_section" ref="hr_payroll.default_salary_rule_section"/>
        <field name="input_suffix">%</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result_rate = inputs['SENIORITY_SUPPLEMENT'].amount
result = categories['BASIC']
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_monthly_pay_structure')])]"/>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="l10n_uz_monthly_pay_bonus" model="hr.salary.rule">
        <field name="name">Bonus</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_category_allowance')])]"/>
        <field name="code">BONUS</field>
        <field name="sequence">20</field>
        <field name="input_usage_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'BONUS' in inputs</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs['BONUS'].amount
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_monthly_pay_structure')])]"/>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="l10n_uz_monthly_pay_other_allowance" model="hr.salary.rule">
        <field name="name">Other Allowance</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_uz_hr_payroll.l10n_uz_category_allowance')])]"/>
        <field name="code">OTHER_ALLOWANCE</field>
        <field name="sequence">30</field>
        <field name="input_usage_payslip" eval="False"/>
        <field name="input_usage_employee" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'OTHER_ALLOWANCE' in inputs</field>
        <field name="input_section" ref="hr_payroll.default_salary_rule_section"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
