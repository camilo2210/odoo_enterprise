<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_l10n_uz" model="ir.ui.view">
        <field name="name">hr.employee.form.uz.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="after">
                <group name="l10n_uz_payroll_leaves" string="Uzbekistan Payroll" groups="hr_payroll.group_hr_payroll_user" invisible="company_country_code != 'UZ'">
                    <label for="l10n_uz_annual_leave_eligibility" string="Eligible Leaves"/>
                    <div class="o_row">
                        <field name="l10n_uz_annual_leave_eligibility" 
                               class="oe_inline o_hr_narrow_field" 
                               nolabel="1" 
                               readonly="0"/>
                        <span>days / year</span>
                    </div>

                    <label for="l10n_uz_initial_average_monthly_wage" string="Initial Average Monthly Wage"/>
                    <div class="o_row">
                        <field name="l10n_uz_initial_average_monthly_wage" readonly="1" class="oe_inline me-2"/>
                        <button name="action_open_initial_wage_update_wizard" 
                                type="object"
                                class="btn btn-link p-0 oe_inline"
                                title="Adjust Initial Wage">
                            <span class="oi oi-fw me-1" data-icon="edit"/>
                            <span>Edit</span>
                        </button>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
