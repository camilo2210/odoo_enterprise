<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="appointments_cards" inherit_id="website_appointment_sale.appointments_cards">
    <!-- Use _resolve_product_combination_info to support both HTTP and AI flows
         where the request object may not be available. -->
    <xpath expr="//t[@t-set='combination_info']" position="replace">
        <t t-set="combination_info" t-value="appointment.product_id._resolve_product_combination_info().get(appointment.product_id.id, {})"/>
    </xpath>
</template>
</odoo>
