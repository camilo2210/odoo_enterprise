<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paid time: remuneration, compulsory insurance base and taxable income -->
        <record id="hr_work_entry.vn_work_entry_type_attendance" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_home_working" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_compensatory" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_legal_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_public_holiday" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.l10n_vn_work_entry_type_marriage_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.l10n_vn_work_entry_type_bereavement_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_vn_hr_payroll.VN_REMUNERATION_BASE'),
                ref('l10n_vn_hr_payroll.VN_SI_BASE'),
                ref('l10n_vn_hr_payroll.VN_PIT_TAXABLE'),
            ])]"/>
        </record>

        <!-- Overtime hours are paid by the overtime rules at the rate of their premium pays -->
        <record id="hr_work_entry.vn_work_entry_type_overtime" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.EXTRA_HOURS')])]"/>
            <field name="display_hours" eval="True"/>
        </record>

        <!-- Time without wage: out of contract, unpaid leave and the leaves compensated by the social insurance fund -->
        <record id="hr_work_entry.vn_hr_work_entry_type_out_of_contract" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_unpaid_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.vn_work_entry_type_sick_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_vn_work_entry_type_maternity_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_vn_work_entry_type_paternity_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>
    </data>
</odoo>
