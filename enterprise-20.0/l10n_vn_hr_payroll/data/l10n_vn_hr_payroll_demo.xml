<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.demo_company_vn" model="res.company" forcecreate="1">
        <field name="name">VN Company</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="street">Lê A</field>
        <field name="city">Phường Bảo Vinh</field>
        <field name="zip">76463</field>
        <field name="country_id" ref="base.vn"/>
        <field name="resource_calendar_id" ref="l10n_vn_hr_payroll.resource_calendar_vn_40"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_vn'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_vn'))]"/>
    </record>

    <record id="hr_department_rdvn" model="hr.department">
        <field name="name">RD VN</field>
        <field name="company_id" ref="base.demo_company_vn"/>
    </record>

    <record id="hr_employee_nguyen_van_an" model="hr.employee">
        <field name="name">Nguyễn Văn An</field>
        <field name="job_id" ref="hr.job_developer"/>
        <field name="country_id" ref="base.vn"/>
        <field name="company_id" ref="base.demo_company_vn"/>
        <field name="department_id" ref="hr_department_rdvn"/>
        <field name="sex">male</field>
        <field name="structure_type_id" ref="l10n_vn_hr_payroll.structure_type_employee_vn"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage">35000000</field>
        <field name="l10n_vn_dependants">1</field>
        <field name="l10n_vn_union_member" eval="True"/>
        <field name="date_version" eval="(DateTime.today() + relativedelta(years=-2, month=1, day=1))"/>
        <field name="contract_date_start" eval="(DateTime.today() + relativedelta(years=-2, month=1, day=1))"/>
        <field name="resource_calendar_id" ref="l10n_vn_hr_payroll.resource_calendar_vn_40"/>
    </record>

    <record id="hr_employee_tran_thi_binh" model="hr.employee">
        <field name="name">Trần Thị Bình</field>
        <field name="job_id" ref="hr.job_consultant"/>
        <field name="country_id" ref="base.vn"/>
        <field name="company_id" ref="base.demo_company_vn"/>
        <field name="department_id" ref="hr_department_rdvn"/>
        <field name="parent_id" ref="hr_employee_nguyen_van_an"/>
        <field name="sex">female</field>
        <field name="structure_type_id" ref="l10n_vn_hr_payroll.structure_type_employee_vn"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage">18000000</field>
        <field name="l10n_vn_minimum_wage_region">2</field>
        <field name="date_version" eval="(DateTime.today() + relativedelta(years=-1, month=1, day=1))"/>
        <field name="contract_date_start" eval="(DateTime.today() + relativedelta(years=-1, month=1, day=1))"/>
        <field name="resource_calendar_id" ref="l10n_vn_hr_payroll.resource_calendar_vn_40"/>
    </record>
</odoo>
