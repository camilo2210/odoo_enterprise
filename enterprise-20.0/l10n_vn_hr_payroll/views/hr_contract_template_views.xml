<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10n_vn_hr_payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group string="Vietnamese Payroll" name="l10n_vn_payroll" invisible="country_code != 'VN'">
                    <field name="l10n_vn_pit_method" class="o_hr_narrow_field"/>
                    <field name="l10n_vn_minimum_wage_region" string="Minimum Wage Zone" class="o_hr_narrow_field"/>
                    <field name="l10n_vn_union_member"/>
                    <field name="l10n_vn_insurance_exempt"/>
                    <field name="l10n_vn_net_salary"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
