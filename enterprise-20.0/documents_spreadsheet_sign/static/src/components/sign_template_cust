<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="sign.SignTemplateCustomCogMenu"
       t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@onSelected.bind='this.onTemplatePropertiesClick']" position="after">
            <DropdownItem t-if="this.canViewAnswers" class="'o_menu_item'" onSelected.bind="this.onOpenSpreadsheetClick">
                <i class="oi oi-fw" data-icon="table_chart"/> Export Answers
            </DropdownItem>
        </xpath>
    </t>
</templates>
