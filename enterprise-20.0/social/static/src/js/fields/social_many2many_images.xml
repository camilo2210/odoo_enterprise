<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="social.SocialMany2manyImages">
        <div t-if="this.attachmentsIds.length >= 2" class="d-flex flex-row">
            <img class="social_many2many_image w-75"
                t-attf-src="/web/image/social.post.image/{{this.attachmentsIds[0]}}/raw" alt="Post Image" />
            <a class="o_social_original_post_image_more position-relative d-flex ms-1 w-25"
                t-on-click.stop.prevent="this.onClickMoreImages">
                <img class="social_many2many_image w-100"
                    t-attf-src="/web/image/social.post.image/{{this.attachmentsIds[1]}}/raw" alt="Post Image" />
                <div class="o_social_stream_post_content_more_overlay d-flex align-items-center h-100 w-100 text-white justify-content-center position-absolute h1 m-0 user-select-none">
                    <t t-if="this.attachmentsIds.length > 2">+<t t-out="this.attachmentsIds.length - 1"/></t>
                </div>
            </a>
        </div>
        <img t-elif="this.attachmentsIds.length === 1"
            class="social_many2many_image w-100"
            t-attf-src="/web/image/social.post.image/{{this.attachmentsIds[0]}}/raw"
            alt="Post Image"
            t-on-click.stop.prevent="this.onClickMoreImages"/>
    </t>
</templates>
