<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_post_image_view_kanban" model="ir.ui.view">
        <field name="name">social.post.image.view.kanban</field>
        <field name="model">social.post.image</field>
        <field name="arch" type="xml">
            <kanban string="Post Images" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <templates>
                    <t t-name="card" class="p-0 border-0 o_social_post_image_card">
                        <div class="card">
                            <field class="card-img-top text-center" name="attachment_id" widget="x2_many_image"
                                options="{'preview_image': 'raw', 'set_attachment_id': True, 'only_image': True}"/>
                            <div class="p-2 m-0 bg-200 text-center">
                                <field name="name" class="small fs-5 text-truncate d-block"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
