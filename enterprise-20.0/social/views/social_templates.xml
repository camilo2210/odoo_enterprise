<odoo>
    <template id="social_http_error_view" name="Social HTTP Error Template">
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <t t-set="head">
            <t t-call-assets="web.assets_frontend" t-js="false"/>
        </t>
        <t t-call="web.layout" html_data="{'style': 'height: 100%;'}" head="head">
            <div class="row h-75">
                <div class="alert alert-danger m-auto col-10 col-lg-4 w-auto" role="alert">
                    <h4 class="alert-heading"><b>An error occurred while trying to link your account</b></h4>
                    <t t-out="error_message" />
                    <t t-if="documentation_data and documentation_data['documentation_link']">
                        <a t-att-href="documentation_data['documentation_link']" target="_blank">
                            <t t-out="documentation_data['documentation_link_label']"/> <i t-att-class="documentation_data['documentation_link_icon_class']"/>
                        </a>
                    </t>
                    <hr/>
                    <button onclick="window.close()" class="btn btn-link"><i class="oi" data-icon="west"/> Go back to Odoo</button>
                </div>
            </div>
        </t>
    </template>

    <!-- Template that is used to send the notification to the main page when the authentication is done -->
    <template id="social_http_authentication_done" name="Social Authentication Done">
        <script>
            window.opener.parent.postMessage(
                { name: "social-authentication-done" },
                window.location.origin,
            );
        </script>
    </template>

    <template id="social_http_authentication_redirect" name="Social Authentication Redirect">
        <html>
            <head>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <meta http-equiv="Refresh" t-attf-content="0; URL={{redirect}}" />
            </head>
            <body class="d-flex flex-column justify-content-center gap-2 align-items-center">
                <b>Connecting your account...</b>
                <div class="spinner-border" role="status"/>
            </body>
        </html>
    </template>
</odoo>
