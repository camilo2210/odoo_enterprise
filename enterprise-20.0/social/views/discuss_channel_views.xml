<?xml version="1.0"?>
<odoo>
<data>
    <record id="discuss_channel_view_kanban" model="ir.ui.view">
        <field name="name">discuss.channel.kanban.inherit.social</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="im_livechat.discuss_channel_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='livechat_customer_history_ids']" position="after">
                <field name="name" class="fw-bolder" invisible="not livechat_social_account_id"/>
            </xpath>
            <xpath expr="//field[@name='livechat_customer_history_ids']" position="attributes">
                <attribute name="invisible" separator="or">livechat_social_account_id</attribute>
            </xpath>
        </field>
    </record>
</data>
</odoo>
