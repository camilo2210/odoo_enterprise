<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_hk_hr_payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_accountant']" position="after">
                <field name="company_country_code" invisible="1"/>
                <block title="Hong Kong Localization" id="l10n_hk_hr_payroll" invisible="company_country_code != 'HK'">
                    <setting id="company_information" string="Company Information" help="Official Company Information" company_dependent="1">
                        <div class="mt16 content-group">
                            <div class="row ms-2">
                                <label for="l10n_hk_employer_name" class="col-md-6 p-0 m-0"/>
                                <field name="l10n_hk_employer_name" class="col-md-6 p-0"/>
                            </div>
                            <div class="row ms-2 align-items-center">
                                <div class="col-md-6 d-flex align-items-center p-0 m-0">
                                    <label for="l10n_hk_employer_file_number"/>
                                    <div class="oi ms-2" data-icon="help"
                                         title="Employee File Number should be formatted like this XXX-11111111.">
                                    </div>
                                </div>
                                <field name="l10n_hk_employer_file_number" placeholder="EEN-12345678" class="col-md-6 p-0"/>
                            </div>
                            <button name="open_mpf_scheme_list" icon="east" type="object" string="Configure your MPF Schemes"
                                    class="btn-link"/>
                        </div>
                    </setting>
                    <setting string="Salaries Bank Account" help="Company bank account to be used in the AutoPay report" id="l10n_hk_autopay_partner_bank_id">
                        <field name="l10n_hk_autopay_partner_bank_id" domain="[('country_code', '=', 'HK')]" options='{"no_create": True}'/>
                    </setting>
                    <setting id="advantages" string="Advantages" help="Configure Default Values for Hong Kong Advantages">
                        <div name="default_advantages" class="mt16 content-group">
                            <div class="row ms-2">
                                <label for="default_l10n_hk_internet" class="col-md-7 p-0 m-0"/>
                                <div class="col-md-5 p-0">
                                    <field name="currency_id" invisible="1"/>  <!-- for the monetary field -->
                                    <field name="default_l10n_hk_internet" nolabel="1"/>
                                    <span>/ period</span>
                                </div>
                            </div>
                            <div class="row ms-2">
                                <label for="l10n_hk_eoy_pay_month" class="col-md-7 p-0 m-0"/>
                                <div class="col-md-5 p-0">
                                    <field name="l10n_hk_eoy_pay_month" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
