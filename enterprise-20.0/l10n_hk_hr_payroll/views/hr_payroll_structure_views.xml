<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_list_view" model="ir.ui.view">
        <field name="name">hr.payroll.structure.list</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payroll_structure_list_view"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="l10n_hk_is_termination_pay" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_hr_employee_grade_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <field name="schedule_pay" position="after">
                <field name="l10n_hk_is_termination_pay" invisible="country_code != 'HK'"/>
            </field>
        </field>
    </record>
</odoo>
