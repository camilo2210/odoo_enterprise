<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_public_view_form_inherit_l10n_hk_hr_payroll" model="ir.ui.view">
            <field name="name">hr.employee.public.form.inherit.l10n_hk_hr_payroll</field>
            <field name="model">hr.employee.public</field>
            <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="l10n_hk_action_open_rentals" type="object" class="oe_stat_button" icon="home" invisible="not is_user or country_code != 'HK'">
                        <field name="l10n_hk_rentals_count" widget="statinfo" string="Rentals"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
