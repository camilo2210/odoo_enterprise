<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ir56m_xml_report">
        <IR56M xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="ir56m.xsd">
            <Section><t t-out="data['Section']" /></Section>
            <ERN><t t-out="data['ERN']"/></ERN>
            <YrErReturn><t t-out="data['YrErReturn']" /></YrErReturn>
            <SubDate><t t-out="data['SubDate'].strftime('%Y%m%d')" /></SubDate>
            <PayerName><t t-out="data['ErName']" /></PayerName>
            <NAME_OF_SIGNER><t t-out="data['NAME_OF_SIGNER'].upper()" /></NAME_OF_SIGNER>
            <Designation><t t-out="data['Designation']" /></Designation>
            <NoRecordBatch><t t-out="'{:05}'.format(int(total_data['NoRecordBatch']))"/></NoRecordBatch>
            <TotIncomeBatch><t t-out="int(total_data['TotIncomeBatch'])" /></TotIncomeBatch>
            <IR56VER>M0001</IR56VER>
            <t t-foreach="employees_data" t-as="recipient">
                <Recipient>
                    <SheetNo><t t-out="'{:06}'.format(recipient['SheetNo'])" /></SheetNo>
                    <TypeOfForm><t t-out="recipient['TypeOfForm']" /></TypeOfForm>
                    <ComRecNameEng><t t-out="recipient['ComRecNameEng']"/></ComRecNameEng>
                    <ComRecNameChi><t t-out="recipient['ComRecNameChi']"/></ComRecNameChi>
                    <ComRecBRN><t t-out="recipient['ComRecBRN']"/></ComRecBRN>
                    <HKID><t t-out="recipient['HKID'].replace('(', '').replace(')', '')" /></HKID>
                    <Surname><t t-out="recipient['Surname']"/></Surname>
                    <GivenName><t t-out="recipient['GivenName']"/></GivenName>
                    <NameInChinese><t t-out="recipient['NameInChinese']" /></NameInChinese>
                    <Sex><t t-out="recipient['Sex']" /></Sex>
                    <MaritalStatus><t t-out="recipient['MaritalStatus']" /></MaritalStatus>
                    <SpouseName><t t-out="recipient['SpouseName']" /></SpouseName>
                    <SpouseHKID><t t-out="recipient['SpouseHKID'].replace('(', '').replace(')', '')" /></SpouseHKID>
                    <SpousePpNum><t t-out="recipient['SpousePpNum']" /></SpousePpNum>
                    <POS_ADDR_LINE1><t t-out="recipient['RES_ADDR_LINE1']"/></POS_ADDR_LINE1>
                    <POS_ADDR_LINE2><t t-out="recipient['RES_ADDR_LINE2']"/></POS_ADDR_LINE2>
                    <POS_ADDR_LINE3><t t-out="recipient['RES_ADDR_LINE3']"/></POS_ADDR_LINE3>
                    <POS_ADDR_AREA><t t-out="recipient['AreaCodeResAddr']" /></POS_ADDR_AREA>
                    <PhoneNum><t t-out="recipient['PhoneNum']"/></PhoneNum>
                    <Capacity><t t-out="recipient['Capacity']" /></Capacity>
                    <RTN_ASS_YR><t t-out="recipient['RTN_ASS_YR']" /></RTN_ASS_YR>
                    <StartDateOfService><t t-out="recipient['StartDateOfEmp'].strftime('%Y%m%d')" /></StartDateOfService>
                    <EndDateOfService><t t-out="recipient['EndDateOfEmp'].strftime('%Y%m%d')"/></EndDateOfService>
                    <AmtOfType1><t t-out="recipient['AmtOfType1']"/></AmtOfType1>
                    <AmtOfType2><t t-out="recipient['AmtOfType2']"/></AmtOfType2>
                    <AmtOfType3><t t-out="recipient['AmtOfType3']"/></AmtOfType3>
                    <AmtOfArtistFee><t t-out="recipient['AmtOfArtistFee']"/></AmtOfArtistFee>
                    <AmtOfCopyright><t t-out="recipient['AmtOfCopyright']"/></AmtOfCopyright>
                    <AmtOfConsultFee><t t-out="recipient['AmtOfConsultFee']"/></AmtOfConsultFee>
                    <AmtOfServiceFee><t t-out="recipient['AmtOfServiceFee']"/></AmtOfServiceFee>
                    <NatureOtherInc><t t-out="recipient['NatureOtherInc']"/></NatureOtherInc>
                    <AmtOfOtherInc><t t-out="recipient['AmtOfOtherInc']"/></AmtOfOtherInc>
                    <TotalIncome><t t-out="recipient['TotalIncome']"/></TotalIncome>
                    <IndOfSumWithheld><t t-out="recipient['IndOfSumWithheld']"/></IndOfSumWithheld>
                    <AmtOfSumWithheld><t t-out="recipient['AmtOfSumWithheld']"/></AmtOfSumWithheld>
                    <Remarks><t t-out="recipient['Remarks']"/></Remarks>
                </Recipient>
            </t>
        </IR56M>
    </template>
</odoo>
