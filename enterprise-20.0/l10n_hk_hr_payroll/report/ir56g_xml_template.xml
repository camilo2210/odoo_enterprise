<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ir56g_xml_report">
        <IR56G xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="ir56g.xsd">
            <Section><t t-out="data['Section']" /></Section>
            <ERN><t t-out="data['ERN']"/></ERN>
            <SubDate><t t-out="data['SubDate'].strftime('%Y%m%d')" /></SubDate>
            <ErName><t t-out="data['ErName']" /></ErName>
            <NAME_OF_SIGNER><t t-out="data['NAME_OF_SIGNER'].upper()" /></NAME_OF_SIGNER>
            <Designation><t t-out="data['Designation']" /></Designation>
            <NoRecordBatch><t t-out="total_data['NoRecordBatch']"/></NoRecordBatch>
            <TotIncomeBatch><t t-out="total_data['TotIncomeBatch']" /></TotIncomeBatch>
            <IR56VER>G0001</IR56VER>
            <t t-foreach="employees_data" t-as="employee_data">
                <t t-set="emp_start_date" t-value="employee_data.get('StartDateOfEmp').strftime('%Y%m%d')"/>
                <t t-set="emp_end_date" t-value="employee_data.get('EndDateOfEmp').strftime('%Y%m%d')"/>
                <t t-set="emp_period_str" t-value="'{} - {}'.format(emp_start_date, emp_end_date)"/>
                <Employee>
                    <SheetNo><t t-out="'{:06}'.format(employee_data['SheetNo'])" /></SheetNo>
                    <HKID><t t-out="employee_data['HKID'].replace('(', '').replace(')', '')" /></HKID>
                    <TypeOfForm><t t-out="employee_data['TypeOfForm']" /></TypeOfForm>
                    <Surname><t t-out="employee_data['Surname']"/></Surname>
                    <GivenName><t t-out="employee_data['GivenName']"/></GivenName>
                    <NameInChinese><t t-out="employee_data['NameInChinese']" /></NameInChinese>
                    <EE_TAX_SECTION><t t-out="employee_data['tax_file_section']" /></EE_TAX_SECTION>
                    <EE_TAX_PRN><t t-out="employee_data['tax_file_prn']" /></EE_TAX_PRN>
                    <Sex><t t-out="employee_data['Sex']" /></Sex>
                    <MaritalStatus><t t-out="employee_data['MaritalStatus']" /></MaritalStatus>
                    <PpNum><t t-out="employee_data['PpNum']" /></PpNum>
                    <SpouseName><t t-out="employee_data['SpouseName']" /></SpouseName>
                    <SpouseHKID><t t-out="employee_data['SpouseHKID'].replace('(', '').replace(')', '')" /></SpouseHKID>
                    <SpousePpNum><t t-out="employee_data['SpousePpNum']" /></SpousePpNum>
                    <RES_ADDR_LINE1><t t-out="employee_data['RES_ADDR_LINE1']"/></RES_ADDR_LINE1>
                    <RES_ADDR_LINE2><t t-out="employee_data['RES_ADDR_LINE2']"/></RES_ADDR_LINE2>
                    <RES_ADDR_LINE3><t t-out="employee_data.get('RES_ADDR_LINE3')"/></RES_ADDR_LINE3>
                    <AreaCodeResAddr><t t-out="employee_data['AreaCodeResAddr']" /></AreaCodeResAddr>
                    <POS_ADDR_LINE1><t t-out="employee_data['POS_ADDR_LINE1']"/></POS_ADDR_LINE1>
                    <POS_ADDR_LINE2><t t-out="employee_data['POS_ADDR_LINE2']"/></POS_ADDR_LINE2>
                    <POS_ADDR_LINE3><t t-out="employee_data['POS_ADDR_LINE3']"/></POS_ADDR_LINE3>
                    <POS_ADDR_AREA><t t-out="employee_data['POS_ADDR_AREA']"/></POS_ADDR_AREA>
                    <Capacity><t t-out="employee_data['Capacity']" /></Capacity>
                    <RTN_ASS_YR><t t-out="employee_data['RTN_ASS_YR']" /></RTN_ASS_YR>
                    <CESSATION_DATE><t t-out="emp_end_date" /></CESSATION_DATE>
                    <StartDateOfEmp><t t-out="emp_start_date" /></StartDateOfEmp>
                    <EndDateOfEmp><t t-out="emp_end_date"/></EndDateOfEmp>
                    <PerOfSalary><t t-out="emp_period_str"/></PerOfSalary>
                    <AmtOfSalary><t t-out="employee_data['AmtOfSalary']"/></AmtOfSalary>
                    <PerOfLeavePay><t t-if="employee_data['AmtOfLeavePay']" t-out="emp_period_str" /></PerOfLeavePay>
                    <AmtOfLeavePay><t t-out="employee_data['AmtOfLeavePay']"/></AmtOfLeavePay>
                    <PerOfDirectorFee><t t-if="employee_data['AmtOfDirectorFee']" t-out="emp_period_str" /></PerOfDirectorFee>
                    <AmtOfDirectorFee><t t-out="employee_data['AmtOfDirectorFee']"/></AmtOfDirectorFee>
                    <PerOfCommFee><t t-if="employee_data['AmtOfCommFee']" t-out="emp_period_str" /></PerOfCommFee>
                    <AmtOfCommFee><t t-out="employee_data['AmtOfCommFee']"/></AmtOfCommFee>
                    <PerOfBonus><t t-if="employee_data['AmtOfBonus']" t-out="emp_period_str" /></PerOfBonus>
                    <AmtOfBonus><t t-out="employee_data['AmtOfBonus']"/></AmtOfBonus>
                    <PerOfBpEtc><t t-if="employee_data['AmtOfBpEtc']" t-out="emp_period_str" /></PerOfBpEtc>
                    <AmtOfBpEtc><t t-out="employee_data['AmtOfBpEtc']"/></AmtOfBpEtc>
                    <PerOfPayRetire><t t-if="employee_data['AmtOfPayRetire']" t-out="emp_period_str" /></PerOfPayRetire>
                    <AmtOfPayRetire><t t-out="employee_data['AmtOfPayRetire']"/></AmtOfPayRetire>
                    <PerOfSalTaxPaid><t t-if="employee_data['AmtOfSalTaxPaid']" t-out="emp_period_str" /></PerOfSalTaxPaid>
                    <AmtOfSalTaxPaid><t t-out="employee_data['AmtOfSalTaxPaid']"/></AmtOfSalTaxPaid>
                    <PerOfEduBen><t t-if="employee_data['AmtOfEduBen']" t-out="emp_period_str" /></PerOfEduBen>
                    <AmtOfEduBen><t t-out="employee_data['AmtOfEduBen']"/></AmtOfEduBen>
                    <PerOfGainShareOption><t t-if="employee_data['AmtOfGainShareOption']" t-out="emp_period_str" /></PerOfGainShareOption>
                    <AmtOfGainShareOption><t t-out="employee_data['AmtOfGainShareOption']"/></AmtOfGainShareOption>
                    <NatureOtherRAP1><t t-if="employee_data['AmtOfOtherRAP1']" t-out="employee_data['NatureOtherRAP1']"/></NatureOtherRAP1>
                    <PerOfOtherRAP1><t t-if="employee_data['AmtOfOtherRAP1']" t-out="emp_period_str" /></PerOfOtherRAP1>
                    <AmtOfOtherRAP1><t t-out="employee_data['AmtOfOtherRAP1']"/></AmtOfOtherRAP1>
                    <NatureOtherRAP2><t t-if="employee_data['AmtOfOtherRAP2']" t-out="employee_data['NatureOtherRAP2']"/></NatureOtherRAP2>
                    <PerOfOtherRAP2><t t-if="employee_data['AmtOfOtherRAP2']" t-out="emp_period_str" /></PerOfOtherRAP2>
                    <AmtOfOtherRAP2><t t-out="employee_data['AmtOfOtherRAP2']"/></AmtOfOtherRAP2>
                    <NatureOtherRAP3><t t-if="employee_data['AmtOfOtherRAP3']" t-out="employee_data['NatureOtherRAP3']"/></NatureOtherRAP3>
                    <PerOfOtherRAP3><t t-if="employee_data['AmtOfOtherRAP3']" t-out="emp_period_str" /></PerOfOtherRAP3>
                    <AmtOfOtherRAP3><t t-out="employee_data['AmtOfOtherRAP3']"/></AmtOfOtherRAP3>
                    <NATURE_PAYMENT_LEFT></NATURE_PAYMENT_LEFT>
                    <OTHER_PAYMENTS_AMT></OTHER_PAYMENTS_AMT>
                    <TotalIncome><t t-out="employee_data['TotalIncome']"/></TotalIncome>
                    <PlaceOfResInd><t t-out="employee_data['PlaceOfResInd']"/></PlaceOfResInd>
                    <AddrOfPlace1><t t-out="employee_data['AddrOfPlace1']"/></AddrOfPlace1>
                    <NatureOfPlace1><t t-out="employee_data['NatureOfPlace1']"/></NatureOfPlace1>
                    <PerOfPlace1><t t-out="employee_data['PerOfPlace1']"/></PerOfPlace1>
                    <RentPaidEr1><t t-out="employee_data['RentPaidEr1']"/></RentPaidEr1>
                    <RentPaidEe1><t t-out="int(employee_data['RentPaidEe1'])"/></RentPaidEe1>
                    <RentRefund1><t t-out="int(employee_data['RentRefund1'])"/></RentRefund1>
                    <RentPaidErByEe1><t t-out="int(employee_data['RentPaidErByEe1'])"/></RentPaidErByEe1>
                    <AddrOfPlace2><t t-out="employee_data['AddrOfPlace2']"/></AddrOfPlace2>
                    <NatureOfPlace2><t t-out="employee_data['NatureOfPlace2']"/></NatureOfPlace2>
                    <PerOfPlace2><t t-out="employee_data['PerOfPlace2']"/></PerOfPlace2>
                    <RentPaidEr2><t t-out="employee_data['RentPaidEr2']"/></RentPaidEr2>
                    <RentPaidEe2><t t-out="employee_data['RentPaidEe2']"/></RentPaidEe2>
                    <RentRefund2><t t-out="employee_data['RentRefund2']"/></RentRefund2>
                    <RentPaidErByEe2><t t-out="employee_data['RentPaidErByEe2']"/></RentPaidErByEe2>
                    <OverseaIncInd><t t-out="1 if employee_data['AmtPaidOverseaCo'] else 0"/></OverseaIncInd>
                    <AmtPaidOverseaCo><t t-out="employee_data['AmtPaidOverseaCo']"/></AmtPaidOverseaCo>
                    <NameOfOverseaCo></NameOfOverseaCo>
                    <AddrOfOverseaCo></AddrOfOverseaCo>
                    <DEPART_DATE><t t-out="employee_data['leave_hk_date'].strftime('%Y%m%d')"/></DEPART_DATE>
                    <ST_BORNE_ER><t t-out="'1' if employee_data['is_salary_tax_borne'] else '0'"/></ST_BORNE_ER>
                    <MONEY_PAYABLE_HELD_ER><t t-out="'1' if employee_data['has_money_payable_held_under_ird'] else '0'"/></MONEY_PAYABLE_HELD_ER>
                    <MONEY_PAYABLE_HELD_ER_AMT><t t-out="int(employee_data['amount_money_payable'])"/></MONEY_PAYABLE_HELD_ER_AMT>
                    <MONEY_PAYABLE_HELD_ER_RES><t t-out="employee_data['reason_no_money_payable']"/></MONEY_PAYABLE_HELD_ER_RES>
                    <RES_DEPART><t t-out="employee_data['reason_departure']"/></RES_DEPART>
                    <RES_DEPART_OTHER><t t-out="employee_data['other_reason_departure']"/></RES_DEPART_OTHER>
                    <RETURN_TO_HK><t t-out="'1' if employee_data['will_return_hk'] else '0'"/></RETURN_TO_HK>
                    <DATE_RETURN_TO_HK><t t-out="employee_data['date_return'] and employee_data['date_return'].strftime('%Y%m%d')"/></DATE_RETURN_TO_HK>
                    <SO_EXE><t t-out="'1' if employee_data['has_non_exercised_stock_options'] else '0'"/></SO_EXE>
                    <NUM_SO_EXE><t t-out="int(employee_data['amount_non_exercised_stock_options'])"/></NUM_SO_EXE>
                    <DATE_GRANT><t t-out="employee_data['date_grant'] and employee_data['date_grant'].strftime('%Y%m%d')"/></DATE_GRANT>
                </Employee>
            </t>
        </IR56G>
    </template>
</odoo>
