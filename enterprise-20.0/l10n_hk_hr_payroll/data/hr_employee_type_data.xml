<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We define specific codes as we use the contract types in a few flows. -->
    <data noupdate="1">
        <record id="l10n_hk_contract_type_regular" model="hr.employee.type">
            <field name="name">Regular</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">REGULAR</field>
        </record>
        <record id="l10n_hk_contract_type_non_continuous" model="hr.employee.type">
            <field name="name">Non-continuous (Non-418/468)</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">NON_CONTINUOUS</field>
        </record>
        <record id="l10n_hk_contract_type_intern" model="hr.employee.type">
            <field name="name">Intern</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">INTERN</field>
        </record>
        <record id="l10n_hk_contract_type_mpf_casual" model="hr.employee.type">
            <field name="name">MPF Casual</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">MPF_CASUAL</field>
        </record>
        <record id="l10n_hk_contract_type_non_employee" model="hr.employee.type">
            <field name="name">Non-employee</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">NON_EMPLOYEE</field>
        </record>
        <record id="l10n_hk_contract_type_contractor" model="hr.employee.type">
            <field name="name">Contractor</field>
            <field name="country_id" ref="base.hk"/>
            <field name="code">CONTRACTOR</field>
        </record>
    </data>
</odoo>
