<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_data_rental_proof_reminder" model="ir.cron">
            <field name="name">HR Rental: Rental Proof Submission Reminder</field>
            <field name="model_id" ref="model_l10n_hk_rental"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(day=10, months=1)).replace(hour=2, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
