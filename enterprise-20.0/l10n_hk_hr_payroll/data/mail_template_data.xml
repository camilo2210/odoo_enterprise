<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_rental_proof_reminder" model="mail.template">
            <field name="name">Payroll: Rental proof Submission Reminder</field>
            <field name="model_id" ref="l10n_hk_hr_payroll.model_l10n_hk_rental"/>
            <field name="subject">{{ object.employee_id.name }}, reminder to submit your rental proof for {{ datetime.date.today().strftime('%B %Y') }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.employee_id.work_contact_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to employees to notify them about missing rental proof</field>
            <field name="body_html" type="html">
    <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0px auto;"><tbody>
        <tr><td valign="top" style="text-align: left; font-size: 14px;">
            Dear <t t-out="object.employee_id.name"></t>, this is a friendly reminder to submit your rental proof for <t t-out="datetime.date.today().strftime('%B %Y')"></t>.<br/><br/>
            Please note that late submissions may be rejected.<br/><br/>
            Have a nice day,<br/>
            The HR Team
        </td></tr>
    </tbody></table>
                </field>
                <field name="lang">{{ object.employee_id.lang }}</field>
                <field name="auto_delete" eval="True"/>
          </record>
    </data>
</odoo>
