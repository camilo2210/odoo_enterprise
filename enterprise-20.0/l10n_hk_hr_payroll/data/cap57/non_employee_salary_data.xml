    <record id="cap57_non_employees_salary_gross" model="hr.salary.rule">
        <field name="category_ids" eval="[(5, 0, 0)]"/>
        <field name="name">Taxable Salary</field>
        <field name="sequence">202</field>
        <field name="code">GROSS</field>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="appears_on_payslip">non_zero</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['FEE']
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_hk_hr_payroll.hr_payroll_structure_cap57_non_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="cap57_non_employees_salary_withheld" model="hr.salary.rule">
        <field name="category_ids" eval="[Command.set([ref('l10n_hk_hr_payroll.WITHHELD_DED')])]"/>
        <field name="name">Amount Withheld</field>
        <field name="code">WITHHELD</field>
        <field name="sequence">205</field>
        <field name="condition_select">property_input</field>
        <field name="input_usage_payslip" eval="True"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -(inputs['WITHHELD'].amount if 'WITHHELD' in inputs else 0.0)
        </field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="input_section" ref="hr_payroll.default_salary_rule_section"/>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_hk_hr_payroll.hr_payroll_structure_cap57_non_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="cap57_non_employees_salary_net" model="hr.salary.rule">
        <field name="category_ids" eval="[Command.set([ref('hr_payroll.NET')])]"/>
        <field name="name">Net</field>
        <field name="sequence">210</field>
        <field name="code">NET</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# The amount actually paid out to the non-employee: FEE and ALW are their income,
# NON_TAXABLE the reimbursements and expenses which are paid out but are not
# income, and DED the deductions and the amount withheld.
result = categories['NON_TAXABLE'] + categories['FEE'] + categories['ALW'] + categories['DED']
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_hk_hr_payroll.hr_payroll_structure_cap57_non_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.hk"/>
    </record>
