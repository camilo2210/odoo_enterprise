<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_cap57_employee_salary" model="hr.payroll.structure">
        <field name="name">CAP57: Employees Monthly Pay</field>
        <field name="code">CAP57MONTHLY</field>
        <field name="rule_ids" eval="[]"/>
        <field name="country_id" ref="base.hk" />
        <field name="type_id" ref="l10n_hk_hr_payroll.structure_type_employee_cap57" />
        <field name="report_id" ref="l10n_hk_hr_payroll.action_report_payslip_hk"/>
    </record>

    <record id="hr_payroll_structure_cap57_casual_employee_salary" model="hr.payroll.structure">
        <field name="name">CAP57: Casual Employees Pay</field>
        <field name="code">CAP57CASUAL</field>
        <field name="rule_ids" eval="[]"/>
        <field name="country_id" ref="base.hk" />
        <field name="type_id" ref="l10n_hk_hr_payroll.structure_type_casual_employee_cap57" />
        <field name="report_id" ref="l10n_hk_hr_payroll.action_report_payslip_hk"/>
    </record>

    <record id="l10n_hk_hr_payroll.structure_type_employee_cap57" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="hr_payroll_structure_cap57_employee_salary" />
        <field name="default_work_entry_type_id" ref="hr_work_entry.hk_work_entry_type_attendance"/>
    </record>

    <record id="l10n_hk_hr_payroll.structure_type_casual_employee_cap57" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="hr_payroll_structure_cap57_casual_employee_salary" />
        <field name="default_work_entry_type_id" ref="hr_work_entry.hk_work_entry_type_attendance"/>
    </record>

    <record id="hr_payroll_structure_cap57_non_employee_salary" model="hr.payroll.structure">
        <field name="name">CAP57: Non-employees Pay</field>
        <field name="code">CAP57NONEMPLOYEE</field>
        <field name="rule_ids" eval="[]"/>
        <field name="country_id" ref="base.hk" />
        <field name="type_id" ref="l10n_hk_hr_payroll.structure_type_non_employee_cap57" />
        <field name="report_id" ref="l10n_hk_hr_payroll.action_report_payslip_hk"/>
        <field name="use_worked_day_lines" eval="False"/>
    </record>

    <record id="l10n_hk_hr_payroll.structure_type_non_employee_cap57" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="hr_payroll_structure_cap57_non_employee_salary" />
    </record>
</odoo>
