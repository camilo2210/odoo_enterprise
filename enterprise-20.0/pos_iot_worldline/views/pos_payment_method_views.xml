<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_method_pos_iot_worldline_user_form" model="ir.ui.view">
        <field name="name">pos.payment.method.iot.form.inherit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'worldline'">
                    <page name="settings" string="Worldline">
                        <group>
                            <field name="iot_device_id" domain="[('type', '=', 'payment')]"
                            invisible="payment_provider != 'worldline'"
                            required="payment_provider == 'worldline'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
