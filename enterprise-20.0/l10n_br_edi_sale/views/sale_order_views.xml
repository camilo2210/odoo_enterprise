<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="l10n_br_avatax_sale.order_form_inherit"/>
        <field name="arch" type="xml">
            <group name="sale_info" position="inside">
                <field name="l10n_br_edi_payment_method"
                        options="{'no_create': True, 'no_open': True}"
                        required="True"
                        invisible="country_code != 'BR'"/>
                <field name="l10n_br_presence" invisible="country_code != 'BR'"/>
                <field name="l10n_br_edi_freight_model" invisible="country_code != 'BR' or l10n_br_is_service_transaction"/>
                <field name="l10n_br_edi_transporter_id"
                           invisible="country_code != 'BR' or l10n_br_edi_freight_model in ('SenderVehicle', 'ReceiverVehicle') or l10n_br_is_service_transaction"/>
            </group>
            <xpath expr="//list/field[@name='tax_ids']" position="after">
                    <field name="l10n_br_tax_details" column_invisible="not parent.l10n_br_edi_avatax_data" optional="hide"/>
            </xpath>
            <field name="l10n_br_goods_operation_type_id" position="attributes">
                <attribute name="invisible" separator="or" remove="l10n_br_is_service_transaction"/>
                <!-- After the reform it's not only for goods. -->
                <attribute name="string">Operation Type</attribute>
                <attribute name="help">Brazil: This is the operation type related to the transaction. It will identify how taxes will be computed.</attribute>
            </field>
        </field>
    </record>

</odoo>
