<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_post_template_view_form" model="ir.ui.view">
        <field name="name">social.post.template.view.form.inherit.facebook</field>
        <field name="model">social.post.template</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="social.social_post_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_social_post_preview_container')]" position="inside">
                <field name="has_facebook_account" invisible="1"/>
                <field name="display_facebook_preview" invisible="1" />
                <field name="facebook_preview" nolabel="1" colspan="2"
                    widget="social_post_preview"
                    media_type="facebook_preview"
                    readonly="1"
                    invisible="not display_facebook_preview"
                    class="o_social_preview_wrapper m-0 px-4 py-4 bg-200"/>
            </xpath>
            <xpath expr="//notebook[@name='media_customization']" position="inside">
                <page string="Facebook" name="facebook_content"
                    invisible="not has_facebook_account">
                    <group>
                        <group>
                            <field name="facebook_post_as_story" string="Post as Story"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_facebook_label_message" colspan="2"
                                invisible="facebook_post_as_story">Message</div>
                            <field name="facebook_message"
                                invisible="facebook_post_as_story"
                                required="is_split_per_media and has_facebook_account and (not facebook_image_ids or facebook_post_as_story)"
                                nolabel="1" colspan="2" widget="social_post_message_facebook_field"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_facebook_label_media" colspan="2">Media</div>
                            <field name="facebook_image_ids"
                                class="o_social_post_image"
                                required="is_split_per_media and has_facebook_account and (not facebook_image_ids or facebook_post_as_story)"
                                mode="kanban"
                                add-label="Add Media"
                                colspan="2"
                                nolabel="1"
                                widget="x2_many_media_viewer"
                                options="{'force_create': True, 'set_attachment_id': True, 'only_image': True}"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_facebook_label_first_comment" colspan="2"
                                invisible="facebook_post_as_story">Scheduled first comment</div>
                            <field name="facebook_first_comment" colspan="2" nolabel="1" invisible="facebook_post_as_story" placeholder="Comment your own post to get the conversation going or share some extra content."/>
                        </group>
                        <group invisible="not display_facebook_preview" class="o_social_post_preview_group">
                            <field name="facebook_preview" nolabel="1"
                                widget="social_post_preview"
                                media_type="facebook_preview"
                                readonly="1"
                                class="o_social_preview_wrapper m-0 px-4 py-4 bg-200 h-100"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</data>
</odoo>
