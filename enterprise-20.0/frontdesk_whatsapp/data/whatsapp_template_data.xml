<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="frontdesk_whatsapp_template" model="whatsapp.template" forcecreate="0">
        <field name="name">Frontdesk WhatsApp Template</field>
        <field name="template_name">frontdesk_visitor_arrival</field>
        <field name="lang_code">en</field>
        <field name="template_type">utility</field>
        <field name="status">approved</field>
        <field name="model_id" ref="frontdesk.model_frontdesk_visitor"/>
        <field name="body">Hello, Your visitor {{1}} ({{2}}) wants to meet you at {{3}}. Please let them know you'll be there shortly.</field>
        <field name="variable_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'name': '{{1}}',
                'demo_value': 'Mitchell Admin',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'name'
            }),
            (0, 0, {
                'name': '{{2}}',
                'demo_value': '+32456000000',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'phone'
            }),
            (0, 0, {
                'name': '{{3}}',
                'demo_value': 'Reception',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'station_id.name'
            })
        ]"/>
    </record>
</odoo>
