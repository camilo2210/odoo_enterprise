<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_asset_view_form_inherit_l10n_ph" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.l10n.ph</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='asset_values']" position="inside">
                <field name="l10n_ph_fixed_asset_code" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
