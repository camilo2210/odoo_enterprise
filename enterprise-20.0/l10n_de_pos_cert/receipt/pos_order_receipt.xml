<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_de_pos_cert.pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer">
            <div name="footer" position="before">
                <t t-if="conditions.get('code_de')">
                    <div t-if="conditions.get('l10n_de_test_env')">
                        This is a TEST receipt. Go to your company settings to be in a production environment.
                    </div>
                    <div t-elif="conditions.get('l10n_de_error')">
                        TSS not reachable.
                    </div>
                    <table class="tss-info w-100 mt-2 text-small text-break" t-else="">
                        <tbody>
                            <tr t-foreach="extra_data.get('tss')" t-as="tss">
                                <td class="w-50 text-start" t-out="tss['name']"/>
                                <td class="w-50 text-end" t-out="tss['value']"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </template>
    </data>
</odoo>
