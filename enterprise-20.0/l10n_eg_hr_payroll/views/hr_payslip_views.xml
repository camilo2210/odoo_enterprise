<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.actions.server" id="action_hr_payroll_tax_adjustment">
        <field name="name">End of year Tax Adjustment (EG)</field>
        <field name="sequence" eval="50"/>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_eg_tax_adjustment_wizard()
        </field>
    </record>
</odoo>
