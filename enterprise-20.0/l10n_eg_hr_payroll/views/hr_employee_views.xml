<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group string="Allowances" invisible="country_code != 'EG'">
                    <label for="l10n_eg_housing_allowance" string="Housing Allowance"/>
                    <div class="o_row" name="l10n_eg_housing_allowance" >
                        <field name="l10n_eg_housing_allowance" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                    <label for="l10n_eg_transportation_allowance" string="Transportation Allowance"/>
                    <div class="o_row" name="l10n_eg_transportation_allowance">
                        <field name="l10n_eg_transportation_allowance" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                    <label for="l10n_eg_other_allowances" string="Other Allowances"/>
                    <div class="o_row" name="l10n_eg_other_allowances">
                        <field name="l10n_eg_other_allowances" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                </group>

                <group string="Annual Leave Provision" invisible="country_code != 'EG'">
                    <label for="l10n_eg_total_leave_days" string="Eligibility"/>
                    <div class="o_row" name="l10n_eg_total_leave_days">
                        <field name="l10n_eg_total_leave_days" class="o_hr_narrow_field"/>
                        <span>Days / Year</span>
                    </div>
                </group>

                <group string="Social Insurance" invisible="country_code != 'EG'">
                    <label for="l10n_eg_social_insurance_reference" string="Reference Amount"/>
                    <div class="o_row" name="l10n_eg_total_leave_days">
                        <field name="l10n_eg_social_insurance_reference" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                </group>

                <group string="End of Service" invisible="country_code != 'EG'">
                    <field name="l10n_eg_eligible_for_eos"/>
                </group>
            </group>
            <field name="identification_id" position="after">
                <field name="l10n_eg_ssn" invisible="country_code != 'EG'"/>
                <label for="l10n_eg_nosi_registration_start_date" string="NOSI Registration Start Date" invisible="country_code != 'EG'"/>
                <div class="o_row" name="l10n_eg_nosi_registration_start_date" invisible="country_code != 'EG'">
                    <field name="l10n_eg_nosi_registration_start_date" class="o_hr_narrow_field"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
