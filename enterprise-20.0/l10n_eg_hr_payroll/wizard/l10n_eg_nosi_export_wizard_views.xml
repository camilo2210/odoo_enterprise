<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="l10n_eg_nosi_export_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.eg.nosi.export.wizard.view.form</field>
        <field name="model">l10n.eg.nosi.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Egypt NOSI Forms Export">
                <sheet>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="employee_ids" widget="many2many_avatar_employee" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generate" type="object" class="btn-primary" invisible="not employee_ids"/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <menuitem
        id="hr.hr_menu_l10n_eg"
        name="Egypt"
        parent="hr.hr_menu_hr_reports"
        sequence="99"/>
</odoo>
