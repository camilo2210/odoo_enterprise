<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_sa_hr_accrual_plan_paid_time_off" model="hr.leave.accrual.plan">
            <field name="name">Saudi Employee Plan</field>
            <field name="can_be_carryover" eval="False"/>
            <field name="accrued_gain_time">end</field>
            <field name="is_based_on_worked_time" eval="False"/>
            <field name="work_entry_type_id" ref="hr_work_entry.sa_work_entry_type_legal_leave"/>
        </record>

        <record id="l10n_sa_hr_accrual_plan_paid_time_off_level_1" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="l10n_sa_hr_accrual_plan_paid_time_off" />
            <field name="milestone_date">creation</field>
            <field name="start_type">day</field>
            <field name="added_value">1.75</field>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="first_day">1</field>
            <field name="cap_accrued_time" eval="True"/>
            <field name="action_with_unused_accruals">all</field>
            <field name="maximum_leave">21</field>
        </record>
    </data>
</odoo>
