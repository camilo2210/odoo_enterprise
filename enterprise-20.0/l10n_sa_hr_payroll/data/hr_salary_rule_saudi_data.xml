        <record id="ksa_saudi_overtime" model="hr.salary.rule">
            <field name="name">Overtime</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
            <field name="code">OT</field>
            <field name="sequence">40</field>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = any(work_day.work_entry_type_id.is_extra_hours for _code, work_day in worked_days.items()) 
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
compensation = categories['BASIC'] + categories['SA_ALW']
daily_wage = compensation / total_number_of_days

result = 0
for code, work_day in worked_days.items():
    if work_day.work_entry_type_id.is_extra_hours:
        result += daily_wage * work_day.number_of_days * work_day.work_entry_type_id.amount_rate
