        <record id="ksa_saudi_end_of_service_provision_salary_rule" model="hr.salary.rule">
            <field name="name">End of Service Provision</field>
            <field name="category_ids" eval="[(6, 0, [ref('l10n_sa_hr_payroll.l10n_sa_category_provision')])]"/>
            <field name="code">EOSP</field>
            <field name="appears_on_payslip">non_zero</field>
            <field name="sequence">45</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
paid_days = total_number_of_days
if any(line.work_entry_type_id.amount_rate == 0 for code, line in worked_days.items()):
    paid_days -= unpaid_days
if total_number_of_days:
    total_years = employee._l10n_sa_get_number_of_years(employee._get_first_version_date(), payslip.date_to)
    provision_month = (categories['BASIC'] + categories['SA_ALW']) / 12
    if total_years &lt;= 5:
        provision_month = provision_month / 2
    result = (provision_month / total_number_of_days) * paid_days
    result = payslip.company_id.currency_id.round(result)
else:
    result = 0
            </field>
