        <record id="l10n_sa_hr_payroll_ksa_saudi_employee_payroll_structure_deferred_amount_salary_rule" model="hr.salary.rule">
            <field name="name">Deferred Amount</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
            <field name="code">DEFERREDAMOUNT</field>
            <field name="sequence">230</field>
            <field name="appears_on_payslip">non_zero</field>
            <field name="condition_select">python</field>
            <field name="condition_python">
previous_payslips = payslip.env['hr.payslip'].search([
    ('employee_id', '=', employee.id),
    ('date_to', '&lt;', payslip.date_from),
    ('state', 'in', ['validated', 'paid']),
    ('company_id', '=', payslip.company_id.id),
]).sorted('date_from')
result = previous_payslips[-1]._get_line_values(['AMOUNTTODEFER'])['AMOUNTTODEFER'][previous_payslips[-1].id]['total'] if previous_payslips else False
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
net_salary = categories['BASIC'] + categories['ALW'] + categories['DED']
previous_payslips = payslip.env['hr.payslip'].search([
    ('employee_id', '=', employee.id),
    ('date_to', '&lt;', payslip.date_from),
    ('state', 'in', ['validated', 'paid']),
    ('company_id', '=', payslip.company_id.id),
]).sorted('date_from')

result = 0
if previous_payslips:
    deferred_amount = previous_payslips[-1]._get_line_values(['AMOUNTTODEFER'])['AMOUNTTODEFER'][previous_payslips[-1].id]['total']
    if deferred_amount &gt;= 0 or net_salary &gt;= abs(deferred_amount):
        result = deferred_amount
    else:
        result = -max(0 , net_salary)
        amount_to_defer += deferred_amount - result
            </field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_sa_hr_payroll.ksa_saudi_employee_payroll_structure'),
            ])]"/>
            <field name="country_id" ref="base.sa"/>
        </record>
