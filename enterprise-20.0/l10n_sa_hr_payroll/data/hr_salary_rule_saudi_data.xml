            <field name="amount_python_compute">
unpaid_days = sum(line.number_of_days for code, line in worked_days.items() if line.work_entry_type_id.amount_rate == 0)
daily_salary = (payslip._get_contract_wage() + categories['SA_ALW']) / total_number_of_days

if version.schedule_pay == '30_monthly':
    month_days = (payslip.date_to - payslip.date_from).days + 1
    if unpaid_days == month_days:
        if unpaid_days == 31:
            amount_to_defer = -daily_salary
        unpaid_days = 30
    elif unpaid_days == 30 and month_days == 31:
        amount_to_defer = daily_salary

result_qty = unpaid_days
result = -daily_salary
