        <record id="ksa_saudi_unpaid_days" model="hr.salary.rule">
            <field name="name">Unpaid Days</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.DED')])]"/>
            <field name="code">UNPAID</field>
            <field name="sequence">10</field>
