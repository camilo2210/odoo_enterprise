<?xml version="1.0"?>
<odoo>
    <record id="hr_leave_advance_pay_view_form" model="ir.ui.view">
        <field name="name">hr.leave.advance.pay.form</field>
        <field name="model">hr.leave.advance.pay</field>
        <field name="arch" type="xml">
            <form string="Advance Leave Pay">
                <group>
                    <field name="struct_id"/>
                </group>
                <footer>
                    <button name="action_populate_payslip" string="Confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
