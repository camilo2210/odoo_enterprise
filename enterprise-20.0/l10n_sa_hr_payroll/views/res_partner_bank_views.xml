<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_bank_form_inherit_hr" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.hr</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="hr.view_partner_bank_form_inherit_hr"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="l10n_sa_bank_establishment_code" invisible="country_code != 'SA'" placeholder="eg. 0123456789"/>
            </field>
        </field>
    </record>

</odoo>
