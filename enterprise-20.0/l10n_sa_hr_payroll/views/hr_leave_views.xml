<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form" model="ir.ui.view">
        <field name="name">hr.leave.view.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <button name="action_cancel" position="after">
                <button name="action_create_sa_leave_advance_pay"
                    string="Create Leave Advance Pay"
                    type="object"
                    invisible="state != 'validate' or company_country_code != 'SA'"
                    groups="hr_holidays.group_hr_holidays_user,hr_payroll.group_hr_payroll_user"
                    />
            </button>
            <field name="dashboard_warning_message" position="after">
                <field name="l10n_sa_work_entry_type_change_warning" class="alert alert-warning d-flex mt-2" role="alert" style="white-space: preserve-breaks;" invisible="not l10n_sa_work_entry_type_change_warning or state != 'confirm'"/>
            </field>
        </field>
    </record>
</odoo>
