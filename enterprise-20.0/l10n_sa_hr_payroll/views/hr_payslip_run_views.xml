<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payrun_payslip_kanban_card_view" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.kanban</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payrun_payslip_kanban_card_view"/>
        <field name="arch" type="xml">
            <templates position="before">
                <field name="l10n_sa_wps_file_reference" string="Reference" invisible="1" />
            </templates>
            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='total_employer_cost']]" position="after">
                <div class="d-flex flex-column align-items-start" invisible="country_code != 'SA'">
                    <div class="o_payrun_metric_label small text-muted">
                        <span>Total Cost</span>
                    </div>
                    <div class="o_payrun_metric_value">
                        <field name="l10n_sa_total_net_cost" widget="payrun_kpi"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='total_employer_cost']]" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'SA'"/>
            </xpath>
            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='net_sum']]" position="after">
                <div class="d-flex flex-column align-items-start" invisible="country_code != 'SA'">
                    <div class="o_payrun_metric_label small text-muted">
                        <span>Total GOSI Contribution</span>
                    </div>
                    <div class="o_payrun_metric_value">
                        <field name="l10n_sa_total_gosi_contribution" widget="payrun_kpi"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
