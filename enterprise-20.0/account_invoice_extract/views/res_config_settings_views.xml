<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.invoice.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="msg_invoice_extract" position="replace"/>

            <div id="account_ocr_settings_moves" position="inside">
                <setting invisible="not module_account_invoice_extract" class="order-2">
                    <field name="extract_in_invoice_digitalization_mode" class="text-nowrap o_light_label" widget="radio" required="True"/>
                </setting>
                <setting invisible="not module_account_invoice_extract" class="order-1">
                    <field name="extract_out_invoice_digitalization_mode" class="text-nowrap o_light_label" widget="radio" required="True"/>
                </setting>
            </div>

            <block id="account_digitalization" position="inside">
                <group id="account_ocr_settings_line_per_tax">
                    <setting invisible="not module_account_invoice_extract" company_dependent="1" help="Enable to get only one invoice line per tax">
                        <field name="extract_single_line_per_tax"/>
                    </setting>
                </group>
            </block>
        </field>
    </record>
</odoo>
