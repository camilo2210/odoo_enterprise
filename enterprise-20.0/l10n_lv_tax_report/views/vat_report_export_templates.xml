                </R>
            </PVN1I>
            <PVN1II>
                <R t-foreach="PVN1II_transactions" t-as="R">
                    <DpValsts t-out="R['partner_vat_country_code']"/>
                    <DpNumurs t-out="R['partner_vat_without_country_code']"/>
