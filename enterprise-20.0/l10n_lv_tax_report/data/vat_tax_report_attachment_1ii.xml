<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <record id="l10n_lv_vat_main_tax_report_attachment_1ii" model="account.report">
        <!-- VAT 1-II: Tax amounts for goods and services received from European Union member states -->
        <field name="name">Attachment 1-II</field>
        <field name="name@lv">Pielikums 1-II</field>
        <field name="sequence">3</field>
        <field name="country_id" ref="base.lv"/>
        <field name="availability_condition">country</field>
        <field name="custom_handler_model_id" ref="model_l10n_lv_tax_report_handler"/>
        <field name="column_ids">
            <record id="vat_report_1ii_partner_vat" model="account.report.column">
                <field name="name">Partner VAT</field>
                <field name="name@lv">Partneris PVN</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1ii_partner_name" model="account.report.column">
                <field name="name">Partner Name</field>
                <field name="name@lv">Partnera nosaukums</field>
                <field name="expression_label">partner_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1ii_transaction_type" model="account.report.column">
                <field name="name">Transaction Type</field>
                <field name="name@lv">Darījuma veids</field>
                <field name="expression_label">transaction_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1ii_base_amount" model="account.report.column">
                <field name="name">Base Amount</field>
                <field name="name@lv">Pamatsumma</field>
                <field name="expression_label">base_amount</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_1ii_vat_amount" model="account.report.column">
                <field name="name">VAT Amount</field>
                <field name="name@lv">PVN summa</field>
                <field name="expression_label">vat_amount</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_1ii_base_amount_currency" model="account.report.column">
                <field name="name">Base Amount Currency</field>
                <field name="name@lv">Pamatsumma valūta</field>
                <field name="expression_label">base_amount_currency</field>
                <field name="figure_type">float</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_1ii_base_amount_currency_code" model="account.report.column">
                <field name="name">Base Amount Currency Code</field>
                <field name="name@lv">Pamatsumma valūtas kods</field>
                <field name="expression_label">base_amount_currency_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1ii_document_number" model="account.report.column">
                <field name="name">Doc. Number</field>
                <field name="name@lv">Dok. numurs</field>
                <field name="expression_label">document_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1ii_document_date" model="account.report.column">
                <field name="name">Doc. Date</field>
                <field name="name@lv">Dok. datums</field>
                <field name="expression_label">document_date</field>
                <field name="figure_type">date</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line" model="account.report.line">
                <field name="name"></field>
                <field name="name@lv"></field>
                <field name="groupby">transaction</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_partner_vat" model="account.report.expression">
                        <field name="label">partner_vat</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">partner_vat</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_partner_name" model="account.report.expression">
                        <field name="label">partner_name</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">partner_name</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_transaction_type" model="account.report.expression">
                        <field name="label">transaction_type</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">transaction_type</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_base_amount" model="account.report.expression">
                        <field name="label">base_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">base_amount</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_vat_amount" model="account.report.expression">
                        <field name="label">vat_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">vat_amount</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_base_amount_currency" model="account.report.expression">
                        <field name="label">base_amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">base_amount_currency</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_base_amount_currency_code" model="account.report.expression">
                        <field name="label">base_amount_currency_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">base_amount_currency_code</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_document_number" model="account.report.expression">
                        <field name="label">document_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">document_number</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1ii_line_document_date" model="account.report.expression">
                        <field name="label">document_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1ii</field>
                        <field name="subformula">document_date</field>
                        <field name="auditable" eval="False"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
