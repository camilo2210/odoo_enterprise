<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_view_form_mcp" model="ir.ui.view">
        <field name="name">ir.actions.server.form.mcp</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="ai.ir_actions_server_view_form"/>
        <field name="arch" type="xml">
            <!-- add into the ai group so labels share the column with `use_in_ai` -->
            <xpath expr="//group[@name='use_in_ai']" position="inside">
                <label for="use_in_mcp" invisible="not use_in_ai"/>
                <div invisible="not use_in_ai">
                    <field name="use_in_mcp"/>
                    <label for="is_readonly" invisible="not use_in_mcp" class="mx-2"/>
                    <field name="is_readonly" invisible="not use_in_mcp"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="ir_actions_server_view_list_mcp" model="ir.ui.view">
        <field name="name">ir.actions.server.list.mcp</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_tree"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="use_in_mcp"/>
                <field name="is_readonly" invisible="not use_in_mcp"/>
            </field>
        </field>
    </record>
</odoo>
