<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_task" inherit_id="project.portal_my_task">
        <xpath expr="//div[@t-if='task.date_deadline']" position="replace">
            <div t-if="task.planned_date_begin" class="text-nowrap">
                <strong>Planned Date:</strong>
                <t t-call="project.portal_format_date" date_record="task.planned_date_begin"/>,
                <span t-field="task.planned_date_begin" t-options='{"widget": "datetime", "time_only": True, "format": "short"}'/>
                <i class="oi" data-icon="east"/>
                <t t-call="project.portal_format_date" date_record="task.date_deadline"/>,
                <span t-field="task.date_deadline" t-options='{"widget": "datetime", "time_only": True, "format": "short"}'/>
            </div>
            <div t-elif="task.date_deadline">
                <strong>Deadline:</strong>
                <t t-call="project.portal_format_date" date_record="task.date_deadline"/>,
                <span t-field="task.date_deadline" t-options='{"widget": "datetime", "time_only": True, "format": "short"}'/>
            </div>
        </xpath>
    </template>

</odoo>
