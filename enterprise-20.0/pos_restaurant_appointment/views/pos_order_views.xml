<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_pos_restaurant_appointment" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.pos.restaurant.appointment</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_calendar_event" icon="calendar_today" icon_class="oi-filled" invisible="not calendar_event_count">
                    <field string="Meetings" name="calendar_event_count" widget="statinfo"/>
                </button>
           </xpath>
        </field>
    </record>
</odoo>
