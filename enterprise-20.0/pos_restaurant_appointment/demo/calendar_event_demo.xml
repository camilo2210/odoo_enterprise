<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="calendar_event_table_1" model="calendar.event">
        <field name="appointment_booker_id" ref="pos_restaurant.customer_1"/>
        <field name="appointment_status">booked</field>
        <field name="appointment_type_id" ref="appointment_type_restaurant_table"/>
        <field name="booking_line_ids" eval="[(0, 0, {
            'appointment_resource_id': ref('pos_restaurant_appointment.appointment_type_restaurant_table_table_09'),
            'capacity_reserved': 6,
        })]"/>
        <field name="duration" eval="2"/>
        <field name="name">John Doe - Table Booking</field>
        <field name="partner_ids" eval="[(6, 0, [ref('pos_restaurant.customer_1')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:00:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 20:00:00')"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

    <record id="calendar_event_table_2" model="calendar.event">
        <field name="appointment_status">booked</field>
        <field name="appointment_type_id" ref="appointment_type_restaurant_table"/>
        <field name="booking_line_ids" eval="[(0, 0, {
            'appointment_resource_id': ref('pos_restaurant_appointment.appointment_type_restaurant_table_table_08'),
            'capacity_reserved': 4,
        })]"/>
        <field name="duration" eval="2"/>
        <field name="name">Ethan Carter</field>
        <field name="partner_ids" eval="[(5, 0, 0)]"/>
        <field name="notes" type="html"><div>Allergic to diary products</div></field>
        <field name="start" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 20:00:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 22:00:00')"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

    <record id="calendar_event_table_3" model="calendar.event">
        <field name="appointment_status">booked</field>
        <field name="appointment_type_id" ref="appointment_type_restaurant_table"/>
        <field name="booking_line_ids" eval="[
            (0, 0, {
                'appointment_resource_id': ref('pos_restaurant_appointment.appointment_type_restaurant_table_table_06'),
                'capacity_reserved': 4,
            }),
            (0, 0, {
                'appointment_resource_id': ref('pos_restaurant_appointment.appointment_type_restaurant_table_table_07'),
                'capacity_reserved': 3,
            })
        ]"/>
        <field name="duration" eval="2"/>
        <field name="name">Audrey Peterson</field>
        <field name="partner_ids" eval="[(5, 0, 0)]"/>
        <field name="notes" type="html"><div>VIP</div></field>
        <field name="start" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 17:45:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 19:45:00')"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

</odoo>
