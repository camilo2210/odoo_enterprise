<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.DocumentsTopbarShareButton" class="d-flex align-items-center">
        <i t-if="this.env.isSharedExternally?.()"
            class="oi oi-lg text-warning px-2" data-icon="public"
            data-tooltip="Shared externally">
        </i>
        <div class="d-flex align-items-center  o-hoverable-button rounded o_topbar_share_icon" t-on-click="() => this.env.onShareSpreadsheet()">
            <t t-call="o-spreadsheet-Icon.SHARE"/>
            <span class="px-1">Share</span>
        </div>
    </div>
</templates>
