<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_website.AiGeneratedScriptsPanel">
    <div class="o_we_ai_gen_scripts_panel d-contents" t-if="this.props.scripts.length">
        <div class="o_panel_header">
            AI-generated scripts
        </div>
        <t t-foreach="this.props.scripts" t-as="script" t-key="script_index">
            <div class="o_script_entry d-flex py-1 align-items-center justify-content-between">
                <div class="o_title" t-out="this.getScriptTitle(script.el)"/>
                <div class="ms-2">
                    <t t-if="!script.isStopped">
                        <button class="btn" t-on-click="() => this.stopScript(script.el)">
                            <i class='oi o_text_orange' data-icon='pause'/>
                        </button>
                    </t>
                    <t t-else="">
                        <button class="btn" t-on-click="() => this.runScript(script.el)">
                            <i class="oi text-success" data-icon="play_arrow"/>
                        </button>
                    </t>
                    <button class="btn" t-on-click="() => this.removeScript(script.el)">
                        <i class="oi oi-filled text-danger" data-icon="delete"/>
                    </button>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
