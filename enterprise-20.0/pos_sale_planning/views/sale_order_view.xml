<?xml version="1.0"?>
<odoo>

    <record id="view_order_form_inherit_pos_sale_planning" model="ir.ui.view">
        <field name="name">sale.order.form.pos.sale.planning</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_view_invoice" position="before">
                <button
                    name="action_view_pos_order_resource"
                    type="object"
                    class="oe_stat_button"
                    icon="shopping_bag"
                    invisible="pos_order_resource_count == 0"
                    groups="point_of_sale.group_pos_user"
                >
                    <field name="pos_order_resource_count" widget="statinfo" string="PoS Orders"/>
                </button>
            </button>

            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/column[@name='product_and_description']" position="after">
                <field name="resource_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
