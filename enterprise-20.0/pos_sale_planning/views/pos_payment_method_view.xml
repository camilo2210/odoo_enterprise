<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.sale.planning</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="before">
                <field name="resource_ids" widget="many2many_tags" placeholder="All resources" options="{'no_create': True}" invisible="type != 'resource'"/>
            </field>
            <field name="payment_method_type" position="attributes">
                <attribute name="invisible" add="type == 'resource'" separator=" or "/>
            </field>
            <field name="qr_code_method" position="attributes">
                <attribute name="invisible" add="type == 'resource'" separator=" or "/>
            </field>
            <field name="journal_id" position="attributes">
                <attribute name="invisible" add="type == 'resource'" separator=" or "/>
            </field>
            <field name="receivable_account_id" position="attributes">
                <attribute name="invisible" add="type == 'resource'" separator=" or "/>
            </field>
        </field>
    </record>
</odoo>
