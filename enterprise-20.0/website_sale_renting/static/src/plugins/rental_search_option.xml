<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_sale_renting.RentalSearchOption">
    <BuilderRow label.translate="Timing">
        <BuilderSelect action="'setRentalSearchTiming'" preview="false">
            <BuilderSelectItem actionParam="'days'">Day</BuilderSelectItem>
            <BuilderSelectItem actionParam="'hours'">Hour</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Attribute Filter">
        <BuilderMany2One action="'setRentalSearchProductAttribute'" model="'product.attribute'"/>
    </BuilderRow>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <rental_search_option
            template="website_sale_renting.RentalSearchOption"
            selector=".s_rental_search"/>
    </xpath>
</t>

</templates>
