<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="website_sale_renting.delivery_method" inherit_id="website_sale.delivery_method">
        <t t-set="available_delivery_days" position="after">
            <t
                t-if="order.is_rental_order"
                t-set="available_delivery_days"
                t-value="[order.rental_start_date]"
            />
        </t>
    </template>

</odoo>
