<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="exceptional_ribbon" model="product.ribbon">
        <field name="name">Exceptional Value</field>
        <field name="style">tag</field>
        <field name="text_color">#FFFFFF</field>
        <field name="bg_color">#BB992A</field>
    </record>

    <record id="sale_renting.luxury_room" model="product.product">
        <field name="is_published">True</field>
        <field name="website_ribbon_id" ref="exceptional_ribbon"/>
    </record>

    <record id="sale_renting.spa_access" model="product.product">
        <field name="is_published">True</field>
    </record>

    <record id="sale_renting.premium_bike" model="product.product">
        <field name="is_published">True</field>
    </record>

    <record id="sale_renting.projector" model="product.product">
        <field name="is_published">True</field>
    </record>

    <record id="sale_renting.printer" model="product.product">
        <field name="is_published">True</field>
    </record>

    <record id="luxury_room_5_days_discount" model="product.pricelist.item">
        <field name="pricelist_id" ref="website_sale.list_default"/>
        <field name="product_id" ref="sale_renting.luxury_room"/>
        <field name="min_quantity">5</field>
        <field name="fixed_price">200.00</field>
    </record>

</odoo>
