<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="frontdesk.WelcomePage">
        <div
            class="position-relative d-flex flex-column justify-content-lg-center w-100 vh-100 o_main_bg_img"
            t-att-style="'background-image: url(/frontdesk/' + this.props.stationInfo.id + '/background), url(/frontdesk/static/img/frontdesk.svg'"
        >
            <div
                class="position-relative d-flex flex-column align-items-center justify-content-around vh-100"
                t-att-class="this.props.stationInfo.has_image ? 'bg-white-75' : ''"
            >
                <div class="d-flex gap-2 flex-column flex-lg-row align-items-lg-start w-100 pt-2 px-2 pt-lg-0 px-lg-4">
                    <div class="h3 flex-basis-50 fw-light" t-out="this.state.today"/>
                    <h1 class="mb-3 mb-lg-0 fw-light text-center flex-basis-100">
                        Welcome to
                        <div class="display-5 fw-bold" t-out="this.props.stationInfo.name"/>
                    </h1>
                    <div class="d-none d-lg-block flex-basis-50 text-end">
                        <button command="show-modal" commandfor="frontdesk-qrcode-dialog" class="btn p-0">
                            <img class="rounded border bg-white o_qrcode" t-att-src="this.state.qrCode" alt="QR Code"/>
                        </button>
                    </div>
                </div>

                <dialog id="frontdesk-qrcode-dialog" class="border-0 position-relative">
                    <button class="position-absolute top-0 end-0 p-3 btn-close btn-sm pe-none" aria-label="Close"/>
                    <button commandfor="frontdesk-qrcode-dialog" command="close" class="btn p-0">
                        <img class="bg-white w-100" t-att-src="this.state.qrCode" alt="QR Code"/>
                    </button>
                </dialog>

                <div class="col-auto">
                    <!-- Visitor Information Card -->
                    <div class="mb-4">
                        <div class="card shadow-lg border-0 rounded-3">
                            <div class="card-body d-flex flex-column flex-lg-row gap-4 gap-lg-5 py-lg-4 px-lg-5">
                                <!-- Visitor Information Section -->
                                <div class="flex-grow-1 flex-basis-100">
                                    <h2 class="h5 mb-4">
                                        <span
                                            t-if="this.props.stationInfo.host_selection"
                                            class="bold text-muted small me-1">
                                            1.
                                        </span>
                                        Your Information
                                    </h2>

                                    <form t-ref="this.visitorFormRef">
                                        <div class="row">
                                            <label for="name" class="col-sm-3 col-form-label smaller">
                                                Name <span class="small text-danger">*</span>
                                            </label>
                                            <div class="col-sm-9">
                                                <input type="text"
                                                    class="form-control"
                                                    t-att-class="this.props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                                                    id="name"
                                                    t-ref="this.inputNameRef"
                                                    placeholder="e.g. John Doe"
                                                    required="1"
                                                    t-att-value="this.visitorData.visitorName"/>
                                            </div>
                                        </div>
                                        <t t-if="this.props.stationInfo.authenticate_guest">
                                            <div t-if="this.props.stationInfo.ask_email" class="mt-3 row">
                                                <label for="email" class="col-sm-3 col-form-label smaller">
                                                    Email <span class="small text-danger">*</span>
                                                </label>
                                                <div class="col-sm-9">
                                                    <input type="email"
                                                        class="form-control"
                                                        t-att-class="this.props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                                                        id="email"
                                                        t-ref="this.inputEmailRef"
                                                        placeholder="e.g. john@company.com"
                                                        required="1"
                                                        t-att-value="this.visitorData.visitorEmail"/>
                                                </div>
                                            </div>
                                            <div t-if="this.props.stationInfo.ask_phone" class="mt-3 row">
                                                <label for="phone" class="col-sm-3 col-form-label smaller">
                                                    Phone <span class="small text-danger">*</span>
                                                </label>
                                                <div class="col-sm-9">
                                                    <input type="phone"
                                                        class="form-control"
                                                        t-att-class="this.props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                                                        id="phone"
                                                        t-ref="this.inputPhoneRef"
                                                        required="1"
                                                        t-att-value="this.visitorData.visitorPhone"/>
                                                </div>
                                            </div>
                                            <div t-if="this.props.stationInfo.ask_company" class="mt-3 row">
                                                <label for="company" class="col-sm-3 col-form-label smaller">
                                                    Company <span class="small text-danger">*</span>
                                                </label>
                                                <div class="col-sm-9">
                                                    <input type="text"
                                                        class="form-control"
                                                        t-att-class="this.props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                                                        id="company"
                                                        t-ref="this.inputCompanyRef"
                                                        placeholder="e.g. My Company"
                                                        required="1"
                                                        t-att-value="this.visitorData.visitorCompany"/>
                                                </div>
                                            </div>
                                        </t>
                                    </form>
                                    <t t-if="!this.props.stationInfo.host_selection">
                                        <div class="d-grid pt-4">
                                            <button class="btn btn-primary btn-sm"
                                                t-on-click="this._onConfirm">
                                                Check In
                                            </button>
                                        </div>
                                    </t>
                                </div>

                                <div t-if="this.props.stationInfo.host_selection" class="d-none d-lg-block flex-shrink-0 vr text-300"/>

                                <!-- Host Selection   -->
                                <t t-if="this.props.stationInfo.host_selection">
                                    <div class="flex-grow-0 flex-shrink-0 mw-lg-50">
                                        <div class="h-100 text-start">
                                            <div>
                                                <t t-if="this.state.showManualSelection">
                                                    <HostManualSelection
                                                            stationId="this.props.stationInfo.id"
                                                            token="this.props.token"
                                                            theme="this.props.theme"
                                                            onSelectHost.bind="this.selectedHost"
                                                            onClickBack.bind="this.goBackFromManualSelection"/>
                                                </t>
                                                <t t-else="">
                                                    <div t-att-class="!this.state.hostName ? 'mb-4' : ''">
                                                        <h2 class="h5 mb-1">
                                                            <span class="bold text-muted small me-1">2.</span>
                                                            Select Host
                                                        </h2>
                                                        <p class="text-muted smaller">Choose who you would like to visit</p>
                                                    </div>
                                                    <div class="d-grid gap-3">
                                                        <!-- Browse Button(s) -->
                                                        <button t-if="!this.state.hostName"
                                                                class="btn btn-primary text-nowrap"
                                                                title="Browse Hosts"
                                                                t-on-click="this.showManualSelection"
                                                        >
                                                            <i class="oi me-2" data-icon="stacks" role="presentation"/>
                                                            Browse All Hosts
                                                        </button>
                                                        <button t-if="this.state.hostName"
                                                                class="btn btn-secondary btn-sm text-nowrap smaller"
                                                                title="Change Host"
                                                                t-on-click="this.showManualSelection"
                                                        >
                                                             <i class="oi" data-icon="chevron_backward" role="presentation"/>
                                                            Change Host
                                                        </button>
                                                        <!-- Selected Host Alert -->
                                                        <t t-if="this.state.hostName">
                                                            <div class="card shadow">
                                                                <div class="card-body">
                                                                    <div
                                                                        class="d-flex align-items-center gap-2 mb-3"
                                                                        t-on-click="this.showManualSelection"
                                                                    >
                                                                        <img t-if="this.state.hostAvatar"
                                                                            class="rounded-circle object-fit-cover border"
                                                                            alt="Host Avatar"
                                                                            t-attf-src="{{this.state.hostAvatar}}"
                                                                            style="width:2em; height:2em"
                                                                        />
                                                                        <strong
                                                                            class="small text-wrap"
                                                                            t-out="this.state.hostName"
                                                                        />
                                                                    </div>
                                                                    <!-- Continue Button -->
                                                                    <button class="btn btn-primary btn-sm text-nowrap w-100"
                                                                            t-if="this.state.hostName"
                                                                            t-on-click="this._onConfirm"
                                                                    >
                                                                        Continue
                                                                        <i class="oi" data-icon="chevron_forward" role="presentation"/>
                                                                    </button>
                                                                </div>

                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Privacy Notice Card -->
                <div class="col-auto">
                    <div class="w-100 mx-auto" style="max-width: 520px;" t-if="this.props.stationInfo.privacy_notice or this.props.stationInfo.privacy_notice_details">
                        <div class="text-center">
                            <div class="d-flex gap-2">
                                <div class="text-prewrap smaller" t-out="this.props.stationInfo.privacy_notice"/>
                                <a href="#"
                                   class="btn btn-link smaller p-0 text-nowrap"
                                   title="Read More"
                                   t-on-click="() => this.changePrivacySettingVisibility()"
                                >
                                    Read more
                                </a>
                            </div>
                            <div
                                name="privacy_details_div"
                                class="position-fixed top-0 start-0 w-100 h-100 align-items-center justify-content-center bg-black-15"
                                role="dialog"
                                style="display: none"
                                t-on-click="() => this.changePrivacySettingVisibility()"
                            >
                                <div class="container vh-100 py-5">
                                    <div class="card bg-view bg-opacity-100 rounded-3 mh-100">
                                        <div class="position-relative d-flex justify-content-center pt-4 p-2">
                                            <h2 class="h5 mb-0">
                                                Privacy Notice
                                            </h2>
                                            <button
                                                class="position-absolute top-0 end-0 p-3 btn-close btn-sm pe-none"
                                                aria-label="Close"
                                            />
                                        </div>
                                        <div class="px-5 pb-5 pt-3 overflow-auto">
                                            <p t-out="this.props.stationInfo.privacy_notice_details"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Language Selection-->
                <div t-if="this.props.langs" class="d-flex justify-content-center pb-3">
                    <select class="form-select w-auto pe-auto" t-att-class="this.props.stationInfo.theme == 'dark' ? 'border-0 bg-800 text-white' : ' bg-white'" t-on-change="(ev) => this.props.onChangeLang(ev)">
                        <t t-foreach="this.props.langs" t-as="lang" t-key="lang.code">
                            <option t-att-value="lang.code" t-att-selected="lang.code === this.props.currentLang ? true : undefined"><t t-out="lang.name"/></option>
                        </t>
                    </select>
                </div>
            </div>
        </div>
    </t>
</templates>
