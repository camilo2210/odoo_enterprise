<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Onbording Screens -->
        <record model="hr.referral.onboarding" id="welcome1">
            <field name="text">Oh no!
Villains are lurking the city!
Help us recruit a team of superheroes to save the day!</field>
            <field name="sequence">1</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/onboarding/villains.png"/>
        </record>
        <record model="hr.referral.onboarding" id="welcome2">
            <field name="text">Browse through open job positions, promote them on social media, or refer friends.</field>
            <field name="sequence">2</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/onboarding/refer-friends.png"/>
        </record>
        <record model="hr.referral.onboarding" id="welcome3">
            <field name="text">Collect points and exchange them for awesome gifts in the shop.</field>
            <field name="sequence">3</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/onboarding/points-gift.png"/>
        </record>
        <record model="hr.referral.onboarding" id="welcome4">
            <field name="text">Compete against your colleagues to build the best justice league!</field>
            <field name="sequence">4</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/onboarding/leaderboard.png"/>
        </record>

        <!-- Referral Levels -->
        <record model="hr.referral.level" id="employee_referral_level_1">
            <field name="name">1</field>
            <field name="points">0</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-1.png"/>
        </record>
        <record model="hr.referral.level" id="employee_referral_level_2">
            <field name="name">2</field>
            <field name="points">50</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-2.png"/>
        </record>
        <record model="hr.referral.level" id="employee_referral_level_3">
            <field name="name">3</field>
            <field name="points">100</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-3.png"/>
        </record>
        <record model="hr.referral.level" id="employee_referral_level_4">
            <field name="name">4</field>
            <field name="points">350</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-4.png"/>
        </record>
        <record model="hr.referral.level" id="employee_referral_level_5">
            <field name="name">5</field>
            <field name="points">800</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-5.png"/>
        </record>
        <record model="hr.referral.level" id="employee_referral_level_6">
            <field name="name">6</field>
            <field name="points">1500</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/level-6.png"/>
        </record>

        <!-- Referral Friends -->
        <record model="hr.referral.friend" id="employee_referral_friend_1">
            <field name="name">Hero 1</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/mystic.png"/>
            <field name="image_head" type="bytes" file="hr_referral/static/src/img/characters/mystic-head.png"/>
        </record>
        <record model="hr.referral.friend" id="employee_referral_friend_2">
            <field name="name">Hero 2</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/aborigen.png"/>
            <field name="image_head" type="bytes" file="hr_referral/static/src/img/characters/aborigen-head.png"/>
        </record>
        <record model="hr.referral.friend" id="employee_referral_friend_3">
            <field name="name">Hero 3</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/cyborg.png"/>
            <field name="image_head" type="bytes" file="hr_referral/static/src/img/characters/cyborg-head.png"/>
        </record>
        <record model="hr.referral.friend" id="employee_referral_friend_4">
            <field name="name">Hero 4</field>
            <field name="position">front</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/dog.png"/>
            <field name="image_head" type="bytes" file="hr_referral/static/src/img/characters/dog-head.png"/>
        </record>
        <record model="hr.referral.friend" id="employee_referral_friend_5">
            <field name="name">Hero 5</field>
            <field name="image" type="bytes" file="hr_referral/static/src/img/characters/girl.png"/>
            <field name="image_head" type="bytes" file="hr_referral/static/src/img/characters/girl-head.png"/>
        </record>

        <!-- Recruitment Stage -->
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job0" forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job1" forcecreate="0">
            <field name="use_in_referral">True</field>
            <field name="points">5</field>
        </record>
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job2" forcecreate="0">
            <field name="use_in_referral">True</field>
            <field name="points">10</field>
        </record>
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job3" forcecreate="0">
            <field name="use_in_referral">True</field>
            <field name="points">15</field>
        </record>
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job4" forcecreate="0">
            <field name="use_in_referral">True</field>
            <field name="points">20</field>
        </record>
        <record model="hr.recruitment.stage" id="hr_recruitment.stage_job5" forcecreate="0">
            <field name="use_in_referral">True</field>
            <field name="points">50</field>
        </record>
    </data>
    <data noupdate="0">
        <function model="res.company" name="_init_default_background">
            <value model="res.company" eval="obj().search([('hr_referral_background', '=', False)]).ids"/>
        </function>
    </data>
</odoo>
