<?xml version="1.0"?>
<odoo>

    <record model="ir.ui.view" id="view_hr_referral_friend_form">
        <field name="name">hr.referral.friend.form</field>
        <field name="model">hr.referral.friend</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning p-2" role="alert"
                    invisible="(id and number_of_friends &lt;= 8) or (not id and number_of_friends &lt;= 7)">
                    You can only display 8 friends on your dashboard.
                </div>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Hero, Adventurer, Spacewoman, Dog, Batman"/>
                        <field name="position" widget="radio"/>
                        <field name="image" widget='image'/>
                        <field name="image_head" string="Avatar Image" widget='image' class="float-start oe_avatar referral-rounded-circle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_hr_referral_friend_tree">
        <field name="name">hr.referral.friend.list</field>
        <field name="model">hr.referral.friend</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget='image' class="oe_avatar o_referral_img"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_hr_referral_friend_configuration">
        <field name="name">Friends</field>
        <field name="res_model">hr.referral.friend</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hr_referral.group_hr_referral_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new friend
            </p>
        </field>
    </record>

    <menuitem parent="menu_hr_referral_dashboard_configuration" id="menu_hr_referral_friend_configuration" action="action_hr_referral_friend_configuration" sequence="2" groups="hr_referral.group_hr_referral_manager"/>

</odoo>
