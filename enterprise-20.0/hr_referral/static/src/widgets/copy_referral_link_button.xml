<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_referral.CopyButtonReferral">
        <a
            role="button"
            class="d-flex align-items-center justify-content-between w-100 text-decoration-none text-body p-0"
            t-on-click.stop="this.onClick">
            <span class="d-flex align-items-center">
                <i role="img" class="oi oi-lg oi-fw me-2 text-center" data-icon="assignment" aria-label="Copy Link"/>
                Copy Link
            </span>
            <span class="text-primary ms-2">
                <t t-if="this.props.record.data.directclicks"><t t-out="this.props.record.data.directclicks"/> click(s)</t>
            </span>
        </a>
    </t>
</templates>
