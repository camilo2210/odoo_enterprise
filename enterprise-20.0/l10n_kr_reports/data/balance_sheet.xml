<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10_kr_bs" model="account.report">
        <field name="name">Balance Sheet</field>
        <field name="name@ko_KR">재무상태표</field>
        <field name="country_id" ref="base.kr"/>
        <field name="root_report_id" ref="account_reports.balance_sheet"/>
        <field name="custom_handler_model_id" ref="l10n_kr_reports.model_l10n_kr_balance_sheet_report_handler"/>
        <field name="groupby">account_id</field>
        <field name="filter_hierarchy">by_default</field>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">today</field>
        <field name="column_ids">
            <record id="l10n_kr_bs_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="name@ko_KR">금액</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_kr_bs_assets" model="account.report.line">
                <field name="name">Assets</field>
                <field name="name@ko_KR">자산</field>
                <field name="code">KR_A</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_bs_assets_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ['asset_current', 'asset_prepayments', 'asset_cash', 'asset_receivable', 'asset_fixed', 'asset_non_current'])]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_bs_liabilities" model="account.report.line">
                <field name="name">Liabilities</field>
                <field name="name@ko_KR">부채</field>
                <field name="code">KR_L</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_bs_liabilities_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ['liability_payable', 'liability_credit_card', 'liability_current', 'liability_non_current'])]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_bs_equity_and_earnings" model="account.report.line">
                <field name="name">Equity And Earnings</field>
                <field name="name@ko_KR">자본 및 이익잉여금</field>
                <field name="code">KR_E</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">KR_EQ.balance + KR_UE.balance + KR_OCI.balance</field>
                <field name="children_ids">
                    <record id="l10n_kr_bs_equity" model="account.report.line">
                        <field name="name">Equity</field>
                        <field name="name@ko_KR">자본</field>
                        <field name="code">KR_EQ</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="l10n_kr_bs_equity_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'equity'), ('account_id.tag_ids', 'not in', [ref('l10n_kr.l10n_kr_account_tag_other_comprehensive_income')])]"/>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_kr_bs_earnings" model="account.report.line">
                        <field name="name">Earnings</field>
                        <field name="name@ko_KR">이익잉여금</field>
                        <field name="code">KR_UE</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="aggregation_formula">KR_CYE.balance + KR_PYE.balance</field>
                        <field name="children_ids">
                            <record id="l10n_kr_bs_current_year_earnings" model="account.report.line">
                                <field name="name">Current Year Unallocated Earnings</field>
                                <field name="name@ko_KR">당기미처분순이익(또는 당기미처분순손실)</field>
                                <field name="code">KR_CYE</field>
                                <field name="hierarchy_level">3</field>
                                <field name="foldability">never_unfolded</field>
                                <field name="expression_ids">
                                    <record id="l10n_kr_bs_current_year_earnings_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', 'in', ['income', 'income_other', 'expense_direct_cost', 'expense', 'expense_depreciation', 'expense_other', 'equity_unaffected'])]"/>
                                        <field name="date_scope">from_fiscalyear</field>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_kr_bs_previous_years_earnings" model="account.report.line">
                                <field name="name">Previous Years Unallocated Earnings</field>
                                <field name="name@ko_KR">이연미처분이익잉여금(또는 이연미처리결손금)</field>
                                <field name="code">KR_PYE</field>
                                <field name="hierarchy_level">3</field>
                                <field name="foldability">never_unfolded</field>
                                <field name="expression_ids">
                                    <record id="l10n_kr_bs_previous_years_earnings_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', 'in', ['income', 'income_other', 'expense_direct_cost', 'expense', 'expense_depreciation', 'expense_other', 'equity_unaffected'])]"/>
                                        <field name="date_scope">to_beginning_of_fiscalyear</field>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_kr_bs_other_comprehensive_income" model="account.report.line">
                        <field name="name">Other Comprehensive Income</field>
                        <field name="name@ko_KR">기타포괄손익누계액</field>
                        <field name="code">KR_OCI</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="hide_if_zero" eval="True"/>
                        <field name="aggregation_formula">KR_CTA.balance + KR_OOCI.balance</field>
                        <field name="children_ids">
                            <record id="l10n_kr_bs_cumulative_translation_adjustments" model="account.report.line">
                                <field name="name">Cumulative Translation Adjustments</field>
                                <field name="name@ko_KR">해외사업환산손익</field>
                                <field name="code">KR_CTA</field>
                                <field name="hierarchy_level">3</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="expression_ids">
                                    <record id="l10n_kr_bs_cumulative_translation_adjustments_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">custom</field>
                                        <field name="formula">_report_engine_cumulative_translation_adjustment</field>
                                        <field name="subformula">balance</field>
                                        <field name="auditable" eval="True"/>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_kr_bs_other_comprehensive_income_items" model="account.report.line">
                                <field name="name">Other OCI</field>
                                <field name="name@ko_KR">그 밖의 기타포괄손익누계액</field>
                                <field name="code">KR_OOCI</field>
                                <field name="hierarchy_level">3</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="expression_ids">
                                    <record id="l10n_kr_bs_other_comprehensive_income_items_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'equity'), ('account_id.tag_ids', 'in', [ref('l10n_kr.l10n_kr_account_tag_other_comprehensive_income')])]"/>
                                        <field name="date_scope">from_beginning</field>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_bs_total_liabilities_and_equity" model="account.report.line">
                <field name="name">Total Liabilities and Equity</field>
                <field name="name@ko_KR">부채 및 자본 총계</field>
                <field name="code">KR_LE</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_bs_total_liabilities_and_equity_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">KR_L.balance + KR_E.balance</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
