<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_kr_pl" model="account.report">
        <field name="name">Profit And Loss</field>
        <field name="name@ko_KR">손익계산서</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="groupby">account_id</field>
        <field name="country_id" ref="base.kr"/>
        <field name="filter_hierarchy">by_default</field>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_budgets" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="l10n_kr_pl_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="name@ko_KR">금액</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_kr_pl_revenue" model="account.report.line">
                <field name="name">Revenue</field>
                <field name="name@ko_KR">매출액</field>
                <field name="code">KR_REV</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_revenue_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_cost_of_sales" model="account.report.line">
                <field name="name">Less Cost of Sales</field>
                <field name="name@ko_KR">매출원가</field>
                <field name="code">KR_COS</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_cost_of_sales_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_gross_profit" model="account.report.line">
                <field name="name">Gross profit (loss)</field>
                <field name="name@ko_KR">매출총이익(또는 매출총손실)</field>
                <field name="code">KR_GRP</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">KR_REV.balance - KR_COS.balance</field>
            </record>
            <record id="l10n_kr_pl_operating_expenses" model="account.report.line">
                <field name="name">Less Selling and Administrative Expenses</field>
                <field name="name@ko_KR">판매비와관리비</field>
                <field name="code">KR_EXP</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_operating_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ['expense', 'expense_depreciation']), ('account_id.tag_ids', 'not in', [ref('l10n_kr.l10n_kr_account_tag_income_tax_expense')])]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_operating_profit" model="account.report.line">
                <field name="name">Profit (loss) from Operating Activities</field>
                <field name="name@ko_KR">영업손익(또는 영업손실)</field>
                <field name="code">KR_INC</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">KR_GRP.balance - KR_EXP.balance</field>
            </record>
            <record id="l10n_kr_pl_non_operating_income" model="account.report.line">
                <field name="name">Plus Non-operating Income</field>
                <field name="name@ko_KR">영업외수익</field>
                <field name="code">KR_OIN</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_non_operating_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income_other')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_non_operating_expenses" model="account.report.line">
                <field name="name">Less Non-operating Expenses</field>
                <field name="name@ko_KR">영업외비용</field>
                <field name="code">KR_OEXP</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_non_operating_expenses_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ['expense_other']), ('account_id.tag_ids', 'not in', [ref('l10n_kr.l10n_kr_account_tag_income_tax_expense')])]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_profit_before_tax" model="account.report.line">
                <field name="name">Profit (loss) Before Tax</field>
                <field name="name@ko_KR">법인세비용차감전순손익</field>
                <field name="code">KR_PBT</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">KR_INC.balance + KR_OIN.balance - KR_OEXP.balance</field>
            </record>
            <record id="l10n_kr_pl_tax_expense" model="account.report.line">
                <field name="name">Less Tax Expense (income)</field>
                <field name="name@ko_KR">법인세비용</field>
                <field name="code">KR_TE</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_tax_expense_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ['expense', 'expense_other', 'expense_depreciation']), ('account_id.tag_ids', 'in', [ref('l10n_kr.l10n_kr_account_tag_income_tax_expense')])]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_net_profit" model="account.report.line">
                <field name="name">Net Profit (loss)</field>
                <field name="name@ko_KR">당기순이익(또는 당기순손실)</field>
                <field name="code">KR_NEP</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">KR_PBT.balance - KR_TE.balance</field>
            </record>
            <record id="l10n_kr_pl_other_comprehensive_income" model="account.report.line">
                <field name="name">Other Comprehensive Income</field>
                <field name="name@ko_KR">기타포괄손익</field>
                <field name="code">KR_OCI</field>
                <field name="hierarchy_level">0</field>
                <field name="foldability">foldable</field>
                <field name="hide_if_zero" eval="True"/>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_other_comprehensive_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'equity'), ('account_id.tag_ids', 'in', [ref('l10n_kr.l10n_kr_account_tag_other_comprehensive_income')])]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_kr_pl_total_comprehensive_income" model="account.report.line">
                <field name="name">Total Comprehensive Income</field>
                <field name="name@ko_KR">포괄손익</field>
                <field name="code">KR_TCI</field>
                <field name="hierarchy_level">0</field>
                <field name="hide_if_zero" eval="True"/>
                <field name="expression_ids">
                    <record id="l10n_kr_pl_total_comprehensive_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">KR_NEP.balance + KR_OCI.balance</field>
                        <field name="subformula">if_other_expr_above(KR_TCI.combined_check, KRW(0))</field>
                    </record>
                    <record id="l10n_kr_pl_total_comprehensive_income_check_above" model="account.report.expression">
                        <field name="label">check_above</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">1</field>
                        <field name="subformula">if_other_expr_above(KR_OCI.balance, KRW(0))</field>
                    </record>
                    <record id="l10n_kr_pl_total_comprehensive_income_check_below" model="account.report.expression">
                        <field name="label">check_below</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">1</field>
                        <field name="subformula">if_other_expr_below(KR_OCI.balance, KRW(0))</field>
                    </record>
                    <record id="l10n_kr_pl_total_comprehensive_income_combined_check" model="account.report.expression">
                        <field name="label">combined_check</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">KR_TCI.check_above + KR_TCI.check_below</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
