<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_account_asset_form">
        <field name="name">account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <field name="company_id" invisible="1" readonly="state != 'draft'"/>
                <field name="is_multi_ledger_company" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="account_asset_id" invisible="1" readonly="state == 'close'"/>
                <field name="state" invisible="1"/>
                <field name="total_depreciation_entries_count" invisible="1"/>
                <field name="parent_id" invisible="1"/>
                <field name="is_main_variant" invisible="1"/>
                <field name="origin_asset_id" invisible="1"/>
                <field name="derived_asset_ids" invisible="1"/>
                <field name="non_deductible_tax_value" invisible="1"/>
                <header>
                    <button name="validate" invisible="state != 'draft'" string="Confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button type="object" name="compute_depreciation_board" string="Compute Depreciation" invisible="state != 'draft'" data-hotkey="d"/>
                    <button name="set_to_running" string="Set to Running" type="object" invisible="state != 'close' or derived_asset_ids or not is_main_variant"/>
                    <button name="resume_after_pause" string="Resume Depreciation" type="object" class="oe_highlight" invisible="state != 'paused'"/>
                    <button name="action_asset_modify" invisible="state != 'open' or not is_main_variant" string="Modify Depreciation" type="object" data-hotkey="e" class="oe_highlight"/>
                    <button name="set_to_cancelled" string="Cancel Assets" type="object" invisible="variant_count &lt; 2 or not is_main_variant or state != 'open'" data-hotkey="x"/>
                    <button name="set_to_cancelled" string="Cancel Asset" type="object" invisible="(variant_count &gt; 1 and is_main_variant) or state != 'open'" data-hotkey="x"/>
                    <button name="set_to_draft" string="Set All to Draft" type="object" invisible="variant_count &lt; 2 or not is_main_variant or depreciation_entries_count > 0 or state not in ['open', 'cancelled']"/>
                    <button name="set_to_draft" string="Set to Draft" type="object" invisible="(variant_count &gt; 1 and is_main_variant) or depreciation_entries_count > 0 or state not in ['open', 'cancelled']"/>
                    <button name="action_depreciation_ledger" invisible="state != 'open' or not is_multi_ledger_company or not is_main_variant or main_variant_parent_id" string="New Depreciation" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="open_main_variant" type="object" icon="stacks" invisible="not main_variant_id or is_main_variant">
                            <field string="Main Asset" name="main_variant_model_name" widget="statinfo" />
                        </button>
                        <button name="action_open_linked_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="badge"
                            invisible="count_linked_asset == 0 or warning_count_assets">
                            <field string="Asset(s)" name="count_linked_asset" widget="statinfo"/>
                        </button>
                        <button name="action_open_linked_assets"
                            type="object"
                            class="oe_stat_button text-danger"
                            icon="badge"
                            invisible="count_linked_asset == 0 or not warning_count_assets">
                            <field string="Asset(s)" name="count_linked_asset" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="open_related_items" type="object" icon="menu" data-hotkey="r" invisible="original_move_lines_count == 0">
                            <field string="Related Items" name="original_move_lines_count" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="open_entries"  type="object" icon="menu" data-hotkey="shift+p">
                            <field string="Posted Entries" name="depreciation_entries_count" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="open_increase"  type="object" icon="expand_circle_up" icon_class="oi-filled" invisible="gross_increase_count == 0">
                            <field string="Gross Increase" name="gross_increase_count" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" string="Original Asset" name="open_origin_asset" type="object" icon="arrow_circle_left" icon_class="oi-filled" invisible="not origin_asset_id"/>
                        <button class="oe_stat_button" string="Active Asset" name="open_derived_assets" type="object" icon="arrow_circle_right" icon_class="oi-filled" invisible="not derived_asset_ids"/>
                        <button class="oe_stat_button" string="Parent Asset" name="open_variant_parent_id" type="object" icon="menu" invisible ="not parent_id"/>
                        <button class="oe_stat_button" name="open_variants" type="object" icon="stacks" invisible="variant_count &lt; 2 or (variant_count == 2 and not is_main_variant) or warning_sub_assets">
                            <field string="Sub-Assets" name="variant_ledger_names" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button text-danger" name="open_variants" type="object" icon="stacks" invisible="variant_count &lt; 2 or (variant_count == 2 and not is_main_variant) or not warning_sub_assets">
                            <field string="Sub-Assets" name="variant_ledger_names" widget="statinfo" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" name="name_label"/>
                        <h1>
                            <field name="name" placeholder="e.g. Laptop iBook" required="1" readonly="not is_main_variant"/>
                        </h1>
                    </div>
                    <notebook colspan="4">
                        <page string="Asset" name="main_page">
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="asset_properties" columns="2"/>
                                <group string="Asset Values" name="asset_values">
                                    <label for="original_value"/>
                                    <span>
                                        <field name="original_value" class="oe_inline" readonly="state != 'draft' or not is_main_variant"/>
                                        <span class="text-muted" invisible="non_deductible_tax_value == 0">
                                            (<field name="related_purchase_value" nolabel="1" class="oe_inline"/>
                                             tax excl.)
                                        </span>
                                    </span>
                                    <field name="gross_increase_value" widget="monetary" invisible="gross_increase_value == 0" options="{'currency_field': 'currency_id'}"/>
                                    <field name="acquisition_date" readonly="state != 'draft' or not is_main_variant"/>
                                    <field
                                        name="account_asset_id"
                                        domain="[
                                            ('company_ids', 'parent_of', company_id),
                                            ('depreciation_model_id', '!=', None),
                                        ]"
                                        context="{
                                            'default_account_type': 'asset_fixed',
                                            'account_type_domain': [('account_type', 'in', (
                                                'asset_fixed',
                                                'asset_non_current'))]}"
                                        invisible="original_move_line_ids"
                                        required="1"
                                        readonly="state != 'draft' or not is_main_variant"/>
                                    <field name="asset_group_id" readonly="not is_main_variant"/>
                                </group>
                                <group string="Current Values" name="current_values">
                                    <field name="salvage_value" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'" invisible="not is_main_variant"/>
                                    <label for="book_value"/>
                                    <span>
                                        <field name="book_value" class="oe_inline" widget="monetary" required="1" options="{'currency_field': 'currency_id'}"/>
                                        <span invisible="salvage_value == 0 or not is_main_variant">
                                            (incl.
                                            <field name="value_residual" nolabel="1" force_save="1" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                             depreciable)
                                        </span>
                                    </span>
                                    <field name="already_depreciated_amount_import" readonly="state != 'draft'" invisible="not is_main_variant"/>
                                </group>
                                <group string="Depreciation Method">
                                    <field
                                        name="model_id"
                                        domain="['|', ('journal_id.journal_group_id', '=', False), ('journal_id', '=', False)]"
                                        string="Depreciation Model"
                                        options="{'no_quick_create': True}"
                                        readonly="state != 'draft' or not is_main_variant"
                                        required="1"/>
                                    <field name="prorata_computation_type" readonly="state != 'draft'" invisible="method == 'no_depreciation'"/>
                                </group>
                                <group string="Accounting">
                                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                    <field name="journal_id" invisible="method == 'no_depreciation'"/>
                                    <field name="analytic_distribution" string="Analytic" groups="analytic.group_analytic_accounting" widget="analytic_distribution"
                                           options="{'account_field': 'account_depreciation_expense_id', 'business_domain': 'general'}"
                                           readonly="0"/>
                                </group>
                            </group>
                        </page>
                        <page string="Depreciation Board" name="depreciation_board" invisible="total_depreciation_entries_count == 0">
                            <field name="depreciation_move_ids" mode="list" options="{'reload_whole_on_button': true}" readonly="state not in ['draft', 'open', 'paused']">
                                <list string="Depreciation Lines" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" create="0" default_order="date asc, id asc" editable="top">
                                    <field name="currency_id" column_invisible="True" readonly="state in ['cancel', 'posted']"/>
                                    <field name="date" string="Depreciation Date" readonly="state in ['cancel', 'posted']"/>
                                    <field name="ref" invisible="0"/>
                                    <field name="reversal_move_ids" widget="deprec_lines_reversed" nolabel="1"/>
                                    <field name="depreciation_value" widget="monetary" string="Depreciation"
                                        options="{'currency_field': 'currency_id'}" readonly="state == 'posted' or not parent.is_main_variant"/>
                                    <field name="asset_depreciated_value" readonly="1" force_save="1" options="{'currency_field': 'currency_id'}"/>
                                    <field name="asset_remaining_value" readonly="1" widget="monetary" force_save="1" options="{'currency_field': 'currency_id'}" column_invisible="not parent.is_main_variant"/>
                                    <field name="name" readonly="1" string="Journal Entry" widget="open_move_widget"/>
                                    <field name="state" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bills" name="related_items">
                            <field
                                name="original_move_line_ids"
                                readonly="state == 'posted'"
                                domain="[
                                    ('parent_state', '=', 'posted'),
                                    ('company_id', '=', company_id),
                                    ('move_id.move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt', 'entry')),
                                    ('move_id.asset_variant_id', '=', False),
                                    ('tax_line_id', '=', False),
                                    ('tax_repartition_line_id', '=', False),
                                    ] + (
                                        [('account_id', '=', account_asset_id)]
                                        if account_asset_id
                                        else [('account_id.account_type', 'in', ('asset_fixed', 'asset_non_current', 'asset_current'))]
                                    )"
                                class="original_move_line_ids_field"
                                context="{'disable_preview': 1, 'list_view_ref': 'account_asset.view_move_line_tree_asset'}">
                                <list create="0" no_open="1">
                                    <field name="date"/>
                                    <field name="move_name" string="Journal Entry" widget="open_move_widget"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="debit" widget="monetary"/>
                                    <field name="credit" widget="monetary"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_asset_kanban" model="ir.ui.view">
        <field name="name">account.asset.kanban</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="row mb4">
                            <field name="name" class="fw-bold fs-5 col-10"/>
                            <div class="col-2">
                                <field name="state" class="float-end" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-success="state == 'open'"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-5">
                                Original Value
                            </div>
                            <div class="col-7 text-end">
                                <field name="original_value" widget='monetary' readonly="state != 'draft'"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-5">
                                Acquisition Date
                            </div>
                            <div class="col-7 text-end">
                                <field name="acquisition_date" readonly="state != 'draft'"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-5">
                                Model
                            </div>
                            <div class="col-7 text-end">
                                <field name="model_id" readonly="state != 'draft'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_asset_tree">
        <field name="name">account.asset.list</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-info="(state == 'draft')" decoration-muted="(state in ['close', 'cancelled'])" decoration-warning="(state == 'close' and value_residual != 0)" sample="1" multi_edit="1">
                <field name="name" readonly="state != 'draft'"/>
                <field name="asset_properties" readonly="state != 'draft'"/>
                <field name="acquisition_date" readonly="state != 'draft'"/>
                <field name="original_value" readonly="state != 'draft'"/>
                <field name="book_value" readonly="1"/>
                <field name="value_residual" widget="monetary" readonly="1" optional="hide"/>
                <field name="account_asset_id" width="120px" readonly="state not in ['draft', 'open']"/>
                <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" options="{'multi_edit': true}" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="state != 'draft'"/>
                <field name="company_id" groups="!base.group_multi_company" column_invisible="True" readonly="state != 'draft'"/>
                <field name="parent_id" optional="hide" readonly="1"/>
                <field name="model_id" string="Depreciation Model" readonly="state != 'draft'"/>
                <field name="asset_group_id"/>
                <field name="main_variant_state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'" readonly="1"/>
                <field name="already_depreciated_amount_import" string="Depreciated Amount" readonly="state != 'draft'" optional="hide"/>
                <field name="salvage_value" widget="monetary" readonly="state != 'draft'" optional="hide"/>
                <field name="activity_exception_decoration" widget="activity_exception" readonly="1"/>
                <field name="activity_ids" widget="list_activity" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_asset_search" model="ir.ui.view">
        <field name="name">account.asset.search</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <search string="Asset Account">
                <field name="name" string="Asset"/>
                <field name="acquisition_date"/>
                <filter string="Current" name="current" domain="[('main_variant_state','in', ('draft','open'))]" help="Assets in draft and open states"/>
                <filter string="Closed" name="closed" domain="[('main_variant_state','=', 'close')]" help="Assets in closed state"/>
                <field name="model_id" string="Depreciation Model"/>
                <separator/>
                <field name="asset_properties"/>
                <filter invisible="1" string="My Activities" name="filter_activities_my"
                    domain="[('activity_user_id', '=', uid)]"/>
                <separator invisible="1"/>
                <filter invisible="1" string="Late Activities" name="activities_overdue"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                    help="Show all records whose next activity date is past"/>
                <filter invisible="1" string="Today Activities" name="activities_today"
                    domain="[('my_activity_date_deadline', '=', 'today')]"/>
                <filter invisible="1" string="Future Activities" name="activities_upcoming_all"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                        <filter string="Date" name="month" domain="[]" context="{'group_by':'acquisition_date'}"/>
                        <filter string="Depreciation Model" name="model" domain="[]" context="{'group_by':'model_id'}"/>
                        <filter string="Properties" name="group_by_properties" context="{'group_by': 'asset_properties'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_account_asset_form">
        <field name="name">Assets</field>
        <field name="res_model">account.asset</field>
        <field name="path">assets</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_asset_tree')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'activity'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_asset_form')})]"/>
        <field name="domain">[('main_variant_parent_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Import your fixed assets' original data and their already accumulated depreciation.
                <a type="action" class="text-primary" name="account_asset.action_server_download_asset_template">
                   With our template
                </a>
            </p>
        </field>

    </record>

    <menuitem parent="accountant.account_assets_liabilities_menu" id="menu_action_account_asset_form" action="action_account_asset_form" sequence="60" groups="account.group_account_readonly"/>

    <record model="ir.actions.server" id="action_account_asset_run">
        <field name="name">Confirm</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="model_id" ref="account_asset.model_account_asset"/>
        <field name="binding_model_id" ref="account_asset.model_account_asset" />
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.filtered(lambda asset: asset.state == 'draft').validate()
        </field>
    </record>

    <record model="ir.actions.server" id="action_account_asset_compute_depreciations">
        <field name="name">Compute Depreciation</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="model_id" ref="account_asset.model_account_asset"/>
        <field name="binding_model_id" ref="account_asset.model_account_asset" />
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.filtered(lambda asset: asset.state == 'draft').compute_depreciation_board()
        </field>
    </record>

    <!-- Configuration -->

    <menuitem id="menu_finance_config_assets" name="Assets and Revenues" parent="account.menu_finance_configuration" sequence="25"/>

    <!-- Override of move line list view. Avoid the assets taking a random list view, and make sure to only display relevant fields by default. -->

    <record id="view_move_line_tree_asset" model="ir.ui.view">
        <field name="name">account.move.line.list.asset</field>
        <field name="model">account.move.line</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="amount_currency" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="debit" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="credit" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="matching_number" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="analytic_distribution" position="attributes"><attribute name="optional">hide</attribute></field>
            <field name="balance" position="attributes"><attribute name="optional">show</attribute></field>
        </field>
    </record>

    <record id="action_server_download_asset_template" model="ir.actions.server">
        <field name="name">Download Asset Import Template</field>
        <field name="model_id" ref="account_asset.model_account_asset"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
active_company = env.company
url = f'/web/binary/download_asset_template/{active_company.id}'
action = {
    'type': 'ir.actions.act_url',
    'url': url,
    'target': 'download',
}
    ]]></field>
    </record>
</odoo>
