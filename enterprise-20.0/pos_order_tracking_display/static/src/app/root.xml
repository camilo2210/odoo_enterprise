<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_order_tracking_display.OrderStatusDisplay">
        <div t-attf-class="o_tracking_display_main vh-100 text-bg-800 overflow-y-auto {{!this.isVertical and 'd-flex flex-row-reverse'}}">
            <Orders categoryName.translate="Ready" ready="true" class="this.isVertical ? 'mb-5' : 'text-bg-600 vh-100'" orders="this.orders.done or []" />
            <Orders categoryName.translate="Almost there" orders="this.orders.notDone or []" />
            <OdooLogo class="'o_tracking_display_logo position-absolute bottom-0 end-0'" monochrome="true" />
        </div>
    </t>
</templates>
