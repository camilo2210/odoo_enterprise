<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_role_view_search_inherit_pos_planning" model="ir.ui.view">
        <field name="name">planning.role.search.inherit.pos.planning</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_search"/>
        <field name="arch" type="xml">
            <field name="resource_ids" position="after">
                <field name="pos_config_ids"/>
            </field>
        </field>
    </record>

    <record id="planning_role_view_tree_inherit_pos_planning" model="ir.ui.view">
        <field name="name">planning.role.list.inherit.pos.planning</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_tree"/>
        <field name="arch" type="xml">
            <field name="resource_ids" position="after">
                <field name="pos_config_ids" widget="many2many_tags_placeholder_list_view" placeholder="None" options="{'no_create': True, 'no_edit': True}" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="pos_planning_role_view_form_inherit_pos_planning"  model="ir.ui.view">
        <field name="name">pos.planning.role.form.inherit.pos.planning</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_form"/>
        <field name="arch" type="xml">
            <field name="resource_ids" position="after">
                <field name="pos_config_ids" widget="many2many_tags" placeholder="None" options="{'no_create': True, 'no_edit': True}"/>
            </field>
        </field>
    </record>

</odoo>
