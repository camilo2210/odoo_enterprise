<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_phone" model="ir.ui.view">
        <field name="name">hr.employee.public.view.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <p class="text-muted">Please add a work phone number for the following employee(s) so that they can receive their planning:</p>
                    </div>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="work_phone"  widget="phone" required="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
