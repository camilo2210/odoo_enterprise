<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="ir_actions_server_add_human" model="ir.actions.server">
        <field name="name">AI: Social Live Chat Add Human Operator</field>
        <field name="ai_tool_name">ai_tool_social_livechat_add_human</field>
        <field name="state">code</field>
        <field name="use_in_ai" eval="True"/>
        <field name="code">ai['result'] = record._ai_tool_social_livechat_add_human()</field>
        <field name="model_id" ref="ai.model_ai_agent"/>
        <field name="ai_tool_thinking_text">Contacting an operator</field>
        <field name="ai_tool_description">
            Adds an available human operator to the current conversation
            and stops the AI agent from handling new user messages.
            Use this tool when the user asks for a human,
            or when the conversation must be escalated to a person.
            If no operator is available, the AI agent remains in the conversation.
        </field>
        <field name="ai_tool_schema">
        {
            "type": "object",
            "properties": {},
            "required": []
        }
        </field>
    </record>
</data>
</odoo>
