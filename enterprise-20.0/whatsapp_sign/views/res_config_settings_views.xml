<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.sign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sign.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sign']" position="inside">
                <setting id="sign_whatsapp" company_dependent="1" help="Allow users to send documents for signing via WhatsApp" string="Send Requests through WhatsApp">
                    <field name="sign_whatsapp_enabled"/>
                    <div class="content-group" id="sign_whatsapp_templates" invisible="not sign_whatsapp_enabled">
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Request Template" for="sign_send_request_wa_template_id"/>
                            <field name="sign_send_request_wa_template_id" class="col-lg-9" required="sign_whatsapp_enabled"/>
                        </div>
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Completion Template" for="request_completion_wa_template_id"/>
                            <field name="request_completion_wa_template_id" class="col-lg-9" required="sign_whatsapp_enabled"/>
                        </div>
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Refusal Template" for="request_refusal_wa_template_id"/>
                            <field name="request_refusal_wa_template_id" class="col-lg-9" required="sign_whatsapp_enabled"/>
                        </div>
                    </div>
                    <button name="%(whatsapp.whatsapp_template_action)d" icon="east" type="action" string="Manage Your Templates" class="btn-link"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
