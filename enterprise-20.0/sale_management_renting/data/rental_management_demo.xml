<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Add a rental quotation template -->
    <record id="rental_order_template_1" model="sale.order.template">
        <field name="name">Couple's Room + Spa Package</field>
        <field name="number_of_days">45</field>
        <field name="sale_order_template_line_ids">
            <record id="rental_order_template_line_1" model="sale.order.template.line">
                <field name="product_id" ref="sale_renting.luxury_room"/>
            </record>
            <record id="rental_order_template_line_section_1" model="sale.order.template.line">
                <field name="name">Optional Products</field>
                <field name="product_uom_qty">0.00</field>
                <field name="display_type">line_section</field>
                <field name="is_optional">True</field>
            </record>
            <record id="rental_order_template_line_option_1" model="sale.order.template.line">
                <field name="product_id" ref="sale_renting.spa_access"/>
                <field name="product_uom_qty">2</field>
            </record>
        </field>
    </record>

</odoo>
