<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_journal_form_inherit_l10n_hk_payment_autopay" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.l10n_hk_payment_autopay</field>
            <field name="model">account.journal</field>
            <field name="priority">10</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@id='outbound_payment_settings']//group[@name='outgoing_payment']" position="inside">
                    <group string="AutoPay configuration" invisible="',l10n_hk_mri,'.lower() not in (selected_payment_method_codes or '').lower() or type != 'bank'">
                        <field name="l10n_hk_autopay_payment_set_code"/>
                        <field name="l10n_hk_autopay_party_ref"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
