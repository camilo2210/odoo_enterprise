<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_se_pos.pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer">
            <div name="footer" position="after">
                <table class="w-100 text-small" t-if="conditions.get('iot_fdm_se_id')">
                    <tbody>
                        <tr>
                            <td class="text-start">POS ID:</td>
                            <td class="text-end" t-out="config['name']" />
                        </tr>
                        <tr>
                            <td class="text-start">Blackbox Unit ID:</td>
                            <td class="text-end" t-out="order['sweden_blackbox_unit_id']" />
                        </tr>
                        <tr>
                            <td class="text-start">Blackbox Signature:</td>
                            <td class="text-end" style="word-break: break-all" t-out="order['sweden_blackbox_signature']" />
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>
    </data>
</odoo>
