<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="worksheet.WorksheetProperties" t-inherit="web.PropertiesField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('row')]" position="after">
            <div t-if="this.displayAddWorksheetPropertyButton"
                class="o_field_property_add d-none d-sm-block"
                t-att-class="{'g-col-2': this.props.columns !== 1}">
                <button
                    class="btn btn-link text-break m-0"
                    t-on-click="this.onPropertyCreateEmpty">
                    <i class="oi" data-icon="add"/>
                    Add Property
                </button>
            </div>
            <span t-if="this.displayAddWorksheetPropertyButton" class="d-block d-sm-none text-muted">
                To design this worksheet template, open it on a desktop.
            </span>
        </xpath>
    </t>
</templates>
