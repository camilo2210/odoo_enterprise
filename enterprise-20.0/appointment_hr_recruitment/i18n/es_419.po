#. module: appointment_hr_recruitment
#: model:ir.module.module,description:base.module_appointment_hr_recruitment
msgid ""
"\n"
"Keeps track of all appointments related to applicants.\n"
msgstr ""
"\n"
"Lleva seguimiento de todas las citas relacionadas con los postulantes.\n"

#. module: appointment_hr_recruitment
#: model:mail.template,body_html:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>Hello,</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        Thanks for your application and interest in <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t>.<br/>\n"
"        <br/>\n"
"        I would like to organize a phone interview with you, it should last "
"about 30 min.\n"
"        We'll go through your resume and motivations to join the <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t> team.\n"
"        You can book a slot in our agenda by cliking on the button below.<br/"
">\n"
"    </div>\n"
"    <br/>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">Schedule my interview</a><br/>\n"
"    <br/>\n"
"    Best regards,\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>Hola,</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        Gracias por tu postulación e interés en <t t-"
"out=\"object.company_id.name or ''\">SuEmpresa</t>.<br/>\n"
"        <br/>\n"
"        Me gustaría organizar una entrevista telefónica contigo que durará "
"aproximadamente 30 minutos.\n"
"        Hablaremos sobre tu currículum y por qué te interesa unirte al "
"equipo de <t t-out=\"object.company_id.name or ''\">SuEmpresa</t>.\n"
"        Para reservar un horario para la entrevista en nuestra agenda, haz "
"clic en el siguiente botón.<br/>\n"
"    </div>\n"
"    <br/>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: {"
"{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">Programar mi entrevista</a><br/>\n"
"    <br/>\n"
"    Saludos cordiales,\n"
"</div>\n"
"        "

#. module: appointment_hr_recruitment
#: model_terms:ir.ui.view,arch_db:appointment_hr_recruitment.appointment_applicant_link_expired
msgid ""
"<i class=\"oi\" data-icon=\"info\"/>\n"
"                    It may have expired because your application process has "
"already been completed or closed."
msgstr ""
"<i class=\"oi\" data-icon=\"info\"/>\n"
"                    Es posible que haya vencido porque tu proceso de "
"postulación ya se completó o se cerró."

