<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_do_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_do_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Dominican Republic Electronic Invoicing" invisible="country_code != 'DO'">
                    <setting id="web_service_environment" string="Web Service Environment"
                             help="Select the environment for the Dominican Republic webservice."
                             invisible="not is_root_company">
                        <div class="row">
                            <field name="l10n_do_edi_web_service_env" widget="radio"/>
                        </div>
                    </setting>
                    <setting id="infile_credentials" string="Infile Credentials"
                             help="Get your credentials from Infile and enter them here to connect and generate electronic invoices."
                             invisible="not is_root_company or l10n_do_edi_web_service_env == 'demo'">
                        <div class="row">
                            <label string="Username" for="l10n_do_edi_username" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_edi_username" class="w-50" required="l10n_do_edi_web_service_env != 'demo'"/>
                        </div>
                        <div class="row">
                            <label string="Password" for="l10n_do_edi_password" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_edi_password" password="True" class="w-50" required="l10n_do_edi_web_service_env != 'demo'" />
                        </div>
                        <div class="row">
                            <label string="Security Key" for="l10n_do_edi_key" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_edi_key" password="True" class="w-50" required="l10n_do_edi_web_service_env != 'demo'"/>
                        </div>
                        <div class="row">
                            <label string="Llave" for="l10n_do_edi_llave" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_edi_llave" class="w-50" required="l10n_do_edi_web_service_env != 'demo'"/>
                        </div>
                    </setting>
                    <div class="text-muted ms-3" invisible="is_root_company">
                        Please configure the EDI credentials from the root company.
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
