<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_do_edi_document_range_form_view" model="ir.ui.view">
        <field name="name">l10n_do_edi.document.type.range.form.view</field>
        <field name="model">l10n_do_edi.document.type.range</field>
        <field name="arch" type="xml">
            <form string="Dominican Republic EDI Document Type Range">
                <group>
                    <field name="start_number"/>
                    <field name="end_number"/>
                    <field name="expiration_date"/>
                    <field name="company_id" domain="[('account_fiscal_country_id.code', '=', 'DO')]"/>
                </group>
            </form>
        </field>
    </record>

    <record id="l10n_do_edi_document_range_list_view" model="ir.ui.view">
        <field name="name">l10n_do_edi.document.type.range.list.view</field>
        <field name="model">l10n_do_edi.document.type.range</field>
        <field name="arch" type="xml">
            <list string="Dominican Republic EDI Document Type Ranges" editable="bottom">
                <field name="start_number"/>
                <field name="end_number"/>
                <field name="expiration_date"/>
                <field name="company_id" optional="hide" domain="[('account_fiscal_country_id.code', '=', 'DO')]"/>
            </list>
        </field>
    </record>
</odoo>
