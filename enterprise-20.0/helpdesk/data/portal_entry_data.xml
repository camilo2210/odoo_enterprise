<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_helpdesk_ticket_entry" model="portal.entry">
        <field name="name">Tickets</field>
        <field name="description">Follow all your helpdesk tickets</field>
        <field name="url">/my/tickets</field>
        <field name="image" type="bytes" file="helpdesk/static/src/img/tickets.svg"/>
        <field name="placeholder_count">ticket_count</field>
        <field name="category">service_category</field>
        <field name="sequence" eval="80"/>
    </record>
</odoo>
