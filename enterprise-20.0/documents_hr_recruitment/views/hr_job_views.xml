<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_survey" model="ir.ui.view">
        <field name="name">hr.job.form1.inherit.documents</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
        <field name="arch" type="xml">
            <field name="documents_count" position="before">
                <field name="documents_bridge_enabled" invisible="1"/> <!-- Invisible because we don't need to see it ! -->
            </field>
            <field name="documents_count" position="attributes">
                <attribute name="invisible">documents_bridge_enabled</attribute>
            </field>
            <field name="documents_count" position="after">
                <!-- Documents count will be displayed whenever the bridge is enabled -->
                <!-- If not, the attachment count will be displayed -->
                <field name="document_count" widget="statinfo" string="Documents"
                       invisible="not documents_bridge_enabled"/>
            </field>
        </field>
    </record>
</odoo>
