<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_kanban_view_applicant" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.documents</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <field name="attachment_number" position="before">
                <field name="documents_bridge_enabled" invisible="1"/>
            </field>
            <field name="attachment_number" position="attributes">
                <attribute name="invisible">documents_bridge_enabled</attribute>
            </field>
            <field name="attachment_number" position="after">
                <!-- Documents count will be displayed whenever the bridge is enabled -->
                <!-- If not, the attachment count will be displayed -->
                <field name="document_count" invisible="not documents_bridge_enabled"/>
            </field>
        </field>
    </record>
</odoo>
