<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr_appraisal.AppraisalGoal.buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-if="this.hasSelectedRecords">
                <button type="button" class="btn btn-primary" t-on-click="this.onSelect">
                    <span t-if="this.defaultEmployeeIds?.length">
                        Select
                    </span>
                    <span t-else="">
                        Continue
                    </span>
                </button>
            </t>
            <button type="button" class="btn btn-secondary" t-on-click.stop="this.onClose">Close</button>
        </xpath>
    </t>
</odoo>
