<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Package Types -->
        <record id="shipstation_packaging_box" model="stock.package.type">
            <field name="name">Package</field>
            <field name="shipper_package_code">package</field>
            <field name="package_carrier_type">shipstation</field>
            <field name="packaging_length">300</field>
            <field name="width">300</field>
            <field name="height">250</field>
        </record>

        <!-- ShipStation Delivery Carrier Data -->
        <record id="product_product_delivery_shipstation" model="product.product">
            <field name="name">ShipStation</field>
            <field name="default_code">SHIPSTATION</field>
            <field name="type">service</field>
            <field name="categ_id" ref="delivery.product_category_deliveries"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="taxes_id" eval='[]'/>
        </record>
        <record id="delivery_carrier_shipstation" model="delivery.carrier">
            <field name="name">ShipStation</field>
            <field name="product_id" ref="product_product_delivery_shipstation"/>
            <field name="shipstation_default_package_type_id" ref="shipstation_packaging_box"/>
            <field name="delivery_type">shipstation</field>
        </record>
    </data>
</odoo>
