<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_attribute_value_view_tree_pos_urban_piper" model="ir.ui.view">
        <field name="name">product.template.attribute.value.view.list.pos.urban.piper</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="excluded_value_ids" position="after">
                <field name="urbanpiper_store_ids" options="{'no_create': True}" widget="many2many_tags"/>
                <field name="urbanpiper_meal_type"/>
            </field>
        </field>
    </record>

    <record id="product_template_attribute_value_view_form_pos_urban_piper" model="ir.ui.view">
        <field name="name">product.template.attribute.value.view.form.pos.urban.piper</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="excluded_value_ids" position="after">
                <field name="urbanpiper_store_ids" options="{'no_create': True}" widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>
