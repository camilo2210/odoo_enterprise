<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_urban_piper" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_urban_piper</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='urban_piper_setting']/div" position="replace">
                <div invisible="not pos_module_pos_urban_piper">
                    <div>
                        <label string="Food Delivery Store" for="pos_urbanpiper_store_id" class="col-lg-3 o_light_label"/>
                        <field name="pos_urbanpiper_store_id" placeholder="e.g. Downtown Shop" required="pos_module_pos_urban_piper" 
                            context="{'default_config_id': pos_config_id }" options="{'no_quick_create': True}"/>
                    </div>
                    <div>
                        <button name="action_open_urbanpiper_signup_form" icon="east" type="object" string="Fill this form to get Username and Api key" class="btn-link"/>
                    </div>
                </div>
            </xpath>
            <field name="pos_available_preset_ids" position="attributes">
                <attribute name="domain">[('identification', '!=', 'online')]</attribute>
            </field>
        </field>
    </record>
</odoo>
