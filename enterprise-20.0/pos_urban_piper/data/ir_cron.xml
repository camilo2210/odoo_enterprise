<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <record id="cron_update_urban_piper_webhook_urls" model="ir.cron">
            <field name="name">UrbanPiper: Update Webhook URLs</field>
            <field name="model_id" ref="model_pos_config"/>
            <field name="state">code</field>
            <field name="code">model._trigger_webhooks_refresh_cron()</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=999)).strftime('%Y-%m-%d 00:00:00')"/>
            <field name="interval_number">999</field>  <!-- This cron is used as a background task, should not be run automatically -->
            <field name="interval_type">months</field>
        </record>
    </data>
</odoo>
