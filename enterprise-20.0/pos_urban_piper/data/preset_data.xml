<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="urbanpiper_store_timing" model="resource.calendar">
        <field name="name">Store timing</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="attendance_ids" eval="[(5, 0, 0),
                (0, 0, {'dayofweek': '0', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '1', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '2', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '3', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '4', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '5', 'hour_from': 10, 'hour_to': 18}),
                (0, 0, {'dayofweek': '6', 'hour_from': 10, 'hour_to': 18})
            ]"
        />
    </record>

    <record id="pos_online_preset" model="pos.preset">
        <field name="name">Online Delivery</field>
        <field name="color">1</field>
        <field name="identification">online</field>
        <field name="use_timing">True</field>
        <field name="resource_calendar_id" ref="urbanpiper_store_timing"/>
    </record>
</odoo>
