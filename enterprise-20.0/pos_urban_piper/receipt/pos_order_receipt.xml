<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_urban_piper.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <xpath expr="//tr[hasclass('preset-info')]//td[2]" position="attributes">
                <attribute name="t-if">extra_data.get('preset_datetime') or conditions.get('is_urban_piper_order')</attribute>
            </xpath>
            <xpath expr="//tr[hasclass('preset-info')]//td[2]/strong" position="attributes">
                <attribute name="t-if">not conditions.get('is_urban_piper_order')</attribute>
            </xpath>
            <xpath expr="//tr[hasclass('preset-info')]//td[2]/strong" position="after">
                <strong t-if="conditions.get('is_urban_piper_order')" t-out="extra_data['delivery_provider_name']" style="font-size: 1.2em;"/>
            </xpath>
            <xpath expr="//tr[@name='partner_details']/td" position="attributes">
                <attribute name="t-att-colspan">(conditions.get('is_urban_piper_order') and 1) or 2</attribute>
            </xpath>
            <xpath expr="//tr[@name='partner_details']/td" position="after">
                <td t-if="conditions.get('is_urban_piper_order')" class="text-end text-top" style="padding: 0;">
                    <div>
                        <t t-out="extra_data['ext_platforms_id'][0]"/>
                        <t t-out="extra_data['ext_platforms_id'][1]"/>
                    </div>
                    <span class="text-bold">UrbanPiper</span><br/>
                    <span t-out="order['delivery_identifier']"/>
                </td>
            </xpath>
            <div name="partner_info" position="after">
                <t t-if="conditions.get('is_urban_piper_order')">
                    <div t-if="not preset" class="text-center">
                        <div t-if="extra_data['delivery_provider_name']" class="text-bold" style="font-size: 1.2em;" t-out="extra_data['delivery_provider_name']"/>
                        <div>
                            <t t-out="extra_data['ext_platforms_id'][0]"/>
                            <t t-out="extra_data['ext_platforms_id'][1]"/>
                        </div>
                        <span class="text-bold">UrbanPiper</span><br/>
                        <span t-out="order['delivery_identifier']"/>
                    </div>
                    <div t-if="extra_data.get('is_instant_order')">
                        <span>Quick Order</span>
                    </div>
                    <div t-if="extra_data.get('delivery_otp')" class="w-100 text-center mt-2">
                        Delivery OTP : <b><t t-out="extra_data['delivery_otp']"/></b>
                    </div>
                </t>
            </div>
        </template>
    </data>
</odoo>
