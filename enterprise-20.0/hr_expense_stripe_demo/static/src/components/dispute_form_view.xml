<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr.expense.stripe.demo.disputeCreationConfirmationDialog"
       t-inherit="web.ConfirmationDialog"
       t-inherit-mode="primary">
        <xpath expr="//button[hasclass('btn-secondary')]" position="before">
            <button type="button" class="btn btn-primary" t-on-click="this.submit_and_win">
                Submit and Win
            </button>
            <button type="button" class="btn btn-primary" t-on-click="this.submit_and_lose">
                Submit and Lose
            </button>
        </xpath>
    </t>
</templates>
