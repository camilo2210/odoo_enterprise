<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_work_entry_type_view_form" model="ir.ui.view">
        <field name="name">hr.work.entry.type.view.form.inherit.l10n.lu.hr.payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="l10n_lu_hr_payroll" string="Luxembourg"
                        invisible="country_code and country_code != 'LU'">
                    <field name="l10n_lu_seculine_code" string="SECULine Code"
                        help="Enter the seculine code for the type of incapacity: &#10;
                            1 = Sick leave &#10;
                            2 = Family Reason Time Off &#10;
                            3 = Maternity leave &#10;
                            4 = Welcome leave &#10;
                            5 = Caring leave"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
