<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_abandoned_cart_search" model="ir.ui.view">
        <field name="name">sale.order.ecommerce.abandoned.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="website_sale.sale_order_abandoned_cart_search"/>
        <field name="arch" type="xml">
            <filter name="recovery_email" position="replace">
                <filter string="Follow-up to send" name="recovery_email" domain="['&amp;', ('cart_recovery_email_sent', '=', False), ('cart_recovery_whatsapp_sent', '=', False)]" />
            </filter>
            <filter name="recovery_email_set" position="replace">
                <filter string="Follow-up Sent" name="recovery_email_set" domain="['|', ('cart_recovery_email_sent', '=', True), ('cart_recovery_whatsapp_sent', '=', True)]" />
            </filter>
        </field>
    </record>
</odoo>
