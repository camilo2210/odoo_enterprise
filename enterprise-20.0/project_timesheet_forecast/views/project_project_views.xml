<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_timesheet_forecast_form" model="ir.ui.view">
        <field name="name">Inherit project form for project_timesheet_forecast</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">24</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_project_timesheets']" position="attributes">
                <attribute name="groups">planning.group_planning_user</attribute>
            </xpath>
        </field>
    </record>
</odoo>
