<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_company_kw" model="res.partner" forcecreate="1">
        <field name="name">My Kuwaiti Company</field>
        <field name="street">15 Mubarak Al-Kabeer Street</field>
        <field name="zip">15458</field>
        <field name="city">Kuwait City</field>
        <field name="country_id" ref="base.kw"/>
        <field name="phone">+965 2244 5566</field>
        <field name="email">info@mykuwaiticompany.kw</field>
        <field name="is_company">True</field>
    </record>

    <record id="base.demo_company_kw" model="res.company" forcecreate="1">
        <field name="name">My Kuwaiti Company</field>
        <field name="partner_id" ref="base.partner_company_kw"/>
        <field name="country_id" ref="base.kw"/>
        <field name="currency_id" ref="base.KWD"/>
        <field name="resource_calendar_id" ref="l10n_kw_hr_payroll.l10n_kw_resource_calendar_std_40h"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_kw'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_kw'))]"/>
    </record>

    <record id="kw_hr_job_marketing_manager" model="hr.job">
        <field name="name">Marketing Manager KW</field>
    </record>

    <record id="kw_hr_job_accounting_manager" model="hr.job">
        <field name="name">Accounting Manager KW</field>
    </record>

    <record id="kw_hr_department_marketing" model="hr.department">
        <field name="name">Marketing KW</field>
        <field name="company_id" ref="base.demo_company_kw"/>
    </record>

    <record id="kw_hr_department_administration" model="hr.department">
        <field name="name">Admin KW</field>
        <field name="company_id" ref="base.demo_company_kw"/>
    </record>

    <record id="res_partner_qasim" model="res.partner">
        <field name="name">Qasim Nasser</field>
        <field name="street">Block 3, Street 12, Hawally</field>
        <field name="city">Kuwait City</field>
        <field name="zip">13001</field>
        <field name="country_id" ref="base.kw"/>
        <field name="phone">+965 5551 2234</field>
        <field name="email">qasim.nasser@example.kw</field>
        <field name="company_id" ref="base.demo_company_kw"/>
    </record>

    <record id="res_partner_munira" model="res.partner">
        <field name="name">Munira Abdulaziz</field>
        <field name="street">Block 6, Avenue 10, Salmiya</field>
        <field name="city">Kuwait City</field>
        <field name="zip">20003</field>
        <field name="country_id" ref="base.kw"/>
        <field name="phone">+965 5559 4477</field>
        <field name="email">munira.abdulaziz@example.kw</field>
        <field name="company_id" ref="base.demo_company_kw"/>
    </record>

    <record id="hr_employee_qasim" model="hr.employee">
        <field name="name" model="res.partner" eval="obj(ref('res_partner_qasim')).name"/>
        <field name="image_1920" type="base64" file="hr/static/img/employee_jgo-image.webp"/>
        <field name="work_phone">+965 2244 5566</field>
        <field name="work_email" model="res.partner" eval="obj(ref('res_partner_qasim')).name.replace(' ', '.').lower() + '@mykuwaiticompany.kw'"/>
        <field name="work_contact_id" ref="base.partner_company_kw"/>
        <field name="company_id" ref="base.demo_company_kw"/>
        <field name="tz">Asia/Kuwait</field>

        <field name="private_street" model="res.partner" eval="obj(ref('res_partner_qasim')).street"/>
        <field name="private_city" model="res.partner" eval="obj(ref('res_partner_qasim')).city"/>
        <field name="private_zip" model="res.partner" eval="obj(ref('res_partner_qasim')).zip"/>
        <field name="private_country_id" model="res.partner" eval="obj(ref('res_partner_qasim')).country_id"/>
        <field name="private_phone" model="res.partner" eval="obj(ref('res_partner_qasim')).phone"/>
        <field name="private_email" model="res.partner" eval="obj(ref('res_partner_qasim')).email"/>

        <field name="distance_home_work">8</field>
        <field name="distance_home_work_unit">miles</field>
        <field name="country_id" ref="base.kw"/>
        <field name="identification_id">286041512345</field>
        <field name="sex">male</field>
        <field name="birthday" eval="datetime(1986, 4, 15).date()"/>
        <field name="place_of_birth">Kuwait City</field>
        <field name="country_of_birth" ref="base.kw"/>
        <field name="emergency_contact">Fahad Nasser</field>
        <field name="emergency_phone">+965 5566 7788</field>
        <field name="certificate">bachelor</field>
        <field name="study_field">Marketing</field>
        <field name="marital">married</field>

        <field name="address_id" ref="base.partner_company_kw"/>
        <field name="job_id" ref="kw_hr_job_marketing_manager"/>
        <field name="department_id" ref="kw_hr_department_marketing"/>
        <field name="structure_type_id" ref="l10n_kw_employee"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage_type">monthly</field>
        <field name="wage">1550</field>
        <field name="hr_responsible_id" ref="base.user_admin"/>
        <field name="resource_calendar_id" ref="l10n_kw_hr_payroll.l10n_kw_resource_calendar_std_40h"/>
        <field name="contract_date_start" eval="datetime(2020, 12, 21).date()"/>
    </record>

