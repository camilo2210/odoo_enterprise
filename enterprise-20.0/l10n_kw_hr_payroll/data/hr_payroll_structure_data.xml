<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_kw_monthly_pay" model="hr.payroll.structure">
        <field name="name">Kuwait: Monthly Pay</field>
        <field name="country_id" ref="base.kw"/>
        <field name="code">KWMONTHLY</field>
        <field name="type_id" ref="l10n_kw_hr_payroll.l10n_kw_employee"/>
        <field name="rule_ids" eval="[]"/>
    </record>

    <record id="l10n_kw_hr_payroll.l10n_kw_employee" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_kw_monthly_pay"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.l10n_kw_work_entry_type_attendance"/>
    </record>
</odoo>
