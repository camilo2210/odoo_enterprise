<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="consumidor_final_customer" model="res.partner">
            <field name="name">Consumidor Final</field>
            <field name="additional_identifiers" eval="{'CO_CC': '222222222222'}"/>
            <field name="l10n_co_edi_fiscal_regimen">49</field>
            <field name="country_id" ref="base.co"/>
            <field name="l10n_co_edi_obligation_type_ids" eval="[(4, ref('obligation_type_5'))]"/>
            <field name="is_company" eval="False"/> <!-- force this user to be considered as an individual -->
        </record>
    </data>
</odoo>
