<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menus -->
    <menuitem
        id="iot_menu_root"
        name="IoT"
        web_icon="iot,static/description/icon.png"
        groups="iot.group_iot_user"
        sequence="265"
    />

    <!-- Client Actions -->
    <record id="action_iot_delete_linked_devices_menu" model="ir.actions.client">
        <field name="name">reset.linked.printers</field>
        <field name="tag">iot_delete_linked_devices_action</field>
    </record>
    <record id="action_discover_iot_boxes" model="ir.actions.client">
        <field name="name">Discover IoT boxes</field>
        <field name="tag">discover_iot_boxes</field>
    </record>
    <record id="action_download_virtual_iot" model="ir.actions.act_url">
        <field name="name">Download Virtual IoT Box</field>
        <field name="url">https://nightly.odoo.com/19.0/nightly/iot/odoo_19.0.latest.exe</field>
        <field name="target">new</field>
    </record>
    <record id="action_download_iot_box_image" model="ir.actions.act_url">
        <field name="name">Download IoT Box Image</field>
        <field name="url">https://nightly.odoo.com/master/iotbox/iotbox-latest.zip</field>
        <field name="target">new</field>
    </record>

    <record id="iot_box_action" model="ir.actions.act_window">
        <field name="name">IoT Boxes</field>
        <field name="path">iot</field>
        <field name="res_model">iot.box</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No IoT Box found!
            </p>
            <p>Click on the connect button to add an IoT Box.</p>
            <a href="https://www.odoo.com/documentation/latest/applications/general/iot.html" target="_blank">Documentation</a>
        </field>
    </record>
    <record id="iot_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="path">iot-devices</field>
        <field name="res_model">iot.device</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No IoT Device found!
            </p>
        </field>
    </record>
    
    <menuitem
        id="iot_box_menu_action"
        action="iot_box_action"
        parent="iot_menu_root"
        sequence="1"/>
    <menuitem
        id="iot_device_menu_action"
        action="iot_device_action"
        parent="iot_menu_root"
        sequence="2"/>
    <menuitem
        id="iot_configuration_menu"
        name="Configuration"
        parent="iot_menu_root"
        sequence="3"/>

    <!-- Reporting submenu -->
    <menuitem
        id="iot_configuration_menu_reporting_section"
        name="Reporting"
        parent="iot_configuration_menu"
        sequence="40"/>
    <menuitem
        id="manage_printers_action"
        name="Manage Printers"
        sequence="41"
        parent="iot_configuration_menu_reporting_section"
        action="printer.manage_printers_action"/>
    <menuitem
        id="iot_clear_selected_devices"
        name="Reset Linked Printers"
        sequence="42"
        parent="iot_configuration_menu_reporting_section"
        action="printer.action_reset_linked_printers"/>

    <!-- Useful links submenu -->
    <menuitem
        id="iot_configuration_menu_links_section"
        name="Useful links"
        parent="iot_configuration_menu"
        sequence="50"
        groups="base.group_no_one"/>
    <menuitem
        id="iot_download_iot_box_image_menu"
        name="IoT Box Image"
        sequence="51"
        parent="iot_configuration_menu_links_section"
        action="iot.action_download_iot_box_image"/>
    <menuitem
        id="iot_download_virtual_iot_box_installer_menu"
        name="Windows IoT Box Installer"
        sequence="52"
        parent="iot_configuration_menu_links_section"
        action="iot.action_download_virtual_iot"/>
</odoo>
