#. module: hr_contract_salary
#: model:mail.template,body_html:hr_contract_salary.mail_template_send_offer
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <h2>Congratulations!</h2>\n"
"                You can configure your salary package by clicking on the "
"link below.<br/>\n"
"                <t t-if=\"ctx.get('validity_end')\">\n"
"                    The link will expire on <t t-"
"out=\"ctx.get('validity_end')\"/>.\n"
"                </t>\n"
"                <div style=\"padding: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"'/salary_package/simulation/offer/%s%s' "
"% "
"(                             ctx.get('offer_id'),                             "
"('?token=' + ctx.get('access_token')) if ctx.get('access_token') else "
"''                         )\" target=\"_blank\" t-attf-style=\"background-"
"color: {{object.company_id.email_secondary_color or '#875A7B'}}; text-"
"decoration: none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}}; padding: 8px 16px 8px 16px; border-radius: 5px;\">\n"
"                        Configure your package\n"
"                    </a>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <h2>Congratulazioni!</h2>\n"
"                Puoi configurare il tuo pacchetto retributivo facendo clic "
"sul link in basso.<br/>\n"
"                <t t-if=\"ctx.get('validity_end')\">\n"
"                    Il link scadrà il <t t-out=\"ctx.get('validity_end')\"/>"
".\n"
"                </t>\n"
"                <div style=\"padding: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"'/salary_package/simulation/offer/%s%s' "
"% (                             ctx.get('offer_id')"
",                             ('?token=' + ctx.get('access_token')) if "
"ctx.get('access_token') else ''                         )\" "
"target=\"_blank\" t-attf-style=\"background-color: {"
"{object.company_id.email_secondary_color or '#875A7B'}}; text-decoration: "
"none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; "
"padding: 8px 16px 8px 16px; border-radius: 5px;\">\n"
"                        Configura il tuo pacchetto\n"
"                    </a>\n"
"                </div>\n"
"            </div>\n"
"        "

#. module: hr_contract_salary
#: model:mail.template,body_html:hr_contract_salary.mail_template_send_offer_applicant
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <h2>Congratulations, <t t-"
"out=\"object.applicant_id.partner_name\"/>!</h2>\n"
"                We are delighted to extend an offer for you to join <t t-"
"out=\"object.company_id.name\"/>.<br/>\n"
"                We were thoroughly impressed with your background and can't "
"wait to welcome you to the team.<br/><br/>\n"
"                The next step is to customize your remuneration components, "
"extra-legal benefits, and mobility choices through our interactive portal:\n"
"                <t t-if=\"ctx.get('validity_end')\">\n"
"                    The link will expire on <t t-"
"out=\"ctx.get('validity_end')\"/>.\n"
"                </t>\n"
"                <div style=\"padding: 16px 0px 16px 0px;\">\n"
"                    <a t-attf-href=\"/salary_package/simulation/offer/"
"{{ctx.get('offer_id')}}?token={{ctx.get('access_token')}}\" "
"target=\"_blank\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; text-decoration: "
"none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; "
"padding: 8px 16px 8px 16px; border-radius: 5px;\">Configure your package</"
"a>\n"
"                </div>\n"
"                What to expect next:\n"
"                <ul>\n"
"                    <li>Tailor your package preferences in the simulator</"
"li>\n"
"                    <li>Review your generated offer summary</li>\n"
"                    <li>Digitally sign your employment contract</li>\n"
"                </ul>\n"
"                If you have any questions regarding your offer or salary "
"package, don't hesitate to ask us.<br/><br/>\n"
"                Best regards,\n"
"            </div>\n"
"        "
msgstr ""

