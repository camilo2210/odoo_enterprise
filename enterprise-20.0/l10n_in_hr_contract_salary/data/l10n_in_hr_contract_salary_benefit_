         <record id="benefit_time_off_days" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Time Off</field>
            <field name="res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'holidays')])"/>
            <field name="sequence">35</field>
            <field name="benefit_type_id" ref="l10n_in_hr_contract_salary.l10n_in_benefit_in_kind"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">luggage</field>
            <field name="display_type">slider</field>
            <field name="uom">days</field>
            <field name="description">You can choose your paid time off, and the total annual leave entitlement will be automatically adjusted based on your selection.</field>
            <field name="slider_min">0</field>
            <field name="slider_max">24</field>
        </record>

    </data>
</odoo>
