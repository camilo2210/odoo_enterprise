<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="l10n_in_monthly_benefit" model="hr.contract.salary.benefit.type">
            <field name="name">Monthly Benefit in Kind</field>
            <field name="sequence">5</field>
        </record>

        <record id="l10n_in_extra_benefits" model="hr.contract.salary.benefit.type">
            <field name="name">Extra Benefits</field>
            <field name="sequence">10</field>
        </record>

        <record id="l10n_in_benefit_in_kind" model="hr.contract.salary.benefit.type">
            <field name="name">Benefit in Kind</field>
            <field name="sequence">15</field>
        </record>

        <record id="l10n_in_medical_insurance" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Medical Insurance</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_medical_insurance')])"/>
            <field name="sequence">2</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="display_type">radio</field>
            <field name="icon">local_hospital</field>
            <field name="description">
                Employees can opt-in for company provided medical insurance with theoption to extend coverage to their
                spouse and children
            </field>
        </record>

        <record id="l10n_in_medical_insurance_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_medical_insurance"/>
            <field name="name">No</field>
            <field name="value">0</field>
            <field name="selector_highlight">red</field>
            <field name="always_show_description" eval="False"/>
            <field name="sequence">1</field>
        </record>

        <record id="l10n_in_medical_insurance_value_1" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_medical_insurance"/>
            <field name="name">Yes</field>
            <field name="value">1</field>
            <field name="sequence">2</field>
        </record>

        <record id="l10n_in_insured_spouse" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Insured Spouse</field>
            <field name="show_name">False</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_spouse')])"/>
            <field name="sequence">3</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="benefit_ids"  eval="[Command.link(ref('l10n_in_hr_contract_salary.l10n_in_medical_insurance'))]"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="folded" eval="True"/>
            <field name="fold_label">Insured Spouse</field>
            <field name="fold_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_spouse')])"/>
            <field name="display_type">always</field>
            </record>

        <record id="l10n_in_insured_first_child" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">First Children</field>
            <field name="show_name">False</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_first_children')])"/>
            <field name="sequence">4</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="benefit_ids"  eval="[Command.link(ref('l10n_in_hr_contract_salary.l10n_in_medical_insurance'))]"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="folded" eval="True"/>
            <field name="fold_label">First Children</field>
            <field name="fold_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_first_children')])"/>
            <field name="display_type">always</field>
            </record>

        <record id="l10n_in_insured_second_child" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Second Children</field>
            <field name="show_name">False</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_second_children')])"/>
            <field name="sequence">4</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="benefit_ids" eval="[Command.link(ref('l10n_in_hr_contract_salary.l10n_in_medical_insurance'))]"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="folded" eval="True"/>
            <field name="fold_label">Second Children</field>
            <field name="fold_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_insured_second_children')])"/>
            <field name="display_type">always</field>
        </record>

        <record id="l10n_in_phone_subscription" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Phone Subscription</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_phone_subscription')])"/>
            <field name="cost_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_phone_subscription')])"/>
            <field name="sequence">10</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">phone</field>
            <field name="display_type">radio</field>
            <field name="description">
                Choose the phone subscription plan offered to the employee by the company
            </field>
        </record>

        <record id="l10n_in_phone_subscription_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_phone_subscription"/>
            <field name="name">No</field>
            <field name="value">0</field>
            <field name="selector_highlight">red</field>
            <field name="always_show_description" eval="False"/>
        </record>

        <record id="l10n_in_phone_subscription_value_1" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_phone_subscription"/>
            <field name="name">Yes</field>
            <field name="value">1</field>
        </record>

        <record id="l10n_in_internet_subscription" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Internet Subscription</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_internet_subscription')])"/>
            <field name="cost_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_internet_subscription')])"/>
            <field name="sequence">12</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">public</field>
            <field name="display_type">radio</field>
            <field name="description">
                Choose the internet subscription plan offered to the employee by the company
            </field>
        </record>

        <record id="l10n_in_internet_subscription_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_internet_subscription"/>
            <field name="name">No</field>
            <field name="value">0</field>
            <field name="selector_highlight">red</field>
            <field name="always_show_description" eval="False"/>
        </record>

        <record id="l10n_in_internet_subscription_value_1" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_internet_subscription"/>
            <field name="name">Yes</field>
            <field name="value">1</field>
        </record>

        <record id="l10n_in_meal_vouchers" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Meal Vouchers</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_meal_voucher_amount')])"/>
            <field name="cost_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_meal_voucher_amount')])"/>
            <field name="sequence">14</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">restaurant</field>
            <field name="display_type">radio</field>
            <field name="description">
                Choose the meal voucher offered by the company to the employee
            </field>
        </record>

        <record id="l10n_in_meal_vouchers_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_meal_vouchers"/>
            <field name="name">No</field>
            <field name="value">0</field>
            <field name="selector_highlight">red</field>
            <field name="always_show_description" eval="False"/>
