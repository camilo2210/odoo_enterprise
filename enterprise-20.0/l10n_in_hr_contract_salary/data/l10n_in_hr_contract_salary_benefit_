        <record id="l10n_in_company_transport" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Company Transport</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_company_transport')])"/>
            <field name="cost_res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_company_transport')])"/>
            <field name="sequence">16</field>
            <field name="benefit_type_id" ref="l10n_in_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">directions_car</field>
            <field name="display_type">radio</field>
            <field name="description">
                Choose company transport  to avail this benefit offered by the company to the employee
            </field>
        </record>

        <record id="l10n_in_company_transport_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_company_transport"/>
            <field name="name">No</field>
            <field name="value">0</field>
            <field name="selector_highlight">red</field>
