        <record id="l10n_in_provident_fund" model="hr.contract.salary.benefit">
            <field name="is_configurable_benefit" eval="True"/>
            <field name="name">Provident Fund</field>
            <field name="res_field_id" model="ir.model.fields"
                eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_in_pf_employee_amount')])"/>
            <field name="sequence">22</field>
            <field name="benefit_type_id" ref="l10n_in_extra_benefits"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="icon">balance</field>
            <field name="display_type">radio</field>
            <field name="description">
                Employees can opt-in for Provident Fund (PF) contribution as per the statutory requirement
            </field>
        </record>

        <record id="l10n_in_provident_fund_value_0" model="hr.contract.salary.benefit.value">
            <field name="benefit_id" ref="l10n_in_provident_fund"/>
            <field name="name">No</field>
