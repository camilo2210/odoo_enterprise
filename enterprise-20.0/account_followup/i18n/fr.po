"                            <t t-if=\"object.partner_bank_id\">\n"
"                                on the account <strong t-"
"out=\"object.partner_bank_id.account_number\"/>\n"
"                            </t>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        </p><p t-"
"if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" "
"style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: "
"none !important; font-weight: 400; background-color: #875A7B; border: 0px "
"solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                        </p>\n"
"                        You will find a copy of the original invoice "
"attached to this email.\n"
"                        <br/>\n"
"                        If you have already sent the payment, please "
"disregard this notice. If you have any questions or concerns, please don't "
"hesitate to reply to this email.\n"
"                        <br/><br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"not "
"is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-"
"quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell "
"Admin</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "
