msgid "'Reminder ' + object.display_name"
msgstr ""

#. module: account_followup
#: model:mail.template,body_html:account_followup.mail_template_invoice_payment_kind_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon "
"Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure "
"Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name "
"or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or "
"''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        This is a kind reminder that invoice\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-"
"out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (with reference: <t t-"
"out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        amounting in <span style=\"font-weight:bold;\" t-"
"out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ "
"143,750.00</span>\n"
"                        from <t t-out=\"object.company_id.name or "
"''\">YourCompany</t> is now overdue.\n"
"                        <br/><br/>\n"
"                        Please remit payment at your earliest convenience\n"
"                        <t t-if=\"object.payment_reference\">\n"
"                            using the following communication for your "
"payment: <strong t-out=\"object.payment_reference or ''\">INV/2021/05/0005</"
"strong>\n"
"                            <t t-if=\"object.partner_bank_id\">\n"
"                                on the account <strong t-"
"out=\"object.partner_bank_id.account_number\"/>\n"
"                            </t>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        </p><p t-"
"if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" "
"style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: "
"none !important; font-weight: 400; background-color: #875A7B; border: 0px "
"solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                        </p>\n"
"                        You will find a copy of the original invoice "
"attached to this email.\n"
"                        <br/>\n"
"                        If you have already sent the payment, please "
"disregard this notice. If you have any questions or concerns, please don't "
"hesitate to reply to this email.\n"
"                        <br/><br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"not "
"is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-"
"quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell "
"Admin</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        عزيزنا\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">براندن "
"فريمان</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure "
"Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name "
"or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">براندن "
"فريمان</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        نود تذكيرك بأن الفاتورة\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-"
"out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (مع المرجع: <t t-out=\"object.invoice_origin or "
"''\">SUB003</t>)\n"
"                        </t>\n"
"                        والتي تبلغ قيمتها <span style=\"font-weight:bold;\" "
"t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ "
"143,750.00</span>\n"
"                        من <t t-out=\"object.company_id.name or "
"''\">YourCompany</t> قد تأخر موعد دفعها.\n"
"                        <br/><br/>\n"
"                        يُرجى تسدسد المبلغ في أقرب وقم ممكن\n"
"                        <t t-if=\"object.payment_reference\">\n"
"                            باسنخدام المعلومات التالية: <strong t-"
"out=\"object.payment_reference or ''\">INV/2021/05/0005</strong>\n"
"                            <t t-if=\"object.partner_bank_id\">\n"
"                                في الحساب <strong t-"
"out=\"object.partner_bank_id.account_number\"/>\n"
"                            </t>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        </p><p t-"
"if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" "
"style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: "
"none !important; font-weight: 400; background-color: #875A7B; border: 0px "
"solid #875A7B; border-radius:3px\">ادفع الآن</a>\n"
"                        </p>\n"
"                        ستجد في المرفقات النسخة الأصلية لهذه الفاتورة.\n"
"                        <br/>\n"
"                        إذا كنت قد أتممت عملية الدفع بالفعل، لا تُلقِ بالاً "
"لهذه الرسالة. إذا كانت لديك أي أسئلة أو استفسارات أخرى، لا تتردد في التواصل "
"معنا عن طريق الرد على هذا البريد الإلكتروني.\n"
"                        <br/><br/>\n"
"                        مع وافر الشكر والتقدير،\n"
"                        <t t-if=\"not "
"is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-"
"quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">ميتشل آدمن</"
"t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "

#. module: account_followup
#: model:mail.template,body_html:account_followup.mail_template_invoice_payment_last_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon "
"Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure "
"Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name "
"or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or "
"''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        This is our third and final reminder regarding the "
"outstanding payment for invoice\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-"
"out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (with reference: <t t-"
"out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        which is now\n"
"                        <t t-if=\"object.invoice_date_due and "
"object.invoice_date_due &lt; datetime.date.today()\">\n"
"                            <t t-out=\"(datetime.date.today() - "
"object.invoice_date_due).days\"/> days\n"
"                        </t>\n"
"                        overdue.\n"
"                        The total amount outstanding is <span style=\"font-"
"weight:bold;\" t-out=\"format_amount(object.amount_residual, "
"object.currency_id) or ''\">$ 143,750.00</span>.\n"
"                        We have sent previous reminders but have not yet "
"received payment or a response.\n"
"                        <br/><br/>\n"
"                        </p><p t-"
"if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" "
"style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: "
"none !important; font-weight: 400; background-color: #875A7B; border: 0px "
"solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                        </p>\n"
"                        Please be advised that your account is now "
"considered delinquent. We urge you to make payment immediately to settle "
"this balance. The original invoice is attached.\n"
"                        <br/><br/>\n"
"                        Please contact us to either confirm your payment or "
"discuss this matter. If we do not receive payment or a response by within 10 "
"days we will be forced to review the status of your account.\n"
"                        <br/><br/>\n"
"                        We hope to resolve this amicably.\n"
"                        <br/><br/>\n"
"                        Sincerely,\n"
"                        <t t-if=\"not "
"is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-"
"quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell "
"Admin</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        عزيزنا\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">براندن "
"فريمان</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure "
"Interior</t>)،\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name "
"or ''\">Azure Interior</t>،\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">براندن "
"فريمان</t>،\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        هذا هو تذكيرنا الثالث والأخير بخصوص المبلغ المستحق "
"الدفع الخاص بالفاتورة\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-"
"out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (مرجع الفاتورة: <t t-out=\"object.invoice_origin "
"or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        والتي أصبحت الآن متأخرة منذ\n"
"                        <t t-if=\"object.invoice_date_due and "
"object.invoice_date_due &lt; datetime.date.today()\">\n"
"                            <t t-out=\"(datetime.date.today() - "
"object.invoice_date_due).days\"/> يوم/أيام.\n"
"                        </t>\n"
"                        \n"
"                        إجمالي المبلغ المستحق <span style=\"font-weight:bold;"
"\" t-out=\"format_amount(object.amount_residual, object.currency_id) or "
"''\">$ 143,750.00</span>.\n"
"                        لقد أرسلنا تذكيرات سابقة، لكننا لم نتلقَ حتى الآن أي "
"دفعة أو ردّاً.\n"
"                        <br/><br/>\n"
"                        </p><p t-"
"if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" "
"style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: "
"none !important; font-weight: 400; background-color: #875A7B; border: 0px "
"solid #875A7B; border-radius:3px\">قم بالدفع الآن</a>\n"
"                        </p>\n"
"                        تنبيه: حسابكم متعثر حالياً. يُرجى إجراء عملية الدفع "
"فوراً لتسوية الرصيد المتبقي. (الفاتورة الأصلية مرفقة).\n"
"                        <br/><br/>\n"
"                        يُرجى التواصل معنا إما لتأكيد عملية الدفع أو لمناقشة "
"هذا الأمر. في حال عدم استلام المبلغ أو عدم الرد خلال 10 أيام، سنكون مضطرين "
"لمراجعة حالة حسابكم.\n"
"                        <br/><br/>\n"
"                        نأمل للوصول إلى حل ودّي لهذا الأمر دون الحاجة لاتخاذ "
"إجراءات أخرى.\n"
"                        <br/><br/>\n"
"                        مع وافر الشكر والتقدير،\n"
"                        <t t-if=\"not "
"is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-"
"quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">ميتشل آدمن</"
"t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "

