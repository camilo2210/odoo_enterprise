#. module: account_followup
#: model:mail.template,body_html:account_followup.demo_followup_email_template_4
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != "
"object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"/> (<t "
"t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,"
"</t>\n"
"                        <br/>\n"
