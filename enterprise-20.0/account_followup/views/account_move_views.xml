<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_tree_reminder_inherit" model="ir.ui.view">
        <field name="name">view.invoice.tree.reminder.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="last_reminder" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_reminder_inherit" model="ir.ui.view">
        <field name="name">view.out.invoice.tree.reminder.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_and_print']" position="after">
                <button name="manual_reminder_action" type="object" string="Send Reminder" groups="account.group_account_basic"/>
            </xpath>
        </field>
    </record>
</odoo>
