<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="stock_barcode.LineUpperButtons" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'o_edit')]" position="before">
            <button t-if="this.env.model.showSubcontractingDetails(this.line)"
                t-on-click="this.showSubcontractingDetails" title="Show subcontract Details"
                class="o_line_button btn" name="show_subcontract_details"
                t-attf-class="btn-{{this.isSelected || this.isComplete ? 'light' : 'secondary'}}">
                <i class="oi" data-icon="account_tree"/>
            </button>
        </xpath>
    </t>

</templates>
