<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Display EC Sales List Report Menu Item -->
        <record model="ir.ui.menu" id="account_reports.menu_action_account_report_sales">
            <field name="active" eval="True"/>
        </record>
    </data>

    <record id="ee_ec_sales_report" model="account.report">
        <field name="name">IC Supply Report (VD)</field>
        <field name="name@et">Ühendusesisese käibe aruanne (VD)</field>
        <field name="country_id" ref="base.ee"/>
        <field name="root_report_id" ref="account_reports.generic_ec_sales_report"/>
        <field name="groupby">partner_id</field>
        <field name="load_more_limit" eval="80"/>
        <field name="search_bar" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_ee_ec_sales_report_handler"/>
        <field name="column_ids">
            <record id="account_financial_report_ec_sales_country" model="account.report.column">
                <field name="name">Country Code</field>
                <field name="name@et">Riigi tunnus</field>
                <field name="expression_label">country_code</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_vat" model="account.report.column">
                <field name="name">VAT Number of Purchaser</field>
                <field name="name@et">Ostja käibemaksukohustuslasena registreerimise number</field>
                <field name="expression_label">vat_number</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_goods" model="account.report.column">
                <field name="name">Taxable Value of Goods</field>
                <field name="name@et">Kaupade maksustatav väärtus</field>
                <field name="expression_label">goods</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_triangular" model="account.report.column">
                <field name="name">Triangular Transaction Value</field>
                <field name="name@et">Kolmnurktehingu väärtus</field>
                <field name="expression_label">triangular</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_services" model="account.report.column">
                <field name="name">Taxable Value of Services</field>
                <field name="name@et">Teenuste maksustatav väärtus</field>
                <field name="expression_label">services</field>
                <field name="sortable" eval="True"/>
            </record>
        </field>
        <field name="line_ids">
            <record id="ee_ec_sales_report_line" model="account.report.line">
                <field name="name">IC Supply Report (VD)</field>
                <field name="name@et">Ühendusesisese käibe aruanne (VD)</field>
                <field name="code">EE_EC</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="ee_ec_sales_report_line_country_code" model="account.report.expression">
                        <field name="label">country_code</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">country_code</field>
                    </record>
                    <record id="ee_ec_sales_report_line_vat_number" model="account.report.expression">
                        <field name="label">vat_number</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">vat_number</field>
                    </record>
                    <record id="ee_ec_sales_report_line_goods" model="account.report.expression">
                        <field name="label">goods</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">goods</field>
                    </record>
                    <record id="ee_ec_sales_report_line_triangular" model="account.report.expression">
                        <field name="label">triangular</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">triangular</field>
                    </record>
                    <record id="ee_ec_sales_report_line_services" model="account.report.expression">
                        <field name="label">services</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">services</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
