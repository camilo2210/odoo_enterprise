        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <group id="invoice_send_settings" position="after">
                <group string="Currency Rates" name="l10n_tr_currency_rate_types" groups="account.group_account_invoice,account.group_account_readonly">
                    <field name="l10n_tr_invoice_currency_rate_type"/>
                    <field name="l10n_tr_bill_currency_rate_type"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
