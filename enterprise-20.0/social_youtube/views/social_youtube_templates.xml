<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="youtube_preview" t-name="Youtube Preview">
        <div class="o_social_preview o_social_youtube_preview bg-white border overflow-hidden">
            <div class="o_social_preview_header mt-3 mb-2 px-3">
                <div class="o_social_preview_author d-flex align-items-center mb-2">
                    <span class="o_social_preview_icon_wrapper d-inline-block overflow-hidden me-2">
                        <img src="/social_youtube/static/src/img/youtube.svg"/>
                    </span>
                    <span class="fw-bold">Your YouTube Channel</span>
                </div>
            </div>
            <a t-attf-href="#{post_link if post_link else '#'}" target="_blank" class="px-3">
                <img class="w-100"
                    src="/social_youtube/static/src/img/youtube_upload_placeholder.png" alt="YouTube Placeholder"/>
            </a>
            <div class="fw-bold mb-2 px-3" t-out="youtube_title"/>
            <div class="text-muted o_social_preview_description pb-3 px-3">
                123 Views • <time t-out="published_date.date()"/>
            </div>
            <div t-if="youtube_description"
                class="o_social_preview_message pb-1 px-3"
                t-out="youtube_description"/>
            <div t-if="youtube_first_comment" class="o_social_comment px-3 py-2 w-100 bg-white">
                <hr class="my-2"/>
                <span>1 Comment</span>
            </div>
        </div>
    </template>
</data>
</odoo>
