<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_settle_due.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='header']/Input" position="before">
             <div t-if="this.props.partner?.overDue and this.props.partner?.useLimit" class="ms-2 me-2 m-0 p-2 alert alert-warning">
                <i class="oi me-1" data-icon="warning"/> Credit limit reached!
            </div>
        </xpath>
    </t>
 </templates>
