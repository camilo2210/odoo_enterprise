<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="CustomDropdownItems">
        <t t-if="this.totalDue gt 0">
            <DropdownItem onSelected="() => this.settleCustomerInvoices()">
                Settle invoices
            </DropdownItem>
        </t>
        <DropdownItem t-if="this.payLaterPaymentExists()" onSelected="() => this.onClickDepositMoney()">
            Deposit money
        </DropdownItem>
    </t>

    <t t-name="pos_settle_due.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-line-balance-mobile')]" position="inside">
            <div
                t-if="this.totalDue"
                class="partner-due badge rounded-2 border py-1 smaller fw-bolder"
                t-att-class="this.totalDue gt 0 ? 'bg-danger-subtle border-danger text-danger': 'bg-success-subtle border-success text-success'"
            >
                <span>
                    <t t-if="this.totalDue gt 0">Due: </t>
                    <t t-else="">Deposit: </t>
                </span>
                <span t-out="this.pos.formatCurrency(Math.abs(this.totalDue))" />
            </div>
        </xpath>
        <xpath expr="//td[hasclass('partner-line-balance')]" position="inside">
            <div t-att-class="{'partner-credit-limit-reached': this.limitReached}" class="partner-due pos-right-align">
                <t t-if="this.totalDue != 0 and this.pos.accessRight.canAccessTotalDue">
                    <span t-if="this.totalDue gt 0">
                        Total due: <t t-out="this.pos.formatCurrency(this.totalDue)"/>
                    </span>
                    <span t-elif="this.totalDue lt 0">
                        Deposited: <t t-out="this.pos.formatCurrency(-this.totalDue)"/>
                    </span>
                </t>
                <span t-if="this.props.partner.useLimit">Credit limit: <t t-out="this.pos.formatCurrency(this.props.partner.creditLimit)"/></span>
            </div>
        </xpath>

        <xpath expr="//DropdownItem[last()]" position="after">
            <t t-call="CustomDropdownItems"/>
        </xpath>
        <xpath expr="//td[hasclass('edit-partner-button-cell')]//DropdownItem[last()]" position="after">
            <t t-call="CustomDropdownItems"/>
        </xpath>
    </t>
 </templates>
