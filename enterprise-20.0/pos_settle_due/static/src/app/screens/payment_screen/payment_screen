<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_settle_due.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-screen-status')]" position="attributes">
            <attribute name="t-att-class">{'d-none': this.hideChange}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-screen-status-mobile')]" position="attributes">
            <attribute name="t-att-class">{'d-none': this.hideChange}</attribute>
        </xpath>
    </t>
    <t t-name="pos_settle_due.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('partner-button')]/span[hasclass('partner-name')]" position="after">
            <i class="oi ms-2 flex-shrink-0" data-icon="warning" t-if="this.currentOrder.getPartner() and this.partner?.overDue and this.partner?.useLimit" />
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]/i[@data-icon='person']" position="attributes">
            <attribute name="class" add="flex-shrink-0" separator=" "/>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]/span[hasclass('partner-name')]" position="attributes">
            <attribute name="class" add="text-truncate" separator=" "/>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute name="t-att-class">
                {
                    'd-flex align-items-baseline' : true,
                    'highlight text-action' : this.highlightPartnerBtn,
                    'btn-warning' : this.partner?.overDue and this.partner?.useLimit,
                }
            </attribute>
        </xpath>
    </t>
    <t t-name="point_of_sale.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-class">
            {
                'disabled': !this.canValidateDeposit
            }
            </attribute>
        </xpath>
    </t>
 </templates>
