#: code:addons/account_sepa_direct_debit/models/account_payment.py:0
msgid ""
"The SEPA Direct Debit mandate associated to the payment has been revoked and "
"cannot be used anymore."
msgstr ""
"SEPA Direct Debit-mandatet tilknyttet betalingen er tilbagekaldt og kan ikke "
"længere anvendes."

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/account_batch_payment.py:0
msgid ""
"The bank needs to be informed at least %(min_days_new)s days in advance for "
"collections related to a new mandate and %(min_days)s days in advance when "
"the mandate is already known by them.\n"
"The minimum collection date must be %(date)s."
msgstr ""
"Banken skal underrettes mindst %(min_days_new)s dage i forvejen for direkte "
"debiteringer vedrørende et nyt mandat og %(min_days)s dage i forvejen, hvis "
"banken allerede kender mandatet.\n"
"Den tidligste dato for direkte debitering skal være %(date)s."

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/res_company.py:0
msgid "The creditor identifier exceeds the maximum length of 35 characters."
msgstr "Kreditor-ID overstiger den maksimale længde på 35 tegn."

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/account_payment.py:0
msgid ""
"The debtor and creditor city name is a compulsary information when "
"generating the SDD XML."
msgstr "Navn på debitor og kreditor er påkrævet, når SDD XML genereres."

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/account_payment.py:0
msgid ""
"The debtor and creditor country is a compulsary information when generating "
"the SDD XML."
msgstr ""
"Det er nødvendigt at angive både debitors og kreditors land for at kunne "
"generere SDD-XML-filen."

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/account_direct_debit_mandate.py:0
msgid ""
"The debtor identifier you specified exceeds the limitation of 35 characters "
"imposed by SEPA regulation"
msgstr ""
"Det Debitor-ID, du har angivet, overskrider SEPA-reguleringens grænse på 35 "
"tegn"

#. module: account_sepa_direct_debit
#: model_terms:ir.ui.view,arch_db:account_sepa_direct_debit.sdd_mandate_form
msgid ""
"The mandate will only be used to pay invoices into the specified time range. "
"If no end date is specified,\n"
"                    you will have to contact us to stop its use. The minimum "
"notification period for creditors\n"
"                    to inform debtors about an upcoming collection is"
msgstr ""
"Mandatet bruges kun til at betale fakturaer inden for den angivne "
"tidsperiode. Hvis der ikke er angivet en slutdato,\n"
"                    skal du kontakte os for at få stoppet brugen. Den "
"korteste frist, en kreditor skal overholde\n"
"                    for at informere en debitor om en kommende debitering, er"

#. module: account_sepa_direct_debit
#. odoo-python
#: code:addons/account_sepa_direct_debit/models/account_payment.py:0
msgid ""
"The payment must be linked to a SEPA Direct Debit mandate in order to "
"generate a Direct Debit XML."
msgstr ""
"Betalingen skal være knyttet til et SEPA Direct Debit-mandat for at kunne "
"generere en direkte XML-debitering."

#. module: account_sepa_direct_debit
#: model_terms:ir.ui.view,arch_db:account_sepa_direct_debit.view_batch_payment_form_inherit
