<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="social.StreamPostCommentsOriginalPost" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_social_original_post_author_image')]" position="inside">
            <img t-if="this.originalPost.instagram_facebook_author_id.raw_value" t-attf-src="https://graph.facebook.com/v17.0/{{ this.originalPost.instagram_facebook_author_id.raw_value }}/picture" alt="Author Image" class="rounded"/>
        </xpath>
        <xpath expr="//div[hasclass('o_social_comments_modal_original_post_content')]" position="inside">
            <div t-if="this.originalPost.media_type.raw_value === 'instagram'"
                 class="o_social_original_post_instagram_stats d-flex justify-content-around">
                <div class="o_social_instagram_likes px-2"
                    t-att-data-post-id="this.originalPost.id.raw_value">
                    <t t-if="this.originalPost.instagram_likes_count.raw_value !== 0">
                        <i class="oi oi-filled me-1" data-icon="favorite" title="Likes"/>
                        <b class="o_social_likes_count mx-1" t-out="this.originalPost.instagram_likes_count.value"/>
                    </t>
                </div>
                <div class="flex-grow-1 d-flex text-muted justify-content-end">
                    <div t-if="this.originalPost.instagram_saved_count.raw_value">
                        <t t-out="this.originalPost.instagram_saved_count.value"/>
                        Save
                    </div>
                    <div t-if="this.originalPost.instagram_views_count.raw_value" class="ms-3">
                        <t t-out="this.originalPost.instagram_views_count.value"/>
                        Views
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
