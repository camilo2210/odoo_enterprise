<templates>
    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension" t-translation="off">
        <xpath expr="//header" position="inside">
            <t t-if="this.env.model.resModel=='mrp.production' and this.state.view === 'barcodeLines' and this.env.model.record.product_id and !this.state.displayByProduct">
                <Header line="this.env.model.record" displayUOM="this.groups.group_uom" openDetails.bind="this.toggleHeaderView"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_barcode_lines_header')]" position="attributes">
             <attribute name="t-if">!this.state.displayByProduct</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_barcode_lines')]" position="after">
            <div t-elif="this.state.view === 'headerProductPage'"> <!-- MRP Header Edit Form View -->
                <View t-props="this.headerFormViewProps"/>
            </div>
            <div t-elif="this.state.view === 'scrapProductPage'"> <!-- Scrap Create Form View -->
                <View t-props="this.scrapViewProps"/>
            </div>
        </xpath>
        <xpath expr="//footer[hasclass('o_action_buttons')]" position="inside">
            <button t-if="this.env.model.displayRegisterByProduct"
                    class="o_by_products btn btn-secondary" t-on-click.prevent.stop="this.openByProductLines">
                Register By-Product
            </button>
        </xpath>
    </t>
</templates>
