<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <xpath expr="//button[@name='decrementButton']" position="before">
            <button t-if="this.line.byProduct and ['lot', 'serial'].includes(this.line.product_id.tracking) and !this.lotName"
                name="generateLotButton"
                t-on-click="() => this.env.model.generateByproductLot(this.line)"
                class="o_line_button btn btn-primary">
                <i class="oi" data-icon="add"/>
            </button>
        </xpath>
    </t>
</templates>
