<?xml version="1.0"?>
<templates>
    <t t-name="voip_ai.TranscriptionStatusBannerField">
        <div t-if="this.banner" class="alert text-center d-flex justify-content-between align-items-center" t-att-class="this.banner.class" role="alert">
            <t t-out="this.banner.text"/>
            <button t-if="this.banner.hasButton" class="btn btn-primary btn-sm" t-on-click="this.onClickTranscribe" t-att-disabled="this.state.loading or this.state.requestSent">
                <t t-if="this.state.loading">
                    <i class="oi oi-spin me-1" data-icon="autorenew"/>Processing...
                </t>
                <t t-elif="this.state.requestSent">
                    <i class="oi me-1" data-icon="check"/>Request Sent
                </t>
                <t t-else="">
                    Request Transcription
                </t>
            </button>
        </div>
    </t>
</templates>
