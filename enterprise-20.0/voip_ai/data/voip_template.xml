<?xml version="1.0"?>
<odoo>
    <data>
        <template id="message_call_transcript_activity_done" inherit_id="voip.message_call_activity_done">
            <xpath expr="//t[@name='recording_label_xpath_target']" position="after">
                <t t-if="call.has_transcript">
                    <i class="oi ms-1 text-muted" data-icon="subtitles" aria-hidden="true"/>
                    <span class="visually-hidden">Transcript available</span>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
