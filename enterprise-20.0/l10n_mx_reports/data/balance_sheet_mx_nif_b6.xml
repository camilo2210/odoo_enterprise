<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="l10n_mx_bs_nif_b6" model="account.report">
        <field name="name">Balance Sheet NIF B-6</field>
        <field name="name@es_419">NIF B-6 Balance General</field>
        <field name="root_report_id" ref="account_reports.balance_sheet"/>
        <field name="availability_condition">coa</field>
        <field name="chart_template">mx</field>
        <field name="country_id" ref="base.mx"/>
        <field name="column_ids">
            <record id="l10n_mx_bs_nif_b6_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_mx_bs_nif_b6_assets" model="account.report.line">
                <field name="name">Assets</field>
                <field name="name@es_419">Activos</field>
                <field name="code">AC</field>
                <field name="aggregation_formula">ACP.balance + ALP.balance</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_mx_bs_nif_b6_current_assets" model="account.report.line">
                        <field name="name">Current Assets</field>
                        <field name="name@es_419">Activos Circulantes</field>
                        <field name="code">ACP</field>
                        <field name="hierarchy_level">1</field>
                        <field name="aggregation_formula">EFE.balance + CXC.balance + IER.balance + INV.balance + AAC.balance</field>
                        <field name="children_ids">
                            <record id="l10n_mx_bs_nif_b6_efe" model="account.report.line">
                                <field name="name">Cash and Cash Equivalents</field>
                                <field name="name@es_419">Efectivo y Equivalentes de Efectivo</field>
                                <field name="code">EFE</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">101 + 102 + 103 + 104</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_cxc" model="account.report.line">
                                <field name="name">Accounts Receivable from Customers</field>
                                <field name="name@es_419">Cuentas por Cobrar a Clientes</field>
                                <field name="code">CXC</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">105 + 106 + 107 + 108</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_ier" model="account.report.line">
                                <field name="name">Taxes, Stimulus, and Short-Term Recoveries</field>
                                <field name="name@es_419">Impuestos, Estímulos y Recuperaciones a Corto Plazo</field>
                                <field name="code">IER</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">110 + 111 + 112 + 113 + 114 + 118 + 119</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_inv" model="account.report.line">
                                <field name="name">Inventories and Related Assets</field>
                                <field name="name@es_419">Inventarios y Activos Relacionados</field>
                                <field name="code">INV</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">115 + 116 + 117</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_aac" model="account.report.line">
                                <field name="name">Advances and Other Short-Term Assets</field>
                                <field name="name@es_419">Anticipos y Otros Activos a Corto Plazo</field>
                                <field name="code">AAC</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">109 + 120 + 121</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_long_term_assets" model="account.report.line">
                        <field name="name">Long-Term Assets</field>
                        <field name="name@es_419">Activos a Largo Plazo</field>
                        <field name="code">ALP</field>
                        <field name="hierarchy_level">1</field>
                        <field name="aggregation_formula">PPE.balance + DAD.balance + ADI.balance + OAL.balance</field>
                        <field name="children_ids">
                            <record id="l10n_mx_bs_nif_b6_ppe" model="account.report.line">
                                <field name="name">Property, Plant and Equipment</field>
                                <field name="name@es_419">Propiedad, Planta y Equipo</field>
                                <field name="code">PPE</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">151 + 152 + 153 + 154 + 155 + 156 + 157 + 158 + 159 + 160 + 161 + 162 + 163 + 164 + 165 + 166 + 167 + 168 + 169 + 170</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_dad" model="account.report.line">
                                <field name="name">Accumulated Depreciation and Impairment of Fixed Assets</field>
                                <field name="name@es_419">Depreciación Acumulada y Deterioro de Activos Fijos</field>
                                <field name="code">DAD</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">171 + 172</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_adi" model="account.report.line">
                                <field name="name">Deferred and Intangible Assets</field>
                                <field name="name@es_419">Activos Diferidos e Intangibles</field>
                                <field name="code">ADI</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">173 + 174 + 175 + 176 + 177 + 178 + 179 + 180 + 181 + 182 + 183</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_oal" model="account.report.line">
                                <field name="name">Other Long-Term Assets</field>
                                <field name="name@es_419">Otros Activos a Largo Plazo</field>
                                <field name="code">OAL</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">184 + 185 + 186 + 187 + 188 + 189 + 190 + 191</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_mx_bs_nif_b6_liabilities" model="account.report.line">
                <field name="name">Liabilities</field>
                <field name="name@es_419">Pasivos</field>
                <field name="code">PA</field>
                <field name="aggregation_formula">PCP.balance + PLP.balance</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_mx_bs_nif_b6_short_term_liabilities" model="account.report.line">
                        <field name="name">Short-Term Liabilities</field>
                        <field name="name@es_419">Pasivos a Corto Plazo</field>
                        <field name="code">PCP</field>
                        <field name="hierarchy_level">1</field>
                        <field name="aggregation_formula">CXP.balance + CAC.balance + IOF.balance + PSI.balance + IMT.balance + OPC.balance</field>
                        <field name="children_ids">
                            <record id="l10n_mx_bs_nif_b6_cxp" model="account.report.line">
                                <field name="name">Suppliers and Accounts Payable</field>
                                <field name="name@es_419">Proveedores y Cuentas por Pagar</field>
                                <field name="code">CXP</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-201 - 202 - 205 - 217</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_cac" model="account.report.line">
                                <field name="name">Advance Payments and Customer Prepayments</field>
                                <field name="name@es_419">Cobros Anticipados y Anticipos de Clientes</field>
                                <field name="code">CAC</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-203 - 206</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_iof" model="account.report.line">
                                <field name="name">Financial Instruments and Obligations</field>
                                <field name="name@es_419">Instrumentos y Obligaciones Financieras</field>
                                <field name="code">IOF</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-204</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_psi" model="account.report.line">
                                <field name="name">Labor Provisions, Social Security and Taxes</field>
                                <field name="name@es_419">Provisiones Laborales, Seguridad Social e Impuestos</field>
                                <field name="code">PSI</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-210 - 211 - 212 - 213 - 214 - 215 - 216</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_imt" model="account.report.line">
                                <field name="name">Taxes Transferred</field>
                                <field name="name@es_419">Impuestos Trasladados</field>
                                <field name="code">IMT</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-207 - 208 - 209</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_opc" model="account.report.line">
                                <field name="name">Other Short-Term Liabilities</field>
                                <field name="name@es_419">Otros Pasivos a Corto Plazo</field>
                                <field name="code">OPC</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-218</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_long_term_liabilities" model="account.report.line">
                        <field name="name">Long-Term Liabilities</field>
                        <field name="name@es_419">Pasivos a Largo Plazo</field>
                        <field name="code">PLP</field>
                        <field name="hierarchy_level">1</field>
                        <field name="aggregation_formula">AXP.balance + CAI.balance + PLD.balance</field>
                        <field name="children_ids">
                            <record id="l10n_mx_bs_nif_b6_axp" model="account.report.line">
                                <field name="name">Creditors and Accounts Payable</field>
                                <field name="name@es_419">Acreedores y Cuentas por Pagar</field>
                                <field name="code">AXP</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-251 - 252</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_cai" model="account.report.line">
                                <field name="name">Advance Payments and Financial Instruments</field>
                                <field name="name@es_419">Cobros Anticipados e Instrumentos Financieros</field>
                                <field name="code">CAI</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-253 - 254</field>
                            </record>
                            <record id="l10n_mx_bs_nif_b6_pld" model="account.report.line">
                                <field name="name">Labor Liabilities, Deferred Liabilities and Other Liabilities</field>
                                <field name="name@es_419">Pasivos Laborales, Diferidos y Otros Pasivos</field>
                                <field name="code">PLD</field>
                                <field name="hierarchy_level">2</field>
                                <field name="groupby">account_id</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="account_codes_formula">-255 - 256 - 257 - 258 - 259 - 260</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_mx_bs_nif_b6_equity" model="account.report.line">
                <field name="name">Equity</field>
                <field name="name@es_419">Capital Contable</field>
                <field name="code">CC</field>
                <field name="aggregation_formula">CCO.balance + PAT.balance + RES.balance + REA.balance + REE.balance + OCC.balance + GOP.balance</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_mx_bs_nif_b6_contributed_capital" model="account.report.line">
                        <field name="name">Contributed Capital</field>
                        <field name="name@es_419">Capital Contribuido</field>
                        <field name="code">CCO</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-301</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_net_worth" model="account.report.line">
                        <field name="name">Net Worth</field>
                        <field name="name@es_419">Patrimonio</field>
                        <field name="code">PAT</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-302</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_reserves" model="account.report.line">
                        <field name="name">Reserves</field>
                        <field name="name@es_419">Reservas</field>
                        <field name="code">RES</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-303</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_cumulative_results" model="account.report.line">
                        <field name="name">Cumulative Results</field>
                        <field name="name@es_419">Resultados Acumulados</field>
                        <field name="code">REA</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-304</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_exercise_result" model="account.report.line">
                        <field name="name">Exercise Result</field>
                        <field name="name@es_419">Resultado del Ejercicio</field>
                        <field name="code">REE</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-305</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_other_capital_accounts" model="account.report.line">
                        <field name="name">Other Capital Accounts</field>
                        <field name="name@es_419">Otras Cuentas de Capital</field>
                        <field name="code">OCC</field>
                        <field name="hierarchy_level">1</field>
                        <field name="groupby">account_id</field>
                        <field name="account_codes_formula">-306</field>
                    </record>
                    <record id="l10n_mx_bs_nif_b6_unalloc_gains_losses" model="account.report.line">
                        <field name="name">Unallocated Gains or Losses</field>
                        <field name="name@es_419">Ganancias o Pérdidas sin Asignar</field>
                        <field name="code">GOP</field>
                        <field name="hierarchy_level">1</field>
                        <field name="aggregation_formula">AC.balance - PA.balance - CCO.balance - PAT.balance - RES.balance - REA.balance - REE.balance - OCC.balance</field>
                    </record>
                </field>
            </record>
            <record id="l10n_mx_bs_nif_b6_total_liabilities_equity" model="account.report.line">
                <field name="name">Total Liabilities and Equity</field>
                <field name="name@es_419">Total Pasivo y Capital</field>
                <field name="code">TPC</field>
                <field name="aggregation_formula">PA.balance + CC.balance</field>
                <field name="hierarchy_level">0</field>
            </record>
        </field>
    </record>
</odoo>
