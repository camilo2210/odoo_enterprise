<odoo>
    <record id="l10n_mx_reports_sat_export_wizard" model="ir.ui.view">
        <field name="name">l10n_mx_reports.sat.export.wizard.form</field>
        <field name="model">l10n_mx_reports.sat.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="submit_type"/>
                    </group>
                </group>

                <footer>
                    <button string="Export" class="oe_highlight" type="object" name="download_sat_action" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
