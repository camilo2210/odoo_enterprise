<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_financial_report_my_bs" model="account.report">
        <field name="name">Balance Sheet</field>
        <field name="root_report_id" ref="account_reports.balance_sheet"/>
        <field name="groupby">account_id</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_hierarchy">by_default</field>
        <field name="country_id" ref="base.my"/>
        <field name="filter_multi_company">selector</field>
        <field name="custom_handler_model_id" ref="account_reports.model_account_balance_sheet_report_handler"/>
        <field name="column_ids">
            <record id="account_financial_report_my_bs_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <!-- Assets -->
            <record id="account_financial_report_my_bs_assets" model="account.report.line">
                <field name="name">Assets</field>
                <field name="code">MY_A</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">MY_CA.balance + MY_NCA.balance</field>
                <field name="children_ids">
                    <record id="account_financial_report_my_bs_nca" model="account.report.line">
                        <field name="name">Non-current Assets</field>
                        <field name="code">MY_NCA</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_my_bs_nca_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', 'in', ['asset_fixed', 'asset_non_current'])]"/>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_my_bs_ca" model="account.report.line">
                        <field name="name">Current Assets</field>
                        <field name="code">MY_CA</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_my_bs_ca_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', 'in', ['asset_current', 'asset_prepayments', 'asset_cash', 'asset_receivable'])]"/>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <!-- Equity And Earnings -->
            <record id="account_financial_report_my_bs_equity_earnings" model="account.report.line">
                <field name="name">Equity</field>
                <field name="code">MY_EQ</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">MY_EQU.balance + MY_RE.balance + MY_OCI_BS.balance</field>
                <field name="children_ids">
                    <record id="account_financial_report_my_bs_equity" model="account.report.line">
                        <field name="name">Share Capital and Reserves</field>
                        <field name="code">MY_EQU</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_my_bs_equity_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[
                                    ('account_id.account_type', '=', 'equity'),
                                    ('account_id.tag_ids', 'not in', [ref('l10n_my.account_tag_oci')]),
                                ]"/>
                                <field name="subformula">-sum</field>
                                <field name="date_scope">from_beginning</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_my_bs_earnings" model="account.report.line">
                        <field name="name">Earnings</field>
                        <field name="code">MY_RE</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="aggregation_formula">MY_CYE.balance + MY_PYE.balance</field>
                        <field name="children_ids">
                            <record id="account_financial_report_my_bs_cye" model="account.report.line">
                                <field name="name">Current year unallocated earnings</field>
                                <field name="code">MY_CYE</field>
                                <field name="hierarchy_level">3</field>
                                <field name="foldability">never_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_my_bs_cye_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[
                                            ('account_id.account_type', 'in', [
                                                'income', 'income_other', 'expense_direct_cost',
                                                'expense', 'expense_depreciation', 'expense_other',
                                                'equity_unaffected',
                                            ]),
                                        ]"/>
                                        <field name="subformula">-sum</field>
                                        <field name="date_scope">from_fiscalyear</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_my_bs_pye" model="account.report.line">
                                <field name="name">Previous years unallocated earnings</field>
                                <field name="code">MY_PYE</field>
                                <field name="hierarchy_level">3</field>
                                <field name="foldability">never_unfolded</field>
                                <field name="expression_ids">
                                    <record id="account_financial_report_my_bs_pye_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[
                                            ('account_id.account_type', 'in', [
                                                'income', 'income_other', 'expense_direct_cost',
                                                'expense', 'expense_depreciation', 'expense_other',
                                                'equity_unaffected',
                                            ]),
                                        ]"/>
                                        <field name="subformula">-sum</field>
                                        <field name="date_scope">to_beginning_of_fiscalyear</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_my_bs_oci" model="account.report.line">
                        <field name="name">Other comprehensive income</field>
                        <field name="code">MY_OCI_BS</field>
                        <field name="hierarchy_level">1</field>
                        <field name="foldability">always_unfolded</field>
                        <field name="hide_if_zero" eval="True"/>
                        <field name="aggregation_formula">MY_CTA.balance + MY_OOCI.balance</field>
                        <field name="children_ids">
                            <record id="account_financial_report_my_bs_cta" model="account.report.line">
                                <field name="name">Cumulative translation adjustments</field>
                                <field name="code">MY_CTA</field>
                                <field name="hierarchy_level">3</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="expression_ids">
                                    <record id="account_financial_report_my_bs_cta_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">custom</field>
                                        <field name="formula">_report_engine_cumulative_translation_adjustment</field>
                                        <field name="subformula">balance</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_financial_report_my_bs_other_oci" model="account.report.line">
                                <field name="name">Other OCI</field>
                                <field name="code">MY_OOCI</field>
                                <field name="hierarchy_level">3</field>
                                <field name="hide_if_zero" eval="True"/>
                                <field name="expression_ids">
                                    <record id="account_financial_report_my_bs_other_oci_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[
                                            ('account_id.account_type', '=', 'equity'),
                                            ('account_id.tag_ids', 'in', [ref('l10n_my.account_tag_oci')]),
                                        ]"/>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <!-- Liabilities -->
            <record id="account_financial_report_my_bs_liabilities" model="account.report.line">
                <field name="name">Liabilities</field>
                <field name="code">MY_L</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">MY_CL.balance + MY_NL.balance</field>
                <field name="children_ids">
                    <record id="account_financial_report_my_bs_cl" model="account.report.line">
                        <field name="name">Current Liabilities</field>
                        <field name="code">MY_CL</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_my_bs_cl_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', 'in', ['liability_current', 'liability_payable', 'liability_credit_card'])]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_my_bs_nl" model="account.report.line">
                        <field name="name">Non-current Liabilities</field>
                        <field name="code">MY_NL</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_my_bs_nl_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'liability_non_current')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <!-- Total Liabilities and Equity -->
            <record id="account_financial_report_my_bs_total" model="account.report.line">
                <field name="name">Total Liabilities and Equity</field>
                <field name="code">MY_LE</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">MY_L.balance + MY_EQ.balance</field>
            </record>
        </field>
    </record>
</odoo>
