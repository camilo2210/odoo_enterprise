<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_gt_libro_report" model="account.report">
        <field name="name">VAT Book</field>
        <field name="name@es_419">Libro de IVA</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.gt"/>
        <field name="availability_condition">country</field>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="only_tax_exigible" eval="False"/>
        <field name="custom_handler_model_id" ref="model_l10n_gt_libro_report_handler"/>
        <field name="column_ids">
            <record id="l10n_gt_libro_col_invoice_date" model="account.report.column">
                <field name="name">Date</field>
                <field name="name@es_419">Fecha</field>
                <field name="sequence">10</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="l10n_gt_libro_col_doc_type" model="account.report.column">
                <field name="name">Doc. Type</field>
                <field name="name@es_419">Tipo Doc.</field>
                <field name="sequence">20</field>
                <field name="expression_label">doc_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_id_type" model="account.report.column">
                <field name="name">Customer ID</field>
                <field name="name@es_419">ID Cliente</field>
                <field name="sequence">30</field>
                <field name="expression_label">id_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_partner_vat" model="account.report.column">
                <field name="name">Customer VAT</field>
                <field name="name@es_419">NIT Cliente</field>
                <field name="sequence">40</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_partner_name" model="account.report.column">
                <field name="name">Customer</field>
                <field name="name@es_419">Cliente</field>
                <field name="sequence">50</field>
                <field name="expression_label">partner_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_transaction_type" model="account.report.column">
                <field name="name">Transaction Type</field>
                <field name="name@es_419">Tipo Transacción</field>
                <field name="sequence">60</field>
                <field name="expression_label">transaction_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_fel_series" model="account.report.column">
                <field name="name">Series</field>
                <field name="name@es_419">Serie</field>
                <field name="sequence">70</field>
                <field name="expression_label">fel_series</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_fel_number" model="account.report.column">
                <field name="name">Number</field>
                <field name="name@es_419">Número</field>
                <field name="sequence">80</field>
                <field name="expression_label">fel_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_taxed_goods" model="account.report.column">
                <field name="name">Goods Taxable</field>
                <field name="name@es_419">Bienes Gravados</field>
                <field name="sequence">90</field>
                <field name="expression_label">taxed_goods</field>
            </record>
            <record id="l10n_gt_libro_col_exempt_goods" model="account.report.column">
                <field name="name">Goods Exempt</field>
                <field name="name@es_419">Bienes Exentos</field>
                <field name="sequence">100</field>
                <field name="expression_label">exempt_goods</field>
            </record>
            <record id="l10n_gt_libro_col_taxed_services" model="account.report.column">
                <field name="name">Services Taxable</field>
                <field name="name@es_419">Servicios Gravados</field>
                <field name="sequence">110</field>
                <field name="expression_label">taxed_services</field>
            </record>
            <record id="l10n_gt_libro_col_exempt_services" model="account.report.column">
                <field name="name">Services Exempt</field>
                <field name="name@es_419">Servicios Exentos</field>
                <field name="sequence">120</field>
                <field name="expression_label">exempt_services</field>
            </record>
            <record id="l10n_gt_libro_col_specific_tax_type" model="account.report.column">
                <field name="name">Specific Tax Type</field>
                <field name="name@es_419">Tipo Imp. Específico</field>
                <field name="sequence">130</field>
                <field name="expression_label">specific_tax_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="l10n_gt_libro_col_specific_tax_subtotal" model="account.report.column">
                <field name="name">Specific Tax Subtotal</field>
                <field name="name@es_419">Subtotal Imp. Específico</field>
                <field name="sequence">140</field>
                <field name="expression_label">specific_tax_subtotal</field>
            </record>
            <record id="l10n_gt_libro_col_specific_tax_amount" model="account.report.column">
                <field name="name">Specific Tax Amount</field>
                <field name="name@es_419">Monto Imp. Específico</field>
                <field name="sequence">150</field>
                <field name="expression_label">specific_tax_amount</field>
            </record>
            <record id="l10n_gt_libro_col_vat_amount" model="account.report.column">
                <field name="name">VAT Total</field>
                <field name="name@es_419">Total IVA</field>
                <field name="sequence">160</field>
                <field name="expression_label">vat_amount</field>
            </record>
            <record id="l10n_gt_libro_col_amount_total" model="account.report.column">
                <field name="name">Document Total</field>
                <field name="name@es_419">Total Documento</field>
                <field name="sequence">170</field>
                <field name="expression_label">amount_total</field>
            </record>
        </field>
    </record>
</odoo>
