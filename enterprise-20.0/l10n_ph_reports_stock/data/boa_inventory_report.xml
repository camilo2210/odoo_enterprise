<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boa_inventory_report" model="account.report">
        <field name="name">Inventory Report</field>
        <field name="country_id" ref="base.ph"/>
        <!-- Fake variant, it's just for grouping under BoA -->
        <field name="root_report_id" ref="l10n_ph_reports.boa_general_journal_report"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_analytic_groupby" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="filter_hierarchy">never</field>
        <field name="default_opening_date_filter">today</field>
        <field name="load_more_limit" eval="80"/>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_ph_boa_inventory_report_handler"/>
        <field name="column_ids">
            <record id="boa_inventory_report_default_code" model="account.report.column">
                <field name="name">Internal Reference</field>
                <field name="expression_label">default_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_inventory_report_qty_available" model="account.report.column">
                <field name="name">Quantity</field>
                <field name="expression_label">qty_available</field>
                <field name="figure_type">float</field>
            </record>
            <record id="boa_inventory_report_uom" model="account.report.column">
                <field name="name">Unit of Measure</field>
                <field name="expression_label">uom</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_inventory_report_cost" model="account.report.column">
                <field name="name">Unit Cost</field>
                <field name="expression_label">avg_cost</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_inventory_report_value" model="account.report.column">
                <field name="name">Total Value</field>
                <field name="expression_label">value</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
