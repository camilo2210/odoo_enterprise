<templates>

    <t t-name="web_studio.ViewEditor.CohortEditorSidebar">
        <InteractiveEditorSidebar>
            <t t-set-slot="view">
                <Property
                    name="'date_start'"
                    type="'selection'"
                    value="this.modelParams.dateStart"
                    childProps="{ choices: this.dateFields }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Start Date Field
                </Property>

                <Property
                    name="'date_stop'"
                    type="'selection'"
                    value="this.modelParams.dateStop"
                    childProps="{ choices: this.dateFields }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Stop Date Field
                </Property>

                <Property
                    name="'measure'"
                    type="'selection'"
                    value="this.modelParams.measure"
                    childProps="{ choices: this.measureFields, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Measure Field
                </Property>

                <Property
                    name="'interval'"
                    type="'selection'"
                    value="this.modelParams.interval"
                    childProps="{ choices: this.intervalChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Interval
                </Property>

                <Property
                    name="'mode'"
                    type="'selection'"
                    value="this.modelParams.mode || 'retention'"
                    childProps="{ choices: this.modeChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Mode
                </Property>

                <Property
                    name="'timeline'"
                    type="'selection'"
                    value="this.modelParams.timeline || 'forward'"
                    childProps="{ choices: this.timelineChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Timeline
                </Property>

                <SidebarViewToolbox onMore="this.props.openViewInForm" canEditXml="!this.viewEditorModel.isEditingSubview" openDefaultValues="this.props.openDefaultValues" />
            </t>
        </InteractiveEditorSidebar>
    </t>

</templates>
