<templates>

    <t t-name="web_studio.ViewEditor.GanttEditorSidebar">
        <InteractiveEditorSidebar>
            <t t-set-slot="view">
                <Property
                    name="'create'"
                    value="this.modelParams.canCreate === true"
                    type="'boolean'"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Can Create
                </Property>
                <Property
                    name="'edit'"
                    value="this.modelParams.canEdit === true"
                    type="'boolean'"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Can Edit
                </Property>
                <Property
                    name="'display_unavailability'"
                    value="this.modelParams.displayUnavailability === true"
                    type="'boolean'"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Display Unavailability
                </Property>
                <Property
                    name="'total_row'"
                    value="this.modelParams.displayTotalRow === true"
                    type="'boolean'"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Display Total row
                </Property>
                <Property
                    name="'schedule'"
                    value="this.modelParams.canSchedule === true"
                    type="'boolean'"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Scheduling
                </Property>
                <Property
                    name="'date_start'"
                    type="'selection'"
                    value="this.modelParams.dateStartField"
                    childProps="{ choices: this.fieldsDateChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Start Date Field
                </Property>
                <Property
                    name="'date_stop'"
                    type="'selection'"
                    value="this.modelParams.dateStopField"
                    childProps="{ choices: this.fieldsDateChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Stop Date Field
                </Property>
                <Property
                    name="'string'"
                    type="'string'"
                    value="this.modelParams.string"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Label
                </Property>
                <Property
                    name="'default_group_by'"
                    type="'selection'"
                    value="this.viewEditorModel.studioViewProps.defaultGroupBy"
                    childProps="{ choices: this.fieldsChoices, multiSelect: true }"
                    onChange.bind="this.onDefaultGroupByChanged"
                >
                    Default Group by
                </Property>
                <Property
                    name="'display_mode'"
                    type="'selection'"
                    value="this.modelParams.displayMode"
                    childProps="{ choices: this.displayModeChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Display Mode
                </Property>
                <Property
                    name="'default_range'"
                    type="'selection'"
                    value="this.modelParams.defaultRange"
                    childProps="{ choices: this.defaultRangesChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Default Scale
                </Property>
                <Property
                    name="'color'"
                    type="'selection'"
                    value="this.modelParams.colorField"
                    childProps="{ choices: this.colorChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Color
                </Property>
                <Property
                    name="'precision_day'"
                    type="'selection'"
                    value="this.currentDayPrecision"
                    childProps="{ choices: this.dayPrecisionChoices }"
                    onChange.bind="(value) => this.onPrecisionChanged(value, 'day')"
                >
                    Day Precision
                </Property>
                <Property
                    name="'precision_week'"
                    type="'selection'"
                    value="this.currentWeekPrecision"
                    childProps="{ choices: this.weekAndMonthPrecisionChoices }"
                    onChange.bind="(value) => this.onPrecisionChanged(value, 'week')"
                >
                    Week Precision
                </Property>
                <Property
                    name="'precision_month'"
                    type="'selection'"
                    value="this.currentMonthPrecision"
                    childProps="{ choices: this.weekAndMonthPrecisionChoices }"
                    onChange.bind="(value) => this.onPrecisionChanged(value, 'month')"
                >
                    Month Precision
                </Property>
                <Property
                    name="'buffer_start'"
                    type="'selection'"
                    value="this.modelParams.bufferStartField"
                    childProps="{ choices: this.fieldsFloatChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Start Buffer Field
                </Property>
                <Property
                    name="'buffer_stop'"
                    type="'selection'"
                    value="this.modelParams.bufferStopField"
                    childProps="{ choices: this.fieldsFloatChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Stop Buffer Field
                </Property>

                <SidebarViewToolbox onMore="this.props.openViewInForm"
                    canEditXml="!this.viewEditorModel.isEditingSubview"
                    openDefaultValues="this.props.openDefaultValues" />
            </t>
        </InteractiveEditorSidebar>
    </t>

</templates>
