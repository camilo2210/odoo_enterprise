<templates>

    <t t-name="web_studio.ViewEditor.CalendarEditorSidebar">
        <InteractiveEditorSidebar>
            <t t-set-slot="view">
                <Property
                    name="'quick_create'"
                    type="'boolean'"
                    value="this.archInfo.quickCreate"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Quick Create
                </Property>

                <Property
                    name="'schedule'"
                    type="'boolean'"
                    value="this.archInfo.canSchedule"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Scheduling
                </Property>

                <Property
                    t-if="this.debugMode.isActive() and this.archInfo.hasQuickCreate"
                    name="'create_name_field'"
                    type="'selection'"
                    value="this.archInfo.fieldMapping.create_name_field"
                    childProps="{ choices: this.quickCreateFields }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Quick Create Field
                </Property>

                <Property
                    name="'date_start'"
                    type="'selection'"
                    value="this.archInfo.fieldMapping.date_start"
                    childProps="{ choices: this.startDateFields }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Start Date Field
                </Property>

                <Property
                    name="'date_stop'"
                    type="'selection'"
                    value="this.archInfo.fieldMapping.date_stop"
                    childProps="{ choices: this.startDateFields, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Stop Date Field
                </Property>

                <Property
                    name="'color'"
                    type="'selection'"
                    value="this.archInfo.fieldMapping.color"
                    childProps="{ choices: this.colorFields, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Color
                </Property>

                <Property
                    name="'all_day'"
                    type="'selection'"
                    value="this.archInfo.fieldMapping.all_day"
                    childProps="{ choices: this.allDayFields, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    All Day
                </Property>

                <Property
                    name="'mode'"
                    type="'selection'"
                    value="this.archInfo.scale"
                    childProps="{ choices: this.modeChoices }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Default Display Mode
                </Property>

                <SidebarViewToolbox onMore="this.props.openViewInForm" canEditXml="!this.viewEditorModel.isEditingSubview" openDefaultValues="this.props.openDefaultValues" />
            </t>
        </InteractiveEditorSidebar>
    </t>

</templates>
