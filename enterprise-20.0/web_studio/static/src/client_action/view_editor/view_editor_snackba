<templates>

    <t t-name="web_studio.ViewEditor.Snackbar">

        <div class="o_web_studio_menu_undo_redo d-flex d-flex-row align-items-center">
            <button class="btn cursor-default text-uppercase text-nowrap o_web_studio_undo" t-attf-class="{{ this.props.operations.canUndo ? 'o_web_studio_active' : '' }}" t-on-click="() => this.props.operations.undo()">
                <i class="oi me-2" data-icon="undo"/>Undo
            </button>

            <div class="align-self-center" />

            <button class="btn cursor-default text-uppercase text-nowrap o_web_studio_redo" t-attf-class="{{ this.props.operations.canRedo ? 'o_web_studio_active' : '' }}" t-on-click="() => this.props.operations.redo()">
                <i class="oi me-2" data-icon="redo"/>Redo
            </button>
        </div>

        <div class="o_web_studio_snackbar mx-2">
            <t t-set="state" t-value="this.props.saveIndicator.state" />
            <span class="fw-bold text-nowrap" t-if="state">
                <t t-if="state ==='loading'"><i class="oi oi-spin me-2" data-icon="autorenew"/>Saving</t>
                <t t-elif="state === 'loaded'"><i class="oi me-2" data-icon="check"/>Saved</t>
                <t t-else=""><i class="oi me-2" data-icon="warning" />Error</t>
            </span>
        </div>

    </t>

</templates>
