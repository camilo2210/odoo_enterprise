<?xml version="1.0" encoding="utf-8"?>
<templates>

  <t t-name="web_studio.NewModelItem">
    <a t-if="this.menus.getCurrentApp()" href="#" class="o_web_create_new_model o_nav_entry" role="button" t-on-click="this.onClick">
      <i class="oi oi-fw" data-icon="add" />New Model
    </a>
  </t>

  <t t-name="web_studio.SimpleNewModelDialog">
    <Dialog size="'sm'" title.translate="Create a new Model" contentClass="'o_web_studio_new_model_modal'" >
      <label class="d-flex gap-2 mt-3 mb-4" t-attf-class="{{ this.state.showValidation and !this.state.modelName ? 'o_web_studio_field_warning': '' }}" >
        <span class="fw-bold flex-shrink-0">Model name</span>
        <input type="text" name="model_name" class="o_input" placeholder.translate="My model" t-model.proxy="this.state.modelName" />
      </label>

      <t t-set-slot="footer">
        <button type="button" class="btn btn-primary confirm_button" t-attf-class="{{ !this.state.modelName ? 'opacity-50' : ''  }}" t-on-click="this.onConfigureModel">Configure Model</button>

        <button type="button" class="btn btn-secondary" t-on-click="this._cancel">Discard</button>
      </t>
    </Dialog>
  </t>

</templates>
