<templates>

    <t t-name="web_studio.AppMenuEditor">
        <a t-if="this.menus.getCurrentApp()" href="#" class="o_web_edit_menu o_nav_entry" role="button" t-on-click="this.onClick">
            <i class="oi oi-fw oi-filled" data-icon="edit" />Edit Menu
        </a>
    </t>

    <t t-name="web_studio.AppMenuEditor.EditMenuDialog">
        <Dialog title.translate="Edit Menu" contentClass="'o-web-studio-appmenu-editor'" size="'md'" >
            <div t-ref="this.rootRef" class="d-flex flex-column gap-3">
                <t t-set="item" t-value="this.mainItem" />
                <div t-if="item" class="w-100">
                    <ul class="oe_menu_editor list-unstyled mb-0" t-att-data-item-id="item.id" t-key="this.state.renderId" t-att-id="item.id">
                        <t t-call="web_studio.InteractiveItemsList.Item" />
                    </ul>
                </div>
                <div class="o_web_studio_edit_menu_desc small align-self-end">
                    <i class="oi oi-filled me-1" data-icon="info"/>Drag a menu to the right to create a sub-menu
                </div>
            </div>

            <t t-set-slot="footer" t-slot-scope="dialog">
                <button type="button" class="btn btn-primary" t-on-click="this.confirm">Confirm</button>

                <button type="button" class="btn btn-secondary" t-on-click="this.cancel">Discard</button>

                <button type="button" class="btn btn-secondary js_add_menu ms-auto" t-on-click="this.onNewMenu">
                    <i class="oi oi-fw oi-filled o_button_icon" data-icon="add_circle" />
                    New Menu
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="web_studio.InteractiveItemsList.Item">
        <li t-att-data-sequence="this.itemSequence" t-attf-class="{{ item.isDraggable ? 'o-draggable': '' }}" t-att-data-item-id="item.id" t-att-id="item.id">
            <div class="input-group mb-1">
                <span class="oi input-group-text bg-view" data-icon="menu" role="img" aria-label="Value of list" title="Value of list" t-attf-class="{{ item.isDraggable ? 'o-draggable-handle' : '' }}" t-attf-style="{{ item.isDraggable ? 'cursor: move;' : '' }}" />
                <span class="form-control o-web-studio-interactive-list-item-label text-truncate" t-out="item.name" />

                <button type="button" class="oi btn btn-secondary o-web-studio-interactive-list-edit-item" data-icon="edit_square" aria-label="Edit selection" data-tooltip="Edit selection" t-on-click="() => this.editItem(item)" />

                <button type="button" t-att-class="{ disabled: !item.isRemovable }"  class="btn btn-secondary oi o-web-studio-interactive-list-remove-item" data-icon="delete" aria-label="Remove selection" data-tooltip="Remove selection" t-on-click="() => this.removeItem(item)" />
            </div>
            <ul class="p-0 ms-5" t-if="item.children">
                <t t-foreach="item.children" t-as="item" t-key="item.id">
                    <t t-call="web_studio.InteractiveItemsList.Item" />
                </t>
            </ul>
        </li>
    </t>
</templates>
