<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.StudioClientAction">
    <div class="o_studio h-100">
        <StudioNavbar />

        <StudioHomeMenu t-if="this.studio.mode === this.studio.MODES.HOME_MENU" apps="this.homeMenuProps.apps" />
        <AppCreator t-elif="this.studio.mode === this.studio.MODES.APP_CREATOR" onNewAppCreated.bind="this.onNewAppCreated"/>
        <Editor t-elif="this.studio.mode === this.studio.MODES.EDITOR" />
    </div>
</t>

</templates>
