<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="notify_approval" technical_usage="mail_post_source">
        <t t-foreach="partner_ids" t-as="partner"><a t-att-href="'/odoo/res.partner/%s' % partner.id" t-att-data-oe-id="partner.id" data-oe-model="res.partner" class="o_mail_redirect" target="_blank">@<t t-out="partner.name"/></a>, </t>
        <span t-if="approved" t-att-title="target_name">
            Approved <i class="oi oi-filled text-success" data-icon="thumb_up"/>
        </span>
        <span t-else="" t-att-title="target_name">
            Rejected <i class="oi oi-filled text-danger" data-icon="thumb_down"/>
        </span>
    </template>
</odoo>
