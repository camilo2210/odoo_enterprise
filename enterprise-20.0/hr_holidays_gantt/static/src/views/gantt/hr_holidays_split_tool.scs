.o_hr_holidays_gantt_pill_split_tool {
    @include o-gantt-zindex(interact);
    [data-icon='content_cut'] {
        position: relative;
        bottom: -5px;
        height: 15px;
        margin: 0 -10px;
        color: $o-black;
        text-shadow: -1px 0 1px $o-white, 0 1px 1px $o-white, 1px 0 1px $o-white, 0 -1px 1px $o-white;
    }
    .o_leave_dashed_cut_line {
        position: relative;
        top: 2px;
        opacity: 0.6;
        border-left: 2px dashed black;
        height: 87%;
        margin: 0 -1.5px;
    }
}
