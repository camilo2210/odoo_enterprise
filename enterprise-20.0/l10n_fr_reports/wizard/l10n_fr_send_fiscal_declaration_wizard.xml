<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="send_fiscal_declaration_wizard" model="ir.ui.view">
        <field name="name">l10n_fr_reports.send.fiscal.declaration.wizard.form</field>
        <field name="model">l10n_fr_reports.send.fiscal.declaration</field>
        <field name="arch" type="xml">
            <form string="Options">
                <sheet>
                    <group>
                        <group string="Configuration">
                            <field name="tax_type" widget="radio"/>
                            <field name="special_circ"/>
                        </group>
                    </group>
                    <group>
                        <group string="Report to send">
                            <div class="d-flex flex-column gap-2" colspan="2">
                                <div>
                                    <field name="send_2033A" class="me-2"/>
                                    <label for="send_2033A"/>
                                </div>
                                <div>
                                    <field name="send_2033B" class="me-2"/>
                                    <label for="send_2033B"/>
                                </div>
                                <div>
                                    <field name="send_2033C" class="me-2"/>
                                    <label for="send_2033C"/>
                                </div>
                                <div>
                                    <field name="send_2033D" class="me-2"/>
                                    <label for="send_2033D"/>
                                </div>
                                <div>
                                    <field name="send_2033E" class="me-2"/>
                                    <label for="send_2033E"/>
                                </div>
                                <div>
                                    <field name="send_2033F" class="me-2"/>
                                    <label for="send_2033F"/>
                                </div>
                                <div>
                                    <field name="send_2033G" class="me-2"/>
                                    <label for="send_2033G"/>
                                </div>
                                <div>
                                    <field name="send_2031" class="me-2"/>
                                    <label for="send_2031"/>
                                </div>
                                <div>
                                    <field name="send_2065" class="me-2"/>
                                    <label for="send_2065"/>
                                </div>
                                <div>
                                    <field name="send_2069" class="me-2"/>
                                    <label for="send_2069"/>
                                </div>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Send Fiscal Declaration" name="action_send_fiscal_declaration" type="object" class="btn-primary" data-hotkey="s"/>
                    <button string="Continue in web declaration mode" name="open_sso_link" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="c"/>
                </footer>
           </form>
        </field>
    </record>
</odoo>
