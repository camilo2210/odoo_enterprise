<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="send_das2_report_wizard" model="ir.ui.view">
        <field name="name">l10n.fr.send.das2.report.wizard.form</field>
        <field name="model">l10n_fr.send.das2.report</field>
        <field name="arch" type="xml">
            <form string="Options">
                <sheet>
                    <group>
                        <field name="year"/>
                        <field name="contact_person"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Send DAS2 Report" name="action_send_das2_report" type="object" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="c"/>
                </footer>
           </form>
        </field>
    </record>
</odoo>
