<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_fr_reports.2033CLineName" t-inherit="account_reports.AccountReportLineNameCustomizable">
        <xpath expr="//td[@data-id='line_name']/t[@data-id='content']" position="replace">
            <t t-if="this.props.line.code?.() === 'add_new_section'">
                <div class="clickable content" role="button" data-id="content" t-on-click="(ev) => this.controller.reportAction(ev, 'action_add_new_section', { line: this.controller.lines[this.props.lineIndex()] })">
                    <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                        name: this.props.line.name,
                        type: () => 'string',
                        maxCharacters: 80,
                    }"/>
                </div>
            </t>
            <t t-elif="this.props.line.code?.()?.includes('l10n_fr_2033_c_iii_immo_parent_section_line_')">
                <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                    name: this.props.line.name,
                    type: () => 'string',
                    maxCharacters: 80,
                }"/>
                <i class="oi btn p-0 muted" data-icon="delete" t-on-click="(ev) => this.controller.reportAction(ev, 'action_remove_section', { line: this.controller.lines[this.props.lineIndex()] }, false, null, true)"/>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
