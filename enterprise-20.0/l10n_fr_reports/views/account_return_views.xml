<odoo>
    <record id="l10n_fr_reports_account_return_kanban_view" model="ir.ui.view">
        <field name="name">l10n_fr_reports.account.return.kanban</field>
        <field name="model">account.return</field>
        <field name="inherit_id" ref="account_reports.account_return_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@role='menu']/a[@name='action_view_entry']" position="after">
                <a string="EDI export" name="action_view_export" class="dropdown-item" type="object" invisible="not l10n_fr_reports_export"/>
            </xpath>
        </field>
    </record>
</odoo>
