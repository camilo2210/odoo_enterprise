<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="l10n_fr_2033_F" model="account.report">
        <field name="name">2033 F</field>
        <field name="name@fr">2033 F</field>
        <field name="custom_handler_model_id" ref="model_l10n_fr_reports_2033_f_report_handler"/>
        <field name="column_ids">
            <record id="l10n_fr_2033_F_balance_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_fr_2033_F_title" model="account.report.line">
                <field name="name">Share capital structure</field>
                <field name="name@fr">Composition du capital social</field>
            </record>
            <record id="l10n_fr_2033_F_1" model="account.report.line">
                <field name="name">Total number of partners or shareholders</field>
                <field name="name@fr">Nombre total de partenaires ou d'actionnaires</field>
                <field name="code">FR_2033_F_905</field>
                <field name="expression_ids">
                    <record id="l10n_fr_2033_F_1_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">FR_2033_F_901.balance + FR_2033_F_903.balance</field>
                        <field name="figure_type">integer</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="l10n_fr_2033_F_1_1" model="account.report.line">
                        <field name="name">Legal Entities</field>
                        <field name="name@fr">Personnes Morales</field>
                        <field name="code">FR_2033_F_901</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_F_1_1_expr" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">integer</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_fr_2033_F_1_2" model="account.report.line">
                        <field name="name">Individuals</field>
                        <field name="name@fr">Personnes Physique</field>
                        <field name="code">FR_2033_F_903</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_F_1_2_expr" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">integer</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_fr_2033_F_2" model="account.report.line">
                <field name="name">Total number of corresponding shares</field>
                <field name="name@fr">Nombre total de parts ou d'actions</field>
                <field name="code">FR_2033_F_906</field>
                <field name="expression_ids">
                    <record id="l10n_fr_2033_F_2_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">FR_2033_F_902.balance + FR_2033_F_904.balance</field>
                        <field name="figure_type">integer</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="l10n_fr_2033_F_2_1" model="account.report.line">
                        <field name="name">Legal Entities</field>
                        <field name="name@fr">Personnes Morales</field>
                        <field name="code">FR_2033_F_902</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_F_2_1_expr" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">integer</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_fr_2033_F_2_2" model="account.report.line">
                        <field name="name">Individuals</field>
                        <field name="name@fr">Personnes Physique</field>
                        <field name="code">FR_2033_F_904</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_F_2_2_expr" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">integer</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_fr_2033_F_3" model="account.report.line">
                <field name="name">I – Capital held by legal entities</field>
                <field name="name@fr">I – Capital détenu par les personnes morales</field>
                <field name="code">FR_2033_F_capital_held_legal_entities</field>
            </record>
            <record id="l10n_fr_2033_F_4" model="account.report.line">
                <field name="name">II – Capital held by individuals</field>
                <field name="name@fr">II – Capital détenu par les personnes physiques</field>
                <field name="code">FR_2033_F_capital_held_individuals</field>
            </record>
        </field>
    </record>
</odoo>
