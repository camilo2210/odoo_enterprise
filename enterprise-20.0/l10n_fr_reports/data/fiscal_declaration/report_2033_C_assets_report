<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="l10n_fr_2033_C_2" model="account.report">
        <field name="name">2033 C - 2</field>
        <field name="name@fr">2033 C - 2</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_fr_reports_2033_c_report_handler"/>
        <field name="column_ids">
            <record id="l10n_fr_2033_C_column_nature" model="account.report.column">
                <field name="name">Asset nature</field>
                <field name="name@fr">Nature de l'actif</field>
                <field name="expression_label">nature</field>
            </record>
            <record id="l10n_fr_2033_C_column_asset_val" model="account.report.column">
                <field name="name">Asset value</field>
                <field name="name@fr">Valeur d'actif</field>
                <field name="expression_label">asset_val</field>
            </record>
            <record id="l10n_fr_2033_C_column_dep" model="account.report.column">
                <field name="name">Depreciation</field>
                <field name="name@fr">Amortissements</field>
                <field name="expression_label">depreciation</field>
            </record>
            <record id="l10n_fr_2033_C_column_res_val" model="account.report.column">
                <field name="name">Residual value</field>
                <field name="name@fr">Valeur résiduelle</field>
                <field name="expression_label">res_val</field>
            </record>
            <record id="l10n_fr_2033_C_column_dispo_price" model="account.report.column">
                <field name="name">Disposal price</field>
                <field name="name@fr">Prix de cession</field>
                <field name="expression_label">disp_price</field>
            </record>
            <record id="l10n_fr_2033_C_column_st" model="account.report.column">
                <field name="name">Capital gain or loss: Short term</field>
                <field name="name@fr">Plus ou moins-values: Court terme</field>
                <field name="expression_label">short_term</field>
            </record>
            <record id="l10n_fr_2033_C_column_lt_19" model="account.report.column">
                <field name="name">Capital gain or loss: Long term - 19%</field>
                <field name="name@fr">Plus ou moins-values: Long terme - 19%</field>
                <field name="expression_label">lt_19</field>
            </record>
            <record id="l10n_fr_2033_C_column_lt_15_or_12_8" model="account.report.column">
                <field name="name">Capital gain or loss: Long term - 15% or 12.8%</field>
                <field name="name@fr">Plus ou moins-values: Long terme - 15% ou 12,8%</field>
                <field name="expression_label">lt_15_or_12_8</field>
            </record>
            <record id="l10n_fr_2033_C_column_lt_0" model="account.report.column">
                <field name="name">Capital gain or loss: Long term - 0%</field>
                <field name="name@fr">Plus ou moins-values: Long terme - 0%</field>
                <field name="expression_label">lt_0</field>
            </record>
        </field>
        <field name="line_ids">
            <record model="account.report.line" id="l10n_fr_2033_c_2_title">
                <field name="name">Fixed Assets – Depreciation – Capital Gains – Capital Losses, part. 2</field>
                <field name="name@fr">Immobilisations – Amortissements – Plus-Values – Moins-Values, part. 2</field>
            </record>
            <record id="l10n_fr_2033_c_iii" model="account.report.line">
                <field name="name">III – Capital Gains &amp; Capital Losses</field>
                <field name="name@fr">III – Plus-Values &amp; Moins-Values</field>
                <field name="code">l10n_fr_2033_c_plus_moins_val</field>
                <field name="children_ids">
                    <record id="l10n_fr_2033_c_iii_01" model="account.report.line">
                        <field name="name">Fixed assets</field>
                        <field name="name@fr">Immobilisations</field>
                        <field name="code">l10n_fr_2033_c_iii_immo</field>
                        <field name="children_ids">
                            <record id="l10n_fr_2033_c_iii_01_02" model="account.report.line">
                                <field name="name">TOTAL</field>
                                <field name="name@fr">TOTAL</field>
                                <field name="code">l10n_fr_2033_c_iii_total</field>
                                <field name="expression_ids">
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_fr_2033_c_iii_02_579" model="account.report.line">
                        <field name="name">Capital gains taxable at 19%</field>
                        <field name="name@fr">Plus-values taxables à 19%</field>
                        <field name="code">l10n_fr_2033_c_iii_579</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_c_iii_02_579_expression" model="account.report.expression">
                                <field name="label">res_val</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">monetary</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_fr_2033_c_iii_03" model="account.report.line">
                        <field name="name">Adjustments</field>
                        <field name="name@fr">Régularisations</field>
                        <field name="code">l10n_fr_2033_c_iii_regul</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_c_iii_03_590" model="account.report.expression">
                                <field name="label">short_term</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">monetary</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_03_583" model="account.report.expression">
                                <field name="label">lt_19</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">monetary</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_03_594" model="account.report.expression">
                                <field name="label">lt_15_or_12_8</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">monetary</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_03_595" model="account.report.expression">
                                <field name="label">lt_0</field>
                                <field name="engine">external</field>
                                <field name="formula">most_recent</field>
                                <field name="date_scope">from_beginning</field>
                                <field name="subformula">editable;rounding=0</field>
                                <field name="figure_type">monetary</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_fr_2033_c_iii_04" model="account.report.line">
                        <field name="name">TOTAL</field>
                        <field name="name@fr">TOTAL</field>
                        <field name="code">l10n_fr_2033_c_iii_total_apres_regul</field>
                        <field name="expression_ids">
                            <record id="l10n_fr_2033_c_iii_04_596" model="account.report.expression">
                                <field name="label">short_term</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">l10n_fr_2033_c_iii_total.short_term + l10n_fr_2033_c_iii_regul.short_term</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_04_585" model="account.report.expression">
                                <field name="label">lt_19</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">l10n_fr_2033_c_iii_total.lt_19 + l10n_fr_2033_c_iii_regul.lt_19</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_04_597" model="account.report.expression">
                                <field name="label">lt_15_or_12_8</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">l10n_fr_2033_c_iii_total.lt_15_or_12_8 + l10n_fr_2033_c_iii_regul.lt_15_or_12_8</field>
                            </record>
                            <record id="l10n_fr_2033_c_iii_04_599" model="account.report.expression">
                                <field name="label">lt_0</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">l10n_fr_2033_c_iii_total.lt_0 + l10n_fr_2033_c_iii_regul.lt_0</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>

