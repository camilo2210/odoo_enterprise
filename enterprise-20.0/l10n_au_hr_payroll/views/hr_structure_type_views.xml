<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_type_view_tree_inherit_l10n_au" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.tree.inherit.l10n.au</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="active" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="hr_payroll_structure_type_view_search_inherit_l10n_au" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.search.inherit.l10n.au</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payroll_structure_type_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.form.inherit</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page name="l10n_au" string=" Default Other Inputs" invisible="country_code != 'AU'">
                        <field name="l10n_au_default_input_type_ids">
                            <list editable="bottom">
                                <field name="name" readonly="1"/>
                                <field name="code" readonly="1"/>
                                <field name="input_default_value"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

</odoo>
