<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payrun_payslip_kanban_card_view" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.kanban</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payrun_payslip_kanban_card_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='net_sum']]" position="after">
                <div class="d-flex flex-column align-items-start" invisible="country_code != 'AU'">
                    <div class="small fw-medium d-flex gap-2 align-items-center">
                        <i class="oi" data-icon="account_balance"/>
                        <span>Super Contributions</span>
                    </div>
                    <div class="fs-6 fw-medium">
                        <field name="l10n_au_total_super_contributions"/>
                    </div>
                </div>
                <div class="d-flex flex-column align-items-start" invisible="country_code != 'AU'">
                    <div class="small fw-medium d-flex gap-2 align-items-center">
                        <i class="oi" data-icon="content_cut"/>
                        <span>Tax Withholding</span>
                    </div>
                    <div class="fs-6 fw-medium">
                        <field name="l10n_au_total_withholding_tax"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
