<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_enterprise.pos_order_change_receipt" inherit_id="point_of_sale.pos_order_change_receipt" primary="True">
        <xpath expr="//div[hasclass('pos-receipt')]" position="after">
            <img t-if="extra_data.prepTicketBarcode" t-att-src="'/report/barcode/Code128/' + extra_data.prepTicketBarcode" class="h-75 w-100 mb-2" alt="Barcode"/>
        </xpath>
    </template>
</odoo>
