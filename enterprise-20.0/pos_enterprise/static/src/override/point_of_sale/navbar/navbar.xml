<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_enterprise.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_burger_menu_buttons')]/t[@t-name='customer_display']" position="after">
            <t t-call="point_of_sale.BurgerDialogMenuButton" 
                dataIcon="this.colorScheme === 'dark' ? 'light_mode' : 'dark_mode'"
                onClick="() => this.toggleColorScheme()"
                btnLabel="this.colorSchemeLabel"
            />
        </xpath>
    </t>

</templates>
