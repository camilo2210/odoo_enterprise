<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="pricer_pricer_tag_view_list" model="ir.ui.view">
        <field name="name">pricer_tag.list</field>
        <field name="model">pricer.tag</field>
        <field name="arch" type="xml">
            <list string="Pricer tag" create="1" delete="1" editable="bottom">
                <field name="name" string="Tag Barcode"/>
                <field name="product_id"/>
                <field name="pricer_store_id"/>
            </list>
        </field>
    </record>

    <!--  Kanban View  -->
    <record id="pricer_pricer_tag_view_kanban" model="ir.ui.view">
        <field name="name">pricer_tag.kanban</field>
        <field name="model">pricer.tag</field>
        <field name="arch" type="xml">
            <kanban group_create="false" sample="1" default_group_by="pricer_store_id" default_order="name">
                <templates>
                    <t t-name="card">
                        <field class="fw-bold" name="name"/>
                        <field class="fs-6" name="product_id"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="pricer_pricer_tag_form_view" model="ir.ui.view">
        <field name="name">pricer_tag.form</field>
        <field name="model">pricer.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h2>Pricer Tag</h2>
                    <br/>
                    <group>
                        <field name="name" string="Barcode"/>
                        <field name="product_id"/>
                        <field name="pricer_store_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Actions -->
    <record model="ir.actions.act_window" id="action_open_pricer_tags">
        <field name="name">Pricer Tags</field>
        <field name="path">pricer-tag</field>
        <field name="res_model">pricer.tag</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No Pricer Tag configured yet!
            </p>
            <p>Click "New" to add a new electronic tag.</p>
            <a href="https://www.odoo.com/documentation/latest/applications/sales/point_of_sale/pricing/electronic_labels.html#pricer-tags" target="_blank">Documentation</a>
        </field>
    </record>
</odoo>
