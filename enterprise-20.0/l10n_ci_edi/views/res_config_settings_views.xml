<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ci_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_ci_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Côte d'Ivoire FNE E-Invoicing"
                       id="l10n_ci_edi_settings"
                       invisible="company_country_code != 'CI'">
                    <setting id="l10n_ci_edi_mode_setting"
                             string="Server Mode"
                             help="Select the FNE environment to connect to."
                             invisible="l10n_ci_edi_company_parent_id">
                        <field name="l10n_ci_edi_server_mode"/>
                    </setting>
                    <setting id="l10n_ci_edi_token_setting"
                             string="API Token"
                             help="Authentication token provided by the DGI for the FNE API."
                             groups="base.group_system"
                             invisible="l10n_ci_edi_company_parent_id">
                        <field name="l10n_ci_edi_fne_api_token" password="True"/>
                    </setting>
                    <div invisible="not l10n_ci_edi_company_parent_id">
                        Please configure the FNE credentials on the root company.
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
