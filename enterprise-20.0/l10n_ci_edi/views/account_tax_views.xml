<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ci_edi_inherit_view_tax_form" model="ir.ui.view">
        <field name="name">l10n.ci.edi.inherit.account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="l10n_ci_edi_tax_code" invisible="country_code != 'CI'"/>
            </xpath>
        </field>
    </record>
</odoo>
