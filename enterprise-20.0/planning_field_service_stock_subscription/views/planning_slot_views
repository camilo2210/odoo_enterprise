<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_view_form" model="ir.ui.view">
        <field name="name">planning.slot.inherit.view.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning_field_service_stock.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_ids']//t[@t-name='card']" position="inside">
                <widget name="web_ribbon" title="Maintained" bg_color="text-bg-success"
                    groups="planning_field_service_stock_subscription.group_field_service_allow_maintenance_contract"
                    invisible="not is_maintained"/>
            </xpath>
        </field>
    </record>
</odoo>
