<odoo>
    <record id="zkteco_transactions_view_list" model="ir.ui.view">
        <field name="name">zkteco.transactions.view.list</field>
        <field name="model">zkteco.transactions</field>
        <field name="arch" type="xml">
            <list string="ZKTeco Transactions" create="0" edit="0" default_order="punch_datetime asc">
                <header>
                    <button name="action_fetch_transactions" string="Fetch" type="object" class="btn-primary" display="always"/>
                    <button name="action_process_attendances" string="Process" type="object" class="btn-primary"/>
                    <button name="action_refetch_transaction" string="Re-Fetch" type="object" class="btn-secondary"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="punch_datetime" string="Punch Time"/>
                <field name="punch_type" string="Type" widget="badge" decoration-success="punch_type == 'check_in'" decoration-warning="punch_type == 'check_out'"/>
                <field name="terminal_id" optional="show"/>
                <field name="attendance_id" optional="show"/>
                <field name="is_processed" string="Processed"/>
                <field name="processing_note" optional="show"/>
                <field name="zkteco_transaction_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="zkteco_transactions_view_form" model="ir.ui.view">
        <field name="name">zkteco.transactions.view.form</field>
        <field name="model">zkteco.transactions</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Transaction" create="0">
                <header>
                    <button name="action_process_attendances" string="Process" type="object" class="oe_highlight" invisible="is_processed or bool(processing_note)"/>
                    <button name="action_refetch_transaction" string="Re-Fetch" type="object" class="btn-secondary" invisible="is_processed or attendance_id"/>
                </header>
                <div class="alert alert-warning" role="alert" invisible="not processing_note">
                    <field name="processing_note" readonly="1" nolabel="1"/>
                </div>
                <sheet>
                    <widget name="web_ribbon" title="Processed" bg_color="text-bg-success" invisible="not is_processed or not attendance_id"/>
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1>
                            <field name="employee_id" widget="many2one_avatar_employee" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Punch Details">
                            <field name="punch_datetime" string="Punch Time" readonly="1"/>
                            <field name="punch_type" string="Type" readonly="is_processed or not manual_punch_type"/>
                            <field name="terminal_id" readonly="1"/>
                            <field name="attendance_id" readonly="1" invisible="not is_processed or not attendance_id"/>
                        </group>
                        <group string="ZKTeco IDs">
                            <field name="zkteco_transaction_id" string="Transaction ID" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zkteco_transactions_view_search" model="ir.ui.view">
        <field name="name">zkteco.transactions.view.search</field>
        <field name="model">zkteco.transactions</field>
        <field name="arch" type="xml">
            <search string="ZKTeco Transactions">
                <field name="employee_id"/>
                <field name="terminal_id"/>
                <separator/>
                <filter string="Processed" name="processed" domain="[('is_processed', '=', True)]"/>
                <filter string="Unprocessed" name="unprocessed" domain="[('is_processed', '=', False)]"/>
                <separator/>
                <filter string="Has Issues" name="has_issues" domain="[('processing_note', '!=', False)]"/>
                <separator/>
                <filter string="Check-in" name="checkin" domain="[('punch_type', '=', 'check_in')]"/>
                <filter string="Check-out" name="checkout" domain="[('punch_type', '=', 'check_out')]"/>
                <separator/>
                <filter string="My Activities" name="my_activities_filter" domain="[('activity_ids.user_id', '=', uid)]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Terminal" name="group_terminal" context="{'group_by': 'terminal_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'punch_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zkteco_transactions_action" model="ir.actions.act_window">
        <field name="name">ZKTeco Transactions</field>
        <field name="res_model">zkteco.transactions</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="view_id" ref="zkteco_transactions_view_list"/>
        <field name="search_view_id" ref="zkteco_transactions_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transactions found
            </p>
            <p>
                Transactions are automatically fetched from the BioTime server via a scheduled action.
            </p>
        </field>
    </record>

    <menuitem
        id="zkteco_transactions_menu"
        name="ZKTeco Transactions"
        parent="hr_attendance.menu_hr_attendance_view_attendances_management"
        action="zkteco_transactions_action"
        sequence="20"/>
</odoo>
