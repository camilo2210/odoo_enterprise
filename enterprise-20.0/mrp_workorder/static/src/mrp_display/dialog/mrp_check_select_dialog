<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.MrpQualityCheckSelectDialog">
        <Dialog size="'md'" title="this.props.title" modalRef="this.modalRef" footer="false" withBodyPadding="false">
            <div class="btn-group-vertical w-100 p-3">
                <t t-foreach="this.checks" t-as="check" t-key="check.id">
                    <li class="btn btn-outline-secondary o_mrp_record_line list-group"
                        t-out="check.display_name"
                        t-on-click="() => this.selectCheck(check)"/>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
