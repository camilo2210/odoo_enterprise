@mixin gantt-decoration-color($color) {
    background-image: linear-gradient($color, $color);
    background-color: lighten($color, 10%);
    &:before {
        content: none;
    }
}
.o_mrp_workorder_gantt {
    .o_gantt_cells .o_gantt_pill.decoration-secondary {
        opacity: 0.2;

        &::before {
            display: none;
        }
    }
    .o_gantt_cells .o_gantt_pill.decoration-info {
        &::before {
            display: none;
        }
    }
}
