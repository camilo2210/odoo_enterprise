<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp_workorder.MRPWorkorderGanttView.Buttons" t-inherit="web_gantt.GanttView.Buttons" t-inherit-mode="primary">

        <button class="o_gantt_button_add btn btn-primary" position="replace">
            <button type="button" class="btn btn-secondary" t-on-click="this.selectOrdersToPlan">
                Plan MO
            </button>
            <button t-if="this.draftProductionIds.length" type="button" class="btn btn-secondary" t-on-click="this.confirmPlanning">
                Confirm Planning
            </button>
        </button>
    </t>

</templates>
