<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="web_grid.Cell">
        <div t-if="this.props.cell()"
            t-attf-class="{{ this.props.classNames }} o_grid_cell o_grid_highlightable position-relative d-flex justify-content-center align-items-center text-800 border"
            t-on-click.synthetic="this.onCellClick"
            t-ref="this.gridCellHook.rootRef"
        >
            <button class="o_grid_search_btn btn btn-sm position-absolute start-0 px-1 opacity-50 opacity-100-hover"
                    t-on-click.synthetic="() => this.gridCellHook.onMagnifierGlassClick()"
            >
                <i class="oi" data-icon="search"/>
            </button>
            <div t-if="this.cell()" class="d-flex w-100 h-100 justify-content-center align-items-center">
                <input t-if="this.props.editMode"
                       t-att-inputmode="this.inputMode"
                       type="text"
                       class="o_input h-100"
                       t-ref="this.inputRef"
                />
                <span t-else="" class="z-1" t-out="this.formattedValue()"/>
            </div>
        </div>
    </t>
</templates>
