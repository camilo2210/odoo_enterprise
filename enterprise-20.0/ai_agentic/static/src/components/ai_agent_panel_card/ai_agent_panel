<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelCard">
        <div class="o_agent_choice_card card shadow-sm cursor-pointer rounded-3 h-100" t-on-click="this.props.onClick">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-3">
                <div class="mb-2">
                    <img t-if="this.props.image" t-att-src="this.props.image" t-att-alt="this.props.title" class="o_agent_choice_card_image"/>
                    <i t-elif="this.props.icon" class="oi o_agent_choice_card_icon" t-att-data-icon="this.props.icon" t-att-title="this.props.title"/>
                </div>
                <h5 class="o_agent_choice_card_title card-title mb-0 text-truncate w-100" t-out="this.props.title" t-att-title="this.props.title"/>
                <p t-if="this.props.description" class="card-text text-muted small mb-0 mt-1" t-out="this.props.description"/>
            </div>
        </div>
    </t>

</templates>
