<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="mail.Discuss" t-inherit-mode="extension">
    <xpath expr="//DiscussContent" position="after">
        <div
            t-if="this.showScopedAgentPanel"
            class="o_ai_agent_panel_container d-flex flex-column flex-shrink-0 h-100 rounded-4 border bg-view d-print-none"
        >
            <AiAgentPanel agent="this.store.discuss.scopedAgent" showAgentActions="true"/>
        </div>
    </xpath>
</t>

</templates>
