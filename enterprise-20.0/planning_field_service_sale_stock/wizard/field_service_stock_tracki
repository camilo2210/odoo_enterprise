<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_service_stock_tracking_line_view_form" model="ir.ui.view">
        <field name="name">field.service.stock.tracking.view.form</field>
        <field name="model">field.service.stock.tracking</field>
        <field name="arch" type="xml">
            <form string="Track Stock">
                <div class="oe_title">
                    <h1><field name="product_id" readonly="1" options="{'no_open': True}"/></h1>
                </div>
                <field name="company_id" invisible="1"/> <!-- company_id is used as default value for tracking_line_ids -->
                <field name="tracking" invisible="1"/> <!-- tracking is used for column_invisible in subtree (to check if it is really needed) -->
                <field name="is_same_warehouse" invisible="1"/> <!-- is_same_warehouse is used for decoration-muted -->
                <field name="tracking_line_ids" context="{'default_product_id': product_id, 'default_company_id': company_id}">
                    <list editable="bottom" decoration-muted="not is_same_warehouse">
                        <field name="lot_id" groups="stock.group_production_lot" context="{'default_product_id': product_id}" readonly="not is_same_warehouse"/>
                        <field name="warehouse_id" column_invisible="parent.is_same_warehouse"/>
                        <field name="quantity" column_invisible="parent.tracking == 'serial'" readonly="not is_same_warehouse"/>
                        <field name="is_same_warehouse" column_invisible="True"/> <!-- is_same_warehouse is used for readonly condition -->
                    </list>
                </field>

                <separator string="Already Delivered" invisible="not tracking_validated_line_ids"/>
                <field name="tracking_validated_line_ids" readonly="1" invisible="not tracking_validated_line_ids">
                    <list>
                        <field name="lot_id" groups="stock.group_production_lot"/>
                        <field name="quantity" column_invisible="parent.tracking == 'serial'"/>
                    </list>
                </field>

                <footer>
                    <button name="generate_lot" string="Validate" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="field_service_stock_tracking_line_line_view_form" model="ir.ui.view">
        <field name="name">field.service.stock.tracking.line.view.form</field>
        <field name="model">field.service.stock.tracking.line</field>
        <field name="arch" type="xml">
            <form string="Track Stock">
                <group>
                    <group>
                        <field name="lot_id" groups="stock.group_production_lot" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

</odoo>
