<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_view_form" model="ir.ui.view">
        <field name="name">planning.slot.inherit.view.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning_field_service_sale_timesheet.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <t groups="planning.group_planning_user">
                    <button class="oe_stat_button" name="action_fsm_pick_up"
                        type="object" icon="local_shipping" invisible="not partner_id or not deliveries_total"
                        groups="planning.group_field_service_allow_material"
                    >
                        <div class="o_stat_info">
                            <span class="o_stat_text d-flex align-items-baseline gap-1">
                                <field name="deliveries_total" widget="statinfo" string="Products" nolabel="1" class="oe_inline"/>
                                <span>Deliveries</span>
                            </span>
                            <span class="o_stat_text d-flex align-items-baseline gap-1">
                                <field name="deliveries_done" widget="statinfo" string="Products" nolabel="1" class="oe_inline"/>
                                <span>Done</span>
                            </span>
                        </div>
                    </button>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
