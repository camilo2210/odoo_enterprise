<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_helpdesk_slides_forum.helpdesk_forums" inherit_id="website_forum.forum_all_all_entries" primary="True">
        <xpath expr="//a[@href='/slides']" position="replace"/>
    </template>

    <template id="website_helpdesk_slides_forum.hide_forum_slides_link" inherit_id="website_slides_forum.forum_all_all_entries">
        <xpath expr="//div[@t-if='_forums == courses_discussions']" position="attributes">
            <attribute name="t-if">_forums == courses_discussions and not hide_forum_slides_link</attribute>
        </xpath>
    </template>
</odoo>
