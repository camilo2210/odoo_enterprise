<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_account_asset_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_project_assets" icon="edit_square" groups="account.group_account_readonly" invisible="assets_count == 0">
                    <field string="Assets" name="assets_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
