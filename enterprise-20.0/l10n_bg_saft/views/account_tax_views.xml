<odoo>
    <data>
        <record id="view_tax_form_inherit_l10n_bg_saft" model="ir.ui.view">
            <field name="name">account.tax.form.inherit.l10n_bg_saft</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form" />
            <field name="arch" type="xml">
                <field name='country_id' position="after">
                    <field name="l10n_bg_saft_tax_code" invisible="company_country_code != 'BG'"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
