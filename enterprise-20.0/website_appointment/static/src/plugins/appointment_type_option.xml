<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_appointment.AppointmentTypeOption">
    <BuilderContext preview="false">
	    <BuilderRow label.translate="Show Time Zone">
	        <BuilderCheckbox action="'appointmentTypeShowTimezone'"/>
	    </BuilderRow>
	    <BuilderRow label.translate="Show Duration">
	        <BuilderCheckbox action="'appointmentTypeShowDuration'"/>
	    </BuilderRow>
	    <BuilderRow label.translate="Show User/Resource Pictures">
	        <BuilderCheckbox action="'appointmentTypeShowAvatars'"/>
	    </BuilderRow>
	    <BuilderRow label.translate="Allow Guests">
	        <BuilderCheckbox action="'appointmentTypeShowAllowGuests'"/>
	    </BuilderRow>
    </BuilderContext>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
	<xpath expr="//t[@id='page_options_hook']" position="after">
		<appointment_type_option
			template="website_appointment.AppointmentTypeOption"
			selector="main:has(.o_wappointment_type_options)"
			title="Appointment Type"
			groups='["website.group_website_designer"]'
			editableOnly="false"/>
	</xpath>
</t>

</templates>
