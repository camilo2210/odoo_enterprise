<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_appointment.AppointmentsOption" t-inherit="website.DynamicSnippetOption">
    <xpath expr="//BuilderRow[*[@id=&quot;'filter_opt'&quot;]]" position="after">
        <t t-call="website_appointment.AppointmentsFilterOption"/>
    </xpath>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//dynamic_snippet_option" position="after">
        <appointments_option selector=".s_appointments:not(.s_appointments_carousel)"/>
    </xpath>
</t>

</templates>
