<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_appointment.WebsiteAppointmentPageOption">
        <BuilderContext action="'websiteConfig'">
            <BuilderRow label.translate="Layout">
                <BuilderSelect>
                    <BuilderSelectItem actionParam="{views: []}">List</BuilderSelectItem>
                    <BuilderSelectItem actionParam="{views: ['website_appointment.opt_appointments_index_cards']}">Cards</BuilderSelectItem>
                    <BuilderSelectItem actionParam="{views: ['website_appointment.opt_appointments_index_pictures']}">Pictures</BuilderSelectItem>
                </BuilderSelect>
            </BuilderRow>
        </BuilderContext>
    </t>

    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='page_options_hook']" position="after">
            <website_appointment_page_option
                template="website_appointment.WebsiteAppointmentPageOption"
                selector="main:has(.o_appointment_index)"
                title="Appointments Page"
                groups='["website.group_website_designer"]'
                editableOnly="false"/>
        </xpath>
    </t>

</templates>
