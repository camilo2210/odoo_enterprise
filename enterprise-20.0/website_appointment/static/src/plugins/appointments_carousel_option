<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_appointment.AppointmentsCarouselOption" t-inherit="website.DynamicSnippetCarouselOption">
    <xpath expr="//BuilderRow[*[@id=&quot;'filter_opt'&quot;]]" position="after">
        <t t-call="website_appointment.AppointmentsFilterOption"/>
    </xpath>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//device_visibility_option" position="after">
        <appointments_carousel_option selector=".s_appointments_carousel"/>
    </xpath>
</t>

</templates>
