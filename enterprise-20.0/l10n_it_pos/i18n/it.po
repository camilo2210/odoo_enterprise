#. module: l10n_it_pos
#: model:ir.model.fields,help:l10n_it_pos.field_pos_payment_method__it_payment_code
msgid ""
"0 = Cash\n"
"1 = Check\n"
"2 = Credit or credit card. Credit now interpreted as mixed not paid\n"
"3 = Ticket\n"
"4 = Multiple tickets\n"
"5 = Not paid\n"
"6 = Payment discount"
msgstr ""
"0 = contanti\n"
"1 = assegno\n"
"2 = carta di credito o di debito. Credito ora interpretato come misto non "
"pagato\n"
"3 = voucher\n"
"4 = più voucher\n"
"5 = non pagato\n"
"6 = sconto pagamento"

