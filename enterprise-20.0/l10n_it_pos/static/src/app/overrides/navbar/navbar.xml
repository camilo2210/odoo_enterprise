<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_it_pos.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_burger_menu_buttons')]//t[@t-name='close_register']" position="before">
            <t t-call="point_of_sale.BurgerDialogMenuButton"
                t-if="this.pos.config.company_id.country_id.code === 'IT' and this.debugMode.isActive()"
                dataIcon="'radio_button_checked'"
                onClick="() => this.showRTStatus()"
                btnLabel.translate="RT Status"
            />
        </xpath>
    </t>

</templates>
