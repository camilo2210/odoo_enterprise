<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_printer_it_form" model="ir.ui.view">
        <field name="name">pos.it.config.form.view</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <field name="printer_type" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="printer_ip" position="attributes">
                <attribute name="invisible" separator=" and " add="printer_type != 'it_fiscal_printer'" />
                <attribute name="required" separator=" and " add="printer_type != 'it_fiscal_printer'" />
            </field>
            <field name="use_lna" position="attributes">
                <attribute name="invisible" separator=" and " add="printer_type != 'it_fiscal_printer'" />
                <attribute name="required" separator=" and " add="printer_type != 'it_fiscal_printer'" />
            </field>
        </field>
    </record>
</odoo>
