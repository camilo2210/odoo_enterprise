        <record id="turkey_net_tax_deduction" model="hr.salary.rule">
            <field name="name">Current Month Actual Deducted Tax (Post Exempt)</field>
            <field name="category_ids" eval="[(6, 0, [ref('l10n_tr_hr_payroll.hr_salary_rule_category_tr_net_taxded')])]"/>
            <field name="code">BTNET</field>
            <field name="sequence">135</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
tax_exemption = payslip._rule_parameter('l10n_tr_tax_exempt')
pre_exempt_tax = result_rules['BTAXNET']['total']
post_exempt_tax = max(pre_exempt_tax - tax_exemption, 0.0)
if version.l10n_tr_is_rd_incentive:
    wage = categories['BASIC']
    relief_ceiling = 40 * payslip._rule_parameter('l10n_tr_min_gross_wage')
    relief_tax = pre_exempt_tax
    if wage &gt; relief_ceiling:
        relief_tax = payslip._l10n_tr_get_tax(YTDGROSS + relief_ceiling) - payslip._l10n_tr_get_tax(YTDGROSS)
    relief_rates = {'doctor': 0.95, 'l10n_tr_7_doctorate': 0.95, 'master': 0.90, 'l10n_tr_6_master_degree': 0.90}
    relief_rate = relief_rates.get(employee.certificate, 0.80)
    relief = max(relief_tax - tax_exemption, 0.0) * relief_rate
    result = -max(post_exempt_tax - relief, 0.0)
else:
    result = -post_exempt_tax
            </field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
                ref('l10n_tr_hr_payroll.hr_payroll_structure_type_self_employed_tr'),
            ])]"/>
            <field name="country_id" ref="base.tr"/>
        </record>

