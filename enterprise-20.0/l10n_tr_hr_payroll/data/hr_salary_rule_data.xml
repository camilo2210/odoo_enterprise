        <record id="turkey_annual_leave_provision_salary_rule" model="hr.salary.rule">
            <field name="name">Annual Leave Provision</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP')])]"/>
            <field name="code">ALP</field>
            <field name="sequence">220</field>
            <field name="appears_on_payslip">never</field>
            <field name="amount_select">code</field>
            <field name="condition_select">python</field>
            <field name="condition_python">
first_employee_version_date = payslip.employee_id._get_first_version_date()
result = employee.active and first_employee_version_date and payslip.date_from &gt;= first_employee_version_date + relativedelta(years=1)
            </field>
            <field name="amount_python_compute">
first_employee_version_date = payslip.employee_id._get_first_version_date()
number_of_years_in_work = relativedelta(payslip.date_from, first_employee_version_date).years
if 1 &lt;= number_of_years_in_work &lt;= 5:
    number_of_leave_days = 14
elif 5 &lt; number_of_years_in_work &lt;= 15:
    number_of_leave_days = 20
elif number_of_years_in_work &gt; 15:
    number_of_leave_days = 26
else:
    number_of_leave_days = 0
number_of_working_days = sum(payslip.worked_days_line_ids.mapped('number_of_days'))
result = ((version.wage / number_of_working_days) * number_of_leave_days / 12) if number_of_working_days else 0
            </field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
