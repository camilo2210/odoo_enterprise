        <record id="turkey_net_tax_btaxnet_deduction" model="hr.salary.rule">
            <field name="name">Current Month Actual Deducted Tax (Pre Exempt)</field>
            <field name="category_ids" eval="[(6, 0, [ref('l10n_tr_hr_payroll.hr_salary_rule_category_tr_net_taxded')])]"/>
            <field name="code">BTAXNET</field>
            <field name="sequence">130</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = result_rules['TOTTB']['total'] - result_rules['ACTD']['total']
            </field>
            <field name="appears_on_payslip">never</field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
