        <record id="l10n_tr_hr_payroll_structure_tr_employee_salary_severance_provision_rule" model="hr.salary.rule">
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP')])]"/>
            <field name="name">Severance Provision</field>
            <field name="sequence">157</field>
            <field name="code">SEVPROV</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = not (employee.departure_date and employee.departure_reason_id)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = 0
ceiling_amount = payslip._rule_parameter('l10n_tr_severance_pay_ceiling')
total_number_of_days = (payslip.date_to - payslip.date_from).days + 1
provision_month = version.wage / 12
paid_days = sum(payslip.worked_days_line_ids.filtered(lambda wd: wd.is_paid).mapped('number_of_days'))
if version.has_static_work_entries():
    result = min(provision_month, ceiling_amount)
else:
    result = min(provision_month * (paid_days / total_number_of_days), ceiling_amount)
            </field>
            <field name="appears_on_payslip">never</field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
            ])]"/>
            <field name="country_id" ref="base.tr"/>
        </record>

        <record id="l10n_tr_hr_payroll_structure_tr_employee_salary_severance_pay_rule" model="hr.salary.rule">
            <field name="category_ids" eval="[(6, 0, [ref('l10n_tr_hr_payroll.l10n_tr_category_severance_pay')])]"/>
            <field name="name">Severance Pay</field>
            <field name="sequence">158</field>
            <field name="code">SEVPAY</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.departure_date and employee.departure_reason_id</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
years, months, days = employee._l10n_tr_get_worked_duration()
worked_years = years + (months / 12.0) + (days / 365.0)
if worked_years &lt; 1:
    result = 0
else:
    salary = version.wage
    ceiling_amount = payslip._rule_parameter('l10n_tr_severance_pay_ceiling')
    capped_salary = min(salary, ceiling_amount)
    result = capped_salary * worked_years
            </field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
            ])]"/>
            <field name="country_id" ref="base.tr"/>
        </record>

        <record id="l10n_tr_salary_rule_annual_leave_compensation" model="hr.salary.rule">
            <field name="name">Annual Leave Compensation</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
            <field name="code">ANNUALCOMP</field>
            <field name="sequence">8</field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
                ref('l10n_tr_hr_payroll.hr_payroll_structure_type_self_employed_tr'),
            ])]"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = employee.departure_date and employee.departure_reason_id and employee._l10n_tr_get_annual_remaining_leaves()[employee.id] &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
daily_salary = version.wage / 30
result = daily_salary * employee._l10n_tr_get_annual_remaining_leaves()[employee.id]
            </field>
            <field name="country_id" ref="base.tr"/>
        </record>

        <record id="turkey_stamp_tax_deduction" model="hr.salary.rule">
            <field name="name">Stamp Tax Deduction</field>
            <field name="category_ids" eval="[(6, 0, [ref('l10n_tr_hr_payroll.hr_salary_rule_category_tr_stamp_tax')])]"/>
            <field name="code">STAX</field>
            <field name="sequence">160</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
wage_base = categories['BASIC'] + categories['SEVPAY'] + categories['ANNUALCOMP']
stamp_tax_pcnt = payslip._rule_parameter('l10n_tr_stamp_tax_pcnt')
if version.l10n_tr_is_rd_incentive:
    taxable_wage = max(wage_base - 40 * payslip._rule_parameter('l10n_tr_min_gross_wage'), 0.0)
    result = -taxable_wage * stamp_tax_pcnt
else:
    tax_exemption = payslip._rule_parameter('l10n_tr_stamp_tax_exempt')
    result = -max(wage_base * stamp_tax_pcnt - tax_exemption, 0.0)
            </field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
                ref('l10n_tr_hr_payroll.hr_payroll_structure_type_self_employed_tr'),
            ])]"/>
            <field name="country_id" ref="base.tr"/>
        </record>

        <record id="turkey_tax_deduction_net" model="hr.salary.rule">
            <field name="name">Tax Deduction Net</field>
