        <record id="turkey_ssi_company_contribution" model="hr.salary.rule">
            <field name="name">SSI Company Contribution</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP')])]"/>
            <field name="code">SSICDED</field>
            <field name="sequence">30</field>
            <field name="amount_select">code</field>
            <field name="condition_select">none</field>
            <field name="amount_python_compute">
company_incentive = int(payslip.company_id.l10n_tr_incentive_tier or '0')
base = min(
    max(categories['BASIC'], payslip._rule_parameter('l10n_tr_ssi_base_minimum')),
    payslip._rule_parameter('l10n_tr_ssi_base_ceiling'),
)
company_rate = (
    payslip._rule_parameter('l10n_tr_ssi_company_disability_rate')
    + payslip._rule_parameter('l10n_tr_ssi_company_health_rate')
    + payslip._rule_parameter('l10n_tr_ssi_company_short_term_rate')
    + payslip._rule_parameter('l10n_tr_ssi_company_unemployment_rate')
)
adjusted_rate = max(
    company_rate - company_incentive,
    0.0,
)
result = base
result_rate = adjusted_rate
            </field>
            <field name="appears_on_payslip">never</field>
            <field name="struct_ids" eval="[(6, 0, [
                ref('l10n_tr_hr_payroll.hr_payroll_structure_tr_employee_salary'),
