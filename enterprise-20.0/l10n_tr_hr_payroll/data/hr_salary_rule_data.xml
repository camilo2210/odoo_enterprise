        <record id="turkey_salary_rule_ssie" model="hr.salary.rule">
            <field name="name">SSI Employee Contribution</field>
            <field name="category_ids" eval="[(6, 0, [ref('l10n_tr_hr_payroll.hr_salary_rule_category_tr_ssid')])]"/>
            <field name="code">SSIEDED</field>
            <field name="sequence">10</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
base = min(
    max(categories['BASIC'], payslip._rule_parameter('l10n_tr_ssi_base_minimum')),
    payslip._rule_parameter('l10n_tr_ssi_base_ceiling'),
)
employee_rate = (
    payslip._rule_parameter('l10n_tr_ssi_employee_disability_rate')
    + payslip._rule_parameter('l10n_tr_ssi_employee_health_rate')
    + payslip._rule_parameter('l10n_tr_ssi_employee_short_term_rate')
    + payslip._rule_parameter('l10n_tr_ssi_employee_unemployment_rate')
)
result = -base
result_rate = employee_rate
            </field>
