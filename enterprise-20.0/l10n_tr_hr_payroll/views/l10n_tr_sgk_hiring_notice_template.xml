<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="l10n_tr_sgk_hiring_notice_template">
            <SGK4AISEGIRIS>
                <ISYERI
                    t-att-ISYERISICIL="company.l10n_tr_sgk_workspace_registration_no"
                    t-att-ISYERIARACINO="company.l10n_tr_sgk_intermediary_code"
                    t-att-ISYERIUNVAN="company.name"
                    t-att-NAKILGELDIGIISYERISICIL="former_sgk_number"
                    t-att-ISYERIADRES="company.partner_id._display_address().replace('\n', ', ')"
                />
                <SIGORTALILAR>
                    <t t-foreach="employees" t-as="employee">
                        <SIGORTALI
                            t-att-TCKNO="employee.identification_id"
                            t-att-AD="employee.l10n_tr_first_name"
                            t-att-SOYAD="employee.l10n_tr_last_name"
                            t-att-ISEGIRISTARIHI="employee._get_first_version_date().strftime('%Y-%m-%d')"
                            t-att-SIGORTAKOLU="employee.l10n_tr_insurance_type"
                            t-att-OZURLUKODU="'E' if employee.disabled else 'H'"
                            t-att-ESKIHUKUMLU="'E' if employee.l10n_tr_is_ex_convict else 'H'"
                            t-att-OGRENIMKODU="employee._l10n_tr_get_certificate_report_value()"
                            t-att-MEZUNIYETYILI="employee.l10n_tr_graduation_year"
                            t-att-MEZUNIYETBOLUMU="employee.study_field"
                            t-att-CSGBISKOLU="employee.l10n_tr_labour_sector"
                            t-att-MESLEKKODU="employee.l10n_tr_occupational_code"
                            t-att-GOREVKODU="employee.l10n_tr_job_code"
                        />
                    </t>
                </SIGORTALILAR>
            </SGK4AISEGIRIS>
        </template>
    </data>
</odoo>
