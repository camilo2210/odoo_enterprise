<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_tree_inherit_l10n_tr_hr_payroll" model="ir.ui.view">
        <field name="name">view.hr.payslip.list.inherit.l10n_tr_hr_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="l10n_tr_payment_type_code" invisible="country_code != 'TR'" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_form_inherit_l10n_tr_hr_payroll" model="ir.ui.view">
        <field name="name">view.hr.payslip.form.inherit.l10n_tr_hr_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="inside">
                <field name="l10n_tr_payment_type_code" invisible="country_code != 'TR'"/>
                <field name="l10n_tr_document_nature" invisible="country_code != 'TR'"/>
            </xpath>
        </field>
    </record>
</odoo>
