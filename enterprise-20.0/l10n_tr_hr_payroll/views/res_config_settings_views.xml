<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_hr_payroll</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_payroll']" position="inside">
                <block title="Türkiye Localization" id="l10n_tr_hr_payroll_localization" invisible="company_country_code != 'TR'">
                    <setting string="SGK Workspace Registration Number" help="Fill the 7-digit company's SGK-issued workplace registration number.">
                        <div class="mt8">
                            <field name="l10n_tr_sgk_workspace_registration_no"/>
                        </div>
                    </setting>
                    <setting string="Old Unit Code" help="Two-digit code identifying the former SGK unit associated with the workplace registration number.">
                        <div class="mt8">
                            <field name="l10n_tr_old_unit_code"/>
                        </div>
                    </setting>
                    <setting string="New Unit Code" help="Two-digit code identifying the current SGK unit associated with the workplace registration number.">
                        <div class="mt8">
                            <field name="l10n_tr_new_unit_code"/>
                        </div>
                    </setting>
                    <setting string="Intermediary Code" help="Set to 000 if the workplace is not registered through an intermediary agency. Otherwise, use the registered intermediary code (e.g. 001, 002, etc.).">
                        <div class="mt8">
                            <field name="l10n_tr_sgk_workspace_intermediary_code"/>
                        </div>
                    </setting>
                    <setting
                        help="Define who in your organisation is accountable for filing tax and SGK contributions/reports with GİB">
                        <field name="l10n_tr_tax_reponsible_id" string="Tax Responsible" required="company_country_code == 'TR'" class="o_light_label"
                            options="{'no_create':True, 'no_create_edit': True}" />
                    </setting>
                    <setting string="Incentive Tier" help="Deduction points from employer SSI contribution percentage.">
                        <div class="mt8">
                            <field name="l10n_tr_incentive_tier"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
