<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="hr_payroll_warning_missing_code" model="hr.payroll.warning">
            <field name="name">Employees Without National / IQAMA ID</field>
            <field name="country_id" ref="base.sa"/>
            <field name="button_name">Review Employees</field>
            <field name="model_id" ref="hr_payroll.model_hr_employee"/>
            <field name="warning_type">domain</field>
            <field name="warning_domain">[('l10n_sa_employee_code', '=', False)]</field>
        </record>

        <record id="hr_payroll_warning_gosi_error" model="hr.payroll.warning">
            <field name="name">Employees Where GOSI Failed to Fetch</field>
            <field name="country_id" ref="base.sa"/>
            <field name="button_name">Review Employees</field>
            <field name="model_id" ref="hr_payroll.model_hr_employee"/>
            <field name="warning_type">domain</field>
            <field name="warning_domain">[('l10n_sa_employee_code', '!=', False), ('l10n_sa_gosi_last_request_failed', '=', True), ('l10n_sa_gosi_api_is_available', '=', True)]</field>
        </record>
    </data>
</odoo>
