<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="DataMergeListRenderer.GroupRow" t-inherit="web.ListRenderer.GroupRow" t-inherit-mode="primary">
        <xpath expr="//tr//div[@class='o_group_buttons']" position="attributes">
            <attribute name="t-on-mouseover">
                (ev) => this.onGroupRowMouseEnter(ev, group)
            </attribute>
            <attribute name="t-on-mouseout">
                () => this.onGroupRowMouseLeave()
            </attribute>
        </xpath>
    </t>
</templates>
