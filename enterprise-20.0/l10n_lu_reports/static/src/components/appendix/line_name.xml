<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_lu_reports.AppendixLineName" t-inherit="account_reports.AccountReportLineNameCustomizable">
        <xpath expr="//td[@data-id='line_name']/t[@data-id='content']" position="replace">
            <t t-if="this.props.line.l10n_lu_appendix_action_line?.()">
                <a class="clickable cursor-pointer" t-on-click="(ev) => this.controller.reportAction(ev, 'action_open_appendix_view')">
                    <t t-out="this.props.line.name()"/>
                </a>
                <button
                    class="btn btn_action"
                    t-on-click="(ev) => this.recomputeAction(ev)"
                >
                Recompute
                </button>
            </t>
            <t t-else="">
                <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                    name: this.props.line.name,
                    type: () => 'string',
                    maxCharacters: 80,
                }"/>
            </t>
        </xpath>
    </t>
</templates>
