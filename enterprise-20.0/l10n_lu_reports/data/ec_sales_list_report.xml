<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- display ec sales list report menu item -->
        <record model="ir.ui.menu" id="account_reports.menu_action_account_report_sales">
            <field name="active" eval="True"/>
        </record>

        <!-- Add the report variant -->
        <record id="lux_ec_sales_report" model="account.report">
            <field name="name">Luxemburgese EC sales Report</field>
            <field name="name@fr">Rapport sur les ventes de la CE au Luxembourg</field>
            <field name="name@de">Luxemburgischer EG-Verkaufsbericht</field>
            <field name="name@lb">Newsise EC Salsbericht</field>
            <field name="country_id" ref="base.lu"/>
            <field name="root_report_id" ref="account_reports.generic_ec_sales_report"/>
            <field name="groupby">partner_id_and_sale_type</field>
            <field name="load_more_limit" eval="80"/>
            <field name="filter_journals" eval="True"/>
            <field name="search_bar" eval="True"/>
            <field name="custom_handler_model_id" ref="model_l10n_lu_ec_sales_report_handler"/>
            <field name="column_ids">
                <record id="account_financial_report_ec_sales_country" model="account.report.column">
                    <field name="name">Country Code</field>
                    <field name="name@fr">Code pays</field>
                    <field name="name@de">Ländercode</field>
                    <field name="name@lb">Landcode</field>
                    <field name="expression_label">country_code</field>
                    <field name="figure_type">string</field>
                    <field name="sortable" eval="True"/>
                </record>
                <record id="account_financial_report_ec_sales_vat" model="account.report.column">
                    <field name="name">VAT Number</field>
                    <field name="name@fr">Numéro de TVA</field>
                    <field name="name@de">Umsatzsteuer-Identifikationsnummer</field>
                    <field name="name@lb">Vat Nummer</field>
                    <field name="expression_label">vat_number</field>
                    <field name="figure_type">string</field>
                    <field name="sortable" eval="True"/>
                </record>
                <record id="account_financial_report_ec_sales_tax" model="account.report.column">
                    <field name="name">Tax Code</field>
                    <field name="name@fr">Code fiscal</field>
                    <field name="name@de">Steuercode</field>
                    <field name="name@lb">Steiero-Code</field>
                    <field name="expression_label">sale_type_shortcut</field>
                    <field name="figure_type">string</field>
                    <field name="sortable" eval="True"/>
                </record>
                <record id="account_financial_report_ec_sales_amount" model="account.report.column">
                    <field name="name">Amount</field>
                    <field name="name@fr">Montant</field>
                    <field name="name@de">Betrag</field>
                    <field name="name@lb">Mobil Bet an der Offer</field>
                    <field name="expression_label">balance</field>
                    <field name="sortable" eval="True"/>
                </record>
            </field>
            <field name="line_ids">
                <record id="lu_ec_sales_report_line" model="account.report.line">
                    <field name="name">EC Sales Report</field>
                    <field name="code">LU_EC</field>
                    <field name="foldability">always_unfolded</field>
                    <field name="expression_ids">
                        <record id="lu_ec_sales_report_line_country_code" model="account.report.expression">
                            <field name="label">country_code</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">country_code</field>
                        </record>
                        <record id="lu_ec_sales_report_line_vat_number" model="account.report.expression">
                            <field name="label">vat_number</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">vat_number</field>
                        </record>
                        <record id="lu_ec_sales_report_line_sale_type_shortcut" model="account.report.expression">
                            <field name="label">sale_type_shortcut</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">sale_type_shortcut</field>
                        </record>
                        <record id="lu_ec_sales_report_line_balance" model="account.report.expression">
                            <field name="label">balance</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">balance</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>
    </data>
</odoo>
