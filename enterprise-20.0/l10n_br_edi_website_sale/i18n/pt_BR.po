#. module: l10n_br_edi_website_sale
#: model:ir.module.module,description:base.module_l10n_br_edi_website_sale
msgid ""
"\n"
"Brazilian Accounting EDI for eCommerce\n"
"======================================\n"
"Allows tax calculation and EDI for eCommerce users.\n"
msgstr ""

#. module: l10n_br_edi_website_sale
#: model:ir.model.fields,help:l10n_br_edi_website_sale.field_sale_order_line__l10n_br_goods_operation_type_id
msgid ""
"Brazil: If an Operation Type is selected, it will be applied to the product "
"in the line, determining the CFOP for that line. If no selection is made, "
"the operation type will be inherited from the header."
msgstr ""

#. module: l10n_br_edi_website_sale
#: model:ir.model.fields,help:l10n_br_edi_website_sale.field_delivery_carrier__l10n_br_edi_transporter_id
msgid "Brazil: If this uses a transport company, add its company contact here."
msgstr ""
"Brasil: Se houver transportadoras em uso, adicione o contato da empresa aqui."

#. module: l10n_br_edi_website_sale
#: model:ir.model.fields,help:l10n_br_edi_website_sale.field_delivery_carrier__l10n_br_edi_freight_model
msgid "Brazil: Used to determine the freight model used on orders."
msgstr "Brasil: Usado para determinar o modelo de frete usado em pedidos."

#. module: l10n_br_edi_website_sale
#: model:ir.model.fields,help:l10n_br_edi_website_sale.field_product_product__l10n_br_operation_type_ecommerce_id
#: model:ir.model.fields,help:l10n_br_edi_website_sale.field_product_template__l10n_br_operation_type_ecommerce_id
msgid ""
"Brazil: if an Operation Type is selected, it will be added on eCommerce sale "
"orders. If empty, it won’t be added on the line, and the one on the header "
"will be used."
msgstr ""

