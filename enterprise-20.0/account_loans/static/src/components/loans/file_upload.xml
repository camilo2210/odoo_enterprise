<?xml version="1.0" encoding="UTF-8"?>

<templates>
<!--    Upload from form view-->
    <t t-name="account_accountant.NewLoan">
        <FileUploader
            acceptedFileExtensions="this.props.acceptedFileExtensions"
            fileUploadClass="'new_loan'"
            multiUpload="false"
            onUploaded.bind="this.onFileUploaded"
        >
            <t t-set-slot="toggler">
                <button class="btn btn-primary o_new_loan_upload">
                    Upload
                </button>
            </t>
            <t t-call-slot="default"/>
        </FileUploader>
        <span class="ms-1">
            <button
                class="btn btn-secondary o_new_loan_compute"
                t-on-click="this.openComputeWizard"
            >
                Compute
            </button>
        </span>
    </t>
</templates>
