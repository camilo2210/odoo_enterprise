<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="appointment.AppointmentTypeActionHelper">
        <div class="o_view_nocontent o_appointment_helper">
            <div class="o_nocontent_help container text-center">
                <div class="o_activity_not_found">
                    <h1>Ready to make scheduling easy?</h1>
                    <p class="lead">Create a Schedule from scratch or use one of our templates</p>
                </div>

                <div class="o_appointment_helper_templates row g-2 g-md-3 mx-auto mt-2 justify-content-center">
                    <t t-set="templateNames" t-value="Object.keys(this.appointmentTypeTemplatesData)"/>
                    <t t-foreach="templateNames" t-as="templateName" t-key="templateName">
                        <t t-set="templateData" t-value="this.appointmentTypeTemplatesData[templateName]"/>
                        <t t-set="templateElemClass" t-value="'col-12 col-md-4 col-xl-3'"/>
                        <t t-set="templateDescriptionClass" t-value="'card-body p-0 text-start text-md-center'"/>
                        <t t-set="templateIconClass" t-value="'o_image_64_contain mx-auto'"/>
                        <t t-call="appointment.AppointmentTemplateCard"/>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
