<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="Appointment.appointment_info_no_slot">
        <div class="col-md-8 mx-auto">
            <div class="px-2 pt-3 pb-5 text-center o_appointment_no_slot_overall_helper_txt">
                <t t-if="!active">
                    <p>
                        Sorry, it is no longer possible to schedule an appointment.
                    </p>
                </t>
                <t t-elif="selectedEntityName">
                    <p>
                        Sorry, <span t-out="selectedEntityName"/> has no availability for an appointment.
                    </p>
                </t>
                <t t-else="">
                    <p>
                        Sorry, we have no availability for an appointment.
                    </p>
                </t>
            </div>
            <div class="o_appointment_no_slot_overall_helper_svg mx-auto mb-2">
                <t t-call="Appointment.appointment_svg"/>
            </div>
        </div>
    </t>

    <t t-name="Appointment.appointment_info_no_capacity">
        <div class="col-md-8 mx-auto py-3">
            <div class="o_appointment_no_slot_overall_helper_txt">
                <p>
                    Sorry, there is no more availability for the asked capacity. Please select another party size.
                </p>
            </div>
            <div class="o_appointment_no_slot_overall_helper_svg mx-auto">
                <t t-call="Appointment.appointment_svg"/>
            </div>
        </div>
    </t>

    <t t-name="Appointment.appointment_info_no_slot_month">
        <div class="o_appointment_no_slot_month_helper mt-4 p-3 text-center">
            <div class="o_appointment_no_slot_month_helper_svg w-25 mx-auto">
                <t t-call="Appointment.appointment_svg"/>
            </div>
            <t t-if="selectedEntityName">
                <p>
                    Sorry, <span t-out="selectedEntityName"/> has no more slots available for this month.
                </p>
                <p>
                    Their first availability is <br/>
                    <a href="#" id="next_available_slot" t-out="firstAvailabilityDate"/>
                </p>
            </t>
            <t t-else="">
                <p>
                    Sorry, we have no more slots available for this month.
                </p>
                <p>
                    Our first availability is <br/>
                    <a href="#" id="next_available_slot" t-out="firstAvailabilityDate"/>
                </p>
            </t>
        </div>
    </t>

    <t t-name="Appointment.appointment_info_upcoming_appointment">
        <div class="o_appointment_close_upcoming_appointment_alert col-12 mx-auto alert alert-warning alert-dismissible fade show" data-bs-backdrop="static">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
            You already booked "<span class="d-contents" t-out="appointmentTypeName"/>" on
            <a t-out="appointmentStart" t-attf-href="/calendar/view/#{appointmentToken}?partner_id=#{partnerId}"
                target="_blank" class="alert-link" title="Review Booking"/>
        </div>
    </t>
</templates>
