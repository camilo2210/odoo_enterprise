<?xml version="1.0"?>
<odoo>
    <record id="calendar_alarm_view_search" model="ir.ui.view">
        <field name="name">calendar.alarm.view.search.inherit.appointment</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.calendar_alarm_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_alarm_type']" position="after">
                <filter name="group_by_appointment_type_id" string="Appointment Type" context="{'group_by': 'appointment_type_ids'}"/>
            </xpath>
        </field>
    </record>

    <record id="calendar_alarm_view_kanban" model="ir.ui.view">
        <field name="name">calendar.alarm.view.kanban.inherit.appointment</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.calendar_alarm_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='calendar_alarm_template_details']" position="after">
                <field name="appointment_type_ids" class="pt-2" widget="many2many_tags" options="{'tag_limit': 10}"/>
            </xpath>
        </field>
    </record>

    <record id="calendar_alarm_view_list" model="ir.ui.view">
        <field name="name">calendar.alarm.view.list.inherit.appointment</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.view_calendar_alarm_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="appointment_type_ids" widget="many2many_tags" options="{'tag_limit': 10}" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
