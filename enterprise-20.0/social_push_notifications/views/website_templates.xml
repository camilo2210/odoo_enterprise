<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Load assets for the push notifications only if the push notifications
         are enabled in the settings (see: `enable_push_notifications`) -->
    <template id="social_push_notifications.frontend_layout" inherit_id="web.frontend_layout">
        <!-- Load the CSS -->
        <xpath expr="//head/link[last()]" position="after">
            <t t-if="website.enable_push_notifications">
                <t t-call-assets="social_push_notifications.assets_push_notifications" t-js="False"/>
            </t>
        </xpath>
        <!-- Load the JS -->
        <xpath expr="//head/t[@t-call-assets][last()]" position="after">
            <t t-if="website.enable_push_notifications">
                <t t-call-assets="social_push_notifications.assets_push_notifications" lazy_load="True" t-css="False"/>
            </t>
        </xpath>
    </template>
</odoo>
