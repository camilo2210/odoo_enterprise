<templates id="template" xml:space="preserve">
    <t t-name="knowledge.SearchBarMenu.FavoriteItem" t-inherit="web.SearchBarMenu.FavoriteItem" t-inherit-mode="extension">
        <xpath expr="//CheckboxItem//i[@data-icon='edit']" position="attributes">
            <attribute name="t-if">!this.env.isEmbeddedView</attribute>
        </xpath>
        <xpath expr="//CheckboxItem//i[@data-icon='edit']" position="after">
            <i t-else="" class="ms-1 oi" data-icon="delete"
                title="Delete favorite"
                t-on-click.stop="() => this.onDeleteKnowledgeFavoriteItem?.(item.id)"
            />
        </xpath>
    </t>
</templates>
