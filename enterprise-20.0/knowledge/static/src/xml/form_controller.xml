<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="KnowledgeControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <t t-if="!this.uiService.isSmall" t-call-slot="control-panel-knowledge-button"/>
        </xpath>
    </t>
    <t t-name="Knowledge.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-knowledge-button">
                <button class="o_knowledge_icon_search btn opacity-trigger-hover" type="button" t-on-click="this.onClickSearchKnowledgeArticle" title="Search Knowledge Articles">
                    <t t-call="Knowledge.KnowledgeIcon"/>
                </button>
            </t>
        </xpath>
    </t>
    <t t-name="Knowledge.SettingsFormView" t-inherit="web.SettingsFormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-knowledge-button']" position="replace"/>
    </t>

    <t t-name="Knowledge.FormCogMenu" t-inherit="web.FormCogMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='this.cogItems']" position="after">
            <t t-if="this.uiService.isSmall and this.env.searchKnowledgeArticles">
                <div role="separator" class="dropdown-divider"/>
                <DropdownItem class="'o_knowledge_icon_search d-flex align-items-center gap-2'" onSelected="() => this.env.searchKnowledgeArticles()">
                    <t t-call="Knowledge.KnowledgeIcon"/>
                    <span>Search Knowledge Articles</span>
                </DropdownItem>
            </t>
        </xpath>
    </t>

    <t t-name="Knowledge.KnowledgeIcon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" class="o_ui_app_icon oi oi-fw oi-lg">
            <path fill="var(--oi-color, #1AD3BB)" d="M21 0c-2 0-4 2-4 3.99V12h18v20.071l5.428 3.748A1 1 0 0 0 42 35.001V0H21Z" class="opacity-50 opacity-100-hover"/>
            <path fill="var(--oi-color, #985184)" d="M8 17.99C8 16 10 14 12 14h21v35a1 1 0 0 1-1.572.82L23 44c-1.5-1-3.5-1-5 0l-8.428 5.82A1 1 0 0 1 8 49V17.99Z"/>
            <path fill="var(--oi-color, #005E7A)" d="M33 30.658 32 30c-1.5-1-3.5-1-5 0l-8.428 5.82A1 1 0 0 1 17 35V14h16v16.658Z"/>
        </svg>
    </t>
</templates>
