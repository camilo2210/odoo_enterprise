<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.EmojiPicker" t-inherit-mode="extension">
        <xpath expr="//*[hasclass('o-EmojiPicker-navbar')]" position="inside">
            <button t-if="this.props.hasRemoveFeature" class="btn oi oi-filled btn-outline-danger justify-self-end flex-grow-1 h-100" data-icon="cancel" title="Remove Icon" t-on-click="this.removeEmoji"/>
        </xpath>
    </t>
</templates>
