<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="knowledge.KnowledgeCommentsPopover">
        <div t-ref="this.rootRef" class="o_knowledge_comment_scrollable o_knowledge_comment_box flex-grow-1 overflow-y-auto overflow-x-hidden">
            <t t-if="this.props.threadId !== 'undefined'">
                <KnowledgeThread
                    thread="this.thread"
                    order="'asc'"
                    showDates="false"
                    showEmptyMessage="false"
                    showJumpPresent="false"
                    scrollRef="this.rootRef"
                />
                <div class="o_knowledge_sticky_composer position-sticky bottom-0 pt-2 pe-2 border-top">
                    <Composer
                        composer="this.thread.composer" mode="'extended'" type="'note'"
                        showFullComposer="false" placeholder.translate="Add a comment..."
                    />
                </div>
            </t>
            <div t-else="" class="pt-2 px-2">
                <KnowledgeCommentCreatorComposer placeholder.translate="Add a comment..."
                    composer="this.thread.composer" type="'note'" showFullComposer="false" autofocus="true"
                    mode="'extended'" onPostCallback.bind="this.onPostCallback"
                    onCreateThreadCallback.bind="this.onCreateThreadCallback"/>
            </div>
        </div>
    </t>
</templates>
