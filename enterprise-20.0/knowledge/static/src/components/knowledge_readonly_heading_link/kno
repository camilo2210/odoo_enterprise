<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="knowledge.KnowledgeReadOnlyHeadingLink">
        <div class="d-flex position-absolute" t-ref="this.headingLinkContainerRef" style="visibility: hidden;">
            <a href="#" t-on-click="() => this.onClickLink()"
            title="Copy a link to this heading in the clipboard" class="o-heading-link px-1 text-400">
                <i class="o-heading-link oi" data-icon="link" aria-hidden="true"/>
            </a>
        </div>
    </t>
</templates>
