<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="knowledge.WithLazyLoading">
        <t t-if="this.state.isLoaded">
            <t t-call-slot="default"/>
        </t>
        <t t-else="">
            <div t-ref="this.loaderRef" class="p-3 text-center">
                <i class="oi oi-2x oi-spin" data-icon="autorenew" title="loader" role="img"/>
            </div>
        </t>
    </t>
</templates>
