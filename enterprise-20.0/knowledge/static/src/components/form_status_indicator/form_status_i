<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="knowledge.FormStatusIndicator" t-inherit="web.FormStatusIndicator" t-inherit-mode="primary">

        <xpath expr="//button[hasclass('o_form_button_save')]" position="attributes">
            <attribute name="class" add="text-muted py-1 px-2" remove="py-0 px-1 lh-sm" separator=" "/>
        </xpath>

        <xpath expr="//button[hasclass('o_form_button_cancel')]" position="attributes">
            <attribute name="class" add="text-muted py-1 px-2" remove="py-0 px-1 lh-sm" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_form_status_indicator')]" position="attributes">
            <attribute name="class" remove="align-self-md-end" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_form_status_indicator_buttons')]" position="attributes">
            <attribute name="class" remove="border-start" separator=" "/>
        </xpath>

    </t>

</templates>
