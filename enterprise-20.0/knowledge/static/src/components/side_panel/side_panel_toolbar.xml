<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="knowledge.SidePanelToolbar">
        <div t-if="this.props.record.resId" class="o_knowledge_side_panel_toolbar d-flex align-self-start flex-shrink-0 gap-0 gap-lg-1 ms-1">
            <button t-if="this.isInternalUser"
                class="btn btn-light btn-chatter"
                t-att-class="{ active: this.panelState.isDisplayed('chatter') }"
                t-on-click="() => this.togglePanel('chatter')"
                t-att-title="this.chatterButtonTitle"
                t-att-aria-label="this.chatterButtonTitle"
                data-hotkey="d">
                <i class="oi" data-icon="forum" aria-hidden="true"/>
            </button>
            <button t-if="this.panelState.isDisplayed('properties') or this.props.record.data.article_properties.some((prop) => !prop.definition_deleted)"
                class="btn btn-light btn-properties"
                t-att-class="{ active: this.panelState.isDisplayed('properties') }"
                t-on-click="() => this.togglePanel('properties')"
                title="Show Properties"
                aria-label="Show Properties"
                data-hotkey="o">
                <i class="oi" data-icon="settings_applications" aria-hidden="true"/>
            </button>
            <button t-if="this.panelState.commentsState.hasComments or this.panelState.isDisplayed('comments')"
                class="btn btn-light btn-comments"
                t-att-class="{ active: this.panelState.isDisplayed('comments') }"
                t-on-click="() => this.togglePanel('comments')"
                t-att-title="this.commentButtonTitle"
                t-att-aria-label="this.commentButtonTitle">
                <i class="oi" data-icon="mode_comment" aria-hidden="true"/>
            </button>
            <button t-if="this.tocButton.isRelevant or this.panelState.isDisplayed('toc')"
                class="btn btn-light btn-toc"
                t-att-class="{ active: this.panelState.isDisplayed('toc') }"
                title="Show Table of Contents"
                aria-label="Show Table of Contents"
                t-on-click="() => this.togglePanel('toc')">
                <i class="oi" data-icon="format_list_bulleted" aria-hidden="true"/>
            </button>
            <OptionsDropdown record="this.props.record"/>
        </div>
    </t>
</templates>
