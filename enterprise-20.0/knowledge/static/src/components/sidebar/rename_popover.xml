<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="knowledge.KnowledgeRenamePopover">
        <div class="d-flex align-items-center">
            <KnowledgeIcon record="this.props.record" fallbackDefaultIcon="true" iconClasses="'me-1'" readonly="false" autoSave="true"/>
            <input
                t-ref="this.autofocusRef"
                class="w-100 p-1 text-truncate text-body border-0"
                t-att-value="this.props.record.data.name || ''"
                type="text"
                autocomplete="off"
                placeholder="Untitled"
                t-on-keydown="this.onInputKeydown"
                t-on-change="ev => this.onChangeInput(ev.target.value)"
            />
        </div>
    </t>
</templates>
