<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="knowledge.WysiwygArticleHelper">
        <div t-if="this.props.isVisible" class="o_knowledge_helper d-print-none d-flex flex-column gap-2 mt-4 mb-5">
            <small class="text-muted">Get started with</small>
            <div class="d-flex flex-wrap gap-1">
                <button class="o_knowledge_load_template btn btn-secondary text-nowrap" data-hotkey="A" t-on-click="this.onLoadTemplateBtnClick" t-if="!this.isPortalUser">
                    <i class="oi me-1" data-icon="design_services"/> Templates
                </button>
                <div class="dropdown">
                    <button class="btn btn-secondary o-dropdown dropdown-toggle dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="oi me-1" data-icon="database" title="Build an Item database"/>
                        <span class="d-none d-md-inline">Build an</span> Item database
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="o_knowledge_add_item_kanban o-dropdown-item dropdown-item text-reset" data-hotkey="K" t-on-click="this.onBuildItemKanbanBtnClick">
                                <i class="oi me-1" data-icon="view_module"/> Kanban
                            </button>
                        </li>
                        <li>
                            <button class="o_knowledge_add_item_list o-dropdown-item dropdown-item text-reset" data-hotkey="L" t-on-click="this.onBuildItemListBtnClick">
                                <i class="oi me-1" data-icon="view_list"/> List
                            </button>
                        </li>
                        <li>
                            <button class="o_knowledge_add_item_calendar o-dropdown-item dropdown-item text-reset" data-hotkey="C" t-on-click="this.onBuildItemCalendarBtnClick">
                                <i class="oi oi-filled me-1" data-icon="calendar_today"/> Calendar
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </t>
</templates>
