<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="knowledge.KnowledgeArticleChatter">
        <chatter t-if="this.panelState.isDisplayed('chatter')" class="o_FormRenderer_chatterContainer p-0 mt-n2">
            <Chatter
                threadModel="'knowledge.article'"
                threadId="this.props.record.resId"
                record="this.props.record"
                hasParentReloadOnAttachmentsChanged="true"
                hasParentReloadOnFollowersUpdate="true"
                hasParentReloadOnMessagePosted="true"
                isChatterAside="this.isChatterAside"
                saveRecord="this.props.record.save.bind(this.props.record, { reload: false })"
            />
        </chatter>
    </t>
</templates>
