<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="knowledge.EmbeddedViewActionsMenu">
        <DropdownItem onSelected.bind="this._onOpenEmbeddedView">
            <i class="oi oi-fw me-1" data-icon="open_in_new"/>Open
        </DropdownItem>
        <DropdownItem t-if="!this.env.isEmbeddedReadonly" onSelected.bind="this._onEditEmbeddedView">
            <i class="oi oi-fw oi-filled me-1" data-icon="edit"/>Edit
        </DropdownItem>
    </t>
</templates>
