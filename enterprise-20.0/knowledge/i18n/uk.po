"            (<span style=\"font-style: italic;\">за командою, темою, "
"проектом, ...</span>)\n"
"        </span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid ""
