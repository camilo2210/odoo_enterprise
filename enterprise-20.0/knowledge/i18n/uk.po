"            (<span style=\"font-style: italic;\">per team, topic, "
"project, ...</span>)\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"            Папки —\n"
"        </span>\n"
"        <span style=\"font-size: 14px;\">\n"
"            <span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">Розмістіть інші статті</"
"font>\n"
"            </span>\n"
