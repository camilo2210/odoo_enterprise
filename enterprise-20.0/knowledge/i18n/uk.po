"            Оберіть текст для\n"
"            <font class=\"bg-o-color-2\">виділення</font>,\n"
"            <span style=\"text-decoration-line: line-through;\">закреслення</"
"span>\n"
"            або\n"
"            <span style=\"font-weight: bolder;\">стилізації</span>\n"
"            <span style=\"font-style: italic; text-decoration-line: "
"underline;\">тексту</span>\n"
"        </span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"            Use\n"
"            /<span style=\"font-weight: bolder;\"><font class=\"text-o-"
"color-2\">clipboard</font></span>\n"
