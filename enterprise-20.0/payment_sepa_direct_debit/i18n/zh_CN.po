#. module: payment_sepa_direct_debit
#: model:mail.template,body_html:payment_sepa_direct_debit.mail_template_sepa_notify_validation
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"\n"
"<p>A SEPA Direct Debit Mandate authorization has just been validated for use "
"with <t t-out=\"company.name or ''\">YourCompany</t>.</p>\n"
"\n"
"<p>You will find a copy of the mandate validation attached to this email.</"
"p>\n"
"\n"
"<p>Do not hesitate to contact us if you have any question.</p>\n"
"            </t>"
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id\"/>\n"
"您好 <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"\n"
"<p> 您授权给 <t t-out=\"company.name or ''\">YourCompany</t>的 SEPA 直接扣款"
"授权书现已验证生效。</p>\n"
"\n"
"<p>本邮件附件包含该授权书的生效副本，敬请查收。</p>\n"
"\n"
"<p>如有任何疑问，请随时与我们联系。</p>\n"
"            </t>"

