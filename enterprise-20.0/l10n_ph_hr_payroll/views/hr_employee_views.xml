<?xml version="1.0"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.l10n.ph.hr.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <field name="legal_name" position="after">
                <field name="l10n_ph_legal_first_name" string="First Name"/>
                <field name="l10n_ph_legal_middle_name" string="Middle Name"/>
                <field name="l10n_ph_legal_last_name" string="Last Name"/>
                <field name="l10n_ph_legal_suffix" string="Suffix" placeholder="e.g. Jr."/>
            </field>
            <field name="identification_id" position="after">
                <field name="l10n_ph_hr_payroll_philhealth_pin" placeholder="00-000000000-0" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_sss_number" placeholder="00-0000000-0" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_pag_ibig_mid" placeholder="0000-0000-0000" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_work_tin" placeholder="000-000-000-000" string="TIN" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_work_tin_branch_code" placeholder="000" string="Branch Code" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_rdo_code" placeholder="e.g. 047 or 039A" invisible="country_code != 'PH'"/>
            </field>
            <label for="distance_home_work" position="before">
                <field name="l10n_ph_hr_payroll_registered_address" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_registered_zip" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_foreign_address" invisible="country_code != 'PH'"/>
            </label>
            <field name="structure_type_id" position="before">
                <field name="l10n_ph_hr_payroll_employee_rank" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_is_main_employment" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_minimum_wage_earner" invisible="country_code != 'PH'"/>
            </field>
            <field name="structure_type_id" position="after">
                <field name="l10n_ph_hr_payroll_prev_employment_id" invisible="country_code != 'PH'" context="{'default_employee_id': id}" readonly="not id"/>
            </field>
            <div name="hourly_wage" position="after">
                <label for="l10n_ph_hr_payroll_daily_wage" invisible="wage_type != 'daily' or country_code != 'PH'"/>
                <div class="o_row" name="l10n_ph_hr_payroll_daily_wage" invisible="wage_type != 'daily' or country_code != 'PH'">
                    <field name="l10n_ph_hr_payroll_daily_wage" class="o_hr_narrow_field"/>
                    <span>/ day</span>
                </div>
            </div>
        </field>
    </record>
</odoo>
