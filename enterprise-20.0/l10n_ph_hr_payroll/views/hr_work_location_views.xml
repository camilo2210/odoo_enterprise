<odoo>
    <record id="hr_work_location_tree_view" model="ir.ui.view">
        <field name="name">hr.work.location.view.list</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
        <field name="arch" type="xml">
            <field name="address_id" position="after">
                <field name="currency_id" column_invisible="1"/> <!-- for the monetary amount -->
                <field name="l10n_ph_hr_payroll_min_daily_wage" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_work_location_form_view" model="ir.ui.view">
        <field name="name">hr.work.location.view.form</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <field name="address_id" position="after">
                <field name="currency_id" invisible="1"/> <!-- for the monetary amount -->
                <field name="l10n_ph_hr_payroll_min_daily_wage" invisible="country_code != 'PH'"/>
            </field>
        </field>
    </record>
</odoo>
