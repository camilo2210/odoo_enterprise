<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ph_hr_payroll_2316_view_form" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.form_2316.view.form</field>
        <field name="model">l10n_ph_hr_payroll.form_2316</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="period_start_date" position="after">
                <field name="employer_signatory_name" readonly="state == 'done'"/>
                <field name="departing_employees_only" readonly="state == 'done'"/>
            </field>
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_2316_view_tree" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.form_2316.view.list</field>
        <field name="model">l10n_ph_hr_payroll.form_2316</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_list"/>
        <field name="mode">primary</field>
    </record>

    <record id="l10n_ph_hr_payroll_2316_action" model="ir.actions.act_window">
        <field name="name">Form 2316</field>
        <field name="res_model">l10n_ph_hr_payroll.form_2316</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
