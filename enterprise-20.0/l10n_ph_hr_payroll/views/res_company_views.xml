<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.l10n.ph.hr.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <div name="identifiers" position="after">
                <field name="l10n_ph_hr_payroll_sss_number" placeholder="00-0000000-0" invisible="country_code != 'PH'"/>
                <field name="l10n_ph_hr_payroll_sss_branch_code" placeholder="e.g. 000" invisible="country_code != 'PH'"/>
            </div>
        </field>
    </record>
</odoo>
