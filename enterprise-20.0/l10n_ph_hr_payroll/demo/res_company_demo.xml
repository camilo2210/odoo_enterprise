<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <!-- Demo company & related data -->
        <record id="base.partner_demo_company_ph" model="res.partner" forcecreate="1">
            <field name="name">My Philippines Company</field>
            <field name="street">Philippines Street</field>
            <field name="zip">1000</field>
            <field name="city">Manila</field>
            <field name="country_id" ref="base.ph"/>
        </record>

        <record id="base.demo_company_ph" model="res.company" forcecreate="1">
            <field name="name">My Philippines Company</field>
            <field name="partner_id" ref="base.partner_demo_company_ph"/>
            <field name="currency_id" ref="base.PHP"/>
            <field name="country_id" ref="base.ph"/>
            <field name="resource_calendar_id" ref="l10n_ph_hr_payroll.calendar_ph_40"/>
            <field name="l10n_ph_hr_payroll_sss_number">03-1234567-8</field>
        </record>

        <record id="res_partner_ph_work_address" model="res.partner">
            <field name="name">Philippines Office</field>
            <field name="street">232 Juan Luna Street</field>
            <field name="street2">Room 703, Padilla Delos Reyes Building</field>
            <field name="city">Manila</field>
            <field name="state_id" ref="base.state_ph_01"/>
            <field name="country_id" ref="base.ph"/>
            <field name="company_id" ref="base.demo_company_ph"/>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="company_ids" eval="[(4, ref('base.demo_company_ph'))]"/>
        </record>

        <record id="base.user_demo" model="res.users">
            <field name="company_ids" eval="[(4, ref('base.demo_company_ph'))]"/>
        </record>

        <!-- same thing with the working schedules -->
        <record id="l10n_ph_hr_payroll.calendar_ph_40" model="resource.calendar">
            <field name="company_id" ref="base.demo_company_ph"/>
        </record>
        <record id="l10n_ph_hr_payroll.calendar_ph_48" model="resource.calendar">
            <field name="company_id" ref="base.demo_company_ph"/>
        </record>
    </data>
</odoo>
