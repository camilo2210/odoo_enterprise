<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We define specific codes as we use the contract types in a few flows. -->
    <data noupdate="1">
        <record id="l10n_ph_contract_type_regular" model="hr.employee.type">
            <field name="name">Regular</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">R</field>
        </record>
        <record id="l10n_ph_contract_type_casual" model="hr.employee.type">
            <field name="name">Casual</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">C</field>
        </record>
        <record id="l10n_ph_contract_type_contractual" model="hr.employee.type">
            <field name="name">Contractual / Project</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">CP</field>
        </record>
        <record id="l10n_ph_contract_type_seasonal" model="hr.employee.type">
            <field name="name">Seasonal</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">S</field>
        </record>
        <record id="l10n_ph_contract_type_probationary" model="hr.employee.type">
            <field name="name">Probationary</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">P</field>
        </record>
        <record id="l10n_ph_contract_type_apprentice" model="hr.employee.type">
            <field name="name">Apprentice / Learner</field>
            <field name="country_id" ref="base.ph"/>
            <field name="code">AL</field>
        </record>
    </data>
</odoo>
