<odoo>
    <record id="group_room_manager" model="res.groups">
        <field name="name">Manage Rooms</field>
        <field name="sequence">10</field>
        <field name="comment">Enable the user to manage meeting rooms available for booking</field>
        <field name="privilege_id" ref="res_groups_privilege_room"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    </odoo>
