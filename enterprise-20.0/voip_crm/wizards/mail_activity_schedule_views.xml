<?xml version="1.0"?>
<odoo>
    <record id="voip_activity_schedule_form_view_inherit" model="ir.ui.view">
        <field name="name">voip.activity.schedule.form.view.inherit</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="voip.voip_activity_schedule_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contact_id']" position="after">
                <field name="lead_id" nolabel="1" class="w-100"
                    domain="lead_id_domain"
                    required="res_model_selection == 'crm.lead'"
                    invisible="res_model_selection != 'crm.lead'"
                    options="{'no_create': True}"
                    placeholder="Choose a Lead"/>
            </xpath>
        </field>
    </record>
</odoo>
