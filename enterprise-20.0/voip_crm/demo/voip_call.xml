<?xml version="1.0"?>
<odoo noupdate="0">

<record id="crm.activity_8" model="mail.activity">
    <field name="active" eval="False"/>
</record>

<record id="voip_activity_message_demo_crm" model="mail.message">
    <field name="model">crm.lead</field>
    <field name="res_id" ref="crm.crm_case_20"/>
    <field name="subtype_id" ref="mail.mt_activities"/>
    <field name="message_type">notification</field>
    <field name="author_id" ref="base.partner_admin"/>
    <field name="mail_activity_type_id" ref="mail.mail_activity_data_call"/>
    <field name="date" eval="datetime.now().replace(hour=15, minute=9, second=58, microsecond=0) - timedelta(days=10)"/>
    <field name="body" model="mail.render.mixin" eval="obj().env['mail.render.mixin']._render_template_qweb_view('voip.message_call_activity_done', 'crm.lead', [ref('crm.crm_case_20')], add_context={'activity': obj().env.ref('crm.activity_8'), 'feedback': False, 'display_assignee': False})[ref('crm.crm_case_20')]"/>
</record>

<record id="voip.voip_call_demo_crm_logged" model="voip.call">
    <field name="activity_id" ref="crm.activity_8"/>
    <field name="activity_mail_message_id" ref="voip_activity_message_demo_crm"/>
</record>

<function model="voip.call" name="update_activity_message" eval="[[ref('voip.voip_call_demo_crm_logged')]]"/>

</odoo>
