<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_mobility_budget" model="ir.ui.view">
        <field name="name">hr.expense.view.form.mobility.budget</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_monthly_expenses" type="object" class="oe_stat_button" icon="attach_money"
                        invisible="not l10n_be_is_mobility_expense or not employee_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_be_mobility_budget_remaining_month" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Monthly Remaining</span>
                    </div>
                </button>
                <button name="action_open_yearly_expenses" type="object" class="oe_stat_button" icon="attach_money"
                        invisible="not l10n_be_is_mobility_expense or not employee_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_be_mobility_budget_remaining_year" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Yearly Remaining</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
