<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="social_media_view_kanban" model="ir.ui.view">
    <field name="name">social.media.view.kanban.inherit.social_linkedin</field>
    <field name="model">social.media</field>
    <field name="inherit_id" ref="social.social_media_view_kanban"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='can_link_accounts']" position="after">
            <field name="media_type"/>
        </xpath>
        <xpath expr="//button" position="attributes">
            <attribute name="t-if">record.media_type.raw_value !== 'linkedin'</attribute>
        </xpath>
        <xpath expr="//button" position="after">
            <button t-if="record.media_type.raw_value === 'linkedin'"
                type="object"
                class="btn btn-primary text-nowrap mt-2 mx-1 w-50"
                name="action_add_account">
                Link Page Account
            </button>
            <button t-if="record.media_type.raw_value === 'linkedin'"
                type="object"
                class="btn btn-primary text-nowrap mt-2 mx-1 w-50"
                name="action_add_account"
                context="{'linkedin_link_personal': True}">
                Link Personal Account
            </button>
        </xpath>
    </field>
</record>
</odoo>
