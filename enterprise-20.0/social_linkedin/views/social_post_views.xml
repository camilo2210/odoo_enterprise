<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_post_view_form" model="ir.ui.view">
        <field name="name">social.post.view.form.inherit.social_linkedin</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social.social_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='linkedin_content']//div[hasclass('o_horizontal_separator')]" position="before">
                <field name="linkedin_scheduled_date" string="Post On" placeholder="Immediately"
                    readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='linkedin_message']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='linkedin_image_ids']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='linkedin_first_comment']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_social_linkedin_label_message')]" position="attributes">
                <attribute name="invisible" add="state != 'draft' and not linkedin_message" separator="or"/>
            </xpath>
            <xpath expr="//div[hasclass('o_social_linkedin_label_media')]" position="attributes">
                <attribute name="invisible" add="state != 'draft' and not linkedin_image_ids" separator="or"/>
            </xpath>
            <xpath expr="//div[hasclass('o_social_linkedin_label_first_comment')]" position="attributes">
                <attribute name="invisible" add="state != 'draft' and not linkedin_first_comment" separator="or"/>
            </xpath>
        </field>
    </record>
</data>
</odoo>
