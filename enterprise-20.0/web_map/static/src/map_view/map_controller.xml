<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_map.MapView">
        <div t-att-class="this.props.className">
            <Layout display="this.props.display">
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu/>
                </t>
                <t t-set-slot="control-panel-buttons">
                    <t t-call="{{ this.props.buttonTemplate }}"/>
                </t>
                <t t-set-slot="control-panel-actions">
                    <SearchBar toggler="this.searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="this.searchBarToggler.component" t-props="this.searchBarToggler.props"/>
                </t>
                <t t-component="this.props.Renderer" t-props="this.rendererProps" />
            </Layout>
        </div>
    </t>
    <t t-name="web_map.GoogleMapsIcon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 232597 333333" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd">
            <path fill="#1a73e8" d="M151444 5419C140355 1916 128560 0 116311 0 80573 0 48591 16155 27269 41534l54942 46222 69232-82338z"/>
            <path fill="#ea4335" d="M27244 41534C10257 61747 0 87832 0 116286c0 21876 4360 39594 11517 55472l70669-84002-54942-46222z"/>
            <path fill="#4285f4" d="M116311 71828c24573 0 44483 19910 44483 44483 0 10938-3957 20969-10509 28706 0 0 35133-41786 69232-82313-14089-27093-38510-47936-68048-57286L82186 87756c8166-9753 20415-15928 34125-15928z" />
            <path fill="#fbbc04" d="M116311 160769c-24573 0-44483-19910-44483-44483 0-10863 3906-20818 10358-28555l-70669 84027c12072 26791 32159 48289 52851 75381l85891-102122c-8141 9628-20339 15752-33948 15752z" />
            <path fill="#34a853" d="M148571 275014c38787-60663 84026-88210 84026-158728 0-19331-4738-37552-13080-53581L64393 247140c6578 8620 13206 17793 19683 27900 23590 36444 17037 58294 32260 58294 15172 0 8644-21876 32235-58320z" />
        </svg>
    </t>
    <t t-name="web_map.MapView.Buttons" >
        <button t-if="!this.env.inDialog and this.canCreate" type="button" class="btn btn-primary o_map_button_add" accesskey="c" t-on-click="() => this.props.createRecord()" data-bounce-button="">
            New
        </button>
        <div data-tooltip="Open addresses and directions of expanded groups in Google Maps">
            <button class="btn btn-secondary" t-on-click="() => this.model.googleMapUrl()" data-hotkey="m">
                <t t-call="web_map.GoogleMapsIcon"/>
                <span class="ms-1">Maps</span>
            </button>
        </div>
    </t>

</templates>
