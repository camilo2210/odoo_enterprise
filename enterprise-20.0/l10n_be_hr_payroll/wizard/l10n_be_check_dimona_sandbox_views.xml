<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_check_dimona_sandbox_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.be.check.dimona.sandbox.view.form</field>
        <field name="model">l10n.be.check.dimona.sandbox</field>
        <field name="arch" type="xml">
            <form string="Check DIMONA Status - Sandbox Mode">
                <group>
                    <group>
                        <field name="version_id" readonly="1"/>
                    </group>
                </group>
                <separator string="Declaration Response (JSON)"/>
                <field name="response_json" widget="ace" options="{'lineNumbers': true, 'lang': 'json'}" nolabel="1"/>
                <footer>
                    <button name="apply_response" string="Apply Response" type="object" class="oe_highlight"/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
