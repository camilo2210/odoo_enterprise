<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_be_hr_payroll.BinaryGenerateField">
        <t t-set="has_binary_value" t-value="!!this.props.record.data[this.props.name]"/>
        <t t-if="has_binary_value">
            <t t-if="this.props.record.resId and !this.props.record.dirty">
                <a class="o_form_uri d-inline-flex align-items-center" href="#" t-on-click.prevent.stop="this.onFileDownload">
                    <span class="oi me-2" data-icon="download" aria-hidden="true"/>
                    <t t-if="this.fileName" t-out="this.fileName"/>
                </a>
            </t>
            <t t-else="">
                <span t-if="this.fileName" t-out="this.fileName"/>
            </t>
        </t>
        <t t-else="">
            <t t-if="this.props.record.resId">
                <button
                    class="btn btn-link btn-sm o_generate_file_button p-0"
                    type="button"
                    t-att-disabled="this.state.isGenerating"
                    t-on-click="this.onGenerate"
                >
                    <t t-out="this.buttonLabel"/>
                </button>
            </t>
        </t>
    </t>

</templates>
