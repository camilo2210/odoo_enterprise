<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_calendar_view_form" model="ir.ui.view">
        <field name="name">resource.calendar.view.form</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='resource_details']/group[1]" position="inside">
                <field name="l10n_be_reorganisation_measure_ids" widget="many2many_tags" options="{'color_field': 'color'}" 
                    invisible="calendar_type != 'variable' and not l10n_be_reorganisation_measure_ids"/>
                <field name="l10n_be_time_reorganisation_amount"
                    invisible="calendar_type != 'variable' or not l10n_be_show_time_reorganisation_amount"/>
            </xpath>
        </field>
    </record>

    <record id="resource_calendar_view_tree" model="ir.ui.view">
        <field name="name">resource.calendar.list.inherit.l10n_be</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
        <field name="arch" type="xml">
            <field name="attendance_ids" position="after">
                <field name="l10n_be_reorganisation_measure_ids" string="WRM" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </field>
        </field>
    </record>

    <record id="resource_calendar_leaves_tree_inherit_be" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.inherit.l10n_be</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">l10n_be_public_holiday_list</attribute>
            </xpath>
        </field>
    </record>
</odoo>
