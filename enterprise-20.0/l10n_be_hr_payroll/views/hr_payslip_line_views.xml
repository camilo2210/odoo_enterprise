<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_line_view_list_report_inherit_l10n_be" model="ir.ui.view">
        <field name="name">hr.payslip.line.list.report.inherit.l10n.be</field>
        <field name="model">hr.payslip.line</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_line_view_list_report"/>
        <field name="arch" type="xml">
            <field name="total" position="after">
                <field name="l10n_be_follow_pay_period" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_payslip_line_view_search_report_inherit_l10n_be" model="ir.ui.view">
        <field name="name">hr.payslip.line.search.report.inherit.l10n.be</field>
        <field name="model">hr.payslip.line</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_line_view_search_report"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter 
                    string="Amount to Recover" 
                    name="filter_amount_to_recover" 
                    domain="[('code', '=', 'NET_TO_RECOVER'), ('total', '&gt;', 0)]"/>
                <filter
                    string="Follows the Pay Period"
                    name="filter_follow_pay_period"
                    domain="[('l10n_be_follow_pay_period', '=', True)]"/>
                <filter
                    string="Follows the Fiscal Period"
                    name="filter_follow_fiscal_period"
                    domain="[('l10n_be_follow_pay_period', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
