<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_joint_committee_action" model="ir.actions.act_window">
        <field name="name">Joint Committees</field>
        <field name="res_model">l10n.be.joint.committee</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="l10n_be_joint_committee_view_form" model="ir.ui.view">
        <field name="name">l10n.be.joint.committee.form</field>
        <field name="model">l10n.be.joint.committee</field>
        <field name="arch" type="xml">
            <form string="Joint Committee">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="egov3_code"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="selectable"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_be_joint_committee_view_tree" model="ir.ui.view">
        <field name="name">l10n.be.joint.committee.tree</field>
        <field name="model">l10n.be.joint.committee</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Joint Committees" editable="bottom" create="1" delete="1">
                <field name="name" width='50'/>
                <field name="egov3_code" width='10'/>
                <field name="parent_id" width='30'/>
                <field name="active" widget="boolean_toggle" width='10'/>
                <field name="selectable" optional="hide" width='10'/>
            </list>
        </field>
    </record>

    <record id="l10n_be_joint_committee_view_search" model="ir.ui.view">
        <field name="name">l10n.be.joint.committee.search</field>
        <field name="model">l10n.be.joint.committee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('egov3_code', 'ilike', self)]"/>
                <field name="egov3_code"/>
                <filter string="With Employees" name="filter_with_employees"
                    domain="[('version_ids', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="l10n_be_joint_committee_action" model="ir.actions.act_window">
        <field name="name">Joint Committees</field>
        <field name="res_model">l10n.be.joint.committee</field>
        <field name="view_mode">list</field>
        <field name="target">current</field>
    </record>

    <record id="l10n_be_joint_committee_see_more_view_list" model="ir.ui.view">
        <field name="name">l10n.be.joint.committee.see.more.list</field>
        <field name="model">l10n.be.joint.committee</field>
        <field name="inherit_id" ref="l10n_be_joint_committee_view_tree"/>
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="selectable" position="replace"/>
        </field>
    </record>

    <menuitem
        id="menu_l10n_be_joint_committee"
        name="Joint Committees"
        action="l10n_be_joint_committee_action"
        parent="menu_l10n_be_hr_payroll_configuration"
        sequence="505"/>

</odoo>
