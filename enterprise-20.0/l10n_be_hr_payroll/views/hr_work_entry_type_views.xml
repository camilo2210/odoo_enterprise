<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- YTI TODO: Reunite those 2 views -->
    <record id="hr_work_entry_type_view_form" model="ir.ui.view">
        <field name="name">hr.work.entry.type.be.inherit.form</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <group name='computation' position="after">
                <group name="extra_computation">
                    <field name='leave_right' invisible="country_code and country_code != 'BE'"/>
                    <field name="l10n_be_is_time_credit" invisible="country_code and country_code != 'BE'"/>
                </group>
            </group>
            <xpath expr="//separator[@name='description']" position="attributes">
                <attribute name="invisible">country_code == 'BE'</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="invisible">country_code == 'BE'</attribute>
            </xpath>
            <xpath expr="//group[@name='exports_code']" position="attributes">
                <attribute name="invisible">country_code == 'BE'</attribute>
            </xpath>
            <xpath expr="//group[@name='exports_code']" position="after">
                <group name="l10n_be_external_code" string="Declarations" invisible="not country_code or country_code != 'BE'">
                    <field placeholder="3 numbers length" name="dmfa_code" string="DMFA"/>
                    <field name="external_code" string="External" placeholder="Code used in manual exports"/>
                    <field name="l10n_be_egov3_code"/>
                    <field name="l10n_be_drs_risk_ids" widget="many2many_tags"/>
                    <field name="l10n_be_drs_nature"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='display_hours']" position="attributes">
                <attribute name="invisible">country_code == 'BE'</attribute>
            </xpath>

            <page id="work_entry_payroll_tab" position="after">
                <page string="Description" invisible="not country_code or country_code != 'BE'">
                    <separator string="Description" />
                    <field rows="5" nolabel="1" name="description" placeholder="Provide a description of the Time Type, in which case should it be used"/>
                </page>
            </page>

        </field>
    </record>

    <record id="hr_work_entry_type_view_tree" model="ir.ui.view">
        <field name="name">hr.work.entry.type.view.tree.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="dmfa_code" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="hr_work_entry_type_view_search" model="ir.ui.view">
        <field name="name">hr.work.entry.type.view.search.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_search"/>
        <field name="arch" type="xml">
            <field name="category_ids" position="after">
                <field name="dmfa_code"/>
            </field>
            <filter name="unpaid_structure" position='after'>
                <separator/>
                <filter name="Assimilated" string="Computed in Holiday Rights" domain="['!', ('category_ids.code', '=', 'UNASSIMILATED')]"/>
            </filter>
        </field>
    </record>

</odoo>
