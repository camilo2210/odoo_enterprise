<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_list_view" model="ir.ui.view">
        <field name="name">hr.payroll.structure.list.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payroll_structure_list_view"/>
        <field name="arch" type="xml">
            <field name="rule_ids" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
            </field>
        </field>
    </record>

    <record id="view_hr_employee_grade_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <field name="schedule_pay" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
                <field name="type_id" position="attributes">
                    <attribute name="invisible">country_code == 'BE'</attribute>
                </field>
            </field>
        </field>
    </record>
</odoo>
