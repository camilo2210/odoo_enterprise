<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_category_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_category_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
            </field>
        </field>
    </record>

    <record id="hr_salary_rule_category_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.list.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_category_tree"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
            </field>
        </field>
    </record>
</odoo>
