<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.contract.type.view.form.inherit.l10_be_hr_payroll</field>
        <field name="model">hr.employee.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="l10n_be_joint_committee_id" invisible="country_code != 'BE'" placeholder="Default from company" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="l10n_be_worker_code_ids" string="Sub-types" widget="many2many_tags" invisible="country_code not in (False, 'BE') or company_country_code not in (False, 'BE')" groups="hr_payroll.group_hr_payroll_user"/>
                <field name="l10n_be_dimona_category" invisible="country_code not in (False, 'BE') or company_country_code not in (False, 'BE')" groups="hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>
</odoo>
