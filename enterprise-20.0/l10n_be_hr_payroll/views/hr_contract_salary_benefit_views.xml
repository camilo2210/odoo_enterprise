<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_benefit_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.salary.benefit.view.list.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.contract.salary.benefit</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_benefit_view_tree"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" width="200" placeholder="All"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" width="200" placeholder="None"/>
            </field>
        </field>
    </record>

    <record id="hr_contract_benefit_view_form" model="ir.ui.view">
        <field name="name">hr.contract.salary.benefit.view.form.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.contract.salary.benefit</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_benefit_view_form"/>
        <field name="arch" type="xml">
            <field name="salary_rule_ids" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" placeholder="None"/>
            </field>
        </field>
    </record>
</odoo>
