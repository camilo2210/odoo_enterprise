<?xml version="1.0"?>
<odoo>
<template id="report_termination_fees">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="oe_structure"></div>
                    <h2><span t-field="o.name"/></h2>

                    <table class="table table-sm table-bordered">
                        <tr>
                            <td><strong>Company Information</strong></td>
                            <td>
                                <div><span t-field="o.company_id.name"/></div>
                                <div><span t-field="o.company_id.street"/></div>
                                <div><span t-if="o.company_id.street2" t-field="o.company_id.street2"/></div>
                                <div>
                                    <span t-field="o.company_id.city"/>
                                    <span t-field="o.company_id.state_id"/>
                                    <span t-field="o.company_id.zip"/>
                                </div>
                                <div><span t-field="o.company_id.country_id"/></div>
                            </td>
                        </tr>
                    </table>

                    <table class="table table-sm table-bordered">
                        <tr>
                            <td><strong>Name</strong></td>
                            <td><span t-field="o.employee_id"/></td>
                            <td><strong>Designation</strong></td>
                            <td><span t-field="o.employee_id.job_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>Address</strong></td>
                            <td colspan="3">
                                <span class="w-100 d-block">
                                    <div><span t-out="o.employee_id.private_street"/></div>
                                    <div t-if="o.employee_id.private_street2"><span t-out="o.employee_id.private_street2"/></div>
                                    <div><span t-out="o.employee_id.private_zip"/> <span t-out="o.employee_id.private_city"/></div>
                                    <div><span t-out="o.employee_id.private_country_id.name"/></div>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Email</strong></td>
                            <td><span t-field="o.employee_id.work_email"/></td>
                            <td><strong>Identification No</strong></td>
                            <td><span t-field="o.employee_id.identification_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>Reference</strong></td>
                            <td colspan="3"><span t-field="o.id"/></td>
                        </tr>
                        <tr>
                            <td><strong>Start notice period</strong></td>
                            <td><span t-field="o.date_from"/></td>
                            <td><strong>Registration Number</strong></td>
                            <td><span t-field="o.employee_id.registration_number"/></td>
                        </tr>
                        <tr t-if="o.version_id.departure_date and o.date_to &gt; o.version_id.departure_date">
                            <td><strong>Departure Date</strong></td>
                            <td colspan="3"><span t-out="o.version_id.departure_date" t-options="{'widget': 'date'}"/></td>
                        </tr>
                    </table>

                    <div class="oe_structure"></div>
                    <table class="table table-sm">
                        <tbody>
                            <tr class="table-secondary">
                                <th><strong>Employee</strong></th>
                                <th class="text-end"><strong>Amount</strong></th>
                                <th class="text-end"><strong>Quantity</strong></th>
                                <th class="text-end"><strong>Rate</strong></th>
                                <th class="text-end"><strong>Total</strong></th>
                            </tr>
                            <tr t-foreach="o.line_ids.filtered(lambda line: any(cat.code in ['BASIC', 'DIV. IMPOS'] for cat in line.category_ids))" t-as="line">                                <td width="50%"><span  t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                            <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/></td>
                                <td class="text-end"><span t-out="line.amount" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td class="text-end">
                                    <span t-if="line.quantity != 1 and line.quantity.is_integer()" t-out="int(line.quantity)"/>
                                    <span t-elif="line.quantity != 1" t-field="line.quantity"/>
                                </td>
                                <td class="text-end"><span t-if="line.rate != 100" t-out="str(round(line.rate, 2)) + ' %'"/></td>
                                <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            </tr>
                            <tr class="table-secondary" t-foreach="o.line_ids.filtered(lambda line: line.code == 'REFERENCE_SALARY_REVALUED')" t-as="line">
                                <td class="text-center"><span t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                                <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/>
                                </td>
                                <td colspan="3"></td>
                                <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            </tr>
                            <t t-set="notice_lines" t-value="o.line_ids.filtered(lambda line: 'NOTICE_DURATION' in line.category_ids.mapped('code'))" />
                            <tr t-foreach="notice_lines" t-as="line">
                                <t t-if="line_index == 0">
                                    <td t-att-rowspan="len(notice_lines)" style="vertical-align: middle;">Notice duration</td>
                                </t>
                                <td class="text-end"><span t-out="line.quantity"/></td>
                                <td colspan="2"><span t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                                <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/>
                                </td>
                                <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            </tr>
                            <t t-foreach="o.line_ids.filtered(lambda line: 'NOTICE_SALARY' in line.category_ids.mapped('code') and line.code != 'EMPLOYERCOST')" t-as="line">
                                <tr class="table-secondary" t-if="line.code in ['NET', 'TERM_BASIC']">
                                    <td class="text-center"><span t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                                    <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/>
                                    </td>
                                    <td colspan="3"></td>
                                    <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                </tr>
                                <tr t-else="">
                                    <td colspan="4"><span t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                                    <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/>
                                    </td>
                                    <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                </tr>
                            </t>
                            <t t-foreach="o.line_ids.filtered(lambda line: line.code in ['ONSS', 'TERM_GROSS', 'P.P', 'HolPayReg', 'ATTACH_SALARY', 'ASSIG_SALARY', 'CHILD_SUPPORT', 'DEDUCTION', 'REIMBURSEMENT', 'NET'])" t-as="line">
                                <tr>
                                    <td colspan="4"><span t-if="is_html_empty(line.salary_rule_id.note)" t-field="line.name"/>
                                    <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)"/>
                                    </td>
                                    <td class="text-end"><span t-out="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-set="net_line" t-value="o.line_ids.filtered(lambda l: l.code == 'NET')[:1]" />
                    <t t-if="net_line">
                        <t t-set="allocations" t-value="o.safe_compute_salary_allocations(net_line.total)" />
                        <t t-if="'__error__' in allocations">
                            <div class="alert alert-danger mt-3">
                                <i class="oi" data-icon="warning"/> <strong>Salary allocations could not be computed:</strong>
                                <span t-out="allocations['__error__']"/>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="table table-sm mt-3">
                                <tbody>
                                    <t t-set="banks_to_pay" t-value="o.employee_id.bank_account_ids.filtered(lambda b: str(b.id) in allocations)" />
                                    <t t-foreach="banks_to_pay" t-as="bank">
                                        <tr class="table-secondary">
                                            <t t-if="bank_index == 0">
                                                <td width="40%" t-att-rowspan="len(banks_to_pay)">To Pay On</td>
                                            </t>
                                            <td class="text-end">
                                                <span t-out="bank.account_number"/>
                                                <t t-if="bank.bank_name"> - <span t-out="bank.bank_name"/></t>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="allocations[str(bank.id)]"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>
                    <div class="oe_structure"></div>
                    <p class="text-end"><strong>Established on <span t-field="o.compute_date"/></strong></p>
                    <p class="text-end"><strong>Authorized signature</strong></p>
                </div>
            </t>
        </t>
    </t>
</template>

<template id="report_termination_fees_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_fees"/>
        </t>
    </t>
</template>
</odoo>
