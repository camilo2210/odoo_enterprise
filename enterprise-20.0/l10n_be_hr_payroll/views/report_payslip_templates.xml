<?xml version="1.0"?>
<odoo>

<template id="report_termination_holiday_n1" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//h2[@id='payslip_name']/span" position="replace">
        <span>
            Holiday Certificate : Exercise <t t-out="(o.date_to-relativedelta(years=1)).strftime('%Y')"/> - Holiday year <t t-out="o.date_to.strftime('%Y')"/>
        </span>
    </xpath>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
    <div id="worked_days_table" position="replace"/>
</template>

<template id="report_termination_holiday_n1_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_holiday_n1"/>
        </t>
    </t>
</template>

<template id="report_termination_holiday_n" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//h2[@id='payslip_name']/span" position="replace">
        <span>
            Holiday Certificate : Exercise <t t-out="o.date_to.strftime('%Y')"/> - Holiday year <t t-out="(o.date_to+relativedelta(years=1)).strftime('%Y')"/>
        </span>
    </xpath>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
    <div id="worked_days_table" position="replace"/>
</template>

<template id="report_termination_holiday_n_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_holiday_n"/>
        </t>
    </t>
</template>

<template id="report_bonus_month" inherit_id="hr_payroll.report_payslip" primary="True">
    <div id="worked_days_table" position="replace"/>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
</template>

<template id="report_bonus_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_bonus_month"/>
        </t>
    </t>
</template>

<template id="report_belgium_payslip" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//div[@id='employee_person_in_charge']" position="replace">
        <t t-set="person_in_charge" t-value="o.employee_id.other_dependents"/>
        <div id="employee_person_in_charge" t-if="person_in_charge">
            <strong class="me-2">Person in Charge:</strong>
            <span t-out="person_in_charge"/>
        </div>
    </xpath>
    <xpath expr="//td[@id='employee_infos']" position="inside">
        <div id="employee_pay_category" t-if="o.version_id.l10n_be_egov3_code != '999'">
            <strong class="me-2"> Pay Category:</strong>
            <span t-field="o.version_id.structure_type_id"/>
        </div>
        <div id="employee_joint_committee1" t-if="o.version_id.l10n_be_egov3_code != '999'">
            <strong class="me-2">Joint Committee:</strong>
            <span t-field="o.version_id.l10n_be_joint_committee_id"/>
        </div>
    </xpath>

    <xpath expr="//div[@id='working_schedule']" position="attributes">
        <attribute name="t-if">o.version_id.l10n_be_egov3_code != '999'</attribute>
    </xpath>
    <div id="wage" position="after">
        <t t-set="ecovouchers" t-value="o._get_eco_vouchers_amount()"/>
        <div id="employee_eco_vouchers" t-if="ecovouchers">
            <strong class="me-2">Eco-Vouchers:</strong>
            <span t-out="round(ecovouchers, 2)"/>€<span class="me-2"/>
            (= <span t-out="int(ecovouchers // 10)"/>*10€ + 1*<span t-out="round(ecovouchers % 10, 2)"/>€)
        </div>
        <t t-set="mobility_budget" t-value="o.version_id.l10n_be_mobility_budget_amount_monthly"/>
        <div id="employee_mobility_budget" t-if="mobility_budget">
            <strong class="me-2">Mobility Budget (Monthly):</strong>
            <span t-out="mobility_budget"/> €
        </div>
    </div>
    <td id="employee_infos" position="inside">
        <div id="employee_company_car">
            <strong class="me-2" t-if="o.version_id.sudo().car_id and not o._is_outside_contract_dates()">Company Car:</strong>
            <t t-if="o.version_id.car_id and not o._is_outside_contract_dates()">
               <span t-field="o.version_id.sudo().car_id.model_id" class="me-2"/>
               [<span t-field="o.version_id.sudo().car_id.license_plate"/>]
            </t>
        </div>
    </td>
    <td id="other_infos" position="inside">
        <t t-if="o.version_id.is_worker()">
            <div id="company_holiday_pay_fund_name">
                <strong class="me-2">Holiday pay fund: </strong>
                <span t-field="o.payroll_config_id.l10n_be_holiday_pay_fund_name"/>
            </div>
            <div id="company_holiday_pay_fund_number">
                <strong class="me-2">Holiday pay fund number: </strong>
                <span t-field="o.payroll_config_id.l10n_be_holiday_pay_fund_number"/>
            </div>
        </t>
    </td>
    <div id="to_pay" position="after">
        <div id="third_party" style="page-break-before:always;">
            <table class="table table-sm table-borderless">
                <thead class="o_black_border">
                    <tr>
                        <th>Third Party Information</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="third_party_infos">
                            <div id="company_employee_accident_insurance_name" t-if="o.version_id.is_employee() and o.payroll_config_id.employee_accident_insurance_name">
                                <strong class="me-2">Accident insurance organization: </strong>
                                <span t-field="o.payroll_config_id.employee_accident_insurance_name"/>
                            </div>
                            <div id="company_employee_accident_insurance_number" t-if="o.version_id.is_employee() and o.payroll_config_id.employee_accident_insurance_number">
                                <strong class="me-2">Work accident policy number: </strong>
                                <span t-field="o.payroll_config_id.employee_accident_insurance_number"/>
                            </div>
                            <div id="company_worker_accident_insurance_name" t-if="o.version_id.is_worker() and o.payroll_config_id.worker_accident_insurance_name">
                                <strong class="me-2">Accident insurance organization: </strong>
                                <span t-field="o.payroll_config_id.worker_accident_insurance_name"/>
                            </div>
                            <div id="company_worker_accident_insurance_number" t-if="o.version_id.is_worker() and o.payroll_config_id.worker_accident_insurance_number">
                                <strong class="me-2">Work accident policy number: </strong>
                                <span t-field="o.payroll_config_id.worker_accident_insurance_number"/>
                            </div>
                            <div id="company_group_insurance_name" t-if="o.payroll_config_id.group_insurance_name">
                                <strong class="me-2">Group insurance name: </strong>
                                <span t-field="o.payroll_config_id.group_insurance_name"/>
                            </div>
                            <div id="company_group_insurance_number" t-if="o.payroll_config_id.group_insurance_number">
                                <strong class="me-2">Group insurance number: </strong>
                                <span t-field="o.payroll_config_id.group_insurance_number"/>
                            </div>
                            <div id="company_l10n_be_SEPPT_name" t-if="o.payroll_config_id.l10n_be_SEPPT_name">
                                <strong class="me-2">External service for prevention and protection at work name: </strong>
                                <span t-field="o.payroll_config_id.l10n_be_SEPPT_name"/>
                            </div>
                            <div id="company_l10n_be_SEPPT_number" t-if="o.payroll_config_id.l10n_be_SEPPT_number">
                                <strong class="me-2">External service for prevention and protection at work number: </strong>
                                <span t-field="o.payroll_config_id.l10n_be_SEPPT_number"/>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
</template>

<template id="report_belgium_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_belgium_payslip"/>
        </t>
    </t>
</template>

<template id="report_belgium_light_payslip" inherit_id="hr_payroll.report_light_payslip" primary="True">
    <tr id="pay_period" position="after">
        <t t-set="ecovouchers" t-value="o._get_eco_vouchers_amount()"/>
        <tr t-if="ecovouchers">
            <td>Eco-Vouchers:</td>
            <td class="text-end fw-bold">
                <span t-out="round(ecovouchers, 2)"/>€<span class="me-2"/>
                (= <span t-out="int(ecovouchers // 10)"/>*10€ + 1*<span t-out="round(ecovouchers % 10, 2)"/>€)
            </td>
        </tr>
    </tr>
</template>

<template id="report_belgium_light_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_belgium_light_payslip"/>
        </t>
    </t>
</template>
</odoo>
