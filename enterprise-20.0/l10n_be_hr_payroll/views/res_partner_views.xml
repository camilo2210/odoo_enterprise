<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_hr_payroll_warning_view_partner_list" model="ir.ui.view">
        <field name="name">l10nbe.hr.payroll.warning.view.partner.list</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <list>
                <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded border object-fit-contain'}" width="30" nolabel="1"/>
                <field name="complete_name" string="Name"/>
                <field name="address" string="Address"/>
                <button string="Create Work Location"
                        type="action"
                        name="%(l10n_be_hr_payroll.l10n_be_hr_payroll_action_create_dmfa_location)d"
                    context="{'default_partner_id': id}"/>
            </list>
        </field>
    </record>

    <record id="l10n_be_hr_payroll_action_warning_view_partner_list" model="ir.actions.act_window">
        <field name="name">Establishment Unit codes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="l10n_be_hr_payroll.l10n_be_hr_payroll_warning_view_partner_list"/>
    </record>
</odoo>
