<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_belgian_report_action" model="ir.actions.server">
        <field name="name">Open Belgian report</field>
        <field name="model_id" ref="hr_payroll.model_hr_payroll_warning"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_l10n_be_report_warning()
        </field>
    </record>

    <record id="cancel_draft_payslip_not_eligible_to_profit_sharing" model="ir.actions.server">
        <field name="name">Cancel Profit Sharing Bonus Payslips</field>
        <field name="model_id" ref="hr_payroll.model_hr_payroll_warning"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_cancel_draft_payslip_not_eligible_to_profit_sharing()
        </field>
    </record>

    <record id="cancel_draft_payslip_employee_less_than_one_year_service_profit_sharing" model="ir.actions.server">
        <field name="name">Cancel Profit Sharing Bonus draft payslips for employees less than 1 year of service</field>
        <field name="model_id" ref="hr_payroll.model_hr_payroll_warning"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_cancel_draft_payslip_employee_less_than_one_year_service_profit_sharing()
        </field>
    </record>

    <record id="hr_payroll_warning_view_tree" model="ir.ui.view">
        <field name="name">hr.payroll.warning.tree.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.payroll.warning</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_warning_view_tree"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
            </field>
        </field>
    </record>

    <record id="hr_payroll_warning_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.warning.form.inherit.l10n_be_hr_payroll</field>
        <field name="model">hr.payroll.warning</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_warning_view_form"/>
        <field name="arch" type="xml">
            <field name="warning_color_class" position="after">
                <field name="l10n_be_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
                <field name="l10n_be_excluded_joint_committee_ids" widget="many2many_tags" placeholder="All joint committees"/>
            </field>
        </field>
    </record>
</odoo>
