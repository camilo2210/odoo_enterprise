<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_be_salary_scale_list" model="ir.ui.view">
        <field name="name">l10n.be.salary.scale.list</field>
        <field name="model">l10n_be.salary.scale</field>
        <field name="arch" type="xml">
            <list string="Salary Scales">
                <field name="name"/>
                <field name="code"/>
                <field name="l10n_be_joint_committee" optional="show"/>
                <field name="dmfa_code" optional="hide"/>
                <field name="employer_category_id" optional="hide"/>
                <field name="egov3_code" groups="base.group_no_one"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_be_salary_scale_form" model="ir.ui.view">
        <field name="name">l10n.be.salary.scale.form</field>
        <field name="model">l10n_be.salary.scale</field>
        <field name="arch" type="xml">
            <form string="Salary Scale">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="l10n_be_joint_committee"/>
                            <field name="employer_category_id"/>
                        </group>
                        <group>
                            <field name="dmfa_code"/>
                            <field name="egov3_code" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_be_salary_scale_action" model="ir.actions.act_window">
        <field name="name">Salary Scales</field>
        <field name="res_model">l10n_be.salary.scale</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_l10n_be_salary_scale"
        name="Salary Scales"
        action="l10n_be_salary_scale_action"
        parent="menu_l10n_be_hr_payroll_configuration"
        sequence="500"/>
</odoo>
