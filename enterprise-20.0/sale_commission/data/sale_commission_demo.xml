<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="plan_manager" model="sale.commission.plan">
            <field name="name">Manager Achievement</field>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="type">achieve</field>
            <field name="user_type">team</field>
            <field name="team_id" ref="sales_team.team_sales_department"/>
            <field name="state">approved</field>
        </record>

        <record id="plan_manager_user" model="sale.commission.plan.user">
            <field name="user_id" ref="base.user_admin"/>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="plan_id" ref="plan_manager"/>
        </record>

        <record id="plan_user" model="sale.commission.plan">
            <field name="name">Salesperson Targets</field>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="commission_amount">1500</field>
            <field name="type">target</field>
            <field name="state">approved</field>
            <field name="achievement_ids" eval="False"/>
        </record>

        <record id="plan_user_user" model="sale.commission.plan.user">
            <field name="user_id" ref="base.user_demo"/>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <function model="sale.commission.plan" name="_compute_targets" context="{'force_target_amount': True}">
            <value eval="[ref('sale_commission.plan_user')]"/>
            <value>25000</value>
        </function>

        <record id="plan_user_achievement" model="sale.commission.plan.achievement">
            <field name="type">amount_invoiced</field>
            <field name="rate">1</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_1" model="sale.commission.plan.target.commission">
            <field name="target_rate">0</field>
            <field name="amount">0</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_2" model="sale.commission.plan.target.commission">
            <field name="target_rate">0.5</field>
            <field name="amount">0</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_3" model="sale.commission.plan.target.commission">
            <field name="target_rate">1</field>
            <field name="amount">1500</field>
            <field name="amount_rate">1</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_4" model="sale.commission.plan.target.commission">
            <field name="target_rate">1.5</field>
            <field name="amount">3000</field>
            <field name="amount_rate">2</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_5" model="sale.commission.plan.target.commission">
            <field name="target_rate">2</field>
            <field name="amount">6000</field>
            <field name="amount_rate">4</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_user_target_commission_6" model="sale.commission.plan.target.commission">
            <field name="target_rate">3</field>
            <field name="amount">13500</field>
            <field name="amount_rate">9</field>
            <field name="plan_id" ref="plan_user"/>
        </record>

        <record id="plan_dynamic" model="sale.commission.plan">
            <field name="name">Team Leader Targets</field>
            <field name="date_from" eval="DateTime.today().replace(day=15, hour=12) - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today().replace(day=15, hour=12) + relativedelta(day=31, month=12)"/>
            <field name="commission_amount">1000</field>
            <field name="type">target</field>
            <field name="target_type">dynamic</field>
            <field name="state">approved</field>
            <field name="dynamic_plan_ids" eval="[(4, ref('plan_user'))]"/>
            <field name="achievement_ids" eval="False"/>
        </record>

        <record id="plan_dynamic_achievement" model="sale.commission.plan.achievement">
            <field name="type">amount_invoiced</field>
            <field name="rate">0.5</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_user_user_1" model="sale.commission.plan.user">
            <field name="user_id" ref="base.user_admin"/>
            <!-- start current quarter -->
            <field name="date_from"
                eval="DateTime.today().replace(day=15, hour=12) + relativedelta(months=-((DateTime.today().month - 1) % 3), day=1)"
            />
             <!-- end current quarter -->
            <field name="date_to"
                eval="DateTime.today().replace(day=15) + relativedelta(months=3, days=-1) + relativedelta(months=-((DateTime.today().month - 1) % 3), day=1) - relativedelta(days=1)"/>
            <field name="plan_id" ref="plan_dynamic"/>
            <field name="user_ids" eval="[(4, ref('base.user_demo')), (4, ref('base.demo_user0'))]"/>
        </record>

        <record id="plan_dynamic_user_user_2" model="sale.commission.plan.user">
            <field name="user_id" ref="base.user_admin"/>
             <!-- start next quarter -->
            <field name="date_from"
                eval="DateTime.today().replace(day=15, month=6) +relativedelta(months=3, days=-1) + relativedelta(months=-((DateTime.today().replace(month=6, day=15).month - 1) % 3), day=1)" />
            <field name="plan_id" ref="plan_dynamic"/>
            <field name="user_ids" eval="[(4, ref('base.user_demo'))]"/>
        </record>

        <record id="plan_dynamic_target_commission_1" model="sale.commission.plan.target.commission">
            <field name="target_rate">0</field>
            <field name="amount">0</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_target_commission_2" model="sale.commission.plan.target.commission">
            <field name="target_rate">0.5</field>
            <field name="amount">300</field>
            <field name="amount_rate">0.3</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_target_commission_3" model="sale.commission.plan.target.commission">
            <field name="target_rate">0.5</field>
            <field name="amount">500</field>
            <field name="amount_rate">0.5</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_target_commission_4" model="sale.commission.plan.target.commission">
            <field name="target_rate">1</field>
            <field name="amount">800</field>
            <field name="amount_rate">0.8</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_target_commission_5" model="sale.commission.plan.target.commission">
            <field name="target_rate">1</field>
            <field name="amount">800</field>
            <field name="amount_rate">1</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

        <record id="plan_dynamic_target_commission_6" model="sale.commission.plan.target.commission">
            <field name="target_rate">3</field>
            <field name="amount">1500</field>
            <field name="amount_rate">1.5</field>
            <field name="plan_id" ref="plan_dynamic"/>
        </record>

    </data>
</odoo>
