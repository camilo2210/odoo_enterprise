<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_commission_achievement_view_list" model="ir.ui.view">
        <field name="name">sale.commission.achievement.view.list</field>
        <field name="model">sale.commission.achievement</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date" readonly="readonly"/>
                <field name="add_user_id" options="{'no_quick_create': True}" readonly="readonly"/>
                <field name="add_plan_id" options="{'no_quick_create': True, 'no_create_edit': True}" domain="[('user_ids.user_id', 'in', add_user_id), ('date_to', '&gt;', date)]" readonly="readonly"/>
                <field name="reduce_user_id" options="{'no_quick_create': True}" readonly="readonly"/>
                <field name="reduce_plan_id" options="{'no_quick_create': True, 'no_create_edit': True}" domain="[('user_ids.user_id', 'in', reduce_user_id), ('date_to', '&gt;', date)]" readonly="readonly"/>
                <field name="company_id" optional="hide" readonly="readonly"/>
                <field name="achieved" sum="Total Achieved" readonly="readonly"/>
                <field name="currency_id" optional="hide" readonly="readonly"/>
                <field name="order_id" optional="hide" readonly="readonly"/>
                <field name="move_id" optional="hide" readonly="readonly"/>
                <field name="note" readonly="readonly"/>
                <field name="readonly" widget="boolean_toggle" groups="sales_team.group_sale_manager"/>
            </list>
        </field>
    </record>

    <record id="sale_commission_achievement_view_search" model="ir.ui.view">
        <field name="name">sale.commission.achievement.view.search</field>
        <field name="model">sale.commission.achievement</field>
        <field name="arch" type="xml">
            <search string="Commission Achievement">
                <field name="add_user_id"/>
                <field name="add_plan_id"/>
                <field name="reduce_user_id"/>
                <field name="reduce_plan_id"/>
                <field name="date"/>
            </search>
        </field>
    </record>

    <record id="sale_commission_action_achievement" model="ir.actions.act_window">
        <field name="name">Adjustments</field>
        <field name="res_model">sale.commission.achievement</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="sale_commission_achievement_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an adjustment
            </p>
            <p>
                Allows you to manually adjust a salesperson's achievements
                for a specific period and commission plan.
            </p>
        </field>
    </record>
</odoo>
