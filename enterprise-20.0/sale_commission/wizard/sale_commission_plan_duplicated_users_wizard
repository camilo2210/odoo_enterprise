<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_plan_issue_user_wizard_form" model="ir.ui.view">
        <field name="name">sale.commission.plan.issue.wizard.form</field>
        <field name="model">sale.commission.plan.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="TODO">
                <header invisible="not issue_user_ids">
                    <div>Achievements whose users are present in different plans. Period overlap and
                        gaps are detected.
                    </div>
                </header>
                <header invisible="issue_user_ids">
                    <div>Congratulations, no conflicting line has been found!</div>
                </header>
                <group invisible="not issue_user_ids">
                    <field name="issue_user_ids" mode="list" nolabel="1">
                        <list>
                            <field name="issue_type" />
                            <field name="user_id" />
                            <field name="sale_user_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="plan_id" />
                            <field name="conflicting_plan_id" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button class="btn-secondary" special="cancel" data-hotkey="x" string="Close" />
                </footer>
            </form>
        </field>
    </record>

    <record id="duplicated_user_wizard_action" model="ir.actions.act_window">
        <field name="name">Conflicting lines</field>
        <field name="res_model">sale.commission.plan.issue.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_commission_plan_issue_user_wizard_form" />
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

</odoo>
