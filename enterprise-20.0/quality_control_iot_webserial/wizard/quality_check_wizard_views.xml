<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_check_wizard_inherit_iot_webserial" model="ir.ui.view">
        <field name="name">quality_check_wizard_inherit_iot_webserial</field>
        <field name="model">quality.check.wizard</field>
        <field name="inherit_id" ref="quality_control.view_quality_check_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='do_measure']" position="before">
                <widget name="quality_control_iot_webserial.scale_measure" invisible="test_type != 'measure' or norm_unit != 'kg'"/>
            </xpath>
        </field>
    </record>
</odoo>
