<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payslip_id" model="ir.actions.report">
        <field name="name">ID: Payslip</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_id_hr_payroll.report_payslip_id_lang</field>
        <field name="print_report_name">'Payslip - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <record id="hr_payroll_structure_id_employee_salary" model="hr.payroll.structure">
        <field name="report_id" ref="action_report_payslip_id"/>
    </record>
</odoo>
