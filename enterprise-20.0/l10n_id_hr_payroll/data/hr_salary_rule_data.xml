        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP'), ref('l10n_id_benefits_parent_category')])]"/>
        <field name="name">(Allowance) BPJS Kesehatan</field>
        <field name="code">BPJS_Kesehatan</field>
        <field name="sequence">60</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = inputs.get('IN_BPJS_KES') and inputs['IN_BPJS_KES'].amount and not l10n_id_bpjs_kesehatan_deferred</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = min(categories['BASIC'], payslip._rule_parameter('l10n_id_bpjs_salary_threshold'))
result_rate = payslip._rule_parameter('l10n_id_alw_bpjs_kesehatan_percent')
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_id_hr_payroll.hr_payroll_structure_id_employee_salary'),
