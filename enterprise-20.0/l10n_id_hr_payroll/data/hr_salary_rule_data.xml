        <field name="name">(Allowance) BPJS JKK</field>
        <field name="code">BPJS_JKK</field>
        <field name="sequence">60</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = version.l10n_id_bpjs_jkk and (inputs['IN_JKK_JKM'].amount if 'IN_JKK_JKM' in inputs else 0.0)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['BASIC'] * version.l10n_id_bpjs_jkk
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_id_hr_payroll.hr_payroll_structure_id_employee_salary'),
