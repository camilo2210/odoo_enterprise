#. module: account_online_synchronization
#: model:mail.template,body_html:account_online_synchronization.email_template_sync_reminder
msgid ""
"<div style=\"font-size: 14px;\">\n"
"                    <t t-set=\"base_url\" t-value=\"object.get_base_url()\"/"
">\n"
"                    <p>\n"
"                        Dear <t t-out=\"object.bank_account_id.holder_name "
"or ''\">Marc Demo</t>,<br/><br/>\n"
"                        The connection between <b><a t-att-href=\"base_url\" "
"t-out=\"base_url or ''\">https://yourcompany.odoo.com</a></b>\n"
"                        and <t t-out=\"object.account_online_link_id.name or "
"''\">Belfius</t>\n"
"                        <t t-if=\"not "
"object.expiring_synchronization_due_day\">expired.</t>\n"
"                        <t t-else=\"\">expires in <t t-"
"out=\"object.expiring_synchronization_due_day or ''\">10</t> days.</t>\n"
"                    </p>\n"
"                    <p>Renew your consent to keep using bank synchronization "
"seamlessly with Odoo.</p>\n"
"                    <t t-set=\"renew_concent_url\" t-value=\"base_url + '/"
"renew_consent/%s?access_token=%s' % (object.id, object.access_token)\"/>\n"
"                    <div style=\"margin:16px auto; text-align:center\">\n"
"                        <a t-att-href=\"renew_concent_url\" t-attf-"
"style=\"padding: 8px 16px 8px 16px; border-radius: 3px; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; "
"text-decoration:none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}};\">\n"
"                            Renew Consent\n"
"                        </a>\n"
"                    </div>\n"
"                    <p>This is an automated email sent by Odoo Accounting to "
"remind you before a bank sync consent expiration.</p>\n"
"                </div>\n"
"            "
msgstr ""

