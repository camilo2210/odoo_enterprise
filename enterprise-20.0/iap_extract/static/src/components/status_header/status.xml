<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_invoice_extract.Status">
        <div t-if="this.state.status === 'error_status'" class="alert alert-danger text-center">
            <t t-out="this.state.errorMessage" class="oe_inline" style="width:auto !important;"/>
            <button t-att-disabled="this.state.retryLoading" type="object" t-on-click="this.retryDigitalization" class="btn btn-link">
                <i class="oi oi-fw o_button_icon" data-icon="east"/>
                Retry
            </button>
        </div>
        <div t-if="['waiting_extraction', 'extract_not_ready'].includes(this.state.status)" class="alert alert-info text-center">
            All fields will be automatically populated by Artificial Intelligence, it might take 5 seconds.
            <button t-att-disabled="this.state.checkStatusLoading" type="object" class="btn btn-link" t-on-click="this.checkOcrStatus">
                <i class="oi oi-fw o_button_icon" data-icon="east"/>
                Refresh
            </button>
        </div>
        <div t-if="this.state.status === 'not_enough_credit'" class="alert alert-danger text-center">
            Not enough credit to scan your document.
            <button t-att-disabled="this.state.retryLoading" type="object" t-on-click="this.buyCredits" class="btn btn-link">
                <i class="oi oi-fw o_button_icon" data-icon="east"/>
                Buy
            </button>
            <button t-att-disabled="this.state.retryLoading" type="object" t-on-click="this.retryDigitalization" class="btn btn-link">
                <i class="oi oi-fw o_button_icon" data-icon="east"/>
                Retry
            </button>
        </div>
        <div t-if="['waiting_validation', 'to_validate', 'done'].includes(this.state.status)" class="alert alert-success text-center">
            Document successfully parsed. Please refresh.
            <button type="object" class="btn btn-link" t-on-click="this.refreshPage">
                <i class="oi oi-fw o_button_icon" data-icon="east"/>
                Refresh
            </button>
        </div>
    </t>
</templates>
