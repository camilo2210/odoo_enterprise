<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_latam_form" model="ir.ui.view">
        <field name="name">view.partner.latam.form.inherit.l10n_uy_edi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='additional_identifiers' and @widget='additional_identifiers_button']" position="before">
                <button name="button_l10n_uy_populate_from_vat"
                        type="object"
                        class="btn-link w-auto"
                        invisible="country_code != 'UY' or not vat">
                    <i title="Fetch from DGI" role="img" aria-label="Fetch from DGI"
                       class="oi oi-fw" data-icon="refresh"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
