<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group name="annual_leave_provision" string="Annual Leave Provision" invisible="country_code != 'IQ'">
                    <label for="l10n_iq_annual_leave_provision_eligibility" string="Eligibility"/>
                    <div class="o_row o_hr_narrow_field" >
                        <field name="l10n_iq_annual_leave_provision_eligibility" nolabel="1"/>
                        <span>days / year</span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
