<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <block title="Iraq Payroll" id="iq_payroll_settings" invisible="company_country_code != 'IQ'">
                    <setting string="In oil and gas business" help="Used to determine the employees social insurance contribution percentages">
                        <field name="l10n_iq_is_oil_and_gas_company"/>
                    </setting>
                    <setting string="Annual Leave Time-off Type" help="Set the time off type used as Annual Leave">
                        <field name="l10n_iq_annual_work_entry_type_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
