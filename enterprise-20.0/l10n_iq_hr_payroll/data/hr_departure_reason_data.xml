        <field name="name">Contract terminated</field>
        <field name="l10n_iq_reason_type">contract_terminated</field>
        <field name="country_id" ref="base.iq"/>
    </record>

    <record id="iq_departure_misconduct" model="hr.departure.reason">
        <field name="sequence">5</field>
        <field name="name">Misconduct</field>
        <field name="l10n_iq_reason_type">misconduct</field>
