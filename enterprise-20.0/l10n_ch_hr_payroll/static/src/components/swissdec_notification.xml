<templates xml:space="preserve">
<t t-name="swissdec_notification_template">
    <t t-if="this.props.notifications">
        <t t-if="this.props.type == 'warning'">
            <div class="alert alert-warning mt-2" role="alert">
                <h4 class="alert-heading"><i class="oi me-2" data-icon="warning"></i>Warnings</h4>
                <hr/>
                <ul class="list-unstyled mb-0">
                    <t t-foreach="this.props.notifications" t-as="notif" t-key="notif_index">
                        <li class="mb-2">
                            <span class="badge rounded-pill bg-300">Code: <t t-out="notif.DescriptionCode"/></span>
                            <span class="badge rounded-pill bg-300 ms-2">Quality Level: <t t-out="notif.QualityLevel"/></span>
                            <div class="mt-1 text-muted">
                                <t t-out="notif.Description"/>
                            </div>
                        </li>
                    </t>
                </ul>
            </div>
        </t>

        <t t-elif="this.props.type == 'error'">
            <div class="alert alert-danger mt-2" role="alert">
                <h4 class="alert-heading"><i class="oi oi-filled me-2" data-icon="cancel"></i>Errors</h4>
                <hr/>
                <ul class="list-unstyled mb-0">
                    <t t-foreach="this.props.notifications" t-as="notif" t-key="notif_index">
                        <li class="mb-2">
                            <span class="badge rounded-pill bg-300">Code: <t t-out="notif.DescriptionCode"/></span>
                            <span class="badge rounded-pill bg-300 ms-2">Quality Level: <t t-out="notif.QualityLevel"/></span>
                            <div class="mt-1 text-muted">
                                <t t-out="notif.Description"/>
                            </div>
                        </li>
                    </t>
                </ul>
            </div>
        </t>

        <t t-else="">
            <div class="alert alert-info mt-2" role="alert">
                <h4 class="alert-heading"><i class="oi me-2" data-icon="info"></i>Information</h4>
                <hr/>
                <ul class="list-unstyled mb-0">
                    <t t-foreach="this.props.notifications" t-as="notif" t-key="notif_index">
                        <li class="mb-2">
                            <span class="badge rounded-pill bg-300">Code: <t t-out="notif.DescriptionCode"/></span>
                            <span class="badge rounded-pill bg-300 ms-2">Quality Level: <t t-out="notif.QualityLevel"/></span>
                            <div class="mt-1 text-muted">
                                <t t-out="notif.Description"/>
                            </div>
                        </li>
                    </t>
                </ul>
            </div>
    </t>
    </t>
</t>
</templates>