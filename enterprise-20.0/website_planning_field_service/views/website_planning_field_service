<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="service_requests" name="Service Requests">
        <t t-call="website.layout" additional_title.translate="Service Requests">
            <div id="wrap">
                <div class="oe_structure oe_empty mb-2" id="oe_structure_website_planning_field_service_1"/>
                <div class="container pt16">
                    <div class="text-center">
                        <h1 class="h2-fs">Service Requests</h1>
                        <p class="lead">Tell us what you need. We'll get back to you to schedule the service.</p>
                    </div>
                </div>
                <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                    <div class="container">
                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required o_service_requests_form o_address_autocomplete" data-mark="*" data-success-mode="redirect" data-success-page="/service-requests/submitted" data-model_name="planning.slot" hide-change-model="true">
                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                <!-- Full Name -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-6 s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_name">
                                        <span class="s_website_form_label_content">Full Name</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="partner_name" required="1" data-fill-with="name" id="rs_name"/>
                                </div>
                                <!-- Company Name -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-6" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_company">
                                        <span class="s_website_form_label_content">Company Name</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="partner_company_name" data-fill-with="parent_name" id="rs_company"/>
                                </div>
                                <!-- Phone Number -->
                                <div class="mb-3 s_website_form_field col-12 col-md-6 s_website_form_required" data-type="tel" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_phone">
                                        <span class="s_website_form_label_content">Phone Number</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input type="tel" class="form-control s_website_form_input" name="partner_phone" required="1" data-fill-with="phone" id="rs_phone"/>
                                </div>
                                <!-- Email Address -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-6" data-type="email" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_email">
                                        <span class="s_website_form_label_content">Email Address</span>
                                    </label>
                                    <input type="email" class="form-control s_website_form_input" name="partner_email" data-fill-with="email" id="rs_email"/>
                                </div>
                                <!-- Address: Street -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_street">
                                        <span class="s_website_form_label_content">Street and Number</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="street" required="1" data-fill-with="street" id="rs_street"/>
                                </div>
                                <!-- Address: Street 2 -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_street2">
                                        <span class="s_website_form_label_content">Apartment, suite, etc.</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="street2" data-fill-with="street2" id="rs_street2"/>
                                </div>
                                <!-- Address: City -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-8 s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_city">
                                        <span class="s_website_form_label_content">City</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="city" required="1" data-fill-with="city" id="rs_city"/>
                                </div>
                                <!-- Address: ZIP -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-4 s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_zip">
                                        <span class="s_website_form_label_content">Zip Code</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input type="text" class="form-control s_website_form_input" name="zip" required="1" data-fill-with="zip" id="rs_zip"/>
                                </div>
                                <!-- Address: Country -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-6 s_website_form_required" data-type="many2one" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_country">
                                        <span class="s_website_form_label_content">Country</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <select class="form-select s_website_form_input" name="country_id" required="1" data-fill-with="country_id" id="rs_country">
                                        <option value="">Select a country...</option>
                                    </select>
                                </div>
                                <!-- Address: State -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12 col-md-6 s_website_form_required" data-type="many2one" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_state">
                                        <span class="s_website_form_label_content">State / Province</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <select class="form-select s_website_form_input" name="state_id" required="1" disabled="disabled" data-fill-with="state_id" data-link-state-to-country="false" id="rs_state">
                                        <option value="">Select a state...</option>
                                    </select>
                                </div>
                                <!-- Type of Request -->
                                <div class="mb-3 s_website_form_field col-12 s_website_form_required" data-type="many2one" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_role">
                                        <span class="s_website_form_label_content">Type of Request</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <select class="form-select s_website_form_input" name="role_id" required="1" id="rs_role">
                                        <option value="">Select a type...</option>
                                    </select>
                                </div>
                                <!-- Impact Level -->
                                <div class="mb-3 s_website_form_field col-12" data-type="selection" data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor align-items-center">
                                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                                            <span class="s_website_form_label_content">Impact Level</span>
                                        </label>
                                        <div class="col-sm">
                                            <div class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple" data-name="priority" data-display="horizontal">
                                                <div class="radio col-12 col-lg-3 col-md-6">
                                                    <div class="form-check">
                                                        <input type="radio" class="s_website_form_input form-check-input" name="priority" value="3" id="rs_priority_urgent"/>
                                                        <label class="form-check-label s_website_form_check_label" for="rs_priority_urgent">Not operational</label>
                                                    </div>
                                                </div>
                                                <div class="radio col-12 col-lg-3 col-md-6">
                                                    <div class="form-check">
                                                        <input type="radio" class="s_website_form_input form-check-input" name="priority" value="2" id="rs_priority_high"/>
                                                        <label class="form-check-label s_website_form_check_label" for="rs_priority_high">Limited operation</label>
                                                    </div>
                                                </div>
                                                <div class="radio col-12 col-lg-3 col-md-6">
                                                    <div class="form-check">
                                                        <input type="radio" class="s_website_form_input form-check-input" name="priority" value="1" id="rs_priority_medium"/>
                                                        <label class="form-check-label s_website_form_check_label" for="rs_priority_medium">Minor impact</label>
                                                    </div>
                                                </div>
                                                <div class="radio col-12 col-lg-3 col-md-6">
                                                    <div class="form-check">
                                                        <input type="radio" class="s_website_form_input form-check-input" name="priority" value="0" id="rs_priority_low"/>
                                                        <label class="form-check-label s_website_form_check_label" for="rs_priority_low">No impact</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Description -->
                                <div class="mb-3 s_website_form_field col-12" data-type="text" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_description">
                                        <span class="s_website_form_label_content">Description</span>
                                    </label>
                                    <textarea class="form-control s_website_form_input" name="name" rows="3" id="rs_description"/>
                                </div>
                                <!-- Photos -->
                                <div class="mb-3 s_website_form_field s_website_form_custom col-12" data-type="binary" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="rs_photos">
                                        <span class="s_website_form_label_content">Photos</span>
                                    </label>
                                    <input type="file" class="form-control s_website_form_input" name="photos" accept="image/*" multiple="multiple" data-max-files-number="10" data-max-file-size="25" id="rs_photos"/>
                                </div>
                                <!-- Submit Button -->
                                <div class="mb-0 py-2 col-12 s_website_form_submit text-end" data-name="Submit Button">
                                    <span id="s_website_form_result"/>
                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit Request</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_website_planning_field_service_2"/>
            </div>
        </t>
    </template>

    <template id="service_requests_submitted" name="Service Request Submitted">
        <t t-call="website.layout" additional_title.translate="Thank you">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt80 pb80" data-snippet="s_text_block" data-name="Thank You Section">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-8 mx-auto text-center">
                                <i class="oi oi-2x oi-filled mb-3 rounded-circle text-bg-success" data-icon="send" role="presentation"/>
                                <h1 class="fw-bolder">Thank You!</h1>
                                <p class="lead">We've received your service request. <br/>Our team will get back to you shortly.</p>
                                <a href="/">Go to Homepage</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
