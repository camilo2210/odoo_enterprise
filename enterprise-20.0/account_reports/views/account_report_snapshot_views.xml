<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snpashots_list_view" model="ir.ui.view">
            <field name="name">account.report.snapshot.list</field>
            <field name="model">account.report.snapshot</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="report_id"/>
                    <field name="groupby"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="engine_func" optional="hide"/>
                    <field name="engine_version" optional="hide"/>
                    <field name="date_scope" optional="hide"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
