<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <setting id="default_taxes" position="after">
                <setting id="account_return_periodicity" string="Tax Return Periodicity" company_dependent="1" groups="account.group_account_user" help="How often tax returns have to be made"
                    documentation="/applications/finance/accounting/reporting/declarations/tax_returns.html"
                    invisible="vat_disabled">
                    <div class="content-group">
                        <div class="row mt16" id="account_return_periodicity_field">
                            <label string="Periodicity" for="account_return_periodicity" class="col-lg-3 o_light_label"/>
                            <field name="account_return_periodicity"/>
                        </div>
                        <div class="row">
                            <label string="Deadline" for="account_return_reminder_day" class="col-lg-3 o_light_label"/>
                            <div class="col-lg-auto content-group">
                                <field name="account_return_reminder_day" class="text-center oe_inline" /> days after period
                            </div>
                        </div>
                        <div class="row">
                            <label string="Journal" for="account_tax_return_journal_id" class="col-lg-3 o_light_label"/>
                            <field name="account_tax_return_journal_id" required="has_chart_of_accounts"/>
                        </div>
                        <div class="mt8">
                            <button name="open_tax_return_type_list" icon="east" type="object" string="Configure your tax returns" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </setting>

            <block id="account_reports_settings" position="inside">
                <setting title="This allows you to choose the position of totals in your financial reports." company_dependent="1" help="When ticked, totals and subtotals appear below the sections of the report">
                    <field name="totals_below_sections"/>
                </setting>
                <setting title="Negative Number Format" company_dependent="1" help="How negative amounts are displayed on financial reports.">
                    <field name="account_reports_negative_format"/>
                </setting>
                <setting>
                    <button name="%(account.action_check_hash_integrity)d" type="action" string="Download the Data Inalterability Check Report" class="oe_link" id="action_hash_integrity"/>
                </setting>
            </block>

        </field>
    </record>

</odoo>
