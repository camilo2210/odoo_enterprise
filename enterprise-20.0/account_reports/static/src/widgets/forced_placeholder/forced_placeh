<?xml version="1.0" encoding="UTF-8"?>
<!-- Displays the placeholder even when the field is empty and readonly. -->
<templates xml:space="preserve">

    <t t-name="account_reports.ForcedPlaceholderField">
        <ForcedPlaceholder t-props="this.m2oProps"/>
    </t>

    <t t-name="account_reports.ForcedPlaceholder" t-inherit="web.Many2One">
        <xpath expr="//t[@t-if='this.props.value']" position="after">
            <t t-else="">
                <span t-out="this.props.placeholder"/>
            </t>
        </xpath>
    </t>

</templates>
