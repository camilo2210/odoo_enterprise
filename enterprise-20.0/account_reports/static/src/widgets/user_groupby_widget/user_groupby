<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="account_reports.UserGroupbyWidget">
        <div
            class="d-flex flex-wrap gap-1"
            t-att-class="{'o_input': !this.props.readonly}"
            t-ref="this.elRef"
            t-on-focusin="this.onFocusin"
            t-on-keydown="this.onKeydown"
        >
            <t t-foreach="this.tags" t-as="tag" t-key="tag_index">
                <t t-if="!this.props.readonly">
                    <div class="o_account_reports_groupby_input o_account_reports_groupby_input_small">
                        <AutoComplete
                            sources="this.sources"
                            onInput.bind="this.onInput"
                        />
                    </div>
                </t>
                <div tabindex="0" class="o_account_reports_groupby">
                    <BadgeTag
                        text="tag.text"
                        color="tag.colorIndex"
                        onDelete="tag.onDelete"
                    />
                </div>
            </t>
            <t t-if="!this.props.readonly">
                <div class="o_account_reports_groupby_input flex-grow-1">
                    <AutoComplete sources="this.sources"/>
                </div>
            </t>
        </div>
    </t>

</templates>
