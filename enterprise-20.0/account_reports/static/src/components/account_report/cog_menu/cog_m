<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_reports.AccountReportCogMenu">
        <t t-if="this.cogButtons.length">
            <Dropdown>
                <button class="btn p-0 ms-1 border-0">
                    <i class="oi oi-fw oi-filled" data-icon="settings"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="this.cogButtons" t-as="cogButton" t-key="cogButton_index">
                        <DropdownItem onSelected="cogButton.onClick">
                            <t t-out="cogButton.name"/>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
        </t>
    </t>
</templates>
