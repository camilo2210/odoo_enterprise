<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="partner_ledger_report" model="account.report">
        <field name="name">Partner Ledger</field>
        <field name="groupby">partner_id,id</field>
        <field name="filter_period_comparison" eval="False"/>
        <field name="search_bar" eval="True"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_account_type">both</field>
        <field name="filter_multi_company">selector</field>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="load_more_limit" eval="80"/>
        <field name="enable_snapshots" eval="True"/>
        <field name="custom_handler_model_id" ref="model_account_partner_ledger_report_handler"/>
        <field name="column_ids">
            <record id="partner_ledger_report_journal_code" model="account.report.column">
                <field name="name">Journal</field>
                <field name="expression_label">journal_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_account_code" model="account.report.column">
                <field name="name">Account</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_invoicing_date" model="account.report.column">
                <field name="name">Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="partner_ledger_report_date_maturity" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
            </record>
            <record id="partner_ledger_report_matching_number" model="account.report.column">
                <field name="name">Matching</field>
                <field name="expression_label">matching_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="partner_ledger_report_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="partner_ledger_report_amount_currency" model="account.report.column">
                <field name="name">Amount Currency</field>
                <field name="expression_label">amount_currency</field>
            </record>
            <record id="partner_ledger_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="partner_ledger_report_line" model="account.report.line">
                <field name="name">Partner Ledger</field>
                <field name="code">PARTNER_LEDGER</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="partner_ledger_report_expression_journal_code" model="account.report.expression">
                        <field name="label">journal_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">journal_code</field>
                    </record>
                    <record id="partner_ledger_report_expression_account_code" model="account.report.expression">
                        <field name="label">account_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">account_code</field>
                    </record>
                    <record id="partner_ledger_report_expression_invoice_date" model="account.report.expression">
                        <field name="label">invoice_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">invoice_date</field>
                    </record>
                    <record id="partner_ledger_report_expression_date_maturity" model="account.report.expression">
                        <field name="label">date_maturity</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">date_maturity</field>
                    </record>
                    <record id="partner_ledger_report_expression_matching_number" model="account.report.expression">
                        <field name="label">matching_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">matching_number</field>
                    </record>
                    <record id="partner_ledger_report_expression_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">debit</field>
                        <field name="blank_if_zero" eval="True"/>
                    </record>
                    <record id="partner_ledger_report_expression_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">credit</field>
                        <field name="blank_if_zero" eval="True"/>
                    </record>
                    <record id="partner_ledger_report_expression_amount_currency" model="account.report.expression">
                        <field name="label">amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount_currency</field>
                        <field name="blank_if_zero" eval="True"/>
                    </record>
                    <record id="partner_ledger_report_expression_currency_amount_currency" model="account.report.expression">
                        <field name="label">_currency_amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">_currency_amount_currency</field>
                    </record>
                    <record id="partner_ledger_report_expression_init_balance" model="account.report.expression">
                        <field name="label">init_balance</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_initial_balance</field>
                        <field name="subformula">init_balance</field>
                        <field name="date_scope">to_beginning_of_period</field>
                        <field name="figure_type">monetary</field>
                    </record>
                    <record id="partner_ledger_report_expression_period_balance" model="account.report.expression">
                        <field name="label">period_balance</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">period_balance</field>
                        <field name="figure_type">monetary</field>
                    </record>
                    <record id="partner_ledger_report_expression_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">PARTNER_LEDGER.init_balance + PARTNER_LEDGER.period_balance</field>
                        <field name="subformula" eval="False"/>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="partner_ledger_report_expression_currency_residual_currency_at_date" model="account.report.expression">
                        <field name="label">_currency_residual_currency_at_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">_currency_amount_currency</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
