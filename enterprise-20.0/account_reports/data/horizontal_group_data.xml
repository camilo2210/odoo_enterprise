<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Horizontal Group based on Ledgers-->
        <record id="horizontal_group_ledger" model="account.report.horizontal.group">
            <field name="name">Ledger</field>
        </record>

        <record id="horizontal_group_ledger_rule" model="account.report.horizontal.group.rule">
            <field name="horizontal_group_id" ref="horizontal_group_ledger"/>
            <field name="field_name">journal_group_id</field>
            <field name="domain">[]</field>
        </record>
    </data>
</odoo>
