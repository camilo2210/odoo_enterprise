<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-att-class">{ 'highlight active': this.highlightInvoiceButton() }</attribute>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]/i" position="attributes">
            <attribute name="t-att-class">{ 'text-action oi-filled': this.highlightInvoiceButton() }</attribute>
            <attribute name="t-attf-data-icon">{ this.highlightInvoiceButton() ? 'check_box' : 'square' }</attribute>
       </xpath>
    </t>
</templates>
