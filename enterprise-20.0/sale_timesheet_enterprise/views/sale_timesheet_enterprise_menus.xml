<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="timesheet_grid.hr_timesheet_enterprise_menu_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[
            Command.set([
                ref('base.group_system'),
                ref('hr_timesheet.group_hr_timesheet_approver'),
                ref('timesheet_grid.group_timesheet_assistant'),
            ]),
        ]"/>
    </record>

    <menuitem id="hr_timesheet_menu_employee_configuration"
        name="Billable Time"
        sequence="15"
        parent="timesheet_grid.hr_timesheet_enterprise_menu_configuration"
    >
        <menuitem id="hr_timesheet_menu_employee_billable_time_target"
            name="Employee Targets"
            action="action_open_edit_billable_time_target"
            sequence="10"
        />

        <menuitem id="hr_timesheet_menu_employee"
            name="Employee Targets"
            action="action_open_view_employee"
            sequence="10"
            groups="hr.group_hr_user"
        />

        <menuitem id="hr_timesheet_menu_configuration_tips"
            name="Tips"
            action="hr_timesheet_tip_action"
            sequence="20"
            groups="hr_timesheet.group_timesheet_manager"
        />
    </menuitem>

</odoo>
