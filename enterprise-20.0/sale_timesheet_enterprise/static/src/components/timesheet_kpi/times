<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="sale_timesheet_enterprise.TimesheetKpi">
        <div class="d-flex align-items-center gap-2"
            t-att-name="this.props.name"
            t-att-title="this.props.title"
            t-att-class="this.props.extraClass"
            t-on-click="this.props.onClick"
        >
            <span class="fw-bold fs-1" t-att-class="this.props.valueExtraClass">
                <span t-out="this.props.value"/>
                <span class="small text-muted" t-if="this.props.target">
                    /
                    <t t-out="this.props.target"/>
                </span>
            </span>
            <div class="d-flex flex-column lh-1 text-start text-muted text-lowercase">
                <t t-foreach="this.props.label.split(' ')" t-as="word" t-key="word_index">
                    <span t-out="word"/>
                </t>
            </div>
        </div>
    </t>

</templates>
