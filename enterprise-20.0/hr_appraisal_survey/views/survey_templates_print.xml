<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="survey_page_print" inherit_id="survey.survey_page_print">
            <xpath expr="//div[hasclass('o_survey_print')]//h1" position="inside">
                <t t-if="survey.survey_type == 'appraisal' and answer.appraisal_id.display_name">
                    for <t t-out="answer.appraisal_id.display_name"/>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
