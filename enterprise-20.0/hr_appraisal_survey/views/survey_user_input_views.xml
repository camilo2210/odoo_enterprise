<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_appraisal_survey_user_input_view_tree" model="ir.ui.view">
        <field name="name">survey.user.input.view.list.inherit.appraisal</field>
        <field name="model">survey.user_input</field>
        <field name="arch" type="xml">
            <list create="0">
                <header>
                    <button string="See results" name="action_open_appraisal_survey_results" class="btn-primary" type="object" display="always"/>
                    <button string="Resend all" name="action_ask_feedback" icon="redo" type="object"/>
                    <button string="Ask Feedback" name="%(hr_appraisal_survey.appraisal_ask_feedback_action)d" type="action" display="always"/>
                </header>
                <field name="partner_id" string="Partner"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state == 'new'"
                    decoration-warning="state == 'in_progress'"
                />
                <field name="deadline"/>
                <field name="survey_id"/>
                <button class="oe_stat_button" string="See Answers" invisible="state != 'done'" name="action_open_survey_inputs" icon="open_in_new" type="object"/>
                <button class="oe_stat_button" string="Resend" invisible="state == 'done'" name="action_ask_feedback" icon="check_box" type="object"/>
            </list>
        </field>
    </record>
</odoo>
