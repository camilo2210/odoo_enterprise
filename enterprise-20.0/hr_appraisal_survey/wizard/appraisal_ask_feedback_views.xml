<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="appraisal_ask_feedback_view_form" model="ir.ui.view">
            <field name="name">appraisal.ask.feedback.view.form</field>
            <field name="model">appraisal.ask.feedback</field>
            <field name="arch" type="xml">
                <form string="Ask Feedback">
                    <sheet>
                        <field name="appraisal_id" invisible="1" />
                        <field name="author_id" invisible="1"/>
                        <field name="employee_id" invisible="1"/>
                        <field name="lang" invisible="1"/>
                        <field name="render_model" invisible="1"/>
                        <group col="2">
                            <group>
                                <field name="survey_template_id" options="{'no_create':1,'no_quick_create':1}"/>
                            </group>
                            <group>
                                <field name="deadline" options="{'min_date': 'today'}"/>
                            </group>
                        </group>
                        <group>
                            <field name="partner_ids"
                                options="{'no_create': 1, 'no_quick_create': 1}"
                                widget="many2many_tags_email"
                                placeholder="Add feedback recipients..."
                                context="{
                                    'search_view_ref': 'hr.res_partner_view_search',
                                    'search_default_employees': 1,
                                    'list_view_ref': 'hr_appraisal_survey.appraisal_view_partner_tree',
                                }"
                            />
                            <field name="subject" placeholder="Subject..."/>
                        </group>
                        <div>
                            <field name="user_body" placeholder="Optional comment..." class="note-wizard" nolabel="1"/>
                        </div>
                    </sheet>

                    <footer>
                        <button string="Send" name="action_send" type="object" class="btn-primary" data-hotkey="q"/>
                        <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="appraisal_ask_feedback_action" model="ir.actions.act_window" >
            <field name="name">Ask Feedback</field>
            <field name="res_model">appraisal.ask.feedback</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="appraisal_ask_feedback_view_form"/>
            <field name="target">new</field>
            
        </record>

        <record id="appraisal_view_partner_tree" model="ir.ui.view">
            <field name="name">appraisal.ask.feedback.res.partner.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list>
                    <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}" width="30" nolabel="1"/>
                    <field name="complete_name" string="Name"/>
                    <field name="email"/>
                    <field name="phone" class="o_force_ltr" optional="hide"/>
                    <field name="country_id" optional="hide"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
