<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_fleet_link" model="ir.actions.server">
        <field name="name">AI Tool: Link Document to Vehicle</field>
        <field name="ai_tool_name">ai_tool_link_document_to_vehicle</field>
        <field name="state">code</field>
        <field name="use_in_ai" eval="True"/>
        <field name="code">record._ai_action_link_to_vehicle(license_plate)</field>
        <field name="model_id" ref="documents.model_documents_document"/>
        <field name="ai_tool_description">Link document to fleet vehicle</field>
        <field name="ai_tool_schema">
        {
            "properties": {
                "license_plate": {
                    "type": "string",
                    "description": "License plate extracted from document"
                }
            },
            "required": ["license_plate"],
            "type": "object"
        }
        </field>
    </record>
</odoo>
