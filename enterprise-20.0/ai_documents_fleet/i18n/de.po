#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid ""
"If the document contains license plate number, link the document with the "
"vehicle with the same license plate."
msgstr ""
"Wenn das Dokument ein Kennzeichen enthält, verknüpfen Sie es mit dem "
"Fahrzeug, das dasselbe Kennzeichen hat."

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid ""
"If the document is a traffic fine, move it to the %(fleet)s folder and link "
"it to the vehicle with the matching license plate."
msgstr ""
"Handelt es sich bei dem Dokument um einen Strafzettel, verschieben Sie es in "
"den Ordner „%(fleet)s“ und verknüpfen Sie es mit dem Fahrzeug mit dem "
"entsprechenden Kennzeichen."

#. module: ai_documents_fleet
#: model:ir.actions.server,ai_tool_description:ai_documents_fleet.ir_actions_server_fleet_link
msgid "Link document to fleet vehicle"
msgstr "Dokument mit Fahrzeug im Fuhrpark verknüpfen"

