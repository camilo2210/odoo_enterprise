<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="documents_vehicle_traffic_fine" model="documents.document" forcecreate="0">
            <field name="name">demo_pdf_fine.pdf</field>
            <field name="raw" type="bytes" file="ai_documents_fleet/demo/files/demo_pdf_fine.pdf"/>
            <field name="folder_id" ref="documents.document_inbox_folder"/>
            <field name="access_internal">edit</field>
        </record>
    </data>

    <function model="ai_documents.sort" name="_activate_demo_prompt">
        <value model="documents.document" eval="ref('documents.document_inbox_folder')"/>
    </function>
</odoo>
