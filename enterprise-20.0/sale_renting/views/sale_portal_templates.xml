<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_rental_portal_details" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="after">
            <t t-if="sale_order.is_rental_order">
                <hr/>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex flex-column gap-1">
                        <strong class="smaller text-uppercase text-muted">Pick Up</strong>
                        <span>
                            <span t-field="sale_order.rental_start_date"
                                t-options='{"widget": "datetime", "date_only": True}'/>
                            <span t-field="sale_order.rental_start_date"
                                t-options='{"widget": "datetime", "time_only": True, "format": "short", "hide_seconds": True}'/>
                        </span>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <strong class="smaller text-uppercase text-muted">Return</strong>
                        <span>
                            <span t-field="sale_order.rental_return_date"
                                t-options='{"widget": "datetime", "date_only": True}'/>
                            <span t-field="sale_order.rental_return_date"
                                t-options='{"widget": "datetime", "time_only": True, "format": "short", "hide_seconds": True}'/>
                        </span>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@id='provide_feedback']" position="before">
            <t t-if="sale_order.is_rental_order">
                <div class="d-lg-none mt-4 p-3 rounded-3 border d-print-none">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="d-flex flex-column gap-1">
                            <strong class="smaller text-uppercase text-muted">Pick Up</strong>
                            <span class="small">
                                <span t-field="sale_order.rental_start_date"
                                    t-options='{"widget": "datetime", "date_only": True}'/>
                                <span t-field="sale_order.rental_start_date"
                                    t-options='{"widget": "datetime", "time_only": True, "format": "short", "hide_seconds": True}'/>
                            </span>
                        </div>
                        <div class="d-flex flex-column gap-1">
                            <strong class="smaller text-uppercase text-muted">Return</strong>
                            <span class="small">
                                <span t-field="sale_order.rental_return_date"
                                    t-options='{"widget": "datetime", "date_only": True}'/>
                                <span t-field="sale_order.rental_return_date"
                                    t-options='{"widget": "datetime", "time_only": True, "format": "short", "hide_seconds": True}'/>
                            </span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
