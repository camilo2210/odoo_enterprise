<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_return_check_template_in_form_26_cash_journal_no_partner" model="account.return.check.template">
            <field name="name">Cash Journal Item Without Partner</field>
            <field name="description">Cash transactions should have an appropriate partner identified where required for proper accounting and compliance.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_cash_journal_no_partner</field>
            <field name="model">account.move.line</field>
            <field name="domain">[
                ('journal_id.type', '=', 'cash'),
                ('partner_id', '=', False),
            ]</field>
        </record>
        <record id="account_return_check_template_in_form_26_cash_accept_us_185" model="account.return.check.template">
            <field name="name">Section 185 - Cash Loan/Deposit Accepted ≥ ₹20,000</field>
            <field name="description">No loan, deposit, or specified sum should be accepted in cash or otherwise than through account-payee cheque/bank transfer/prescribed electronic mode.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_cash_accept_us_185</field>
            <field name="model">account.move.line</field>
            <field name="domain">[
                ('journal_id.type', '=', 'cash'),
                ('move_id.state', '=', 'posted'),
                ('partner_id', '!=', False),
                ('account_type', 'in', ('liability_current', 'liability_non_current')),
            ]</field>
            <field name="additional_action_context">{'group_by': ['partner_id']}</field>
        </record>
        <record id="account_return_check_template_in_form_26_cash_repayment_us_188" model="account.return.check.template">
            <field name="name">Section 188 - Cash Loan/Deposit Repayment ≥ ₹20,000</field>
            <field name="description">No loan, deposit, or specified advance (incl. interest) should be repaid otherwise than through the prescribed mode.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_cash_repayment_us_188</field>
            <field name="model">account.move.line</field>
            <field name="domain">[
                ('journal_id.type', '=', 'cash'),
                ('move_id.state', '=', 'posted'),
                ('partner_id', '!=', False),
                ('account_type', 'in', ('liability_current', 'liability_non_current')),
            ]</field>
            <field name="additional_action_context">{'group_by': ['partner_id']}</field>
        </record>
        <record id="account_return_check_template_in_form_26_single_cash_receipt_us_186" model="account.return.check.template">
            <field name="name">Section 186 - Single Cash Receipt ≥ ₹2,00,000</field>
            <field name="description">No person should receive ₹2 lakh or more in cash from one person in a single day/transaction/event.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_single_cash_receipt_us_186</field>
            <field name="model">account.move.line</field>
            <field name="domain">[
                ('journal_id.type', '=', 'cash'),
                ('move_id.state', '=', 'posted'),
                ('partner_id', '!=', False),
                ('account_type', '=', 'asset_cash'),
            ]</field>
            <field name="additional_action_context">{'group_by': ['partner_id', 'date:day']}</field>
        </record>
        <record id="account_return_check_template_in_form_26_tds_tcs_stmt_filed_us_427" model="account.return.check.template">
            <field name="name">Section 427 - TDS/TCS Statement Filed Within Due Date</field>
            <field name="description">Confirm quarterly statements (Form 138, 140, 144, 143) are filed by the due date each quarter.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_tds_tcs_stmt_filed_us_427</field>
        </record>
        <record id="account_return_check_template_in_form_26_tds_deposit_within_due_date_us_398_3a" model="account.return.check.template">
            <field name="name">Section 398(3)(a) - TDS Deposited Within Due Date</field>
            <field name="description">TDS deducted must be deposited to the Central Government by the 7th of the following month.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_tds_deposit_within_due_date_us_398_3a</field>
        </record>
        <record id="account_return_check_template_in_form_26_tds_deducted_on_eligible_payment_us_35_b2" model="account.return.check.template">
            <field name="name">Section 35(b)(ii) - TDS Deducted on All Eligible Payments</field>
            <field name="description">Verify TDS is deducted wherever the section threshold is crossed (contractor, professional fee, rent, commission, interest, etc.).</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_tds_deducted_on_eligible_payment_us_35_b2</field>
            <field name="model">account.move</field>
            <field name="domain">[
                ('state', '=', 'posted'),
                ('move_type', '=', 'in_invoice'),
                ('invoice_line_ids.tax_ids', 'any', [('l10n_in_tax_type', '=', 'tds')]),
                ('withholding_residual_amount_currency', '>', 0),
            ]</field>
        </record>
        <record id="account_return_check_template_in_form_26_tds_deducted_at_correct_rate_us_35_b_1" model="account.return.check.template">
            <field name="name">Section 35(b)(i) - TDS Deducted at Correct Rate</field>
            <field name="description">Verify the rate applied matches the statutory rate, factoring PAN availability/non-filer status.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_tds_deducted_at_correct_rate_us_35_b_1</field>
            <field name="model">account.move</field>
            <field name="domain">[
                ('state', '=', 'posted'),
                ('move_type', '=', 'in_invoice'),
                ('partner_id.l10n_in_pan_entity_id', '=', False),
                ('invoice_line_ids.tax_ids', 'any', [('l10n_in_tax_type', '=', 'tds')]),
            ]</field>
        </record>
        <record id="account_return_check_template_in_form_26_emp_pf_esi_contri_deposited_us_29_1e" model="account.return.check.template">
            <field name="name">Section 29(1)(e) - Employee PF/ESI Contribution Deposited by Statutory Due Date</field>
            <field name="description">Employee's share deducted from salary must reach the fund within the statutory due date each month — payment before return filing does not cure this.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_emp_pf_esi_contri_deposited_us_29_1e</field>
        </record>
        <record id="account_return_check_template_in_form_26_msme_vendor_payment_us_37" model="account.return.check.template">
            <field name="name">Section 37 - MSME Vendor Payments Within 15/45 Days</field>
            <field name="description">Verify payments to Udyam-registered Micro/Small vendors are made within the MSMED-prescribed period; unpaid amounts and related interest are disallowed until actually paid.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_msme_vendor_payment_us_37</field>
            <field name="model">account.move</field>
            <field name="domain">[
                ('state', '=', 'posted'),
                ('move_type', '=', 'in_invoice'),
                ('partner_id.l10n_in_pan_entity_id.msme_type', 'in', ['micro', 'small']),
                ('payment_state', '!=', 'paid'),
                ('invoice_date_due', '&lt;', 'today -45d'),
            ]</field>
        </record>
        <record id="account_return_check_template_in_form_26_no_single_day_cash_payment_us_36_4" model="account.return.check.template">
            <field name="name">Section 36(4) - No Single-Day Cash Payment > ₹10,000 to One Party</field>
            <field name="description">No expenditure should be paid in cash exceeding ₹10,000 to a single person in a single day.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_no_single_day_cash_payment_us_36_4</field>
            <field name="model">account.move.line</field>
            <field name="domain">[
                ('journal_id.type', '=', 'cash'),
                ('move_id.state', '=', 'posted'),
                ('partner_id', '!=', False),
                ('account_type', '=', 'asset_cash'),
            ]</field>
            <field name="additional_action_context">{'group_by': ['partner_id', 'date:day']}</field>
        </record>
        <record id="account_return_check_template_in_form_26_cash_payment_for_earlier_year_us_36_5" model="account.return.check.template">
            <field name="name">Section 36(5) - Cash Payment for Earlier-Year Accrued Expense</field>
            <field name="description">If an expense allowed on accrual in an earlier year is later paid in cash above the limit, the amount becomes deemed income of the payment year.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_cash_payment_for_earlier_year_us_36_5</field>
        </record>
        <record id="account_return_check_template_in_form_26_expenditure_us_34" model="account.return.check.template">
            <field name="name">Section 34 - Personal / Club / CSR / Penal / Prohibited-Purpose Expenditure</field>
            <field name="description">Entertainment, club fees, CSR spend, fines, and expenditure for any offence/prohibited purpose must not be claimed as regular business expense.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_expenditure_us_34</field>
        </record>
        <record id="account_return_check_template_in_form_26_statutory_dues_paid_before_us_37" model="account.return.check.template">
            <field name="name">Section 37 - Statutory Dues Paid Before Return Due Date</field>
            <field name="description">Tax/duty/cess, employer PF/superannuation/gratuity contribution, bonus, leave encashment, and specified bank/NBFC interest are deductible only on actual payment.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_statutory_dues_paid_before_us_37</field>
        </record>
        <record id="account_return_check_template_in_form_26_related_party_payment_us_36_3" model="account.return.check.template">
            <field name="name">Section 36(3) - Related-Party Payments at Arm's Length</field>
            <field name="description">Payments to specified persons should not exceed fair market value for goods/services received.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_related_party_payment_us_36_3</field>
        </record>
        <record id="account_return_check_template_in_form_26_interest_to_associated_enterprises_us_177_1" model="account.return.check.template">
            <field name="name">Section 177(1) - Interest to Associated Enterprises Within 30% EBITDA</field>
            <field name="description">Interest/similar expenditure paid to an AE should not exceed 30% of EBITDA.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_interest_to_associated_enterprises_us_177_1</field>
        </record>
        <record id="account_return_check_template_in_form_26_transfer_pricing_primary_adj_us_170_1" model="account.return.check.template">
            <field name="name">Section 170(1) - Transfer Pricing Primary Adjustment</field>
            <field name="description">International/specified domestic transactions with AEs should be at arm's length; excess money not repatriated attracts imputed interest.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_transfer_pricing_primary_adj_us_170_1</field>
        </record>
        <record id="account_return_check_template_in_form_26_deemed_dividend_on_shared_loans_us_2_40e" model="account.return.check.template">
            <field name="name">Section 2(40)(e) - Deemed Dividend on Shareholder Loans</field>
            <field name="description">Loans/advances to a shareholder holding ≥10% voting power (with accumulated profits available) must be reported.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_deemed_dividend_on_shared_loans_us_2_40e</field>
        </record>
        <record id="account_return_check_template_in_form_26_boa_maintained_us_441" model="account.return.check.template">
            <field name="name">Section 441 - Books of Account Maintained</field>
            <field name="description">Prescribed books must be kept, maintained, and retained for the statutory period, including audit trail per Rule 46(8).</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_boa_maintained_us_441</field>
        </record>
        <record id="account_return_check_template_in_form_26_tax_audit_report_obt_file_on_time_us_446" model="account.return.check.template">
            <field name="name">Section 446 - Tax Audit Report Obtained &amp; Filed on Time</field>
            <field name="description">Where turnover/receipts cross the audit threshold, the audit report must be obtained and furnished by the due date.</field>
            <field name="type">check</field>
            <field name="cycle_id" ref="account_reports.audit_cycle_regulatory_compliance"/>
            <field name="return_type" ref="l10n_in_reports.l10n_in_form_26_audit_return_type"/>
            <field name="code">_account_return_check_template_in_form_26_tax_audit_report_obt_file_on_time_us_446</field>
        </record>
    </data>
</odoo>
