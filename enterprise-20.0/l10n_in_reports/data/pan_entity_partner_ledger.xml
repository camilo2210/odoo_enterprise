<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="pan_entity_partner_ledger_report" model="account.report">
        <field name="name">Partner Ledger By PAN Entity</field>
        <field name="root_report_id" ref="account_reports.partner_ledger_report"/>
        <field name="groupby">l10n_in_pan_entity_id,partner_id,id</field>
        <field name="custom_handler_model_id" ref="account_reports.model_account_partner_ledger_report_handler"/>
        <field name="country_id" ref="base.in"/>
        <field name="column_ids">
            <record id="pan_entity_partner_ledger_report_journal_code" model="account.report.column">
                <field name="name">Journal</field>
                <field name="expression_label">journal_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="pan_entity_partner_ledger_report_account_code" model="account.report.column">
                <field name="name">Account</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="pan_entity_partner_ledger_report_invoicing_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="pan_entity_partner_ledger_report_date_maturity" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
            </record>
            <record id="pan_entity_partner_ledger_report_matching_number" model="account.report.column">
                <field name="name">Matching</field>
                <field name="expression_label">matching_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="pan_entity_partner_ledger_report_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="pan_entity_partner_ledger_report_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="pan_entity_partner_ledger_report_amount_currency" model="account.report.column">
                <field name="name">Amount Currency</field>
                <field name="expression_label">amount_currency</field>
            </record>
            <record id="pan_entity_partner_ledger_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="pan_entity_partner_ledger_report_line" model="account.report.line">
                <field name="name">Partner Ledger</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="pan_entity_partner_ledger_report_expression_journal_code" model="account.report.expression">
                        <field name="label">journal_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">journal_code</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_account_code" model="account.report.expression">
                        <field name="label">account_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">account_code</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_invoice_date" model="account.report.expression">
                        <field name="label">invoice_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">invoice_date</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_date_maturity" model="account.report.expression">
                        <field name="label">date_maturity</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">date_maturity</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_matching_number" model="account.report.expression">
                        <field name="label">matching_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">matching_number</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">debit</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">credit</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_amount_currency" model="account.report.expression">
                        <field name="label">amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount_currency</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_currency_amount_currency" model="account.report.expression">
                        <field name="label">_currency_amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">_currency_amount_currency</field>
                    </record>
                    <record id="pan_entity_partner_ledger_report_expression_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
