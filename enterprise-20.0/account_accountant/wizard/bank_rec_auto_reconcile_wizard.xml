<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_rec_auto_reconcile_wizard_view_form" model="ir.ui.view">
        <field name="name">bank.rec.auto.reconcile.wizard.form</field>
        <field name="model">bank.rec.auto.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Auto Reconciliation">
                <p>
                    Choose a journal and a starting date. The system will try to automatically
                    reconcile all unreconciled bank statement lines from that date until today.
                </p>
                <group>
                    <field name="journal_id" required="1" options="{'no_quick_create':True,'no_create_edit':True}"/>
                    <field name="date" required="1"/>
                </group>
                <footer>
                    <button string="Run" data-hotkey="q" name="action_auto_reconcile" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
