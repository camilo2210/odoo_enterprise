<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_select_account_line_tree" model="ir.ui.view">
        <field name="name">account.select.account.line.tree</field>
        <field name="model">account.select.account.line</field>
        <field name="arch" type="xml">
            <list js_class="bank_rec_account_dialog_list" editable="top" create="false" string="Accounts">
                <field name="code" readonly="True"/>
                <field name="name" readonly="True"/>
                <field name="description" readonly="True" optional="show"/>
                <field name="amount" optional="show"/>
                <!-- Needed for the monetary field -->
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_select_account_search_bank_rec_widget" model="ir.ui.view">
        <field name="name">account.select.account.line.search</field>
        <field name="model">account.select.account.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>
</odoo>
