<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="printer_view_list_inherit_obox" model="ir.ui.view">
        <field name="name">printer.view.list.inherit.obox</field>
        <field name="model">printer.printer</field>
        <field name="inherit_id" ref="printer.printer_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='type']" position="after">
                <field name="obox_device_id" optional="True"/>
            </xpath>
            <xpath expr="//field[@name='ip_address']" position="attributes">
                <attribute name="required" separator="and" add="type != 'obox'"/>
            </xpath>
        </field>
    </record>

    <record id="printer_view_form_inherit_obox" model="ir.ui.view">
        <field name="name">printer.view.form.inherit.obox</field>
        <field name="model">printer.printer</field>
        <field name="inherit_id" ref="printer.printer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="obox_device_id" invisible="type != 'obox'" domain="[('type', '=', 'printer')]"/>
            </xpath>
            <xpath expr="//field[@name='ip_address']" position="attributes">
                <attribute name="invisible" separator="or" add="type == 'obox'"/>
            </xpath>
        </field>
    </record>
</odoo>
