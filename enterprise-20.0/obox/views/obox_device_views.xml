<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="obox_device_view_form" model="ir.ui.view">
        <field name="name">obox.device.view.form</field>
        <field name="model">obox.device</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="local_ip" invisible="True"/> <!-- Required by test_obox_device widget -->
                    <widget name="test_obox_device"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group name="obox_device_details">
                        <group>
                            <field name="obox_id" readonly="True"/>
                            <field name="identifier" readonly="True"/>
                        </group>
                        <group>
                            <field name="connection_type"/>
                            <field name="type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="obox_device_view_kanban" model="ir.ui.view">
        <field name="name">obox.device.view.kanban</field>
        <field name="model">obox.device</field>
        <field name="arch" type="xml">
            <kanban create="false" group_create="false" default_group_by="obox_id" default_order="type">
                <field name="type"/>
                <field name="connection_type"/>
                <templates>
                    <t t-name="card" class="row g-0 p-0">
                        <aside class="col-3 text-center align-self-center">
                            <img t-attf-src="/obox/static/img/#{record.type.raw_value}.svg" t-attf-alt="Device type is #{record.type.raw_value}" class="w-50"/>
                        </aside>
                        <main class="col p-2 border-start">
                            <field name="name" class="fw-bold text-truncate mb-2"/>
                            <div class="d-flex align-items-center gap-2">
                                <t t-set="connections" t-value="{'usb': 'usb', 'network': 'wifi'}"/>
                                <i t-attf-class="oi oi-fw" t-att-data-icon="connections[record.connection_type.raw_value]" title="connection_type"/>
                                <field name="obox_id" class="text-truncate" readonly="1"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="obox_device_view_list" model="ir.ui.view">
        <field name="name">obox.device.view.list</field>
        <field name="model">obox.device</field>
        <field name="arch" type="xml">
            <list create="false" default_group_by="obox_id" default_order="type">
                <field name="name"/>
                <field name="obox_id"/>
                <field name="identifier"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="action_obox_device_list" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="path">obox-devices</field>
        <field name="res_model">obox.device</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
