<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Oboxes -->
        <record id="obox_demo" model="obox.obox">
            <field name="name">Demo Obox</field>
            <field name="serial_number">demo_serial_number</field>
            <field name="local_ip">127.0.0.1</field>
            <field name="token">demo_token</field>
            <field name="services" eval="['apip','sos','odoo','wifi','example','base','com','ble','usb','clock','leds','display']"/>
            <field name="state">02_paired</field>
        </record>

        <record id="obox_demo2" model="obox.obox">
            <field name="name">Demo Obox2</field>
            <field name="serial_number">demo_serial_number2</field>
            <field name="local_ip">127.0.0.2</field>
            <field name="token">demo_token2</field>
            <field name="services" eval="['apip','sos','odoo','wifi','example','base','com','ble','usb','clock','leds','display']"/>
            <field name="state">02_paired</field>
        </record>

        <!-- Obox devices -->
        <record id="obox_demo_usb_printer" model="obox.device">
            <field name="name">Demo USB Printer</field>
            <field name="obox_id" ref="obox.obox_demo"/>
            <field name="identifier">usb_demo_printer</field>
            <field name="type">printer</field>
        </record>

        <record id="obox_demo_network_printer" model="obox.device">
            <field name="name">Demo network Printer</field>
            <field name="obox_id" ref="obox.obox_demo"/>
            <field name="identifier">ipp_demo_printer</field>
            <field name="type">printer</field>
        </record>

        <record id="obox_demo_camera" model="obox.device">
            <field name="name">Demo Camera</field>
            <field name="obox_id" ref="obox.obox_demo"/>
            <field name="identifier">usb_demo_camera</field>
            <field name="type">camera</field>
        </record>

        <record id="obox_demo_scale" model="obox.device">
            <field name="name">Demo Scale</field>
            <field name="obox_id" ref="obox.obox_demo2"/>
            <field name="identifier">usb_demo_scale</field>
            <field name="type">scale</field>
        </record>

        <!-- Obox Queues -->
        <record id="obox_queue" model="obox.queue">
            <field name="uuid">demo_uuid1</field>
            <field name="obox_id" ref="obox_demo"/>
            <field name="payload_length">123</field>
            <field name="action_type">test</field>
            <field name="payload">{'demo_key': 'demo_value'}</field>
            <field name="result">Demo result</field>
            <field name="status">done</field>
            <field name="retry">0</field>
        </record>

        <record id="obox_queue2" model="obox.queue">
            <field name="uuid">demo_uuid2</field>
            <field name="obox_id" ref="obox_demo"/>
            <field name="payload_length">456</field>
            <field name="action_type">test</field>
            <field name="payload">{'demo_key': 'demo_value'}</field>
            <field name="result">Demo result</field>
            <field name="status">processing</field>
            <field name="retry">0</field>
        </record>
    </data>
</odoo>
