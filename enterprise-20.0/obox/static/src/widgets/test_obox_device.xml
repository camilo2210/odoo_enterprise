<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="obox.TestOboxDevice">
        <div class="d-flex gap-4 align-items-baseline">
            <button
                type="button"
                class="btn btn-primary"
                t-att-disabled="this.state.loading or (this.device.type === 'printer' and !this.state.printType)"
                t-on-click="this.onClick">
                Test
            </button>
            <SelectMenu t-if="this.device.type === 'printer'"
                name="'print-type'"
                choices="this.testPrintOptions"
                placeholder.translate="Select test print type"
                onSelect.bind="this.onPrintTypeSelected"
                value="this.state.printType"
                disabled="this.state.loading"
            />
        </div>
    </t>

</templates>
