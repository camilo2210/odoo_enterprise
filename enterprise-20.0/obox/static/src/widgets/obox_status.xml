<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="obox.OboxStatus">
        <div class="d-flex gap-2">
            <i
                class="oi"
                data-icon="wifi"
                t-att-title="this.lanTitle"
                t-att-class="{
                    'text-warning': this.lanPending,
                    'text-success': !this.lanPending and this.state.lan.status,
                    'text-danger': !this.lanPending and !this.state.lan.status,
                }"
            />
            <i
                class="oi"
                data-icon="cloud"
                t-att-title="this.wanTitle"
                t-att-class="{
                    'text-warning': this.wanPending,
                    'text-success': !this.wanPending and this.state.wan.status,
                    'text-danger': !this.wanPending and !this.state.wan.status,
                }"
            />
        </div>
    </t>
</templates>
