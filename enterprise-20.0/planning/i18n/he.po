#: model:mail.template,body_html:planning.email_template_slot_single
msgid ""
"<style>\n"
"                    .top_button {\n"
"                        color: #FFFFFF;\n"
"                        background-color: #714B67;\n"
"                        border: solid #714B67;\n"
"                        flex: 1 1 60%;\n"
"                    }\n"
"                    .button_box {\n"
"                        display: flex;\n"
"                        flex-wrap: wrap;\n"
"                        gap: 10px;\n"
"                        margin: 20px 15px 0px 15px;\n"
"                    }\n"
"                </style>\n"
"                <body><div>\n"
"                    <p t-if=\"ctx.get('employee_name')\">Dear <t t-"
"out=\"ctx['employee_name']\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">Hello,</p>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('open_shift_available')\">We have a "
"new shift opening:</p>\n"
"                    <p t-else=\"\">You have been assigned the following "
"shift:</p>\n"
"                    <table style=\"margin-left: 30px;\">\n"
"                        <tr t-if=\"(ctx.get('start_datetime') and "
"ctx.get('end_datetime'))                                   or "
"ctx.get('allocated_hours')                                   or "
"ctx.get('allocated_percentage')\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Date</th>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <span t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\" t-out=\"'%s ⟶ %s' % "
"(                                     ctx['start_datetime'],                                     "
"ctx['end_datetime'],                                 )\">\n"
"                                    05/31/2021, 8:00 AM ⟶ 05/31/2021, 4:00 "
"PM\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_hours')\" "
"style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_hours']"
"\">4:00</t>h)\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_percentage') "
"and ctx['allocated_percentage'] != '100'\" style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_percentage']"
"\">50</t>%)\n"
"                                </span>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.role_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Role</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.role_id.name or ''\">Bartender</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'project_id') and "
"object.project_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Project</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().project_id.name or ''\">Gathering</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'task_id') and "
"object.task_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Task</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().task_id.name or ''\">Chef</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'sale_line_id') and "
"object.sale_line_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Sales Order Item</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().sale_line_id.name or ''\">Coffee</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'name') and "
"object.name\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Note</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.name "
"or ''\">/</td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <div class=\"button_box\">\n"
"                        <a t-if=\"ctx.get('available_link')\" t-att-"
"href=\"ctx['available_link']\" target=\"_blank\" t-att-style=\"'font-size: "
"12px; color: ' + (company.email_primary_color or '#FFFFFF') + '; background-"
"color: ' + (company.email_secondary_color or '#875A7B') + '; padding: 8px "
"12px 11px; text-decoration: none !important; font-weight: bold;'\">\n"
"                            Assign me this shift\n"
"                        </a>\n"
"                        <a t-if=\"ctx.get('unavailable_link')\" t-att-"
"href=\"ctx['unavailable_link']\" target=\"_blank\" t-att-style=\"'font-size: "
"12px; color: ' + (company.email_primary_color or '#FFFFFF') + '; background-"
"color: ' + (company.email_secondary_color or '#875A7B') + '; padding: 8px "
"12px 11px; text-decoration: none !important; font-weight: bold;'\">\n"
"                            I am unavailable\n"
"                        </a>\n"
"                        <a t-if=\"ctx.get('google_url')\" t-att-"
"href=\"ctx['google_url']\" target=\"_blank\" t-att-style=\"'font-size: 12px; "
"color: ' + (company.email_secondary_color or '#875A7B') + '; padding: 8px "
"12px 11px; text-decoration: none !important; font-weight: bold;'\">\n"
"                            Add to Google Calendar\n"
"                        </a>\n"
"                        <a t-if=\"ctx.get('iCal_url')\" t-att-"
"href=\"ctx['iCal_url']\" target=\"_blank\" t-att-style=\"'font-size: 12px; "
"color: ' + (company.email_secondary_color or '#875A7B') + '; padding: 8px "
"12px 11px; text-decoration: none !important; font-weight: bold;'\">\n"
"                            Add to iCal/Outlook\n"
"                        </a>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <t t-if=\"ctx.get('open_shift_available')\">\n"
"                        <p t-if=\"ctx.get('is_internal_user')\">\n"
"                            If you are interested and available, please "
"assign yourself to this open shift.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Please contact your manager if you would like to "
"take this shift.\n"
"                        </p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p t-if=\"ctx.get('is_internal_user') and not "
"object.allow_self_unassign\">\n"
"                            In case the current shift does not suit you, we "
"encourage you to reach out to your colleagues and request to switch shifts. "
"They might be interested in exchanging shifts with you.\n"
"                        </p>\n"
"                    </t>\n"
"                </div>\n"
"            </body>"
