"12px 11px; text-decoration: none !important; font-weight: bold;'\">\n"
"                            Add to iCal/Outlook\n"
"                        </a>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <t t-if=\"ctx.get('open_shift_available')\">\n"
"                        <p t-if=\"ctx.get('is_internal_user')\">\n"
"                            If you are interested and available, please "
"assign yourself to this open shift.\n"
"                        </p>\n"
"                        <p t-else=\"\">\n"
"                            Please contact your manager if you would like to "
"take this shift.\n"
"                        </p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p t-if=\"ctx.get('is_internal_user') and not "
