<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="digest_tip_planning_0" model="digest.tip">
            <field name="name">Tip: Plan faster</field>
            <field name="sequence">500</field>
            <field name="group_id" ref="planning.group_planning_manager" />
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Plan faster</b></p>
                <p class="tip_content">Drag a shift to another day to reschedule it, or to another row to reassign it. Hold <b>Ctrl</b> (or <b>Cmd</b> on Mac) while dragging a shift to duplicate it.</p>
                <img src="https://download.odoocdn.com/digests/planning/static/src/img/Plan-faster.png" width="540" class="illustration_border" />
            </div>
            </field>
        </record>

        <record id="digest_tip_planning_1" model="digest.tip">
            <field name="name">Tip: Quickly schedule multiple shifts</field>
            <field name="sequence">1000</field>
            <field name="group_id" ref="planning.group_planning_manager" />
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Quickly schedule multiple shifts</b></p>
                <p class="tip_content">Need several people for the afternoon shift this week? Schedule them all at once ⚡</p>
                <img src="https://download.odoocdn.com/digests/planning/static/src/img/multiple_shifts.png" width="540" class="illustration_border" />
            </div>
            </field>
        </record>
    </data>
</odoo>
