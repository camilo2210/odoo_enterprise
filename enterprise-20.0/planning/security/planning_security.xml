<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_planning">
        <field name="name">Planning</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can view all published shifts.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Can manage all shifts, with access to reporting and configuration.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_planning_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_field_service_allow_geolocation" model="res.groups">
        <field name="name">Field Service Geolocation</field>
    </record>

    <record id="group_field_service_allow_customer_report" model="res.groups">
        <field name="name">Field Service: Allow Customer Report</field>
    </record>

    <record id="group_field_service_allow_material" model="res.groups">
        <field name="name">Field Service: Allow material on interventions</field>
    </record>

    <record id="group_field_service_hide_price" model="res.groups">
        <field name="name">Field Service: Hide Price</field>
    </record>

    <record id="group_field_service_allow_quotations" model="res.groups">
        <field name="name">Field Service Extra Quotations</field>
    </record>

    <record id="group_field_service_allow_customer_ratings" model="res.groups">
        <field name="name">Field Service: Allow Customer Ratings</field>
    </record>

    <record id="group_field_service_allow_equipment" model="res.groups">
        <field name="name">Field Service: Allow Equipment Tracking</field>
    </record>

    <record id="base.default_user_group" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('planning.group_planning_user'))]"/>
    </record>
</odoo>
