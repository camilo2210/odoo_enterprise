<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="planning.PlanningGanttRendererControls.ToolbarContent" t-inherit="web_gantt.GanttRendererControls.ToolbarContent">
        <xpath expr="//div[@name='expandCollapseButtons']" position="after">
            <strong t-if="!this.uiService.isSmall" class="alert alert-info position-absolute top-0 end-0 me-3"
                t-att-class="{ invisible: !this.planningGanttProps.duplicateToolHelperReactive.shouldDisplay }"
            >
                <i class="oi me-2" data-icon="lightbulb"/>
                Press Ctrl to duplicate the shift
            </strong>
        </xpath>
    </t>

</templates>
