<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- TODO: when gantt view is converted it should be reused somehow there as well. -->
    <t t-name="planning.PlanningCalendarController.controlButtons" t-inherit="web.CalendarController.controlButtons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <button t-if="this.model.canCreate &amp;&amp; this.model.scale === 'week'" class="btn btn-primary me-1 o_button_copy_previous_week" title="Copy previous week"
                t-on-click="() => this.planningControllerActions.copyPrevious()">
                Copy previous
            </button>
            <button t-if="this.model.isManager and this.model.scale !== 'year'" class="btn btn-primary me-1 o_button_send_all" title="Send schedule"
                t-on-click.prevent="() => this.planningControllerActions.publish()">
                Publish
            </button>
            <button t-if="['week', 'month'].includes(this.model.scale)" class="btn btn-secondary me-1 o_button_print" title="Print resource calendar"
                t-on-click="() => this.planningControllerActions.print()">
                Print
            </button>
            <button t-if="this.displayAutoPlanButton" class="btn btn-secondary me-1" title="Automatically plan open shifts and sales orders"
                t-on-click.prevent="this.autoPlan.bind(this)">
                Auto Plan
            </button>
        </xpath>
    </t>
</templates>
