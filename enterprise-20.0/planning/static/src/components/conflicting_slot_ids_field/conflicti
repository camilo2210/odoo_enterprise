<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="planning.ConflictingSlotIdsField">
        <t t-if="this.conflictingSlots.length">
            <button t-on-click="this.showConflictedSlots" class="btn btn-link">
                <t t-out="this.conflictingSlots.length" /> conflicts
            </button>
            <span t-out="this.conflictString" />
        </t>
    </t>

</templates>
