<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_274_XX_view_form" model="ir.ui.view">
        <field name="name">l10n_be.274_xx.view.form.inherit</field>
        <field name="model">l10n_be.274_xx</field>
        <field name="inherit_id" ref="l10n_be_hr_payroll.l10n_be_274_XX_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="action_open_move" type="object" icon="attach_money"
                        invisible="not move_id" groups="account.group_account_readonly">
                    <div class="o_stat_info">
                        <span class="o_stat_text" invisible="move_state != 'draft'">Journal Entry <br/>(Draft)</span>
                        <span class="o_stat_text" invisible="move_state != 'posted'">Journal Entry <br/>(Posted)</span>
                        <span class="o_stat_text" invisible="move_state != 'cancel'">Journal Entry <br/>(Canceled)</span>
                    </div>
                </button>
            </div>
            <widget name="generate_dropdown" position="after">
                <button name="action_post_account_entries" string="Post Journal Entries"
                    invisible="move_id"
                    groups="account.group_account_user" type="object" class="btn-secondary"/>
            </widget>
        </field>
    </record>
</odoo>
