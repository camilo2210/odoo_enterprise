<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boa_sales_report" model="account.report">
        <field name="name">Sales Report</field>
        <field name="country_id" ref="base.ph"/>
        <!-- Fake variant, it's just for grouping under BoA -->
        <field name="root_report_id" ref="l10n_ph_reports.boa_general_journal_report"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="search_bar" eval="True"/>
        <field name="load_more_limit" eval="80"/>
        <field name="custom_handler_model_id" ref="model_l10n_ph_boa_sales_report_handler"/>
        <field name="column_ids">
            <record id="boa_sales_report_invoice_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="boa_sales_report_taxpayer_id" model="account.report.column">
                <field name="name">Taxpayer ID Number</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_sales_report_register_name" model="account.report.column">
                <field name="name">Register Name</field>
                <field name="expression_label">register_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_sales_report_customer_address" model="account.report.column">
                <field name="name">Customer's Address</field>
                <field name="expression_label">partner_address</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_sales_report_invoice_line" model="account.report.column">
                <field name="name">Description</field>
                <field name="expression_label">invoice_line</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_sales_report_gross_sales" model="account.report.column">
                <field name="name">Gross Sales</field>
                <field name="expression_label">gross_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_sales_report_discount_amount" model="account.report.column">
                <field name="name">Discount Amount</field>
                <field name="expression_label">discount_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_sales_report_output_tax" model="account.report.column">
                <field name="name">Output Tax</field>
                <field name="expression_label">tax_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_sales_report_taxable_sales" model="account.report.column">
                <field name="name">Taxable Sales</field>
                <field name="expression_label">taxable_amount</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
