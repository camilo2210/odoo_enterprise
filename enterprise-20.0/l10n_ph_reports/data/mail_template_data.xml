<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_bir_certificate" model="mail.template">
            <field name="name">Withholding Certificate: Sending</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.commercial_partner_id.id }}</field>
            <field name="subject">{{ object.company_id.name }} - BIR WHT Certificate(s) (Ref {{ object.name or 'n/a' }})</field>
            <field name="description">Sent to vendors with their BIR 2306/2307 withholding tax certificate in attachment</field>
            <field name="email_layout_xmlid">mail.mail_notification_layout_with_responsible_signature</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear
        <t t-out="object.commercial_partner_id.name or ''">Acme Corporation</t>,
        <br/><br/>
        Please find attached your BIR withholding tax certificate for 
        <t t-if="object.name"><span style="font-weight:bold;" t-out="object.name or ''">BILL/2026/06/0003</span></t>
        issued by <t t-out="object.company_id.name or ''">PH Company</t>.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <br/><br/>
        Best regards,
        <br/>
        <t t-out="object.company_id.name or ''">PH Company</t>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
