<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="2306_report" model="account.report">
        <field name="name">2306</field>
        <field name="country_id" ref="base.ph"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_multi_company">tax_units</field>
        <field name="default_opening_date_filter">this_quarter</field>
        <field name="search_bar" eval="False"/>
        <field name="load_more_limit" eval="80"/>
        <field name="custom_handler_model_id" ref="model_l10n_ph_2306_2307_report_handler"/>
        <field name="column_ids">
            <record id="2306_report_amount_income_payment" model="account.report.column">
                <field name="name">Amount of Income Payments</field>
                <field name="expression_label">tax_base_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="2306_report_tax_withheld" model="account.report.column">
                <field name="name">Tax Withheld</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="2306_report_line" model="account.report.line">
                <field name="name"></field>
                <field name="groupby">partner_id, tax_line_id, move_id</field>
                <field name="hide_if_zero" eval="1"/>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="2306_expr_tax_base" model="account.report.expression">
                        <field name="label">tax_base_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_ph_2306</field>
                        <field name="subformula">tax_base_amount</field>
                    </record>
                    <record id="2306_expr_tax_amount" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_ph_2306</field>
                        <field name="subformula">balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

