<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- The 2550Q reports both the VAT and the withholding tax, but they are settled on
             different accounts, so each gets its own return over that same report. -->
        <record id="ph_tax_return_type" model="account.return.type">
            <field name="name">VAT (2550Q)</field>
            <field name="report_id" ref="l10n_ph.vat"/>
            <field name="country_id" ref="base.ph" />
        </record>

        <record id="ph_wht_tax_return_type" model="account.return.type">
            <field name="name">Withholding Tax (2550Q)</field>
            <field name="report_id" ref="l10n_ph.vat"/>
            <field name="country_id" ref="base.ph" />
        </record>

        <!-- The 2551Q report is inactive by default, so is its return. -->
        <record id="ph_percentage_tax_return_type" model="account.return.type">
            <field name="name">Percentage Tax (2551Q)</field>
            <field name="report_id" ref="l10n_ph.percentage_tax"/>
            <field name="country_id" ref="base.ph" />
            <field name="active_fallback" eval="False"/>
        </record>
    </data>
</odoo>
