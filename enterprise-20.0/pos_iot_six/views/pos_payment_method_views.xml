<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_six_iot" model="ir.ui.view">
        <field name="name">pos.payment.method.form.six_iot</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'six_iot'">
                    <page name="settings" string="SIX">
                        <group>
                            <field name="iot_box_ip" invisible="True"/>  <!-- Needed by 'six_terminal_id_field' JS widget -->
                            <field name="iot_box_id" invisible="payment_provider != 'six_iot'" required="payment_provider == 'six_iot'"/>
                            <field name="six_terminal_id" widget="six_terminal_id_field" invisible="not iot_box_id or payment_provider != 'six_iot'"/>
                            <field name="iot_device_id"
                                invisible="not iot_box_id or payment_provider != 'six_iot'"
                                domain="[('iot_id', '=', iot_box_id), ('type', '=', 'payment')]"
                                required="payment_provider == 'six_iot'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
