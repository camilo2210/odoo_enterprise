<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_iot_six.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_burger_menu_buttons')]/t[@t-name='create_product']" position="before">
            <t t-call="point_of_sale.BurgerDialogMenuButton"
                dataIcon="'attach_money'"
                onClick="() => this.sendBalance()"
                btnLabel.translate="Six Terminal Balance"
            />
        </xpath>
    </t>
</templates>
