<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_mx_hr_payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_accountant']" position="after">
                <field name="company_country_code" invisible="1"/>
                <block title="Mexican Localization" id="l10n_mx_hr_payroll" invisible="company_country_code != 'MX'">
                    <setting id="l10n_mx_isr" string="ISR (Income Tax)" help="Method used to compute the income tax withheld on each payslip">
                        <div class="mt16 content-group">
                            <div class="row ms-2">
                                <label for="l10n_mx_isr_calculation_method" class="col-md-6 p-0 m-0"/>
                                <field name="l10n_mx_isr_calculation_method" class="col-md-6 p-0"/>
                            </div>
                            <div class="row ms-2" invisible="l10n_mx_isr_calculation_method != 'monthly_with_period_factor'">
                                <label for="l10n_mx_isr_days_per_month" class="col-md-6 p-0 m-0"/>
                                <field name="l10n_mx_isr_days_per_month" class="col-md-6 p-0"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
