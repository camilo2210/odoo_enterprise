<?xml version="1.0"?>
<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.inherit.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <group name="top" position="inside">
                <group name="top_right_mx" invisible="country_code != 'MX'">
                    <field name="l10n_mx_daily_salary"/>
                    <label for="l10n_mx_integration_factor"/>
                    <div name="l10n_mx_integration_factor" class="o_row">
                        <field name="l10n_mx_integration_factor" options="{'digits': [6,4]}"/>
                        <button name="action_reset_integration_factor"
                            title="Reset integration factor"
                            type="object"
                            icon="refresh"
                            class="btn-link"
                            invisible="not l10n_mx_is_integration_factor_manual"/>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
