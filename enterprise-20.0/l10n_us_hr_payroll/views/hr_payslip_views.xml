<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_form_inherit_l10n_us" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.l10n.us.hr.payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="paid_date" position="attributes">
                <attribute name="readonly">country_code == 'US' and state != 'draft'</attribute>
            </field>
        </field>
    </record>

</odoo>
