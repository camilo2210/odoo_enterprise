                                <td class="text-end"><span t-out="round(line['used'], 2)"
                                                           t-if="line['used'] &gt; 0"/></td>
                                <td class="text-end"><span t-out="round(line['accrual'], 2)"
                                                           t-if="line['accrual'] &gt; 0"/></td>
                                <td class="text-end"><span t-out="round(line['balance'], 2)"/></td>
                            </tr>
                        </span>
                    </t>
