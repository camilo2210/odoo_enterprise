    <xpath expr="//div[@id='to_pay']" position="replace">
        <div id="to_pay">
            <t t-set="net_to_pay" t-value="o.correction_net_delta if (is_correction and o.origin_payslip_id.state == 'paid') else o.net_wage"/>
            <t t-if="net_to_pay >= 0">
                <t t-set="payments" t-value="o.generate_payments_dict()"/>
                <t t-foreach="payments" t-as="payment">
                    <p>
                        Paid to
                        <span class="fw-bold"
                            t-out="('X' * (len(payment['account_num']) - 4) + payment['account_num'][-4:])
                                    if payment['account_num'] else 'xxxxxxxxxxxx'"/>
                        <span t-out="payment['partner']"/>:
                        <span t-out="payment['amount']"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                            class="fw-bold"/>
                            <br/>
                    </p>
                </t>
                <t t-if="not payments">
                    Amount to be paid to <span class="fst-italic" t-field="o.employee_id.legal_name"/>: <span t-out="net_to_pay" t-options='{"widget": "monetary", "display_currency": o.currency_id}' class="fw-bold"/>
                </t>
            </t>
            <p t-else="">
                The net amount will be recovered from the first positive remuneration established after this.
            </p>
        </div>
    </xpath>

</template>

<template id="report_light_payslip_us_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_us_hr_payroll.report_light_payslip_us"/>
        </t>
    </t>
</template>
</odoo>
