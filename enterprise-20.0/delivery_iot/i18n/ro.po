#. module: delivery_iot
#: model:ir.module.module,summary:base.module_delivery_iot
msgid "Use IoT devices in delivery operations"
msgstr ""

msgid "'Empty Report - Used for assigning IoT printer'"
msgstr "'Raport gol - Folosit pentru alocarea imprimantei IoT'"

msgid "Auto Print Carrier Labels"
msgstr "Tipărește automat etichete de transport"

msgid "Auto Print Export Documents"
msgstr "Tipărește automat documente de export"

msgid "Carrier Labels"
msgstr "Etichete de transport"

msgid "Export Documents"
msgstr "Documente de export"

msgid ""
"If this checkbox is ticked, Odoo will automatically print the carrier labels "
"of the picking when they are created. Note this requires a printer to be "
"assigned to this report."
msgstr ""
"Dacă această căsuță este bifată, Odoo va printa automat etichetele de "
"transport ale transferului când sunt create. De notat, Odoo are nevoie de o "
"imprimantă desemnată la acest raport."

msgid ""
"If this checkbox is ticked, Odoo will automatically print the export "
"documents of the picking when they are created. Availability of export "
"documents depends on the carrier and the destination. Note this requires a "
"printer to be assigned to this report. "
msgstr ""
"Dacă această căsuță este bifată, Odoo va printa automat documentele de "
"transport ale transferului când sunt create. Disponibilitatea acestora "
"depinde de curier și de destinație. De notat, Odoo are nevoie de o "
"imprimantă desemnată la acest raport. "

msgid "Report Action"
msgstr "Acțiune raport"

msgid "Reporting"
msgstr "Raportare"

msgid "Reset Linked Printers"
msgstr "Resetează imprimantele asociate"

msgid "Shipping Documents"
msgstr "Documente de Livrare"

msgid "Shipping Labels"
msgstr "Etichete de livrare"

msgid "Transfer"
msgstr "Transfer"
