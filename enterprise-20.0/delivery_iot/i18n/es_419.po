#. module: delivery_iot
#: model:ir.module.module,description:base.module_delivery_iot
msgid ""
"\n"
"Allows using IoT devices, such as scales and printers, for delivery "
"operations.\n"
msgstr ""

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__available_scale_ids
msgid "Available Scale"
msgstr "Báscula disponible"

#. module: delivery_iot
#: model:ir.model.fields,help:delivery_iot.field_stock_picking_type__iot_scale_ids
msgid ""
"Choose the scales you want to use for this operation type. Those scales can "
"be used to weigh the packages created."
msgstr ""
"Elige las básculas que quieres usar para este tipo de operación. Puedes usar "
"estas básculas para pesar los paquetes que crees."

#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid "Connect Scale"
msgstr "Conectar báscula"

