#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid ""
"If you connect your scales through the IoT App, the\n"
"                            weight of the package will be set automatically "
"when\n"
"                            you do a \"Put in Pack\" operation.\n"
"                            <br/>"
msgstr ""
"Si conectas tus básculas desde la aplicación IoT,\n"
"                            el sistema definirá el peso del paquete de forma "
"automática al\n"
"                            realizar una operación de tipo \"Incluir en el "
"paquete\".\n"
"                            <br/>"

