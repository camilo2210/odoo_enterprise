<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_self_order_menu_item" model="ir.ui.view">
        <field name="name">pos.config.kanban.view.inherit.pos_self_order_mobile</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_self_order.pos_self_order_menu_item"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_wizard'][hasclass('pos_open_session_btn')][@t-if='!record.current_session_id.raw_value']" position="replace">
                <widget t-if="!record.current_session_id.raw_value" name="pos_self_open_kiosk_button" action="action_open_wizard"/>
            </xpath>
            <xpath expr="//button[@name='action_open_wizard'][@t-if='record.current_session_id.raw_value']" position="replace">
                <widget t-if="record.current_session_id.raw_value" name="pos_self_open_kiosk_button" action="action_open_wizard"/>
            </xpath>
        </field>
    </record>
</odoo>
