<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="whatsapp.ThreadIcon" t-inherit="mail.ThreadIcon" t-inherit-mode="extension">
        <xpath expr="//*[@name='extra']" position="inside">
            <t t-if="this.channel?.channel_type === 'whatsapp'">
                <t name="whatsapp">
                    <t name="whatsapp_static">
                        <div class="oi text-success o-fs-small d-flex" data-icon="oi_whatsapp" t-att="attr" title="WhatsApp" />
                    </t>
                </t>
            </t>
        </xpath>
    </t>
</templates>
