<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.Message.notification" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <t t-if="this.message.message_type === 'whatsapp_message'">
                <span class="oi mx-1" data-icon="oi_whatsapp" t-att-class="this.getWhatsappStatusClass()" t-att-title="this.getWhatsappStatusTitle()"/>
            </t>
        </xpath>
    </t>

</templates>
