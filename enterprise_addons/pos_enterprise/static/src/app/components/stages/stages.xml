<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_enterprise.Stages">
        <section class="d-flex justify-content-center flex-grow-1 overflow-hidden">
            <div class="d-flex align-items-center justify-content-start gap-2 py-2 px-2 overflow-auto">
                <button class= "btn o_stage_tab px-3 py-2 fs-5"
                    t-attf-style="{{ this.prepDisplay.selectedStageId === 0 ? 'background-color: #C8C9CB30; border-color: #C8C9CB80;' : '' }}"
                    t-on-click="() => this.prepDisplay.selectStage(0)"
                >
                    All
                </button>
                <button
                    t-foreach="[...this.props.stages.values()]"
                    t-as="stage"
                    t-key="stage.id"
                    class="o_pdis_navbar_stage d-flex btn o_stage_tab px-3 py-2 fs-5"
                    t-att-class="{ 'selected': this.prepDisplay.selectedStageId === stage.id }"
                    t-on-click="() => this.prepDisplay.selectStage(stage.id)"
                    t-att-style="this.getStageStyle(stage)">
                    <p class="m-0 p-0 text-truncate" t-out="stage.name"/>
                    <span t-att-style="stage.color ? 'background-color:' + stage.color + '70;' : '' " class="o_stage_count ms-2 px-2 rounded fw-bold" t-out="this.orderCount(stage.id)"/>
                </button>
            </div>
        </section>
    </t>
</templates>
