<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_enterprise.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('filter-buttons')]" position="attributes">
            <attribute name="t-if" separator=" or " add="this.shouldShowPlatformFilterButton()"/>
        </xpath>
        <xpath expr="//div[hasclass('filter-buttons')]" position="inside">
            <button
                t-if="this.shouldShowPlatformFilterButton()"
                class="btn btn-lg btn-secondary text-nowrap"
                t-on-click="this.togglePlatformFilter"
                t-att-class="{'active' : this.state.isPlatformFilterActive}">
                Food Platform
            </button>
        </xpath>
    </t>
</templates>
