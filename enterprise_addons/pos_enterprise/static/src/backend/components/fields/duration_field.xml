<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_enterprise.DurationField">
        <span t-if="this.props.readonly" t-out="this.displayValue"/>
        <input t-else=""
               t-att-id="this.props.id"
               t-att-type="this.props.inputType"
               t-ref="this.numpadDecimalRef"
               class="o_input"
               autocomplete="off"/>
    </t>
</templates>
