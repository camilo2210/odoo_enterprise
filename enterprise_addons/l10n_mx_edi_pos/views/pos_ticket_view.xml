<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ticket_validation_screen" inherit_id="point_of_sale.ticket_validation_screen">
        <xpath expr="//form" position="before">
            <!-- For Mexican orders, the RFC is collected through the localisation
                 fields required to invoice. -->
            <t t-set="l10n_mx_hide_b2b_fields"
               t-value="pos_order.company_id.account_fiscal_country_id.code == 'MX'"/>
        </xpath>
    </template>

</odoo>
