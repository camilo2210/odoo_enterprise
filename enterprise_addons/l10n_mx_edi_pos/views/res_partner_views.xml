<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pos_ui_inherit_l10n_mx_edi_pos" model="ir.ui.view">
        <field name="name">res.partner.form.pos.ui.inherit.l10n_mx_edi_pos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="point_of_sale.view_partner_form_pos_ui"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="l10n_mx_edi_fiscal_regime" invisible="'MX' not in fiscal_country_codes"/>
                <field name="l10n_mx_edi_usage" invisible="'MX' not in fiscal_country_codes"/>
            </xpath>
        </field>
    </record>
</odoo>
