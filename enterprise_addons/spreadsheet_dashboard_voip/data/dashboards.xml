<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dashboard_phone" model="spreadsheet.dashboard">
        <field name="name">Phone</field>
        <field name="spreadsheet_binary_data" type="bytes" file="spreadsheet_dashboard_voip/data/files/phone_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('voip.model_voip_call'))]"/>
        <field name="sample_dashboard_file_path">spreadsheet_dashboard_voip/data/files/phone_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_project"/>
        <field name="group_ids" eval="[Command.link(ref('voip.group_voip_officer'))]"/>
        <field name="sequence">310</field>
        <field name="is_published">True</field>
    </record>

</odoo>
