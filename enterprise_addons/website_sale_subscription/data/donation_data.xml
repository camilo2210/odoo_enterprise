<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_recurring_donation" model="product.template">
            <field name="name">Recurring Donation</field>
            <field name="type">service</field>
            <field name="categ_id" eval="ref('website_sale.product_category_donations', raise_if_not_found=False)"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="recurring_invoice" eval="True"/>
            <field name="list_price">1.0</field>
            <field name="taxes_id" eval="False"/>
            <field name="image_1920" type="bytes" file="website_sale_subscription/static/src/img/recurring_donation.png"/>
        </record>

        <record id="product_recurring_donation_pricing_monthly" model="product.pricelist.item">
            <field name="plan_id" eval="ref('sale_subscription.subscription_plan_month', raise_if_not_found=False)"/>
            <field name="product_tmpl_id" ref="product_recurring_donation"/>
            <field name="fixed_price">1.0</field>
            <field name="pricelist_id" eval="False"/>
        </record>

        <record id="product_recurring_donation_pricing_yearly" model="product.pricelist.item">
            <field name="plan_id" eval="ref('sale_subscription.subscription_plan_year', raise_if_not_found=False)"/>
            <field name="product_tmpl_id" ref="product_recurring_donation"/>
            <field name="fixed_price">1.0</field>
            <field name="pricelist_id" eval="False"/>
        </record>

    </data>
</odoo>
