<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_sale_subscription.donation.recurrenceSelect">
    <div class="s_donation_recurrence_wrapper d-inline-block">
        <input
            type="hidden"
            class="s_donation_recurrence_select"
            value=""
        />
        <div class="dropdown">
            <button
                class="btn btn-light dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                t-att-aria-label="ariaLabel"
                t-out="options[0].name"
            />
            <ul class="dropdown-menu">
                <t
                    t-foreach="options"
                    t-as="option"
                    t-key="option.id"
                >
                    <li>
                        <button
                            t-attf-class="dropdown-item{{ option_index === 0 ? ' active' : '' }}"
                            type="button"
                            t-att-data-value="option.id"
                            t-out="option.name"
                        />
                    </li>
                </t>
            </ul>
        </div>
    </div>
</t>

</templates>
