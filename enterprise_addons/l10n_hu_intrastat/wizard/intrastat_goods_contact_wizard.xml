<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="intrastat_goods_contact_form" model="ir.ui.view">
            <field name="name">l10n_hu_intrastat.intrastat.goods.contact.wizard.form</field>
            <field name="model">l10n_hu_intrastat.intrastat.goods.contact.wizard</field>
            <field name="arch" type="xml">
                <form string="Contacts Data">
                    <div class="alert alert-warning" role="alert" invisible="l10n_hu_intrastat_contacts_validity">
                        The executive and/or contact person is missing either a name, an email, or a phone number.
                    </div>
                    <sheet>
                        <group id="contact_executive">
                            <separator string="Executive"/>
                            <field name="l10n_hu_intrastat_contact_executive" required="True"/>
                            <field name="l10n_hu_intrastat_contact_executive_status" required="True"/>
                        </group>
                        <group id="contact_person">
                            <separator string="Contact Person"/>
                            <field name="l10n_hu_intrastat_contact_person" required="True"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Submit" name="action_submit_contacts" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
