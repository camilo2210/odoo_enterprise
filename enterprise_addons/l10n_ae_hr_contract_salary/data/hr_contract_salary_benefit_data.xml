<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="l10n_ae_monthly_benefit" model="hr.contract.salary.benefit.type">
            <field name="name">Monthly Benefit in Kind</field>
            <field name="sequence">5</field>
            <field name="periodicity">monthly</field>
        </record>

        <record id="l10n_ae_housing_allowance_amount" model="hr.contract.salary.benefit">
            <field name="name">Housing Allowance</field>
            <field name="show_name">True</field>
            <field name="res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_housing_allowance')])"/>
            <field name="cost_res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_housing_allowance')])"/>
            <field name="sequence">5</field>
            <field name="benefit_type_id" ref="l10n_ae_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_ae_hr_payroll.uae_employee_payroll_structure_type"/>
            <field name="display_type">always</field>
        </record>

        <record id="l10n_ae_transportation_allowance_amount" model="hr.contract.salary.benefit">
            <field name="name">Transportation Allowance</field>
            <field name="show_name">True</field>
            <field name="res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_transportation_allowance')])"/>
            <field name="cost_res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_transportation_allowance')])"/>
            <field name="sequence">5</field>
            <field name="benefit_type_id" ref="l10n_ae_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_ae_hr_payroll.uae_employee_payroll_structure_type"/>
            <field name="display_type">always</field>
        </record>

        <record id="l10n_ae_other_allowances_amount" model="hr.contract.salary.benefit">
            <field name="name">Other Allowance</field>
            <field name="show_name">True</field>
            <field name="res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_other_allowances')])"/>
            <field name="cost_res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_ae_other_allowances')])"/>
            <field name="sequence">5</field>
            <field name="benefit_type_id" ref="l10n_ae_monthly_benefit"/>
            <field name="structure_type_id" ref="l10n_ae_hr_payroll.uae_employee_payroll_structure_type"/>
            <field name="display_type">always</field>
        </record>
    </data>
</odoo>
