<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="social_post_template_view_form" model="ir.ui.view">
        <field name="name">social.post.template.view.form.inherit.instagram</field>
        <field name="model">social.post.template</field>
        <field name="priority">25</field>
        <field name="inherit_id" ref="social.social_post_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_social_post_preview_container')]" position="inside">
                <field name="display_instagram_preview" invisible="1" />
                <field name="instagram_preview" nolabel="1" colspan="2"
                    widget="social_post_preview" media_type="instagram"
                    readonly="1"
                    invisible="not display_instagram_preview"
                    class="o_social_preview_wrapper m-0 px-4 py-4 bg-200"/>
            </xpath>
            <xpath expr="//notebook[@name='media_customization']" position="inside">
                <page string="Instagram" name="instagram_content"
                    invisible="not has_instagram_account">
                    <group>
                        <group>
                            <field name="instagram_post_as_story" string="Post as Story"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_instagram_label_message" colspan="2"
                                invisible="instagram_post_as_story">Message</div>
                            <field name="instagram_message"
                                required="is_split_per_media and has_instagram_account and not instagram_image_ids and not instagram_post_as_story"
                                invisible="instagram_post_as_story"
                                nolabel="1" colspan="2" widget="social_post_message_field" social_media="instagram"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_instagram_label_media" colspan="2">Media</div>
                            <field name="instagram_image_ids"
                                class="o_social_post_image"
                                options="{'force_create': True, 'set_attachment_id': True, 'only_image': True}"
                                required="is_split_per_media and has_instagram_account and (not instagram_message or instagram_post_as_story)"
                                mode="kanban"
                                add-label="Add Media"
                                colspan="2"
                                nolabel="1"
                                widget="x2_many_media_viewer"/>
                            <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small o_social_instagram_label_first_comment" colspan="2"
                                invisible="instagram_post_as_story">Scheduled first comment</div>
                            <field name="instagram_first_comment" invisible="instagram_post_as_story" colspan="2" nolabel="1" placeholder="Comment your own post to get the conversation going or share some extra content."/>
                        </group>
                        <group invisible="not display_instagram_preview" class="o_social_post_preview_group">
                            <field name="instagram_preview" nolabel="1"
                                widget="social_post_preview"
                                media_type="instagram_preview"
                                readonly="1"
                                class="o_social_preview_wrapper m-0 px-4 py-4 bg-200 h-100"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</data>
</odoo>
