<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_obox_pos_printer_form_mobile" model="ir.ui.view">
        <field name="name">obox.pos.printer.form.view.mobile</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="obox_point_of_sale.view_obox_pos_printer_form"/>
        <field name="arch" type="xml">
            <field name="printer_ip" position="before">
                <label for="obox_device_id" invisible="printer_type != 'obox'"/>
                <div class="d-flex flex-column" invisible="printer_type != 'obox'">
                    <widget name="obox_add_local_printer"/>
                </div>
            </field>
            <widget name="obox_add_local_printer" position="before">
                <xpath expr="//field[@name='obox_device_id']" position="move"/>
            </widget>
        </field>
    </record>
</odoo>
