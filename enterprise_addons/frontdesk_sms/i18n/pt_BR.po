#. module: frontdesk_sms
#: model:sms.template,body:frontdesk_sms.frontdesk_sms_template
msgid ""
"Hello, Your visitor {{ object.name }} {{ '(%s)' % object.phone if "
"object.phone else '' }} {{ '(%s)' % object.company if object.company else "
"'' }} wants to meet you at {{ object.station_id.name }}. Please let them "
"know you'll be there shortly."
msgstr ""
"Olá, o seu visitante {{ object.name }} {{ '(%s)' % object.phone if "
"object.phone else '' }} {{ '(%s)' % object.company if object.company else "
"'' }} quer encontrá-lo em {{ object.station_id.name }}. Informa que você "
"estará lá em breve."

