<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="planning_slot_view_form" model="ir.ui.view">
        <field name="name">planning.slot.view.form.inherited.helpdesk_planning_field_service</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning_field_service.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    string="Ticket"
                    type="object"
                    name="action_open_helpdesk_ticket"
                    class="oe_stat_button"
                    icon="support"
                    groups="helpdesk.group_helpdesk_user"
                    invisible="not helpdesk_ticket_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
