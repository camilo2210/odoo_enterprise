<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_timesheet_form_inherit" model="ir.ui.view">
        <field name="name">product.template.timesheet.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='service_policy_div']" position="after">
                <div class="o_td_label d-inline-flex" invisible="not planning_enabled">
                    <label for='worksheet_template_id'/>
                    <span class='oi oi-lg oi-fw' data-icon="business" title="Values set here are company-specific." groups="base.group_multi_company"/>
                </div>
                <field name="worksheet_template_id" placeholder="e.g. Device Installation"
                    context="{'default_res_model': 'planning.slot'}"
                    invisible="not planning_enabled"
                    nolabel="1" options="{'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
