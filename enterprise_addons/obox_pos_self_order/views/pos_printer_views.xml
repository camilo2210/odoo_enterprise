<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_printer_form_obox_self_order" model="ir.ui.view">
        <field name="name">pos.printer.view.obox.self.order</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <field name="use_lna" position="after">
                <field name="proxy_obox_id" invisible="printer_type != 'epson_epos'" options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
        </field>
    </record>
</odoo>
