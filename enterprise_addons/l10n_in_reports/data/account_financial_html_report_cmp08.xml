<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="account_report_cmp_08" model="account.report">
        <field name="name">CMP-08</field>
        <field name="country_id" ref="base.in"/>
        <field name="filter_multi_company">tax_units</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="default_opening_date_filter">this_quarter</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="custom_handler_model_id" ref="model_l10n_in_report_handler"/>
        <field name="column_ids">
            <record id="account_report_cmp_08_base_column" model="account.report.column">
                <field name="name">Base</field>
                <field name="expression_label">tax_base</field>
            </record>
            <record id="account_report_cmp_08_igst_column" model="account.report.column">
                <field name="name">IGST</field>
                <field name="expression_label">tax_igst</field>
            </record>
            <record id="account_report_cmp_08_cgst_column" model="account.report.column">
                <field name="name">CGST</field>
                <field name="expression_label">tax_cgst</field>
            </record>
            <record id="account_report_cmp_08_sgst_column" model="account.report.column">
                <field name="name">SGST/UTGST</field>
                <field name="expression_label">tax_sgst</field>
            </record>
            <record id="account_report_cmp_08_cess_column" model="account.report.column">
                <field name="name">CESS</field>
                <field name="expression_label">tax_cess</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_report_cmp_08_3_1_taxable_supplies" model="account.report.line">
                <field name="name">3.1 Taxable Outward Supplies</field>
                <field name="code">TOS</field>
                <field name="expression_ids">
                    <record id="account_report_cmp_08_3_1_taxable_expression_tax_base" model="account.report.expression">
                        <field name="label">tax_base</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', '=', 'sale_composition_supplies'), ('display_type', '=', 'product')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                    <record id="account_report_cmp_08_3_1_taxable_expression_tax_cgst" model="account.report.expression">
                        <field name="label">tax_cgst</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_outward_supplies_tax_amounts</field>
                        <field name="subformula">tax_amount</field>
                    </record>
                    <record id="account_report_cmp_08_3_1_taxable_expression_tax_sgst" model="account.report.expression">
                        <field name="label">tax_sgst</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_outward_supplies_tax_amounts</field>
                        <field name="subformula">tax_amount</field>
                    </record>
                </field>
            </record>
            <record id="account_report_cmp_08_3_2" model="account.report.line">
                <field name="name">3.2 Inward Supplies attracting Reverse Charge including Import of Services</field>
                <field name="code">INWARD</field>
                <field name="expression_ids">
                    <record id="account_report_cmp_08_3_2_expression_tax_base" model="account.report.expression">
                        <field name="label">tax_base</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['purchase_b2b_rcm', 'purchase_b2c_rcm', 'purchase_imp_services', 'purchase_imp_services_rcm', 'purchase_cdnr_rcm', 'purchase_cdnur_rcm']), ('display_type', '=', 'product')]"/>
                        <field name="subformula">sum</field>
                    </record>
                    <record id="account_report_cmp_08_3_2_expression_tax_igst" model="account.report.expression">
                        <field name="label">tax_igst</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['purchase_b2b_rcm', 'purchase_b2c_rcm', 'purchase_imp_services', 'purchase_imp_services_rcm', 'purchase_cdnr_rcm', 'purchase_cdnur_rcm']), ('tax_tag_ids', '=', ref('l10n_in.tax_tag_igst'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                    <record id="account_report_cmp_08_3_2_expression_tax_cgst" model="account.report.expression">
                        <field name="label">tax_cgst</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['purchase_b2b_rcm', 'purchase_b2c_rcm', 'purchase_imp_services', 'purchase_imp_services_rcm', 'purchase_cdnr_rcm', 'purchase_cdnur_rcm']), ('tax_tag_ids', '=', ref('l10n_in.tax_tag_cgst'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                    <record id="account_report_cmp_08_3_2_expression_tax_sgst" model="account.report.expression">
                        <field name="label">tax_sgst</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['purchase_b2b_rcm', 'purchase_b2c_rcm', 'purchase_imp_services', 'purchase_imp_services_rcm', 'purchase_cdnr_rcm', 'purchase_cdnur_rcm']), ('tax_tag_ids', '=', ref('l10n_in.tax_tag_sgst'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                    <record id="account_report_cmp_08_3_2_expression_tax_cess" model="account.report.expression">
                        <field name="label">tax_cess</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('l10n_in_gstr_section', 'in', ['purchase_b2b_rcm', 'purchase_b2c_rcm', 'purchase_imp_services', 'purchase_imp_services_rcm', 'purchase_cdnr_rcm', 'purchase_cdnur_rcm']), ('tax_tag_ids', '=', ref('l10n_in.tax_tag_cess'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="account_report_cmp_08_3_3" model="account.report.line">
                <field name="name">3.3 Tax Payable</field>
                <field name="expression_ids">
                    <record id="account_report_cmp_08_3_3_expression_tax_base" model="account.report.expression">
                        <field name="label">tax_base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">TOS.tax_base + INWARD.tax_base</field>
                    </record>
                    <record id="account_report_cmp_08_3_3_expression_tax_igst" model="account.report.expression">
                        <field name="label">tax_igst</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">INWARD.tax_igst</field>
                    </record>
                    <record id="account_report_cmp_08_3_3_expression_tax_cgst" model="account.report.expression">
                        <field name="label">tax_cgst</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">TOS.tax_cgst + INWARD.tax_cgst</field>
                    </record>
                    <record id="account_report_cmp_08_3_3_expression_tax_sgst" model="account.report.expression">
                        <field name="label">tax_sgst</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">TOS.tax_sgst + INWARD.tax_sgst</field>
                    </record>
                    <record id="account_report_cmp_08_3_3_expression_tax_cess" model="account.report.expression">
                        <field name="label">tax_cess</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">INWARD.tax_cess</field>
                    </record>
                </field>
            </record>
            <record id="account_report_cmp_08_3_4" model="account.report.line">
                <field name="name">3.4 Interest, Late Fee, Penalty and Others (Manual)</field>
                <field name="expression_ids">
                    <record id="account_report_cmp_08_3_4_expression_tax_igst" model="account.report.expression">
                        <field name="label">tax_igst</field>
                        <field name="engine">external</field>
                        <field name="formula">sum</field>
                        <field name="subformula">editable</field>
                    </record>
                    <record id="account_report_cmp_08_3_4_expression_tax_cgst" model="account.report.expression">
                        <field name="label">tax_cgst</field>
                        <field name="engine">external</field>
                        <field name="formula">sum</field>
                        <field name="subformula">editable</field>
                    </record>
                    <record id="account_report_cmp_08_3_4_expression_tax_sgst" model="account.report.expression">
                        <field name="label">tax_sgst</field>
                        <field name="engine">external</field>
                        <field name="formula">sum</field>
                        <field name="subformula">editable</field>
                    </record>
                    <record id="account_report_cmp_08_3_4_expression_tax_cess" model="account.report.expression">
                        <field name="label">tax_cess</field>
                        <field name="engine">external</field>
                        <field name="formula">sum</field>
                        <field name="subformula">editable</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="action_account_report_cmp_08" model="ir.actions.client">
        <field name="name">CMP-08 Report</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('l10n_in_reports.account_report_cmp_08')}"/>
    </record>

    <menuitem id="menu_account_report_cmp_08" name="CMP-08" sequence="6" parent="l10n_in.account_reports_in_statements_menu" action="action_account_report_cmp_08" groups="base.group_no_one"/>
</odoo>
