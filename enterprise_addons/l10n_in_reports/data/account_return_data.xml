<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--GSTR-1 Return -->
        <record id="in_gstr1_return_type" model="account.return.type">
            <field name="name">GSTR-1</field>
            <field name="report_id" ref="l10n_in_reports.account_report_gstr1"/>
            <field name="country_id" ref="base.in"/>
            <field name="states_workflow">l10n_in_gstr1_status</field>
            <field name="default_deadline_days_delay">7</field>
            <field name='auto_generate' eval='False'/>
        </record>

        <!--GSTR-2B Return -->
        <record id="in_gstr2b_return_type" model="account.return.type">
            <field name="name">GSTR-2B</field>
            <field name="report_id" ref="l10n_in_reports.account_report_gstr2b"/>
            <field name="country_id" ref="base.in" />
            <field name="default_deadline_periodicity">monthly</field>
            <field name="states_workflow">l10n_in_gstr2b_status</field>
            <field name="default_deadline_days_delay">14</field>
            <field name='auto_generate' eval='False'/>
        </record>

        <!--CMP-08 Return -->
        <record id="in_cmp08_return_type" model="account.return.type">
            <field name="name">CMP-08</field>
            <field name="report_id" ref="l10n_in_reports.account_report_cmp_08"/>
            <field name="country_id" ref="base.in"/>
            <field name="default_deadline_periodicity">trimester</field>
            <field name="states_workflow">generic_state_review_submit</field>
            <field name='auto_generate' eval='False'/>
            <field name="default_deadline_days_delay">12</field>
        </record>

        <!--GSTR-4 Return -->
        <record id="in_gstr4_return_type" model="account.return.type">
            <field name="name">GSTR-4</field>
            <field name="report_id" ref="l10n_in_reports.account_report_gstr4"/>
            <field name="country_id" ref="base.in"/>
            <field name="default_deadline_periodicity">fiscalyear</field>
            <field name="states_workflow">generic_state_review_submit</field>
            <field name='auto_generate' eval='False'/>
            <field name="default_deadline_days_delay">86</field>
        </record>

        <!-- Audit (Form 26) -->
        <record id="l10n_in_form_26_audit_return_type" model="account.return.type">
            <field name="name">Audit IN (Form 26)</field>
            <field name="category">audit</field>
            <field name="country_id" ref="base.in"/>
            <field name="default_deadline_periodicity">fiscalyear</field>
        </record>

        <!--GSTR-1 IFF Return -->
        <record id="in_gstr_iff_return_type" model="account.return.type">
            <field name="name">GSTR-1 IFF</field>
            <field name="report_id" ref="l10n_in_reports.account_report_gstr_iff"/>
            <field name="country_id" ref="base.in"/>
            <field name="states_workflow">l10n_in_gstr1_status</field>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">7</field>
            <field name="auto_generate" eval="False"/>
            <field name="active_fallback">False</field>
        </record>
    </data>
</odoo>
