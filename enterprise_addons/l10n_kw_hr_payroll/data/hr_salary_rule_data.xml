    <record id="l10n_kw_monthly_pay_eos_benefit" model="hr.salary.rule">
        <field name="name">End of Service Benefit</field>
        <field name="code">EOS_BENEFIT</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
        <field name="sequence">160</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = employee.departure_date and employee.departure_reason_id and (payslip.date_from &lt;= employee.departure_date &lt;= payslip.date_to)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
start_date = employee._get_first_contract_date()
end_date = employee.departure_date
difference = relativedelta(end_date, start_date)
total_years = difference.years + difference.months / 12.0 + difference.days / 365.25

if total_years &lt;= 5:
    indemnity = total_years * (version.wage / 2.0)
else:
    first_five_amount = 5.0 * (version.wage / 2.0)
    remaining_years_amount = (total_years - 5.0) * version.wage
    indemnity = first_five_amount + remaining_years_amount

if employee.departure_reason_id == payslip.env.ref('hr.departure_fired', raise_if_not_found=False):
    result = 0.0
elif employee.departure_reason_id == payslip.env.ref('hr.departure_resigned', raise_if_not_found=False):
    if total_years &lt; 3:
        result = 0.0
    elif 3 &lt;= total_years &lt; 5:
        result = indemnity * 0.5
    elif 5 &lt;= total_years &lt; 10:
        result = indemnity * (2/3.0)
    else:
        result = indemnity
else:
    # End of Contract or other reasons -> 100%
    result = indemnity
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_kw_monthly_pay')])]"/>
        <field name="country_id" ref="base.kw"/>
    </record>

    <record id="l10n_kw_monthly_pay_sick_leave" model="hr.salary.rule">
        <field name="name">Sick Leave Pay</field>
        <field name="code">SICK_PAY</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
        <field name="sequence">105</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = '013.00' in worked_days and worked_days['013.00'].number_of_days &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
current_sick_days = worked_days['013.00'].number_of_days
year_start = payslip.date_from.replace(month=1, day=1)

past_payslips = payslip.env['hr.payslip'].search([
    ('employee_id', '=', employee.id),
    ('state', 'in', ['validated', 'paid']),
    ('date_from', '&gt;=', year_start),
    ('date_from', '&lt;', payslip.date_from),
    ('company_id', '=', payslip.company_id.id),
])

past_sick_days = past_payslips._get_worked_days_line_values(['013.00'], ['number_of_days'], compute_sum=True)['013.00']['sum']['number_of_days']

count_worked_days = sum(worked_days[wd].number_of_days for wd in worked_days if worked_days[wd].code != '040.00') or 1.0
daily_wage = version.wage / count_worked_days

total_amount = 0.0

days_left = current_sick_days
current_used = past_sick_days

while days_left &gt; 0:
    if current_used &lt; 15:
        rate = 1.0
        tier_limit = 15 - current_used
    elif current_used &lt; 25:
        rate = 0.75
        tier_limit = 25 - current_used
    elif current_used &lt; 35:
        rate = 0.50
        tier_limit = 35 - current_used
    elif current_used &lt; 45:
        rate = 0.25
        tier_limit = 45 - current_used
    else:
        rate = 0.0
        tier_limit = days_left

    step = min(days_left, tier_limit)
    total_amount += (daily_wage * step * rate)
    current_used += step
    days_left -= step

result = total_amount
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_kw_monthly_pay')])]"/>
        <field name="country_id" ref="base.kw"/>
    </record>

    <record id="l10n_kw_monthly_pay_remaining_leaves_compensation" model="hr.salary.rule">
        <field name="name">Remaining Leaves Compensation</field>
        <field name="code">REM_LEAVE</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
        <field name="sequence">170</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = employee.departure_date and employee.departure_reason_id and (payslip.date_from &lt;= employee.departure_date &lt;= payslip.date_to)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
leave_type = payslip.company_id.l10n_kw_annual_work_entry_type_id

if leave_type:
    allocations = payslip.env['hr.leave.allocation'].search([
        ('employee_id', '=', employee.id),
        ('work_entry_type_id', '=', leave_type.id),
        ('state', '=', 'validate'),
        ('employee_company_id', '=', payslip.company_id.id),
        '|', ('date_to', '=', False), ('date_to', '&gt;=', employee.departure_date),
    ])
    leaves = payslip.env['hr.leave'].search([
        ('employee_id', '=', employee.id),
        ('work_entry_type_id', '=', leave_type.id),
        ('state', '=', 'validate'),
        ('employee_company_id', '=', payslip.company_id.id),
    ])

    allocated_days = sum(allocations.mapped('number_of_days'))
    taken_days = sum(leaves.mapped('number_of_days'))
    remaining_days = allocated_days - taken_days

    count_worked_days = sum(worked_days[wd].number_of_days for wd in worked_days if worked_days[wd].code != '040.00') or 1.0
    daily_wage = (version.wage / count_worked_days) if version else 0.0

    result = max(remaining_days, 0.0) * daily_wage
else:
    result = 0.0
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_kw_monthly_pay')])]"/>
        <field name="country_id" ref="base.kw"/>
    </record>

