    <record id="l10n_kw_monthly_pay_eos_provision" model="hr.salary.rule">
        <field name="name">End of Service Provision</field>
        <field name="code">EOS_PROV</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_kw_hr_payroll.l10n_kw_category_provisions')])]"/>
        <field name="sequence">115</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
start_date = employee._get_first_contract_date()
end_date = payslip.date_to
difference = relativedelta(end_date, start_date)
years_of_service = difference.years + difference.months / 12.0 + difference.days / 365.25

if years_of_service &lt; 5:
    result = (categories['PENSION_BASE'] / 2.0) / 12.0
else:
    result = categories['PENSION_BASE'] / 12.0
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_kw_monthly_pay')])]"/>
        <field name="country_id" ref="base.kw"/>
    </record>

    <record id="l10n_kw_monthly_pay_annual_leave_provision" model="hr.salary.rule">
        <field name="name">Annual Leave Provision</field>
        <field name="code">LEAVE_PROV</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_kw_hr_payroll.l10n_kw_category_provisions')])]"/>
        <field name="sequence">120</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
yearly_eligibility = version.l10n_kw_annual_leave_eligibility or 30.0
monthly_accrual = yearly_eligibility / 12.0

count_worked_days = sum(worked_days[wd].number_of_days for wd in worked_days if worked_days[wd].code != '040.00') or 1.0
daily_wage = categories['PENSION_BASE'] / count_worked_days

result = daily_wage * monthly_accrual
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_kw_monthly_pay')])]"/>
        <field name="country_id" ref="base.kw"/>
    </record>

