<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TAX REPORTS: SALES / PURCHASES -->
    <record id="sales_tax_report" model="account.report">
        <field name="name">Sales</field>
        <field name="name@vi_VN">Bán ra</field>
        <field name="country_id" ref="base.vn"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_quarter</field>
        <field name="search_bar" eval="False"/>
        <field name="load_more_limit" eval="80"/>
        <field name="custom_handler_model_id" ref="model_l10n_vn_sales_tax_report_handler"/>
        <field name="column_ids">
            <record id="sales_tax_report_invoice_number" model="account.report.column">
                <field name="name">Invoice Number</field>
                <field name="name@vi_VN">Số hoá đơn</field>
                <field name="expression_label">invoice_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="sales_tax_report_invoice_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="name@vi_VN">Ngày/tháng/năm lập hoá đơn</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="sales_tax_report_partner_id" model="account.report.column">
                <field name="name">Customer</field>
                <field name="name@vi_VN">Tên người mua/bán</field>
                <field name="expression_label">partner_id</field>
                <field name="figure_type">string</field>
            </record>
            <record id="sales_tax_report_tax_id" model="account.report.column">
                <field name="name">Tax ID</field>
                <field name="name@vi_VN">MST</field>
                <field name="expression_label">tax_id</field>
                <field name="figure_type">string</field>
            </record>
            <record id="sales_tax_report_ref" model="account.report.column">
                <field name="name">Description</field>
                <field name="name@vi_VN">Diễn giải</field>
                <field name="expression_label">ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="sales_tax_report_untaxed_amount" model="account.report.column">
                <field name="name">Untaxed sales of goods and services</field>
                <field name="name@vi_VN">Doanh thu chưa có thuế GTGT</field>
                <field name="expression_label">untaxed_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="sales_tax_report_amount_tax" model="account.report.column">
                <field name="name">VAT Amount</field>
                <field name="name@vi_VN">Thuế GTGT</field>
                <field name="expression_label">tax_amount</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>

    <record id="purchase_tax_report" model="account.report">
        <field name="name">Purchase</field>
        <field name="name@vi_VN">Mua vào</field>
        <field name="country_id" ref="base.vn"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_quarter</field>
        <field name="search_bar" eval="False"/>
        <field name="load_more_limit" eval="80"/>
        <field name="custom_handler_model_id" ref="model_l10n_vn_purchase_tax_report_handler"/>
        <field name="column_ids">
            <record id="purchase_tax_report_invoice_number" model="account.report.column">
                <field name="name">Invoice Number</field>
                <field name="name@vi_VN">Số hoá đơn</field>
                <field name="expression_label">invoice_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="purchase_tax_report_invoice_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="name@vi_VN">Ngày/tháng/năm lập hoá đơn</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="purchase_tax_report_partner_id" model="account.report.column">
                <field name="name">Customer</field>
                <field name="name@vi_VN">Tên người mua/bán</field>
                <field name="expression_label">partner_id</field>
                <field name="figure_type">string</field>
            </record>
            <record id="purchase_tax_report_tax_id" model="account.report.column">
                <field name="name">Tax ID</field>
                <field name="name@vi_VN">MST</field>
                <field name="expression_label">tax_id</field>
                <field name="figure_type">string</field>
            </record>
            <record id="purchase_tax_report_ref" model="account.report.column">
                <field name="name">Description</field>
                <field name="name@vi_VN">Diễn giải</field>
                <field name="expression_label">ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="purchase_tax_report_untaxed_amount" model="account.report.column">
                <field name="name">Untaxed purchase of goods and services</field>
                <field name="name@vi_VN">Doanh số mua chưa có thuế</field>
                <field name="expression_label">untaxed_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="purchase_tax_report_amount_tax" model="account.report.column">
                <field name="name">VAT Amount</field>
                <field name="name@vi_VN">Thuế GTGT</field>
                <field name="expression_label">tax_amount</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>

    <record id="tax_report" model="account.report">
        <field name="name">Sales/Purchase Tax Report</field>
        <field name="name@vi_VN">Bảng kê hoá đơn mua vào/bán ra</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.vn"/>
        <field name="sequence">20</field>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_quarter</field>
        <field name="search_bar" eval="True"/>
        <field name="load_more_limit" eval="80"/>
        <field name="use_sections" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_vn_tax_report_handler"/>
        <field name="section_report_ids" eval="[(6, 0, [ref('l10n_vn_reports.sales_tax_report'), ref('l10n_vn_reports.purchase_tax_report')])]"/>
    </record>

    <!-- TAX REPORTS: FORM01 / APPENDIX 142 -->
    <record id="appendix_142_report" model="account.report">
        <field name="name">Appendix 142</field>
        <field name="name@vi_VN">Phụ lục 142</field>
        <field name="country_id" ref="base.vn"/>
        <field name="custom_handler_model_id" ref="l10n_vn_reports.model_l10n_vn_reports_appendix_142_report_handler"/>
        <field name="column_ids">
            <record id="appendix_142_report_purch_col3" model="account.report.column">
                <field name="name"></field>
                <field name="expression_label">base_amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="appendix_142_report_purch_col4" model="account.report.column">
                <field name="name"></field>
                <field name="expression_label">vat_amount</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>

    </record>

    <record id="l10n_vn_tax_report" model="account.report">
        <field name="name">VAT Declaration - 01/GTGT</field>
        <field name="name@vi_VN">Báo cáo thuế Việt Nam</field>
        <field name="country_id" ref="base.vn"/>
        <field name="sequence">10</field>
        <field name="search_bar" eval="False"/>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="load_more_limit" eval="80"/>
        <field name="default_opening_date_filter">this_month</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_partner" eval="False"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="use_sections" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_vn_reports_form_01_gtgt_report_handler"/>
        <field name="section_report_ids" eval="[Command.set([ref('l10n_vn.form_01_gtgt_report'), ref('l10n_vn_reports.appendix_142_report')])]"/>
    </record>

    <record id="l10n_vn.form_01_gtgt_report" model="account.report">
            <field name="root_report_id" eval="False"/>
    </record>

    <!-- PDF EXPORT OF APPENDIX 142 -->
   <template id="l10n_vn_appendix142_report_pdf_export" inherit_id="account_reports.pdf_export_main" primary="True">
       <xpath expr="//div[hasclass('d-flex')][hasclass('align-items-start')]" position="replace">
                <div class="d-flex align-items-start">
                    <t t-foreach="options.get('horizontal_split') and ['left', 'right'] or [None]" t-as="split_side">
                        <table t-attf-class="o_table  #{options.get('horizontal_split') and 'horizontal_split_page'}">
                            <!-- Header -->
                            <t t-call="l10n_vn_reports.l10n_vn_appendix142_report_pdf_export_first_header"/>

                            <!-- Body -->
                            <tbody>
                                <t t-if="lines">
                                    <t t-call="{{custom_templates.get('pdf_export_main_table_body', 'account_reports.pdf_export_main_table_body')}}"
                                        lines="filter(lambda x: not split_side or split_side == (x.horizontal_split_side or 'left'), purchase_lines)"/>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
                <div class="d-flex align-items-start">
                    <t t-foreach="options.get('horizontal_split') and ['left', 'right'] or [None]" t-as="split_side">
                        <table t-attf-class="o_table  #{options.get('horizontal_split') and 'horizontal_split_page'}">
                        <thead id="table_header">
                            <t t-foreach="options['column_headers']" t-as="column_header">
                                <tr id="table_header2_row" class="">
                                    <th class="text-start" colspan="5">II. Sold Goods and Services in the period</th>
                                </tr>
                            </t>
                        </thead>
                            <!-- Body -->
                            <tbody>
                                <t t-if="lines">
                                <t t-call="l10n_vn_reports.l10n_vn_appendix142_report_pdf_export_sales_lines_body"
                                        lines="filter(lambda x: not split_side or split_side == (x.horizontal_split_side or 'left'), sales_lines)"/>
                                </t>

                            <tr id="table_header2_row" class="">
                                <th class="text-start" colspan="4">III. Difference of VAT amount between Purchased and Sold Goods and Services in the period which applies the 8% VAT rate:
                                </th>
                                <th class="text-end"><t t-out="section_3_total"/></th>
                            </tr>
                            </tbody>
                    </table>
                    </t>
                </div>
       </xpath>
   </template>

   <template id="l10n_vn_appendix142_report_pdf_export_first_header" inherit_id="account_reports.pdf_export_main_table_header" primary="True">
        <xpath expr="//thead//tr[last()]" position="after">
            <tr class="">
                <th class="text-start" colspan="5">I. Purchased Goods and Services in the period with 8% VAT rate</th>
            </tr>
        </xpath>
    </template>

   <template id="l10n_vn_appendix142_report_pdf_export_sales_lines_body" inherit_id="account_reports.pdf_export_main_table_body" primary="True">
       <xpath expr="//t/tr[@id='pdf_export_main_table_body_spacing_row']/td[1]" position="after">
            <td style="max-width: 100px;"/>
            <td style="max-width: 100px;"/>
        </xpath>
        <xpath expr="//tr[@name='pdf_export_main_table_body_lines_tr']/t[@t-as='cell']" position="replace">
            <td class="o_cell_td">
                <t t-set="cell" t-value="line.columns[0]"/>
                <t t-call="{{custom_templates.get('pdf_export_cell', 'account_reports.pdf_export_cell')}}"/>
            </td>
            <!-- second col after name -->
            <t t-if="line.level == 0">
                <td class="o_cell_td text-center" style="max-width: 100px; white-space: normal; justify-content: flex-center !important;">Original VAT rate</td>
            </t>
            <t t-elif="line.code == 'total'">
                <td class="o_cell_td" style="max-width: 100px; white-space: normal;"/>
            </t>
            <t t-else="">
                <td class="o_cell_td text-end" style="max-width: 100px; white-space: normal; justify-content: flex-end !important;">10 %</td>
            </t>

            <!-- third col after name -->
            <t t-if="line.level == 0">
                <td class="o_cell_td text-center" style="max-width: 100px; white-space: normal;">VAT rate after deduction</td>
            </t>
            <t t-elif="line.code == 'total'">
                <td class="o_cell_td" style="max-width: 100px; white-space: normal;"/>
            </t>
            <t t-else="">
                <td class="o_cell_td text-end" style="max-width: 100px; white-space: normal;">8 %</td>
            </t>

            <!-- last col -->
            <td class="o_cell_td">
                <t t-set="cell" t-value="line.columns[-1]"/>
                <t t-call="{{custom_templates.get('pdf_export_cell', 'account_reports.pdf_export_cell')}}"/>
            </td>
        </xpath>
    </template>

</odoo>
