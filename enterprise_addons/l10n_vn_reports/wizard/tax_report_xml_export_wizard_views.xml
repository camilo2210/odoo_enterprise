<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="form_01_gtgt_xml_export_wizard_view" model="ir.ui.view">
        <field name="name">l10n_vn_reports.form_01_gtgt.export.wizard.form</field>
        <field name="model">l10n_vn_reports.form_01_gtgt.export.wizard</field>
        <field name="arch" type="xml">
            <form string="01/GTGT Export Options">
                <sheet>
                    <group>
                        <group>
                            <field name="business_activity"/>
                            <field name="first_time"/>
                        </group>
                        <group>
                            <field name="adjustment_no"
                                   invisible="first_time"
                                   required="not first_time"/>
                        </group>
                    </group>
                    <group string="Dependent Unit"
                           invisible="business_activity not in ('infrastructure_housing', 'power_generation')">
                        <group>
                            <field name="dependent_unit_name"
                                   required="business_activity in ('infrastructure_housing', 'power_generation')"/>
                            <field name="dependent_unit_tax_code"
                                   required="business_activity in ('infrastructure_housing', 'power_generation')"/>
                        </group>
                        <group>
                            <field name="province_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   required="business_activity in ('infrastructure_housing', 'power_generation')"/>
                            <field name="district"/>
                            <field name="ward"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_export"
                            string="Export"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
