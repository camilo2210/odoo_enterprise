<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_eco_update_product_version_view_form" model="ir.ui.view">
        <field name="name">mrp.eco.update.product.version.view.form</field>
        <field name="model">mrp.eco.update.product.version</field>
        <field name="arch" type="xml">
            <form string="Update Versions">
                <field name="eco_id" invisible="1"/>
                <field name="product_tmpl_id" invisible="1"/>
                <field name="bom_id" invisible="1"/>
                <field name="used_in_product_tmpl_ids" invisible="1"/>
                <field name="used_in_bom_ids" invisible="1"/>
                <div class="d-flex flex-column gap-2">
                    <div class="text-muted">Which versions do you want to increase?</div>
                    <div class="d-flex align-items-center gap-2">
                        <field name="update_product_version" nolabel="1"/>
                        <field name="product_version_label" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not bom_id">
                        <field name="update_bom_version" nolabel="1"/>
                        <field name="bom_version_label" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not used_in_product_tmpl_ids">
                        <field name="update_used_in_product_versions" nolabel="1"/>
                        <field name="used_in_product_versions_label" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not used_in_bom_ids or not bom_id">
                        <field name="update_used_in_bom_versions" nolabel="1"/>
                        <field name="used_in_bom_versions_label" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                </div>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
