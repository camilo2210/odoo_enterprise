<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="planning.PlanningGanttView.Buttons" t-inherit="web_gantt.GanttView.Buttons">
        <xpath expr="." position="inside">
            <button t-if="this.model.metaData.canEdit and this.model.isManager"
                class="o_gantt_button_send_all btn btn-primary"
                title="Send schedule"
                data-hotkey="w"
                t-on-click="() => this.planningControllerActions.publish()"
            >
                Publish
            </button>
            <button t-if="this.uiService.isSmall and this.model.metaData.canCreate and this.model.metaData.rangeId === 'week'"
                class="o_gantt_button_copy_previous_week btn btn-link dropdown-item"
                title="Copy previous week"
                data-hotkey="c"
                t-on-click="() => this.planningControllerActions.copyPrevious()"
            >
                Copy previous week
            </button>
            <button t-if="this.uiService.isSmall and this.model.metaData.canCreate"
                class="o_gantt_button_auto_plan btn btn-link dropdown-item"
                title="Automatically plan open shifts and sales orders"
                data-hotkey="k"
                t-on-click="this.autoPlan.bind(this)"
            >
                Auto Plan
            </button>
            <button t-if="['week', 'month'].includes(this.model.metaData.rangeId) and !this.model.isManager"
                class="o_gantt_button_print btn btn-secondary"
                title="Print resource calendar"
                data-hotkey="p"
                t-on-click="() => this.planningControllerActions.print(this.props.groupBy)"
            >
                Print
            </button>

            <Dropdown t-if="!this.uiService.isSmall and this.model.metaData.canCreate">
                <button class="btn btn-secondary" data-hotkey="o">
                    Actions
                    <i class="oi ms-1" data-icon="arrow_drop_down"></i>
                </button>
                <t t-set-slot="content">
                    <DropdownItem t-if="this.model.metaData.rangeId === 'week'"
                        class="'o_gantt_button_copy_previous_week btn btn-link dropdown-item'"
                        onSelected="() => this.planningControllerActions.copyPrevious()"
                        attrs="{ 'data-hotkey': 'c', 'title': 'Copy previous week' }"
                    >
                        Copy previous week
                    </DropdownItem>
                    <DropdownItem
                        class="'o_gantt_button_auto_plan btn btn-link dropdown-item'"
                        onSelected="this.autoPlan.bind(this)"
                        attrs="{ 'data-hotkey': 'k', 'title': 'Automatically plan open shifts and sales orders' }"
                    >
                        Auto Plan
                    </DropdownItem>
                    <DropdownItem t-if="['week', 'month'].includes(this.model.metaData.rangeId) and this.model.isManager"
                        class="'o_gantt_button_print btn btn-link dropdown-item'"
                        onSelected="() => this.planningControllerActions.print(this.props.groupBy)"
                        attrs="{ 'data-hotkey': 'p', 'title': 'Print planning' }"
                    >
                        Print
                    </DropdownItem>
                </t>
            </Dropdown>

        </xpath>
    </t>

</templates>
