<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="planning.PlanningCalendarSidePanel" t-inherit="web.CalendarSidePanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_calendar_sidepanel_content')]" position="inside">
            <div t-if="this.props.model.isManager" class="o_planning_legend mt-4">
                <img src="/hr/static/src/img/icons/plain.svg" width="30px" class="me-1 ms-n1"/><span class="me-4">Published</span>
                <img src="/hr/static/src/img/icons/hatched.svg" width="30px" class="me-1"/><span>Draft</span><br/>
            </div>
        </xpath>
        <xpath expr="//DatePicker" position="replace">
            <DatePicker t-if="this.showDatePicker" t-props="this.datePickerProps"/>
        </xpath>
    </t>
</templates>
