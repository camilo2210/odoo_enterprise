<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="planning.PlanningCalendarCommonPopover.DefaultFooterButtons" t-inherit="web.CalendarCommonPopover.DefaultFooterButtons" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='this.isEventEditable or this.isEventViewable']" position="after">
            <button t-if="this.canUnschedule" class="btn btn-sm btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.onUnschedule())">
                Unschedule
            </button>
        </xpath>
        <!-- Style the delete button like every other planning.slot popover's. -->
        <xpath expr="//a[hasclass('o_cw_popover_delete')]" position="replace">
            <a href="#"
                class="btn ms-auto btn-delete o_cw_popover_delete"
                t-att-class="{
                    'btn-danger': this.footer.isMobile,
                    'btn-outline-danger': !this.footer.isMobile,
                }"
                title="Delete"
                t-on-click="this.onDeleteEvent"
            >
                <i class="oi" data-icon="delete"/>
            </a>
        </xpath>
    </t>
</templates>
