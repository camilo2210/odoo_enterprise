<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AvatarCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_avatar_card_details')]" position="inside">
            <div t-if="this.roleTags.length > 0" class="o_resource_roles_tags">
                <span class="fw-bold">Roles</span>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <TagsList tags="this.roleTags" tagLimit="5" t-slot-scope="tag">
                        <BadgeTag color="tag.color" tooltip="tag.text">
                            <t t-if="tag.hasIcon">
                                <i class="oi oi-filled p-1 o_planning_avatar_role_tag" data-icon="star"/>
                            </t>
                            <div class="o_tag_badge_text" t-out="tag.text"/>
                        </BadgeTag>
                    </TagsList>
                </div>
            </div>
        </xpath>
    </t>
</templates>
