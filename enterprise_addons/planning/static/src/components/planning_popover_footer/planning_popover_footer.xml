<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="planning.PlanningPopoverFooterButtons.Common">
        <button t-if="this.props.onUnschedule" class="btn btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.props.onUnschedule())">
            Unschedule
        </button>
        <button t-if="this.props.onDelete"
                class="btn ms-auto btn-delete"
                t-att-class="{
                    'btn-danger': this.footer.isMobile,
                    'btn-outline-danger': !this.footer.isMobile,
                }"
                title="Delete"
                t-on-click="() => this.footer.onFooterBtnClicked(() => this.props.onDelete())"
        >
            <i class="oi" data-icon="delete"/>
        </button>
    </t>
</templates>
