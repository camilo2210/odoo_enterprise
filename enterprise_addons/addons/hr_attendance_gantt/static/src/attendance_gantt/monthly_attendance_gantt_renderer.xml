<?xml version="1.1" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance_gantt.MonthlyAttendanceGanttRenderer" t-inherit="web_gantt.GanttRenderer" t-inherit-mode="primary">
        <xpath expr="//GanttRendererControls" position="after">
            <div class="o_attendance_calendar flex-grow-0">
                <AttendanceCalendarOverview dateRange="this.dateRange"/>
            </div>
        </xpath>
    </t>
</templates>
