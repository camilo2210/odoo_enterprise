<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="import_to_spreadsheet_action" model="ir.actions.act_window">
        <field name="name">File preview</field>
        <field name="res_model">documents.import.to.spreadsheet</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>

    <record id="documents_import_to_spreadsheet_view_form" model="ir.ui.view">
        <field name="name">documents.import.to.spreadsheet.view.form</field>
        <field name="model">documents.import.to.spreadsheet</field>
        <field name="arch" type="xml">
            <form>
                <p>This file type can't be opened directly in Odoo. Convert it to an Odoo Spreadsheet to view or edit it.</p>
                <group>
                    <group>
                        <field name="csv_separator_type" invisible="not is_csv"/>
                    </group>
                    <group>
                        <field
                            nolabel="1"
                            name="csv_separator"
                            required="csv_separator_type == 'custom'"
                            invisible="csv_separator_type != 'custom'"
                            placeholder="e.g. ; or |"
                        />
                    </group>
                </group>
                <group class="text-nowrap">
                    <field name="archive_document"/>
                </group>
                <footer>
                    <button
                        string="Open with Odoo Spreadsheet"
                        class="btn-primary"
                        name="import_to_spreadsheet"
                        type="object"
                        data-hotkey="q"
                    />
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
