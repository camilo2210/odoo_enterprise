<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="esg.carbonEmissionGraphView" t-inherit="web.GraphView" t-inherit-mode="primary">
        <ActionHelper position="replace">
            <t t-if="!this.model.hasData() or this.model.useSampleModel and this.props.info.noContentHelp">
                <t t-call="esg.noContentHelper" reportName="this.title" accountantInstalled="this.accountantInstalled"/>
            </t>
        </ActionHelper>
    </t>
</odoo>
