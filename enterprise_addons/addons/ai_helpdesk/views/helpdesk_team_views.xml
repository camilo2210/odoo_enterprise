<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <h2>AI</h2>
                <div class="o_settings_container">
                    <setting>
                        <field name="use_ai" string="Look for Similar Tickets"/>
                        <div invisible="not use_ai" class="mt16">
                            <group>
                                <field name="ticket_similarity_time_range" help="Controls how far in the past should the search for similar tickets go."/>
                                <field name="ai_agent_id" help="Agent that will be used when interacting with tickets of this team."/>
                                <field name="ticket_similarity_threshold"/>
                            </group>
                        </div>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
