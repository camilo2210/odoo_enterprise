<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="crm_enterprise.CrmBusinessCardScanner">
        <FileUploader
            multiUpload="true"
            onUploaded.bind="this.onFileUploaded"
            onUploadComplete.bind="this.onUploadComplete">
            <t t-set-slot="toggler">
                <i class="oi me-1" data-icon="photo_camera"/>
                <span t-if="this.isMobileOS">Scan Business Cards</span>
                <span t-else="">Import Business Cards</span>
            </t>
            <t t-call-slot="default"/>
        </FileUploader>
    </t>
</templates>
