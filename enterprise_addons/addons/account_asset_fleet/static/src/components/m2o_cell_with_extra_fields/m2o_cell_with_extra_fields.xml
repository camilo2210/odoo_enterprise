<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="account.M2OCellWithExtraFields" t-inherit-mode="extension">
        <xpath expr="//div[@id='extra_fields']" position="inside">
            <div t-if="!this.extraVehicleProps.invisible" t-att-class="{'o_cell_wrapper': this.extraVehicleProps.required}">
                <Many2One t-props="this.extraVehicleProps.props" />
            </div>
        </xpath>
    </t>
</templates>
