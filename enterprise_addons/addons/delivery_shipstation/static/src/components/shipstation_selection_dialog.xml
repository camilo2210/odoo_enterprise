<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="delivery_shipstation.ServiceCard">
        <label class="card h-100 border cursor-pointer user-select-none"
            t-att-class="this.state.selectedService === service ? 'border-primary' : ''">
            <div class="card-body p-3 d-flex align-items-start gap-2">
                <input class="form-check-input mt-1 flex-shrink-0" type="radio"
                    name="service_selection"
                    t-att-value="service.service_code"
                    t-att-checked="this.state.selectedService === service"
                    t-on-change="() => this.selectService(service)"/>
                <div class="d-flex flex-column gap-1 overflow-hidden">
                    <div class="fw-bold text-break" t-out="service.name"/>
                    <div class="d-flex flex-wrap gap-1">
                        <span t-if="service.domestic" class="o_tag badge rounded-pill o_tag_color_7">DOM</span>
                        <span t-if="service.international" class="o_tag badge rounded-pill o_tag_color_0">INTL</span>
                        <span t-if="service.is_multi_package_supported" class="o_tag badge rounded-pill o_tag_color_2">Multi-Package</span>
                        <span t-if="service.is_return_supported" class="o_tag badge rounded-pill o_tag_color_4">Returns</span>
                    </div>
                </div>
            </div>
        </label>
    </t>

    <t t-name="delivery_shipstation.CarrierSelector.DesktopLayout">
        <div class="d-flex" style="height: 50vh;">
            <div class="border-end overflow-auto" style="flex: 0 0 240px;">
                <div class="p-2 text-uppercase text-muted small fw-bold border-bottom">Carriers</div>
                <t t-foreach="this.state.carriers" t-as="carrier" t-key="carrier.carrier_id">
                    <div class="px-3 py-2 cursor-pointer border-bottom"
                        t-att-class="this.state.selectedCarrier === carrier ? 'fw-semibold' : ''"
                        t-on-click="() => this.selectCarrier(carrier)">
                        <div class="d-flex justify-content-between align-items-center">
                            <span t-out="carrier.friendly_name"/>
                            <i t-if="this.state.selectedCarrier === carrier" class="oi text-primary" data-icon="check"/>
                        </div>
                        <div class="small text-muted" t-out="carrier.carrier_code"/>
                    </div>
                </t>
            </div>
            <div class="flex-grow-1 overflow-auto p-3">
                <t t-if="!this.state.selectedCarrier">
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                        Select a carrier to view services
                    </div>
                </t>
                <t t-else="">
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                        <t t-foreach="this.services" t-as="service" t-key="service.service_code">
                            <div class="col">
                                <t t-call="delivery_shipstation.ServiceCard"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="delivery_shipstation.CarrierSelector.MobileLayout">
        <!-- Step 1: Carrier list -->
        <t t-if="this.state.step === 1">
            <div class="list-group list-group-flush">
                <t t-foreach="this.state.carriers" t-as="carrier" t-key="carrier.carrier_id">
                    <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                        t-on-click="() => this.selectCarrier(carrier)">
                        <div>
                            <div class="fw-semibold" t-out="carrier.friendly_name"/>
                            <div class="small text-muted" t-out="carrier.carrier_code"/>
                        </div>
                        <i class="oi text-muted" data-icon="chevron_forward"/>
                    </button>
                </t>
            </div>
        </t>
        <!-- Step 2: Service list -->
        <t t-elif="this.state.step === 2">
            <div class="list-group list-group-flush">
                <t t-foreach="this.services" t-as="service" t-key="service.service_code">
                    <label class="list-group-item d-flex gap-3 align-items-start">
                        <input class="form-check-input mt-1 flex-shrink-0" type="radio"
                            name="service_selection"
                            t-att-value="service.service_code"
                            t-att-checked="this.state.selectedService === service"
                            t-on-change="() => this.selectService(service)"/>
                        <div class="d-flex flex-column gap-1">
                            <div class="fw-semibold" t-out="service.name"/>
                            <div class="d-flex flex-wrap gap-1">
                                <span t-if="service.domestic" class="o_tag badge rounded-pill o_tag_color_7">DOM</span>
                                <span t-if="service.international" class="o_tag badge rounded-pill o_tag_color_0">INTL</span>
                                <span t-if="service.is_multi_package_supported" class="o_tag badge rounded-pill o_tag_color_2">Multi-Package</span>
                                <span t-if="service.is_return_supported" class="o_tag badge rounded-pill o_tag_color_4">Returns</span>
                            </div>
                        </div>
                    </label>
                </t>
            </div>
        </t>
    </t>

    <t t-name="delivery_shipstation.CarrierSelector">
        <Dialog title="this.dialogTitle" size="'xl'" withBodyPadding="false">
            <t t-set-slot="header">
                <button t-if="this.isSmall and this.state.step === 2"
                        class="btn btn-link p-0 me-3" t-on-click="this.goBack">
                    <i class="oi fs-4" data-icon="west"/>
                </button>
                <h4 class="modal-title flex-grow-1" t-out="this.dialogTitle"/>
                <button t-if="!this.isSmall or this.state.step === 1"
                        class="btn-close" t-on-click="this.close"/>
            </t>

            <t t-if="this.isSmall" t-call="delivery_shipstation.CarrierSelector.MobileLayout"/>
            <t t-else="" t-call="delivery_shipstation.CarrierSelector.DesktopLayout"/>

            <t t-set-slot="footer">
                <button class="btn btn-secondary me-auto" t-on-click="this.close">Discard</button>
                <t t-if="!this.isSmall || this.state.step === 2">
                    <button class="btn btn-primary" t-att-disabled="!this.canSave" t-on-click="this.save">
                        Save
                    </button>
                </t>
            </t>
        </Dialog>
    </t>
</templates>
