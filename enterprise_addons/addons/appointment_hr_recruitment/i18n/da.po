#. module: appointment_hr_recruitment
#: model:ir.module.module,description:base.module_appointment_hr_recruitment
msgid ""
"\n"
"Keeps track of all appointments related to applicants.\n"
msgstr ""

#. module: appointment_hr_recruitment
#: model:mail.template,body_html:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>Hello,</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        Thanks for your application and interest in <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t>.<br/>\n"
"        <br/>\n"
"        I would like to organize a phone interview with you, it should last "
"about 30 min.\n"
"        We'll go through your resume and motivations to join the <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t> team.\n"
"        You can book a slot in our agenda by cliking on the button below.<br/"
">\n"
"    </div>\n"
"    <br/>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">Schedule my interview</a><br/>\n"
"    <br/>\n"
"    Best regards,\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>Hej</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        Tak for din ansøgning og din interesse i <t t-"
"out=\"object.company_id.name or ''\">DinVirksomhed</t>.<br/>\n"
"        <br/>\n"
"        Jeg vil gerne arrangere en telefonisk jobsamtale med dig, som varer "
"cirka 30 minutter.\n"
"        Her vil vi gennemgå dit CV samt din motivation for at blive en del "
"af teamet hos <t t-out=\"object.company_id.name or ''\">DinVirksomhed</t>.\n"
"        Du kan booke en tid i vores kalender ved at klikke på knappen "
"herunder.<br/>\n"
"    </div>\n"
"    <br/>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: {"
"{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">Planlæg min jobsamtale</a><br/>\n"
"    <br/>\n"
"    Med venlig hilsen\n"
"</div>\n"
"        "

