<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="calendar_event_interview_1" model="calendar.event">
        <field name="appointment_booker_id" model="hr.applicant" eval="obj(ref('hr_recruitment.hr_case_dev1')).partner_id.id"/>
        <field name="appointment_status">booked</field>
        <field name="applicant_id" ref="hr_recruitment.hr_case_dev1"/>
        <field name="appointment_type_id" ref="appointment_type_interviews"/>
        <field name="duration" eval="1.5"/>
        <field name="name">Interview with Kelly Wallant</field>
        <field name="partner_ids" model="hr.applicant" eval="[(6, 0, [obj(ref('hr_recruitment.hr_case_dev1')).partner_id.id, ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 15:30:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 17:00:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

    <record id="calendar_event_interview_2" model="calendar.event">
        <field name="appointment_booker_id" model="hr.applicant" eval="obj(ref('hr_recruitment.hr_case_financejob1')).partner_id.id"/>
        <field name="appointment_status">booked</field>
        <field name="applicant_id" ref="hr_recruitment.hr_case_financejob1"/>
        <field name="appointment_type_id" ref="appointment_type_interviews"/>
        <field name="duration" eval="0.5"/>
        <field name="name">Joren Jacob - Discuss job opportunity</field>
        <field name="partner_ids" model="hr.applicant" eval="[(6, 0, [obj(ref('hr_recruitment.hr_case_financejob1')).partner_id.id, ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 13:15:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 13:45:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

</odoo>
