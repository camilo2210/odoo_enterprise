<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.extract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="account_ocr_settings_moves" position="after">
                <div id="account_ocr_settings_moves_credits">
                    <setting invisible="not module_account_extract">
                        <widget name="iap_buy_more_credits" service_name="invoice_ocr"/>
                    </setting>
                </div>
            </div>
        </field>
    </record>
</odoo>
