<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="knowledge.WysiwygArticleHelper" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_knowledge_load_template')]" position="after">
            <button class="o_knowledge_generate_article d-flex btn btn-secondary align-items-center text-nowrap" data-hotkey="G" t-on-click="this.onGenerateArticleClick">
                <span class="oi-fw o_ai_icon_color me-2" data-icon="o_ai_icon"/> Write with AI
            </button>
        </xpath>
    </t>
</templates>
