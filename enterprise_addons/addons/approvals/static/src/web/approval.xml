<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="approvals.Approval">
        <div t-if="this.activity().approver_id.status === 'pending' and this.isApprover()">
            <button class="btn btn-success btn-link ps-0 pt-0" t-on-click="this.onClickApprove">
                <i class="oi" data-icon="check"/> Approve
            </button>
            <button class="btn btn-danger btn-link pt-0" t-on-click="this.onClickRefuse">
                <i class="oi" data-icon="close"/> Refuse
            </button>
        </div>
    </t>

</templates>
