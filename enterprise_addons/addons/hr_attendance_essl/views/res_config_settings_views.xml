<odoo>
    <record id="res_config_settings_view_form_inherit_essl" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.essl</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="eSSL Webhook">
                    <setting string="Webhook URL" help="Use this URL for the eSSL device or middleware integration.">
                        <field name="essl_webhook_url" widget="CopyClipboardChar" class="w-100"/>
                        <button name="action_regenerate_essl_webhook_token" type="object" string="Generate New Token" class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

