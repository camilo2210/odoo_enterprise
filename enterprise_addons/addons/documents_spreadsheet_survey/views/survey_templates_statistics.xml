<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="survey_page_statistics_header_spreadsheet" inherit_id="survey.survey_page_statistics_header">
        <xpath expr="//div[hasclass('btn-group')]" position="before">
            <form id="survey_spreadsheet_form" class="d-none" t-attf-action="/survey/{{survey.id}}/analyze-results" method="POST">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            </form>
        </xpath>
        <xpath expr="//button[hasclass('o_survey_results_print')]" position="before">
            <button type="submit" form="survey_spreadsheet_form" class="btn btn-light" aria-label="Open in Spreadsheet" title="Open in Spreadsheet">
                <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" class="o_ui_app_icon" aria-hidden="true">
                    <path fill="var(--body-color)" d="M19 19L46 19L46 42C46 44.2091 44.2091 46 42 46L19 46L19 19Z" class="opacity-50"/>
                    <path fill="var(--body-color)" d="M17 17L4 17L4 8C4 5.79086 5.79086 4 8 4L17 4L17 17Z" class="opacity-50"/>
                    <rect fill="var(--body-color)" x="4" y="19" width="13" height="27"/>
                    <rect fill="var(--body-color)" x="19" y="4" width="27" height="13"/>
                </svg>
            </button>
        </xpath>
    </template>
</data>
</odoo>
