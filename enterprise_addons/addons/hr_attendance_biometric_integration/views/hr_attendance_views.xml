<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_inherit_biometric" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.biometric</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <group name="group_employee" position="after">
                <group string="Biometric" invisible="not biometric_check_in_event_id and not biometric_check_out_event_id">
                    <field name="biometric_check_in_event_id" readonly="1"/>
                    <field name="biometric_check_out_event_id" readonly="1"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
