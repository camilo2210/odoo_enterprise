<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="delivery_fedex_certified_inherit_product_template_form_view_procurement_button" model="ir.ui.view">
        <field name="name">delivery_fedex_certified.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <group name="group_lots_and_weight" position="inside">
                <field name="manufacturer_product_id" invisible="product_variant_count != 1"/>
            </group>
        </field>
    </record>

    <record id="delivery_fedex_certified_product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.inherit.delivery</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <group name="group_lots_and_weight" position="inside">
                <field name="manufacturer_product_id"/>
            </group>
        </field>
    </record>
</odoo>
