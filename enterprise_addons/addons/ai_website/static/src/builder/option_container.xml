<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.OptionsContainer" t-inherit="html_builder.OptionsContainer" t-inherit-mode="extension">
    <xpath expr="//span[@t-out='this.title']" position="after">
        <span
            t-if="this.props.editingElement.matches('[data-contains-ai-content]')"
            class="ms-1 fw-bold o_ai_content_badge"
            style="font-size: 0.7em;"
            data-tooltip="Customized by AI. Standard builder options may be limited or behave differently."
        >AI</span>
    </xpath>
</t>

</templates>
