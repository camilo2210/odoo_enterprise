<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Add AI button to the builder top actions bar -->
<t t-name="website.WebsiteBuilder" t-inherit="website.WebsiteBuilder" t-inherit-mode="extension">
    <xpath expr="//t[@t-set-slot='extraActions']/div[hasclass('o-website-discard-save-buttons')]" position="before">
        <span t-if="!this.isTranslationMode" t-att-title="this.aiAssistantTooltip">
            <button
                t-on-click="this.onAiChatClick" type="button"
                class="o-hb-btn btn d-flex align-items-center justify-content-center"
                t-att-disabled="!this.isPageAiEditable || !this.websiteService.isDesigner"
                data-action="ai-chat"
                style="--btn-font-size: 14px; padding: 2px 6px;">
                <img src="/ai/static/description/icon.png" alt="AI" style="width: 20px; height: 20px; object-fit: contain;"/>
            </button>
        </span>
    </xpath>
</t>

</templates>
