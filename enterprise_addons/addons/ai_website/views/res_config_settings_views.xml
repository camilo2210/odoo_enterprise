<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_info_settings" position="inside">
                <setting id="ai_website_scripts"
                    string="AI JavaScript"
                    help="Always let the AI website builder add JavaScript to your pages. When off, it asks before adding any scripts.">
                    <field name="ai_allow_scripts"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
