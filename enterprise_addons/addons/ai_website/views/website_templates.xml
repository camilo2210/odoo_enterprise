<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <!-- We need it to be ready before ai-gen scripts run. -->
            <t t-call-assets="ai_website.ai_assets" t-css="false"/>
            <!-- Recording what a script changes is only worth anything to
                 someone who can open the builder and revert it, so visitors
                 are not served it at all. -->
            <t groups="website.group_website_restricted_editor"
               t-call-assets="ai_website.ai_editor_assets" t-css="false"/>
        </xpath>
    </template>
</odoo>
