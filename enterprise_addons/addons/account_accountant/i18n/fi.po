msgstr "Voit täsmäyttää kirjauksia enintään kahden eri tilin kanssa: %s"

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid ""
"You cannot change the account for a deferred line in %(move_name)s if it has "
"already been deferred."
msgstr ""
"Siirtorivin tiliä ei voi muuttaa kohdassa %(move_name)s, jos se on jo "
"jaksotettu."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid "You cannot create a deferred entry with a start date but no end date."
msgstr ""
"Et voi luoda siirtokirjausta aloituspäivällä, mutta ilman päättymispäivää."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid ""
"You cannot create a deferred entry with a start date later than the end date."
msgstr ""
"Et voi luoda siirtokirjausta, jonka aloituspäivä on päättymispäivän jälkeen."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_bank_statement.py:0
msgid "You cannot delete a statement that was posted on a hashed cash journal"
msgstr ""
"Et voi poistaa tiliotetta, joka on kirjattu hajautettuun kassapäiväkirjaan"

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_fiscal_year.py:0
msgid "You cannot have a fiscal year on a child company."
msgstr "Tytäryhtiöllä ei voi olla tilikautta."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid ""
"You cannot reset to draft an invoice that is grouped in deferral entry. You "
"can create a credit note instead."
msgstr ""
"Et voi palauttaa luonnokseksi laskua, joka on ryhmitelty siirtokirjaukseen. "
"Voit luoda hyvityslaskun sen sijaan."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/wizard/account_change_lock_date.py:0
msgid "You cannot set a Lock Date in the future."
msgstr "Et voi määrittää lukituspäivää tulevaisuuteen."

#. module: account_accountant
#. odoo-javascript
#: code:addons/account_accountant/static/src/components/bank_reconciliation/button_list/button_list.js:0
msgid ""
"You have successfully reconciled 3 transactions with %s, what about automate "
"this reconciliation ?"
msgstr ""
"Olet täsmäyttänyt onnistuneesti 3 tapahtumaa %s kanssa. Haluatko "
"automatisoida tämän täsmäytyksen?"

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid "You might want to %(btn_start)sfully reconcile%(btn_end)s the document."
msgstr "Haluat ehkä %(btn_start)stäsmäyttää kokonaan%(btn_end)s asiakirjan."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid ""
"You might want to make a %(btn_start)spartial reconciliation%(btn_end)s "
"instead."
msgstr ""
"Haluat ehkä tehdä %(btn_start)sosittaisen täsmäytyksen%(btn_end)s sen sijaan."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid "You might want to record a %(btn_start)spartial payment%(btn_end)s."
msgstr "Haluat ehkä kirjata %(btn_start)sosittaisen maksun%(btn_end)s."

#. module: account_accountant
#. odoo-python
#: code:addons/account_accountant/models/account_move.py:0
msgid ""
"You might want to set the invoice as %(btn_start)sfully paid%(btn_end)s."
msgstr ""
"Haluat ehkä määrittää laskun %(btn_start)stäysin maksetuksi%(btn_end)s."

#. module: account_accountant
