<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="account_accountant.BankRecControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="inside">
            <div t-if="this.selectedStatementLines.length and !this.ui.isSmall and (this.extraButtonToDisplay.length or this.buttonsToDisplay.length)" class="d-flex w-100 gap-1">
                <t t-foreach="this.buttonsToDisplay" t-as="button" t-key="button_index">
                    <BankRecButton t-props="button"/>
                </t>
                <Dropdown t-if="this.extraButtonToDisplay.length">
                    <button class="btn btn-secondary">
                        <i class="oi" data-icon="more_vert"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.reconcileModelsToDisplay" t-as="model" t-key="model.id">
                            <DropdownItem class="'btn btn-link'" onSelected.bind="() => this.triggerReconciliationModel(model.id)">
                                <t t-out="model.display_name"/>
                            </DropdownItem>
                        </t>
                        <t t-foreach="this.extraButtonToDisplay" t-as="button" t-key="button_index">
                            <DropdownItem class="'btn btn-link'" onSelected.bind="button.action">
                                <t t-out="button.label"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</templates>
