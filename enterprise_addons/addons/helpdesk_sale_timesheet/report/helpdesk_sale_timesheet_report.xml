<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the sale timesheet report template for Helpdesk Sale Timesheet -->
    <template id="report_timesheet" inherit_id="sale_timesheet.timesheet_sale_page">
        <xpath expr="//t[@t-if='doc.timesheet_ids']" position="before">
            <t t-set="show_ticket" t-value="any(doc.timesheet_ids.helpdesk_ticket_id)"/>
        </xpath>
    </template>
</odoo>
