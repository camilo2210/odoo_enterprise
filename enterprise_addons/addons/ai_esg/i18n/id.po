#. module: ai_esg
#: model:mail.template,body_html:ai_esg.mail_template_data_ai_esg_assign_emission_factors_failure
msgid ""
"<div>\n"
"                    <p>The request to assign emission factors to your "
"emission lines using AI has been completed. Note that some emissions could "
"not get assigned due to unexpected errors.</p>\n"
"                    <p>You can review the emissions assigned in your ESG app."
"</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Permintaan untuk menetapkan faktor emisi ke garis "
"emisi Anda menggunakan AI telah selesai. Perhatikan bahwa beberapa emisi "
"tidak dapat ditetapkan karena kesalahan tak terduga.</p>\n"
"                    <p>Anda dapat meninjau emisi yang telah ditetapkan di "
"aplikasi ESG.</p>\n"
"                </div>\n"
"            "

#. module: ai_esg
#: model:mail.template,body_html:ai_esg.mail_template_data_ai_esg_assign_emission_factors_success
#, fuzzy
msgid ""
"<div>\n"
"                    <p>The request to assign emission factors to your "
"emission lines using AI has been successfully completed.</p>\n"
"                    <p>You can review the emissions assigned in your ESG app."
"</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Permintaan untuk menetapkan faktor emisi ke baris "
"emisi Anda menggunakan AI berhasil diselesaikan.</p>\n"
"                    <p>Anda dapat meninjau emisi yang ditetapkan di aplikasi "
"ESG.</p>\n"
"                </div>\n"
"            "

