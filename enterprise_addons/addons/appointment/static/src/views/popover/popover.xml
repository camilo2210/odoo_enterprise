<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="appointment.AppointmentCalendarEventPopover">
        <div class="o_appointment_calendar_event_popover">
            <t t-set="data" t-value="this.props.data"/>
            <div class="popover-header d-flex justify-content-between pe-2"
                t-attf-class="o_appointment_calendar_event_popover_header_color_{{ this.getAppointmentStatusColorIndex(data) }}">
                <h4 t-out="data.display_name" class="pt-1 text-black"/>
                <span class="ms-4 mt-1 me-2 cursor-pointer" t-on-click="this.props.close">
                    <i class="oi oi-filled" data-icon="close"/>
                </span>
            </div>
            <div class="popover-body p-3 pb-0">
                <div class="p-0 m-0 d-flex flex-column gap-1">
                    <div t-if="data.appointment_type_manage_capacity and data.total_capacity_reserved > 1" class="d-flex align-items-baseline">
                        <i class="oi oi-filled text-muted me-3" data-icon="group" title="Guests"/>
                        <span>
                            <t t-out="data.total_capacity_reserved"/> guests
                        </span>
                    </div>
                    <div t-if="data.total_capacity_unassigned" class="d-flex align-items-baseline text-warning">
                        <i class="oi oi-filled text-muted me-3" data-icon="warning" title="Missing Seats"/>
                        <span>
                            <t t-out="data.total_capacity_unassigned"/> missing seats
                        </span>
                    </div>
                    <div class="d-flex align-items-baseline">
                        <i class="oi oi-filled text-muted me-3" data-icon="schedule" title="Start"/>
                        <t t-out="this.formattedTime"/>
                    </div>
                    <div t-if="data.location" class="d-flex align-items-baseline">
                        <i class="oi oi-filled text-muted me-3" data-icon="location_on" title="Location"/>
                        <t t-out="data.location"/>
                    </div>
                    <div t-if="data.videocall_location"
                         class="d-flex align-items-baseline o_appointment_calendar_event_popover_videocall_location_field">
                        <i class="oi oi-filled text-muted me-3" data-icon="videocam" title="Video Call URL"/>
                        <span t-out="data.videocall_location" class="text-truncate"/>
                        <CopyButton content="data.videocall_location"
                            className="'p-0'"
                            successText.translate="Copied!"/>
                    </div>
                    <div t-if="!this.isHtmlEmpty(data.description)" class="d-flex align-items-baseline">
                        <i class="oi oi-filled text-muted me-3" data-icon="sticky_note_2" title="Description"/>
                        <div t-out="data.description" class="o_appointment_calendar_event_popover_html_field"/>
                    </div>
                </div>
            </div>
            <div class="popover-footer">
                <div class="p-3 d-flex">
                    <button t-on-click="this.onClickEdit" class="btn btn-sm btn-primary me-1 o_appointment_calendar_popover_edit">Edit</button>
                    <div t-if="data.appointment_type_id" class="d-flex gap-1 ms-auto me-1 o_appointment_status_btns_container">
                        <button class="btn btn-sm o_appointment_calendar_popover_status_btn"
                            t-attf-class="{{ this.getButtonClass('booked') }}"
                            t-on-click="() => this.onClickAppointmentStatus('booked')">
                            Booked
                        </button>
                        <button class="btn btn-sm o_appointment_calendar_popover_status_btn"
                            t-attf-class="{{ this.getButtonClass('attended') }}"
                            t-on-click="() => this.onClickAppointmentStatus('attended')">
                            Check In
                        </button>
                        <button class="btn btn-sm o_appointment_calendar_popover_status_btn"
                            t-attf-class="{{ this.getButtonClass('no_show') }}"
                            t-on-click="() => this.onClickAppointmentStatus('no_show')">
                            No Show
                        </button>
                    </div>
                    <button t-on-click="this.onClickDelete" class="btn btn-secondary ms-auto o_appointment_calendar_popover_delete">
                        <i class="oi oi-filled" data-icon="delete"/>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
