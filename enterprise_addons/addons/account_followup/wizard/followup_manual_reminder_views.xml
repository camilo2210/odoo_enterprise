<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="manual_reminder_view_form" model="ir.ui.view">
        <field name="name">account.followup.manual_reminder.view.form</field>
        <field name="model">account_followup.manual_reminder</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    Preview, the content will be adapted per client
                </div>
                <!-- Warnings -->
                <div class="m-0" id="alerts" invisible="not alerts">
                    <field name="alerts" class="o_field_html" widget="actionable_errors"/>
                </div>
                <div name="email_header">
                    <strong class="text-muted">To: </strong>
                    <field name="preview_subject" readonly="1"/>
                </div>
                <div name="email_content">
                    <field name="preview_body" readonly="1"/>
                </div>
                <footer>
                    <button string="Send" name="send_reminder" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    <label for="template_id" string="Email Template"/>
                    <field name="template_id" domain="[('model', '=', 'res.partner')]"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
