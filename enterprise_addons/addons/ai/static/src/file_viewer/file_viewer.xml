<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ai.AIFileViewer" t-inherit="web.FileViewer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-FileViewer-download')]/preceding-sibling::div[hasclass('flex-grow-1')][1]" position="after">
            <t t-call="ai.AIFileButton"/>
        </xpath>
    </t>
    <t t-name="ai.AIFileButton">
        <div class="o-FileViewer-headerButton d-flex align-items-center px-3 mx-1">
            <button
                class="cursor-pointer border-0 bg-transparent p-0"
                data-hotkey="c"
                t-on-click="this.openAIChat"
                title="Ask AI"
            >
                <img src="/ai/static/description/icon.png" style="height: 22px;" alt="AI"/>
            </button>
        </div>
    </t>
</templates>
