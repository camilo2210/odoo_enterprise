<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai.AgentToolSummary">
    <div class="ms-3" t-att-class="{'ms-4': this.env.inChatWindow}">
        <t t-if="this.store.debugMode.isActive() and this.toolCallId">
            <button class="btn btn-link d-flex align-items-center text-muted py-0 ps-0 pe-3 fw-normal" t-on-click="this.onClickMessage">
                <t t-out="this.props.message.richBody"/><i class="oi oi-fw ms-1 flex-shrink-0" t-att-class="this.isUnfolded() ? 'mt-1' : 'o-mt-0_5'" t-attf-data-icon="{{this.isUnfolded() ? 'expand_more' : 'chevron_right'}}"/>
            </button>
            <div class="o-ai-AgentToolSummary-params o-ms-4_5 me-3 overflow-auto text-nowrap" t-if="this.isUnfolded() and this.toolParams">
                <table class="table table-sm table-borderless w-auto mb-0">
                    <tbody>
                        <tr t-foreach="this.toolParams" t-as="param" t-key="param">
                            <th scope="row" class="fw-medium text-muted ps-0 pe-1 py-1"><t t-out="param"/>:</th>
                            <td class="py-1"><code t-out="this.stringify(param_value)"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
        <span t-else="" class="text-muted" t-out="this.props.message.richBody"/>
    </div>
</t>
</templates>
