<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="attachment_ai_agent_source_1" model="ir.attachment">
        <field name="name">Odoo Enterprise Agreement.pdf</field>
        <field name="raw" type="bytes" file="ai/static/demo/odoo_enterprise_agreement.pdf"/>
        <field name="mimetype">application/pdf;base64</field>
        <field name="res_model">ai.agent</field>
    </record>

    <record id="ai_agent_1" model="ai.agent">
        <field name="name">Odoo Compliance Assistant</field>
        <field name="subtitle">I help you with any legal issue related to Odoo.</field>
        <field name="sequence">4</field>
        <field name="image_128" type="bytes" file="ai/static/avatars/Avatar1-Teal.png"/>
        <field name="system_prompt">You are the Odoo Compliance Assistant.
- Be concise and professional.
- Always cite the Section/Clause Number from the document.
- If the answer is not in the document, state that clearly.
- All information is for demonstration, not legal advice.
        </field>
        <field name="restrict_to_sources">True</field>
        <field name="create_uid" ref="base.user_admin"/>
    </record>

    <record  id="ai_agent_source_1" model="ai.agent.source">
        <field name="name">Odoo Enterprise Agreement</field>
        <field name="attachment_id" ref="attachment_ai_agent_source_1"/>
        <field name="type">binary</field>
        <field name="agent_id" ref="ai_agent_1"/>
    </record>
</odoo>
