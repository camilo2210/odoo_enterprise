<?xml version="1.0"?>
<odoo>
    <data>
        <record id="ir_cron_generate_embedding" model="ir.cron">
            <field name="name">AI Embedding: Generate Embeddings</field>
            <field name="model_id" ref="ai.model_ai_embedding"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_embedding()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">9999</field>
            <field name="interval_type">months</field>
        </record>
        <record id="ir_cron_run_web_scraper" model="ir.cron">
            <field name="name">AI Web Scraper: Run Batches</field>
            <field name="model_id" ref="ai.model_ai_web_scraper_batch"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_web_scraper()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_embed_records" model="ir.cron">
            <field name="name">AI Embedding: Create records embedding</field>
            <field name="model_id" ref="ai.model_ai_embedding_mixin"/>
            <field name="state">code</field>
            <field name="code">model._cron_embed_records()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_update_deprecated_embedding_models" model="ir.cron">
            <field name="name">AI Embedding: Update deprecated embedding models</field>
            <field name="model_id" ref="ai.model_ai_embedding"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_deprecated_embedding_models()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
