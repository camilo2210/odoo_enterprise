<odoo>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.view.form.inherit.hr.attendance.zkteco</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <group name="check_out_group" position="after">
                <separator string="ZKTeco" invisible="not zkteco_checkin_transaction_id and not zkteco_checkout_transaction_id and not terminal_id"/>
                <group>
                    <field name="terminal_id" readonly="1" invisible="not terminal_id" help="The Biotime terminal in which the record is created from"/>
                    <field name="zkteco_checkin_transaction_id" string="Check In" readonly="1" invisible="not zkteco_checkin_transaction_id"/>
                    <field name="zkteco_checkout_transaction_id" string="Check Out" readonly="1" invisible="not zkteco_checkout_transaction_id"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
