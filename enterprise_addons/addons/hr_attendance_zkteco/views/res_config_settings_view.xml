<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.zkteco</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="hr_attendance" position="inside">
                <block title="ZKTeco BioTime" id="zkteco_biotime">
                    <setting string="Company" help="ZKTeco BioTime company">
                        <field name="zkteco_company" string="Company Name"/>
                    </setting>
                    <setting string="Server URL" help="Full URL of the ZKTeco bioTime server">
                        <field name="zkteco_server_url" string="Server URL" class="w-100" placeholder="https://biotime.example.com"/>
                    </setting>
                    <setting string="Email" help="Email used to authenticate with the BioTime server">
                        <field name="zkteco_email" string="Email" placeholder="admin@example.com"/>
                    </setting>
                    <setting string="Password" help="Password used to authenticate with the BioTime server">
                        <field name="zkteco_password" string="Password" password="True"/>
                    </setting>
                    <setting string="Transaction Fetch Window" help="Number of days of punch data to fetch from the BioTime server on each sync.">
                        <field name="zkteco_transaction_fetch_days"/>
                    </setting>
                    <setting string="Check-out Lookback" help="Number of days to look back when matching a check-out to an existing open attendance.">
                        <field name="zkteco_checkout_lookback_days"/>
                    </setting>
                    <setting string="Connection" help="Verify the connection to the ZKTeco BioTime server.">
                        <button name="action_test_zkteco_connection"
                                string="Test Connection"
                                type="object"
                                class="btn-primary"
                                invisible="not zkteco_server_url or not zkteco_email or not zkteco_password or not zkteco_company"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
