<odoo>
    <record id="zkteco_terminal_view_list" model="ir.ui.view">
        <field name="name">zkteco.terminal.view.list</field>
        <field name="model">zkteco.terminal</field>
        <field name="arch" type="xml">
            <list string="Terminals" create="0">
                <header>
                    <button name="action_fetch_terminals" type="object" string="Fetch Terminals" class="btn-primary" display="always"/>
                </header>
                <field name="name" readonly="1"/>
                <field name="terminal_sn" readonly="1"/>
                <field name="location_id"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="zkteco_terminal_view_form" model="ir.ui.view">
        <field name="name">zkteco.terminal.view.form</field>
        <field name="model">zkteco.terminal</field>
        <field name="arch" type="xml">
            <form string="Terminal" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="terminal_sn" readonly="1" help="The ID of the terminal that is defined in the Biotime server"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_work_location_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.work.location.view.form.inherit.hr.attendance.zkteco</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="BioTime">
                    <field name="zkteco_biotime_id" help="The ID of the Location that is defined in the Biotime server"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="zkteco_terminal_action" model="ir.actions.act_window">
        <field name="name">Zkteco Terminals</field>
        <field name="res_model">zkteco.terminal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
    </record>

    <menuitem id="zkteco_terminal_menu"
            name="Zkteco Terminals"
            parent="hr_attendance.menu_hr_attendance_configuration"
            action="zkteco_terminal_action"
            sequence="60"/>
</odoo>
