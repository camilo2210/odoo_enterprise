<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="avatax_parameter_value_view_form" model="ir.ui.view">
        <field name="name">avatax.parameter.value.view.form</field>
        <field name="model">avatax.parameter.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="parameter_id" options="{'no_open': True, 'no_create': True}"/>
                        <field name="parameter_description" readonly="1" invisible="not parameter_id"/>
                        <field name="data_type" invisible="1"/>
                        <field name="avatax_uom_id" invisible="data_type != 'NumericMeasured'" options="{'no_open': True, 'no_create': True}"/>
                        <field name="value_boolean" string="Value" invisible="data_type != 'Boolean'"/>
                        <field name="value_float" string="Value" invisible="data_type not in ('NumericMeasured', 'NumericCurrency')"/>
                        <field name="value_char" string="Value" invisible="data_type not in ('String', 'Date')"/>
                        <field name="value_selection_id" string="Value" invisible="data_type != 'Enumeration'" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="avatax_parameter_value_view_list" model="ir.ui.view">
        <field name="name">avatax.parameter.value.view.list</field>
        <field name="model">avatax.parameter.value</field>
        <field name="arch" type="xml">
            <list>
                <!-- Needed to have these values for NewId in `_compute_value()` -->
                <field name="parameter_id" column_invisible="True"/>
                <field name="data_type" column_invisible="True"/>
                <field name="value" column_invisible="True"/>
                <field name="value_boolean" column_invisible="True"/>
                <field name="value_float" column_invisible="True"/>
                <field name="value_char" column_invisible="True"/>
                <field name="value_selection_id" column_invisible="True"/>
                <field name="avatax_uom_id" column_invisible="True"/>

                <field name="display_name" string="Parameter"/>
            </list>
        </field>
    </record>
</odoo>
