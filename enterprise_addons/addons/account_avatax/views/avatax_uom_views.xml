<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="avatax_uom_view_list" model="ir.ui.view">
        <field name="name">avatax.uom.view.list</field>
        <field name="model">avatax.uom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="avatax_uom_view_search" model="ir.ui.view">
        <field name="name">avatax.uom.view.search</field>
        <field name="model">avatax.uom</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="measurement_type"/>
            </search>
        </field>
    </record>
</odoo>
