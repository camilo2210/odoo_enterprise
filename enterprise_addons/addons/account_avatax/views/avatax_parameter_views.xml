<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="avatax_parameter_view_list" model="ir.ui.view">
        <field name="name">avatax.parameter.view.list</field>
        <field name="model">avatax.parameter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="avatax_parameter_view_search" model="ir.ui.view">
        <field name="name">avatax.parameter.view.search</field>
        <field name="model">avatax.parameter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="data_type"/>
            </search>
        </field>
    </record>
</odoo>
