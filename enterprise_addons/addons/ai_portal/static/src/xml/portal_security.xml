<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="portal.keyshow" t-inherit-mode="extension">
        <xpath expr="//div[@id='rpc_key_card']" position="attributes">
            <attribute name="t-if">scope != 'mcp'</attribute>
        </xpath>

        <xpath expr="//div[@id='rpc_key_card']" position="after">
            <div class="card" t-if="scope == 'mcp'">
                <div id="mcp_key_card" class="card-header d-flex justify-content-between align-items-center">
                    <strong>To connect via MCP, add these details to your AI Assistant's settings:</strong>
                </div>
                <div class="card-body">
                    <code>
                        <p class="mb-1">
                            <strong>Server URL: </strong>
                            <span t-out="base_url"/>/mcp
                        </p>
                        <p class="mb-1">
                            <strong>Server Name: </strong>
                            <span>&lt;Pick a name&gt;</span>
                        </p>
                        <p class="mb-1">
                            <strong>Header: </strong>
                            <span>Authorization: Bearer <span t-out="key"/></span>
                        </p>
                    </code>
                </div>
            </div>
        </xpath>
    </t>
</templates>
