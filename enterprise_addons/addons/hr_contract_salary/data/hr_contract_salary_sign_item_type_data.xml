<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sign item type used in contract -->
        <record model="sign.item.type" id="sign_item_type_legal_name">
            <field name="name">Legal Name</field>
            <field name="placeholder">Legal Name</field>
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="auto_field">employee_id.legal_name</field>
            <field name="required" eval="True"/>
            <field name="constant" eval="True"/>
            <field name="default_width" type="float">0.18</field>
            <field name="default_height" type="float">0.015</field>
            <field name="icon">person</field>
            <field name="authorized_group_ids" eval="[Command.set([ref('hr_recruitment.group_hr_recruitment_interviewer'), ref('hr_payroll.group_hr_payroll_user')])]"/>
        </record>

        <record model="sign.item.type" id="sign_item_type_private_city">
            <field name="name">Private City</field>
            <field name="placeholder">City</field>
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="auto_field">private_city</field>
            <field name="required" eval="True"/>
            <field name="constant" eval="True"/>
            <field name="default_width" type="float">0.18</field>
            <field name="default_height" type="float">0.015</field>
            <field name="icon">business</field>
            <field name="authorized_group_ids" eval="[Command.set([ref('hr_recruitment.group_hr_recruitment_interviewer'), ref('hr_payroll.group_hr_payroll_user')])]"/>
        </record>

        <record model="sign.item.type" id="sign_item_type_country_name">
            <field name="name">Country Name</field>
            <field name="placeholder">Country Name</field>
            <field name="model_id" ref="hr.model_hr_version" />
            <field name="auto_field">private_country_id.name</field>
            <field name="required" eval="True"/>
            <field name="constant" eval="True"/>
            <field name="default_width" type="float">0.18</field>
            <field name="default_height" type="float">0.015</field>
            <field name="icon">flag</field>
            <field name="authorized_group_ids" eval="[Command.set([ref('hr_recruitment.group_hr_recruitment_interviewer'), ref('hr_payroll.group_hr_payroll_user')])]"/>
        </record>

        <record model="sign.item.type" id="sign_item_type_private_street">
            <field name="name">Private Street</field>
            <field name="placeholder">Street</field>
            <field name="model_id" ref="hr.model_hr_version" />
            <field name="auto_field">private_street</field>
            <field name="required" eval="True"/>
            <field name="constant" eval="True"/>
            <field name="default_width" type="float">0.18</field>
            <field name="default_height" type="float">0.015</field>
            <field name="icon">road</field>
            <field name="authorized_group_ids" eval="[Command.set([ref('hr_recruitment.group_hr_recruitment_interviewer'), ref('hr_payroll.group_hr_payroll_user')])]"/>
        </record>

    </data>
</odoo>
