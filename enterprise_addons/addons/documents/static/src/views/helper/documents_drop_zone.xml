<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents.DocumentsDropZone">
        <t t-if="this.dragOver()">
            <div class="h-100 w-100 start-0 position-absolute"
                t-att-class="{'o_documents_drop_over_zone': this.canDrop, 'o_documents_drop_over_unauthorized_zone': !this.canDrop}"
                t-attf-style="top: {{this.topOffset()}}px !important; z-index: 10;"
                t-on-drop.prevent="this.onDrop">
                <div class="h-100 w-100 position-sticky">
                    <div t-if="this.canDrop" class="o_documents_upload_text text-center text-white">
                        <i class="d-block oi oi-9x mb-4" data-icon="upload"/>
                        <span>Drop files here to upload</span>
                    </div>
                    <div t-else="" class="o_documents_upload_text text-center text-danger">
                        <i class="oi oi-9x oi-filled d-block mb-4" data-icon="cancel"/>
                        <span>You must be in a specific writable folder to upload files</span>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>
