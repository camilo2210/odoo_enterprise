<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="documents.DocumentsBooleanIconField">
        <button t-attf-class="btn {{this.props.record.data[this.props.name] ? this.props.btnTrueClass:this.props.btnFalseClass}}"
            t-att-data-tooltip="this.props.label" t-on-click.prevent.stop="this.update">
            <i class="oi" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon"/>
        </button>
    </t>

</templates>
