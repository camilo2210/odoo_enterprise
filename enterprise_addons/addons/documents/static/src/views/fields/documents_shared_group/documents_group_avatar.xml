<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="documents.DocumentsGroupAvatarCardPopover">
        <ul class="m-3 list-unstyled">
            <li t-foreach="this.state.users" t-as="user" t-key="user.id" class="mb-1">
                <Avatar resModel="'res.users'" resId="user.id" canOpenPopover="false"
                        cssClass="'fw-bold'" displayName="user.name"/>
            </li>
        </ul>
    </t>

</templates>
