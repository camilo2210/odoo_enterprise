<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents.DocumentsKanbanRendererCommon" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="class" add="o_documents_view position-relative" separator=" "/>
            <attribute name="t-on-click">this.onGlobalClick</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="inside">
            <DocumentsFileViewer t-props="this.documentsAttachmentViewerProps"/>
        </xpath>
    </t>

    <t t-name="documents.DocumentsKanbanRenderer" t-inherit="documents.DocumentsKanbanRendererCommon" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="after">
            <DocumentsRightPanel nbViewItems="this.getNbViewItems()" t-if="!this.env.searchModel.context.documents_view_secondary"/>
        </xpath>
        <DocumentsFileViewer position="before">
            <DocumentsDropZone parentRoot="this.rootRef"/>
        </DocumentsFileViewer>
        <t t-foreach="this.getGroupsOrRecords()" position="attributes">
            <attribute name="t-if" add="!this.isRecentFolder" separator="and"/>
        </t>
        <t t-foreach="this.getGroupsOrRecords()" position="before">
            <div t-if="this.isRecentFolder" class="w-100">
                <!-- RECENT view -->
                <div t-foreach="this.getGroupsOrRecords()" t-as="group" t-key="group.key"
                    class="d-flex flex-row flex-wrap gap-3 p-2">
                    <h3 class="o_documents_title m-2 w-100 fs-4" t-out="group.group.displayName"/>
                    <t t-set="folders" t-value="group.group.list.records.filter((d) => d.data.type === 'folder')"/>
                    <t t-set="files" t-value="group.group.list.records.filter((d) => d.data.type !== 'folder')"/>
                    <t t-foreach="folders" t-as="record" t-key="record.id">
                        <t t-set="group" t-as="group.group"/>
                        <KanbanRecord
                            Compiler="this.props.Compiler"
                            archInfo="this.props.archInfo"
                            groupByField="this.props.list.groupByField"
                            getSelection.bind="this.getSelection"
                            toggleSelection.bind="this.toggleSelection"
                            selectionAvailable="this.state.selectionAvailable"
                            record="record"
                        />
                    </t>
                    <div class="w-100"/>
                    <t t-foreach="files" t-as="record" t-key="record.id">
                        <t t-set="group" t-as="group.group"/>
                        <KanbanRecord
                            Compiler="this.props.Compiler"
                            archInfo="this.props.archInfo"
                            groupByField="this.props.list.groupByField"
                            getSelection.bind="this.getSelection"
                            toggleSelection.bind="this.toggleSelection"
                            selectionAvailable="this.state.selectionAvailable"
                            record="record"
                        />
                    </t>
                </div>
            </div>
            <t t-if="this.hasFolders() and !this.props.list.isGrouped">
                <h3 class="o_documents_title m-2 w-100 fs-4">Folders</h3>
                <t t-foreach="this.getFolderRecords()" t-as="folderRecord" t-key="folderRecord.key">
                    <KanbanRecord
                        Compiler="this.props.Compiler"
                        archInfo="this.props.archInfo"
                        groupByField="this.props.list.groupByField"
                        getSelection.bind="this.getSelection"
                        toggleSelection.bind="this.toggleSelection"
                            selectionAvailable="this.state.selectionAvailable"
                        record="folderRecord.record"
                    />
                </t>
                <!-- kanban ghost cards are used to properly space last elements. -->
                <div t-foreach="[,,,,,,]" t-as="i" t-key="i_index" class="o_kanban_record o_kanban_ghost flex-grow-1 flex-md-shrink-1 flex-shrink-0" />
                <h3 t-if="this.hasFiles()" class="o_documents_title m-2 w-100 fs-4">Files</h3>
            </t>
            <FileUploadProgressContainer fileUploads="this.documentUploads" Component="this.constructor.components.FileUploadProgressKanbanRecord"
                                         shouldDisplay="(upload) => !upload.data.get('document_id') &amp;&amp; !upload.data.get('thread_id')"/>
        </t>
        <ActionHelper position="replace">
            <t t-if="this.props.noContentHelp">
                <DocumentsActionHelper noContentHelp="this.props.noContentHelp"/>
            </t>
        </ActionHelper>
    </t>
</templates>
