<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FileViewer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-FileViewer-download')][hasclass('o-FileViewer-headerButton')]" position="after">
            <div t-if="this.documentService.canAddAttachmentToDocuments(this.state.file)" class="o-FileViewer-headerButton d-flex align-items-center px-3 cursor-pointer" role="button" t-att-title="this.state.file.documentHelperText" t-att-aria-label="this.state.file.documentHelperText" t-on-click.stop="(ev) => this.documentService.onClickAddAttachmentToDocuments(this.state.file, ev)">
                <i class="oi oi-fw" t-att-data-icon="this.state.file.documentIcon" role="img"/>
            </div>
        </xpath>
    </t>
</templates>
