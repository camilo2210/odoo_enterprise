<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents.DocumentsViews.RightPanel">
        <div t-if="this.state.rightPanelVisible and this.documentService.canShowRightPanel"
            class="o_document_chatter_container o-mail-ChatterContainer o-aside h-100 align-self-start me-3 mb-3 pb-0 border rounded-4 bg-view overflow-hidden"
            t-att-class="{'d-flex flex-column': !this.panelDisabled}"
        >
            <t t-if="this.panelDisabled" t-call="documents.DocumentsViews.ChatterOverlay"/>
            <DocumentsDetailsPanel t-if="!this.panelDisabled" record="this.state.previewedDocument?.record || this.state.focusedRecord" nbViewItems="this.props.nbViewItems" />
            <Chatter t-if="!this.panelDisabled and this.documentService.userIsInternal"
                threadId="this.state.focusedRecord.data.id"
                threadModel="'documents.document'"
                isChatterAside="true"/>
        </div>
    </t>
</templates>
