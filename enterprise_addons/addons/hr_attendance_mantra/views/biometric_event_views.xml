<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_biometric_event_search_mantra" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.event.search.mantra</field>
        <field name="model">hr.attendance.biometric.event</field>
        <field name="inherit_id" ref="hr_attendance_biometric_integration.view_hr_attendance_biometric_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='errors']" position="after">
                <separator/>
                <filter string="Mantra" name="mantra" domain="[('provider', '=', 'mantra')]"/>
            </xpath>
        </field>
    </record>
</odoo>

