msgid "'Empty Report - Used for assigning IoT printer'"
msgstr "\"تقرير فارغ - يُستخدم لتعيين طابعة إنترنت الأشياء\""

msgid "Auto Print Carrier Labels"
msgstr "طباعة ملصق شركة الشحن تلقائياً"

msgid "Auto Print Export Documents"
msgstr "طباعة مستندات التصدير تلقائيًا"

msgid "Carrier Labels"
msgstr "بطاقات عناوين شركة الشحن"

msgid "Export Documents"
msgstr "تصدير المستندات"

msgid ""
"If this checkbox is ticked, Odoo will automatically print the carrier labels "
"of the picking when they are created. Note this requires a printer to be "
"assigned to this report."
msgstr ""
"إذا تم تحديد خانة الاختيار هذه، فسيقوم Odoo تلقائيًا بطباعة ملصقات الناقل "
"الخاصة بالاختيار عند إنشائها. لاحظ أن هذا يتطلب تخصيص طابعة لهذا التقرير."

msgid ""
"If this checkbox is ticked, Odoo will automatically print the export "
"documents of the picking when they are created. Availability of export "
"documents depends on the carrier and the destination. Note this requires a "
"printer to be assigned to this report. "
msgstr ""
"إذا تم تحديد خانة الاختيار هذه، فسيقوم Odoo تلقائيًا بطباعة مستندات التصدير "
"الخاصة بالاختيار عند إنشائها. يعتمد توفر مستندات التصدير على شركة النقل "
"والوجهة. لاحظ أن هذا يتطلب تخصيص طابعة لهذا التقرير. "

msgid "Report Action"
msgstr "إجراء التقرير"

msgid "Reporting"
msgstr "إعداد التقارير"

msgid "Reset Linked Printers"
msgstr "إعادة ضبط الطابعات المرتبطة"

msgid "Shipping Documents"
msgstr "مستندات الشحن"

msgid "Shipping Labels"
msgstr "بطاقات عنوان الشحن"

msgid "Transfer"
msgstr "تحويل"
