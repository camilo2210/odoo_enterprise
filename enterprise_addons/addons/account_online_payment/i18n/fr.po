#: code:addons/account_online_payment/models/account_payment.py:0
msgid "You can't pay payments from more than one journal."
msgstr ""
"Vous ne pouvez pas effectuer des paiements provenant de plusieurs journaux."

#. module: account_online_payment
#. odoo-python
#: code:addons/account_online_payment/models/account_payment.py:0
msgid "You cannot modify a payment that has already been sent to the bank."
msgstr ""
"Vous ne pouvez pas modifier un paiement qui a déjà été envoyé à la banque."

#. module: account_online_payment
#. odoo-python
#: code:addons/account_online_payment/models/account_online_link.py:0
msgid ""
"You haven't completed your KYC yet, so you can't process payment directly "
"from Odoo."
msgstr ""
"Vous n’avez pas encore complété votre vérification d’identité (KYC), vous ne "
"pouvez donc pas traiter de paiements directement depuis Odoo."

#. module: account_online_payment
#. odoo-python
#: code:addons/account_online_payment/models/account_payment.py:0
msgid "You must select at least one payment."
msgstr "Vous devez sélectionner au moins un paiement."

#. module: account_online_payment
#. odoo-python
#: code:addons/account_online_payment/models/account_online_account.py:0
msgid ""
"Your bank allows a maximum of %(limit)s payments per batch.\n"
"If you want to send your payments through Odoo, please split your batch."
msgstr ""
"Votre banque autorise un maximum de %(limit)s paiements par lot.\n"
"Si vous souhaitez envoyer vos paiements via Odoo, veuillez scinder votre lot."

#. module: account_online_payment
#: model_terms:ir.ui.view,arch_db:account_online_payment.view_batch_payment_form_inherit
msgid "Your payment activation is pending, please wait!"
msgstr "L’activation de vos paiements est en attente, veuillez patienter !"

#. module: account_online_payment
#: model:ir.model,name:account_online_payment.model_account_online_account
msgid "representation of an online bank account"
msgstr "- représentation d’un compte bancaire en ligne"

