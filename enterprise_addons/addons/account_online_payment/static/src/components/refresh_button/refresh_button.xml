<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="account_online_payment.RefreshButton" class="w-100 d-sm-contents">
        <div class="o_field_widget o_readonly_modifier o_field_char d-flex gap-2">
            <span class="w-25" t-out="this.paymentOnlineStatus"/>
            <t t-if="this.state.isFetching">
                <div>
                    <i class="oi oi-spin" data-icon="autorenew"/>
                </div>
            </t>
            <t t-elif="['pending', 'unsigned'].includes(this.paymentOnlineStatus)">
                <div name="check_online_payment_status" class="cursor-pointer" t-on-click="this.onClickFetchStatus">
                    <i class="oi" data-icon="refresh"/>
                </div>
            </t>
        </div>
    </div>
</templates>
