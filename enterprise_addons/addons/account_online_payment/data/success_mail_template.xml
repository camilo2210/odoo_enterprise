<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_account_payment_activation_success" model="mail.template">
            <field name="name">Payments successfully activated</field>
            <field name="model_id" ref="account_online_payment.model_account_online_link"/>
            <field name="subject">Payments successfully activated</field>
            <field name="email_to">{{object.renewal_contact_email}}</field>
            <field name="auto_delete" eval="True"/>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html" type="html">
                <div style="font-size: 14px;">
                    <p>Hi there,</p>
                    <p>We're pleased to inform you that the payments feature in Odoo has been successfully activated. </p>
                    <p>You can now process payments directly through your Odoo database, ensuring faster, more secure, and more efficient transactions.</p>
                    <div style="margin:16px auto; text-align:center">
                        <a t-att-href="object.get_base_url()"
                           t-attf-style="padding: 8px 16px 8px 16px; border-radius: 3px; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; text-decoration:none; color: {{object.company_id.email_primary_color or '#FFFFFF'}};">
                            Make Payments
                        </a>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
