<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="frontdesk" name="Frontdesk">
        <t t-set="head">
            <t t-call-assets="frontdesk.assets_frontdesk" lazy_load="True"/>
            <script type="text/javascript">
                odoo.__session_info__ = <t t-out="json.dumps(session_info)"/>;
            </script>
        </t>
        <t t-call="web.frontend_layout"
            head="head"
            title="frontdesk.name"
            body_classname="'o_frontdesk ' + ('bg-900 o_dark' if frontdesk.theme == 'dark' else 'o_light')"
            no_header="1"
            no_footer="1"
            no_livechat="1">
            <owl-component name="frontdesk" t-att-props="json.dumps({
                'id': frontdesk.id,
                'isMobile': is_mobile,
                'currentLang': current_lang,
            })"/>
        </t>
    </template>
</odoo>
