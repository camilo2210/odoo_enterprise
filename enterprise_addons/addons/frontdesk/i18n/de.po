#. module: frontdesk
#: model:mail.template,body_html:frontdesk.frontdesk_visitor_mail_template
msgid ""
"<div>\n"
"                    <p>Hello <t t-if=\"ctx.get('host_name')\"><t t-"
"out=\"ctx.get('host_name')\"/>, </t><b><t t-out=\"object.name\"/></b> <t t-"
"if=\"object.phone\">(<t t-out=\"object.phone\"/>)</t><t t-"
"if=\"object.company\">, coming from <t t-out=\"object.company\"/></t> is "
"asking to meet you at <t t-out=\"object.station_id.name\"/>. Please let them "
"know you'll be there shortly.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Guten Tag <t t-if=\"ctx.get('host_name')\"><t t-"
"out=\"ctx.get('host_name')\"/>, </t><b><t t-out=\"object.name\"/></b> <t t-"
"if=\"object.phone\">(<t t-out=\"object.phone\"/>)</t><t t-"
"if=\"object.company\"> von <t t-out=\"object.company\"/></t> bittet um ein "
"Treffen an folgendem Standort: <t t-out=\"object.station_id.name\"/>. Bitte "
"benachrichtigen Sie die Person, dass Sie bald kommen.\n"
"                    </p>\n"
"                </div>\n"
"            "

