<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="helpdesk.SLATag">
        <BadgeTag color="this.props.color" onDelete="this.props.onDelete" tooltip="this.props.tooltip">
            <t t-set="statusIcon" t-value="this.SLAStatusIcon"/>
            <i t-if="statusIcon" class="oi oi-filled me-2" t-att-data-icon="statusIcon"/>
            <div class="o_tag_badge_text" t-out="this.props.text"/>
        </BadgeTag>
    </t>

</templates>
