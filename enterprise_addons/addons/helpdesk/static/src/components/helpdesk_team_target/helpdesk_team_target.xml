<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="helpdesk.HelpdeskTeamTarget">
        <td t-attf-class="{{this.props.demoClass}} p-0" t-att-data-hotkey="this.props.hotkey">
            <input t-if="this.state.isFocused" t-att-value="this.state.value"
                   class="form-control p-0 h-100 text-center rounded" type="text"
                   t-ref="this.inputRef" t-on-blur="this._toggleFocus" t-on-change="this._onValueChange"
                   t-on-keydown="this._onInputKeydown"
            />
            <span t-else="" class="btn btn-light justify-content-center align-items-center d-flex h-100 p-0 border-0 bg-100 fw-normal"
                  t-att-title="this.helpdeskTeamTargetTitle"
                  t-att-class="{'o_target_to_set': !this.props.showDemo}" t-on-click.stop="this._toggleFocus"
            >
                <div t-if="this.state.value" class="position-relative p-2">
                    <t t-out="this.valueString"/>
                    <i class="oi oi-filled position-absolute ms-2 mt-1 opacity-0" data-icon="edit"/>
                </div>
                <div t-else="">
                    Click to set
                </div>
            </span>
        </td>
    </t>
</templates>
