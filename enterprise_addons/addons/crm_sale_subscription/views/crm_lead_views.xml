<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart Button for opening subscriptions from lead. -->
    <record id="crm_lead_view_form_inherit_subscriptions" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.subscriptions</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_subscriptions" type="object" class="oe_stat_button" icon="refresh" invisible="subscription_count == 0">
                    <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
