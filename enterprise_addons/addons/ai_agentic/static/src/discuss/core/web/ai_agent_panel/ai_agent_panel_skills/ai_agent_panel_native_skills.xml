<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelNativeSkills">
        <div>
            <h6 class="mt-2 mb-2">Tools</h6>
            <div aria-atomic="true" class="d-flex flex-column gap-2 w-100 mb-3">
                <t t-foreach="this.items" t-as="item" t-key="item.id">
                    <div class="o_ai_agent_panel_list_row d-flex align-items-center justify-content-between gap-2 w-100 p-2 border rounded-4 bg-body">
                        <span class="text-900 fw-medium text-truncate" t-out="item.display_name"/>
                        <CheckBox
                            value="this.isSelected(item)"
                            onChange="(checked) => this.onChange(item.id, item.display_name, checked)"
                            className="'o_field_boolean o_boolean_toggle form-switch'"
                        />
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
