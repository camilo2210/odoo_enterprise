<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelList.AddButton">
        <button class="btn btn-sm btn-primary flex-shrink-0" t-on-click.stop.prevent="() => this.props.onAdd({})">
            <i class="oi me-1" data-icon="add"/>Add
        </button>
    </t>

    <t t-name="ai_agentic.AiAgentPanelList">
        <t t-set="isEmpty" t-value="!this.props.list.records.length"/>
        <div class="o_ai_agent_panel_list d-flex flex-column gap-2 w-100">
            <div class="d-flex align-items-center gap-2">
                <t t-if="this.constructor.headerTemplate" t-call="{{ this.constructor.headerTemplate }}"/>
                <div t-if="!isEmpty" class="ms-auto">
                    <t t-call="ai_agentic.AiAgentPanelList.AddButton"/>
                </div>
            </div>
            <div t-if="isEmpty" class="text-center text-500 my-3">
                <i class="oi oi-2x opacity-50 mb-2 d-block" t-att-data-icon="this.constructor.empty.icon"/>
                <p t-out="this.constructor.empty.text"/>
                <t t-call="ai_agentic.AiAgentPanelList.AddButton"/>
            </div>
            <t t-else="">
                <t t-foreach="this.props.list.records" t-as="record" t-key="record.id">
                    <t t-call="{{ this.constructor.rowTemplate }}"/>
                </t>
            </t>
        </div>
    </t>

</templates>
