<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelTriggerListRenderer.Row">
        <div class="o_ai_agent_panel_list_row d-flex align-items-center gap-2 w-100 p-2 border rounded-4 bg-body">
            <button
                class="btn btn-link text-start text-reset text-decoration-none min-w-0 flex-grow-1 p-0 d-flex align-items-center gap-2"
                type="button"
                t-on-click="() => this.onClickOpenTrigger(record)"
            >
                <i class="oi oi-fw" t-att-data-icon="this.isCronTrigger(record) ? 'schedule' : 'flash_on'"/>
                <span class="d-block text-truncate" t-out="record.data.name"/>
            </button>
            <button
                t-if="this.isCronTrigger(record)"
                class="btn btn-sm btn-secondary flex-shrink-0"
                type="button"
                t-on-click.stop="() => this.onClickRunTrigger(record)"
            >Run</button>
            <CheckBox
                value="record.data.active"
                onChange="(checked) => this.onToggleActive(record, checked)"
                className="'o_field_boolean o_boolean_toggle form-switch'"
            />
        </div>
    </t>

</templates>
