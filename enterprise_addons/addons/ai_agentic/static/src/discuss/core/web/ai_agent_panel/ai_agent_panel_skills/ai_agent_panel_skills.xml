<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelSkillListRenderer.Header">
        <h6 class="mb-0">Skills</h6>
    </t>

    <t t-name="ai_agentic.AiAgentPanelSkillListRenderer.Row">
        <div class="o_ai_agent_panel_list_row d-flex align-items-center gap-2 w-100 p-2 border rounded-4 bg-body">
            <button
                class="btn btn-link text-start text-reset text-decoration-none min-w-0 flex-grow-1 p-0 d-flex align-items-center gap-2"
                type="button"
                t-on-click="() => this.onClickEditSkill(record)"
            >
                <i class="oi" data-icon="wand_stars"/>
                <span class="d-block text-truncate" t-out="record.data.name"/>
            </button>
            <Dropdown menuClass="'o_ai_agent_panel_list_row_menu'" position="'bottom-end'">
                <button class="btn btn-sm o-no-caret px-1" title="Dropdown menu">
                    <span class="oi" data-icon="more_vert"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem onSelected="() => this.onClickEditSkill(record)">
                        <i class="oi oi-fw oi-filled me-2" data-icon="edit"/>Edit
                    </DropdownItem>
                    <DropdownItem class="'text-danger'" onSelected="() => this.onClickRemoveSkill(record)">
                        <i class="oi oi-fw oi-filled me-2" data-icon="delete"/>Remove
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
