<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelSourceListRenderer.Header">
        <div class="d-flex align-items-center gap-2">
            <BooleanToggleField name="'restrict_to_sources'" record="this.sourcesFolderTree.record"/>
            <span>Restrict answers to Sources</span>
        </div>
    </t>

    <t t-name="ai_agentic.AiAgentPanelSourceListRenderer.Row">
        <AiAgentSourceRow record="record"/>
    </t>

</templates>
