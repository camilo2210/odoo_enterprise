<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentPanelAgentListRenderer.Header">
        <h6 class="mb-0">Subagents</h6>
    </t>

    <t t-name="ai_agentic.AiAgentPanelAgentListRenderer.Row">
        <div class="o_ai_agent_panel_list_row d-flex align-items-center gap-2 w-100 p-2 border rounded-4 bg-body">
            <button
                class="btn btn-link text-start text-reset text-decoration-none min-w-0 flex-grow-1 p-0 d-flex align-items-center gap-2"
                type="button"
                t-on-click="() => this.onClickAgent(record)"
            >
                <img t-attf-src="/web/image/ai.agent/{{record.data.id}}/avatar_128" class="o_avatar rounded"/>
                <span class="fw-bold text-truncate m0" t-out="record.data.name"/>
            </button>
            <button class="btn btn-sm o-no-caret px-1" t-on-click="() => this.onClickRemoveAgent(record)">
                <span class="oi" data-icon="close"/>
            </button>
        </div>
    </t>

</templates>
