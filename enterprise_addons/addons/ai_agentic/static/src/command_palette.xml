<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AICommand">
        <div class="o-mail-DiscussCommand o_command_default d-flex align-items-center ps-3 pe-4" t-att-class="{ 'o-uiSmall': this.ui.isSmall }">
            <i class="oi oi-fw oi-filled opacity-50 text-muted me-2" data-icon="settings"/>
            <img class="rounded me-2 object-fit-cover" t-if="this.props.imgUrl" t-att-src="this.props.imgUrl"  style="width: 25px; height: 25px"/>
            <span class="pe-1 text-ellipsis d-flex align-items-center fw-bold">
                <t t-call-slot="name" />
            </span>
            <span t-if="this.props.subtitle" class="text-muted smaller text-truncate mw-50" t-out="'- ' + this.props.subtitle"/>
        </div>
    </t>

</templates>
