<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_prompt_button_view_form" model="ir.ui.view">
        <field name="name">ai.prompt.button.view.form</field>
        <field name="model">ai.prompt.button</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <label for="name" string="Title" colspan="2"/>
                        <field name="name" nolabel="1" placeholder="Summarize the chatter" colspan="2"/>
                    </group>
                    <group>
                        <label for="prompt" string="Prompt" colspan="2"/>
                        <field
                            name="prompt"
                            nolabel="1"
                            colspan="2"
                            options="{
                                'height': 200,
                                'resizable': true,
                                'aiFieldSelectorModelReferenceField': 'render_model'
                            }"
                            widget='ai_field_selector_html_field'
                            invisible="not render_model"
                            class="border"
                            placeholder="e.g. write a one paragraph summary of the chatter conversation"
                        />
                        <field
                            name="prompt"
                            nolabel="1"
                            colspan="2"
                            options="{
                                'height': 200,
                                'resizable': true,
                            }"
                            invisible="render_model"
                            class="border"
                            placeholder="e.g. write a one paragraph summary of the chatter conversation"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
