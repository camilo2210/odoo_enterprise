<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="account_reports.account_audit_balance_list_controller" t-inherit="web.ListView">
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <button
                data-tooltip="Chatter"
                class="btn btn-secondary o_switch_view o_kanban active"
                t-att-class="{
                    'd-none': !this.chatterPlugin.res_id(),
                    'd-md-inline': this.chatterPlugin.res_id(),
                }">
                    <i class="oi oi-fw mt-1" data-icon="close"/>
            </button>
        </xpath>

        <xpath expr="//SelectionBox" position="before">
            <div t-if="this.model.root.selection.length &gt; 1" t-on-click="this.openJournalItems">
                <button class="btn btn-secondary">
                    <i class="oi me-1" data-icon="format_list_bulleted"></i>
                    <span>Journal Items</span>
                </button>
            </div>
        </xpath>
    </t>
</templates>
