<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="account_reports.PartnerLedgerFollowupLineCell" t-inherit="account_reports.AccountReportLineCellCustomizable">
        <xpath expr="//t[@t-if='this.props.cell.auditable?.()']" position="after">
            <t t-elif="this.props.cell.expression_label?.() === 'no_followup' and typeof this.props.cell.no_format?.() === 'boolean'">
                <div class="o-checkbox form-check o_boolean_toggle form-switch mx-auto"
                     t-on-click.stop.prevent="this.toggleNoFollowup">
                    <input type="checkbox" class="form-check-input" role="switch"
                           t-att-checked="this.props.cell.no_format?.()"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
