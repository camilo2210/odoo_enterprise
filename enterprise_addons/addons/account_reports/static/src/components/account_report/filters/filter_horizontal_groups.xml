<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportFilterHorizontalGroups">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="oi oi-filled me-1" data-icon="filter_alt"/>Group: <t t-out="this.selectedHorizontalGroupName"/>
            </button>

            <t t-set-slot="content">
                <DropdownItem
                    class="{ 'selected': this.controller.cachedFilterOptions().selected_horizontal_group_id === null }"
                    onSelected="() => this.selectHorizontalGroup(null)"
                    closingMode="'none'"
                >
                    None
                </DropdownItem>

                <t t-foreach="this.controller.cachedFilterOptions().available_horizontal_groups" t-as="horizontalGroup" t-key="horizontalGroup_index">
                    <DropdownItem
                        class="{ 'selected': this.controller.cachedFilterOptions().selected_horizontal_group_id === horizontalGroup.id }"
                        onSelected="() => this.selectHorizontalGroup(horizontalGroup.id)"
                        closingMode="'none'"
                    >
                        <t t-out="horizontalGroup.name"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
