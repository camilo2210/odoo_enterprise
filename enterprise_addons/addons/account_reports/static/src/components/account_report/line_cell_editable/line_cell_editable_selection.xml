<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportLineCellEditableSelection">
        <div
            class="content d-inline-block"
            t-ref="this.selectionRef"
        >
            <SelectMenu
                choices="this.selectionChoices()"
                value="this.selectionValue"
                togglerClass="'w-100 text-end'"
                searchPlaceholder.translate="Select or type a value"
                onSelect.bind="this.onSelectChoice"
                onOpened.bind="this.onSelectOpened"
                onClosed.bind="this.onSelectClosed"
                menuClass="'w-auto'"
            />
        </div>
        <i class="oi oi-filled cursor-pointer" data-icon="edit"
           t-on-click.prevent.stop="this.onClickSelection"
           t-att-class="{'invisible': this.isFocused()}"
        />
    </t>
</templates>
