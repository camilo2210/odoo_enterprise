<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportEllipsisPopover">
        <div class="account_report_popover_ellipsis">
            <p t-out="this.props.name"/>
            <button class="btn account_report_btn_clone" t-on-click="() => this.props.copyEllipsisText()">
                <i class="oi" data-icon="assignment"/>
            </button>
        </div>
    </t>
</templates>
