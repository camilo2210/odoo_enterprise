<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportEllipsis">
        <t t-call="{{ this.controller.template('AccountReportEllipsis') }}"/>
    </t>

    <t t-name="account_reports.AccountReportEllipsisCustomizable">
        <t t-set="name" t-value="this.props.name?.()"/>
        <t t-if="this.props.type?.() === 'string'">
            <t t-out="name ? name.substring(0, this.props.maxCharacters) : ''"/>

            <i  class="btn btn_ellipsis oi"
                data-icon="more_horiz"
                t-if="this.triggersEllipsis"
                t-on-click="(ev) => this.showEllipsisPopover(ev)"
                />
        </t>
        <t t-else="">
            <t t-out="name"/>
        </t>
    </t>
</templates>
