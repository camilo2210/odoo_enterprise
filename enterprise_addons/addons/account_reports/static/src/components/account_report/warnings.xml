<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.common_warning_tax_unit">
        This company is part of a tax unit. You're currently not viewing the whole unit.
    </t>

    <t t-name="account_reports.common_warning_draft_in_period">
        There are
        <a type="button" t-on-click="(ev) => this.controller.reportAction(ev, 'open_unposted_moves', {})">unposted Journal Entries</a>
        prior or included in this period.
    </t>

    <t t-name="account_reports.common_link_account_return">
        <t t-if="warningParams['submitted']">
            View submitted
            <a type="button" class="ps-1" t-on-click="(ev) => this.controller.reportAction(ev, 'action_open_related_returns')">Tax Return</a>
        </t>
        <t t-else="">
            Review or submit <a type="button" class="ps-1" t-on-click="(ev) => this.controller.reportAction(ev, 'action_open_related_returns')">Tax Return</a>
        </t>
    </t>

    <t t-name="account_reports.common_possibly_unbalanced_because_cta">
        This report uses the CTA conversion method to consolidate multiple companies using different currencies,
        which can lead the report to be unbalanced.
    </t>
</templates>
