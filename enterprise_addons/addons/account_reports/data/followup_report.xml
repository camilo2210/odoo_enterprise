<?xml version="1.0" encoding="UTF-8"?>
<odoo auto_sequence="1">
    <record id="followup_report" model="account.report">
        <field name="name">Open Items</field>
        <field name="filter_journals" eval="False"/>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="root_report_id" eval="False"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_account_type">both</field>
        <field name="filter_multi_company">selector</field>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">today</field>
        <field name="load_more_limit" eval="80"/>
        <field name="groupby">partner_id,id</field>
        <field name="custom_handler_model_id" ref="model_account_followup_report_handler"/>
        <field name="column_ids">
            <record id="followup_report_follow_up" model="account.report.column">
                <field name="name">No Reminder</field>
                <field name="expression_label">no_followup</field>
                <field name="figure_type">boolean</field>
            </record>
            <record id="followup_report_invoicing_date" model="account.report.column">
                <field name="name">Invoice Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="followup_report_date_maturity" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
            </record>
            <record id="followup_report_amount" model="account.report.column">
                <field name="name">Amount</field>
                <field name="expression_label">amount</field>
                <field name="blank_if_zero" eval="True"/>
            </record>
            <record id="followup_report_amount_currency" model="account.report.column">
                <field name="name">Amount Currency</field>
                <field name="expression_label">amount_currency</field>
                <field name="blank_if_zero" eval="True"/>
            </record>
            <record id="followup_report_amount_residual" model="account.report.column">
                <field name="name">Residual</field>
                <field name="expression_label">amount_residual</field>
                <field name="blank_if_zero" eval="True"/>
            </record>
            <record id="followup_report_amount_residual_currency" model="account.report.column">
                <field name="name">Residual Currency</field>
                <field name="expression_label">amount_residual_currency</field>
                <field name="blank_if_zero" eval="True"/>
            </record>
        </field>
        <field name="line_ids">
            <record id="followup_report_line" model="account.report.line">
                <field name="name">Open Items</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="followup_report_expression_no_followup" model="account.report.expression">
                        <field name="label">no_followup</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">no_followup</field>
                    </record>
                    <record id="followup_report_expression_invoice_date" model="account.report.expression">
                        <field name="label">invoice_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">invoice_date</field>
                    </record>
                    <record id="followup_report_expression_date" model="account.report.expression">
                        <field name="label">date_maturity</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">date_maturity</field>
                    </record>
                    <record id="followup_report_expression_amount" model="account.report.expression">
                        <field name="label">amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount</field>
                    </record>
                    <record id="followup_report_expression_amount_currency" model="account.report.expression">
                        <field name="label">amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount_currency</field>
                    </record>
                    <record id="followup_report_expression_amount_residual" model="account.report.expression">
                        <field name="label">amount_residual</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount_residual</field>
                    </record>
                    <record id="followup_report_expression_amount_residual_currency" model="account.report.expression">
                        <field name="label">amount_residual_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">amount_residual_currency</field>
                    </record>
                    <record id="folluwup_report_expression_currency_amount_currency" model="account.report.expression">
                        <field name="label">_currency_amount_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">_currency_amount_currency</field>
                    </record>
                    <record id="folluwup_report_expression_currency_amount_residual_currency" model="account.report.expression">
                        <field name="label">_currency_amount_residual_currency</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_partner_ledger_report</field>
                        <field name="subformula">_currency_amount_residual_currency</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
