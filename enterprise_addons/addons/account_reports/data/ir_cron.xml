<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_generate_account_return" model="ir.cron">
        <field name="name">Generate or refresh account return for every companies</field>
        <field name="model_id" ref="model_account_return_type"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_or_refresh_all_returns()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_create_snapshots" model="ir.cron">
        <field name="name">Create snapshots of accounting reports</field>
        <field name="model_id" ref="model_account_report_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_snapshots()</field>
        <field name="interval_number">9999</field> <!--Only executed via cron trigger-->
        <field name="interval_type">months</field>
    </record>

    <record id="ir_cron_garbage_collect_snapshots" model="ir.cron">
        <field name="name">Garbage-collect snapshots of accounting reports</field>
        <field name="model_id" ref="model_account_report_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_garbage_collect_snapshots()</field>
        <field name="priority" eval="0"/> <!--To make sure snapshots are always deleted ASAP, to avoid displaying inconsistent reports-->
        <field name="interval_number">9999</field> <!--Only executed via cron trigger-->
        <field name="interval_type">months</field>
    </record>
</odoo>
