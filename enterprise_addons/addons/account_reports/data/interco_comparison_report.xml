<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <record id="interco_comparison_report_audit_view" model="ir.ui.view">
        <field name="name">account.move.line.interco.audit.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <field name="amount_currency" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <record id="interco_comparison_report_audit_action" model="ir.actions.act_window">
        <field name="name">Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="interco_comparison_report_audit_view"/>
    </record>

    <record id="interco_comparison_report" model="account.report">
        <field name="name">Interco Comparison</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="custom_handler_model_id" ref="model_account_interco_comparison_report_handler"/>
        <field name="groupby">currency_id, interco_company, interco_account_type, interco_account</field>
        <field name="column_ids">
            <record id="interco_comparison_main_company" model="account.report.column">
                <field name="name">Main Company</field>
                <field name="expression_label">main_company</field>
                <field name="figure_type">float</field>
                <field name="custom_audit_action_id" ref="interco_comparison_report_audit_action"/>
            </record>
            <record id="interco_comparison_counterpart" model="account.report.column">
                <field name="name">Counterpart</field>
                <field name="expression_label">counterpart</field>
                <field name="figure_type">float</field>
                <field name="custom_audit_action_id" ref="interco_comparison_report_audit_action"/>
            </record>
            <record id="interco_comparison_difference" model="account.report.column">
                <field name="name">Difference</field>
                <field name="expression_label">difference</field>
                <field name="figure_type">float</field>
                <field name="custom_audit_action_id" ref="interco_comparison_report_audit_action"/>
            </record>
        </field>
        <field name="line_ids">
            <record id="interco_comparison_line" model="account.report.line">
                <field name="name">Interco Comparison</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="interco_comparison_line_main_company" model="account.report.expression">
                        <field name="label">main_company</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_interco_comparison</field>
                        <field name="subformula">main_company</field>
                        <field name="auditable" eval="True"/>
                    </record>
                    <record id="interco_comparison_line_counterpart" model="account.report.expression">
                        <field name="label">counterpart</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_interco_comparison</field>
                        <field name="subformula">counterpart</field>
                        <field name="auditable" eval="True"/>
                    </record>
                    <record id="interco_comparison_line_difference" model="account.report.expression">
                        <field name="label">difference</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_interco_comparison</field>
                        <field name="subformula">difference</field>
                        <field name="auditable" eval="True"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
