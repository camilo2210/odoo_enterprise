<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="calendar_event_online_cooking_lesson_1" model="calendar.event">
        <field name="appointment_booker_id" ref="base.res_partner_address_18"/>
        <field name="appointment_status">booked</field>
        <field name="appointment_type_id" ref="appointment_type_online_cooking_lesson"/>
        <field name="duration" eval="0.5"/>
        <field name="name">Gordon Owens - Online Cooking Lesson</field>
        <field name="partner_ids" eval="[(6, 0, [ref('base.res_partner_address_18'), ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 08:30:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 09:00:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

    <record id="calendar_event_online_cooking_lesson_2" model="calendar.event">
        <field name="appointment_booker_id" ref="base.partner_demo_portal"/>
        <field name="appointment_status">booked</field>
        <field name="appointment_type_id" ref="appointment_type_online_cooking_lesson"/>
        <field name="duration" eval="0.5"/>
        <field name="name">Joel Willis - Online Cooking Lesson</field>
        <field name="partner_ids" eval="[(6, 0, [ref('base.partner_demo_portal'), ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 09:00:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 09:30:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

</odoo>
