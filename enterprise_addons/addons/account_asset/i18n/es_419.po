#: code:addons/account_asset/models/account_move.py:0
msgid ""
"You can't post an entry related to a draft asset. Please post the asset "
"before."
msgstr ""
"No puede publicar un asiento relacionado con un activo en borrador. Publique "
"el asiento antes."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid "You can't re-evaluate the asset before the lock date."
msgstr "No puede volver a evaluar el activo antes de la fecha de bloqueo."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid ""
"You cannot activate depreciation on an asset that has running gross "
"increases. Please dispose of them first."
msgstr ""
"No puedes activar la depreciación de un activo que tenga incrementos brutos "
"en curso. Primero debes darlos de baja."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset.py:0
msgid ""
"You cannot archive a record that has at least one variant that is not closed"
msgstr ""

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset.py:0
msgid "You cannot archive a record that is not closed"
msgstr "No puede archivar un registro que no está cerrado"

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_variant.py:0
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid ""
"You cannot automate the journal entry for an asset that has a running gross "
"increase. Please use 'Dispose' on the increase(s)."
msgstr ""
"No puede automatizar el asiento contable para un activo que tiene un aumento "
"bruto en proceso. Utilice \"eliminar\" en los aumentos."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_variant.py:0
msgid "You cannot change the state of an archived asset"
msgstr ""

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset.py:0
msgid ""
"You cannot create an asset from lines containing credit and debit on the "
"account or with a null amount"
msgstr ""
"No puede crear un activo a partir de líneas que contienen crédito y débito "
"en la cuenta o con un importe nulo"

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset.py:0
msgid "You cannot delete a document that is in %s state."
msgstr "No puede eliminar un documento que está en estado %s."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_variant.py:0
msgid ""
"You cannot delete an asset linked to posted entries.\n"
"You should either confirm the asset, then, sell or dispose of it, or cancel "
"the linked journal entries."
msgstr ""
"No puede eliminar un activo vinculado a asientos registrados.\n"
"Debe confirmar el activo y luego venderlo o deshacerse de él, o cancelar los "
"asientos contables vinculados."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_variant.py:0
msgid "You cannot delete an asset variant that is in %s state."
msgstr ""

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_ledger_variant.py:0
msgid "You cannot dispose of a sub-asset before the lock date."
msgstr ""

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_variant.py:0
msgid "You cannot dispose of an asset before the lock date."
msgstr "No puede disponer de un activo antes de la fecha de bloqueo."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid "You cannot resume at a date equal to or before the pause date"
msgstr "No puede reanudar en una fecha igual o anterior a la fecha de pausa"

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid "You cannot select the same account as the Depreciation Account"
msgstr "No puede seleccionar la misma cuenta que la cuenta de depreciación."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_move.py:0
msgid ""
"You cannot update the account for asset '%s' because it is linked to journal "
"items from multiple different accounts."
msgstr ""
"No puedes actualizar la cuenta del activo \"%s\" porque está vinculada a los "
"asientos contables de varias cuentas diferentes."

