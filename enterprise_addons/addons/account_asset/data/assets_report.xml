            <record id="assets_report_balance" model="account.report.column">
                <field name="name">book_value</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="depreciation_schedule_line" model="account.report.line">
                <field name="name">Depreciation Schedule</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="depreciation_schedule_line_acquisition_date" model="account.report.expression">
