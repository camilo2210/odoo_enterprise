<?xml version="1.0"?>
<odoo>
    <record id="payroll_overwrite_employee_declaration_view_form" model="ir.ui.view">
        <field name="name">payroll.overwrite.employee.declaration.form</field>
        <field name="model">payroll.overwrite.employee.declaration</field>
        <field name="arch" type="xml">
            <form string="File(s) already exist">
                <div class="alert alert-warning" role="alert">
                    The following file(s) already exist. Do you want to overwrite them?
                </div>
                
                <field name="declaration_ids" readonly ="1" >
                    <list class="pe-none">
                        <field name="employee_id"/>
                        <field name="pdf_filename" string="File Name"/>
                    </list>
                </field>
                <footer>
                    <button name="action_overwrite" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
