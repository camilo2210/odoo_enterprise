<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_partner_view_form_inherit_account_direct_debit" model="ir.ui.view">
            <field name="name">res.partner.view.form.inherit.account_direct_debit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button"
                            groups="account.group_account_invoice"
                            name="action_open_mandates"
                            type="object"
                            icon="edit_square"
                            help="Open this partner's mandates"
                            title="Direct Debit Mandates">
                        <field string="Direct Debit Mandates" name="mandate_count" widget="statinfo"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
