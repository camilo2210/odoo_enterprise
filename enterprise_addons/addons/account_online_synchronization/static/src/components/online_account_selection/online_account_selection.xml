<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_online_synchronization.OnlineAccountSelection">
        <div class="o_odoofin_account_selection d-flex flex-column gap-1">
            <t t-foreach="this.accountOnlineAccounts" t-as="account" t-key="account_index">
                <button t-att-class="{ 'disabled': this.state.loading }" t-att-disabled="this.state.loading" class="p-0 card shadow-sm cursor-pointer" t-on-click="() => this.connectAccount(account)">
                    <div class="card-body o-card-body p-2 d-flex justify-content-between align-content-center">
                        <div>
                            <div class="card-title fw-bold text-start" t-out="account.display_name"/>
                            <div class="card-text text-muted text-start" t-out="account?.account_number"/>
                        </div>
                        <div t-att-class="account?.balance &lt; 0 ? 'text-danger' : ''"
                             t-out="this.formattedBalance(account)"/>
                    </div>
                </button>
            </t>
        </div>
    </t>
</templates>
