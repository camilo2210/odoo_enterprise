<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr_payroll.PayslipShowAllToggle">
        <div class="form-check form-switch">
            <input
                type="checkbox"
                class="form-check-input"
                role="switch"
                t-att-checked="this.state.showAll"
                t-on-change="this.toggle"
            />
        </div>
    </t>
</odoo>
