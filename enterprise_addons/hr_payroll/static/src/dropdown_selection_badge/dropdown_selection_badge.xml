<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_payroll.DropdownSelectionBadge">
        <t t-if="this.canEditAny">
            <Dropdown>
                <button
                    t-attf-class="btn btn-link rounded-pill text-nowrap {{ this.additionalClassName }} {{ this.getDropdownButtonDecoration(this.value) }}"
                    style="min-width: 10ch; min-height: 2.5em;"
                    t-on-mouseenter="() => this.onBadgeHover()"
                    t-on-mouseleave="() => this.onBadgeLeave()"
                >
                    <i class="oi m-1" t-if="this.showIcon" t-att-class="this.getIconClass(this.value)" t-att-data-icon="this.getIcon(this.value)"/>
                    <t t-out="this.display"/>
                </button>
                <t t-set-slot="content">
                    <t t-if="this.editableOptions.includes(false)">
                        <DropdownItem
                            class="'o_dropdown_selection_badge_dropdown_item'"
                            t-if="!this.required || !this.value"
                            t-out="this.props.placeholder || ''"
                            onSelected="() => this.onChange(false)"
                        />
                    </t>
                    <t t-foreach="this.options" t-as="option" t-key="option[0]">
                        <t t-if="this.editableOptions.includes(option[0])">
                            <DropdownItem
                                class="'d-flex text-black align-items-center o_dropdown_selection_badge_dropdown_item'"
                                onSelected="() => this.onChange(option[0])"
                            >
                                <div class="oi oi-fw me-1" t-att-class="this.getDropdownItemDecoration(option[0]) + ' ' + this.getIconClass(option[0])" t-att-data-icon="this.getIcon(option[0])"/>
                                <span t-out="option[1]"/>
                            </DropdownItem>
                        </t>
                    </t>
                </t>
            </Dropdown>
        </t>
        <t t-else="">
            <button
                t-if="this.value"
                tabindex="-1"
                t-attf-class="btn btn-link rounded-pill text-nowrap cursor-default {{ this.additionalClassName }} {{ this.getDropdownButtonDecoration(this.value) }}"
                style="min-width: 10ch; min-height: 2.5em;"
                t-on-click.stop.prevent="() => {}"
                t-on-mouseenter="() => this.onBadgeHover()"
                t-on-mouseleave="() => this.onBadgeLeave()"
            >
                <i class="oi m-1" t-if="this.showIcon" t-att-class="this.getIconClass(this.value)" t-att-data-icon="this.getIcon(this.value)"/>
                <t t-out="this.display"/>
            </button>
        </t>
    </t>

</templates>
