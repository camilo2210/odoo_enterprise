<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="hr_holidays_gantt.AvatarCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_avatar_card_leave_summary')]" position="after">
            <div class="o_avatar_card_benefits_summary px-3 pb-2 d-flex flex-column rounded-bottom bg-100">
                <t t-if="this.state.benefits.length">
                    <span class="fw-bold mt-2">Benefits</span>
                    <table class="mt-1 w-100">
                        <t t-foreach="this.state.benefits" t-as="benefit" t-key="benefit.id">
                            <tr>
                                <td class="text-muted pe-2" t-out="benefit.name"/>
                                <td t-out="benefit.value"/>
                            </tr>
                        </t>
                    </table>
                </t>
            </div>
        </xpath>
    </t>
</templates>
