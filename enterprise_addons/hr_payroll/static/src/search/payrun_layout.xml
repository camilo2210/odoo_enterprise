<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr_payroll.PayRunLayout" t-inherit="web.Layout" t-inherit-mode="primary">
        <main position="attributes">
            <attribute name="t-attf-class">{{this.props.className}} d-flex</attribute>
        </main>
        <main position="inside">
            <div t-if="this.payRunChatter?.visible() and this.payRunChatter?.payslipRunId and !this.uiService.isSmall and !this.env.inDialog"
                 class="o_payrun_chatter_container overflow-auto shrink-0 o-mail-ChatterContainer o-aside d-flex flex-column border-start">
                <Chatter t-props="this.payRunChatter.chatterProps"/>
            </div>
        </main>
    </t>
</templates>
