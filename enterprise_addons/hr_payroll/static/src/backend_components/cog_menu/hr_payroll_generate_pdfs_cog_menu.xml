<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_payroll.GeneratePdfsCogMenu">
        <span t-if="this.draftRecords()" t-on-mouseenter="this.highlightDraftRecords" t-on-mouseleave="this.unhighlightDraftRecords">
            <DropdownItem onSelected.bind="this.generatePdfs">
                <i class="oi oi-fw" data-icon="progress_activity"/> Generate PDFs
            </DropdownItem>
        </span>
    </t>
</templates>
