<template>
    <t t-name="hr_payroll.PayrollWarningCard">
        <div
            class="o_payroll_warning_card d-flex flex-grow-1 flex-column flex-md-row gap-2 align-items-md-center rounded p-3 bg-view"
            t-attf-class="border-#{this.props.colorClass}"
        >
            <div class="flex-grow-1">
                <h2
                    class="h5 mb-0"
                    t-attf-class="{{this.props.colorClass != 'light' ? `text-${this.props.colorClass}-emphasis` : ''}}"
                >
                    <span t-if="this.props.isError" class="me-1">
                        <i class="oi" data-icon="warning"/>
                    </span>
                    <span t-elif="this.props.isLoading" class="o_payroll_warning_count_placeholder me-1">
                        <i class="oi oi-spin" data-icon="autorenew"/>
                    </span>
                    <t t-elif="this.props.count !== undefined and this.props.count !== 0">
                        <span t-out="this.props.count" class="pe-1"/>
                    </t>
                    <t t-out="this.props.title"/>
                </h2>
                <span
                    t-if="this.props.structureTypeSuffix"
                    class="ms-1 fst-italic text-muted"
                >
                    (<t t-out="this.props.structureTypeSuffix"/>)
                </span>
                <span
                    t-if="this.props.description"
                    t-out="this.props.description"
                    class="d-inline-block mt-1"
                    t-attf-class="{{this.props.colorClass != 'light' ? `text-${this.props.colorClass}-emphasis` : ''}}"
                />
            </div>
            <button
                class="btn text-nowrap"
                t-attf-class="{{this.props.colorClass == 'warning' or this.props.colorClass == 'danger' ? 'btn-primary' : 'btn-secondary'}}"
                t-att-disabled="this.props.isLoading"
                t-on-click.stop.prevent="this.doButtonAction"
            >
                <t t-out="this.props.buttonName"/>
            </button>
        </div>
    </t>
</template>
