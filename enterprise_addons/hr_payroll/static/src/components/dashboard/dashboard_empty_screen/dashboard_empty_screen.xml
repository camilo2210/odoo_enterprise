<?xml version="1.0" encoding="utf-8"?>
<template>
    <t t-name="hr_payroll.DashboardEmptyScreen">
        <div class="h-100 d-flex flex-column align-items-center justify-content-center">
            <div class="d-flex flex-column align-items-center text-center">
                <h2>All done 👏</h2>
                <t t-foreach="this.props.closingDatesData" t-as="data" t-key="data.schedule">
                    <span>
                        The next <t t-out="data.label"/> is scheduled on <t t-out="this.formatClosingDate(data.closing_date)"/>
                    </span>
                </t>
                <div name="action_buttons">
                    <button name="all_payslips" class="btn btn-secondary mt-2" t-on-click="this.gotoAllPayslips">
                        All Payslips
                    </button>
                </div>
            </div>
        </div>
    </t>
</template>
