<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="hr_payroll.PayrunStartWarningDialog">
        <Dialog size="'md'" title.translate="Before You Start">
            <div t-foreach="this.props.warnings" t-as="warning" t-key="warning_index"
                 class="d-flex justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
                <div>
                    <div class="fw-bold" t-out="warning.title"/>
                    <p class="text-prewrap text-muted mb-0" t-out="warning.body"/>
                </div>
                <button class="btn btn-primary text-nowrap"
                        t-on-click="() => this.onReviewClick(warning.reviewAction)"
                        t-out="warning.reviewLabel"/>
            </div>
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <div class="fw-bold">Generate</div>
                    <p class="text-prewrap text-muted mb-0">Draft payslips can still be generated. As long as they are in draft, they will auto-update along your validations.</p>
                </div>
                <button class="btn btn-primary text-nowrap" t-on-click="this.onGenerateClick">Generate Payslips</button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="this.onDiscardClick">Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
