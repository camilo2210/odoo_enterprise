<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_payroll.PayrollHolidaysGanttRenderer.RowHeader" t-inherit="hr.HrGanttRenderer.RowHeader">
        <xpath expr="//div[hasclass('o_gantt_row_title')]" position="attributes">
            <attribute name="t-on-click">() => this.onRowHeaderClicked(row)</attribute>
        </xpath>
        <xpath expr="//span[hasclass('o_gantt_row_title_label')]" position="attributes">
            <attribute name="t-att-data-tooltip"/>
        </xpath>
    </t>
</templates>
