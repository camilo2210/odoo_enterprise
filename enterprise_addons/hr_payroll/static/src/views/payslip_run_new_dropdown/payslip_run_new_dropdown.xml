<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hr_payroll.PayrunNewDropdown">
        <Dropdown>
            <button class="btn btn-primary dropdown-toggle o_list_button_add o-dropdown-caret">
                New
            </button>
            <t t-set-slot="content">
                <DropdownItem tag="'button'" class="'btn btn-link'" onSelected="this.props.onCreatePayslip">
                    Payslip
                </DropdownItem>
                <DropdownItem tag="'button'" class="'btn btn-link'" onSelected="this.props.onCreatePayRun">
                    Pay Run
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
