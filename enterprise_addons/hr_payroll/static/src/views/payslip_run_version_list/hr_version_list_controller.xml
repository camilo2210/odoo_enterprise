<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr_payroll.VersionPayrunListController.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-if="this.env.inDialog">
                <button class="btn btn-primary" t-on-click="this.onSelect" t-att-disabled="this.model.root.selection.length &lt; 1 || this.state.disabled">
                    Select
                </button>
                <button class="btn btn-secondary" t-on-click="this.onCreateEmployee">
                    Create
                </button>
                <button class="btn btn-secondary" t-on-click="this.onBack" t-if="!this.props.context.active_id">
                    Back
                </button>
                <button class="btn btn-secondary" t-on-click="this.onClose" t-else="">
                    Discard
                </button>
            </t>
        </xpath>
    </t>
    <t t-name="hr_payroll.VersionPayrunListController" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_selection_container')]" position="attributes">
            <attribute name="class" add="position-static" remove="m-1" separator=" "/>
        </xpath>
    </t>
</templates>
