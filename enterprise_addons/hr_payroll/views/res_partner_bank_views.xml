<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payroll.res_partner_bank_view_search" model="ir.ui.view">
        <field name="name">res.partner.bank.view.search.hr_payroll</field>
        <field name="model">res.partner.bank</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_number"/>
                <filter string="Holder" name="holder" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="hr_payroll.res_partner_bank_view_list" model="ir.ui.view">
        <field name="name">res.partner.bank.view.list.hr_payroll</field>
        <field name="model">res.partner.bank</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="account_number"/>
                <field name="allow_out_payment"/>
            </list>
        </field>
    </record>

    <record id="res_partner_bank_view_accounts_list_hr_payroll" model="ir.ui.view">
        <field name="name">res.partner.bank.view.accounts.list.hr_payroll</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holder_name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_untrusted_bank_accounts" model="ir.actions.act_window">
        <field name="name">Untrusted Bank Accounts</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="res_partner_bank_view_accounts_list_hr_payroll"/>
    </record>
</odoo>
