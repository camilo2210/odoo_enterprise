<?xml version="1.0"?>
<odoo>
<template id="report_payslip">
    <t t-call="web.external_layout">
        <div class="page">
            <h2 id="payslip_name"><span t-field="o.name">August 2023 Payslip</span></h2>
            <t t-set="is_invalid" t-value="o._is_invalid()"/>
            <t t-set="is_correction" t-value="o.is_correction_payslip"/>
            <t t-if="is_correction">
                <t t-set="orig_lines_by_code" t-value="{l.code: l for l in o.origin_payslip_id.line_ids}"/>
                <t t-set="orig_wd_by_type" t-value="{wd.work_entry_type_id.id: wd for wd in o.origin_payslip_id.worked_days_line_ids}"/>
            </t>
            <div t-if="is_invalid">
                <div class="text-center alert alert-warning">This payslip is draft. This is not a legal document.</div>
            </div>
            <div t-else="">
                <div class="oe_structure"></div>
            </div>
            <div id="infos_table">
                <table class="table table-sm table-borderless">
                    <thead class="o_black_border">
                        <tr>
                            <th>Employee Information</th>
                            <th class="w-50">Other Information</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="employee_infos">
                                <div id="employee_name">
                                    <strong class="me-2">Name:</strong>
                                    <span t-field="o.employee_id.legal_name"/>
                                </div>
                                <div id="employee_id">
                                    <strong class="me-2">ID:</strong>
                                    <span t-if="o.version_id.identification_id" t-field="o.version_id.identification_id"/>
                                    <span t-else="" class="fw-bold">No ID number on the employee</span>
                                </div>
                                <div id="employee_email" t-if="o.employee_id.work_email">
                                    <strong class="me-2">Email:</strong>
                                    <span t-field="o.employee_id.work_email"/>
                                </div>
                                <div id="employee_job_position" t-if="o.version_id.job_id">
                                    <strong class="me-2">Job Position:</strong>
                                    <span t-field="o.version_id.job_id"/>
                                </div>
                                <div id="employee_department" t-if="o.version_id.department_id">
                                    <strong class="me-2">Department:</strong>
                                    <span t-field="o.version_id.department_id"/>
                                </div>
                                <div id="employee_marital">
                                    <strong class="me-2">Marital Status:</strong>
                                    <span t-field="o.version_id.marital"/>
                                </div>
                                <div id="employee_person_in_charge" t-if="o.version_id.children">
                                    <strong class="me-2">Children:</strong>
                                    <span t-field="o.version_id.children"/>
                                </div>
                                <div id="employee_private_address" t-if="o.version_id.private_street and o.version_id.private_city">
                                    <strong class="me-2">Address:</strong>
                                    <span t-field="o.version_id.private_street"/>,
                                    <span t-field="o.version_id.private_street2" t-if="o.version_id.private_street2" class="ms-2"/><span t-if="o.version_id.private_street2">,</span>
                                    <span t-field="o.version_id.private_city" class="ms-2"/>
                                    <span t-field="o.version_id.private_zip"/>
                                    <span t-field="o.version_id.private_country_id"/>
                                </div>
                            </td>
                            <td id="other_infos">
                                <div id="wage" t-if="not o.struct_id.hide_basic_on_pdf">
                                    <strong class="me-2">Contract Wage (<span class="text-capitalize" t-out="o.version_id.schedule_pay if o.version_id.wage_type == 'monthly' else o.version_id.wage_type"/>):</strong>
                                    <span t-out="o.version_id._get_contract_wage()" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}" class="fw-bold"/>
                                </div>
                                <div invisible="1">
                                    <t t-if="o.version_id.contract_date_end and o.date_to &gt; o.version_id.contract_date_end" t-set="end_date" t-value="o.version_id.contract_date_end"/>
                                    <t t-else="" t-set="end_date" t-value="o.date_to"/>
                                </div>
                                <div id="pay_period">
                                    <strong class="me-2">Pay Period:</strong>
                                    <span t-if="o.version_id.contract_date_start and o.date_from &lt; o.version_id.contract_date_start" t-field="o.version_id.contract_date_start"/>
                                    <span t-else="" t-field="o.date_from"/>
                                    -
                                    <span t-out="end_date" t-options="{'widget': 'date'}"/>
                                </div>
                                <div id="computed_on">
                                    <strong class="me-2">Computed On:</strong>
                                    <span t-field="o.compute_date"/>
                                </div>
                                <div id="contract_start">
                                    <strong class="me-2">Entry Date:</strong>
                                    <span id="entry_date" t-out="o.version_id.employee_id._get_first_contract_date(end_date)" t-options="{'widget': 'date'}"/>
                                </div>
                                <div t-if="o.version_id.departure_date and o.date_to &gt; o.version_id.departure_date"  id="departure_date">
                                    <strong class="me-2">Departure Date:</strong>
                                    <span t-out="o.version_id.departure_date" t-options="{'widget': 'date'}"/>
                                </div>
                                <div id="contract_type" t-if="o.version_id.employee_type_id">
                                    <strong class="me-2">Contract Type:</strong>
                                    <span t-field="o.version_id.employee_type_id"/>
                                </div>
                                <div id="working_schedule">
                                    <strong class="me-2">Working Schedule:</strong>
                                    <span t-out="('%.2f' % o.version_id.resource_calendar_id.hours_per_week).rstrip('0').rstrip('.')"/> Hours / Week
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div id="worked_days_table" t-if="not o.ignore_worked_day_lines and not o.is_company_executive">
                <table class="table table-sm table-borderless">
                <t t-set="worked_days_lines" t-value="o.worked_days_line_ids.filtered(lambda worked_days: worked_days.code != '000.00')"/>
                <!-- TODO master: remove show_days and show_hours, kept for inheriting templates -->
                <t t-set="show_days" t-value="True"/>
                <t t-set="show_hours" t-value="True"/>
                    <thead class="o_black_border">
                        <tr>
                            <th id="work_days_header_name">Earnings</th>
                            <th id="work_days_header_hours" class="text-end">Hours</th>
                            <th id="work_days_header_days" class="text-end">Days</th>
                            <th id="work_days_header_amount" class="text-end">Amount</th>
                            <th id="work_days_header_ytd" t-if="o.ytd_computation and not is_correction" class="text-end">YTD</th>
                        </tr>
                    </thead>
                    <tbody id="worked_days_lines">
                        <span t-foreach="worked_days_lines" t-as="worked_days">
                            <t t-if="is_correction">
                                <t t-set="orig_wd" t-value="orig_wd_by_type.get(worked_days.work_entry_type_id.id)"/>
                                <t t-set="disp_hours" t-value="worked_days.number_of_hours - (orig_wd.number_of_hours if orig_wd else 0.0)"/>
                                <t t-set="disp_days" t-value="worked_days.number_of_days - (orig_wd.number_of_days if orig_wd else 0.0)"/>
                                <t t-set="disp_amount" t-value="worked_days.amount - (orig_wd.amount if orig_wd else 0.0)"/>
                            </t>
                            <t t-else="">
                                <t t-set="disp_hours" t-value="worked_days.number_of_hours"/>
                                <t t-set="disp_days" t-value="worked_days.number_of_days"/>
                                <t t-set="disp_amount" t-value="worked_days.amount"/>
                            </t>
                            <tr style="color:none">
                                <td id="worked_days_name"><span t-field="worked_days.name"/></td>
                                <td id="worked_days_hours" class="text-end">
                                    <span t-out="round(disp_hours, 2)" t-options="{'widget': 'float_time'}"/>
                                </td>
                                <td id="worked_days_days" class="text-end">
                                    <span t-out="round(disp_days, 2)"/>
                                </td>
                                <td id="worked_days_amount" class="text-end"><span t-out="disp_amount" digits="[42, 2]"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td id="worked_days_ytd" t-if="o.ytd_computation and not is_correction" class="text-end">
                                    <span t-out="worked_days.ytd"
                                        t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                </td>
                            </tr>
                        </span>
                        <span>
                            <t t-set="line_class" t-value="'o_total o_border_bottom fw-bold'"/>
                            <t t-if="is_correction">
                                <t t-set="total_wd_hours" t-value="sum((wd.number_of_hours - (orig_wd_by_type.get(wd.work_entry_type_id.id).number_of_hours if orig_wd_by_type.get(wd.work_entry_type_id.id) else 0.0)) for wd in worked_days_lines)"/>
                                <t t-set="total_wd_days" t-value="sum((wd.number_of_days - (orig_wd_by_type.get(wd.work_entry_type_id.id).number_of_days if orig_wd_by_type.get(wd.work_entry_type_id.id) else 0.0)) for wd in worked_days_lines)"/>
                                <t t-set="total_wd_amount" t-value="sum((wd.amount - (orig_wd_by_type.get(wd.work_entry_type_id.id).amount if orig_wd_by_type.get(wd.work_entry_type_id.id) else 0.0)) for wd in worked_days_lines)"/>
                            </t>
                            <t t-else="">
                                <t t-set="total_wd_hours" t-value="sum(worked_days_lines.mapped('number_of_hours'))"/>
                                <t t-set="total_wd_days" t-value="sum(worked_days_lines.mapped('number_of_days'))"/>
                                <t t-set="total_wd_amount" t-value="sum(worked_days_lines.mapped('amount'))"/>
                            </t>
                            <tr style="color:none">
                                <td t-att-class="line_class">
                                    <span>Total</span>
                                </td>
                                <td id="worked_days_total_hours" t-attf-class="#{line_class} text-end">
                                    <span t-out="round(total_wd_hours, 2)" t-options="{'widget': 'float_time'}"/>
                                </td>
                                <td id="worked_days_total_days" t-attf-class="#{line_class} text-end">
                                    <span t-out="round(total_wd_days, 2)"/>
                                </td>
                                <td id="worked_days_total_amount" t-attf-class="#{line_class} text-end">
                                    <span t-out="total_wd_amount" digits="[42, 2]"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                                <td id="worked_days_total_ytd" t-if="o.ytd_computation and not is_correction" t-attf-class="#{line_class} text-end">
                                    <span t-out="sum(worked_days_lines.mapped('ytd'))" digits="[42, 2]"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                            </tr>
                        </span>
                    </tbody>
                </table>
            </div>
            <div id="payslip_lines_table">
                <table class="table table-sm table-borderless">
                    <thead class="o_black_border">
                        <tr>
                            <th id="line_header_name">Name</th>
                            <th id="line_header_amount" class="text-end">Amount</th>
                            <th id="line_header_quantity" class="text-end">Quantity</th>
                            <th id="line_header_rate" class="text-end">Rate</th>
                            <th id="line_header_total" class="text-end">Total</th>
                            <th id="line_header_ytd" class="text-end" t-if="o.ytd_computation and not is_correction">YTD</th>
                        </tr>
                    </thead>
                    <tbody id="payslip_lines">
                        <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip in ('always', 'non_zero'))" t-as="line">
                            <t t-if="is_correction">
                                <t t-set="orig_line" t-value="orig_lines_by_code.get(line.code)"/>
                                <t t-set="disp_total" t-value="line.total - (orig_line.total if orig_line else 0.0)"/>
                                <t t-set="delta_amount" t-value="line.amount - (orig_line.amount if orig_line else 0.0)"/>
                                <t t-set="delta_qty" t-value="line.quantity - (orig_line.quantity if orig_line else 0.0)"/>
                                <t t-set="delta_rate" t-value="line.rate - (orig_line.rate if orig_line else 0.0)"/>
                                <t t-set="single_change" t-value="[round(delta_amount,2)!=0, round(delta_qty,2)!=0, round(delta_rate,2)!=0].count(True)==1"/>
                                <t t-set="disp_amount" t-value="delta_amount if round(delta_amount,2) != 0 else line.amount"/>
                                <t t-set="disp_qty" t-value="delta_qty if round(delta_qty,2) != 0 else line.quantity"/>
                                <t t-set="disp_rate" t-value="delta_rate if round(delta_rate,2) != 0 else line.rate"/>
                            </t>
                            <t t-else="">
                                <t t-set="disp_total" t-value="line.total"/>
                                <t t-set="disp_amount" t-value="line.amount"/>
                                <t t-set="disp_qty" t-value="line.quantity"/>
                                <t t-set="disp_rate" t-value="line.rate"/>
                            </t>
                            <t t-if="not line.display_in_pdf_extra_info and (
                                      line.appears_on_payslip == 'always'
                                      or (line.appears_on_payslip == 'non_zero' and not is_correction and round(disp_amount, 2) != 0)
                                      or (line.appears_on_payslip == 'non_zero' and is_correction and disp_total != 0)
                                    )">
                                <t t-set="line_styling" t-value="line.get_payslip_styling_dict()"/>
                                <t t-set="line_style" t-value="line_styling['line_style']"/>
                                <t t-set="line_class" t-value="line_styling['line_class']"/>
                                <t t-set="o_title" t-value="line_styling['o_title']"/>
                                <tr id="line_display">
                                    <td id="payslip_line_name" t-att-class="line_class" t-attf-style="#{line_style} #{'border-right: none;' if line.salary_rule_id.title else ''}" t-att-colspan="99 if line.salary_rule_id.title else 1">
                                        <t t-set="is_invalid" t-value="o._is_invalid()"/>
                                        <span t-field="line.name" class="d-block"/>
                                        <span t-field="line.salary_rule_id.note" t-if="not is_html_empty(line.salary_rule_id.note)" t-attf-class="#{line_class} d-inline-block pb-0 mb-0 ps-1" style="max-width: 500px; font-size: 0.875em;"/>
                                    </td>
                                    <td id="payslip_line_amount" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-out="disp_amount"
                                            t-if="not line.hide_amount and ((is_correction and single_change) or (not is_correction and (disp_qty > 1 or line.rate &lt; 100)))"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                    <td id="payslip_line_quantity" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-if="(is_correction and single_change) or (not is_correction and disp_qty > 1)" t-out="round(disp_qty, 2)"/>
                                    </td>
                                    <td id="payslip_line_rate" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-if="(is_correction and single_change) or (not is_correction and line.rate &lt; 100)" t-out="str(round(disp_rate, 2)) + ' %'"/>
                                    </td>
                                    <td id="payslip_line_total" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-out="disp_total"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                    <td id="payslip_line_ytd" t-if="o.ytd_computation and not is_correction" t-attf-class="#{line_class} text-end #{o_title}" t-att-style="line_style">
                                        <span t-out="line.ytd"
                                            t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </span>
                    </tbody>
                </table>
                <div class="oe_structure"></div>
            </div>
            <div id="to_pay">
                <t t-set="net_to_pay" t-value="o.correction_net_delta if is_correction else o.net_wage"/>
                <t t-if="net_to_pay &gt;= 0">
                    <t t-set="payments" t-value="o.generate_payments_dict()"/>
                    <t t-foreach="payments" t-as="payment">
                        <t t-if="payment['amount'] &gt; 0">
                            <p>
                                Paid to
                                <span class="fw-bold"
                                    t-out="('X' * (len(payment['account_num']) - 4) + payment['account_num'][-4:])
                                            if payment['account_num'] else 'xxxxxxxxxxxx'"/>
                                <span t-out="payment['partner']"/>:
                                <span t-out="payment['amount']"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    class="fw-bold"/>
                                <br/>
                            </p>
                        </t>
                    </t>
                    <t t-if="not payments">
                        Amount to be paid to <span class="fst-italic" t-field="o.employee_id.legal_name"/>: <span t-out="net_to_pay" t-options='{"widget": "monetary", "display_currency": o.currency_id}' class="fw-bold"/>
                    </t>
                </t>
                <p t-else="">
                    The net amount will be recovered from the first positive remuneration established after this.
                </p>
            </div>

            <t t-call="hr_payroll.report_payslip_extra_info"/>

            <div id="note" t-if="o.note" t-field="o.note" />
        </div>
    </t>
</template>

<template id="report_payslip_extra_info">
  <t t-set="extra_info_lines" t-value="o.line_ids.filtered_domain([('salary_rule_id.display_in_pdf_extra_info', '=', True)])"/>
  <t t-set="mapped_extra_info" t-value="[
      {
          'displayed_total': (line.total - (orig_lines_by_code.get(line.code).total if orig_lines_by_code.get(line.code) else 0.0)) if is_correction else line.total,
          'displayed_name': line.name,
          'appears_on_payslip': line.appears_on_payslip,
          'currency_id': line.currency_id,
      }
      for line in extra_info_lines
  ]"/>
  <t t-set="displayed_extra_info" t-value="[
      info for info in mapped_extra_info
      if info['appears_on_payslip'] == 'always' or (info['appears_on_payslip'] == 'non_zero' and info['displayed_total'] != 0)
  ]"/>

  <div t-if="displayed_extra_info" id='extra_info_table' style="margin-top: 20px;">
      <table class="table table-sm table-borderless">
          <thead>
              <tr>
                  <th>Additional Information</th>
                  <th/> <!-- table body will be in two columns -->
              </tr>
          </thead>
          <tbody>
            <t t-foreach="range(0, len(displayed_extra_info), 2)" t-as="i">
              <tr>
                <td>
                  <strong><t t-out="displayed_extra_info[i]['displayed_name']"/>:</strong>
                  <span
                    t-out="displayed_extra_info[i]['displayed_total']"
                    t-options="{'widget': 'monetary', 'display_currency': displayed_extra_info[i]['currency_id']}"
                  />
                </td>
                <td t-if="i + 1 &lt; len(displayed_extra_info)">
                  <strong><t t-out="displayed_extra_info[i + 1]['displayed_name']"/>:</strong>
                  <span
                    t-out="displayed_extra_info[i + 1]['displayed_total']"
                    t-options="{'widget': 'monetary', 'display_currency': displayed_extra_info[i + 1]['currency_id']}"
                  />
                </td>
              </tr>
            </t>
          </tbody>
      </table>
  </div>
</template>

<template id="report_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="hr_payroll.report_payslip"/>
        </t>
    </t>
</template>
</odoo>
