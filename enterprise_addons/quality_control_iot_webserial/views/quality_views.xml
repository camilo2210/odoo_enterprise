<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_point_view_form_inherit_quality_iot_webserial" model="ir.ui.view">
        <field name="name">quality.point.view.form.inherit.quality.iot_webserial</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='failure_location_ids']" position="after">
                <div colspan="2">
                    <widget name="iot_webserial.connect_web_serial_scale" invisible="test_type != 'measure' or norm_unit != 'kg'"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
