<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_config_settings_view_form" model="ir.ui.view">
        <field name="name">payroll.config.settings.form.inherit.l10n_vn_hr_payroll</field>
        <field name="model">payroll.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.payroll_config_settings_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_settings" position="after">
                <group name="l10n_vn_hr_payroll" string="Vietnam" invisible="country_code != 'VN'" groups="hr_payroll.group_hr_payroll_user">
                    <field name="l10n_vn_reduced_occupational_accident_rate"/>
                    <field name="l10n_vn_union_fund_rate"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
