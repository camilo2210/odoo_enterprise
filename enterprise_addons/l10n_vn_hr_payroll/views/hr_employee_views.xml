<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.l10n_vn_hr_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group string="Vietnamese Payroll" name="l10n_vn_payroll" invisible="company_country_code != 'VN'">
                    <field name="l10n_vn_pit_method" class="o_hr_narrow_field"/>
                    <field name="l10n_vn_dependants" class="o_hr_narrow_field"/>
                    <field name="l10n_vn_minimum_wage_region" string="Minimum Wage Zone" class="o_hr_narrow_field"/>
                    <field name="l10n_vn_union_member"/>
                    <field name="l10n_vn_insurance_exempt"/>
                    <field name="l10n_vn_net_salary"/>
                </group>
            </group>
            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="l10n_vn_tax_code" invisible="company_country_code != 'VN'"/>
            </xpath>
        </field>
    </record>
</odoo>
