<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_co_edi.dian_key_demo" model="certificate.key">
        <field name="name">DIAN Private Key</field>
        <field name="content" type="bytes" file="l10n_co_edi/demo/demo_key.pem"/>
        <field name="company_id" eval="ref('base.demo_company_co')"/>
    </record>

    <record id="l10n_co_edi.dian_certificate_demo" model="certificate.certificate">
        <field name="name">Demo DIAN Certificate</field>
        <field name="content" type="bytes" file="l10n_co_edi/demo/demo_cert.crt"/>
        <field name="private_key_id" ref="l10n_co_edi.dian_key_demo"/>
        <field name="company_id" eval="ref('base.demo_company_co')"/>
    </record>

    <record id="l10n_co_edi.dian_operation_mode_demo" model="l10n_co_edi.operation_mode">
        <field name="dian_software_id">Odoo</field>
        <field name="dian_software_operation_mode">invoice</field>
        <field name="dian_software_security_code">12345</field>
        <field name="dian_testing_id">TESTODOO</field>
        <field name="company_id" eval="ref('base.demo_company_co')"/>
    </record>

    <record id="l10n_co_edi.dian_operation_mode_demo_bill" model="l10n_co_edi.operation_mode">
        <field name="dian_software_id">Odoo</field>
        <field name="dian_software_operation_mode">bill</field>
        <field name="dian_software_security_code">12345</field>
        <field name="dian_testing_id">TESTODOO</field>
        <field name="company_id" eval="ref('base.demo_company_co')"/>
    </record>

    <record id="base.partner_demo_company_co" model="res.partner">
        <field name="city_id" eval="ref('l10n_co_edi.city_co_150')"/>
        <field name="l10n_co_edi_obligation_type_ids" eval="[(4, ref('l10n_co_edi.obligation_type_1'))]"/>
    </record>

    <record id="base.demo_company_co" model="res.company">
        <field name="vat">623456789-1</field>
        <field name="zip">11001</field>
        <field name="street">CL 12A</field>
        <field name="country_id" eval="ref('base.co')"/>
        <field name="state_id" eval="ref('base.state_co_03')"/>
        <field name="l10n_co_edi_operation_mode_ids" eval="[(4, ref('l10n_co_edi.dian_operation_mode_demo')), (4, ref('l10n_co_edi.dian_operation_mode_demo_bill'))]"/>
        <field name="l10n_co_edi_test_environment" eval="False"/>
        <field name="l10n_co_edi_demo_mode" eval="True"/>
        <field name="l10n_co_edi_certificate_ids" eval="[(4, ref('l10n_co_edi.dian_certificate_demo'))]"/>
        <field name="l10n_co_edi_header_actividad_economica">3100</field>
    </record>

    <function model="account.journal" name="l10n_co_edi_archive_demo_journals"/>

    <record id="l10n_co_edi.demo_client" model="res.partner">
        <field name="name">Hacienda Cafetalera Andina SAS</field>
        <field name="is_company" eval="True"/>
        <field name="street">CR 41 #8-78</field>
        <field name="country_id" ref="base.co"/>
        <field name="state_id" ref="base.state_co_03"/>
        <field name="city_id" ref="l10n_co_edi.city_co_150"/>
        <field name="zip">11001</field>
        <field name="vat">12345678-8</field>
        <field name="phone">+155555555555</field>
        <field name="email">cafetalera@andina.com</field>
        <field name="l10n_co_edi_obligation_type_ids" eval="[(4, ref('l10n_co_edi.obligation_type_5'))]"/>
        <field name="l10n_co_edi_fiscal_regimen">49</field>
        <field name="l10n_co_edi_commercial_name">Hacienda Andina</field>
    </record>
</odoo>
