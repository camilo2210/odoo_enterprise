<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_mantra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.mantra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="hr_attendance" position="inside">
                <block title="Mantra Webhook">
                    <setting string="Webhook URL" help="Use this URL in the Mantra device or middleware to post biometric punches.">
                        <field name="mantra_webhook_url" widget="CopyClipboardChar" class="w-100"/>
                        <button name="action_regenerate_mantra_webhook_token" type="object" string="Generate New Token" class="btn-link"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
