<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_gt_reports.L10nGtLibroReportFiltersCustomizable" t-inherit="account_reports.AccountReportFiltersCustomizable">
        <xpath expr="//div[@id='filter_variant']" position="after">
            <div class="acc_rep_filter_l10n_gt_libro_book">
                <t t-call="l10n_gt_reports.L10nGtLibroFilterBook"/>
            </div>
        </xpath>
    </t>

    <t t-name="l10n_gt_reports.L10nGtLibroFilterBook">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="oi me-1" data-icon="book"/>Book: <t t-out="this.l10nGtLibroSelectedBook"/>
            </button>

            <t t-set-slot="content">
                <t t-foreach="Object.entries(this.l10nGtLibroBooks)" t-as="book" t-key="book[0]">
                    <DropdownItem
                        class="{ 'selected': book[0] === this.controller.cachedFilterOptions().l10n_gt_libro_book }"
                        onSelected="() => this.selectL10nGtLibroBook(book[0])"
                    >
                        <t t-out="book[1]"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
