<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="kr_tax_return_type" model="account.return.type">
            <field name="name">VAT Return</field>
            <field name="name@kr">부가세 신고</field>
            <field name="report_id" ref="l10n_kr.l10n_kr_general_tp_vat"/>
            <field name="country_id" ref="base.kr" />
            <field name="default_deadline_periodicity">trimester</field>
        </record>

        <record id="kr_simplified_tax_return_type" model="account.return.type">
            <field name="name">VAT Return (Simplified Taxpayer)</field>
            <field name="name@kr">부가세 신고 (간이과세자)</field>
            <field name="report_id" ref="l10n_kr.l10n_kr_simplified_tp_vat"/>
            <field name="country_id" ref="base.kr" />
            <field name="default_deadline_periodicity">year</field>
            <field name="active_fallback">False</field>
        </record>
    </data>
</odoo>
