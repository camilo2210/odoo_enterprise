<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    The category structure is built to mimic the way IRD reports are built, and the payslips are
    set up in order to follow this structure.
    -->

    <!-- Basic & Gross Wages -->

    <record id="GROSS_CASH" model="hr.salary.rule.category">
        <field name="name">Gross - Cash</field>
        <field name="code">GROSS_CASH</field>
        <field name="parent_id" ref="hr_payroll.GROSS"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Taxable money that actually goes into the employee's bank account.</field>
    </record>

    <!-- Country specific BASIC that goes into the GROSS -->
    <record id="BASIC" model="hr.salary.rule.category">
        <field name="name">Basic</field>
        <field name="code">HK_BASIC</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="OVERSEAS_INCOME" model="hr.salary.rule.category">
        <field name="name">Oversea Income</field>
        <field name="code">OVERSEAS_INCOME</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.BASIC"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtPaidOverseaCo' in the IRD reports.</field>
    </record>

    <record id="OTHER_CASH_EARNINGS" model="hr.salary.rule.category">
        <field name="name">Other Cash Earnings</field>
        <field name="code">OTHER_CASH_EARNINGS</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="LEAVE_PAY" model="hr.salary.rule.category">
        <field name="name">Leave Encashment</field>
        <field name="code">LEAVE_PAY</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.OTHER_CASH_EARNINGS"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfLeavePay' in the IRD reports.</field>
    </record>

    <record id="DIRECTOR_FEE" model="hr.salary.rule.category">
        <field name="name">Director Fee</field>
        <field name="code">DIRECTOR_FEE</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfDirectorFee' in the IRD reports.</field>
    </record>

    <record id="BACKPAY" model="hr.salary.rule.category">
        <field name="name">Back-Payment</field>
        <field name="code">BACKPAY</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.OTHER_CASH_EARNINGS"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfBpEtc' in the IRD reports.</field>
    </record>

    <record id="RETIREMENT" model="hr.salary.rule.category">
        <field name="name">Retirement</field>
        <field name="code">RETIREMENT</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfPayRetire' in the IRD reports.</field>
    </record>

    <record id="PENSION" model="hr.salary.rule.category">
        <field name="name">Pension</field>
        <field name="code">PENSION</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfPension' in the IRD reports.</field>
    </record>

    <record id="EDUCATION" model="hr.salary.rule.category">
        <field name="name">Education</field>
        <field name="code">EDUCATION</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfEduBen' in the IRD reports.</field>
    </record>

    <record id="BONUS" model="hr.salary.rule.category">
        <field name="name">Bonus</field>
        <field name="code">BONUS</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfBonus' in the IRD reports.</field>
    </record>

    <record id="PILON" model="hr.salary.rule.category">
        <field name="name">Payment in Lieu of Notice</field>
        <field name="code">PILON</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfBpEtc' in the IRD reports.</field>
    </record>

    <record id="GROSS_NON_CASH" model="hr.salary.rule.category">
        <field name="name">Gross - Non Cash</field>
        <field name="code">GROSS_NON_CASH</field>
        <field name="parent_id" ref="hr_payroll.GROSS"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Taxable perks that are not paid out as cash.</field>
    </record>

    <record id="SHARE_OPTION" model="hr.salary.rule.category">
        <field name="name">Share Option</field>
        <field name="code">SHARE_OPTION</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_NON_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfGainShareOption' in the IRD reports.</field>
    </record>

    <record id="TAX_PAID" model="hr.salary.rule.category">
        <field name="name">Tax Paid By Employer</field>
        <field name="code">TAX_PAID</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.GROSS_NON_CASH"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfSalTaxPaid' in the IRD reports.</field>
    </record>

    <!-- Allowances -->

    <!-- We make a Hong Kong specific allowance so that we can set its parent to GROSS -->
    <record id="ALW" model="hr.salary.rule.category">
        <field name="name">Allowance</field>
        <field name="code">HK_ALW</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.OTHER_CASH_EARNINGS"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="COMMISSION" model="hr.salary.rule.category">
        <field name="name">Commission</field>
        <field name="code">COMMISSION</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.ALW"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfCommFee' in the IRD reports.</field>
    </record>

    <record id="ALLOWANCE_RAP" model="hr.salary.rule.category">
        <field name="name">Rewards, Allowances, and Perquisites</field>
        <field name="code">ALLOWANCE_RAP</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.ALW"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfOtherRAP' in the IRD reports.</field>
    </record>

    <record id="HOUSING_ALW" model="hr.salary.rule.category">
        <field name="name">Housing Allowance</field>
        <field name="code">HOUSING_ALW</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.ALW"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'PlaceOfResd' in the IRD reports.</field>
    </record>

    <!-- Post-accident earnings -->

    <record id="POST_ACCIDENT_EARNINGS" model="hr.salary.rule.category">
        <field name="name">Post Accident Earnings</field>
        <field name="code">POST_ACCIDENT_EARNINGS</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.OTHER_CASH_EARNINGS"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <!-- Non-Taxable -->

    <record id="NON_TAXABLE" model="hr.salary.rule.category">
        <field name="name">Non-Taxable</field>
        <field name="code">NON_TAXABLE</field>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="SLSP" model="hr.salary.rule.category">
        <field name="name">Severance/Long Service Payment</field>
        <field name="code">SLSP</field>
        <field name="country_id" ref="base.hk"/>
    </record>

    <!-- Deductions -->

    <record id="DED_AFTER_TAX" model="hr.salary.rule.category">
        <field name="name">Deduction After Tax</field>
        <field name="code">DED_AFTER_TAX</field>
        <field name="parent_id" ref="hr_payroll.DED"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="HOUSING_DED" model="hr.salary.rule.category">
        <field name="name">Housing Deduction</field>
        <field name="code">HOUSING_DED</field>
        <field name="parent_id" ref="hr_payroll.DED"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <!-- MPF -->

    <record id="MPF" model="hr.salary.rule.category">
        <field name="name">MPF</field>
        <field name="code">MPF</field>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="EEMPF" model="hr.salary.rule.category">
        <field name="name">Employee MPF</field>
        <field name="code">EEMPF</field>
        <field name="parent_id" ref="MPF" />
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="ERMPF" model="hr.salary.rule.category">
        <field name="name">Employer MPF</field>
        <field name="code">ERMPF</field>
        <field name="parent_id" ref="MPF" />
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="AUTOPAY" model="hr.salary.rule.category">
        <field name="name">Autopay</field>
        <field name="code">AUTOPAY</field>
        <field name="country_id" ref="base.hk"/>
    </record>

    <!-- Non-Employees & contractors -->

    <record id="FEE" model="hr.salary.rule.category">
        <field name="name">Fees and Remuneration</field>
        <field name="code">FEE</field>
        <field name="parent_id" ref="hr_payroll.GROSS"/>
        <field name="country_id" ref="base.hk"/>
    </record>

    <record id="FEE_SUBCON" model="hr.salary.rule.category">
        <field name="name">Subcontracting Fees</field>
        <field name="code">FEE_SUBCON</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfType1' in the IR56M report.</field>
    </record>

    <record id="FEE_COMMISSION" model="hr.salary.rule.category">
        <field name="name">Commission (Non-Employee)</field>
        <field name="code">FEE_COMMISSION</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfType2' in the IR56M report.</field>
    </record>

    <record id="FEE_WRITER" model="hr.salary.rule.category">
        <field name="name">Writer's / Contributor's Fees</field>
        <field name="code">FEE_WRITER</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfType3' in the IR56M report.</field>
    </record>

    <record id="FEE_ARTIST" model="hr.salary.rule.category">
        <field name="name">Artiste's Fees</field>
        <field name="code">FEE_ARTIST</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfArtistFee' in the IR56M report.</field>
    </record>

    <record id="FEE_ROYALTY" model="hr.salary.rule.category">
        <field name="name">Copyright / Royalties</field>
        <field name="code">FEE_ROYALTY</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfCopyright' in the IR56M report.</field>
    </record>

    <record id="FEE_CONSULT" model="hr.salary.rule.category">
        <field name="name">Consultancy / Management Fees</field>
        <field name="code">FEE_CONSULT</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfConsultFee' in the IR56M report.</field>
    </record>

    <record id="FEE_SERVICE" model="hr.salary.rule.category">
        <field name="name">Service Fees</field>
        <field name="code">FEE_SERVICE</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfServiceFee' in the IR56M report.</field>
    </record>

    <record id="FEE_OTHER" model="hr.salary.rule.category">
        <field name="name">Other Fees</field>
        <field name="code">FEE_OTHER</field>
        <field name="parent_id" ref="l10n_hk_hr_payroll.FEE"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfOtherInc' in the IR56M report.</field>
    </record>

    <record id="WITHHELD_DED" model="hr.salary.rule.category">
        <field name="name">Withheld Deduction</field>
        <field name="code">WITHHELD_DED</field>
        <field name="parent_id" ref="hr_payroll.DED"/>
        <field name="country_id" ref="base.hk"/>
        <field name="note">Maps to 'AmtOfSumWithheld' in the IR56M report.</field>
    </record>
</odoo>
