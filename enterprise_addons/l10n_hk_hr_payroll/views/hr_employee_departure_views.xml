<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_departure_wizard_view_form" model="ir.ui.view">
            <field name="name">hr.employee.departure.view.form.inherit.l10n_hk_hr_payroll</field>
            <field name="model">hr.employee.departure</field>
            <field name="inherit_id" ref="hr.hr_employee_departure_view_form"/>
            <field name="arch" type="xml">
                <field name="action_date" position="after">
                    <field name="l10n_hk_leaving_hk" invisible="country_code != 'HK'"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
