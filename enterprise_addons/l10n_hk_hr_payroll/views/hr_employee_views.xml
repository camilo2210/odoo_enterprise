<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.l10n_hk_hr_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_rentals" type="object" class="oe_stat_button" icon="home" invisible="country_code != 'HK'">
                    <field name="l10n_hk_rentals_count" widget="statinfo" string="Rentals"/>
                </button>
            </div>
            <label for="visa_no" position="before">
                <label for="l10n_hk_visa_issue_date" invisible="country_code != 'HK'"/>
                <div class="o_wrap_label d-flex flex-row gap-3 align-items-baseline" invisible="country_code != 'HK'">
                    <field name="l10n_hk_visa_issue_date"/>
                </div>
            </label>
            <group name="hr_birth_group" position="inside">
                <field name="l10n_hk_previous_employment_date" invisible="country_code != 'HK'"/>
            </group>
            <xpath expr="//page[@name='personal_information']/group" position="inside">
                <group string='Autopay' invisible="country_code != 'HK'">
                    <field name="l10n_hk_autopay_account_type" />
                    <field name="l10n_hk_autopay_svid"
                           placeholder="0240402"
                           invisible="l10n_hk_autopay_account_type != 'svid'"
                           required="l10n_hk_autopay_account_type == 'svid'"/>
                    <field name="l10n_hk_autopay_email"
                           placeholder="susan.wong@abc.com.hk"
                           invisible="l10n_hk_autopay_account_type != 'emal'"
                           required="l10n_hk_autopay_account_type == 'emal'"/>
                    <field name="l10n_hk_autopay_mobile"
                           placeholder="+852-92223333"
                           invisible="l10n_hk_autopay_account_type != 'mobn'"
                           required="l10n_hk_autopay_account_type == 'mobn'"/>
                    <field name="l10n_hk_autopay_ref" />
                </group>
            </xpath>
            <field name="private_email" position="before">
                <field name="l10n_hk_surname" invisible="country_code != 'HK'" />
                <field name="l10n_hk_given_name" invisible="country_code != 'HK'" />
                <field name="l10n_hk_name_in_chinese" invisible="country_code != 'HK'" />
            </field>
            <xpath expr="//page[@name='personal_information']//field[@name='spouse_birthdate']" position="after">
                <field name="l10n_hk_spouse_identification_id" invisible="country_code != 'HK' or marital not in ['married', 'cohabitant']" />
                <field name="l10n_hk_spouse_passport_id" invisible="country_code != 'HK' or marital not in ['married', 'cohabitant']" />
                <field name="l10n_hk_spouse_passport_place_of_issue" invisible="country_code != 'HK' or marital not in ['married', 'cohabitant']" />
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='passport_id']" position="after">
                <field name="l10n_hk_passport_place_of_issue" invisible="country_code != 'HK'" />
            </xpath>
            <div name="div_km_home_work" position="after">
                <label for="l10n_hk_has_postal_address" invisible="country_code != 'HK'"/>
                <div name="l10n_hk_postal_address" invisible="country_code != 'HK'">
                    <field name="l10n_hk_has_postal_address"/>
                    <div class="o_address_format" invisible="not l10n_hk_has_postal_address">
                        <field name="l10n_hk_postal_street" placeholder="Street..." class="o_address_street" required="country_code == 'HK' and l10n_hk_has_postal_address"/>
                        <field name="l10n_hk_postal_street2" placeholder="Street 2..." class="o_address_street"/>
                        <field name="l10n_hk_postal_city" placeholder="City" class="o_address_city"/>
                        <field name="l10n_hk_postal_state_id" class="o_address_state" placeholder="State"
                               required="country_code == 'HK' and l10n_hk_has_postal_address"
                               options='{"no_open": True, "no_create": True}'
                               context="{'default_country_id': l10n_hk_postal_country_id}"/>
                        <field name="l10n_hk_postal_zip" placeholder="ZIP" class="o_address_zip"/>
                        <field name="l10n_hk_postal_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                    </div>
                </div>
            </div>
            <group name="payroll_group" position="inside">
                <group name="mpf" string="MPF" invisible="country_code != 'HK'">
                    <field name="l10n_hk_mpf_exempt"/>
                    <field name="l10n_hk_mpf_scheme_id"/>
                    <field name="l10n_hk_mpf_account_number"/>
                    <field name="l10n_hk_payroll_group_id" required="l10n_hk_scheme_group_count &gt;= 2"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="l10n_hk_member_class_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="l10n_hk_mpf_registration_status" placeholder="Unregistered"/>
                    <field name="l10n_hk_mpf_contribution_start" invisible="l10n_hk_mpf_registration_status in [False, 'terminated']"
                           required="l10n_hk_mpf_registration_status in ['next_contribution', 'registered']"/>
                    <field name="l10n_hk_mpf_scheme_join_date"/>

                    <separator string="Benefits"/>
                    <label for="l10n_hk_internet" string="Internet Allowance"/>
                    <div class="o_row">
                        <field name="l10n_hk_internet" class="o_hr_narrow_field"/>
                        <span class="mx-2 text-muted">/</span>
                        <field name="schedule_pay" class="o_hr_narrow_field" nolabel="1" readonly="1"/>
                    </div>
                    <label for="l10n_hk_rental_id" invisible="not l10n_hk_rental_id"/>
                    <div class="o_row" invisible="not l10n_hk_rental_id">
                        <field name="l10n_hk_rental_id" readonly="1"/>
                    </div>
                    <field name="l10n_hk_rental_valid_up_to_date" readonly="1" invisible="not l10n_hk_rental_id"/>
                </group>
            </group>
            <field name="registration_number" position="after">
                <field name="l10n_hk_staff_number" invisible="country_code != 'HK'"/>
            </field>
            <field name="departure_action_date" position="after">
                <field name="l10n_hk_leaving_hk" invisible="country_code != 'HK'" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.l10n_hk_hr_payroll_empf</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="l10n_hk_mpf_scheme_id" optional="hide" options="{'no_create': True, 'no_open': True}"/>
                <field name="l10n_hk_payroll_group_id" optional="hide" options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>
</odoo>
