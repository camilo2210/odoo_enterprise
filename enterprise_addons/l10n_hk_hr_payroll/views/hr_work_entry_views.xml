<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_work_entry_type_view_form" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.inherit.l10n_hk_hr_payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_work_entry_type_view_form_inherit"/>
        <field name="arch" type="xml">
            <field name="round_days_type" position="after">
                <field name="l10n_hk_use_713"/>
            </field>
        </field>
    </record>
    <record id="hr_work_entry_type_view_form_leave" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.inherit.l10n_hk_hr_payroll.leave</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <field name="request_unit" position="after">
                <label for="l10n_hk_consecutive_days_limit_type" invisible="country_code and country_code != 'HK'"/>
                <div class="o_row" name="consecutive_limit" invisible="country_code and country_code != 'HK'">
                    <field name="l10n_hk_consecutive_days_limit_type" class="oe_inline o_hr_narrow_field" nolabel="1" placeholder="No Limit"/>
                    <field name="l10n_hk_consecutive_days_limit" class="oe_inline o_hr_narrow_field" nolabel="1" invisible="not l10n_hk_consecutive_days_limit_type"/>
                    <span invisible="not l10n_hk_consecutive_days_limit_type">Consecutive Days</span>
                </div>
            </field>
        </field>
    </record>
</odoo>
