<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_request_view_inherit_tree" model="ir.ui.view">
        <field name="name">sign.request.list.spreadsheet</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button type="object"
                    name="action_open_selected_requests_spreadsheet"
                    class="btn btn-secondary"
                    string="Export Answers"/>
            </xpath>

        </field>
    </record>
</odoo>
