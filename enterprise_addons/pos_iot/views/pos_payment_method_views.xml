<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_iot_payment_method_view_tree" model="ir.ui.view">
        <field name="name">pos.iot.payment.method.list</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='config_ids']" position="after">
                <field name="iot_device_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
