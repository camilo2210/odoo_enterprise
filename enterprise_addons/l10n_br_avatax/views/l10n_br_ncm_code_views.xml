<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_br_ncm_code_view_form" model="ir.ui.view">
        <field name="name">l10n_br_avatax.l10n_br.ncm.code.form</field>
        <field name="model">l10n_br.ncm.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="is_service"/>
                        <field name="ex" invisible="is_service"/>
                        <field name="l10n_br_cnae_code_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_ncm_code_view_list" model="ir.ui.view">
        <field name="name">l10n_br_avatax.l10n_br.ncm.code.list</field>
        <field name="model">l10n_br.ncm.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="ex"/>
                <field name="is_service" optional="show"/>
            </list>
        </field>
    </record>

    <record id="l10n_br_ncm_code_view_search" model="ir.ui.view">
        <field name="name">l10n_br_avatax.l10n_br.ncm.code.search</field>
        <field name="model">l10n_br.ncm.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="goods" string="Goods (NCM)" domain="[('is_service', '=', False)]"/>
                <filter name="services" string="Services (LC)" domain="[('is_service', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="l10n_br_ncm_code_action" model="ir.actions.act_window">
        <field name="name">NCM / LC Codes</field>
        <field name="res_model">l10n_br.ncm.code</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="l10n_br_ncm_code_view_list"/>
    </record>

    <menuitem id="ncm_codes_menu" name="NCM / LC Codes" action="l10n_br_ncm_code_action" parent="l10n_br.brazilian_accounting_menu"/>
</odoo>
