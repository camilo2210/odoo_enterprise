<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_br_operation_type_form" model="ir.ui.view">
            <field name="name">l10n_br.operation.type.form</field>
            <field name="model">l10n_br.operation.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="technical_name"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Issuer Options">
                                <group>
                                        <field name="l10n_br_issuer_manufacturer_industry_equivalent"/>
                                        <field name="l10n_br_issuer_appropriate_ipi_credit"/>
                                        <field name="l10n_br_issuer_not_subject_to_icmsst"/>
                                        <field name="l10n_br_issuer_is_icmsst_substitute"/>
                                        <field name="l10n_br_issuer_appropriate_icms_credit"/>
                                        <field name="l10n_br_issuer_appropriate_piscofins_credit"/>
                                </group>
                            </page>
                            <page string="Recipient Options">
                                <group>
                                    <field name="l10n_br_recipient_manufacturer_industry_equivalent"/>
                                    <field name="l10n_br_recipient_is_icmsst_substitute"/>
                                </group>
                            </page>
                            <page string="Product Options">
                                <group>
                                    <field name="l10n_br_source_origin"/>
                                    <field name="l10n_br_sped_type"/>
                                    <field name="l10n_br_use_type"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="l10n_br_operation_type_tree" model="ir.ui.view">
            <field name="name">l10n_br.operation.type.list</field>
            <field name="model">l10n_br.operation.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="technical_name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="l10n_br_operation_type_action" model="ir.actions.act_window">
            <field name="name">Operation Types</field>
            <field name="res_model">l10n_br.operation.type</field>
            <field name="context">{'active_test': False}</field>
        </record>

        <menuitem id="l10n_br_operation_type_menu"
                  parent="l10n_br.brazilian_accounting_menu"
                  action="l10n_br_avatax.l10n_br_operation_type_action"/>
    </data>
</odoo>
