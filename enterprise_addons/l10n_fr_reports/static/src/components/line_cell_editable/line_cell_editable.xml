<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportLineCellEditable"
       t-inherit="account_reports.AccountReportLineCellEditable"
       t-inherit-mode="extension">
        <xpath expr="//t[@data-id='date']" position="attributes">
            <attribute name="t-if" add="this.figureType() === 'datetime_year'" separator=" or "/>
        </xpath>
    </t>
</templates>
