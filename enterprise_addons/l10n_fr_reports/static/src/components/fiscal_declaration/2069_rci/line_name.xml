<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_fr_reports.L10nFr2069RciReportLineName" t-inherit="account_reports.AccountReportLineNameCustomizable">
        <xpath expr="//td[@data-id='line_name']/t[@data-id='content']" position="replace">
            <t t-if="this.props.line.code?.() === 'add_new_section'">
                <div class="clickable content" data-id="content" role="button" t-on-click="(ev) => this.controller.reportAction(ev, 'action_add_new_section', { line: this.controller.lines[this.props.lineIndex()] })">
                    <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                        name: this.props.line.name,
                        type: () => 'string',
                        maxCharacters: 80,
                    }"/>
                </div>
            </t>
            <t t-elif="this.props.line.code?.()?.includes('parent_section_line')">
                <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                    name: this.props.line.name,
                    type: () => 'string',
                    maxCharacters: 80,
                }"/>
                <i class="btn p-0 muted oi" data-icon="delete" t-on-click="(ev) => this.controller.reportAction(ev, 'action_remove_section', { line: this.controller.lines[this.props.lineIndex()] }, false, null, true)"/>
            </t>
            <t t-elif="this.props.line.code?.()?.includes('first_case_label') || this.props.line.code?.()?.includes('second_case_label')">
                <t t-component="this.controller.component('AccountReportEllipsis')" t-props="{
                    name: this.props.line.name,
                    type: () => 'string',
                    maxCharacters: 80,
                }"/>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
