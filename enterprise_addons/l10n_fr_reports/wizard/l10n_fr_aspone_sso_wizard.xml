<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="aspone_sso_wizard_form" model="ir.ui.view">
        <field name="name">l10n_fr_reports.aspone.sso.wizard.form</field>
        <field name="model">l10n_fr_reports.aspone.sso.wizard</field>
        <field name="arch" type="xml">
            <form string="Options">
                <sheet>
                    <p>Please fill in the information needed to create a Single Sign-On account on ASPOne</p>
                    <group>
                        <group string="Company">
                            <field name="siren" string="SIREN"/>
                            <field name="nic" string="NIC"/>
                            <field name="address_street_name" required="True" string="Street"/>
                            <field name="address_street_name2" string="Street 2"/>
                            <field name="address_city" required="True" string="City"/>
                            <field name="address_zip" required="True" string="Zip"/>
                            <field name="address_country_code" required="True" string="Country Code"/>
                        </group>
                        <group string="Subscriber">
                            <field name="subscriber_title" widget="radio" required="True" string="Title"/>
                            <field name="subscriber_firstname" required="True" string="Firstname"/>
                            <field name="subscriber_name" required="True" string="Lastname"/>
                            <field name="subscriber_email" required="True" string="Email"/>
                            <field name="subscriber_phone" required="True" string="Phone"/>
                        </group>
                        <group string="Technical Contact">
                            <field name="technical_contact_name" required="True" string="Name"/>
                            <field name="technical_contact_phone" required="True" string="Phone"/>
                            <field name="technical_contact_email" required="True" string="Email"/>
                        </group>
                        <group string="GDPR Contact">
                            <field name="gdpr_contact_firstname" required="True" string="Firstname"/>
                            <field name="gdpr_contact_name" required="True" string="Lastname"/>
                            <field name="gdpr_contact_function" required="True" string="Function"/>
                            <field name="gdpr_contact_email" required="True" string="Email"/>
                            <field name="gdpr_contact_phone" required="True" string="Phone"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Create account" name="create_sso_account" type="object" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="c"/>
                </footer>
           </form>
        </field>
    </record>
</odoo>
