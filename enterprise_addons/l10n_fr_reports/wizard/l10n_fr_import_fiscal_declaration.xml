<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_fiscal_declaration_form" model="ir.ui.view">
        <field name="name">l10n_fr.import.fiscal.declaration.view.form</field>
        <field name="model">l10n_fr.import.fiscal.declaration</field>
        <field name="arch" type="xml">
            <form string="Import Fiscal Declaration">
                <sheet>
                    <p class="text-muted">
                        If you do not have the template, download it, fill it out, and upload it.
                    </p>

                    <div class="mb-3">
                        <button name="action_download_template"
                                type="object"
                                string="Download Template"
                                class="btn-link p-0 o_form_label"/>
                    </div>
                    <group>
                        <field name="data" filename="filename" options="{'accepted_file_extensions': '.xlsx'}"/>
                        <field name="filename" invisible="1"/> <!-- The name is needed in the BinaryField component used to upload the file -->
                    </group>
                </sheet>
                <footer>
                    <button string="Upload" name="action_import_template" type="object" class="btn-primary"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
