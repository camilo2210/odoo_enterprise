<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vat_return_type" model="account.return.type">
            <field name="name">VAT</field>
            <field name="report_id" ref="l10n_fr_account.tax_report"/>
            <field name="country_id" ref="base.fr" />
            <field name="default_deadline_days_delay">19</field>
            <field name="states_workflow">generic_state_review_submit</field>
        </record>

        <record id="l10n_fr_fiscal_declaration_return_type" model="account.return.type">
            <field name="name">Fiscal Declaration</field>
            <field name="name@fr">Liasse Fiscale</field>
            <field name="report_id" ref="l10n_fr_reports.fiscal_declaration"/>
            <field name="states_workflow">generic_state_review_submit</field>
            <field name="default_deadline_periodicity">fiscalyear</field>
            <field name="country_id" ref="base.fr"/>
        </record>

        <record id="das2_return_type" model="account.return.type">
            <field name="name">DAS2</field>
            <field name="default_deadline_periodicity">year</field>
            <field name="report_id" ref="account_report_l10n_fr_das2_report"/>
            <field name="country_id" ref="base.fr" />
            <field name="states_workflow">generic_state_review_submit</field>
        </record>
    </data>
</odoo>
