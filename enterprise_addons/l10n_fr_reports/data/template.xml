<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aspone_xml_edi">
        <XmlEdi t-att-Test="is_test">
            <GroupeFonctionnel t-att-Type="type">
                <t t-foreach="declarations" t-as="decla">
                    <t t-call="l10n_fr_reports.aspone_declaration" vals="decla"/>
                </t>
            </GroupeFonctionnel>
        </XmlEdi>
    </template>

    <template id="aspone_declaration">
        <Declaration t-att-Type="vals['type']" t-att-Reference="vals['reference']">
            <t t-if="vals.get('emitor')">
                <Emetteur>
                    <t t-call="l10n_fr_reports.aspone_partner" vals="vals['emitor']"/>
                </Emetteur>
            </t>
            <Redacteur>
                <t t-call="l10n_fr_reports.aspone_partner" vals="vals['writer']"/>
            </Redacteur>
            <Redevable>
                <t t-call="l10n_fr_reports.aspone_partner" vals="vals['debtor']"/>
                <Rof t-out="vals['debtor']['rof']"/>
                <IdentifiantRedevable2 t-out="vals['debtor'].get('identifier2')"/>
                <SirenActivitePrincipale t-out="vals['debtor'].get('siren_principal_activity')"/>
            </Redevable>
            <t t-if="'edi_partner' in vals">
                <PartenaireEdi>
                    <t t-call="l10n_fr_reports.aspone_partner" vals="vals['edi_partner']"/>
                </PartenaireEdi>
            </t>
            <ListeDestinataires>
                <Destinataire>
                    <t t-foreach="vals['recipients']" t-as="recipient">
                        <t t-call="l10n_fr_reports.aspone_partner" vals="recipient"/>
                    </t>
                </Destinataire>
            </ListeDestinataires>
            <ListeFormulaires>
                <Identif t-att-Millesime="vals['identif']['millesime']"
                         t-att-Repetition="vals['identif'].get('repetition')">
                    <t t-foreach="vals['identif']['zones']" t-as="zone">
                        <t t-call="l10n_fr_reports.aspone_zone" vals="zone"/>
                    </t>
                </Identif>
                <t t-foreach="vals['forms']" t-as="form">
                    <Formulaire t-att-Nom="form['name']"
                                t-att-Millesime="form['millesime']"
                                t-att-Repetition="form.get('repetition')">
                        <t t-foreach="form['zones']" t-as="zone">
                            <t t-call="l10n_fr_reports.aspone_zone" vals="zone"/>
                        </t>
                    </Formulaire>
                </t>
            </ListeFormulaires>
        </Declaration>
    </template>

    <template id="aspone_partner">
        <Siret t-out="vals.get('siret')"/>
        <Identifiant t-out="vals.get('identifier')"/>
        <Designation t-out="vals.get('designation')"/>
        <DesignationSuite1 t-out="vals.get('designation_cont_1')"/>
        <DesignationSuite2 t-out="vals.get('designation_cont_2')"/>
        <t t-if="vals.get('address')">
            <Adresse>
                <t t-call="l10n_fr_reports.aspone_address" vals="vals['address']"/>
            </Adresse>
        </t>
        <ReferenceDossier t-out="vals.get('reference')"/>
    </template>

    <template id="aspone_address">
        <AdresseNumero t-out="vals.get('number')"/>
        <AdresseRepetabilite t-out="vals.get('repeatability')"/>
        <AdresseVoie t-out="vals.get('street')"/>
        <AdresseComplement t-out="vals.get('complement')"/>
        <AdresseHameau t-out="vals.get('hamlet')"/>
        <AdresseCodePostal t-out="vals.get('postal_code')"/>
        <AdresseVille t-out="vals.get('city')"/>
        <AdresseCodePays t-out="vals.get('country_code')"/>
    </template>

    <template id="aspone_zone">
        <Zone t-att-id="vals['id']">
            <t t-if="vals.get('occurences')">
                <t t-foreach="vals['occurences']" t-as="occurence">
                    <Occurrence t-att-Numero="occurence.get('occurence_number')">
                        <t t-call="l10n_fr_reports.aspone_zone_inner" vals="occurence"/>
                    </Occurrence>
                </t>
            </t>
            <t t-else="">
                <t t-call="l10n_fr_reports.aspone_zone_inner" vals="vals"/>
            </t>
        </Zone>
    </template>

    <template id="aspone_zone_inner">
        <!-- "Zone simple" -->
        <Valeur t-out="vals.get('value')"/>
        <Unite t-out="vals.get('unit')"/>
        <MonnaieCible t-out="vals.get('monnaie')"/>

        <!-- "Zone multiple NAD" -->
        <Identifiant t-out="vals.get('identifier')"/>
        <Designation t-out="vals.get('designation')"/>
        <DesignationSuite1 t-out="vals.get('designation_1')"/>
        <DesignationSuite2 t-out="vals.get('designation_2')"/>
        <t t-if="vals.get('address')">
            <t t-call="l10n_fr_reports.aspone_address" vals="vals['address']"/>
        </t>
        <Telephone t-out="vals.get('telephone')"/>
        <Email t-out="vals.get('email')"/>

        <!-- "Zone multiple FTX" -->
        <TexteLibre1 t-out="vals.get('ftx_1')"/>
        <TexteLibre2 t-out="vals.get('ftx_2')"/>
        <TexteLibre3 t-out="vals.get('ftx_3')"/>
        <TexteLibre4 t-out="vals.get('ftx_4')"/>
        <TexteLibre5 t-out="vals.get('ftx_5')"/>

        <!-- "Zone multiple FII" -->
        <Iban t-out="vals.get('iban')"/>
        <Bic t-out="vals.get('bic')"/>
        <Compte t-out="vals.get('account_number')"/>
        <Etablissement t-out="vals.get('bank_code')"/>
        <Agence t-out="vals.get('office_code')"/>
        <TitulaireDesignation t-out="vals.get('holder_name')"/>
        <TitulaireDesignationSuite t-out="vals.get('holder_name_2')"/>
    </template>
</odoo>
