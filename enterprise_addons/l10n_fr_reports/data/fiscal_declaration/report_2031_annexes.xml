                                        <field name="formula">l10n_fr_2031_annexes_i_furnished_social_loss.balance + l10n_fr_2031_annexes_i_other_furnished_loss.balance + l10n_fr_2031_annexes_i_lease_management_loss.balance + l10n_fr_2031_annexes_i_racehorse_loss.balance + l10n_fr_2031_annexes_i_other_non_prof_loss.balance</field>
