<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="l10n_fr_reports.fiscal_declaration" model="account.report">
        <field name="name">Fiscal Declaration</field>
        <field name="name@fr">Liasse Fiscale</field>
        <field name="custom_handler_model_id" ref="model_l10n_fr_reports_fiscal_declaration_handler"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="use_sections" eval="True"/>
        <field name="section_report_ids" eval="[
            Command.set([
                ref('l10n_fr_reports.l10n_fr_2033_A'),
                ref('l10n_fr_reports.l10n_fr_2033_B'),
                ref('l10n_fr_reports.l10n_fr_2033_C_1'),
                ref('l10n_fr_reports.l10n_fr_2033_C_2'),
                ref('l10n_fr_reports.l10n_fr_2033_D_1'),
                ref('l10n_fr_reports.l10n_fr_2033_D_2'),
                ref('l10n_fr_reports.l10n_fr_2033_E'),
                ref('l10n_fr_reports.l10n_fr_2033_F'),
                ref('l10n_fr_reports.l10n_fr_2033_G'),
                ref('l10n_fr_reports.l10n_fr_2031'),
                ref('l10n_fr_reports.l10n_fr_2031_annexes'),
                ref('l10n_fr_reports.l10n_fr_2065_SD'),
                ref('l10n_fr_reports.l10n_fr_2065_bis_SD'),
                ref('l10n_fr_reports.l10n_fr_2069_RCI'),
                ref('l10n_fr_reports.l10n_fr_2069_RCI_donations'),
            ])]"/>
    </record>

    <record id="action_account_report_l10n_fr_fiscal_declaration" model="ir.actions.client">
        <field name="name">Fiscal Declaration</field>
        <field name="path">l10n_fr-fiscal-declaration</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('l10n_fr_reports.fiscal_declaration')}" />
    </record>

    <record id="action_fiscal_declaration_menu_router" model="ir.actions.client">
        <field name="name">Fiscal Declaration</field>
        <field name="tag">l10n_fr_reports.fiscal_declaration_menu_router</field>
    </record>

    <menuitem
        id="menu_action_account_report_l10n_fr_fiscal_declaration"
        name="Fiscal Declaration"
        action="action_fiscal_declaration_menu_router"
        parent="l10n_fr_account.account_reports_fr_statements_menu"
    />
</odoo>
