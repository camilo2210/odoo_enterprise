<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_fr_reports" model="ir.ui.view">
        <field name="name">res.company.form.das2_activity</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_fr.res_company_form_l10n_fr"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ape']" position="after">
                <field
                    name="l10n_fr_das2_activity"
                    invisible="country_code != 'FR'"
                />
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="l10n_fr_rof_type" invisible="country_code != 'FR'"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_inherit_das2_required_fields" model="ir.ui.view">
        <field name="name">res.company.form.required.fields</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_fr.res_company_form_l10n_fr"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_fr_das2_activity']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ape']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
