<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="marketing_activity_view_search" model="ir.ui.view">
        <field name="name">marketing.activity.view.search.whatsapp</field>
        <field name="model">marketing.activity</field>
        <field name="inherit_id" ref="marketing_automation.marketing_activity_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mass_mailing_id']" position="after">
                <field name="whatsapp_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="marketing_activity_view_form" model="ir.ui.view">
        <field name="name">marketing.activity.view.form.whatsapp</field>
        <field name="model">marketing.activity</field>
        <field name="inherit_id" ref="marketing_automation.marketing_activity_view_form"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mass_mailing_id']" position="after">
                <label for="whatsapp_template_id" string="Whatsapp Template" invisible="activity_type != 'whatsapp'"/>
                <field name="whatsapp_template_id" nolabel="1"
                    domain="[('model', '=', model_name), ('status', '=', 'approved')]"
                    placeholder="Pick a Template..." context="{'default_model_id': model_id}"
                    class="ps-1" invisible="activity_type != 'whatsapp'"/>
            </xpath>
        </field>
    </record>

    <record id="marketing_activity_view_form_mailing" model="ir.ui.view">
        <field name="name">marketing.activity.view.form.mailing.whatsapp</field>
        <field name="model">marketing.activity</field>
        <field name="inherit_id" ref="marketing_automation.marketing_activity_view_form_mailing"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_marketing_activity_title')]" position="inside">
                <div class="d-flex align-items-center" invisible="activity_type != 'whatsapp'">
                    <i class="oi oi-2x mb-auto p-2 bg-300 rounded" data-icon="oi_whatsapp" title="Whatsapp icon"/>
                    <h1 class="ps-1"><field name="name"/></h1>
                </div>
            </xpath>
            <xpath expr="//field[@name='server_action_id']" position="after">
                <div invisible="not whatsapp_error"
                    class="oe_clear oe_edit_only o_ma_text_error"
                    style="font-size:100%">
                    Make sure you select url tracking under buttons option, otherwise those links won't be tracked
                </div>
                <separator invisible="not whatsapp_error"/>
                <label for="whatsapp_template_id" string="Whatsapp Template" invisible="activity_type != 'whatsapp'"/>
                <field name="whatsapp_template_id" nolabel="1" domain="[('model', '=', model_name), ('status', '=', 'approved')]"
                    placeholder="Pick a Template..." context="{'default_model_id': model_id}" class="ps-1" invisible="activity_type != 'whatsapp'"/>
            </xpath>
        </field>
    </record>
</odoo>
