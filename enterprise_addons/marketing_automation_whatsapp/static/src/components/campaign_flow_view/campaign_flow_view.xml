<templates>
    <t t-name="marketing_automation_whatsapp.CampaignFlowView" t-inherit="marketing_automation.CampaignFlowView" t-inherit-mode="extension">
        <xpath expr="//t[@t-elif=&quot;activity.data.activity_type === &apos;mail&apos;&quot;]" position="after">
            <t t-elif="activity.data.activity_type === 'whatsapp'">
                <t t-set="position" t-value="this.getActivityPositionOnScreen(activity)"/>
                <!-- "WhatsApp" node: -->
                <div class="o-editor-node d-flex flex-column align-self-center flex-shrink-0 bg-300 rounded border overflow-hidden"
                    t-att-style="this.getCSSTransform(position.x, position.y)"
                    t-on-pointerdown="(e) => this.addPointerListenerOnMarketingActivity(activity, e)">
                    <div class="d-flex flex-row align-items-center bg-view p-2">
                        <i class="o_ma_step_icon o_ma_step_communicate oi p-2 rounded" data-icon="oi_whatsapp" aria-hidden="true"/>
                        <div class="d-flex flex-column min-w-0 ps-2">
                            <span class="fw-bold text-truncate" t-out="activity.data.name" t-att-title="activity.data.name"/>
                            <span class="small" t-out="activity.data.whatsapp_template_id.display_name"/>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 px-2 py-1">
                        <div class="d-flex align-items-center">
                            <span class="small" t-out="activity.data.total_sent"/>
                            <span class="text-muted small ps-1">Sent</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small" t-out="activity.data.total_open"/>
                            <span class="text-muted small ps-1">Opened</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small" t-out="activity.data.total_click"/>
                            <span class="text-muted small ps-1">Clicks</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small" t-out="activity.data.total_reply"/>
                            <span class="text-muted small ps-1">Replied</span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
