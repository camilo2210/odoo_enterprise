<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="action_social_stream_post" model="ir.actions.act_window">
        <field name="name">Feed</field>
        <field name="path">social</field>
        <field name="res_model">social.stream.post</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <img class="o_social_no_account_placeholder"
                src="/social/static/img/megaphone.svg"/>
            <p>
                Welcome to Odoo Social!
            </p>
            <p>
                Your place to monitor discussions, schedule posts, and track their results.
                <br/>
                Connect your accounts to get started.
            </p>
            <a class="btn btn-primary o_social_js_add_stream" href="#">Connect an Account</a>
        </field>
        <field name="context">{'search_default_group_by_stream': 1, 'search_default_search_my_streams': 1}</field>
    </record>

    <record id="menu_social_stream_post" model="ir.ui.menu">
        <field name="action" ref="action_social_stream_post" />
    </record>

    <record id="social_stream_post_view_kanban" model="ir.ui.view">
        <field name="name">social.stream.post.view.kanban</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <kanban
                create="0"
                quick_create="false"
                edit="0"
                records_draggable="false"
                group_create="false"
                can_open="0"
                js_class="social_stream_post_kanban_view">
                <field name="author_name"/>
                <field name="author_link"/>
                <field name="is_author"/> <!-- Needed for edit/delete buttons -->
                <field name="post_link"/>
                <field name="published_date"/>
                <field name="link_url"/>
                <field name="link_image_url"/>
                <field name="stream_post_attachment_ids"/>
                <field name="stream_post_content_json"/>
                <field name="stream_id" readonly="1"/>
                <templates>
                    <t t-name="card" class="o_social_stream_post_kanban_global p-0 mb-3">
                        <div class="o_social_stream_post_message d-flex flex-column h-100 py-2">
                            <div class="d-flex justify-content-between mb-2 px-2">
                                <t t-set="author_info">
                                    <span class="o_social_stream_post_author_image o_social_author_image o_avatar position-relative d-flex gap-1 rounded overflow-hidden"/>
                                    <span class="o_social_stream_post_author_name text-truncate ms-2" t-out="record.author_name.value or 'Unknown'" t-att-title="record.author_name.value or 'Unknown'"/>
                                </t>

                                <div class="o_social_author_information d-flex align-items-center">
                                    <a t-if="record.author_link.value"
                                        class="d-flex align-items-center"
                                        t-att-href="record.author_link.value"
                                        t-att-title="record.author_name.value or 'Unknown'"
                                        t-out="author_info"
                                        target="_blank"/>

                                    <div t-else=""
                                        class="d-flex align-items-center"
                                        t-out="author_info"/>
                                </div>

                                <a t-att-href="record.post_link.value" target="_blank">
                                    <time class="o_social_stream_post_published_date small"
                                        t-att-title="record.published_date.value">
                                        <field name="formatted_published_date"/>
                                    </time>
                                </a>
                            </div>
                            <t t-set="has_attachments" t-value="record.stream_post_attachment_ids.raw_value.length !== 0 || record.link_url.value"/>
                            <div name="o_social_stream_post_message_body"
                                t-attf-class="o_social_stream_post_message_body flex-grow-1 px-2 pb-2 #{has_attachments ? 'o_social_stream_post_with_attachments' : ''}">

                                <div class="o_social_stream_post_message_text overflow-hidden mb-2" invisible="not message">
                                    <field name="message" widget="social_post_formatter"/>
                                </div>
                                <a t-if="record.link_url.value"
                                    class="o_social_stream_post_link p-2 d-flex bg-100"
                                    t-att-href="record.link_url.raw_value"
                                    target="_blank">
                                    <img t-if="record.link_image_url.raw_value" class="me-2 flex-shrink-0" t-att-src="record.link_image_url.raw_value" alt="Link Image"/>
                                    <div class="o_social_stream_post_link_text">
                                        <field class="d-block fw-bold text-truncate" name="link_title"/>
                                        <field class="d-block text-truncate" name="link_description"/>
                                    </div>
                                </a>
                                <div t-if="has_attachments"
                                    class="o_social_stream_post_content d-flex mx-n2 overflow-hidden">
                                    <t t-set="content_attachment_json" t-value="JSON.parse(record.stream_post_content_json.raw_value)"/>
                                    <t t-foreach="content_attachment_json.length > 2 ? content_attachment_json.slice(0, 2) : content_attachment_json" t-as="content_url" t-key="content_url_index">
                                        <a t-if="content_url_index == 1 and record.stream_post_attachment_ids.raw_value.length > 2"
                                            class="o_social_stream_post_content_more position-relative d-flex ms-1" t-att-data-media-type="record.media_type.raw_value"
                                            t-att-data-index="content_url_index" t-att-data-content-json="JSON.stringify(content_attachment_json)">
                                            <img t-att-src="content_url['thumbnail_url'] or content_url['url']" alt="Post Attachment" />
                                            <div class="o_social_stream_post_content_more_overlay position-absolute d-flex align-items-center justify-content-center h-100 w-100 m-0 h1">
                                                +<t t-out="content_attachment_json.length - 2"/>
                                            </div>
                                        </a>
                                        <img t-else="" class="o_social_stream_post_content_more" t-att-src="content_url['thumbnail_url'] or content_url['url']" alt="Post Attachment"
                                            t-att-data-index="content_url_index" t-att-data-content-json="JSON.stringify(content_attachment_json)"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="social_stream_post_view_search" model="ir.ui.view">
        <field name="name">social.stream.post.view.search</field>
        <field name="model">social.stream.post</field>
        <field name="arch" type="xml">
            <search>
                <field name="message" string="Post Message"/>
                <filter string="My Streams" domain="[('stream_id.create_uid','=',uid)]" name="search_my_streams"/>
                <group>
                    <filter name="group_by_stream" string="By Stream" context="{'group_by': 'stream_id'}"/>
                </group>
            </search>
        </field>
    </record>
</data>
</odoo>
