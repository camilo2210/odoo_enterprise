<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="social.SocialAccountMany2manyField" t-inherit="web.Many2ManyCheckboxesField" t-inherit-mode="primary">
        <xpath expr="//CheckBox/t" position="replace">
            <div class="d-flex flex-row align-items-center">
                <img class="img me-1" height="14" width="14" t-att-alt="item.media_id.name" loading="lazy"
                    t-attf-src="/web/image/social.media/{{item.media_id.id}}/image/14x14"/>
                <span t-out="item.name"/>
            </div>
        </xpath>
    </t>
</templates>
