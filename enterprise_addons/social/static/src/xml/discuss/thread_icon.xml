<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ThreadIcon" t-inherit-mode="extension">
        <xpath expr="//t[@name='chat_static']/ImStatus" position="after">
            <img
                t-elif="this.channel?.livechat_social_account_id?.media_id"
                class="d-block object-fit-contain rounded-1 o_social_livechat_media_thread_icon"
                alt="Social Media"
                t-att-src="this.channel.social_account_media_image_url"
            />
        </xpath>
    </t>
</templates>
