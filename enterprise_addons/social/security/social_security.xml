<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_social_marketing">
        <field name="name">Social Marketing</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_social_user" model="res.groups">
        <field name="name">Social User</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_social_marketing"/>
    </record>

    <record id="group_social_manager" model="res.groups">
        <field name="name">Social Manager</field>
        <field name="sequence">20</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_social_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_social_user'))]"/>
    </record>

    </odoo>
