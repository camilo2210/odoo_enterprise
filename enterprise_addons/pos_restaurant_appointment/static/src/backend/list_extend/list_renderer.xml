<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_appointment.PosResAppointmentListRenderer.RecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="primary">
        <xpath expr="//tr[hasclass('o_data_row')]//td[@t-att-name='column.name']" position="inside">
            <t t-if="column.name == 'resource_ids' and record.data.appointment_type_schedule_based_on == 'resources' and !['attended', 'no_show'].includes(record.data.appointment_status) and (!record.data.resource_ids || !record.data.resource_ids.records.length)">
                <span class="cursor-pointer fw-bold" t-on-click.stop="() => this.setTable(record)" style="color: #01585c">Set Table</span>
            </t>
        </xpath>
    </t>

</templates>
