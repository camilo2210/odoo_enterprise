<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_appointment.ReassignAppointmentPopup">
        <Dialog title="this.title" size="'md'">
            <div><t t-out="this.message"/></div>
            <div>Do you want to reassign <t t-out="this.existingAppointment.attendeeName"/> to another table, or double book on the same table?</div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.onConfirm()">
                    <t t-if="this.canSwap">
                        Swap
                    </t>
                    <t t-else="">
                        Reassign
                    </t>
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.onContinue()">Double Book</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
