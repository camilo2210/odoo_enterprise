<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_appointment.ConfirmAppointmentPopup">
        <Dialog title="this.title" size="'md'">
            <div><t t-out="this.message"/></div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.onConfirm()">Confirm</button>
                <button class="btn btn-secondary" t-on-click="() => this.onContinue()">Another Guest</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
