<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="quality_check_4x12_label">
        <td t-att-style="label['invisible'] and 'visibility:hidden;'">
            <div class="o_label_full o_label_4x12">
                <t t-if="not label.get('invisible')">
                    <t t-call="product.report_label_contour_marks"/>
                    <div class="o_label_centering_table">
                        <div class="o_label_centered_content">
                            <div class="o_label_table o_label_header">
                                <div class="o_label_name_block">
                                    <div class="o_label_name" t-out="label['name']"/>
                                </div>
                                <div class="o_label_meta_block">
                                    <div class="o_label_meta_line" t-out="label['secondary_text']"/>
                                </div>
                            </div>
                            <div class="o_label_content">
                                <div class="o_label_barcode_block">
                                    <t t-call="product.report_label_barcode"
                                       barcode_size="'width:100%;height:6mm'"/>
                                </div>
                                <div class="o_label_table o_label_footer">
                                    <div class="o_label_barcode_text" t-out="label['barcode_text']"/>
                                    <div class="o_label_reference_block">
                                        <div class="o_label_reference" t-out="label['reference']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </td>
    </template>

    <template id="quality_check_zpl_label">
^PW406
^LL203
^FO14,23^A0N,23^FB235,1,0,L^FH^FD<t t-out="name"/>^FS
^FO250,23^A0N,23,18^FB142,1,0,R^FH^FD<t t-out="secondary_text"/>^FS
        <t t-if="barcode_value">
^FO14,67^BY2^BCN,74,N^FH^FD<t t-out="barcode_value"/>^FS
^FO14,159^A0N,21,16^FB170,1,0,L^FH^FD<t t-out="label['barcode_text']"/>^FS
        </t>
        <t t-else="">
^FO14,90^A0N,22^FB378,1,0,C^FDNo barcode available^FS
        </t>
        <t t-if="reference">
^FO222,159^A0N,21,16^FB170,1,0,R^FH^FD<t t-out="reference"/>^FS
        </t>
    </template>
</odoo>
