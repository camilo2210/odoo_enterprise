<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_production_split_mo_form" model="ir.ui.view">
            <field name="name">Split Manufacturing Order</field>
            <field name="model">mrp.production.backorder</field>
            <field name="arch" type="xml">
                <form string="Split Manufacturing Order">
                    <p colspan="2">
                        Split the manufacturing order if you expect to process the
                        remaining quantities later. Don't split if you won't process the
                        remaining products.
                    </p>
                    <footer>
                        <button name="action_backorder" type="object" string="Split MO"
                                class="btn-primary" data-hotkey="q"/>
                        <button name="action_close_mo" type="object" string="No Backorder"
                                class="btn-secondary" data-hotkey="w"/>
                        <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
