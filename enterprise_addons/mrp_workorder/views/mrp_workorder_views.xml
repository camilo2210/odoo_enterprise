<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workorder_view_form_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.inherit.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <page name='components' position="after">
                <page string="Instructions" name="finished_steps" invisible="not check_ids">
                    <field name="check_ids" readonly="1" context="{'form_view_ref': 'mrp_workorder.quality_check_workorder_form'}">
                        <list default_order="control_date">
                            <field name="quality_state"/>
                            <field name="test_type" column_invisible="True"/>
                            <field name="title"/>
                            <field name="control_date" string="Date"/>
                            <field name="user_id" string="Operator"/>
                            <field name="result"/>
                        </list>
                    </field>
                </page>
            </page>
            <field name="production_state" position="after">
                <field name="allowed_employees" invisible="1"/>
                <field name="all_employees_allowed" invisible="1"/>
            </field>
            <xpath expr="//field[@name='time_ids']/list/field[@name='user_id']" position="after">
                <field name="employee_id" domain="['|',(parent.all_employees_allowed , '=', True),('id', 'in', parent.allowed_employees)]"/>
            </xpath>
            <xpath expr="//field[@name='time_ids']/list/field[@name='user_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='check_ids']/list/field[@name='user_id']" position="after">
                <field name="employee_id" />
            </xpath>
            <xpath expr="//field[@name='check_ids']/list/field[@name='user_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='workcenter_id']" position="before">
                <field name="employee_assigned_ids" widget="many2many_avatar_employee" readonly="state == 'done'"
                    domain="not all_employees_allowed and [('id','in',allowed_employees)] or []"/>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[1]" position="before">
                <button name="action_open_mes" type="object" icon="oi_view-kanban" string="Open Shop Floor" groups="mrp_workorder.group_mrp_wo_shop_floor" invisible="state in ['done', 'cancel']"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_workorder_tree_editable_view_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="production_state" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                    <field name="allowed_employees" column_invisible="True"/>
                    <field name="all_employees_allowed" column_invisible="True"/>
                    <field name="employee_assigned_ids" widget="many2many_avatar_employee" domain="not all_employees_allowed and [('id','in',allowed_employees)] or []" optional="hidden"/>
            </xpath>
        </field>
    </record>

    <record id="workcenter_line_graph_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.production.work.order.graph.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="worksheet_page" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="workcenter_line_pivot_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.production.work.order.pivot.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="employee_costs_hour" invisible="1"/>
                <field name="worksheet_page" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="workorder_pivot_inherit" model="ir.ui.view">
        <field name="name">mrp.work.order.pivot.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="employee_costs_hour" invisible="1"/>
                <field name="worksheet_page" invisible="1"/>
            </xpath>
        </field>
    </record>

<record id="workcenter_line_gantt_production" model="ir.ui.view">
        <field name="name">mrp.production.work.order.gantt.production</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <gantt class="o_mrp_workorder_gantt" date_stop="date_finished" date_start="date_start" string="Operations" default_group_by="workcenter_id" create="0" delete="0" schedule="1"
                progress="progress" plan="0"
                decoration-info="production_state == 'draft'"
                decoration-danger="has_conflicts"
                decoration-warning="has_planning_issues"
                color="color"
                display_unavailability="0"
                total_row="True"
                js_class="mrp_workorder_gantt"
                precision="{'day': 'hour:full', 'week': 'day:full', 'month': 'day:full', 'year': 'day:full'}"
                form_view_id="mrp.mrp_production_workorder_form_view_inherit">

                <field name="has_conflicts"/>
                <field name="has_planning_issues"/>
                <field name="production_id"/>
                <field name="production_state"/>
                <popover>
                    <field name="has_conflicts"/>
                    <field name="has_planning_issues"/>
                    <templates>
                        <t t-name="popover-header">
                            <field name="display_name"/>
                        </t>
                        <t t-name="popover-body">
                            <div><strong>Start: </strong> <field name="date_start"/></div>
                            <div><strong>Stop: </strong> <field name="date_finished"/></div>
                            <div><strong>Workcenter: </strong> <field name="workcenter_id"/></div>
                            <div invisible="not has_conflicts" class="text-danger">This workorder has conflicts</div>
                            <div invisible="not has_planning_issues" class="text-warning">This workorder is scheduled before its dependencies</div>
                        </t>
                        <t t-name="popover-footer" replace="0">
                            <button name="action_mark_as_done" type="object" string="Mark as Done" class="btn btn-sm btn-secondary"/>
                            <button invisible="not (has_conflicts or has_planning_issues)" name="action_replan" type="object" string="Replan" class="btn btn-sm btn-secondary"/>
                        </t>
                    </templates>
                </popover>
            </gantt>
        </field>
    </record>

    <record id="mrp_workorder_view_gantt" model="ir.ui.view">
        <field name="name">mrp.workorder.view.gantt</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <gantt class="o_mrp_workorder_gantt" date_stop="date_finished" date_start="date_start" string="Operations" default_group_by="workcenter_id" create="0"
                delete="0" schedule="1"
                progress="progress" plan="0"
                decoration-info="production_state == 'draft'"
                decoration-danger="has_conflicts"
                decoration-warning="has_planning_issues"
                decoration-secondary="state == 'done'"
                color="color"
                display_unavailability="1"
                progress_bar="workcenter_id,employee_assigned_ids"
                total_row="False"
                js_class="mrp_workorder_gantt"
                precision="{'day': 'hour:quarter', 'week': 'day:half', 'month': 'day:half', 'year': 'day:full'}"
                dependency_field="blocked_by_workorder_ids"
                dependency_inverted_field="needed_by_workorder_ids"
                form_view_id="mrp.mrp_production_workorder_form_view_inherit">

                <field name="has_conflicts"/>
                <field name="has_planning_issues"/>
                <field name="production_id"/>
                <field name="production_state"/>
                <field name="state"/>
                <popover>
                    <field name="has_conflicts"/>
                    <field name="has_planning_issues"/>
                    <field name="date_finished"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="popover-header">
                            <field name="display_name"/>
                        </t>
                        <t t-name="popover-body">
                            <div class="d-flex gap-1 mb-1 mt-n2">
                                <i class="oi px-1" data-icon="build" role="img" title="Manufacturing Order"/>
                                <field name="production_id" widget="many2one"/>
                            </div>
                            <div class="d-flex gap-1 mb-1">
                                <i class="oi oi-filled px-1" data-icon="calendar_today" role="img" title="Date"/>
                                <field name="date_start" widget="daterange" options="{'end_date_field': 'date_finished', 'always_range': True}"/>
                                <div class="d-flex">
                                    (<field name="duration_expected" widget="float_time" options="{'unit': 'minutes'}"/>)
                                </div>
                            </div>
                            <div class="d-flex gap-1 mb-1">
                                <i class="oi oi-filled px-1 o-pt-0_5" data-icon="settings" role="img" title="Work Center"/>
                                <field name="workcenter_id" widget="many2one"/>
                            </div>
                            <div class="o-ps-1_5">
                                <field name="employee_assigned_ids" widget="many2many_avatar_employee"/>
                            </div>
                            <div invisible="not has_conflicts" class="text-danger">This workorder has conflicts</div>
                            <div invisible="not has_planning_issues" class="text-warning">This workorder is scheduled before its dependencies</div>
                        </t>
                        <t t-name="popover-footer" replace="0">
                            <button invisible="state == 'done'" name="action_mark_as_done" type="object" string="Mark as Done" class="btn btn-sm btn-secondary"/>
                            <span invisible="state != 'done'" class="align-self-center text-success">This work order is done</span>
                            <button invisible="not (has_conflicts or has_planning_issues)" name="action_replan" type="object" string="Replan" class="btn btn-sm btn-secondary"/>
                        </t>
                    </templates>
                </popover>
            </gantt>
        </field>
    </record>

    <record id="mrp_workorder_view_gantt_employee" model="ir.ui.view">
        <field name="name">mrp.workorder.view.gantt.employee</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp_workorder.mrp_workorder_view_gantt"/>
        <field name="mode">primary</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <gantt position="attributes">
                <attribute name="default_group_by">employee_assigned_ids</attribute>
            </gantt>
        </field>
    </record>

    <record id="workcenter_line_gantt_production_dependencies" model="ir.ui.view">
        <field name="name">mrp.production.work.order.gantt.production.dependencies</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="workcenter_line_gantt_production"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//gantt" position="attributes">
                <attribute name="dependency_field">blocked_by_workorder_ids</attribute>
                <attribute name="dependency_inverted_field">needed_by_workorder_ids</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_mrp_workorder_dependencies_workcenter" model="ir.actions.server">
        <field name="name">Work Orders Planning</field>
        <field name="model_id" ref="model_mrp_workorder"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_mrp_workorder_dependencies('workcenter')
        </field>
    </record>

    <record id="action_mrp_workorder_dependencies_production" model="ir.actions.server">
        <field name="name">Work Orders Planning Kanban</field>
        <field name="model_id" ref="model_mrp_workorder"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_mrp_workorder_planning()
        </field>
    </record>

    <record id="action_mrp_workorder_dependencies_employee" model="ir.actions.server">
        <field name="name">Work Orders Planning</field>
        <field name="model_id" ref="model_mrp_workorder"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_mrp_workorder_dependencies('employee')
        </field>
    </record>

    <record model="ir.actions.act_window" id="mrp_workorder_action_tablet">
        <field name="name">Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mrp.workcenter_line_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mrp.mrp_production_workorder_tree_editable_view')}) ]"/>
        <field name="target">fullscreen</field>
        <field name="context">{'search_default_workcenter_id': active_id, 'search_default_progress': True, 'search_default_ready': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_workorder">
            No work orders to do!
          </p><p>
            Work orders are operations to do as part of a manufacturing order.
            Operations are defined in the bill of materials or added in the manufacturing order directly.
          </p><p>
            Use the table work center control panel to register operations in the shop floor directly.
            The tablet provides worksheets for your workers and allow them to scrap products, track time,
            launch a maintenance request, perform quality tests, etc.
          </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="mrp.mrp_workorder_todo">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,gantt</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_workorder">
            No Work Orders to do!
          </p><p>
            Work orders are operations to do as part of a manufacturing order.<br/>
            Operations are defined in the bills of materials or added in the manufacturing order directly.
            In both cases, instructions, worksheets and quality checks can be added.
          </p><p>
            You can process work orders here, or use the dedicated Shop Floor application.
          </p><p>
            <a type="action" name="mrp.action_mrp_production_form" role="button" class="btn btn-primary btn-large">Create a manufacturing order</a>
          </p>
        </field>
        <field name="context">{'search_default_my_work_order': False, 'search_default_ready': True, 'search_default_waiting': True, 'search_default_progress': True, 'search_default_blocked': True}</field>
    </record>


    <record model="ir.actions.act_window" id="mrp.action_mrp_routing_time" >
        <field name="view_mode">graph,pivot,list,form,gantt,calendar</field>
    </record>

