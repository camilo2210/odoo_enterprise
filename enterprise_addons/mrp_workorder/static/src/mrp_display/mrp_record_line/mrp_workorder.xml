<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.WorkOrder">
        <li class="o_mrp_record_line list-group-item d-flex align-items-center cursor-pointer"
            t-att-class="{'o_active': this.active, 'disabled': !this.props.clickable}" t-on-click="this.onClick">
            <div class="d-flex align-items-center gap-2 w-100">
                <span t-if="!this.isComplete" t-out="this.workcenter.display_name" class="o_tag badge rounded flex-shrink-0"
                      t-attf-class="o_tag_color_{{this.workcenter.id % 11}}"/>
                <span class="o_mrp_operation_name text-truncate" t-out="this.props.record.data.name"/>
            </div>
            <div class="justify-content-end w-20" t-att-class="this.isEmployeeAssigned and !this.isComplete? 'btn btn-primary':''">
                <i class="oi ms-auto" t-att-class="{'text-muted': this.isComplete}" t-att-data-icon="this.isComplete ? 'check' : 'chevron_forward'" role="img"/>
            </div>
        </li>
    </t>
</templates>
