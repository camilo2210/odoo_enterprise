<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.MrpEmployeeDialog">
        <Dialog size="'md'" title.translate="Select Operators" modalRef="this.modalRef">
            <div class="o_mrp_operatos_dialog w-100">
                <ul t-if="this.hasEmployees" class="ps-0">
                    <li t-foreach="this.props.employees.all" t-as="employee" t-key="employee.id"
                        class="btn btn-outline-secondary w-100 text-start mb-2 fw-normal py-2"
                        t-att-class="{'active' : this.selected.ids.includes(employee.id)}"
                        t-att-name="employee.name"
                        t-on-click="() => this.toggleEmployee(employee.id)">
                        <img t-if="!this.selected.ids.includes(employee.id)"
                                class="o_avatar rounded-circle me-2"
                                t-att-src="this.imageBaseURL + employee.id"/>
                        <div t-else="" class="o_avatar_selected d-inline-block rounded-circle me-2 bg-action text-center">
                            <i class="oi mt-2 text-100" data-icon="check" role="img" />
                        </div>
                        <t t-out="employee.name"/>
                    </li>
                </ul>
                <p t-else="">
                    You must create an employee to log in as an operator in Shopfloor.
                </p>
            </div>
            <t t-set-slot="footer">
                <button t-if="this.hasEmployees" class="btn btn-primary" t-on-click="this.confirm">Done</button>
                <button t-if="!this.hasEmployees and this.isHrUser" class="btn btn-primary" t-on-click="() => this.createEmployee()">Create Employee</button>
                <button t-if="!this.hasEmployees" class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
