<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.MrpLogTimeDialog">
    <div class="o_tablet_popups o_mrp_register_production_dialog">
        <Dialog size="'sm'" title="this.props.title">
            <div class="o_workorder_bar_content d-grid gap-2">
                <span>Total Duration </span>
                <div>
                    <span class="o_field_widget text-end w-25">
                        <input
                            type="text"
                            t-model="this.durationStr"
                            t-ref="this.durationRef"
                            t-on-input="() => this.onValueChange()"
                            t-on-focus="() => this.openPopover()"
                            t-on-focusout="() => this.closePopover()"
                            class="o_input"
                        />
                    </span>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.validate">Update Duration</button>
                <button class="btn btn-secondary" t-on-click="this._cancel">Discard</button>
            </t>
        </Dialog>
    </div>
    </t>
    <t t-name="mrp_workorder.MrpLogTimePopover">
        <div class="o_duration_popover p-1">
            <div t-out="this.props.signal()" />
        </div>
    </t>
</templates>
