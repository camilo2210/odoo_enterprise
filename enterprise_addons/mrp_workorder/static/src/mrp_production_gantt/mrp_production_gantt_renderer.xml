<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.MRPProductionGanttRenderer.RowHeader"
       t-inherit="web_gantt.GanttRenderer.RowHeader">
        <xpath expr="//div[hasclass('o_gantt_row_header')]" position="attributes">
            <attribute name="t-on-click.synthetic">() => row.isGroup ? this.model.toggleRow(row.id) : this.onRowHeaderClicked(row)</attribute>
        </xpath>
    </t>
</templates>
