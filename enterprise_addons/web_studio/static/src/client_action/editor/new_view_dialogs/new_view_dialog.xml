<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.NewViewDialog">
  <Dialog size="'md'" title="this.title">
    <div class="o_web_studio_new_view_dialog">
      <div class="o_web_studio_select">
        <label for="date_start">Start Date Field</label>
        <select name="date_start" class="o_input" t-model.proxy="this.fieldsChoice.date_start">
          <option t-foreach="this.dateFields" t-as="field" t-att-value="field.name" t-key="field.name">
            <t t-out="field.string"/><span t-if="this.debugMode.isActive()"> (<t t-out="field.name"/>)</span>
          </option>
        </select>
      </div>

      <div class="o_web_studio_select">
        <label for="date_stop">Stop Date Field</label>
        <select name="date_stop" class="o_input" t-model.proxy="this.fieldsChoice.date_stop">
          <option t-if="!this.mandatoryStopDate" />
          <option t-foreach="this.dateFields" t-as="field" t-att-value="field.name" t-key="field.name">
            <t t-out="field.string"/><span t-if="this.debugMode.isActive()"> (<t t-out="field.name"/>)</span>
          </option>
        </select>
      </div>
    </div>
    <t t-set-slot="footer">
      <button class="btn btn-primary" t-on-click="this._confirm">
        Activate View
      </button>
      <button class="btn btn-secondary" t-on-click="this._cancel">
        Discard
      </button>
    </t>
  </Dialog>
</t>

</templates>
