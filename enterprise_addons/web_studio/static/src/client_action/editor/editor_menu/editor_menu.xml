<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.EditorMenu">
    <div class="o_web_studio_menu d-flex flex-row pe-3">
        <Breadcrumbs currentTab="this.currentTab" switchTab="this.props.switchTab"/>

        <t t-if="this.editionFlow.MenuItem" t-component="this.editionFlow.MenuItem.component" t-props="this.editionFlow.MenuItem.props" />

        <div class="ms-auto d-flex flex-row gap-0">
            <div class="o_menu_sections d-flex flex-row align-items-center gap-0 mb-0 pe-1">
                <t t-foreach="this.editorTabs" t-as="tab" t-key="tab.id" >
                    <t t-if="tab.Component" t-component="tab.Component" editedAction="this.studio.editedAction" tab="tab" openTab.bind="this.openTab"/>
                    <button t-else=""
                        class="btn h-100 d-table px-2 rounded-0"
                        t-on-click="() => this.openTab(tab.id)">
                        <span class="d-table-cell align-middle" t-out="tab.name"/>
                    </button>
                </t>
            </div>

            <div class="o_web_studio_views_icons d-flex flex-row gap-2 align-items-center border-start border-dark border-2 ps-2">
                <a href="#" t-foreach="this.activeViews" t-as="view" t-key="view.type" t-att-data-tooltip="view.title" t-att-aria-label="view.title" t-att-title="view.title"
                   t-on-click.prevent="() => { this.props.switchView({viewType: view.type}); }">
                    <i class="oi" t-att-data-icon="view.icon" />
                </a>
            </div>
        </div>
    </div>
</t>

<t t-name="web_studio.EditorMenu.Breadcrumbs">
    <div class="o_web_studio_breadcrumb ">
        <ol class="breadcrumb align-items-center">
            <li t-foreach="this.breadcrumbs"
                t-as="crumb"
                t-key="crumb.id"
                t-on-click="crumb.handler"
                class="breadcrumb-item cursor-pointer"
                t-att-class="{active: crumb_last, o_back_button: !crumb_last}"
                t-out="crumb.data.name"/>
        </ol>
    </div>
</t>

<t t-name="web_studio.EditorMenu.BaseEditorTabComponent" >
    <button class="btn h-100 d-table px-2 pe-auto rounded-0"
        t-att-disabled="this.isDisabled"
        t-att-data-tooltip="this.tooltip"
        t-on-click="this.onClick">
        <span class="d-table-cell align-middle" t-out="this.props.tab.name"/>
        <i t-if="this.isDisabled" class="oi ps-1 d-table-cell align-middle" data-icon="warning" />
    </button>
</t>

</templates>
