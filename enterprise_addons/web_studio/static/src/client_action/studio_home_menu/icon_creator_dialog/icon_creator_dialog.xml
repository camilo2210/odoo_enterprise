<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.IconCreatorDialog">
    <Dialog title.translate="Edit Application Icon" contentClass="'o_web_studio_edit_menu_icon_modal'" bodyClass="'d-flex justify-content-center align-items-center overflow-auto'" size="'md'">
        <IconCreator editable="true" t-props="this.props.editedAppData" onIconChange.bind="this.onIconChanged"/>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="this.saveIcon">Confirm</button>
            <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
        </t>
    </Dialog>
</t>

</templates>
