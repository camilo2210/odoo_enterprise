<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.IconCreator">
    <div class="o_web_studio_icon_creator">
        <div t-if="this.props.type === 'base64'" class="o_web_studio_uploaded_image mx-auto mb-4 rounded-3 shadow bg-white"
            t-attf-style="background-image: url({{this.props.webIconData}})"
        />
        <t t-else="">
            <h6 t-if="this.props.editable">Design your Icon</h6>
            <div class="o_web_studio_icon float-start">
                <div class="o_app_icon d-flex align-items-center justify-content-center rounded-3 shadow border-2" t-attf-style="border: solid #00000050;background-color: {{this.props.backgroundColor}};">
                    <i class="oi"
                        t-att-data-icon="this.props.icon"
                        t-attf-style="color: {{this.props.color}};"
                        t-key="this.props.icon"
                    />
                </div>
            </div>
            <t t-if="this.props.editable">
                <div class="o_web_studio_selectors float-end mt-2">
                    <SelectMenu
                        autoSort="false"
                        class="'o_web_studio_selector o_web_studio_selector_background rounded-2 p-0 border-0 m-3'"
                        menuClass="'o_web_studio_selector_menu'"
                        togglerClass="'p-0'"
                        value="this.props.backgroundColor"
                        choices="this.backgroundColorChoices"
                        onSelect="(value) => this.onPaletteItemClick('backgroundColor', value)"
                        required="true"
                        searchable="false">
                        <div class="w-100 h-100 rounded-2" t-attf-style="background-color: {{this.props.backgroundColor}};"> </div>
                        <span class="o_web_studio_selector_pointer" />
                        <t t-set-slot="choice" t-slot-scope="choice">
                            <div
                                class="o_web_studio_selector_value border border-primary m-0 rounded-2 d-inline-flex"
                                t-attf-style="background-color: {{choice.data.value}}"
                            />
                        </t>
                    </SelectMenu>
                    <SelectMenu
                        autoSort="false"
                        class="'o_web_studio_selector o_web_studio_selector_color rounded-2 overflow-visible p-0 border-0 m-3'"
                        menuClass="'o_web_studio_selector_menu'"
                        togglerClass="'p-0'"
                        value="this.props.color"
                        choices="this.colorChoices"
                        onSelect="(value) => this.onPaletteItemClick('color', value)"
                        required="true"
                        searchable="false">
                        <div class="w-100 h-100 rounded-2" t-attf-style="background-color: {{this.props.color}};"> </div>
                        <span class="o_web_studio_selector_pointer" />
                        <t t-set-slot="choice" t-slot-scope="choice">
                            <div
                                class="o_web_studio_selector_value border border-primary m-0 rounded-2 d-inline-flex"
                                t-attf-style="background-color: {{choice.data.value}}"
                            />
                        </t>
                    </SelectMenu>
                    <StudioIconSelector
                        className="'o_web_studio_selector o_web_studio_selector_icon rounded-2 m-3 p-0 border-0'"
                        value="this.props.icon"
                        onSelect="(value) => this.onPaletteItemClick('icon', value)"
                    >
                        <i class="oi" t-att-data-icon="this.props.icon" />
                        <span class="o_web_studio_selector_pointer" />
                    </StudioIconSelector>
                </div>
                <div class="clearfix" />
            </t>
        </t>
        <div t-if="this.props.editable" class="o_web_studio_upload">
            <a t-if="this.props.type === 'base64'" href="#" t-on-click.prevent.stop="this.onDesignIconClick">
                Design your Icon
            </a>
            <span> or </span>
            <FileInput t-props="this.fileInputProps" onUpload.bind="this.onFileUploaded">
                <a href="#">
                    <t t-if="this.props.type === 'base64'">upload one</t>
                    <t t-else="">upload it</t>
                </a>
            </FileInput>
        </div>
    </div>
</t>

</templates>
