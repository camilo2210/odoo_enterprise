<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.StudioIconSelector">
    <Dropdown state="this.dropdown">
        <button type="button" t-attf-class="o_web_studio_icon_selector position-relative d-inline-flex align-items-center justify-content-center {{this.props.className}}">
            <t t-call-slot="default">
                <i class="oi" t-att-data-icon="this.props.value"/>
            </t>
            <span t-if="!this.required() and this.props.value" class="o_select_menu_toggler_clear position-absolute top-50 end-0 translate-middle-y me-1" t-on-click.stop="() => this.props.onSelect('')">
                <i class="oi" data-icon="close"/>
            </span>
        </button>
        <t t-set-slot="content">
            <div class="o_web_studio_selector_icon_menu">
                <IconSelector
                    id="'icons'"
                    selectedMedia="this.selectedMedia()"
                    selectMedia.bind="this.onIconSelect"
                    save="() => {}"
                />
            </div>
        </t>
    </Dropdown>
</t>

</templates>
