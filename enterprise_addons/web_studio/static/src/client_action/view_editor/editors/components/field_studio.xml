<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="web_studio.Field" t-inherit="web.Field">
    <xpath expr="./div" position="attributes">
        <attribute name="t-ref">this.rootRef</attribute>
    </xpath>

    <xpath expr="./div" position="before">
      <t t-set="isX2ManyEditable" t-value="this.isX2ManyEditable(this.props)" />
      <t t-set="emptyPlaceholder" t-value="this.getEmptyPlaceholder()" />
    </xpath>

    <xpath expr="//t[@t-component]" position="attributes">
      <attribute name="t-if">!isX2ManyEditable and !emptyPlaceholder</attribute>
    </xpath>

    <xpath expr="//t[@t-component]" position="after">
      <FieldContentOverlay t-if="isX2ManyEditable" displayOverlay="this.state.displayOverlay" onEditViewType.bind="this.onEditViewType">
        <t t-component="this.field.component" t-props="this.fieldComponentProps"/>
      </FieldContentOverlay>
      <span t-if="emptyPlaceholder" t-out="emptyPlaceholder" />
    </xpath>
  </t>

</templates>
