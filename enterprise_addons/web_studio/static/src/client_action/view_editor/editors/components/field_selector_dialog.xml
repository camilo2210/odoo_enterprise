<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="web_studio.FieldSelectorDialog">
    <Dialog title.translate="Select a Field">
      <div class="o_web_studio_kanban_helper">
        <label for="field">Field</label>
        <select id="field" name="field" class="o_input" t-ref="this.selectRef">
            <option t-if="this.props.showNew" class="o_new fst-italic" value=''>New Field</option>
            <option t-foreach="this.props.fields" t-as="field" t-key="field_index" t-att-value="field.name">
                <t t-out="field.string"/> <span t-if="this.debugMode.isActive()">(<t t-out="field.name"/>)</span>
            </option>
        </select>
      </div>
      <t t-set-slot="footer">
        <button class="btn btn-primary" t-on-click="this.onConfirm">
            Confirm
        </button>
        <button class="btn btn-secondary" t-on-click="this.onCancel">
            Discard
        </button>
      </t>
    </Dialog>
  </t>

</templates>
