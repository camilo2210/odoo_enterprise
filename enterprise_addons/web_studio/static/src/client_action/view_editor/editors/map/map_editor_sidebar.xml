<templates>

    <t t-name="web_studio.ViewEditor.MapEditorSidebar">
        <InteractiveEditorSidebar>
            <t t-set-slot="view">
                <Property
                    name="'create'"
                    type="'boolean'"
                    value="this.archInfo.activeActions.create"
                    onChange.bind="this.editAttribute"
                >
                    Can Create
                </Property>

                <Property
                    name="'res_partner'"
                    type="'selection'"
                    value="this.modelParams.resPartnerField"
                    childProps="{ choices: this.contactFieldChoices, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Contact Field
                </Property>

                <Property
                    name="'hide_name'"
                    type="'boolean'"
                    value="this.modelParams.hideName"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Hide Name
                </Property>

                <Property
                    name="'hide_address'"
                    type="'boolean'"
                    value="this.modelParams.hideAddress"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Hide Address
                </Property>

                <div class="o_map_popup_fields">
                    <label for="additional_fields" class="mb-1">Additional Fields</label>
                    <div class="o_field_widget o_field_many2many_tags" name="additional_fields">
                        <MultiRecordSelector t-props="this.multiRecordSelectorProps" />
                    </div>
                </div>

                <Property
                    name="'routing'"
                    type="'selection'"
                    value="this.modelParams.routing"
                    childProps="{ choices: this.routingChoices, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                    tooltip="this.routingTooltip"
                >
                    Routing
                </Property>
                <a href="/odoo/settings#token_map_view" class="d-flex gap-1 btn-link" role="button" target="_blank">Mapbox Token <i class="oi pt-1" data-icon="open_in_new"/></a>
                <Property
                    t-if="this.modelParams.routing === 'ordered'"
                    name="'default_order'"
                    type="'selection'"
                    value="this.modelParams.defaultOrder?.[0]?.name"
                    childProps="{ choices: this.defaultOrderChoices, required: false }"
                    onChange.bind="this.onViewAttributeChanged"
                >
                    Sort by
                </Property>

                <Property
                    name="'default_group_by'"
                    type="'selection'"
                    value="this.viewEditorModel.studioViewProps.defaultGroupBy"
                    onChange.bind="this.editDefaultGroupBy"
                    childProps="{ choices: this.defaultGroupbyChoices, required: false, multiSelect: true }"
                >
                    Default Group By
                </Property>

                <SidebarViewToolbox onMore="this.props.openViewInForm"
                    canEditXml="!this.viewEditorModel.isEditingSubview"
                    openDefaultValues="this.props.openDefaultValues" />
            </t>
        </InteractiveEditorSidebar>
    </t>

</templates>
