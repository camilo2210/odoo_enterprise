<templates>

    <t t-name="web_studio.InteractiveEditor">
        <t
            t-component="this.props.editor.Sidebar or this.defaultSidebar"
            openViewInForm.bind="this.openViewInForm"
            openDefaultValues.bind="this.openDefaultValues"
        />
        <t t-call-slot="default" autoClick="this.applyAutoClick"/>
    </t>

</templates>
