<templates>
    <t t-name="web_studio.ViewEditor.InteractiveEditorSidebar">
        <div t-ref="this.rootRef" class="h-100 o_web_studio_sidebar" >
            <Notebook className="'overflow-x-hidden h-100'" defaultPage="this.defaultTab" icons="this.icons" onPageUpdate.bind="this.onTabClicked">
                <t t-set-slot="new" title="this.tabsDisplay.new.title" isVisible="true" isDisabled="!this.props.slots.new" className="this.tabsDisplay.new.class">
                    <t t-call-slot="new" />
                </t>
                <t t-set-slot="view" title="this.tabsDisplay.view.title" isVisible="true" className="this.tabsDisplay.view.class">
                    <t t-call-slot="view" />
                </t>
                <t t-set-slot="properties" title="this.tabsDisplay.properties.title" isVisible="true" isDisabled="!this.props.slots.properties || !this.env.viewEditorModel.activeNodeXpath" className="this.tabsDisplay.properties.class">
                    <t t-call-slot="properties" />
                </t>
            </Notebook>
        </div>
    </t>
</templates>
