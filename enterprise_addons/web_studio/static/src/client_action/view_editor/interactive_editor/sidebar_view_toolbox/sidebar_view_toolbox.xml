<?xml version="1.0" encoding="utf-8"?>
<templates>

  <t t-name="web_studio.ViewEditor.ViewToolbox">
    <div
      t-if="this.debugMode.isActive()"
      class="o_web_studio_sidebar_toolbox d-flex flex-wrap border-top pt-3 mt-4 gap-2"
    >
      <button
        class="o_web_studio_parameters btn btn-secondary btn-lg w-30"
        t-on-click="() => this.props.onMore()"
      >
        <i class="oi oi-filled me-2" data-icon="settings"/>More
      </button>
      <button t-if="this.props.canEditXml"
        class="o_web_studio_open_xml_editor btn btn-secondary btn-lg"
        t-on-click="() => this.env.viewEditorModel.switchMode()"
      >
        <i class="oi me-2" data-icon="code"/>XML
      </button>
      <button t-if="this.props.canEditDefaultValues" class="o_web_studio_defaults btn btn-secondary btn-lg" t-on-click="this.props.openDefaultValues">
        Default Values
      </button>
      <button
        class="o_web_studio_restore btn btn-danger btn-lg mt-0 w-100"
        t-on-click="() => this.env.viewEditorModel.restoreDefaultView(this.env.viewEditorModel.mainView.id)"
      >
        Restore Default View
      </button>
    </div>
  </t>

  <t t-name="web_studio.ViewEditor.ShowInvisibleToggler">
    <Property
      name="'show_invisible'"
      type="'boolean'"
      value="this.env.viewEditorModel.showInvisible"
      onChange.bind="(value) => this.env.viewEditorModel.showInvisible = value"
    >
        Show Invisible Elements
    </Property>
  </t>

</templates>
