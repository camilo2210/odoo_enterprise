<templates>
    <t t-name="web_studio.ViewEditor.InteractiveEditorProperties.Toolbox">
        <t t-set="hasMoreButton" t-value="this.debugMode.isActive() and this.nodeType === 'field'" />

        <div class="o_web_studio_sidebar_toolbox d-flex flex-wrap border-top pt-3 mt-4 gap-2">
            <button t-if="hasMoreButton" t-on-click="this.openFormAction" class="btn btn-secondary btn-lg o_web_studio_parameters me-1">
                <i class="oi oi-filled me-2" data-icon="settings" />
                    More
            </button>
            <button t-on-click="this.onRemoveFromView" class="btn btn-danger btn-lg o_web_studio_remove">Remove from View</button>
        </div>
    </t>
</templates>
