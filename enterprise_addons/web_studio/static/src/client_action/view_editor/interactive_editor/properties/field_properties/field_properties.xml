<templates>

<t t-name="web_studio.ViewEditor.InteractiveEditorProperties.Field">
    <div class="d-flex flex-column">
    <ViewStructureProperties>
        <ClassAttribute
            value="this.props.node.attrs.class"
            onChange.bind="this.onChangeAttribute"
        />
        <ModifiersProperties node="this.props.node" availableOptions="this.props.availableOptions"/>

        <!-- Attribute depending on views -->
        <Property
            t-if="this.isAttributeSupported('bold')"
            name="'bold'"
            type="'boolean'"
            value="this.getBoldValue()"
            onChange.bind="this.onChangeAttribute"
        >
            Bold
        </Property>
        <Property
            t-if="this.isAttributeSupported('optional')"
            name="'optional'"
            type="'selection'"
            value="this.props.node.attrs.optional"
            onChange.bind="this.onChangeAttribute"
            childProps="this.optionalVisibilityChoices"
        >
            Optional
        </Property>
        <Property
            t-if="this.isAttributeSupported('string')"
            name="'string'"
            type="'string'"
            value="this.props.node.attrs.string || this.props.node.field.string"
            onChange.bind="this.onChangeFieldString"
            autofocus="true"
        >
            Label
        </Property>
        <Property
            t-if="this.isAttributeSupported('help')"
            name="'help'"
            type="'string'"
            value="this.props.node.attrs.help || this.props.node.field.help"
            onChange.bind="this.onChangeAttribute"
        >
            Help Tooltip
        </Property>

        <Property
            t-if="this.canShowTracking(this.props.node) and this.isAttributeSupported('tracking')"
            name="'tracking'"
            type="'boolean'"
            value="this.state.tracking"
            onChange.bind="this.onChangeTracking"
        >
            Track in chatter
        </Property>

        <TechnicalName t-if="this.debugMode.isActive()" node="this.props.node"/>

        <TypeWidgetProperties
            node="this.props.node"
            onChangeAttribute.bind="this.onChangeAttribute"
        />

        <t t-set="defaultValuePropertyProps" t-value="this.getDefaultValuePropertyProps()" />
        <t t-if="defaultValuePropertyProps">
            <Property
                name="'default_value'"
                value="this.state.defaultValue"
                onChange.bind="this.onChangeDefaultValue"
                t-props="defaultValuePropertyProps"
            >
                Default value
                <span t-if="this.multiCompany">
                for company <b t-out="this.activeCompany.name"/>
                </span>
            </Property>
        </t>

        <t t-if="this.canEditSelectionChoices">
            <button class="btn btn-link o_web_studio_edit_selection_values" t-on-click="this.editSelectionChoices">
                <i class="oi oi-filled" data-icon="edit"/> Edit Values
            </button>
        </t>
        <t t-if="this.canEditStages">
            <button class="btn btn-link o_web_studio_edit_selection_values" t-on-click="this.editStages">
                <i class="oi oi-filled" data-icon="edit"/> Edit Stages
            </button>
        </t>
        <Property
            t-if="this.isAttributeSupported('width')"
            name="'width'"
            tooltip.translate="Set a fixed width (e.g. 100) or a minimum width (e.g. [100]) or a width range (e.g. [100, 200]). If not set, the width is automatically computed to fit optimally."
            type="'string'"
            value="this.props.node.attrs.width || this.props.node.field.width"
            onChange.bind="this.onChangeAttribute"
        >
            Column Width (px)
        </Property>
    </ViewStructureProperties>
    </div>
</t>

<t t-name="web_studio.ViewEditor.InteractiveEditorProperties.Field.TechnicalName" >
    <Property
        name="'technical_name'"
        type="'string'"
        value="this.fieldName"
        isReadonly="!this.canEdit"
        onChange.bind="this.renameField"
    >
        <span class="w-100 d-inline-block">Technical Name</span>
        <span t-if="this.canEdit" class="input-group-text d-inline-block pe-none">x_studio_</span>
    </Property>
</t>

</templates>
