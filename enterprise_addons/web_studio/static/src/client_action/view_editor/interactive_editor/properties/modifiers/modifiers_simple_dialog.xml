<templates>
    <t t-name="web_studio.ViewEditor.InteractiveEditorProperties.ModifiersSimpleDialog" >
        <Dialog title.translate="Edit Condition" size="'xl'">
            <input
                class="o_input w-100"
                t-att-value="this.state.expression"
                t-on-change="(ev) => this.updateCondition(ev.target.value)"
            />
            <t t-if="this.debugMode.isActive()">
                <div class="o_expression_editor_debug_container d-block mt-3 border rounded p-3 bg-100 text-muted font-monospace">
                    <span class="small"># Code editor</span>
                    <textarea
                        class="pt-2 border-0 bg-transparent text-body"
                        type="text"
                        spellcheck="false"
                        t-att-value="this.state.expression"
                        t-on-change="(ev) => this.updateCondition(ev.target.value)"
                    />
                </div>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onConfirm" t-ref="this.confirmRef">Confirm</button>
                <button class="btn btn-secondary" t-on-click="this.onDiscard">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
