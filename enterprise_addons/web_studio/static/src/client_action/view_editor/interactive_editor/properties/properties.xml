<templates>
    <t t-name="web_studio.ViewEditor.InteractiveEditorProperties">
        <t t-if="this.node">
            <h3 t-attf-class="text-capitalize o_web_studio_icon_container position-relative {{ this.iconClass }}" t-out="this.node.humanName" />
            <t t-if="this.propertiesComponent.component" t-component="this.propertiesComponent.component" t-props="this.propertiesComponent.props" node="this.node"/>
            <DefaultProperties t-else="" node="this.node"/>
        </t>
    </t>
</templates>
