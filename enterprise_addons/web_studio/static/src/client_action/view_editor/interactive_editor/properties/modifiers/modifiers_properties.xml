<templates>
    <t t-name="web_studio.ViewEditor.InteractiveEditorProperties.Modifiers">
        <t t-set="value" t-value="this.props.node.attrs.actual_invisible || this.props.node.attrs.invisible || this.props.node.attrs.column_invisible" />
        <t t-if="this.isAttributeSupported('invisible')" t-call="web_studio.ViewEditor.InteractiveEditorProperties.PythonExpressionCheckbox"
            name="'invisible'"
            value="value"
            indeterminate="this.isIndeterminate(value)"
            boolValue="this.valueAsBoolean(value)"
            string.translate="Invisible"/>

        <t t-set="value" t-value="this.props.node.attrs.required" />
        <t t-if="this.isAttributeSupported('required')" t-call="web_studio.ViewEditor.InteractiveEditorProperties.PythonExpressionCheckbox"
            name="'required'"
            value="value"
            indeterminate="this.isIndeterminate(value)"
            boolValue="this.valueAsBoolean(value)"
            string.translate="Required"/>

        <t t-set="value" t-value="this.props.node.attrs.readonly" />
        <t t-if="this.isAttributeSupported('readonly')" t-call="web_studio.ViewEditor.InteractiveEditorProperties.PythonExpressionCheckbox"
            name="'readonly'"
            value="value"
            indeterminate="this.isIndeterminate(value)"
            boolValue="this.valueAsBoolean(value)"
            string.translate="Readonly"/>
    </t>

    <t t-name="web_studio.ViewEditor.InteractiveEditorProperties.PythonExpressionCheckbox" >
        <div class="o_web_studio_property clearfix o_web_studio_sidebar_checkbox d-flex" t-att-class="this.props.class">
            <CheckBox
                id="name"
                name="name"
                value="boolValue"
                indeterminate="indeterminate"
                onChange="(value) => this.onChangeModifier(name, value)"
            >
                <t t-out="string" />
                <sup t-if="this.tooltip" class="text-info p-1" t-att-data-tooltip="this.props.tooltip" t-out="'?'"/>
            </CheckBox>
            <a t-on-click.prevent.stop="() => this.onConditionalButtonClicked(name, value)" role="button" href="#" data-type="invisible" class="btn btn-link o_web_studio_attrs ms-auto">
                Conditional
            </a>
        </div>
    </t>
</templates>
