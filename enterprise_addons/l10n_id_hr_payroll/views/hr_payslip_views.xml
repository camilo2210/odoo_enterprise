<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='worked_days']//list/field[@name='work_entry_type_id']" position="attributes">
                <attribute name="column_invisible">parent.country_code in ('AU', 'HK', 'ID', 'PH')</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days']//list/field[@name='code']" position="attributes">
                <attribute name="column_invisible">parent.country_code in ('AU', 'HK', 'ID', 'PH')</attribute>
            </xpath>
            <xpath expr="//page[@name='worked_days']//list/field[@name='version_id']" position="before">
                <field name="work_entry_type_id" readonly="1" force_save="1"
                    column_invisible="parent.country_code not in ('AU', 'HK', 'ID', 'PH')"/>
                <field name="code" readonly="1" force_save="1" optional="hide"
                    column_invisible="parent.country_code not in ('AU', 'HK', 'ID', 'PH')"/>
            </xpath>
            <xpath expr="//page[@name='salary_inputs']" position="inside">
                <group string="Income Tax">
                    <field name="l10n_id_include_pkp_ptkp" string="Include PTKP and PKP calculation " invisible="country_code != 'ID'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
