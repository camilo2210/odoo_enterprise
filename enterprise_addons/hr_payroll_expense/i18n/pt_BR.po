#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid ""
"The '%(account_name)s' account for the salary rule '%(rule_name)s' must be "
"of type 'Payable'."
msgstr ""
"A conta '%(account_name)s' para a regra salarial '%(rule_name)s' deve ser do "
"tipo 'A pagar'."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"The salary rules linked to a product must have a debit account of type "
"'Liability Payable'.\n"
"Please fix the following salary rule(s): %s"
msgstr ""
"As regras salariais vinculadas a um produto devem ter uma conta de débito do "
"tipo 'Passivo a Pagar'.\n"
"Corrija a(s) seguinte(s) regra(s) salarial(is): %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "There are no valid expenses selected."
msgstr "Não há despesas válidas selecionadas."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"You cannot assign multiple salary rules to the same structure for this "
"product.\n"
"Please fix the following structure(s): %s"
msgstr ""
"Não é possível atribuir várias regras salariais à mesma estrutura para este "
"produto.\n"
"Corrija a(s) seguinte(s) estrutura(s): %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"You cannot remove an expense from a payslip that has already been "
"validated.\n"
"Expenses can only be removed from draft or canceled payslips."
msgstr ""
"Não é possível remover uma despesa de um holerite que já tenha sido "
"validado.\n"
"As despesas só podem ser removidas de holerites provisórios ou cancelados."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "You do not have permission to add this expense to a payslip."
msgstr "Você não tem permissão para adicionar essa despesa a um holerite."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid ""
"You don't have the access rights to link an expense to a payslip. You need "
"to be a payroll officer to do that."
msgstr ""
"Você não tem os direitos de acesso para vincular uma despesa a um holerite. "
"Você precisa ser um funcionário da folha de pagamento para fazer isso."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid "You don't have the access rights to post an invoice."
msgstr "Você não tem direitos de acesso para lançar uma fatura."

