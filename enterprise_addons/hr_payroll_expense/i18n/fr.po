#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid ""
"The '%(account_name)s' account for the salary rule '%(rule_name)s' must be "
"of type 'Payable'."
msgstr ""
"Le compte '%(account_name)s' pour la règle salariale '%(rule_name)s' doit "
"être de type \" Payable \"."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"The salary rules linked to a product must have a debit account of type "
"'Liability Payable'.\n"
"Please fix the following salary rule(s): %s"
msgstr ""
"Les règles salariales liées à un produit doivent avoir un compte débit de "
"type « Dettes ».\n"
"Veuillez corriger la ou les règles salariales suivantes : %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "There are no valid expenses selected."
msgstr "Aucune dépense valide sélectionnée."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"You cannot assign multiple salary rules to the same structure for this "
"product.\n"
"Please fix the following structure(s): %s"
msgstr ""
"Vous ne pouvez pas attribuer plusieurs règles salariales à la même structure "
"pour ce produit.\n"
"Veuillez corriger la ou les structures suivantes : %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"You cannot remove an expense from a payslip that has already been "
"validated.\n"
"Expenses can only be removed from draft or canceled payslips."
msgstr ""
"Vous ne pouvez pas supprimer une dépense d'une fiche de paie déjà validée.\n"
"Les dépenses peuvent uniquement être supprimées sur des fiches de paie "
"provisoires ou annulées."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "You do not have permission to add this expense to a payslip."
msgstr ""
"Vous n'avez pas la permission d'ajouter cette dépense à une fiche de paie."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid ""
"You don't have the access rights to link an expense to a payslip. You need "
"to be a payroll officer to do that."
msgstr ""
"Vous n'avez pas les droits d'accès pour lier une dépense à une fiche de "
"paie. Pour ce faire, vous devez être un gestionnaire payroll."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid "You don't have the access rights to post an invoice."
msgstr "Vous n'avez pas les droits suffisants pour comptabiliser une facture."

