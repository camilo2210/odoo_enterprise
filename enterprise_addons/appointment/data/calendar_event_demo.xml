<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="calendar_event_dental_care_1" model="calendar.event">
        <field name="appointment_booker_id" ref="base.res_partner_address_31"/>
        <field name="appointment_status">request</field>
        <field name="appointment_type_id" ref="appointment_type_dental_care"/>
        <field name="duration" eval="0.5"/>
        <field name="name">Addison Olson - Dental Care</field>
        <field name="partner_ids" eval="[(6, 0, [ref('base.res_partner_address_31'), ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=5)).strftime('%Y-%m-%d 12:00:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=5)).strftime('%Y-%m-%d 12:30:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

    <record id="calendar_event_dental_care_2" model="calendar.event">
        <field name="appointment_booker_id" ref="base.partner_demo_portal"/>
        <field name="appointment_status">request</field>
        <field name="appointment_type_id" ref="appointment_type_dental_care"/>
        <field name="duration" eval="0.5"/>
        <field name="name">Joel Willis - Dental Care</field>
        <field name="partner_ids" eval="[(6, 0, [ref('base.partner_demo_portal'), ref('base.partner_demo')])]"/>
        <field name="start" eval="(DateTime.now() + timedelta(days=5)).strftime('%Y-%m-%d 08:30:00')"/>
        <field name="stop" eval="(DateTime.now() + timedelta(days=5)).strftime('%Y-%m-%d 09:00:00')"/>
        <field name="total_capacity_reserved" eval="1"/>
        <field name="user_id" ref="base.user_demo"/>
    </record>

</odoo>
