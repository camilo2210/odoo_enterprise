<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_appointment_entry" model="portal.entry">
        <field name="name">Appointments</field>
        <field name="description">Follow, reschedule or cancel your appointments</field>
        <field name="url">/my/appointments</field>
        <field name="image" type="bytes" file="appointment/static/src/img/calendar.svg"/>
        <field name="placeholder_count">appointment_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="10"/>
    </record>
</odoo>
