<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="appointment.List.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <button t-if="this.isAppointmentManager" type="button" class="btn btn-secondary" t-on-click="this.onAddClosingDay">
                Add Closing Day
            </button>
        </xpath>
    </t>
</templates>
