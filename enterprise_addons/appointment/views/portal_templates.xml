<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal -->
    <template id="portal_my_home_menu_appointment" name="Portal layout : appointment menu entries" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'appointment' or event" t-attf-class="breadcrumb-item #{'active ' if not event else ''}">
                <a t-if="event" t-attf-href="/my/appointments?{{ keep_query() }}">Appointments</a>
                <t t-else="">Appointments</t>
            </li>
            <li t-if="event" class="breadcrumb-item active">
                <span t-field="event.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Appointments"/>
            <t t-if="not appointments">
                <div class="alert alert-warning" role="alert">
                    <p class="mb-0">There is no appointment linked to your account.</p>
                </div>
            </t>
            <t t-else="" t-call="portal.portal_table">
                <t t-set="appointments" t-value="grouped_appointments or appointments"/>
                <thead>
                    <tr>
                        <th>Appointment Name</th>
                        <th>Date</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <t t-foreach="appointments" t-as="appts">
                    <tbody t-if="grouped_appointments and not groupby == 'none'">
                        <t t-set="groupby_record" t-value="appts[0]"/>
                        <t t-set="appts" t-value="appts[1]"/>
                        <tr class="table-light">
                            <th>
                                <em class="fw-normal text-muted">Appointments by <t t-out="searchbar_groupby[groupby]['label']"/>:</em>
                                <span t-if="groupby == 'responsible'" t-field="groupby_record.name"/>
                                <span t-if="groupby == 'status'" t-field="groupby_record.appointment_status"/>
                            </th>
                            <th/>
                            <th class="text-end">
                                Total: <span class="text-muted" t-out="len(appts)"/>
                            </th>
                        </tr>
                    </tbody>
                    <tbody>
                        <t t-foreach="appts" t-as="appointment">
                            <tr>
                                <td>
                                    <a t-attf-href="/calendar/view/#{appointment.access_token}?partner_id=#{env.user.partner_id.id}">
                                        <t t-out="appointment.appointment_type_id.name"/> 
                                        <t t-if="appointment.appointment_type_id.schedule_based_on == 'users'">
                                            with <t t-out="appointment.user_id.name"/>
                                        </t>
                                    </a>
                                </td>
                                <td><span t-field="appointment.start"/></td>
                                <td class="text-end">
                                    <span t-if="appointment.appointment_status == 'booked'"
                                        class="badge rounded-pill text-bg-success">
                                        <i class="oi oi-fw" data-icon="calendar_today" aria-label="Booked" title="Booked" role="img"/>
                                        <span class="d-none d-md-inline"> Booked</span>
                                    </span>
                                    <span t-elif="appointment.appointment_status == 'attended'"
                                        class="badge rounded-pill text-bg-success">
                                        <i class="oi oi-fw" data-icon="check" aria-label="Attended" title="Attended" role="img"/>
                                        <span class="d-none d-md-inline"> Attended</span>
                                    </span>
                                    <span t-elif="appointment.appointment_status == 'no_show'"
                                        class="badge rounded-pill text-bg-danger">
                                        <i class="oi oi-fw" data-icon="visibility_off" aria-label="No Show" title="No Show" role="img"/>
                                        <span class="d-none d-md-inline"> No Show</span>
                                    </span>
                                    <span t-elif="appointment.appointment_status == 'cancelled'"
                                        class="badge rounded-pill text-bg-danger">
                                        <i class="oi oi-fw" data-icon="close" aria-label="Cancelled" title="Cancelled" role="img"/>
                                        <span class="d-none d-md-inline"> Cancelled</span>
                                    </span>
                                    <span t-else=""
                                        class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="schedule" aria-label="Request" title="Request" role="img"/>
                                        <span class="d-none d-md-inline"> Request</span>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>
</odoo>
