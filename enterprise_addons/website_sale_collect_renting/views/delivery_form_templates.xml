<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="in_store_delivery_method" inherit_id="website_sale_collect.in_store_delivery_method">
        <span name="o_pickup_location_selector" position="attributes">
            <attribute name="t-att-data-is-rental">order.is_rental_order</attribute>
            <attribute name="t-att-data-from-date">order.rental_start_date</attribute>
            <attribute name="t-att-data-to-date">order.rental_return_date</attribute>
        </span>
        <button name="o_pickup_location_selector" position="attributes">
            <attribute name="t-att-data-is-rental">order.is_rental_order</attribute>
            <attribute name="t-att-data-from-date">order.rental_start_date</attribute>
            <attribute name="t-att-data-to-date">order.rental_return_date</attribute>
        </button>
    </template>
</odoo>
