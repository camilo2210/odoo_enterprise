<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_public_view_form_inherit_l10n_in_hr_payroll" model="ir.ui.view">
        <field name="name">hr.employee.public.view.form.inherit.l10n.in.hr.payroll</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <button name="%(l10n_in_hr_payroll.action_employee_tax_declaration_client)d"
                        invisible="country_code != 'IN' or not is_user or not user_id" string="Tax Declaration" type="action"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
