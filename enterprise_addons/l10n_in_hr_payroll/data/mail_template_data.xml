<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="l10n_in_mail_template_notice_period" model="mail.template">
            <field name="name">Employee Departure: Notice Period</field>
            <field name="model_id" ref="hr.model_hr_employee_departure"/>
            <field name="subject">Notice Period Details</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="description">Sent to employees when notice period dates are set</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p>Dear <t t-out="object.employee_id.name"/>,</p>
    <p>This is to confirm that your notice period will start from <strong><t t-out="object.l10n_in_notice_period_start"/></strong>
    to <strong><t t-out="object.departure_date"/></strong>, as per company policy.<br/>
    Please ensure proper handover of your responsibilities during this period.<br/>
    For any clarification, feel free to contact HR.</p>
    <br/>
    <p>Regards,<br/>
    <t t-out="user.name"/><br/>
    HR Team<br/>
    <t t-out="user.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
