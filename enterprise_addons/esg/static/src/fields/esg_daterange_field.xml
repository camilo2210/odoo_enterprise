<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="esg.EsgDateTimeField" t-inherit="web.DateTimeField" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='this.endDateField']/t[2]" position="attributes">
            <attribute name="t-elif">!this.isEmpty(this.startDateField) and this.isEmpty(this.endDateField)</attribute>
        </xpath>
    </t>
</templates>
