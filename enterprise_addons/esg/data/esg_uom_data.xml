<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="esg_uom_kg_co2" model="uom.uom">
        <field name="name">kgCO₂</field>
        <field name="relative_factor" eval="1.0"/>
    </record>
    <record id="esg_uom_t_co2" model="uom.uom">
        <field name="name">tCO₂</field>
        <field name="relative_factor" eval="1000.0"/>
        <field name="relative_uom_id" ref="esg_uom_kg_co2"/>
    </record>
</odoo>
