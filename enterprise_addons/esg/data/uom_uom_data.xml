<?xml version="1.0" encoding="utf-8"?>
    <odoo noupdate="1">
        <!-- ENERGY -->
        <record id="product_uom_j" model="uom.uom">
            <field name="name">J</field>
            <field name="relative_factor" eval="1"/>
        </record>

        <record id="product_uom_kj" model="uom.uom">
            <field name="name">kJ</field>
            <field name="relative_factor" eval="1000"/>
            <field name="relative_uom_id" ref="product_uom_j"/>
        </record>

        <record id="product_uom_mj" model="uom.uom">
            <field name="name">MJ</field>
            <field name="relative_factor" eval="1000000"/>
            <field name="relative_uom_id" ref="product_uom_j"/>
        </record>

        <record id="product_uom_gj" model="uom.uom">
            <field name="name">GJ</field>
            <field name="relative_factor" eval="1000000000"/>
            <field name="relative_uom_id" ref="product_uom_j"/>
        </record>

        <record id="product_uom_toe" model="uom.uom">
            <field name="name">toe</field>
            <field name="relative_factor" eval="41840000000"/>
            <field name="relative_uom_id" ref="product_uom_j"/>
        </record>

        <record id="uom.product_uom_kwh" model="uom.uom">
            <field name="relative_factor" eval="3600000"/>
            <field name="relative_uom_id" ref="product_uom_j"/>
        </record>

        <!-- SURFACE -->
        <record id="product_uom_a" model="uom.uom">
            <field name="name">a</field>
            <field name="relative_factor" eval="100"/>
            <field name="relative_uom_id" ref="uom.product_uom_square_meter"/>
        </record>

        <record id="product_uom_ha" model="uom.uom">
            <field name="name">ha</field>
            <field name="relative_factor" eval="10000"/>
            <field name="relative_uom_id" ref="uom.product_uom_square_meter"/>
        </record>

        <record id="product_uom_km2" model="uom.uom">
            <field name="name">km²</field>
            <field name="relative_factor" eval="1000000"/>
            <field name="relative_uom_id" ref="uom.product_uom_square_meter"/>
        </record>
</odoo>
