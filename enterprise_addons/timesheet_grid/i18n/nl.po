#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add a description</b> <br/> <i>Briefly summarize your activity, e.g., "
"\"Metting with the customer.\"</i>"
msgstr ""
"<b>Voeg een beschrijving toe</b> <br/> <i> Vat je activiteit kort samen, bv: "
"'Meeting met de klant.'</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add time in the Grid view</b> <br/> <i>Click a cell to enter hours. Press "
"Tab or Enter to navigate easily.</i>"
msgstr ""
"<b>Tijd toevoegen in de rasterweergave</b> <br/> <i>Klik op een cel om uren "
"in te voeren. Druk op Tab of Enter om gemakkelijk te navigeren.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Create the timesheet</b> <br/> <i>Once saved, the timer automatically "
"restarts for your next activity.</i>"
msgstr ""
"<b>Urenstaat aanmaken</b> <br/> <i>Zodra deze is opgeslagen, start de timer "
"automatisch opnieuw voor je volgende activiteit.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Select a project</b> <br/> <i>Choose the relevant project, such as a "
"customer or team project.</i>"
msgstr ""
"<b>Project selecteren</b> <br/> <i>Kies het relevante project, zoals een "
"klant- of teamproject.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Start managing your timesheets</b> <br/> <i>Everything you track begins "
"here.</i>"
msgstr ""
"<b>Urenstaten beheren</b> <br/> <i>Alles wat je opvolgt, begint hier.</i>"

#. module: timesheet_grid
#: model_terms:digest.tip,tip_description:timesheet_grid.digest_tip_timesheet_grid_0
