<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="timesheet_grid.aw_timesheet_no_content_animation">
    <section class="o_aw_nc_container">
        <div class="position-relative">
            <div class="o_aw_nc_animation d-flex align-items-start justify-content-center pe-none">
                <!-- Activities (Left)-->
                <div class="o_aw_nc_col o_aw_nc_col_activities min-w-0">
                    <div class="o_aw_nc_activities_screen card rounded-3 bg-view shadow-sm overflow-hidden">
                        <div class="o_aw_nc_activities_scroller d-flex">
                            <t t-call="timesheet_grid.aw_timesheet_no_content_screen_mail"/>
                            <t t-call="timesheet_grid.aw_timesheet_no_content_screen_document"/>
                            <t t-call="timesheet_grid.aw_timesheet_no_content_screen_terminal"/>
                            <t t-call="timesheet_grid.aw_timesheet_no_content_screen_call"/>
                        </div>
                    </div>
                    <div class="o_aw_nc_step_label overflow-hidden text-center small text-muted">
                        Your activity, tracked locally
                    </div>
                </div>

                <!-- Flow Line (Center) -->
                <div class="d-flex flex-column">
                    <div class="o_aw_nc_line d-flex align-items-center">
                        <div class="o_aw_nc_line_flow position-relative overflow-hidden w-100"/>
                    </div>
                    <div class="o_aw_nc_step_label overflow-hidden text-center small" aria-hidden="true">&#160;</div>
                </div>

                <!-- Timesheet (Right) -->
                <div class="o_aw_nc_col">
                    <div class="o_aw_nc_timesheets_screen card bg-100 rounded-3 shadow-lg overflow-hidden">
                        <div class="card-header bg-100 d-flex gap-1 align-items-center border-0">
                            <img style="width: 1em; height: 1em" class="d-inline-block"
                                 src="/timesheet_grid/static/description/icon.svg"/>
                            <div class="smaller fw-medium lh-1">Timesheets</div>
                        </div>
                        <div class="o_aw_nc_timesheets_entries_wrapper overflow-hidden px-2">
                            <div class="o_aw_nc_timesheets_entries d-flex flex-column">
                                <t t-call="timesheet_grid.aw_timesheet_no_content_timesheet_card"
                                    icon="'phone'"
                                    client="'Microsoft'"
                                    task.translate="Call Marc"
                                    duration.translate="42m"
                                    isCompleteAtStep="5"/>

                                <t t-call="timesheet_grid.aw_timesheet_no_content_timesheet_card"
                                    icon="'code'"
                                    client="'Apple'"
                                    task.translate="Feature XyZ"
                                    duration.translate="1h 21m"
                                    isCompleteAtStep="4"/>

                                <t t-call="timesheet_grid.aw_timesheet_no_content_timesheet_card"
                                    icon="'description'"
                                    client="'Tesla'"
                                    task.translate="Review Specification"
                                    duration.translate="12m"
                                    isCompleteAtStep="3"/>

                                <t t-call="timesheet_grid.aw_timesheet_no_content_timesheet_card"
                                    icon="'mail'"
                                    client="'IBM'"
                                    task.translate="Read Agreement"
                                    duration.translate="07m"
                                    isCompleteAtStep="2"/>
                            </div>
                        </div>
                        <!-- Collapsed to nothing until the scene resolves. -->
                        <div class="card-footer bg-100 d-flex align-items-center justify-content-between gap-2 overflow-hidden border-0">
                            <small class="text-muted">Captured today</small>
                            <b class="o_tabular_nums fs-3">2h 22m</b>
                        </div>
                    </div>
                    <div class="o_aw_nc_step_label overflow-hidden text-center small text-muted">
                        Matched to the right project, ready to confirm
                    </div>
                </div>
            </div>

             <!-- Final Message -->
            <div class="text-center">
                <h2 class="o_aw_nc_final_title mb-0">
                    Never lose track of your time again
                </h2>
                <ul class="list-unstyled d-inline-flex flex-wrap justify-content-center gap-3 mt-2 mb-0 small text-muted">
                    <li class="o_aw_nc_final_bullet d-flex align-items-center gap-1">
                        <i class="oi oi-fw text-success" data-icon="check" aria-hidden="true"/>
                        <span>Zero effort</span>
                    </li>
                    <li class="o_aw_nc_final_bullet d-flex align-items-center gap-1">
                        <i class="oi oi-fw text-success" data-icon="check" aria-hidden="true"/>
                        <span>Privacy-friendly</span>
                    </li>
                    <li class="o_aw_nc_final_bullet d-flex align-items-center gap-1">
                        <i class="oi oi-fw text-success" data-icon="check" aria-hidden="true"/>
                        <span>Bill 22% more of your time</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>
</t>

