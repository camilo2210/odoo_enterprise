<t t-name="timesheet_grid.aw_timesheet_no_content_timesheet_card">
    <div class="o_aw_nc_timesheets_entry bg-200 flex-shrink-0 rounded">
        <div class="align-items-center h-100 d-flex justify-content-between gap-2 px-2">
            <div class="d-flex align-items-center gap-1 text-start overflow-hidden">
                <i class="oi oi-fw flex-shrink-0" t-att-data-icon="icon" aria-hidden="true"/>
                <div class="lh-sm overflow-hidden">
                    <small class="d-block fw-medium text-truncate">
                        <t t-out="client"/>
                    </small>
                    <small class="d-block text-muted text-truncate">
                        <t t-out="task"/>
                        <span t-attf-class="o_aw_nc_entry_fade_out_{{isCompleteAtStep}}">...</span>
                    </small>
                </div>
            </div>
            <div class="position-relative flex-shrink-0">
                <span t-attf-class="o_aw_nc_entry_fade_out_{{isCompleteAtStep}}">
                    <i class="oi text-action oi-spin position-absolute end-0 lh-base"
                       data-icon="autorenew"/>
                </span>
                <span t-attf-class="o_aw_nc_entry_fade_in_{{isCompleteAtStep}} text-success o_tabular_nums">
                    <b t-out="duration"/>
                </span>
            </div>
        </div>
    </div>
</t>
</templates>
