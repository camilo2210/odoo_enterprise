<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="timesheet_grid.AwRuleTypeSelectionField" t-inherit="web.SelectionField" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='this.props.readonly']" position="before">
            <t t-set="icon" t-value="this.getIcon(this.value)"/>
            <i t-if="icon" t-att-class="'oi oi-fw me-2 ' + icon.class" t-att-data-icon="icon.icon" aria-hidden="true"/>
        </xpath>
        <xpath expr="//SelectMenu" position="replace">
            <SelectMenu autoSort="false" class="'border-0'" menuClass="'o_field_selection_menu w-auto'" value="this.value" choices="this.choices" onSelect.bind="this.onChange" placeholder="this.props.placeholder" id="this.props.id" searchable="!this.isBottomSheet">
                <t t-set-slot="choice" t-slot-scope="choice">
                    <div class="d-flex align-items-baseline">
                        <t t-set="icon" t-value="this.getIcon(choice.data.value)"/>
                        <i t-if="icon" t-att-class="'oi oi-fw me-2 text-muted ' + icon.class" t-att-data-icon="icon.icon" aria-hidden="true"/>
                        <span t-out="choice.data.label"/>
                    </div>
                </t>
            </SelectMenu>
        </xpath>
    </t>
</templates>
