<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_timesheet.timesheet_menu_root" model="ir.ui.menu">
            <field name="web_icon">timesheet_grid,static/description/icon.png</field>
        </record>
        <menuitem id="menu_activitywatch_sync"
            name="Assistant"
            action="action_activitywatch_sync"
            sequence="15"
            parent="hr_timesheet.timesheet_menu_root"
            groups="group_timesheet_assistant"
        />
        <menuitem
            id="menu_timesheet_grid_validate"
            name="To Validate"
            parent="hr_timesheet.timesheet_menu_root"
            groups="hr_timesheet.group_hr_timesheet_approver"
            sequence="20"
        />
        <menuitem
            id="menu_timesheet_grid_validate_previous_week"
            name="Last Period"
            parent="menu_timesheet_grid_validate"
            action="timesheet_grid_to_validate_action"
        />
        <menuitem
            id="menu_timesheet_grid_validate_all_timesheets"
            name="All Timesheets"
            parent="menu_timesheet_grid_validate"
            action="timesheet_grid_to_validate_all_timesheets_action"
        />
        <menuitem id="hr_timesheet_enterprise_menu_configuration"
            name="Configuration"
            sequence="100"
            parent="hr_timesheet.timesheet_menu_root"
            groups="group_timesheet_assistant"
        >
            <menuitem id="hr_timesheet_menu_configuration_settings"
                  name="Settings"
                  action="hr_timesheet.hr_timesheet_config_settings_action"
                  groups="base.group_system"
                  sequence="5"
            />
            <menuitem id="hr_timesheet_menu_configuration_assistant"
                name="Timesheets Assistant"
                sequence="10"
                groups="group_timesheet_assistant"
            >
                <menuitem id="menu_aw_rule"
                    name="Assistant Rules"
                    groups="hr_timesheet.group_hr_timesheet_user"
                    action="action_aw_rule"
                    sequence="50"
                />
                <menuitem id="menu_aw_local_config"
                    name="Local Assistant Rules"
                    groups="base.group_no_one"
                    action="action_aw_local_config"
                    sequence="100"
                />
            </menuitem>
        </menuitem>
    </data>
</odoo>
