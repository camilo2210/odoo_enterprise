<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_appointments_carousel_preview_data" name="Appointments Carousel Preview Data">
    <t t-call="website.s_dynamic_snippet_carousel_preview_data">
        <div class="carousel-item active" style="min-height: 357.875px;">
            <div class="row">
                <div class="col-12 col-lg-4">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_1.jpg'" title="'Dental Care'" duration="'30 minutes'" location_icon="'location_on'" location="'Doctor\'s Office'"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_2.jpg'" title="'Tennis Court'" duration="'1 hour'" location_icon="'location_on'" location="'Tennis Club'"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_3.jpg'" title="'Online Cooking Lesson'" duration="'1 hour'" location_icon="'videocam'" location="'Online'" badge="'$ 150.00'"/>
                </div>
            </div>
        </div>
        <div class="carousel-item" style="min-height: 357.875px;">
            <div class="row">
                <div class="col-12 col-lg-4">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_4.jpg'" title="'Meeting with a friend'" duration="'15 mins'" location_icon="'location_on'" location="'Ratanpur Border'"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_cover_0.jpg'" title="'Writing Session'" duration="'20 mins'" location_icon="'location_on'" location="'Gujarat, India'"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_appointment.s_appointments_carousel_preview_card" cover_img="'/appointment/static/src/img/appointment_3.jpg'" title="'Pizza making class'" duration="'1 hour'" location_icon="'location_on'" location="'Master Chef Town'"/>
                </div>
            </div>
        </div>
    </t>
</template>

<template id="s_appointments_carousel_preview_card" name="Appointments Carousel Preview Card">
    <div class="position-relative d-flex align-items-center rounded overflow-hidden text-decoration-none ratio ratio-1x1">
        <div class="o_record_cover_container d-flex flex-column o_colored_level o_cc h-100 w-100 bg-600 position-absolute">
            <img class="img img-fluid w-100 h-100 object-fit-cover" t-att-src="cover_img"/>
            <div class="o_record_cover_component o_record_cover_filter oe_black" style="opacity: 0.4;"/>
        </div>
        <div class="d-flex flex-column justify-content-center flex-grow-1 w-100 h-100 px-3 text-center text-white">
            <h3 t-out="title"/>
            <div t-attf-class="d-flex gap-3 justify-content-center smaller #{badge and 'align-items-center' or ''}">
                <span><i class="oi me-1" data-icon="schedule" role="presentation"/><t t-out="duration"/></span>
                <span><i t-attf-class="oi me-1" t-att-data-icon="location_icon" role="presentation"/><t t-out="location"/></span>
                <span t-if="badge" class="badge text-bg-primary" t-out="badge"/>
            </div>
        </div>
    </div>
</template>

</odoo>
