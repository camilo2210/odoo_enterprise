<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="account_sepa_direct_debit_mandate_form">
            <field name="name">sdd.mandate.form.inherit.sepa</field>
            <field name="model">account.direct.debit.mandate</field>
            <field name="inherit_id" ref="account_direct_debit.account_direct_debit_mandate_form"/>
            <field name="arch" type="xml">
                <field name="partner_bank_id" position="after">
                    <field name="sdd_scheme" readonly="state != 'draft'" invisible="mandate_type != 'sepa'" required="mandate_type == 'sepa'"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="account_sepa_direct_debit_mandate_tree">
            <field name="name">sdd.mandate.list.inherit.sepa</field>
            <field name="model">account.direct.debit.mandate</field>
            <field name="inherit_id" ref="account_direct_debit.account_direct_debit_mandate_list"/>
            <field name="arch" type="xml">
                <field name="mandate_type" position="after">
                    <field name="sdd_scheme" optional="show"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
