<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_eu_iot_scale_cert.CertifiedScaleScreen">
        <Dialog size="'md'" t-if="this.scale.product">
            <t t-set-slot="header">
                <t t-if="this.uiService.isSmall">
                    <button class="oi btn" data-icon="west" data-bs-dismiss="modal" aria-label="Close" t-on-click="this.close"/>
                </t>
                <h4 class="modal-title text-break text-center w-100 ms-4" t-att-class="{ 'me-auto': this.uiService.isSmall }">
                    <t t-out="this.scale.product.name"/>
                </h4>
                <t t-if="!this.uiService.isSmall">
                    <button type="button" class="btn-close" aria-label="Close" tabindex="-1" t-on-click="this.close"/>
                </t>
            </t>
            <div class="d-flex flex-column">
                    <div class="d-flex gap-2 align-items-center m-2 px-2">
                        <div class="w-60 fs-2 fw-bold">
                            <t t-out="this.scale.hardwareTare ? 'Net' : 'Gross'"/> Weight:
                        </div>
                        <div
                          class="fs-1 gross-weight text-end form-control-plaintext"
                          t-out="this.scale.hardwareTare ? this.scale.netWeightString : this.scale.grossWeightString"
                        />
                    </div>
                <div class="d-flex flex-row gap-2 m-2 align-items-center">
                    <div class="product-price w-50 text-center fs-1" t-out="this.scale.unitPriceString"/>
                    <div
                      class="computed-price fs-1 fd-flex flex-grow-1 p-3 rounded text-center text-bg-info bg-opacity-25 text-info fw-bold"
                      t-out="this.scale.totalPriceString"
                    />
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="d-flex flex-grow-1 gap-2">
                    <button class="btn btn-secondary w-100" t-att-disabled="this.scale.loading" t-on-click="() => this.scale.readWeight()">
                        <i t-if="this.scale.loading" class="oi oi-spin" data-icon="progress_activity"/>
                        <t t-else="">Get Weight</t>
                    </button>
                    <button class="btn btn-lg btn-primary d-flex justify-content-center align-items-center w-100" t-on-click="this.confirm" t-att-disabled="!this.scale.isWeightValid">
                        Order
                        <i class="oi ms-2" data-icon="keyboard_double_arrow_right"/>
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
