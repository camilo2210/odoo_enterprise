<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_eu_iot_scale_cert.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <div name="header" position="before">
                <div t-if="conditions.get('l10n_eu_iot_scale_cert_show_warning')" class="text-insane mt-3 mb-3">
                    Metrological data not certified
                </div>
            </div>
        </template>

        <template id="l10n_eu_iot_scale_cert.pos_orderline_receipt" inherit_id="point_of_sale.pos_orderline_receipt">
            <xpath expr="//span[hasclass('qty')]" position="replace">
                <span class="qty text-normal ms-2" style="white-space: nowrap;">
                    <t t-if="line['show_uom']" t-out="line['qty_full_precision'] + ' ' + line['product_uom_name']"/>
                    <t t-else="" t-out="line['qty']"/>
                </span>
            </xpath>
        </template>

        <template id="l10n_eu_iot_scale_cert.pos_orderline_receipt_information" inherit_id="point_of_sale.pos_orderline_receipt_information">
            <span name="standard-unit-price" position="replace">
                <span class="text-small price-unit font-monospace" name="standard-unit-price" t-if="not conditions['basic_receipt'] and not len(line['combo_line_ids'])">
                    <t t-out="line['unit_price']" /> 
                    <t t-if="line['show_uom']">
                        /
                        <t t-out="line['product_uom_name']" />
                    </t>
                </span>
            </span>
        </template>
    </data>
</odoo>
