#. module: sale_subscription
#: model:mail.template,body_html:sale_subscription.email_payment_close
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    Our final attempt to process a payment for your subscription using your "
"payment method\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> <t t-"
"out=\"ctx.get('currency') or ''\">$</t> failed.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the "
"issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Our final attempt to process a payment for your subscription failed "
"because we have no payment method recorded for you.\n"
"</t>\n"
"<br/><br/>\n"
"As your payment should have been made <strong><t t-"
"out=\"ctx.get('auto_close_limit') or ''\">5</t> days ago</strong>, your "
"subscription has been terminated.\n"
"Should you wish to resolve this issue, do not hesitate to contact us.<br/"
"><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hola, <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>:<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    Se ha producido un error durante nuestro último intento para procesar el "
"pago de su suscripción con el método de pago\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    por un importe de <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> "
"<t t-out=\"ctx.get('currency') or ''\">€</t>.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Su banco o entidad de crédito ha proporcionado la siguiente "
"información sobre este problema: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Se ha producido un error durante nuestro último intento para procesar el "
"pago de su suscripción porque no hay ningún método de pago configurado.\n"
"</t>\n"
"<br/><br/>\n"
"Se ha cancelado su suscripción, ya que el pago debería haberse efectuado "
"hace <strong><t t-out=\"ctx.get('auto_close_limit') or ''\">5</t> días</"
"strong>.\n"
"No dude en ponerse en contacto con nosotros para resolver este problema.<br/"
"><br/>\n"
"¡Gracias por elegir a <t t-out=\"company.name or ''\">SuEmpresa</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "

#. module: sale_subscription
#: model:mail.template,body_html:sale_subscription.email_payment_reminder
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    We were unable to process a payment for your subscription using your "
"payment method\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> <t t-"
"out=\"ctx.get('currency_name') or ''\">$</t>.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the "
"issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> is "
"due for renewal but we haven’t received your payment yet. To keep your "
"subscription active, please make your payment as soon as possible.\n"
"</t>\n"
"<br/><br/>\n"
"Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> will "
"be <strong>suspended</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + "
"format_date(ctx.get('date_close')))) or 'soon'\">05/05/2021</t>\n"
"if payment is not received.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}"
"\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-"
"decoration: none; background-color: {{company.email_secondary_color or "
"'#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"        Pay Now\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"If you have any questions, do not hesitate to contact us.<br/><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hola, <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>:<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    No se ha podido procesar el pago de tu suscripción mediante el método de "
"pago\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    por un importe de <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> "
"<t t-out=\"ctx.get('currency_name') or ''\">€</t>.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Tu banco o entidad financiera ha proporcionado la siguiente "
"información sobre la incidencia: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Es necesario renovar tu suscripción <t t-out=\"object.client_order_ref "
"or ''\">CÓDIGO</t>, pero todavía no hemos recibido el pago. Efectúa el pago "
"lo antes posible para mantener tu suscripción activa.\n"
"</t>\n"
"<br/><br/>\n"
"Tu suscripción <t t-out=\"object.client_order_ref or ''\">CÓDIGO</t> se "
"<strong>suspenderá</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + "
"format_date(ctx.get('date_close')))) or 'soon'\">05/05/2021</t>\n"
"si no se recibe el pago.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}"
"\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-"
"decoration: none; background-color: {{company.email_secondary_color or "
"'#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"        Pagar ahora\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"Si tienes alguna pregunta, ponte en contacto con nosotros.<br/><br/>\n"
"¡Gracias por elegir <t t-out=\"company.name or ''\">TuEmpresa</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "

