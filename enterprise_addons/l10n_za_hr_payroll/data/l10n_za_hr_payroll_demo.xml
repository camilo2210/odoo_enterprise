<odoo>
    <record id="base.partner_demo_company_za" model="res.partner" forcecreate="1">
        <field name="name">My South African Company</field>
        <field name="country_id" ref="base.za"/>
    </record>

    <record id="base.demo_company_za" model="res.company" forcecreate="1">
        <field name="name">My South African Company</field>
        <field name="partner_id" ref="base.partner_demo_company_za"/>
        <field name="currency_id" ref="base.ZAR"/>
        <field name="street">1 Long Street</field>
        <field name="zip">8001</field>
        <field name="city">Cape Town</field>
        <field name="country_id" ref="base.za"/>
        <field name="resource_calendar_id" ref="l10n_za_hr_payroll.resource_calendar_std_45h"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_za'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_za'))]"/>
    </record>

    <record id="res_partner_za_work_address" model="res.partner">
        <field name="name">South African Offices</field>
        <field name="street">100 Rivonia Road</field>
        <field name="city">Johannesburg</field>
        <field name="zip">2196</field>
        <field name="country_id" ref="base.za"/>
        <field name="company_id" ref="base.demo_company_za"/>
    </record>

    <record id="za_hr_department_rd" model="hr.department">
        <field name="name">R&amp;D ZA</field>
        <field name="company_id" ref="base.demo_company_za"/>
    </record>
</odoo>
