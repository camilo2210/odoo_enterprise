<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.l10n_za_hr_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <field name="birthday" position="attributes">
                <attribute name="required" add="country_code == 'ZA'" separator=" or "/>
            </field>
            <group name="payroll_group" position="inside">
                <group string="Medical Scheme Contribution" invisible="country_code != 'ZA'">
                    <label for="l10n_za_employee_medical_scheme_contribution"/>
                    <div class="o_row">
                        <field name="l10n_za_employee_medical_scheme_contribution" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                    <label for="l10n_za_employee_dependant_count"/>
                    <div class="o_row">
                        <field name="l10n_za_employee_dependant_count" class="o_hr_narrow_field"/>
                        <span>dependants</span>
                    </div>
                    <label for="l10n_za_dependant_medical_scheme_contribution"/>
                    <div class="o_row">
                        <field name="l10n_za_dependant_medical_scheme_contribution" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
