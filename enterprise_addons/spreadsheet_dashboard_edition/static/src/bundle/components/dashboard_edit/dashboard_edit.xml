<?xml version="1.0" encoding="utf-8"?>
<templates>

  <div t-name="spreadsheet_dashboard_edition.DashboardEdit">
    <button t-if="this.isDashboardAdmin"
            type="button"
            class="btn btn-link o_edit_dashboard oi oi-filled"
            data-icon="edit"
            t-att-class="this.props.data.is_from_data ? 'btn-warning' : ''"
            tabindex="-1"
            draggable="false"
            aria-label="Edit"
            t-att-data-tooltip="this.tooltip"
            t-on-click.stop="this.onClick" />
  </div>
</templates>
