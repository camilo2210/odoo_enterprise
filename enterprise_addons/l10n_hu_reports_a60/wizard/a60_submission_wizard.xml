<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ec_sales_list_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_hu_reports_a60.ec.sales.list.submission.wizard.form</field>
            <field name="model">l10n_hu_reports_a60.ec.sales.list.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="phone_number"/>
                        <field name="contact_person"/>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li><button string='Download your EC Sales List (A60 form) data.' name="download_xml" type="object" class="btn-secondary"/></li>
                            <li>Ensure you have the official government software (<a href="https://nav.gov.hu/p/anyk" target="_blank">ÁNYK</a>) and the latest 'A60' form installed.</li>
                            <li>Open the ÁNYK software and import the downloaded XML file into the 'A60' form.</li>
                            <li>Validate the data and create the final submission file from ÁNYK.</li>
                            <li>Log in to the government portal, <a href="https://ugyfelkapu.gov.hu/" target="_blank">Ügyfélkapu</a>, to upload your file.</li>
                        </ol>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
