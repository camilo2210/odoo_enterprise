<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="l10n_hu_a60_export_file">
        <nyomtatvanyok>
            <nyomtatvany>
                <nyomtatvanyinformacio>
                    <nyomtatvanyazonosito><t t-out="date_from[2:4]"/>A60</nyomtatvanyazonosito>
                    <nyomtatvanyverzio>1.0</nyomtatvanyverzio>
                    <adozo>
                        <nev t-out="company.name"/>
                        <t t-if="len(escaped_vat_number) == 10">
                            <adoazonosito t-out="escaped_vat_number"/>
                        </t>
                        <t t-else="">
                            <adoszam t-out="escaped_vat_number.split('-')[0]"/>
                        </t>
                    </adozo>
                    <idoszak>
                        <tol t-out="date_from"/>
                        <ig t-out="date_to"/>
                    </idoszak>
                </nyomtatvanyinformacio>
                <mezok>
                    <t t-foreach="nodes_values" t-as="node">
                        <mezo t-att-eazon="node['code']" t-out="node['value']"/>
                    </t>
                </mezok>
            </nyomtatvany>
        </nyomtatvanyok>
    </template>
</odoo>
