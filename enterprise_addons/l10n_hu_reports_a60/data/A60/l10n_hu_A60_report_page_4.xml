<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="l10n_hu_a60_page_4" model="account.report">
            <field name="name">Acquisition Of Services</field>
            <field name="name@hu">Szolgáltatások megszerzése</field>
            <field name="custom_handler_model_id" ref="model_l10n_hu_reports_a60_a60_page4_report_handler"/>
            <field name="column_ids">
                <record id="l10n_hu_a60_page4_report_column_country_code" model="account.report.column">
                    <field name="name">Country Code</field>
                    <field name="name@hu">Országkód</field>
                    <field name="expression_label">country_code</field>
                    <field name="figure_type">string</field>
                    <field name="sortable" eval="True"/>
                </record>
                <record id="l10n_hu_a60_page4_report_column_vat_number" model="account.report.column">
                    <field name="name">VAT Number</field>
                    <field name="name@hu">HÉA-szám</field>
                    <field name="expression_label">vat_number</field>
                    <field name="figure_type">string</field>
                    <field name="sortable" eval="True"/>
                </record>
                <record id="l10n_hu_a60_page4_report_column_balance" model="account.report.column">
                    <field name="name">Balance</field>
                    <field name="name@hu">Egyensúly</field>
                    <field name="expression_label">balance</field>
                    <field name="figure_type">monetary</field>
                    <field name="sortable" eval="True"/>
                </record>
            </field>
            <field name="line_ids">
                <record id="hu_ec_sales_report_line_page_4" model="account.report.line">
                    <field name="name">EC Sales Report</field>
                    <field name="code">HU_EC</field>
                    <field name="groupby">partner_id_and_sale_type</field>
                    <field name="foldability">always_unfolded</field>
                    <field name="expression_ids">
                        <record id="hu_ec_sales_report_line_page_4_country_code" model="account.report.expression">
                            <field name="label">country_code</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">country_code</field>
                        </record>
                        <record id="hu_ec_sales_report_line_page_4_vat_number" model="account.report.expression">
                            <field name="label">vat_number</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">vat_number</field>
                        </record>
                        <record id="hu_ec_sales_report_line_page_4_sale_type_shortcut" model="account.report.expression">
                            <field name="label">sale_type_shortcut</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">sale_type_shortcut</field>
                        </record>
                        <record id="hu_ec_sales_report_line_page_4_balance" model="account.report.expression">
                            <field name="label">balance</field>
                            <field name="engine">custom</field>
                            <field name="auditable">True</field>
                            <field name="formula">_report_engine_ec_sales_report</field>
                            <field name="subformula">balance</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>
    </data>
</odoo>
