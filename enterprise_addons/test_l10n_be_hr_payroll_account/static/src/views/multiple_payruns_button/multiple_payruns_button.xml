<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="test_l10n_be.PayrunKanbanView.Buttons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="primary">
        <xpath expr="//button[contains(@class, 'o-kanban-button-new')]" position="after">
            <button t-if="this.props.resModel === 'hr.payslip.run' and this.isBelgium" type="button" class="btn btn-primary mx-1" t-on-click="this.multiPayButtonClick">
                Multi Pay
            </button>
        </xpath>
    </t>
</templates>
