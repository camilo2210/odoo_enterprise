        "B2": "(Net sales – COGS) / Net sales",
        "B3": "> 50%: hugely profitable business",
        "B4": "< 20%: hard to become profitable",
        "B5": "possible issue in the business model",
        "B10": "EBIT / Net sales",
        "B11": "< 5%: not efficient at operating business",
        "B12": "> 10%: very efficient at operating business",
        "B13": "possible issue in COGS (Cost of Goods sold)",
        "B18": "Current assets / Current liabilities",
        "B19": "> 1.5: strong financial performance",
        "B20": "< 1: weak financial performance",
        "B21": "possible issue with asset distribution and cash availability",
        "B26": "Current assets – Current liabilities",
        "B27": "> 0: company can meet financial obligations at any time",
        "B28": "< 0: company might not be able to meet obligations",
        "B29": "possible issues in cash availability at short term",
        "B34": "Sales on account / Average accounts receivable balance for period",
        "B35": "< 45: company gets paid for sales quickly",
        "B36": "> 60: company might not get paid for sales quickly enough",
        "B37": "possible issue in payment terms agreement with clients to get paid faster",
        "B38": "Very dependent on the sector",
        "B39": "Best if compared with competitors",
        "D2": "Net income / Revenue",
        "D3": "< 3%: not efficient at generating business",
        "D4": "> 10%: very efficient",
        "D5": "possible issue in direct and indirect costs",
        "D10": "Total liabilities / Total shareholders’ equity",
        "D11": "< 2.5: mature company who accumulated a lot of money",
        "D12": "> 5: company owns a lot of debt and not of a lot of own money",
        "D13": "possible issue in ressources allocation or missed growth opportunities",
        "D18": "Cash flow / Current liabilities",
        "D19": "> 1: income allow to meet financial obligations",
        "D20": "< 0.8: income might be too low",
        "D21": "number of times you can pay off current debts with cash generated per year",
        "D26": "Quick assets / Current liabilities",
        "D27": "> 1: company in highly solvent position",
        "D28": "< 0.7: company might be stuck with non liquid assets",
        "D29": "possible issues in cash availability at short term",
        "D34": "Net Credit Purchases / Average accounts payable balance for period",
        "D35": "< 45: company liquidates debts to suppliers quickly",
        "D36": "> 70: company might be slow to pay suppliers",
        "D37": "possible issue in providers payments, could lead to loss of suppliers trust",
        "D38": "Very dependent on the sector",
        "D39": "Best if compared with competitors"
