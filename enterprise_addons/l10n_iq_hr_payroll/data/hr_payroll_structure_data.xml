<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_iq_regular_pay" model="hr.payroll.structure">
        <field name="name">Iraq: Monthly Pay</field>
        <field name="country_id" ref="base.iq"/>
        <field name="code">IQMONTHLY</field>
        <field name="type_id" ref="l10n_iq_hr_payroll.l10n_iq_employee"/>
        <field name="rule_ids" eval="[]"/>
    </record>

    <record id="l10n_iq_hr_payroll.l10n_iq_employee" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_iq_regular_pay"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.iq_work_entry_type_attendance"/>
    </record>
</odoo>
