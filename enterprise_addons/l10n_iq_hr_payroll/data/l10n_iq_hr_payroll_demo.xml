        <field name="name">My Iraqi Company</field>
        <field name="country_id" ref="base.iq"/>
    </record>
    <record id="base.demo_company_iq" model="res.company" forcecreate="1">
        <field name="name">My Iraqi Company</field>
        <field name="partner_id" ref="base.partner_demo_company_iq"/>
        <field name="currency_id" ref="base.IQD"/>
        <field name="street">Falastin St. Al Anbari 123</field>
        <field name="zip">00964</field>
