        <field name="country_id" ref="base.iq"/>
        <field name="resource_calendar_id" ref="l10n_iq_hr_payroll.l10n_iq_resource_calendar"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_iq'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_iq'))]"/>
