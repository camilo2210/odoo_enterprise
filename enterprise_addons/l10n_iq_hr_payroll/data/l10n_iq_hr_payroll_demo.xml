    <function model="hr.version" name="_set_input_value">
        <value model="hr.version" search="[('employee_id', '=', ref('l10n_iq_hr_payroll.iq_hr_employee_rasheed'))]"/>
        <value>OTHER_ALLOWANCE</value>
        <value>500</value>
    </function>

    <record id="iq_hr_leave_allocation_rasheed" model="hr.leave.allocation">
        <field name="accrual_plan_id" ref="l10n_iq_hr_payroll.l10n_iq_hr_accrual_plan_paid_time_off"/>
