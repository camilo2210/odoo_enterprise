        <field name="company_id" ref="base.demo_company_iq"/>
        <field name="group_ids" eval="[(6,0,[ref('base.group_user')])]"/>
        <field name="image_1920" type="bytes" file="hr/static/img/employee_al-image.webp"/>
    </record>

