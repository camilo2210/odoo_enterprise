        <field name="login" model="res.partner" eval="obj(ref('l10n_iq_hr_payroll.iq_res_partner_raghad')).name.replace(' ', '.').lower() + '@example.com'"/>
        <field name="signature" model="res.partner" eval="obj(ref('l10n_iq_hr_payroll.iq_res_partner_raghad')).name.split(' ')[0][0] + '. ' + obj(ref('l10n_iq_hr_payroll.iq_res_partner_raghad')).name.split(' ')[-1]"/>
