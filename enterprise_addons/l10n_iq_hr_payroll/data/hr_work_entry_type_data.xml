<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sick Time Off -->
        <function model="hr.work.entry.type" name="write">
            <value model="hr.work.entry.type" eval="obj().sudo().search([('code', '=', '013.00'), ('country_id', '=', ref('base.iq'))]).ids"/>
            <value eval="{
                'requires_allocation': True,
            }"/>
        </function>

        <record id="hr_work_entry.iq_work_entry_type_attendance" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.BASIC')])]"/>
        </record>

