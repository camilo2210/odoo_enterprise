<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_iq_hr_accrual_plan_paid_time_off" model="hr.leave.accrual.plan">
            <field name="name">Iraqi Employee Plan</field>
            <field name="accrued_gain_time">start</field>
            <field name="is_based_on_worked_time" eval="False"/>
            <field name="can_be_carryover" eval="True"/>
            <field name="carryover_date">year_start</field>
            <field name="work_entry_type_id" ref="hr_work_entry.iq_work_entry_type_legal_leave"/>

        </record>

        <record id="l10n_iq_hr_accrual_plan_paid_time_off_level_1" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="l10n_iq_hr_accrual_plan_paid_time_off" />
            <field name="milestone_date">after</field>
            <field name="start_count">1</field>
            <field name="start_type">year</field>
            <field name="added_value">1.75</field>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="first_day">1</field>
            <field name="cap_accrued_time" eval="True"/>
            <field name="action_with_unused_accruals">all</field>
            <field name="maximum_leave">21</field>
        </record>

        <record id="l10n_iq_hr_accrual_plan_paid_time_off_level_2" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="l10n_iq_hr_accrual_plan_paid_time_off" />
            <field name="milestone_date">after</field>
            <field name="start_count">5</field>
            <field name="start_type">year</field>
            <field name="added_value" eval="23 / 12"/>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="first_day">1</field>
            <field name="cap_accrued_time" eval="True"/>
            <field name="action_with_unused_accruals">all</field>
            <field name="maximum_leave">23</field>
        </record>

        <record id="l10n_iq_hr_accrual_plan_paid_time_off_level_3" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="l10n_iq_hr_accrual_plan_paid_time_off" />
            <field name="milestone_date">after</field>
            <field name="start_count">10</field>
            <field name="start_type">year</field>
            <field name="added_value" eval="25 / 12"/>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="first_day">1</field>
            <field name="cap_accrued_time" eval="True"/>
            <field name="action_with_unused_accruals">all</field>
            <field name="maximum_leave">25</field>
        </record>

        <record id="l10n_iq_hr_accrual_plan_paid_time_off_level_4" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="l10n_iq_hr_accrual_plan_paid_time_off" />
            <field name="milestone_date">after</field>
            <field name="start_count">15</field>
            <field name="start_type">year</field>
            <field name="added_value" eval="28 / 12"/>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="first_day">1</field>
            <field name="cap_accrued_time" eval="True"/>
            <field name="action_with_unused_accruals">all</field>
            <field name="maximum_leave">28</field>
        </record>
    </data>
</odoo>
