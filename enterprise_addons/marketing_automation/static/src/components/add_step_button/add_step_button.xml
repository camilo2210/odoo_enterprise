<templates>
    <t t-name="marketing_automation.AddStepButton">
        <Dropdown menuClass="'o_ma_add_step_menu'">
            <button class="o-editor-button btn btn-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                t-att-style="this.props.style"
                t-att-title="this.props.title"
                t-on-pointerdown="(e) => e.stopPropagation()">
                <i class="oi" t-att-data-icon="this.props.icon || 'add'" aria-hidden="true"/>
                <span t-if="this.props.title" class="visually-hidden" t-out="this.props.title"/>
                <span t-else="" class="visually-hidden">Add a step</span>
            </button>
            <t t-set-slot="content">
                <t t-call-slot="dropdown-header"/>
                <div class="o_communicate_category">
                    <div class="dropdown-header">Communicate</div>
                    <DropdownItem t-props="this.getDropdownItemProps('mail')">
                        <i class="oi pe-1" data-icon="mail" aria-hidden="true"/>Send Email
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('log_note')">
                        <i class="oi pe-1" data-icon="edit_square" aria-hidden="true"/>Log Note
                    </DropdownItem>
                </div>
                <div class="o_flow_rules_category">
                    <div class="dropdown-header">Flow Rules</div>
                    <DropdownItem t-props="this.getDropdownItemProps('delay')">
                        <i class="oi pe-1" data-icon="hourglass_empty" aria-hidden="true"/>Delay
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('branching')">
                        <i class="oi oi-rotate-90 pe-1" data-icon="fork_right" aria-hidden="true"/>New Path
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('split')">
                        <i class="oi pe-1" data-icon="signpost" aria-hidden="true"/>If/Else Split
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('trigger')">
                        <i class="oi pe-1" data-icon="pause_circle" aria-hidden="true"/>Condition Delay
                    </DropdownItem>
                </div>
                <div class="o_actions_category">
                    <div class="dropdown-header">Actions</div>
                    <DropdownItem t-props="this.getDropdownItemProps('subscribe_to_list')">
                        <i class="oi pe-1" data-icon="contact_mail" aria-hidden="true"/>Update Subscription
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('create_activity')">
                        <i class="oi pe-1" data-icon="verified" aria-hidden="true"/>Create an Activity
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('update_record')">
                        <i class="oi pe-1" data-icon="edit" aria-hidden="true"/>Update Record
                    </DropdownItem>
                    <DropdownItem t-props="this.getDropdownItemProps('action')">
                        <i class="oi pe-1" data-icon="settings" aria-hidden="true"/>Server Action
                    </DropdownItem>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
