<templates>
    <t t-name="marketing_automation.CampaignSidePanel">
        <div t-attf-class="o_ma_campaign_side_panel col-12 col-md-3" t-if="this.panelState.activePanel">
            <div class="d-flex flex-column h-100">
                <div class="overflow-y-auto overflow-x-hidden flex-grow-1">
                    <div t-if="this.panelState.activePanel === 'chatter'" class="o_FormRenderer_chatterContainer p-0">
                        <Chatter
                            threadModel="'marketing.campaign'"
                            threadId="this.props.record.resId"
                            record="this.props.record"
                            has_activities="false"
                            hasParentReloadOnAttachmentsChanged="true"
                            hasParentReloadOnFollowersUpdate="true"
                            hasParentReloadOnMessagePosted="true"
                            isChatterAside="this.isChatterAside"
                            saveRecord="this.props.record.save.bind(this.props.record, { reload: false })"
                        />
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
