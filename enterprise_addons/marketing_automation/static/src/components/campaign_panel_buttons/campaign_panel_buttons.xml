<templates>
    <t t-name="marketing_automation.MarketingCampaignPanelButtons">
        <div class="d-flex gap-1">
            <button
                t-attf-class="btn btn-light text-muted btn-chatter #{this.panelState.activePanel === 'chatter' ? 'active' : ''}"
                t-on-click="() => this.togglePanel('chatter')"
                t-att-title="this.chatterButtonTitle"
                data-hotkey="d">
                <i class="oi oi-fw fs-6" data-icon="forum"/>
            </button>
        </div>
    </t>
</templates>
