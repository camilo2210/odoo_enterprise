<odoo>
    <record id="ir_actions_server_view_form_simple_marketing_automation" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.simple.marketing.automation</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="mode">primary</field>
        <field name="model">ir.actions.server</field>
        <field name="priority">64</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="d-flex align-items-center" invisible="state != 'object_write'">
                    <i class="oi oi-2x mb-auto p-2 bg-300 rounded" data-icon="edit" title="Update icon"/>
                    <h1 class="ps-1">Update Record</h1>
                </div>
                <div class="d-flex align-items-center" invisible="state != 'next_activity'">
                    <i class="oi oi-2x mb-auto p-2 bg-300 rounded" data-icon="verified" title="Activity icon"/>
                    <h1 class="ps-1">Create an Activity</h1>
                </div>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form" position="inside">
                <field name="marketing_activity_ids" invisible="1"/> <!-- Because -->
            </xpath>
            <xpath expr="//page[@name='explanation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
