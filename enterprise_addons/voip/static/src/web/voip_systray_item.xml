<?xml version="1.0"?>
<templates>
    <t t-name="voip.SystrayItem">
        <button data-hotkey="Shift+S" class="o_nav_entry" t-att-class="this.systrayButtonClasses" t-att-title="this.titleText" t-on-click="this.onClick">
            <i class="oi oi-filled" t-att-data-icon="this.icon" t-att-class="{ 'o-voip-RingingAnimation': this.userAgent.hasCallInvitation and !this.softphone.isDisplayed }"/>
            <span t-if="this.missedCallCount" class="badge rounded-pill ms-n1" t-out="this.missedCallCount"/>
            <span t-if="this.systrayButtonText" class="ms-2" t-out="this.systrayButtonText"/>
        </button>
    </t>
</templates>
