<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.FlowConnection">
        <g class="o_flow_editor_connection" t-att-class="{'o_flow_editor_connection_selected': this.props.selected}" t-on-click="this.onClick" aria-hidden="true">
            <path class="o_flow_editor_connection_hitbox" t-att-d="this.props.geometry.path" fill="none" vector-effect="non-scaling-stroke"/>
            <path class="o_flow_editor_connection_path" t-att-d="this.props.geometry.path" fill="none" vector-effect="non-scaling-stroke"/>
        </g>
    </t>
</templates>
