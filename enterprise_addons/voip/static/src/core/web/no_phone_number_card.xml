<?xml version="1.0"?>
<templates>
    <t t-name="voip.NoPhoneNumberCard">
        <div class="o_view_nocontent" t-att-class="{ 'position-static': this.props.inline }">
            <div class="o_nocontent_help">
                <div>
                    <div class="position-relative mb-3">
                        <span class="o_view_nocontent_voip_bg_shape o_view_nocontent_voip_number_bg position-absolute bg-primary"/>
                        <img class="position-relative mw-100" src="/voip/static/src/img/voip_phone_number.svg" alt="Phone numbers"/>
                    </div>
                    <h2 t-out="this.title"/>
                    <p t-out="this.description"/>
                    <button t-if="this.isUserVoipAdmin" type="button" class="btn btn-primary" t-on-click="this.openPhoneNumberPurchaseWizard">Buy a Number</button>
                </div>
            </div>
        </div>
    </t>
</templates>
