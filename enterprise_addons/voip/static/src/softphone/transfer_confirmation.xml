<?xml version="1.0"?>
<templates>
<t t-name="voip.TransferConfirmation">
    <div class="d-flex flex-column gap-3 flex-grow-1 p-3">
        <div class="d-flex flex-column align-items-center justify-content-center gap-3 flex-grow-1">
            <ContactInfo contact="this.frontSession.call?.partner_id" phoneNumber="this.frontSession.displayedPhoneNumber"/>
            <i class="oi oi-2x" data-icon="south"/>
            <ContactInfo contact="this.props.targetContact" phoneNumber="this.props.targetPhoneNumber" extraClass="'mt-3'"/>
        </div>
        <div class="d-flex gap-2">
            <ActionButton name.translate="Transfer Now" icon="'phone_forwarded'" type="'success'" inCallPad="true" extraClass="'w-50 rounded-3'" onClick.bind="this.onClickDirectTransfer"/>
            <ActionButton name.translate="Ask First" icon="'phone_paused'" type="'secondary'" inCallPad="true" extraClass="'w-50 rounded-3'" onClick.bind="this.onClickAskFirst"/>
        </div>
    </div>
</t>
</templates>
