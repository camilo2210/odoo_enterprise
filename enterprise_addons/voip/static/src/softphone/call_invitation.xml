<?xml version="1.0"?>
<templates>
<t t-name="voip.CallInvitation">
    <div class="o-voip-CallInvitation h-100 d-flex flex-column gap-3 p-3">
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 gap-3">
            <ContactInfo contact="this.callInvitationSession.call?.partner_id"/>
            <p class="o-voip-PhoneNumber mb-0 opacity-75 text-truncate">
                <span t-out="this.callInvitationSession.phoneNumberFormatted"/>
                <span t-if="this.callInvitationSession.call?.phone_country_id?.name" t-out="' (' + this.callInvitationSession.call.phone_country_id.name + ')'"/>
            </p>
            <div class="d-flex justify-content-center gap-3">
                <ActionList session="this.callInvitationSession"/>
            </div>
        </div>
        <div class="d-flex justify-content-center gap-5 py-4">
            <ActionButton
                name.translate="Reject the call"
                hideLabel="true"
                type="'danger'"
                icon="'close'"
                iconClass="'oi-2x'"
                onClick.bind="this.onClickReject"
            />
            <ActionButton
                name.translate="Accept the call"
                hideLabel="true"
                type="'success'"
                icon="'phone'"
                iconClass="'oi-filled oi-2x'"
                onClick.bind="this.onClickAccept"
            />
        </div>
    </div>
</t>
</templates>
