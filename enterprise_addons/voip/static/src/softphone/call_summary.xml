<?xml version="1.0"?>
<templates>
<t t-name="voip.CallSummary">
    <div class="o-voip-CallSummary position-relative d-flex flex-column align-items-center h-100 gap-3 p-3 overflow-auto">
        <div class="progress position-absolute top-0 start-0 end-0 bg-transparent">
            <div class="progress-bar w-100"/>
        </div>
        <button title="Close" class="btn align-self-end p-0 text-decoration-none" aria-label="Close call summary" t-on-click="() => this.softphone.hideCallSummary()">
            <i class="oi oi-lg" data-icon="close" aria-hidden="true"/>
        </button>
        <div class="my-auto w-100">
            <ContactInfo contact="this.session.call?.partner_id" phoneNumber="this.session.displayedPhoneNumber" alias="this.session.alias"/>
            <h2 t-out="this.statusText" class="m-0 py-3 text-center"/>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <ActionButton
                    name.translate="Call"
                    icon="'phone'"
                    iconClass="'oi-filled'"
                    type="'success'"
                    onClick.bind="this.onClickCall"
                />
                <ActionButton
                    t-if="this.session.call and !this.session.call.activity_id"
                    name.translate="Log"
                    icon="'schedule'"
                    onClick="() => this.session.call.logToChatter()"
                />
            </div>
        </div>
    </div>
</t>
</templates>
