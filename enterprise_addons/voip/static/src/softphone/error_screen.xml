<?xml version="1.0"?>
<templates>

<t t-name="voip.ErrorScreen">
    <section class="o-voip-ErrorScreen position-absolute bg-view bg-opacity-75" t-att-role="this.props.isConnecting ? 'status' : 'alert'" t-att-aria-live="this.props.isConnecting ? 'polite' : 'assertive'">
        <div t-if="this.props.isConnecting" class="h-100 d-flex flex-column align-items-center justify-content-center gap-3">
            <i class="oi oi-spin oi-3x text-primary" data-icon="autorenew" aria-hidden="true"/>
            <span class="h4 mb-0" t-out="this.props.message"/>
        </div>
        <t t-else="">
            <button t-if="!this.props.isBlocking" class="btn btn-close position-absolute end-0 p-3" aria-label="Close" t-on-click="this.onClickCloseButton"/>
            <div class="container-fluid py-3 mh-100 overflow-auto">
                <h2 class="display-6">
                    Oops!<br/>
                    <span class="h4">Something went wrong...</span>
                </h2>

                <p class="lead">
                    <t t-if="this.props.message" t-out="this.props.message"/>
                    <t t-else="">Please ask your administrator for help.</t>
                </p>

                <a t-if="this.props.buyCreditsUrl" t-att-href="this.props.buyCreditsUrl" target="_blank" class="btn btn-primary mb-3">
                    <i class="oi me-1" data-icon="open_in_new"/>Buy Credits
                </a>

                <t t-if="this.props.technical or this.props.technicalExtra">
                    <hr/>
                    <span class="badge rounded text-bg-light mb-2">Technical Details</span>
                    <p class="o-voip-ErrorScreen-technicalMessage font-monospace small text-muted">
                        <strong t-out="this.props.technical"/>
                        <br t-if="this.props.technical and this.props.technicalExtra"/>
                        <t t-out="this.props.technicalExtra"/>
                    </p>
                </t>
            </div>
        </t>
    </section>
</t>

</templates>
