<?xml version="1.0"?>
<templates>
<t t-name="voip.Dialer">
    <div class="o-voip-Dialer d-flex flex-column align-items-center gap-1 w-100 h-100 pb-3 overflow-auto">
        <Keypad state="this.props.state" onSubmit.bind="this.onClickCall" onClickContact.bind="this.onClickKeypadContact" onCallVoicemail.bind="this.onCallVoicemail" onClickHistory.bind="this.onClickContactHistory" onClickBack="this.props.onClickBack"/>
        <div class="o-voip-Keypad-numpad w-100 grid px-3">
            <ActionButton t-if="!this.props.state.showMore"
                name.translate="Call"
                icon="'phone'"
                iconClass="'oi-filled fs-2'"
                type="'success'"
                onClick.bind="this.onClickCall"
                disabled="!this.voip.canCall"
                hideLabel="true"
                extraClass="'g-start-5 g-col-4'"
                innerExtraClass="'w-100 justify-content-center rounded-pill'"
            />
        </div>
    </div>
</t>
</templates>
