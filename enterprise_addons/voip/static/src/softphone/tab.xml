<?xml version="1.0"?>
<templates>
<t t-name="voip.Tab">
    <div class="d-flex flex-column w-100 h-100 o-min-height-0" t-att-class="this.props.extraClass"
            style="isolation: isolate;"><!-- New stacking context for potential sticky effect -->
        <t t-call-slot="top"/>
        <div t-if="this.hasItems" t-ref="this.scrollContainerRef" class="o-min-height-0 overflow-auto flex-grow-1">
            <t t-foreach="[...this.props.itemsBySection]" t-as="mapping" t-key="mapping[0]">
                <t t-set="sectionName" t-value="mapping[0]"/>
                <t t-set="items" t-value="mapping[1]"/>
                <t t-set="sectionClass" t-value="this.props.getSectionStyle?.(items[0])"/>
                <section class="pt-1" style="isolation: isolate;"><!-- New stacking context for the title sticky effect -->
                    <h2 class="position-sticky top-0 px-3 py-2 m-0 border-bottom bg-view fs-6 z-1" t-att-class="sectionClass">
                        <i t-if="this.props.sectionIcon" class="oi me-1" t-att-data-icon="this.props.sectionIcon" aria-hidden="true"/>
                        <t t-out="sectionName"/>
                    </h2>
                    <t t-foreach="items" t-as="item" t-key="item.id">
                        <t t-call-slot="entry" item="item" section="sectionName"/>
                    </t>
                </section>
            </t>
            <t t-foreach="this.props.ungroupedItems" t-as="item" t-key="'ungrouped-' + item.id">
                <t t-call-slot="entry" item="item" section="'ungrouped'"/>
            </t>
            <!-- dummy node, used to hold a t-ref to the end of tab -->
            <div t-ref="this.endOfTabRef" class="pe-none pt-1 mt-n1"/>
        </div>
        <div t-elif="!this.props.state.searchInputValue.trim()" class="d-flex justify-content-center align-items-center flex-grow-1 p-3 text-center">
            <t t-call-slot="no-entries">
                <p class="fs-4 m-0" t-out="this.props.noEntriesMessage"/>
            </t>
        </div>
        <t t-else="" t-call-slot="no-search-results">
            No search results 💔
        </t>
    </div>
</t>
</templates>
