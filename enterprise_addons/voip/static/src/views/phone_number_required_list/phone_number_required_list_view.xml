<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.PhoneNumberRequiredListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="attributes">
            <attribute name="hasPhoneNumber">this.hasPhoneNumber</attribute>
        </xpath>
    </t>

    <t t-name="voip.PhoneNumberRequiredListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//ActionHelper" position="replace">
            <ActionHelper t-if="this.props.hasPhoneNumber" noContentHelp="this.props.noContentHelp"/>
            <NoPhoneNumberCard t-else=""/>
        </xpath>
    </t>
</templates>
