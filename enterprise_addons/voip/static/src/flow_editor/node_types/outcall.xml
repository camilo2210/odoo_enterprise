<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.OutcallFlowNode">
        <header class="o_flow_editor_node_header card-header text-truncate fw-semibold" t-att-style="this.headerStyle">
            <i class="oi me-2" data-icon="open_in_new" aria-hidden="true"/>
            <t t-out="this.label"/>
        </header>
        <div class="o_flow_editor_node_body card-body overflow-hidden">
            <div class="small text-muted text-truncate"><t t-out="this.extension"/></div>
        </div>
    </t>

    <t t-name="voip.OutcallFlowNodeConfig">
        <div>
            <label class="form-label" for="o_voip_outcall_extension">Extension</label>
            <input id="o_voip_outcall_extension" class="form-control" type="tel" t-att-value="this.props.draft.data.extension" t-on-input="this.onExtensionInput" placeholder="+32471234567"/>
        </div>
    </t>
</templates>
