<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.FlowNodeConfigurationDialog">
        <Dialog title="this.title">
            <t t-component="this.definition.ConfigComponent" t-key="this.draft.type" t-props="this.configComponentProps"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.apply" type="button"><t t-out="this.applyLabel"/></button>
                <button class="btn btn-secondary" t-on-click="this.cancel" type="button"><t t-out="this.cancelLabel"/></button>
            </t>
        </Dialog>
    </t>
</templates>
