<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.AudioListPlayField">
        <button type="button" class="btn btn-link btn-sm" t-att-disabled="!this.canPlay" t-on-click.stop="this.togglePlay" t-att-aria-label="this.state.isPlaying ? 'Stop' : 'Play'">
            <i class="oi" t-att-data-icon="this.state.isPlaying ? 'stop' : 'play_arrow'" aria-hidden="true"/>
        </button>
    </t>
</templates>
