<?xml version="1.0"?>
<templates>
    <t t-name="voip.VoipCalendarMany2OneField">
        <div class="d-flex align-items-baseline">
            <t t-if="this.props.readonly and this.props.record.data[this.props.name] and this.props.canOpen">
                <i class="oi oi-fw oi-filled text-400 me-2" data-icon="group" aria-hidden="true"/>
            </t>
            <Many2One t-props="this.m2oProps"/>
        </div>
    </t>
</templates>
