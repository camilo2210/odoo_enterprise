<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.LinphoneProvisioningQrCodeField">
        <!-- Without an href this is an anchor in name only: neither focusable nor clickable. -->
        <a t-att-href="this.deepLink">
            <img class="o-voip-LinphoneProvisioningQrCodeField" t-att-src="this.qrCode" t-att-width="this.props.size" t-att-height="this.props.size" alt="Linphone provisioning QR code"/>
        </a>
    </t>
</templates>
