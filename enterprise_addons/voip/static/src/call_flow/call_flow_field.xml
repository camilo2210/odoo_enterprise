<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voip.CallFlowField">
        <div class="o_voip_call_flow_field d-flex flex-column overflow-hidden">
            <section class="o_voip_call_flow_title d-flex align-items-center gap-2 p-3 border-bottom">
                <label t-if="!this.props.readonly" class="form-label fw-semibold text-nowrap mb-0" t-att-for="this.nameInputId"><t t-out="this.nameLabel"/></label>
                <span t-else="" class="form-label fw-semibold text-nowrap mb-0"><t t-out="this.nameLabel"/></span>
                <div class="o_field_widget flex-grow-1">
                    <CharField id="this.nameInputId" name="'name'" record="this.props.record" readonly="this.props.readonly" placeholder="this.namePlaceholder"/>
                </div>
            </section>
            <div class="o_voip_call_flow_body d-flex flex-grow-1 overflow-hidden">
                <FlowNodePalette registry="this.registry" nodes="this.state.nodes" onDrop="this.onNodeDrop.bind(this)" onSelect="this.onNodeSelect.bind(this)" readonly="this.props.readonly"/>
                <div class="o_voip_call_flow_canvas flex-grow-1 overflow-hidden" t-ref="this.canvasRef">
                    <FlowEditor nodes="this.state.nodes" connections="this.state.connections" viewport="this.viewport" allowSelfConnections="true" getNodeComponent="this.getNodeComponent.bind(this)" onConnect="this.onConnect.bind(this)" onConnectionRejected="this.onConnectionRejected.bind(this)" onDisconnect="this.onDisconnect.bind(this)" onDrag="this.onNodeDrag.bind(this)" onNodeClick="this.onNodeClick.bind(this)" onNodeDelete="this.onNodeDelete.bind(this)" onPan="this.onPan.bind(this)" onResize="this.onNodeResize.bind(this)" onViewportChange="this.onViewportChange.bind(this)" readonly="this.props.readonly"/>
                </div>
            </div>
        </div>
    </t>
</templates>
