<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="voip_call_flow_view_list" model="ir.ui.view">
        <field name="name">voip.call.flow.list</field>
        <field name="model">voip.call.flow</field>
        <field name="arch" type="xml">
            <list duplicate="false">
                <field name="name"/>
                <field name="node_count" width="110"/>
            </list>
        </field>
    </record>

    <record id="voip_call_flow_view_form" model="ir.ui.view">
        <field name="name">voip.call.flow.form</field>
        <field name="model">voip.call.flow</field>
        <field name="arch" type="xml">
            <form class="o_voip_call_flow_form" duplicate="false">
                <field name="name" invisible="1"/>
                <field name="graph_data" widget="voip_call_flow_editor" nolabel="1" class="w-100"/>
            </form>
        </field>
    </record>

    <record id="action_voip_call_flow_window" model="ir.actions.act_window">
        <field name="name">Call Flows</field>
        <field name="res_model">voip.call.flow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="visually-hidden">Example of a configured call flow.</p>
            <div class="o_voip_call_flow_sample" aria-hidden="true">
                <img src="/voip/static/src/img/voip_call_flow_sample.svg" alt=""/>
            </div>
        </field>
    </record>

    <menuitem id="voip_call_flow_menu" name="Call Flows" parent="voip.voip_pbx_configuration_menu" action="action_voip_call_flow_window" sequence="11" groups="voip.group_voip_admin"/>
</odoo>
