<?xml version="1.0"?>
<odoo>
    <record id="view_requirement_group_submit_form" model="ir.ui.view">
        <field name="name">voip.requirement.group.submit.form</field>
        <field name="model">voip.requirement.group</field>
        <field name="arch" type="xml">
            <form string="Requirements" create="False" delete="False">
                <field name="filtered_requirement_ids" nolabel="True" readonly="True"
                       context="{'did_number_id': context.get('did_number_id')}"/>
                <footer>
                    <button name="action_fulfill_requirements" type="object" string="Submit" class="btn-primary" icon="upload"
                            invisible="context.get('did_number_id')"/>
                    <button name="action_fulfill_requirements" type="object" string="Update" class="btn-primary" icon="upload"
                            invisible="not context.get('did_number_id')"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
