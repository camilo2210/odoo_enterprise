<?xml version="1.0"?>
<odoo>
    <data>
        <template id="message_call_activity_done" inherit_id="mail.message_activity_done">
            <xpath expr="//span[@t-field='activity.summary']" position="replace">
                <t t-set="call" t-value="activity.call_ids[-1:]"/>
                <t t-if="call">
                    <a href="#" t-att-data-oe-model="call._name" t-att-data-oe-id="call.id" class="o_label_info text-primary fw-bold">
                        <t t-out="call.activity_done_label"/>
                    </a>
                    <span t-if="activity.summary"> - <t t-out="activity.summary"/></span>
                    <t name="recording_label_xpath_target" t-if="call.has_recording">
                        <i class="oi ms-1 text-muted" data-icon="graphic_eq" aria-hidden="true"/>
                        <span class="visually-hidden">Recording available</span>
                    </t>
                </t>
                <t t-else="">
                    <t>$0</t>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
