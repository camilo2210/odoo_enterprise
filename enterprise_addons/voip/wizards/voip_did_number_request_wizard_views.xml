<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="voip_did_number_request_view_form" model="ir.ui.view">
        <field name="name">voip.did.number.request.wizard.view.form</field>
        <field name="model">voip.did.number.request.wizard</field>
        <field name="arch" type="xml">
            <form disable_autofocus="1">
                <label for="recipient_ids" string="To:" class="me-1"/>
                <field name="recipient_ids" widget="many2many_tags" nolabel="1" readonly="True" class="mb-4"/>
                <field name="body_html" nolabel="1" placeholder="Why do you need a phone number?"
                       options="{'height': 100}"/>
                <footer>
                    <button string="Send" class="btn-primary" type="object" name="action_send_request" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="voip_did_number_request_action" model="ir.actions.act_window">
        <field name="name">Request a phone number</field>
        <field name="res_model">voip.did.number.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
