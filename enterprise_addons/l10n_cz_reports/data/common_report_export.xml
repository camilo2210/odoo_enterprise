        <VetaD
            t-att-d_poddp="veta_d['date_issue']"
            t-att-dokument="veta_d['document']"
            t-att-ctvrt="veta_d.get('quarter')"
            t-att-mesic="veta_d.get('month')"
            t-att-rok="veta_d['year']"
            t-att-khdph_forma="veta_d.get('control_report_form')"
            t-att-shvies_forma="veta_d.get('vies_report_form')"
            t-att-dapdph_forma="veta_d.get('vat_report_form')"
            t-att-typ_platce="veta_d.get('vat_report_submitter_type')"
            t-att-c_okec="veta_d.get('vat_report_economic_activity_code')"
            k_uladis="DPH"
        />
    </template>
    <template id='veta_p'>
        <VetaP
            t-att-c_pracufo="veta_p.get('workplace_code')"
