            t-att-naz_obce="veta_p.get('city')"
            t-att-stat="veta_p.get('country')"
            t-att-dic="veta_p['vat']"
            t-att-email="veta_p.get('email')"
            t-att-typ_ds="veta_p['company_type']"
            t-att-zkrobchjm="veta_p.get('company_name')"
            t-att-opr_jmeno="veta_p.get('authorized_person_first_name')"
            t-att-opr_prijmeni="veta_p.get('authorized_person_surname')"
            t-att-opr_postaveni="veta_p.get('authorized_person_relationship')"
            t-att-sest_jmeno="veta_p.get('contact_first_name')"
            t-att-sest_prijmeni="veta_p.get('contact_surname')"
            t-att-sest_telef="veta_p.get('contact_phone')"
        />
    </template>
</odoo>
