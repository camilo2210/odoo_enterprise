<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cz_tax_return_type" model="account.return.type">
            <field name="name">Tax</field>
            <field name="report_id" ref="l10n_cz.l10n_cz_vat_declaration"/>
            <field name="country_id" ref="base.cz" />
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
        </record>

        <record id="cz_vat_control_statement_return_type" model="account.return.type">
            <field name="name">VAT Control Statement</field>
            <field name="report_id" ref="l10n_cz_reports.control_statement_report"/>
            <field name="country_id" ref="base.cz" />
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
        </record>

        <record id="cz_vies_summary_return_type" model="account.return.type">
            <field name="name">VIES Summary</field>
            <field name="report_id" ref="l10n_cz_reports.vies_summary_report"/>
            <field name="country_id" ref="base.cz" />
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
            <field name="auto_generate" eval="False"/>
        </record>
    </data>
</odoo>
