#. module: ai_esg
#: model:mail.template,body_html:ai_esg.mail_template_data_ai_esg_assign_emission_factors_failure
msgid ""
"<div>\n"
"                    <p>The request to assign emission factors to your "
"emission lines using AI has been completed. Note that some emissions could "
"not get assigned due to unexpected errors.</p>\n"
"                    <p>You can review the emissions assigned in your ESG app."
"</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Anmodningen om at tildele emissionsfaktorer til dine "
"emissionslinjer med AI er afsluttet. Bemærk, at nogle emissioner ikke kunne "
"tildeles på grund af uventede fejl.</p>\n"
"                    <p>Du kan gennemgå de tildelte emissioner i din ESG-"
"app.</p>\n"
"                </div>\n"
"            "

#. module: ai_esg
#: model:mail.template,body_html:ai_esg.mail_template_data_ai_esg_assign_emission_factors_success
msgid ""
"<div>\n"
"                    <p>The request to assign emission factors to your "
"emission lines using AI has been successfully completed.</p>\n"
"                    <p>You can review the emissions assigned in your ESG app."
"</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Anmodningen om at tildele emissionsfaktorer til dine "
"emissionslinjer med AI er blevet gennemført.</p>\n"
"                    <p>Du kan gennemgå de tildelte emissioner i din ESG-"
"app.</p>\n"
"                </div>\n"
"            "

