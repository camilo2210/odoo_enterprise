<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_se_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@name='o_split_button']" position="attributes">
            <!-- Cannot use the sweden blackbox with the bill splitting -->
            <attribute name="t-if">!this.pos.useBlackBoxSweden()</attribute>
        </xpath>
    </t>
</templates>
