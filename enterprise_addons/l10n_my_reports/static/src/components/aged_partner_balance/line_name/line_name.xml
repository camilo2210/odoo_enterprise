<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="l10n_my_reports.AgedPartnerBalanceLineName" t-inherit="account_reports.AgedPartnerBalanceLineName" t-inherit-mode="extension">
        <xpath expr="//t[@data-id='line_buttons']" position="inside">
            <t t-if="this.props.line.unfoldable?.() &amp;&amp; !this.props.line.id().includes('no_partner') &amp;&amp; this.controller.action.xml_id === 'account_reports.action_account_report_ar' &amp;&amp; this.controller.report.company_country_code === 'MY'">
                <button
                    class="btn btn_action"
                    t-on-click="(ev) => this.controller.reportAction(ev, 'action_print_report_statement_account', { line_id: this.props.line.id() })"
                >
                    Statement of Account
                </button>
            </t>
        </xpath>
    </t>

</templates>
