<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_return_type_form_view" model="ir.ui.view">
            <field name="name">account.return.type.form</field>
            <field name="model">account.return.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="is_master_data" invisible="1"/>
                        <field name="is_tax_return_type" invisible="1"/>
                        <group>
                            <field name="category" widget="radio" options="{'horizontal': true}" readonly="is_master_data"/>
                            <group colspan="2">
                                <h1>
                                    <field name="name" placeholder="Tax Return" invisible="category != 'account_return'"/>
                                    <field name="name" placeholder="Audit" invisible="category != 'audit'"/>
                                </h1>
                            </group>
                            <group>
                                <field name="deadline_periodicity"/>
                                <field name="deadline_start_date" invisible="deadline_periodicity == 'fiscalyear'"/>
                                <label for="deadline_days_delay" class="o_form_label"/>
                                <div class="d-flex align-items-left">
                                    <field name="deadline_days_delay" style="width: 15%" class="o_form_field text-center"/>
                                    <span style="width: 85%">days after tax period</span>
                                </div>
                                <field name="states_workflow" invisible="category == 'audit' or is_master_data" required="1"/>
                                <field name="tax_payable_account_id" invisible="not is_tax_return_type"/>
                                <field name="tax_receivable_account_id" invisible="not is_tax_return_type"/>
                                <field name="advance_tax_payment_account_id" invisible="not is_tax_return_type"/>
                            </group>
                            <group>
                                <field name="country_id" string="Country" invisible="category == 'audit'"/>
                                <field name="report_id"/>
                                <field name="payment_partner_id" invisible="category == 'audit'"/>
                                <field name="payment_partner_bank_id" invisible="category == 'audit'" context="{'default_partner_id': payment_partner_id}"/>
                            </group>
                            <group string="Tax Closing Rounding" invisible="not is_tax_return_type">
                                <field name="tax_closing_rounding_profit_account_id"/>
                                <field name="tax_closing_rounding_loss_account_id"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="account_return_type_list_view" model="ir.ui.view">
            <field name="name">account.return.type.list.view</field>
            <field name="model">account.return.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="is_tax_return_type" column_invisible="1"/>
                    <field name="tax_closing_account_placeholder" column_invisible="1"/>    <!-- Needed for placeholder_field -->
                    <field name="name" string="Return Name"/>
                    <field name="category" string="Type" optional="hide"/>
                    <field name="deadline_periodicity"/>
                    <field name="tax_payable_account_id"
                           widget="account_reports.forced_placeholder"
                           readonly="not is_tax_return_type"
                           decoration-muted="not tax_payable_account_id"
                           options="{'placeholder_field': 'tax_closing_account_placeholder'}"/>
                    <field name="tax_receivable_account_id"
                           widget="account_reports.forced_placeholder"
                           readonly="not is_tax_return_type"
                           decoration-muted="not tax_receivable_account_id"
                           options="{'placeholder_field': 'tax_closing_account_placeholder'}"/>
                    <field name="advance_tax_payment_account_id"
                           optional="hide"
                           widget="account_reports.forced_placeholder"
                           readonly="not is_tax_return_type"
                           decoration-muted="not advance_tax_payment_account_id"
                           options="{'placeholder_field': 'tax_closing_account_placeholder'}"/>
                    <field name="country_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="account_return_type_search_view" model="ir.ui.view">
            <field name="name">account.return.type.search.view</field>
            <field name="model">account.return.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="report_id"/>
                    <field name="country_id"/>
                    <field name="deadline_periodicity"/>
                    <field name="deadline_start_date"/>
                    <field name="payment_partner_id"/>
                    <field name="payment_partner_bank_id"/>

                    <filter name="tax_return" string="Tax Return" domain="[('category', '=', 'account_return')]"/>
                    <filter name="audit" string="Audit" domain="[('category', '=', 'audit')]"/>

                    <filter name="groupby_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="groupby_country" string="Country" context="{'group_by': 'country_id'}"/>
                    <filter name="groupby_periodicity" string="Periodicity" context="{'group_by': 'deadline_periodicity'}"/>
                </search>
            </field>
        </record>

        <record id="action_view_account_return_types" model="ir.actions.act_window">
            <field name="name">Return Types</field>
            <field name="res_model">account.return.type</field>
            <field name="view_id" ref="account_reports.account_return_type_list_view"/>
            <field name="context">{'active_test': False}</field>
        </record>
    </data>
</odoo>
