"t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                    <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,</"
"t>\n"
"                    <br/>\n"
"                    Please find enclosed the list of your open invoices.\n"
"                    <br/>\n"
"                    Do not hesitate to contact us if you have any "
"questions.\n"
"                    <br/>\n"
"                    Sincerely,\n"
"                    <br/>\n"
"                    <t t-out=\"object._get_followup_responsible().name if "
"is_html_empty(object._get_followup_responsible().signature) else "
"object._get_followup_responsible().signature\"/>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
