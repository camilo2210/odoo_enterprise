<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportLineCellEditableBoolean">
        <input type="text"
                class="o_input text-end user-select-none"
                t-ref="this.inputRef"
                t-att-data-no-format="this.inputNoFormatValue"
                t-on-click.prevent.stop="this.toggleBooleanValue"
                t-att-value="this.inputValue"
                readonly=""
        />
        <i class="oi oi-filled" data-icon="edit"
           t-on-click.prevent.stop="this.toggleBooleanValue"
        />
    </t>
</templates>
