<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="account_reports.BankReconciliationReportLineName" t-inherit="account_reports.AccountReportLineNameCustomizable">
        <t data-id="line_buttons" position="after">
            <t t-set="line" t-value="this.controller.lines[this.props.lineIndex()]"/>
            <t t-if="line and line.warning_text">
                <t t-if="line.warning_action">
                    <a t-on-click="(ev) => this.controller.reportAction(ev, line.warning_action, line.warning_params)" class="cursor-pointer">
                        <i class="oi oi-filled ms-1 text-warning" data-icon="error" t-att-title="line.warning_text"/>
                    </a>
                </t>
                <t t-else="">
                    <i class="oi oi-filled ms-1 text-warning" data-icon="error" t-att-title="line.warning_text"/>
                </t>
            </t>
        </t>
    </t>

</templates>
