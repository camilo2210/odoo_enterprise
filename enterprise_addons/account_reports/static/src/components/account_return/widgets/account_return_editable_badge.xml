<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_reports.AccountReturnEditableBadgeField" >
        <t t-if="this.props.type === 'char'">
            <input type="text" t-att-value="this.props.record.data[this.props.name]" class="bg-transparent border-0"
                t-att-readonly="this.props.readonly"
                t-on-blur="this.updateField" t-on-click="(e) => {e.stopPropagation();}" t-att-placeholder="this.props.placeholder || ''"
                t-att-class="this.props.widget_class || ''"/>
        </t>
        <t t-elif="this.props.type === 'text'">
            <textarea t-att-value="this.props.record.data[this.props.name]" class="bg-transparent border-0" style="resize: none; text-align: justify; text-justify: inter-word; overflow-x: hidden; overflow-wrap: break-word;"
                t-att-readonly="this.props.readonly"
                t-on-blur="this.updateField" t-on-click="(e) => {e.stopPropagation();}" t-att-placeholder="this.props.placeholder || ''"
                t-att-class="this.props.widget_class || ''"  t-on-input="this.resize" t-ref="this.textareaRef"/>
        </t>
    </t>
</templates>
