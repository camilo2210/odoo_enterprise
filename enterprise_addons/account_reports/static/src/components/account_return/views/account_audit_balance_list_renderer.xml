<?xml version="1.0" encoding="utf-8"?>

<templates>
    <t t-name="account_reports.account_audit_balance_list_renderer" t-inherit="web.ListRenderer">
        <xpath expr="//div[@t-ref='this.rootRef']" position="after">
            <div t-att-class="{'o_account_report_chatter_hidden': !this.chatterPlugin.res_id() or this.ui.isSmall()}"
                 class="o_account_report_chatter o-mail-ChatterContainer h-100 o-aside d-flex flex-column border-start"
                 t-ref="this.AuditChatterRef">
                <AccountReportChatter
                    threadId="this.chatterPlugin.res_id()"
                    threadModel="'account.account'"
                    date_to="this.chatterPlugin.date_to()"
                    list="this.props.list"
                />
            </div>
        </xpath>
        <xpath expr="//div[@t-ref='this.rootRef']" position="attributes">
            <attribute name="class" add="o_account_report_audit_balance_list" separator=" "/>
        </xpath>
    </t>
</templates>
