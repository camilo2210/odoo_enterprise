<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_audit_custom_target" model="ir.actions.server">
            <field name="name">Audit Custom Target</field>
            <field name="model_id" ref="model_account_return_check"/>
            <field name="state">code</field>
            <field name="code">
                action = model.action_audit_custom_target(env.context.get('working_file_id'), env.context.get('target'))
            </field>
        </record>

        <record id="action_audit_report" model="ir.actions.server">
            <field name="name">Audit Report</field>
            <field name="model_id" ref="model_account_return_check"/>
            <field name="state">code</field>
            <field name="code">
                action = model.action_audit_report(env.context.get('working_file_id'), env.context.get('action_xml_id'))
            </field>
        </record>
    </data>
</odoo>
