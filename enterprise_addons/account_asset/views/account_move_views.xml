<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="asset_variant_id" groups="account.group_account_readonly,account.group_account_invoice" invisible="1"/>
                <field name="asset_ids" groups="account.group_account_readonly,account.group_account_invoice" invisible="1"/>
                <field name="count_asset" groups="account.group_account_readonly,account.group_account_invoice" invisible="1"/>
                <field name="draft_asset_exists" groups="account.group_account_readonly,account.group_account_invoice" invisible="1"/>
                <button name="open_asset_view"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not asset_variant_id"
                    class="oe_stat_button"
                    icon="deployed_code"
                    type="object">
                    <field name="asset_id_display_name" nolabel="1"/>
                </button>
                <button name="action_open_asset_ids"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    type="object"
                    class="oe_stat_button"
                    icon="badge"
                    invisible="count_asset == 0 or draft_asset_exists">
                    <field string="Asset(s)" name="count_asset" widget="statinfo"/>
                </button>
                <button name="action_open_asset_ids"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    type="object"
                    class="oe_stat_button text-danger"
                    icon="badge"
                    invisible="count_asset == 0 or not draft_asset_exists">
                    <field string="Asset(s)" name="count_asset" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="inside">
                <field name="asset_move_type"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not asset_variant_id and not asset_ids"
                    readonly="0"
                />
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//group[@id='other_tab_entry_group']//group[@name='misc_group']" position="inside">
                <field name="asset_move_type"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not asset_variant_id and not asset_ids"
                    readonly="0"
                />
            </xpath>
            <xpath expr="//field[@name='account_id']" position="before">
                <!-- the depreciation model is shown under account not in a separate column due to widget m2o_cell_with_extra_fields -->
                <field name="depreciation_model_id" optional="show"/>
                <field name="display_depreciation_model" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.line.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <group string="Related Assets" groups="account.group_account_invoice,account.group_account_readonly" invisible="not asset_ids">
                    <field name="asset_ids" nolabel="1"/>
                </group>
            </field>
        </field>
    </record>

    <record model="ir.actions.server" id="action_account_aml_to_asset">
        <field name="name">Create Asset</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.turn_as_asset()
        </field>
    </record>
</odoo>
