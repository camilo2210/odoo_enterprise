<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="l10n_co_edi_pos.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
        <div name="header" position="inside">
            <t t-if="l10n_co_edi_pos">
                <t t-set="header" t-value="l10n_co_edi_pos['header']"/>

                <div class="receipt_header_l10n_co_edi_type">
                    <t t-if="header['l10n_co_edi_type'] == '1'">Factura Electrónica de Venta</t>
                    <t t-else="">Nota Crédito Electrónica</t>
                </div>

                <div class="receipt_header_l10n_co_edi_document_number">Número de Documento: <t t-out="header['sequence_number']"/></div>
                <div class="receipt_header_l10n_co_edi_authorization_number">DIAN resolution: <t t-out="header['l10n_co_edi_dian_authorization_number']"/></div>
                <div class="receipt_header_l10n_co_edi_date_range">Fecha efectiva desde <t t-out="header['l10n_co_edi_dian_authorization_date']"/> a <t t-out="header['l10n_co_edi_dian_authorization_end_date']"/></div>
                <div>Número de secuencia desde</div>
                <div class="receipt_header_l10n_co_edi_sequence_range"><t t-out="header['l10n_co_edi_min_range_number']"/> a <t t-out="header['l10n_co_edi_max_range_number']"/></div>
                <div class="receipt_header_l10n_co_edi_payment_option">Metodo de Pago: <t t-out="header['l10n_co_edi_pos_payment_option_id']['name']"/></div>

                <div class="receipt_header_l10n_co_edi_payment_option_code">
                    <t t-set="payment_option_code" t-value="header['l10n_co_edi_pos_payment_option_id']['code']"/>
                    <t t-if="payment_option_code == '1'">Termino de Pago: Contado</t>
                    <t t-if="payment_option_code == '2'">Termino de Pago: Crédito</t>
                </div>
            </t>
        </div>
    </template>

    <template id="l10n_co_edi_pos.pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
        <div name="before-footer" position="inside">
            <t t-if="l10n_co_edi_pos">
                <t t-set="before_footer" t-value="l10n_co_edi_pos['before_footer']"/>

                <div class="d-flex flex-column align-items-center mt-4">
                    <!-- Client info -->
                    <div class="receipt_l10n_co_edi_partner_name">Razón social / Nombre: <t t-out="before_footer['partner_name']"/></div>
                    <div class="receipt_l10n_co_edi_identification_type">Tipo de identificación: <t t-out="before_footer['identification_type']"/></div>
                    <div class="receipt_l10n_co_edi_identification_number">Número de identificación: <t t-out="before_footer['identification_number']"/></div>
                    <div class="receipt_l10n_co_edi_address">Dirección: <t t-out="before_footer['address']"/></div>

                    <!-- Company info -->
                    <div class="receipt_l10n_co_edi_large_taxpayer mt-3">
                        <t t-if="before_footer['large_taxpayer']">Somos Grandes Contribuyentes</t>
                        <t t-else="">No Somos Grandes Contribuyentes</t>
                    </div>

                    <div class="receipt_l10n_co_edi_fiscal_regimen">Regimen fiscal: <t t-out="before_footer['fiscal_regimen_description']"/></div>
                    <div>Responsabilidad Tributaria:</div>
                    <div class="receipt_l10n_co_edi_obligation_type_description"><t t-out="before_footer['obligation_type_description']"/></div>
                    <img alt="Barcode" t-att-src="before_footer['barcode_src']" class="mt-3"/>
                </div>
            </t>
        </div>
    </template>

    <template id="l10n_co_edi_pos.pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer">
        <div name="footer" position="inside">
            <t t-if="l10n_co_edi_pos">
                <t t-set="footer" t-value="l10n_co_edi_pos['footer']"/>

                <div class="d-flex flex-column align-items-center">
                    <br/>
                    <t t-if="footer['document_state'] == 'invoice_accepted'">
                        <t t-foreach="footer['cufe_chunks']" t-as="chunk">
                            <div t-if="chunk_first">CUFE: <t t-out="chunk"/></div>
                            <div t-else=""><t t-out="chunk"/></div>
                        </t>
                        <div class="receipt_l10n_co_edi_signing_time mt-2">Fecha de firma: <t t-out="footer['signing_time']"/></div>
                        <div class="receipt_l10n_co_edi_issue_date_time">Fecha de emisión: <t t-out="footer['issue_date']"/> <t t-out="footer['issue_time']"/></div>
                    </t>
                    <div>Generado por Software Propio</div>
                    <div class="receipt_l10n_co_edi_pos_serial_number">Número de serie del punto de venta: <t t-out="footer['l10n_co_edi_pos_serial_number']"/></div>
                </div>
            </t>
        </div>
    </template>
</odoo>
