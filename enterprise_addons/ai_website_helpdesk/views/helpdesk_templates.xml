<odoo>
    <template id="ai_website_helpdesk.ai_helpdesk_knowledge" inherit_id="website_helpdesk.knowledge_base">
        <xpath expr="//section[@id='help_search_section']" position="replace">
            <div t-ignore="true">
                <section class="s_ai_livechat pt64 pb96 o_colored_level"
                    data-snippet="s_ai_livechat"
                    data-name="AI Livechat"
                    t-attf-data-livechat-channel-id="{{ channel_id }}"
                    t-attf-data-agent-id="{{ ai_agent }}">
                    <div class="o_container_small" data-name="ai_livechat_container">
                        <h1 class="h3-fs">Need help?<br/></h1>
                        <div class="ai_livechat_component py-2"/>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[@id='help_search_box']" position="replace"/>
    </template>
</odoo>
