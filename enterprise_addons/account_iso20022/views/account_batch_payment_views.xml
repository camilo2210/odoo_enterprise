<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_batch_payment_form_inherit" model="ir.ui.view">
            <field name="name">sct.account.batch.payment.form.inherit</field>
            <field name="model">account.batch.payment</field>
            <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="after">
                    <field name="invalid_sct_partners_ids" invisible="1"/> <!-- invalid_sct_partners_ids needed for computation so it should be called and stay invisible -->
                    <div class="alert alert-danger" invisible="not invalid_sct_partners_ids" role="alert">
                        The country or city of <a type="object" name="action_invalid_partners_from_sct">these partners</a>
                        is not set, which could cause the file to be refused by the bank.
                    </div>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="iso20022_batch_booking" string="Batch Booking" invisible="payment_method_code not in ['sepa_ct', 'iso20022', 'iso20022_se', 'iso20022_ch']"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
