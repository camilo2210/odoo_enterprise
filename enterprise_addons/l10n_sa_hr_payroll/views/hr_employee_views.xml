<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group string='Saudi Payroll Information' invisible="company_country_code != 'SA'">
                    <field name="l10n_sa_employee_code" placeholder="e.g. 3141592653"/>
                    <label for="l10n_sa_remaining_annual_leave_balance" string="Annual Leave Balance"
                           help="Number of valid allocated leave days that are annual leave days"/>
                    <div class="o_row" name="l10n_sa_remaining_annual_leave_balance">
                        <field name="l10n_sa_remaining_annual_leave_balance" class="o_hr_narrow_field"/>
                        <span>days</span>
                    </div>
                    <field name="l10n_sa_eos_number_of_days_in_year"/>

                    <separator string="Allowances"/>
                    <label for="l10n_sa_housing_allowance" string="Housing"/>
                    <div class="o_row" name="l10n_sa_housing_allowance">
                        <field class="o_hr_narrow_field" name="l10n_sa_housing_allowance"/>
                        <span invisible="wage_type != 'monthly'">/ month</span>
                        <span invisible="wage_type != 'hourly'">/ hour</span>
                    </div>
                    <label for="l10n_sa_transportation_allowance" string="Transportation"/>
                    <div class="o_row" name="l10n_sa_transportation_allowance">
                        <field class="o_hr_narrow_field" name="l10n_sa_transportation_allowance"/>
                        <span invisible="wage_type != 'monthly'">/ month</span>
                        <span invisible="wage_type != 'hourly'">/ hour</span>
                    </div>
                    <label for="l10n_sa_other_allowances" string="Other"/>
                    <div class="o_row" name="l10n_sa_other_allowances">
                        <field class="o_hr_narrow_field" name="l10n_sa_other_allowances"/>
                        <span invisible="wage_type != 'monthly'">/ month</span>
                        <span invisible="wage_type != 'hourly'">/ hour</span>
                    </div>

                    <separator string="Annual Leaves Provisions"/>
                    <label for="l10n_sa_number_of_days" string="Eligibility"/>
                    <div class="o_row" name="l10n_sa_number_of_days">
                        <field name="l10n_sa_number_of_days" class="o_hr_narrow_field"/>
                        <span>days / year</span>
                    </div>
                </group>
                <group name="l10n_sa_hr_payroll_contributions" string="GOSI" invisible="country_code != 'SA'" colspan="2">
                    <group name="l10n_sa_hr_payroll_contributions_company" string="Company Contributions" >
                        <field name="l10n_sa_company_social_insurance_percentage" string="Social Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_sa_company_oh_insurance_percentage" string="Occupational Hazard Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_sa_company_unemployment_insurance_percentage" string="Unemployment Insurance" class="mw-25" widget="percentage"/>
                    </group>
                    <group name="l10n_sa_hr_payroll_contributions_employee" string="Employee Contributions">
                        <field name="l10n_sa_employee_social_insurance_percentage" string="Social Insurance" class="mw-25" widget="percentage"/>
                        <field name="l10n_sa_employee_unemployment_insurance_percentage" string="Unemployment Insurance" class="mw-25" widget="percentage"/>
                    </group>
                </group>
            </group>
            <field name="identification_id" position="after">
                <field name="l10n_sa_ssn" invisible="country_code != 'SA'"/>
            </field>
        </field>
    </record>
</odoo>
