<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="hr_payslip_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.view.form</field>
            <field name="model">hr.payslip</field>
            <field name="priority">20</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <field name="issues" position="before">
                    <div class="alert alert-info" role="alert" invisible="country_code != 'SA' or schedule_pay != '30_monthly'">
                        Working Schedule is set to Monthly (30); the number of worked days may vary per month, <br/>
                        but the month is strictly treated as 30 days and the daily wage computed accordingly. <br/>
                        Any Overflows are deferred to the next payslips.
                    </div>
                </field>
                <xpath expr="//field[@name='payment_report']" position="after">
                    <field name="l10n_sa_wps_file_reference" readonly="1" invisible="country_code != 'SA' or not l10n_sa_wps_file_reference"/>
                </xpath>
            </field>
        </record>
</odoo>
