<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_certificate_wizard_form" model="ir.ui.view">
        <field name="name">certificate.wizard.form</field>
        <field name="model">certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Signing Certificate">
                <group>
                    <field name="certificate_data"
                       filename="certificate_filename"/>
                    <field name="certificate_name"/>
                    <field name="pkcs12_password" password="True"/>
                </group>
                <footer>
                    <button name="action_create_certificate" type="object" class="btn-primary" string="Save"/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
