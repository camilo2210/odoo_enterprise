<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="sign.upload_pdf_button">
        <input
            t-ref="this.signButtons.uploadFileInputRef"
            type="file"
            multiple="true"
            accept="application/pdf, application/x-pdf, application/vnd.cups-pdf"
            class="o_sign_template_file_input o_input_file o_hidden"
        />
        <a t-att-class="this.props.btnClass" type="object" t-on-click="() => this.onClickUpload('sign_send_request')">
            <t t-out="this.props.title"/>
        </a>
    </t>
</templates>
