<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.SignRefusalDialogTitle" t-inherit="sign.ThankYouDialog" t-inherit-mode="primary">
        <span id="header-title-content" position="replace">
            <span id="header-title-content"><i id="sign-thank-you-icon" class="oi oi-sm p-2 rounded-circle text-warning" data-icon="warning" role="img"/> Signature Declined</span>
        </span>
    </t>
    <t t-name="sign.SignRefusalDialog">
        <Dialog t-props="this.dialogProps">
            <t t-set-slot="header">
                <h4 class="modal-title text-break text-center">
                    Decline Signature
                </h4>
                <button class="btn btn-close shadow-none float-end" t-on-click="this.props.close"/>
            </t>
            <p>
                We'll notify the sender, signer and copied contacts of the signature refusal.
                Your refusal reason will be included.
            </p>
            <div>
                <div class="mb-3 row" t-if="this.isShared">
                    <label for="o_sign_public_signer_name_input" class="col-lg-1 col-form-label o_sign_refuse_label">Name</label>
                    <div class="col-lg-11">
                        <input type="text" t-ref="this.refuseNameRef"
                            id="o_sign_public_signer_name_input"
                            placeholder="Your name" class="form-control"
                            t-on-change="this.checkForChanges"
                            t-on-keyup="this.checkForChanges"
                            t-on-paste="this.checkForChanges"
                        />
                    </div>
                </div>
                <div class="mb-3 row" t-if="this.isShared">
                    <label for="o_sign_public_signer_mail_input" class="col-lg-1 col-form-label o_sign_refuse_label">Email</label>
                    <div class="col-lg-11">
                        <input type="email" t-ref="this.refuseEmailRef"
                            id="o_sign_public_signer_mail_input"
                            placeholder="Your email" class="form-control"
                            t-on-change="this.checkForChanges"
                            t-on-keyup="this.checkForChanges"
                            t-on-paste="this.checkForChanges"
                        />
                    </div>
                </div>
                <div class="mb-3 row">
                    <label for="o_sign_public_signer_reason_input" class="col-lg-1 col-form-label o_sign_refuse_label">Reason</label>
                    <div class="col-lg-11">
                        <textarea class="form-control o_sign_refuse_confirm_message placeholder-spacing"
                            placeholder="Please provide a reason for refusal"
                            t-ref="this.refuseReasonRef"
                            t-on-change="this.checkForChanges"
                            t-on-keyup="this.checkForChanges"
                            t-on-paste="this.checkForChanges"
                        />
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary refuse-button" t-on-click="this.refuse" t-ref="this.refuseButtonRef" disabled="disabled">Decline</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
