<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign.NextDirectSignDialog">
        <Dialog t-props="this.dialogProps">
            <t t-set-slot="header">
                <h4 class="modal-title text-break">
                    <t t-out="this.title"/>
                </h4>
            </t>
            <div class="o_nextdirectsign_message">
                <p t-if="this.lastEmailedName">The signing link was sent to <t t-out="this.lastEmailedName"/>.</p>
                <p t-else="">The signature of <t t-out="this.lastSignedName"/> has been saved.</p>
                <p><t t-out="this.nextSigner"/> is next. They can sign now on this device, or later by email.</p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.goToNextSigner">Next signatory (<t t-out="this.nextSigner"/>)</button>
                <button class="btn btn-secondary" t-on-click="this.continueByEmail">Send by Email</button>
            </t>
        </Dialog>
    </t>
</templates>
