<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ActivityListPopoverItem" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-ActivityListPopoverItem-markAsDone')]" position="after">
            <button t-if="this.showRequestSignButton"
                    class="o-mail-ActivityListPopoverItem-requestSign btn btn-sm btn-success btn-link"
                    title="Request Signature"
                    t-on-click="this.onClickRequestSign">
                <i class="oi" data-icon="edit_square"/>
            </button>
            <button
                t-if="this.activity().sign_request_id and this.activity().activity_category == 'sign_request'"
                class="o-mail-ActivityListPopoverItem-requestSign btn btn-sm btn-success btn-link"
                title="Resend"
                t-on-click="this.onClickResendSignRequest">
                <i class="oi" data-icon="refresh"/>
            </button>
            <button
                t-if="this.activity().sign_request_id and this.needMySignature and this.activity().activity_category == 'sign_request'"
                class="o-mail-ActivityListPopoverItem-requestSign btn btn-sm btn-success btn-link"
                title="Sign Now"
                t-on-click="this.onClickSignNow">
                <i class="oi" data-icon="edit_square"/>
            </button>
        </xpath>
    </t>
</templates>
