<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignTemplateCustomCogMenu">
        <Dropdown>
            <button class="btn btn-light border-0 px-1 py-0 lh-sm" title="Actions" data-hotkey="u">
                <i class="oi oi-fw oi-filled" data-icon="settings"/>
            </button>
            <t t-set-slot="content">
                <t t-if="this.showEditButton">
                    <DropdownItem class="'o_menu_item'" onSelected.bind="this.props.onEditTemplate">
                        <i class="oi oi-fw oi-filled" data-icon="article"/> Edit
                    </DropdownItem>
                </t>
                <t t-if="!this.props.signTemplate.active &amp;&amp; !this.state.properties">
                    <DropdownItem class="'o_menu_item'" onSelected.bind="this.props.onTemplateSaveClick">
                        <i class="oi oi-fw" data-icon="save"/> Save as Template
                    </DropdownItem>
                </t>
                <t t-if="this.props.manageTemplateAccess">
                    <DropdownItem class="'o_menu_item'" onSelected.bind="this.onAccessRightsClick">
                        <i class="oi oi-fw oi-filled" data-icon="group"/> Access Rights
                    </DropdownItem>
                </t>
                <DropdownItem class="'o_menu_item'" onSelected.bind="this.onTemplatePropertiesClick">
                    <i class="oi oi-fw oi-filled" data-icon="settings"/> Configuration
                </DropdownItem>
                <DropdownItem class="'o_menu_item'" onSelected.bind="this.onPreviewClick">
                    <i class="oi oi-fw" data-icon="visibility"/> Preview
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
