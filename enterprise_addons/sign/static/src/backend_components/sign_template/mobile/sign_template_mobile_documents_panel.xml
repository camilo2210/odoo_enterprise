<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignTemplateMobileDocumentsPanel">
        <div class="o_sign_mobile_documents_panel d-flex flex-column h-100">
            <div class="flex-grow-1 overflow-auto">
                <t t-foreach="this.props.documents.filter((doc) => !doc.deleted).sort((a, b) => a.sequence - b.sequence)" t-as="document" t-key="document.id">
                    <t t-call="sign.SignTemplateSidebar.DocumentRow"/>
                </t>
            </div>
            <div t-if="!this.props.hasSignRequests and this.props.canAddDocument !== false" class="p-2 border-top">
                <input
                    type="file"
                    multiple="true"
                    t-ref="this.signButtons.uploadFileInputRef"
                    accept="application/pdf, application/x-pdf, application/vnd.cups-pdf"
                    class="o_sign_template_file_input o_input_file o_hidden"
                />
                <button class="btn btn-primary w-100" t-on-click="() => this.signButtons.requestFile('sign_send_request')">Add Document</button>
            </div>
        </div>
    </t>
</templates>
