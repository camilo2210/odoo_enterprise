<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignTemplateMobileSignersPanel">
        <div class="o_sign_mobile_signers_panel d-flex flex-column h-100">
            <div class="flex-grow-1 overflow-auto">
                <t t-foreach="this.props.signers" t-as="signer" t-key="signer.id">
                    <SignTemplateMobileSignerRow t-props="this.getSignerRowProps(signer.id)"/>
                </t>
            </div>
            <div t-if="!this.props.hasSignRequests" class="p-2 border-top">
                <button class="btn btn-primary w-100" t-on-click="this.onClickAddSigner">Add Signer</button>
            </div>
        </div>
    </t>
</templates>
