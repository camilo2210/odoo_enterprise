<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="sign.SignRequest" class="d-flex flex-column h-100">
        <SignRequestControlPanel t-props="this.controlPanelProps"/>
        <div class="o_content">
            <div class="o_sign_document mx-3 border border-bottom-0 rounded-4 rounded-bottom-0 overflow-hidden" t-ref="this.signDocumentRef">
                <t t-out="this.markupHtml"/>
                <Document t-props="this.documentProps"/>
            </div>
        </div>
    </div>
</templates>
