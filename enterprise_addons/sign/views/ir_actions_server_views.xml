<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_view_form_sign" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.sign</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('d-flex')]" position="after">
                <group invisible="state != 'sign'">
                    <group name="sign_template" colspan="2">
                        <field name="sign_template_id" placeholder="Choose a template..." required="state == 'sign'" options="{'no_create': True}"/>
                    </group>
                    <group name="signers" colspan="2" invisible="not sign_template_id">
                        <field name="sign_role_ids" widget="ir_action_role_config" nolabel="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
