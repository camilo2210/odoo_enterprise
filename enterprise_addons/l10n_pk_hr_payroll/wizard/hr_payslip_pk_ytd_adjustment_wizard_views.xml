<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_pk_ytd_adjustment_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.pk.ytd.tax.adjustment.wizard.view.form</field>
        <field name="model">l10n.pk.ytd.tax.adjustment.wizard</field>
        <field name="arch" type="xml">
        <form string="End of year Tax Adjustment">
            <group>
                <group>
                    <field name="ytd_gross"/>
                </group>
                <group>
                    <field name="ytd_tax_amount"/>
                </group>
            </group>
            <group>
                <field name="warning" class="alert alert-warning" role="alert" nolabel="1" invisible="not warning"/>
            </group>
            <footer>
                <button name="action_confirm_pk_adjustment" type="object" string="Confirm" class="btn btn-primary"/>
                <button string="Discard" class="btn btn-secondary" special="cancel"/>
            </footer>
        </form>
        </field>
    </record>
</odoo>
