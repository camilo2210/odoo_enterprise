<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_financial_report_export" model="ir.ui.view">
            <field name="name">l10n_lv_tax_report.periodic.vat.xml.export.form</field>
            <field name="model">l10n_lv_tax_report.periodic.vat.xml.export</field>
            <field name="arch" type="xml">
                <form string="Export Options">
                    <div>
                        Choose option(s) before exporting XML
                    </div>
                    <group>
                         <group>
                             <field name="clarification"/>
                         </group>
                    </group>
                    <footer>
                        <button string='Export XML' name="print_xml" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
               </form>
            </field>
        </record>

    </data>
</odoo>
