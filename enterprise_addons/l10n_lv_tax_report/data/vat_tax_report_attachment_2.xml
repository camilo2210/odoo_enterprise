<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <record id="l10n_lv_vat_main_tax_report_attachment_2" model="account.report">
        <!-- VAT 2: Estimated tax on supplied goods and services (EU)-->
        <field name="name">Attachment 2</field>
        <field name="name@lv">Pielikums 2</field>
        <field name="sequence">5</field>
        <field name="country_id" ref="base.lv"/>
        <field name="availability_condition">country</field>
        <field name="custom_handler_model_id" ref="model_l10n_lv_tax_report_handler"/>
        <field name="column_ids">
            <record id="vat_report_2_partner_vat" model="account.report.column">
                <field name="name">Partner VAT</field>
                <field name="name@lv">Partneris PVN</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_2_base_amount" model="account.report.column">
                <field name="name">Base Amount</field>
                <field name="name@lv">Pamatsumma</field>
                <field name="expression_label">base_amount</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_2_transaction_type" model="account.report.column">
                <field name="name">Transaction Type</field>
                <field name="name@lv">Darījuma veids</field>
                <field name="expression_label">transaction_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_2_partner_replacement_VAT" model="account.report.column">
                <field name="name">Partner Replacement VAT</field>
                <field name="name@lv">Partnera aizstāšana PVN</field>
                <field name="expression_label">partner_replacement_vat</field>
                <field name="figure_type">string</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_lv_vat_main_tax_report_attachment_2_line" model="account.report.line">
                <field name="name"></field>
                <field name="name@lv"></field>
                <field name="groupby">transaction</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="l10n_lv_vat_main_tax_report_attachment_2_line_partner_vat" model="account.report.expression">
                        <field name="label">partner_vat</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_2</field>
                        <field name="subformula">partner_vat</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_2_line_base_amount" model="account.report.expression">
                        <field name="label">base_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_2</field>
                        <field name="subformula">base_amount</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_2_line_transaction_type" model="account.report.expression">
                        <field name="label">transaction_type</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_2</field>
                        <field name="subformula">transaction_type</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_2_line_partner_replacement_vat" model="account.report.expression">
                        <field name="label">partner_replacement_vat</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_2</field>
                        <field name="subformula">partner_replacement_vat</field>
                        <field name="auditable" eval="False"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
