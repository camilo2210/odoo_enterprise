<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <record id="l10n_lv_vat_main_tax_report_attachment_1iii" model="account.report">
        <!-- VAT 1-III: Estimated tax on supplied goods and services (domestic)-->
        <field name="name">Attachment 1-III</field>
        <field name="name@lv">Pielikums 1-III</field>
        <field name="sequence">4</field>
        <field name="country_id" ref="base.lv"/>
        <field name="availability_condition">country</field>
        <field name="custom_handler_model_id" ref="model_l10n_lv_tax_report_handler"/>
        <field name="column_ids">
            <record id="vat_report_1iii_partner_vat" model="account.report.column">
                <field name="name">Partner VAT</field>
                <field name="name@lv">Partneris PVN</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1iii_partner_name" model="account.report.column">
                <field name="name">Partner Name</field>
                <field name="name@lv">Partnera nosaukums</field>
                <field name="expression_label">partner_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1iii_vat_declaration_line_number" model="account.report.column">
                <field name="name">VAT Declaration Line Number</field>
                <field name="name@lv">PVN deklarācijas rindas Nr.</field>
                <field name="expression_label">vat_declaration_line_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1iii_base_amount" model="account.report.column">
                <field name="name">Base Amount</field>
                <field name="name@lv">Pamatsumma</field>
                <field name="expression_label">base_amount</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_1iii_vat_amount" model="account.report.column">
                <field name="name">VAT Amount</field>
                <field name="name@lv">PVN summa</field>
                <field name="expression_label">vat_amount</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="False"/>
            </record>
            <record id="vat_report_1iii_document_type" model="account.report.column">
                <field name="name">Doc. Type</field>
                <field name="name@lv">Dok. veids</field>
                <field name="expression_label">document_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1iii_document_number" model="account.report.column">
                <field name="name">Doc. Number</field>
                <field name="name@lv">Dok. numurs</field>
                <field name="expression_label">document_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_report_1iii_document_date" model="account.report.column">
                <field name="name">Doc. Date</field>
                <field name="name@lv">Dok. datums</field>
                <field name="expression_label">document_date</field>
                <field name="figure_type">date</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line" model="account.report.line">
                <field name="name"></field>
                <field name="name@lv"></field>
                <field name="groupby">transaction</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_partner_vat" model="account.report.expression">
                        <field name="label">partner_vat</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">partner_vat</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_partner_name" model="account.report.expression">
                        <field name="label">partner_name</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">partner_name</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_vat_declaration_line_number" model="account.report.expression">
                        <field name="label">vat_declaration_line_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">vat_declaration_line_number</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_base_amount" model="account.report.expression">
                        <field name="label">base_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">base_amount</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_vat_amount" model="account.report.expression">
                        <field name="label">vat_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">vat_amount</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_document_type" model="account.report.expression">
                        <field name="label">document_type</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">document_type</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_document_number" model="account.report.expression">
                        <field name="label">document_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">document_number</field>
                        <field name="auditable" eval="False"/>
                    </record>
                    <record id="l10n_lv_vat_main_tax_report_attachment_1iii_line_document_date" model="account.report.expression">
                        <field name="label">document_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_l10n_lv_vat_main_tax_report_attachment_1iii</field>
                        <field name="subformula">document_date</field>
                        <field name="auditable" eval="False"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
