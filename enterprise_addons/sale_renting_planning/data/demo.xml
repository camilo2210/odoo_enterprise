<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="luxury_room_planning" model="planning.role">
        <field name="name">Luxury Room</field>
        <field name="resource_ids" eval="[
            Command.create({'name': f'Room {room_number}', 'resource_type': 'material'})
            for room_number in range(101, 104)
        ]"/>
        <field name="sync_shift_rental">True</field>
        <field name="product_ids" eval="[Command.set([ref('sale_renting.luxury_room_template')])]"/>
        <field name="color">5</field>
    </record>

    <record id="sale_renting.luxury_room_template" model="product.template">
        <field name="planning_enabled">True</field>
        <field name="planning_role_id" ref="luxury_room_planning"/>
    </record>

</odoo>
