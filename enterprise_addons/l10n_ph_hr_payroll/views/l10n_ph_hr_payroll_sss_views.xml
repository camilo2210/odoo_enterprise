<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ph_hr_payroll_sss_view_form" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.sss_contribution.view.form</field>
        <field name="model">l10n_ph_hr_payroll.sss_contribution</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <button name="action_confirm_declaration" position="before">
                <button name="action_generate_txt" string="Export File" type="object" class="btn-secondary" invisible="state != 'done'"/>
            </button>
            <p name="save_warning" position="attributes">
                <attribute name="invisible">1</attribute>  <!-- As we don't print PDF files for this report, this warning is irrelevant -->
            </p>
            <xpath expr="//group[@name='first_group']/group" position="inside">
                <field name="txt_file" filename="txt_filename" readonly="1" invisible="not txt_file"/>
                <field name="txt_filename" invisible="1"/>  <!-- for the name of the downloaded txt_file -->
            </xpath>
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_sss_view_tree" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.sss_contribution.view.list</field>
        <field name="model">l10n_ph_hr_payroll.sss_contribution</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_list"/>
        <field name="mode">primary</field>
    </record>

    <record id="l10n_ph_hr_payroll_sss_action" model="ir.actions.act_window">
        <field name="name">SSS Contribution</field>
        <field name="res_model">l10n_ph_hr_payroll.sss_contribution</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
