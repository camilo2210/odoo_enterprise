<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ph_hr_payroll_previous_employment_view_form" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.previous_employment.view.form</field>
        <field name="model">l10n_ph_hr_payroll.previous_employment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Employer Name..."/></h1>
                    </div>
                    <group>
                        <field name="currency_id" invisible="1"/> <!-- for the monetary fields -->
                        <group string="General information" colspan="2">
                            <field name="employee_id" widget="many2one_avatar_employee" invisible="not id"/>
                            <field name="tin" placeholder="000-000-000-000"/>
                            <field name="address"/>
                            <field name="zip"/>
                        </group>
                        <group string="Non-Taxable &amp; Exempt Amounts" class="text-nowrap">
                            <field name="nontax_basic_mwe"/>
                            <field name="holiday_pay"/>
                            <field name="overtime_pay"/>
                            <field name="night_shift_differential"/>
                            <field name="hazard_pay"/>
                            <field name="nontax_de_minimis"/>
                            <field name="nontax_13th_month"/>
                            <field name="nontax_statutory_contributions"/>
                            <field name="nontax_salaries_other"/>
                            <field name="nontaxable_income"/>
                        </group>
                        <group string="Taxable Amounts &amp; Tax Withheld" class="text-nowrap">
                            <field name="taxable_basic_salary"/>
                            <field name="taxable_13th_month"/>
                            <field name="taxable_salaries_other"/>
                            <field name="taxable_income"/>
                            <field name="tax_withheld"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_previous_employment_view_list" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.previous_employment.view.list</field>
        <field name="model">l10n_ph_hr_payroll.previous_employment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
