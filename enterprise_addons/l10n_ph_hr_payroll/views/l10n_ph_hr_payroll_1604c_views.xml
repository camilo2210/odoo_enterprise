<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ph_hr_payroll_1604c_view_form" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.form_1604c.view.form</field>
        <field name="model">l10n_ph_hr_payroll.form_1604c</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <p name="save_warning" position="attributes">
                <attribute name="invisible">1</attribute>  <!-- As we don't print PDF files for this report, this warning is irrelevant -->
            </p>
            <sheet position="before">
                <div class="alert alert-warning" role="alert" invisible="not warning_text">
                    <field name="warning_text" class="fw-bold"/>
                </div>
            </sheet>
            <button name="action_confirm_declaration" position="after">
                <button name="action_generate_files" string="Generate Files" type="object" class="btn-primary" invisible="not lines_count or state != 'done'"/>
            </button>
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_1604c_view_tree" model="ir.ui.view">
        <field name="name">l10n_ph_hr_payroll.form_1604c.view.list</field>
        <field name="model">l10n_ph_hr_payroll.form_1604c</field>
        <field name="inherit_id" ref="l10n_ph_hr_payroll.l10n_ph_hr_payroll_declaration_view_list"/>
        <field name="mode">primary</field>
    </record>

    <record id="l10n_ph_hr_payroll_1604c_action" model="ir.actions.act_window">
        <field name="name">Form 1604-C</field>
        <field name="res_model">l10n_ph_hr_payroll.form_1604c</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
