<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No termination pay -->

    <record id="hr.departure_fired" model="hr.departure.reason">
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
    </record>

    <record id="hr.departure_resigned" model="hr.departure.reason">
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">R</field>
    </record>

    <record id="hr_departure_reason_end_of_contract" model="hr.departure.reason">
        <field name="sequence">3</field>
        <field name="name">Contract Expired</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_awol" model="hr.departure.reason">
        <field name="sequence">4</field>
        <field name="name">Abandoned Work</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_misconduct" model="hr.departure.reason">
        <field name="sequence">5</field>
        <field name="name">Fired (Serious Misconduct)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_fraud" model="hr.departure.reason">
        <field name="sequence">6</field>
        <field name="name">Fired (Fraud or Breach of Trust)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_crime" model="hr.departure.reason">
        <field name="sequence">7</field>
        <field name="name">Fired (Crime Commission)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_other" model="hr.departure.reason">
        <field name="sequence">8</field>
        <field name="name">Fired (Other Analogous Causes)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <!-- Retirement Pay -->

    <record id="hr.departure_retired" model="hr.departure.reason">
        <field name="l10n_ph_hr_payroll_terminal_pay_type">retirement</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">TR</field>
    </record>

    <record id="hr_departure_reason_optional_retirement" model="hr.departure.reason">
        <field name="sequence">9</field>
        <field name="name">Retired (Optional)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">retirement</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">TR</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_mandatory_retirement" model="hr.departure.reason">
        <field name="sequence">10</field>
        <field name="name">Retired (Mandatory)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">retirement</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">TR</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <!-- Severance Pay (Full) -->

    <record id="hr_departure_reason_automation_separated" model="hr.departure.reason">
        <field name="sequence">11</field>
        <field name="name">Separated (Automation)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_full</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_redundancy" model="hr.departure.reason">
        <field name="sequence">12</field>
        <field name="name">Declared Redundant</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_full</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_impossible_reinstatement" model="hr.departure.reason">
        <field name="sequence">13</field>
        <field name="name">Separated (Impossible Reinstatement)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_full</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <!-- Severance Pay (Half) -->

    <record id="hr_departure_reason_retrenchement" model="hr.departure.reason">
        <field name="sequence">14</field>
        <field name="name">Retrenched (To Prevent Losses)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_half</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_closure" model="hr.departure.reason">
        <field name="sequence">15</field>
        <field name="name">Separated (Business Closure)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_half</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_disease" model="hr.departure.reason">
        <field name="sequence">16</field>
        <field name="name">Separated (Disease)</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type">severance_half</field>
        <field name="l10n_ph_hr_payroll_bir_separation_code">T</field>
        <field name="country_id" ref="base.ph"/>
    </record>

    <record id="hr_departure_reason_deceased" model="hr.departure.reason">
        <field name="sequence">17</field>
        <field name="name">Deceased</field>
        <field name="l10n_ph_hr_payroll_terminal_pay_type" eval="False"/>
        <field name="l10n_ph_hr_payroll_bir_separation_code">D</field>
        <field name="country_id" ref="base.ph"/>
    </record>
</odoo>
