        <field name="sequence">230</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = (categories['CASH_FRINGE_BENEFITS'] + categories['NON_CASH_FRINGE_BENEFITS']) and version.l10n_ph_hr_payroll_employee_rank not in (False, 'rank_and_file')</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
employee_type = 'non-residents' if version.is_non_resident else 'residents'
tax_rate = payslip._rule_parameter('l10n_ph_hr_payroll_fringe_benefits_tax_rates')[employee_type] / 100.0
divisor = 1.0 - tax_rate
result = ((categories['CASH_FRINGE_BENEFITS'] + categories['NON_CASH_FRINGE_BENEFITS']) / divisor) * tax_rate
        </field>
        <field name="appears_on_payslip">never</field>
