    <!-- Taxes -->
    <record id="l10n_ph_hr_payroll_tax_rule" model="hr.salary.rule">
        <field name="name">Withholding Tax</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.WTH_TAX')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">WITHH_TAX</field>
        <field name="sequence">150</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
tax_tables = payslip._rule_parameter('l10n_ph_hr_payroll_tax_rates')
tax_table = tax_tables.get(version.schedule_pay)
needs_conversion = False
if not tax_table:  # Bi-weekly doesn't have its own table; so we use the monthly table and do conversion to get the tax.
    tax_table = tax_tables['monthly']
    needs_conversion = True

gross_wages = result_rules['GROSS']['total']
if needs_conversion:
    gross_wages = version._l10n_ph_hr_payroll_from_to_schedule(amount=gross_wages, to_schedule='monthly')

# Find the correct contribution rate in the table
tax_amount = previous_ceiling = 0
for ceiling, tax_rate, fixed_amount in tax_table:
    if ceiling is None or gross_wages &lt;= ceiling:
        excess = gross_wages - previous_ceiling
        tax_amount = fixed_amount + (excess * (tax_rate / 100.0))
        break
    previous_ceiling = ceiling

if needs_conversion:
    result = -version._l10n_ph_hr_payroll_from_to_schedule(amount=tax_amount, from_schedule='monthly')
else:
    result = -tax_amount
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_tax_annualization_rule" model="hr.salary.rule">
        <field name="name">Tax Annualization</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.TAX_ANN')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">TAX_ANNUALIZATION</field>
        <field name="sequence">160</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = payslip.l10n_ph_hr_payroll_includes_tax_annualization
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
total_gross = ytd_gross + result_rules['GROSS']['total']
total_tax_withheld = ytd_wthh_tax + result_rules['WITHH_TAX']['total']
yearly_tax_table = payslip._rule_parameter('l10n_ph_hr_payroll_tax_rates').get('yearly')

# In the first year of employment, we count the amounts from the previous employer as well.
if prev_employment := payslip.employee_id._l10n_ph_get_previous_employment(payslip.date_to):
    total_gross += prev_employment.taxable_income
    total_tax_withheld -= prev_employment.tax_withheld

total_tax_due = previous_ceiling = 0
for ceiling, tax_rate, fixed_amount in yearly_tax_table:
    if ceiling is None or total_gross &lt;= ceiling:
        excess = total_gross - previous_ceiling
        total_tax_due = fixed_amount + (excess * (tax_rate / 100.0))
        break
    previous_ceiling = ceiling

calculated_adjustment = -(total_tax_due + total_tax_withheld)

if calculated_adjustment > 0:
    # Cap refunds to the total amount of tax withheld by the employer themselves
    max_refundable = abs(ytd_wthh_tax + result_rules['WITHH_TAX']['total'])
    result = min(calculated_adjustment, max_refundable)
else:
    result = calculated_adjustment
        </field>
    </record>

