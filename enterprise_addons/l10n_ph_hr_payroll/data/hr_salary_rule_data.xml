        <field name="code">GROSS</field>
        <field name="appears_on_payslip">never</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
taxable_salary = categories['TA'] + categories['TAX_NON_CASH_EARNINGS'] + categories['PRE_TAX_DEDUCTIONS']

if not version.l10n_ph_hr_payroll_minimum_wage_earner:
    # Minimum wage earners are exempt of taxes on their basic salary, ECOLA and differentials.
    taxable_salary += categories['PH_BASIC'] + categories['OT'] + categories['ECOLA']

if version.l10n_ph_hr_payroll_employee_rank in (False, 'rank_and_file'):
    taxable_salary += categories['CASH_FRINGE_BENEFITS'] + categories['NON_CASH_FRINGE_BENEFITS']

result = max(taxable_salary, 0)
        </field>
