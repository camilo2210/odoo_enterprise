    <!-- Gross -->
    <record id="l10n_ph_hr_payroll_gross_rule" model="hr.salary.rule">
        <field name="name">Taxable Salary</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.GROSS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
