        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Holds the amount in this payslip that will contribute to the 13th month.
# Using a provisional rule allow to easily account for possible raise and changes in the basic salary.
# This would also allow to make two (or more) partial 13th month payslip for companies wanting to, as allowed by law.
result = (result_rules['BASIC']['total'] + result_rules.get('TARD', {}).get('total', 0)) / 12
        </field>
