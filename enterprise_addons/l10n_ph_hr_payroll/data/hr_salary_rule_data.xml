    <record id="l10n_ph_hr_payroll_separation_pay_rule" model="hr.salary.rule">
        <field name="name">Separation Pay</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.NT_ALW')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="code">SEPARATION</field>
        <field name="sequence">22</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip.l10n_ph_hr_payroll_includes_separation_pay</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
start_date = payslip.employee_id._get_first_version_date()
end_date = payslip.date_to
months = end_date.month - start_date.month + 12 * (end_date.year - start_date.year)
extra_months = months % 12
years_of_services = (months - extra_months) / 12 + (1 if extra_months >= 6 else 0)
monthly_base_wage = version._l10n_ph_hr_payroll_from_to_schedule(to_schedule='monthly')

terminal_pay_type = payslip.version_id.departure_reason_id.l10n_ph_hr_payroll_terminal_pay_type
if terminal_pay_type == 'severance_full':
    # One month’s pay or one month’s pay for every year of service, whichever is higher.
    result = max(monthly_base_wage, monthly_base_wage * years_of_services)
else:
    # One-half (1/2) month’s pay for every year of service.
    result = (monthly_base_wage / 2) * years_of_services
        </field>
    </record>

