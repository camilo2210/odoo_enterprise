    <record id="l10n_ph_hr_payroll_sss_contribution_rule" model="hr.salary.rule">
        <field name="name">SSS Contribution</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.MANDATORY_SSS_CONTRIBUTIONS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">SSS_CONTRIB</field>
        <field name="sequence">27</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
sss_contrib_table = payslip._rule_parameter('l10n_ph_hr_payroll_monthly_sss_contributions')
monthly_base_amount = version._l10n_ph_hr_payroll_from_to_schedule(amount=categories['TAX_CASH_EARNINGS'], to_schedule='monthly')
# Find the correct contribution rate in the table
for ceiling, er_contrib, ec, ee_contrib in sss_contrib_table:
    if ceiling is None or monthly_base_amount &lt;= ceiling:
        result = -version._l10n_ph_hr_payroll_from_to_schedule(amount=ee_contrib, from_schedule='monthly')
        break
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_philhealth_contribution_rule" model="hr.salary.rule">
        <field name="name">PhilHealth Contribution</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.MANDATORY_PHILHEALTH_CONTRIBUTIONS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">PHILHEALTH_CONTRIB</field>
        <field name="sequence">28</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
philhealth_contrib_table = payslip._rule_parameter('l10n_ph_hr_payroll_monthly_philhealth_contributions')
ee_contrib_pct = philhealth_contrib_table['contributions'][1] / 100.0
monthly_wage = version._l10n_ph_hr_payroll_from_to_schedule(to_schedule='monthly')
monthly_amount = min(
    max(monthly_wage * ee_contrib_pct, philhealth_contrib_table['minimum']),
    philhealth_contrib_table['maximum']
)
result = -version._l10n_ph_hr_payroll_from_to_schedule(amount=monthly_amount, from_schedule='monthly')
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_pag_ibig_contribution_rule" model="hr.salary.rule">
        <field name="name">Pag-IBIG Contribution</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.MANDATORY_PAG_IBIG_CONTRIBUTIONS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">PAG_IBIG_CONTRIB</field>
        <field name="sequence">29</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
pag_ibig_contrib_info = payslip._rule_parameter('l10n_ph_hr_payroll_monthly_pag_ibig_contributions')
pag_ibig_contrib_table = pag_ibig_contrib_info['contributions']['standard']
max_contrib = pag_ibig_contrib_info['maximum']

base_amount = categories['PH_BASIC'] + categories['ECOLA']
monthly_base_amount = version._l10n_ph_hr_payroll_from_to_schedule(amount=base_amount, to_schedule='monthly')

for ceiling, ee_rate, er_rate in pag_ibig_contrib_table:
    if ceiling is None or monthly_base_amount &lt;= ceiling:
        computed = (monthly_base_amount * (ee_rate / 100.0))
        final_contrib = min(computed, max_contrib)
        result = -version._l10n_ph_hr_payroll_from_to_schedule(amount=final_contrib, from_schedule='monthly')
        break
        </field>
    </record>

    <record id="l10n_ph_hr_payroll_tardiness_rule" model="hr.salary.rule">
        <field name="name">Tardiness</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.PRE_TAX_DEDUCTIONS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">TARD</field>
        <field name="sequence">30</field>
        <field name="condition_select">python</field>
