    <record id="l10n_ph_hr_payroll_13th_month_rule" model="hr.salary.rule">
        <field name="name">13th month</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.BENEFITS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="code">13THMONTH</field>
        <field name="sequence">6</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip.l10n_ph_hr_payroll_includes_13th_month</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
last_13th_month_payslip = payslip.search([
    ('employee_id', '=', payslip.employee_id.id),
    ('date_to', '&lt;', payslip.date_from),
    ('l10n_ph_hr_payroll_includes_13th_month', '=', True),
    ('state', 'in', ['validated', 'paid']),
], order="date_from desc", limit=1)
if last_13th_month_payslip:
    date_from = last_13th_month_payslip.date_to + relativedelta(days=1)
else:
    date_from = payslip.employee_id._get_first_version_date()
provision_payslips = payslip.search([
    ('employee_id', '=', payslip.employee_id.id),
    ('date_from', '&gt;=', date_from),
    ('date_to', '&lt;=', payslip.date_to),
    ('state', 'in', ['validated', 'paid']),
])
if not provision_payslips:
    # Employee having worked less than a month are not entitled to 13th month.
    result = 0
provision_amount = provision_payslips._get_line_values(['13THMONTHPROVISION'], compute_sum=True)['13THMONTHPROVISION']['sum']['total']
total_basic = sum(payslip.worked_days_line_ids.mapped('l10n_ph_hr_payroll_basic_amount'))
provision_amount += total_basic / 12  # We recalculate the current month, since the provision is calculated later
result = provision_amount
        </field>
    </record>

    <!-- De Minimis, see their own file -->

    <record id="l10n_ph_hr_payroll_de_minimis_excess_rule" model="hr.salary.rule">
        <field name="name">Excess De Minimis</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.BENEFITS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="code">DM_EXCESS</field>
        <field name="sequence">17</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
de_minimis_codes = payslip.struct_id.rule_ids.filtered(lambda l: 'DE_MINIMIS' in l.category_ids.mapped('code')).mapped('code')
code_values = payslip._l10n_ph_hr_payroll_get_property_inputs_value(de_minimis_codes)
daily_wage = version._l10n_ph_hr_payroll_from_to_schedule(to_schedule='daily')
# Calculates the uncapped total. Leave monetization have extra steps to get the amount so we do separately.
total_uncapped = sum(value for code, value in code_values.items() if code in de_minimis_codes and code != 'DM_LEAVE_MONETIZATION')
total_uncapped += code_values.get('DM_LEAVE_MONETIZATION', 0) * daily_wage

total_capped = sum(result_rules.get(code, {}).get('total', 0.0) for code in de_minimis_codes)

# We don't want to show it IF there are excess, but it's difficult to know. So we compute the value, and save its result.
# This way, we can hide it when not required while at the same time avoiding recalculating twice.
result_rules["DM_EXCESS"]['total'] = total_uncapped - total_capped
result = result_rules["DM_EXCESS"]['total']
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = result_rules["DM_EXCESS"]['total']
        </field>
        <field name="appears_on_payslip">non_zero</field>
    </record>

