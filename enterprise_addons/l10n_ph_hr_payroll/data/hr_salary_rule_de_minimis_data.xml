    <record id="l10n_ph_hr_payroll_de_minimis_leave_monetization_rule" model="hr.salary.rule">
        <field name="name">Monetized Unused Vacation Leave (Private)</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.DE_MINIMIS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="code">DM_LEAVE_MONETIZATION</field>
        <field name="sequence">16</field>
        <field name="condition_select">property_input</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
amount = (inputs['DM_LEAVE_MONETIZATION'].amount if 'DM_LEAVE_MONETIZATION' in inputs else 0.0)
cap = payslip._rule_parameter('l10n_ph_hr_payroll_de_minimis_cap')['DM_LEAVE_MONETIZATION']
used_amount = de_minimis_used_amount.get('DM_LEAVE_MONETIZATION', 0.0)

# Special rule, the cap and amount are days. the monetary value is the capped day multiplied by the daily wage.
remaining_amount = max(0, cap['amount'] - used_amount)
days_to_monetize = min(amount, remaining_amount)
daily_wage = version._l10n_ph_hr_payroll_from_to_schedule(to_schedule='daily')

result = days_to_monetize * daily_wage
        </field>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
    </record>
