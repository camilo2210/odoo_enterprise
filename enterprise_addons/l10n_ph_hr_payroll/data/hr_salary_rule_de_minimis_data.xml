    <record id="l10n_ph_hr_payroll_de_minimis_rice_subsidy_rule" model="hr.salary.rule">
        <field name="name">Rice Subsidy</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.DE_MINIMIS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="code">DM_RICE</field>
        <field name="sequence">7</field>
        <field name="condition_select">property_input</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
amount = (inputs['DM_RICE'].amount if 'DM_RICE' in inputs else 0.0)
cap = payslip._rule_parameter('l10n_ph_hr_payroll_de_minimis_cap')['DM_RICE']
used_amount = de_minimis_used_amount.get('DM_RICE', 0.0)

remaining_amount = max(0, cap['amount'] - used_amount)
result = min(amount, remaining_amount)
        </field>
        <field name="input_usage_employee" eval="True"/>
        <field name="input_usage_payslip" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
    </record>

