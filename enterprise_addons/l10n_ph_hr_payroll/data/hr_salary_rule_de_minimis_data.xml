    <record id="l10n_ph_hr_payroll_de_minimis_daily_meal_rule" model="hr.salary.rule">
        <field name="name">Daily Meal Allowance (Overtime / Night Shift)</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_ph_hr_payroll.DE_MINIMIS')])]"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_ph_hr_payroll.hr_payroll_structure_ph_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.ph"/>
        <field name="appears_on_employee_cost_dashboard" eval="True"/>
        <field name="code">DM_DAILY_MEAL</field>
        <field name="sequence">13</field>
        <field name="condition_select">property_input</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
amount = (inputs['DM_DAILY_MEAL'].amount if 'DM_DAILY_MEAL' in inputs else 0.0)
cap = payslip._rule_parameter('l10n_ph_hr_payroll_de_minimis_cap')['DM_DAILY_MEAL']
minimum_wage = payslip.version_id.work_location_id.l10n_ph_hr_payroll_min_daily_wage
used_amount = de_minimis_used_amount.get('DM_DAILY_MEAL', 0.0)

# Specifically to this rule, the amount stored is a % applied to the minimum wage
worked_days_count = sum(wd.number_of_days for wd in payslip.worked_days_line_ids if 'WORK' in wd.code or 'OVERTIME' in wd.code or '002.00' in wd.code or '040.00' in wd.code)
cap_amount = minimum_wage * cap['amount'] * worked_days_count

remaining_amount = max(0, cap_amount - used_amount)
result = min(amount, remaining_amount)
        </field>
        <field name="input_usage_employee" eval="True"/>
        <field name="input_usage_payslip" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
    </record>

