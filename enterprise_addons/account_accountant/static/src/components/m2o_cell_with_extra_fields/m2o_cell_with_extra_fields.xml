<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="account.M2OCellWithExtraFields" t-inherit-mode="extension">
        <xpath expr="//div[@id='extra_fields']" position="inside">
            <div t-if="!this.extraDeferredDateInfo.invisible" t-att-class="{'o_cell_wrapper': this.extraDeferredDateInfo.required, 'text-warning': this.extraDeferredDateInfo.decorationWarning}">
                <DateTimeField t-props="this.extraDeferredDateInfo.props"/>
            </div>
        </xpath>
    </t>
</templates>
