<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="account_accountant.TransactionDetailsField">
        <div t-if="this.hasData" class="text-center">
            <i class="oi" data-icon="search"
               t-ref="this.previewRef"
               t-on-mouseenter="this.showPopup"
               t-on-mouseleave="this.hidePopup"/>
        </div>
    </t>

    <t t-name="account_accountant.TransactionDetailsPopover">
        <div class="p-2 popover-content-wrapper"
             t-on-mouseenter="() => this.props.setOverPopover(true)"
             t-on-mouseleave="() => this.props.setOverPopover(false)">
            <t t-out="this.props.formattedData"/>
        </div>
    </t>

</templates>
