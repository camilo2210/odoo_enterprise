<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="account_accountant.BankRecStatementSummary">
        <div class="o_statement_summary d-flex justify-content-between align-items-center w-100 p-2">
            <div name="label_statement_summary" class="d-flex gap-2 align-items-center">
                <h4 t-out="this.label"
                    t-on-click="this.props.action"
                    class="m-0 cursor-pointer"
                    t-att-class="{'text-danger': !this.props.isValid}"/>
                <h6 t-if="this.props.problemDescription"
                    t-out="this.props.problemDescription"
                    class="my-0 ms-2 text-warning"
                />

                <h6 class="my-0 text-info cursor-pointer"
                    t-if="!this.props.isValid and !this.props.isReviewFilterActive"
                    t-on-click="this.props.actionReview"
                >
                    Review
                </h6>
            </div>
            <div t-if="this.amount"
                 class="btn btn-link p-0 fw-bold fs-4"
                 t-on-click="this.props.action"
            >
                <t t-set="dates" t-value="this.formatStatementDates"/>
                <t t-if="dates?.dateFrom">
                    <t t-out="dates.dateFrom"/>
                </t>
                <t t-if="dates?.dateTo">
                    - <t t-out="dates.dateTo"/>
                </t>
                <span class="ms-2" t-out="this.props.amount"/>
            </div>
        </div>
    </t>
</templates>
