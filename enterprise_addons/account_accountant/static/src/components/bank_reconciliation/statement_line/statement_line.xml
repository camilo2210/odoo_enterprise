<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="account_accountant.BankRecStatementLine" t-inherit="web.KanbanRecord" t-inherit-mode="primary">
        <xpath expr="//article" position="replace">
            <article
                    t-att-class="this.getCardClasses()"
                    t-att-data-id="this.record.id"
                    t-att-tabindex="this.record.model.useSampleModel ? -1 : 0"
                    t-custom-click="this.onGlobalClick"
                    t-on-touchstart="this.onTouchStart"
                    t-on-touchmove="this.onTouchMoveOrCancel"
                    t-on-touchcancel="this.onTouchMoveOrCancel"
                    t-on-touchend="this.onTouchEnd"
                    t-ref="this.rootRef">
                <div name="bank_statement_line" class="o_statement_line w-100 p-2" t-on-click="this.selectStatementLine" t-att-class="{'o_selected_statement_line': this.isSelected, 'text-info': this.isDraft}">

                    <button t-if="!this.recordData.statement_id" type="button" class="o_statement_btn d-none d-md-block position-absolute top-0 end-0 btn btn-sm btn-secondary" t-on-click.stop="this.openStatementCreate">
                        Statement
                    </button>
                    <div class="o_grid_container">
                        <div class="o_row">
                            <div class="d-flex gap-3">
                                <div t-att-data-tooltip="this.formattedFullDate">
                                    <t t-out="this.formattedDate"/>
                                </div>
                                <div t-on-click.stop="this.openChatter" t-if="!this.ui.isSmall" class="o_chatter_icon btn-link text-action" t-att-class="{'visible': this.activityNumber or this.hasAttachment()}">
                                    <div t-if="this.activityNumber" class="activity-container position-relative">
                                        <i class="oi oi-lg" data-icon="schedule" role="img" aria-label="Activities"/>
                                        <span class="activity-badge badge rounded-pill" t-out="this.activityNumber"/>
                                    </div>
                                    <i t-elif="this.hasAttachment()"
                                       class="oi oi-lg"
                                       data-icon="attach_file"
                                       role="img"
                                       aria-label="Attachment"
                                    />
                                    <i t-elif="!this.isChatterOpen"
                                       class="oi oi-lg"
                                       data-icon="forum"
                                       role="img"
                                       aria-label="Journal Entry"
                                    />
                                </div>
                            </div>
                            <div class="o_payment_ref user-select-text d-none d-md-block"
                                 t-att-class="this.isUnfolded() ? 'overflow-wrap' : 'text-truncate'">
                                <span class="d-inline">
                                    <t t-if="this.partner">
                                        <a class="fw-bold" href="#" t-on-click.prevent.stop="this.openPartner">
                                            <span t-out="this.partner.display_name" name="statement_line_partner_name"/>
                                        </a>
                                        <button class="btn btn-link oi p-0 align-baseline" data-icon="close_small" t-on-click.stop="this.removePartner" t-if="!this.linesToReconcile().length"/>
                                    </t>
                                    <t t-elif="this.recordData.partner_name">
                                        <span class="fw-bold" t-out="this.recordData.partner_name" name="statement_line_partner_name"/>
                                    </t>
                                    <span t-att-class="this.partner or this.recordData.partner_name ? 'ms-1' : undefined"
                                          t-out="this.recordData.payment_ref"
                                    />
                                </span>
                            </div>
                            <!-- Only available on large screen -->
                            <div class="o_button_line d-none d-md-flex align-items-start">
                                <BankRecButtonList t-props="this.buttonListProps" suspenseAccountLine="this.suspenseAccountLine()" t-if="!this.recordData.is_reconciled or (this.userCanReview and ['todo', 'anomaly'].includes(this.recordData.review_state))"/>
                                <span class="badge rounded-pill py-1 ps-1" t-att-class="{ 'pe-1': !this.isUnfolded(), 'text-success bg-success-subtle': !this.hasInvalidAnalytics(), 'text-warning bg-warning-subtle': this.hasInvalidAnalytics()}" t-if="this.recordData.is_reconciled">
                                    <i t-if="this.hasInvalidAnalytics()" class="oi" data-icon="warning" data-tooltip="Some lines have invalid analytic distribution"/>
                                    <i t-if="!this.hasInvalidAnalytics()" class="oi" data-icon="check"/>
                                    <span t-if="this.isUnfolded()" class="ms-1">
                                        Reconciled
                                    </span>
                                </span>
                                <div t-if="this.recordData.is_reconciled and !this.isUnfolded()" class="text-start text-truncate text-muted" name="reconciled_line_name">
                                    <div t-out="this.recordData.reconciled_lines_name"/>
                                </div>
                                <button class="btn btn-link p-0 text-600" t-on-click.stop="this.undoReconciliation" t-if="this.isUnfolded() and this.recordData.is_reconciled and !this.recordData.move_id.inalterable_hash" data-tooltip="Undo reconciliation">
                                    <i class="oi" data-icon="undo"/>
                                </button>
                            </div>
                            <div class="d-flex align-items-start justify-content-between o_line_amount">
                                <span class="text-muted w-50 text-end text-nowrap" t-if="this.recordData.foreign_currency_id">
                                    <t t-out="this.formattedAmountCurrencyInForeign"/>
                                </span>
                                <span t-att-class="this.amountClasses" class="text-end text-nowrap" t-out="this.formattedAmount"/>
                            </div>
                            <div class="d-none d-md-block text-end" t-on-click.stop="this.toggleUnfold" t-if="this.recordData.is_reconciled and this.linesToReconcile().length">
                                <i class="oi" t-attf-data-icon="{{this.isUnfolded() ? 'keyboard_arrow_up' : 'keyboard_arrow_down'}}"/>
                            </div>
                            <div class="d-none d-md-block" t-else=""/> <!-- To keep empty space if no chevron -->
                        </div>

                        <!-- Only available on small screen -->
                        <div class="o_row d-md-none">
                            <span class="text-truncate o_payment_ref"
                                  t-out="this.recordData.payment_ref"
                            />
                        </div>
                        <t t-if="this.isUnfolded() or !this.recordData.is_reconciled">
                            <t t-foreach="this.linesToReconcile()" t-as="line" t-key="line_index">
                                <BankRecLineToReconcile statementLine="this.record" line="line"/>
                            </t>
                            <div class="o_row" t-if="this.linesToReconcile().length">
                                <div t-if="this.suspenseAccountLine()" class="d-none d-md-flex fw-bold text-muted align-items-center justify-content-end o_line_amount" t-att-class="this.allLinesInSameForeignCurrency() ? 'w-50' : 'w-100'">
                                    <t t-out="this.suspenseAccountLineFormattedAmount"/>
                                </div>
                            </div>
                        </t>
                        <div class="o_row d-md-none">
                            <div class="o_button_line">
                                <BankRecButtonList t-props="this.buttonListProps" suspenseAccountLine="this.suspenseAccountLine()" t-if="!this.recordData.is_reconciled or (this.userCanReview and ['todo', 'anomaly'].includes(this.recordData.review_state))"/>
                                <div t-if="this.recordData.is_reconciled" class="d-flex gap-2 mt-2">
                                    <span class="badge rounded-pill py-1 ps-1" t-att-class="{ 'pe-1': !this.isUnfolded(), 'text-success bg-success-subtle': !this.hasInvalidAnalytics(), 'text-warning bg-warning-subtle': this.hasInvalidAnalytics()}">
                                        <i t-if="this.hasInvalidAnalytics()" class="oi" data-icon="warning" data-tooltip="Some lines have invalid analytic distribution"/>
                                        <i t-if="!this.hasInvalidAnalytics()" class="oi" data-icon="check"/>
                                        <span t-if="this.isUnfolded()" class="ms-1">
                                            Reconciled
                                        </span>
                                    </span>
                                <span t-if="this.recordData.is_reconciled and !this.isUnfolded()" class="text-start text-muted">
                                    <div t-out="this.recordData.reconciled_lines_name"/>
                                </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </xpath>
    </t>
</templates>
