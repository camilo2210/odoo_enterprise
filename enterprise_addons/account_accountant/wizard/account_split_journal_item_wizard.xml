<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_split_journal_item_view" model="ir.ui.view">
        <field name="name">Split Journal Item</field>
        <field name="model">account.split.journal.item.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Journal Item">
                <field name="line_ids" invisible="1"/> <!-- Needed to fill the fields correctly -->
                <field name="line_currency_id" invisible="1"/> <!-- Needed for monetary widget -->

                <group>
                    <field name="quantity"/>
                    <field name="amount" invisible="show_simple_wizard"/>
                    <field name="account_id" invisible="show_simple_wizard"/>
                </group>
                <footer>
                    <button string="Split" name="split" type="object" default_focus="1" class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
