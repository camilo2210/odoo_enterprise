<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="invoice_cancel_wizard_view" model="ir.ui.view">
        <field name="name">Invoice Cancel</field>
        <field name="model">l10n_gt_edi.cancel</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="l10n_gt_edi_cancel_reason"/>
                </group>
                <footer>
                    <button string="Cancel invoice" name="button_cancel" type="object" class="btn-primary"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
