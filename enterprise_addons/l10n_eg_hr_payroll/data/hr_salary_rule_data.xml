    <record id="10n_eg_hr_payroll_structure_eg_employee_salary_housing_allowance" model="hr.salary.rule">
        <field name="name">Housing Allowance</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_eg_hr_payroll.hr_salary_rule_category_eg_basic_alw')])]"/>
        <field name="code">HOU</field>
        <field name="sequence">2</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
overtime_codes = ['OVTWD', 'OVTWDN', 'OVTWEND', 'OVTPUB']
working_days_without_overtime = payslip.worked_days_line_ids.filtered(lambda l: l.work_entry_type_id.code not in overtime_codes)
number_of_working_days = sum(working_days_without_overtime.mapped('number_of_days')) or 1
paid_days = working_days_without_overtime.filtered(lambda l: l.work_entry_type_id.amount_rate != 0)
number_of_paid_days = sum(paid_days.mapped('number_of_days'))
result = version.l10n_eg_housing_allowance * number_of_paid_days / number_of_working_days
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_eg_hr_payroll.hr_payroll_structure_eg_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.eg"/>
    </record>

