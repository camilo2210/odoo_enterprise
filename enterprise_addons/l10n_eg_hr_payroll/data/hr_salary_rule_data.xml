    <record id="egypt_end_of_service_provision_salary_rule" model="hr.salary.rule">
        <field name="name">End of Service Provision</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP')])]"/>
        <field name="code">EOSP</field>
        <field name="sequence">45</field>
        <field name="appears_on_payslip">never</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = not version.departure_date and version.l10n_eg_eligible_for_eos</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
compensation = version.wage
if version.l10n_eg_number_of_years &lt; 5:
    compensation /= 2
result = compensation / 12.0
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_eg_hr_payroll.hr_payroll_structure_eg_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.eg"/>
    </record>

    <record id="l10n_eg_salary_rule_annual_leave_provision" model="hr.salary.rule">
        <field name="name">Annual Leave Provision</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.COMP')])]"/>
        <field name="code">ANNUALP</field>
        <field name="sequence">50</field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_eg_hr_payroll.hr_payroll_structure_eg_employee_salary'),
        ])]"/>
        <field name="appears_on_payslip">never</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
overtime_codes = ['OVTWD', 'OVTWDN', 'OVTWEND', 'OVTPUB']
overtime_amount = sum(payslip.worked_days_line_ids.filtered(lambda l: l.work_entry_type_id.code in overtime_codes).mapped('amount'))
salary = categories['BASIC'] + categories['BASICALW'] - overtime_amount
paid_days_line_ids = payslip.worked_days_line_ids.filtered(lambda l: l.work_entry_type_id.amount_rate != 0 and l.work_entry_type_id.code not in overtime_codes)
number_of_paid_days = sum(paid_days_line_ids.mapped('number_of_days')) or 1
result = (salary / number_of_paid_days) * version.l10n_eg_total_leave_days / 12
        </field>
        <field name="country_id" ref="base.eg"/>
    </record>

    <record id="l10n_eg_salary_rule_annual_leave_compensation" model="hr.salary.rule">
        <field name="name">Annual Leave Compensation</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
        <field name="code">ANNUALCOMP</field>
        <field name="sequence">55</field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_eg_hr_payroll.hr_payroll_structure_eg_employee_salary'),
        ])]"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = version.departure_date and version.departure_reason_id and employee._l10n_eg_get_annual_remaining_leaves()[employee.id] &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
overtime_codes = ['OVTWD', 'OVTWDN', 'OVTWEND', 'OVTPUB']
overtime_amount = sum(payslip.worked_days_line_ids.filtered(lambda l: l.work_entry_type_id.code in overtime_codes).mapped('amount'))
salary = categories['BASIC'] + categories['BASICALW'] - overtime_amount
number_of_working_days = sum(payslip.worked_days_line_ids.filtered(lambda l: l.work_entry_type_id.code not in overtime_codes).mapped('number_of_days')) or 1
result = (salary / number_of_working_days) * employee._l10n_eg_get_annual_remaining_leaves()[employee.id]
        </field>
        <field name="country_id" ref="base.eg"/>
    </record>

    <record id="egypt_end_of_service_benefit_salary_rule" model="hr.salary.rule">
        <field name="name">End of Service Benefit</field>
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW')])]"/>
        <field name="code">EOSB</field>
        <field name="sequence">60</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = version.departure_date and version.l10n_eg_eligible_for_eos and version.l10n_eg_number_of_years >= 1.0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
compensation = version.wage
adjusted_number_of_years = version.l10n_eg_number_of_years - (min(5.0, version.l10n_eg_number_of_years) * 0.5)
result = compensation * adjusted_number_of_years
        </field>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_eg_hr_payroll.hr_payroll_structure_eg_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.eg"/>
    </record>

