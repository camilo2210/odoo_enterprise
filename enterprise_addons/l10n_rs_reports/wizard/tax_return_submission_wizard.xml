<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rs_tax_return_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_rs_reports.tax.return.submission.wizard.form</field>
            <field name="model">l10n_rs_reports.tax.return.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download your KMD pdf report</span><br/>
                                        <button string="Download pdf" name="print_pdf" type="object" class="btn-secondary"/>
                                    </div>
                                </li>
                                <li>Log in to <a href="http://www.poreskauprava.gov.rs" target="_blank">Poreska</a></li>
                                <li>Select the right PDV form for VAT</li>
                                <li>Fill in the VAT Form with the Tax report generated in Odoo</li>
                                <li>Validate and Submit the Form on the portal</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
