<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Thread')]" position="attributes">
            <attribute name="t-attf-style" add="{{ this.channel?.isAiChat ? 'padding-bottom: 10px !important;' : '' }}" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-foreach]" position="before">
            <t t-set="isStepsGroupShown" t-value="false"/>
            <t t-set="stepsGroupId" t-value="false"/>
            <t t-set="lastUserMsg" t-value="messages.findLast((msg) => !msg.aiAgentAuthored)"/>
        </xpath>
        <xpath expr="//NotificationMessage" position="before">
            <t t-if="msg.aiAgentAuthored and (!prevMsg?.aiAgentAuthored or !prevMsg.author_id.eq(msg.author_id))">
                <t t-set="isStepsGroupShown" t-value="this.isStepsGroupShown(msg.id)"/>
                <t t-set="stepsGroupId" t-value="msg.id"/>
                <div t-if="lastUserMsg > msg.id or isStepsGroupShown or !this.channel?.isAiGenerating" class="o-agent-header" t-att-class="this.env.inChatWindow ? 'ms-3' : 'ms-2'">
                    <div class="d-flex align-items-baseline">
                        <div class="o-mail-Message-avatarContainer position-relative bg-inherit rounded-3" t-att-class="{'o-inChatWindow': this.env.inChatWindow}">
                            <img class="o-mail-Message-avatar w-100 h-100 rounded-3 object-fit-cover" t-att-src="msg.author_id.avatarUrl"/>
                        </div>
                        <span class="o-mail-Message-author smaller ms-2">
                            <strong class="me-1 fw-bold" t-out="msg.author_id.displayName"/>
                        </span>
                        <small class="o-mail-Message-date o-xsmaller" t-att-title="msg.datetimeMedium" t-out="msg.dateSimpleWithDay"/>
                    </div>
                    <button t-if="!msg.aiIsAgentResponse" class="btn btn-link text-muted fw-normal d-flex gap-1 align-items-center p-0" t-on-click="() => this.toggleStepsGroupVisibility(msg.id)">
                        <span class="text-truncate">Steps taken</span>
                        <i class="oi" t-att-class="isStepsGroupShown ? 'mt-1' : 'o-mt-0_5'" t-attf-data-icon="{{isStepsGroupShown ? 'expand_more' : 'chevron_right'}}"/>
                    </button>
                </div>
            </t>
            <t t-if="msg.aiIsToolUse and isStepsGroupShown">
                <AgentToolSummary message="msg" onBeforeToggle="() => this.preserveScrollPosition()" onAfterToggle="this.applyScroll"/>
            </t>
        </xpath>
        <xpath expr="//Message" position="attributes">
            <attribute name="t-elif" add="and (!msg.aiIsAgentStep or isStepsGroupShown)" separator=" "/>
        </xpath>
        <xpath expr="//Message" position="after">
            <div t-if="msg_last and this.channel?.isAiGenerating" class="mb-n3" t-att-class="this.env.inChatWindow ? 'ms-3' : 'ms-2'">
                <t t-if="this.channel?.aiRootSession?.toolStatus">
                    <div class="mt-3" t-if="isStepsGroupShown">
                        <span class="o-ai-tool-status text-600" t-out="this.channel?.aiRootSession?.toolStatus"/>
                    </div>
                    <div t-else="" class="mt-1">
                        <button class="o-ai-tool-status btn btn-link text-muted fw-normal me-auto overflow-hidden mw-100 d-flex gap-1 align-items-center p-0" t-on-click="() => this.toggleStepsGroupVisibility(stepsGroupId, false)">
                            <span class="text-600" t-out="this.channel?.aiRootSession?.toolStatus"/>
                            <i class="oi o-mt-0_5" data-icon="chevron_right"/>
                        </button>
                    </div>
                </t>
                <div t-else="" class="o-ai-tool-status text-600 mt-1">Thinking</div>
            </div>
        </xpath>
    </t>
    <t t-inherit="mail.Thread.startMessage" t-inherit-mode="extension">
        <xpath expr="//p" position="after">
            <div class="mt-1" t-if="this.sortedPromptButtons.length > 0 and this.showPromptButtons">
                <t t-foreach="this.sortedPromptButtons" t-as="button" t-key="button.localId">
                    <div>
                        <button class="btn btn-secondary ai-chat-prompt-button" t-out="button.name" t-on-click="() => this.onClickPromptButton(button)"/>
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
