<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='mail.Thread.jumpPresent']" position="before">
            <AIUserInputRequest
                t-if="this.channel?.aiInputSession?.userInputRequest"
                t-key="this.channel.aiInputSession.userInputRequest.resumeToken"
                request="this.channel.aiInputSession.userInputRequest"
                thread="this.props.thread"/>
        </xpath>
    </t>
</templates>
