<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="ai.Composer" t-inherit="mail.Composer" t-inherit-mode="extension">
    <xpath expr="//FileUploader" position="attributes">
        <attribute name="acceptedFileExtensions">this.supportedFileTypes</attribute>
    </xpath>
</t>

<t t-name="ai.VoiceMessageTranscribingSpinner">
    <div class="d-flex align-items-center align-self-center text-muted mx-2 py-1 user-select-none">
        <i class="oi oi-fw oi-spin me-2" data-icon="autorenew"/>
        <span class="text-truncate">Transcribing...</span>
    </div>
</t>

</templates>
