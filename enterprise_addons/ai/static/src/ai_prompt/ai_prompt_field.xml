<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="ai.AiPromptField">
        <AiPrompt
            comodel="this.recordSelectorRelation"
            model="this.modelName"
            onChange.bind="this.onChange"
            updatePrompt.bind="this.updatePrompt"
            missingRecordsWarning="this.props.showMissingRecordsWarning ? this.missingRecordsMessage : undefined"
            placeholder="this.props.placeholder"
            prompt="this.prompt"
            readonly="this.props.readonly"
            aiFieldPath="this.updatedFieldName"
            domain="this.props.recordSelectorDomain"/>
    </t>
</templates>
