<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ai.CallDebriefTimeline" t-inherit="mail.CallDebriefTimeline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-CallDebriefTimeline-track')]" position="inside">
            <t t-if="this.props.transcriptLines">
                <t t-foreach="this.props.transcriptLines" t-as="line" t-key="line.startSecRelToCall + '-' + line_index">
                    <div t-if="!line.isGap" class="o-CallDebriefTimeline-transcript-marker position-absolute bottom-100 mb-2 rounded-pill pe-none" t-attf-class="{{line.isActive ? 'o_active bg-info' : (line.isHovered ? 'o_active bg-900' : 'bg-400')}}"
                        t-att-style="this._stylePositionTranscriptMarker(line)"/>
                </t>
            </t>
        </xpath>
    </t>
</templates>
