<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_inherit_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rental</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_renting.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="quotations" position="after">
                <block name="inventory" title="Inventory">
                    <setting
                        id="rental_transfers"
                        string="Rental Transfers"
                        help="Activate to use stock deliveries and receipts for rental orders."
                        documentation="/applications/sales/rental/products.html#multi-location-management-and-transfers"
                    >
                        <field name="group_rental_stock_picking"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
