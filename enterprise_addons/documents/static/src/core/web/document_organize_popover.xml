<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="documents.DocumentOrganizePopover">
        <div class="m-2">
            <span>
                <span t-out="this.addedToText"/>
                <a class="ms-3 me-2" href="#" t-on-click="() => this.props.onOrganizeClick()">Organize</a>
                <i class="oi cursor-pointer" data-icon="close" t-on-click.stop="this.props.close"/>
            </span>
        </div>
    </t>
</templates>
