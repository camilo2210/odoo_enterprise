<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="documents.DocumentsSharedGroupField">
        <t t-set="model" t-value="this.props.record.fields[this.props.name].relation"/>
        <t t-set="record" t-value="this.props.record.data[this.props.name]"/>
        <div class="d-flex align-items-center gap-1">
            <DocumentsGroupAvatar resModel="model" resId="record.id" userIds="this.userIds"/>
            <div class="flex-grow-1 d-flex flex-column">
                <div class="d-flex gap-1">
                    <div t-out="this.props.record.data[this.props.name].display_name"/>
                    <div t-if="this.props.record.data.user_in_group"
                         class="badge d-none d-sm-block rounded-pill text-bg-primary flex-shrink-1">Includes You</div>
                </div>
                <div class="text-truncate text-muted">
                    <span t-if="!this.userCount">No members</span>
                    <span t-elif="this.userCount == 1">1 member</span>
                    <span t-else=""><t t-out="this.userCount"/> members</span>
                </div>
            </div>
        </div>
    </t>

</templates>
