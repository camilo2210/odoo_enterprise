<templates>
    <t t-name="documents.DocumentsDatetimeBtnField">
        <button
            t-ref="this.datetimePickerTargetRef"
            t-attf-class="btn #{this.props.btnClasses ? this.props.btnClasses : 'btn-primary'}"
            t-att-title="this.props.label"
            t-on-click.prevent="() => this.dateTimePicker.open()">
            <i
                class="oi oi-fw"
                t-att-class="this.props.iconClass ? this.props.iconClass : 'oi-filled'"
                t-att-data-icon="this.props.icon ? this.props.icon : 'calendar_today'"
                />
        </button>
    </t>
</templates>
