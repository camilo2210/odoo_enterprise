<templates>
    <t t-name="documents.DocumentsDatetimeField">
        <div class="d-flex align-items-center">
            <div t-att-title="this.props.label" class="text-primary">Exp: <span t-out="this.formattedLocalExpirationDate"/></div>
            <button t-on-click="this.onRemove" class="btn btn-link ms-2 p-0" title="Clear" t-if="!this.props.readonly">
                <i class="oi oi-fw" data-icon="close"/>
            </button>
            <DocumentsDatetimeBtnField name="this.props.name" record="this.props.record" label.translate="Edit"
                btnClasses="'btn-link p-0'" icon="'edit'" iconClass="'oi-filled'" t-if="!this.props.readonly"/>
        </div>
    </t>
</templates>
