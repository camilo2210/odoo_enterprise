<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents.DocumentsKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="attributes">
            <attribute name="className">(this.model.useSampleModel ? 'o_view_sample_data' : '')
                + ' o_documents_content o_documents_kanban'</attribute>
        </xpath>
        <xpath expr="//Layout/t[@t-component='this.props.Renderer']" position="attributes">
            <attribute name="previewStore">this.previewStore()</attribute>
        </xpath>
        <xpath expr="//div[@t-if='this.hasSelectedRecords']" position="attributes">
            <attribute name="t-if">this.hasSelectedRecords &amp;&amp; !this.documentService.state.previewedDocument</attribute>
        </xpath>
        <xpath expr="//ActionMenus" position="attributes">
            <attribute name="t-if">this.showActions</attribute>
        </xpath>
        <xpath expr="//SearchBar" position="attributes">
            <attribute name="autofocus">this.firstLoad || this.documentService.state.shouldFocusSearchBar</attribute>
            <attribute name="inputRef">this.searchInputRef</attribute>
        </xpath>
    </t>

    <t t-name="documents.DocumentsKanbanView.Buttons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-call="documents.DocumentsViews.ControlPanel"/>
        </xpath>
    </t>
</templates>
