<templates xml:space="preserve">
    <t t-name="documents.DocumentsListActionWidget">
        <div class="o_documents_list_actions mt-1 gap-2">
            <t t-foreach="this.actionItems" t-as="item" t-key="item_index">
                <i
                    t-if="item.isVisible()"
                    class="oi oi-fw"
                    t-att-data-icon="item.icon"
                    t-att-title="item.description"
                    t-on-click="item.onActionClicked"
                />
            </t>
        </div>
    </t>
</templates>
