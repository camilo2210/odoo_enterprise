<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_inherit_l10n_hk_payment_autopay" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.l10n_hk_payment_autopay</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_method_line_id']" position="after">
                    <field name="l10n_hk_autopay_account_type"
                            invisible="payment_method_code != 'l10n_hk_mri'"
                            readonly="state != 'draft'"/>
                    <field name="l10n_hk_autopay_account_proxy_id"
                            invisible="l10n_hk_autopay_account_type == 'bban' or payment_method_code != 'l10n_hk_mri'"
                            readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
