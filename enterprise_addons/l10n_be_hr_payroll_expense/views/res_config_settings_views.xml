<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.be.mobility.budget</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_be_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='l10n_be_hr_payroll']" position="inside">
                <setting string="Expense Mobility Categories" help="Any Expense of those categories will be reimbursed with Mobility Budget">
                    <field name="l10n_be_mobility_expense_category_ids" widget="many2many_tags"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
