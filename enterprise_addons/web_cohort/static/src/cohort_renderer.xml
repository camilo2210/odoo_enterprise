<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_cohort.CohortRenderer">
        <div class="o_cohort_renderer" t-att-class="this.props.class">
            <div class="d-flex gap-1 px-3 py-2">
                <div class="btn-group" role="toolbar" aria-label="Main actions">
                    <ReportViewMeasures
                        measures="this.model.metaData.measures"
                        activeMeasures="[this.model.metaData.measure]"
                        onMeasureSelected.bind="this.onMeasureSelected"
                    />
                </div>
                    <div class="btn-group">
                    <ViewScaleSelector scales="this.scales" currentScale="this.model.metaData.interval" setScale.bind="this.setScale" />
                </div>
                    <div class="btn-group">
                    <button class="btn btn-secondary o_cohort_download_button oi"
                            data-icon="download"
                            title="Download as Excel file"
                            t-att-disabled="!this.model.hasData() or this.model.useSampleModel"
                            t-on-click="this.downloadExcel"></button>
                </div>
            </div>
            <t t-set="data" t-value="this.model.data"/>
            <div t-if="data.rows.length" class="table-responsive">
                <table class="o_data_table table table-bordered text-center mb-0">
                    <thead>
                        <tr>
                            <th rowspan="2" class="text-center align-middle">
                                <t t-out="this.model.metaData.dateStartString" />
                            </th>
                            <th rowspan="2" class="text-center align-middle">
                                <t t-out="this.model.metaData.measures[this.model.metaData.measure].string"/>
                            </th>
                            <th colspan="16" class="text-center align-middle">
                                <t t-out="this.model.metaData.dateStopString" /> - By <t t-out="this.model.intervals[this.model.metaData.interval]" />
                            </th>
                        </tr>
                        <tr>
                            <th t-foreach="Array(data.rows[0].columns.length)" t-as="intervalNumber" t-key="intervalNumber_index"
                                class="text-center align-middle"
                            >
                                <t t-if="this.model.metaData.timeline === 'backward'">
                                    <t t-out="intervalNumber_index - (data.rows[0].columns.length - 1)"/>
                                </t>
                                <t t-else="">
                                    +<t t-out="intervalNumber_index"/>
                                </t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data.rows" t-as="row" t-key="row.date"
                            class="o_cohort_row_clickable"
                            t-custom-click.stop="(ev, isMiddleClick) => this.props.onRowClicked(row, isMiddleClick)"
                        >
                            <td class="o_cohort_value text-center align-middle p-0">
                                <t t-out="row.date" />
                            </td>
                            <td class="o_cohort_value text-center align-middle p-0">
                                <t t-out="this.getFormattedValue(row.value)" />
                            </td>
                            <td t-foreach="row.columns" t-as="col" t-key="col.period" class="text-center align-middle p-0">
                                <t t-set="count" t-value="this.mode === 'churn' ? (col.churn_value === '-' ? '' : col.churn_value) : (col.value === '-' ? '' : col.value)" />
                                <t t-set="measure" t-value="this.model.metaData.measures[this.model.metaData.measure].string" />
                                <div class="o_cohort_highlight m-1 rounded p-1"
                                    t-att-title="this.getCellTitle(col.period, measure, count)"
                                    t-attf-style="background-color: rgba(0, 160, 157, {{col.percentage/100.0}}); color: {{col.percentage gt 50 and '#FFFFFF' or 'inherit'}}"
                                    t-att-class="{o_cohort_value: col.value !== '-'}"
                                >
                                    <t t-out="this.formatPercentage(col.percentage / 100.0)"/>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="fw-bold">
                        <tr>
                            <td class="text-center align-middle">Average</td>
                            <td class="text-center align-middle">
                                <t t-out="this.getFormattedValue(data.avg.avg_value)"/>
                            </td>
                            <td t-foreach="data.avg.columns_avg" t-as="col" t-key="col_index" class="text-center align-middle">
                                <t t-if="data.avg.columns_avg[col]['count']">
                                    <t t-out="this.formatPercentage(data.avg.columns_avg[col]['percentage'] / (data.avg.columns_avg[col]['count'] * 100.0))" />
                                </t>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

</templates>
