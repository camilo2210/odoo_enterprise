<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_preset_form_inherit_posurban_piper" model="ir.ui.view">
        <field name="name">pos.preset.form.inherit.restaurant.urbanpiper</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_preset_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='return-mode']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
            <xpath expr="//label[@for='return']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
            <xpath expr="//div[@id='prepration-capacity']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
            <xpath expr="//label[@for='slots_per_interval']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
