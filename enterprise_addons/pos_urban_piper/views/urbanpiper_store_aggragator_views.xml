<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_urbanpiper_store_aggregator_form" model="ir.ui.view">
        <field name="name">urbanpiper.store.aggregator.form</field>
        <field name="model">urbanpiper.store.aggregator</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="delivery_provider_id" widget="many2one_avatar_user" options="{'no_open': True, 'no_create': True}"/>
                            <field name="store_id"/>
                            <field name="payment_method_id" />
                        </group>
                        <group>
                            <field name="pricelist_id"/>
                            <field name="use_create_customer"/>
                            <field name="default_customer_id" invisible="use_create_customer"/>
                            <field name="is_online" widget="boolean_toggle" readonly="not has_active_store_session"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
