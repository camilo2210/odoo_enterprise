<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_urban_piper.DebugWidget" t-inherit="point_of_sale.DebugWidget" t-inherit-mode="extension">
        <xpath expr="//div[@data-tooltip='Export PoS data']" position="before">
            <div t-if="this.showUrbanPiperTestOrderBtn" data-tooltip="Place UrbanPiper Test Order" data-tooltip-delay="0">
                <button class="btn btn-secondary btn-sm text-nowrap" t-on-click="this.placeUrbanPiperTestOrder">
                    <i class="oi" data-icon="add_shopping_cart" aria-hidden="true" /> UrbanPiper Test Order
                </button>
            </div>
        </xpath>
    </t>
</templates>
