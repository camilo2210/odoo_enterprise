<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_slot_report_view_pivot" model="ir.ui.view">
        <field name="name">planning.slot.pivot.inherit.project_timesheet_forecast_field_service_sale</field>
        <field name="inherit_id" ref="project_timesheet_forecast.planning_slot_report_view_pivot_inherit_project_timesheet_forecast"/>
        <field name="model">planning.analysis.report</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='remaining_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='effective_hours']" position="after">
                <field name="effective_hours_cost" invisible="1"/>
                <field name="percentage_hours" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="planning_slot_report_view_graph" model="ir.ui.view">
        <field name="name">planning.slot.pivot.inherit.project_timesheet_forecast_field_service_sale</field>
        <field name="inherit_id" ref="project_timesheet_forecast.planning_slot_report_view_graph_inherit_project_timesheet_forecast"/>
        <field name="model">planning.analysis.report</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='remaining_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='effective_hours']" position="after">
                <field name="effective_hours_cost" invisible="1"/>
                <field name="percentage_hours" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
