<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="planning_field_service_sale_timesheet_barcodes.FSMProductCatalogKanbanController.Buttons"
       t-inherit="ProductCatalogKanbanController.Buttons"
       t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o-kanban-button-back')]" position="after">
            <button type="button"
                    class="btn btn-secondary"
                    t-on-click="this.onScanClick">
                <i class="oi me-1" data-icon="barcode" aria-hidden="true"/>Scan
            </button>
        </xpath>
    </t>
</templates>
