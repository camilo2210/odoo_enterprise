<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="l10n_in_hr_contract_salary_payroll_resume_gross_employee" model="hr.contract.salary.resume">
            <field name="name">Gross</field>
            <field name="value_type">payslip</field>
            <field name="code">GROSS</field>
            <field name="category_id" ref="hr_contract_salary.hr_contract_salary_resume_category_monthly_salary"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="impacts_monthly_total" eval="False"/>
        </record>

        <record id="l10n_in_hr_contract_salary_resume_net_employee" model="hr.contract.salary.resume">
            <field name="name">Net</field>
            <field name="value_type">payslip</field>
            <field name="code">NET</field>
            <field name="category_id" ref="hr_contract_salary.hr_contract_salary_resume_category_monthly_salary"/>
            <field name="impacts_monthly_total" eval="True"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
        </record>

        <record id="l10n_in_hr_contract_salary_resume_final_yearly_costs" model="hr.contract.salary.resume">
            <field name="name">Employer Cost</field>
            <field name="value_type">version</field>
            <field name="code">final_yearly_costs</field>
            <field name="category_id" ref="hr_contract_salary.hr_contract_salary_resume_category_total"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
        </record>

        <record id="l10n_in_hr_contract_salary_resume_monthly_benefits" model="hr.contract.salary.resume">
            <field name="name">Benefits</field>
            <field name="code">monthly_benefits</field>
            <field name="value_type">sum</field>
            <field name="benefit_ids" eval="[
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_medical_insurance')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_insured_spouse')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_insured_first_child')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_insured_second_child')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_phone_subscription')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_internet_subscription')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_meal_vouchers')),
                Command.link(ref('l10n_in_hr_contract_salary.l10n_in_company_transport')),
            ]"/>
            <field name="category_id" ref="hr_contract_salary.hr_contract_salary_resume_category_monthly_benefits"/>
            <field name="structure_type_id" ref="l10n_in_hr_payroll.hr_payroll_salary_structure_type_ind_emp_pay"/>
            <field name="impacts_monthly_total" eval="True"/>
        </record>

    </data>
</odoo>
