<?xml version="1.0" encoding="utf-8"?>
<templates>

<div t-name="documents_spreadsheet.SpreadsheetAction" class="o_spreadsheet_action">
    <SpreadsheetNavbar
        t-props="this.navbarProps"
        model="this.model"
    >
        <t t-set-slot="navbar-additional-actions">
            <a
                title="Toggle favorite"
                t-on-click="this._onSpreadSheetFavoriteToggled"
                class="o-sp-favorite oi oi-lg"
                    t-att-class="{'oi-filled favorite_button_enabled': this.state.isFavorited}"
                    data-icon="star"
            />
        </t>
    </SpreadsheetNavbar>
    <SpreadsheetComponent model="this.model"/>
</div>

</templates>
