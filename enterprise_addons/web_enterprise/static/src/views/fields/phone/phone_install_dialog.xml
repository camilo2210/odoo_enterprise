<?xml version="1.0"?>
<templates>
    <t t-name="web_enterprise.PhoneInstallDialog">
        <Dialog
            title="''"
            size="'xl'"
            contentClass="'o_phone_install_dialog'"
            footer="false"
            withBodyPadding="false"
        >
            <div class="o_phone_install_dialog_promo grid ms-3">
                <div class="g-col-3 d-none d-lg-flex align-items-end">
                    <img
                        class="img-fluid"
                        src="/web_enterprise/static/src/img/phone_install_promo_subject.png"
                        alt="Make and receive calls right from Odoo"
                    />
                </div>
                <div class="g-col-12 g-col-lg-9 d-flex flex-column flex-md-row row-gap-3 flex-nowrap flex-md-wrap">
                    <h2 class="o_phone_install_dialog_heading display-6">
                        Make and receive calls right from Odoo
                    </h2>
                    <div class="grid">
                        <div class="g-col-12 g-col-md-4 pb-3">
                            <p class="lead">
                                Give your team phone numbers and manage business calls in one place.
                            </p>
                            <ul class="list-unstyled o_phone_install_dialog_list ps-4">
                                <li>Buy phone numbers in a few clicks</li>
                                <li>International calls at low prices</li>
                                <li>Log calls on any record</li>
                                <li>Design call flows with menus and queues</li>
                                <li>Record and transcribe calls</li>
                                <li>Use multiple devices</li>
                            </ul>
                            <div class="d-flex flex-wrap gap-2">
                                <button
                                    class="btn btn-lg btn-primary w-100 w-sm-auto"
                                    t-on-click="this.onClickInstall"
                                >
                                    Install App
                                </button>
                                <a
                                    class="o_phone_install_dialog_video btn btn-lg btn-secondary w-100 w-sm-auto"
                                    href="https://youtu.be/sDZErem-PME"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Watch Video
                                </a>
                            </div>
                        </div>
                        <div class="g-col-12 g-col-md-8 d-flex gap-2 align-items-end me-3">
                            <img
                                class="o_phone_install_dialog_screenshot flex-grow-1 min-w-0 rounded-top-3 border border-bottom-0 shadow"
                                t-att-src="this.screenshotProductionSrc"
                                alt="Odoo Phone production call"
                            />
                            <img
                                class="o_phone_install_dialog_screenshot flex-grow-1 min-w-0 rounded-top-3 border border-bottom-0 shadow"
                                t-att-src="this.screenshotDemoSrc"
                                alt="Odoo Phone keypad showing Willie Burke"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
