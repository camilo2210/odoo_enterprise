<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-inherit="web.CalendarController" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_calendar_container')]" position="attributes">
        <attribute name="class" remove="bg-view" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_calendar_header')]" position="attributes">
        <attribute name="class" remove="pe-md-1 py-2 border-bottom" add="mb-3" separator=" "/>
    </xpath>
</t>

</templates>
