<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-inherit="web.KanbanHeader" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_kanban_header')]" position="attributes">
        <attribute name="class" add="d-flex flex-column gap-1 fs-4" remove="py-2" separator=" "/>
        <attribute name="t-att-class">{
                'o_kanban_header_sticky pb-3': this.sticky.isSticky and !this.group.isFolded,
                'pb-2': !this.sticky.isSticky,
                'px-3 mx-n3': !this.group.isFolded,
                'pb-2': !this.uiService.isSmall and this.group.isFolded,
                'py-2': this.uiService.isSmall and this.group.isFolded,
            }
        </attribute>
    </xpath>

    <xpath  expr="//div[hasclass('o_kanban_header_title')]" position="attributes">
        <attribute name="class" add="align-items-center" remove="lh-lg" separator=" "/>
    </xpath>

    <xpath expr="//div[@t-if='!this.group.isFolded'][hasclass('o_column_title')]" position="attributes">
        <attribute name="class" remove="fs-4" separator=" "/>
    </xpath>

    <xpath expr="//button[hasclass('o_kanban_quick_add')]" position="attributes">
        <attribute name="class" add="btn-secondary" remove="btn-light" separator=" "/>
    </xpath>
</t>

</templates>

