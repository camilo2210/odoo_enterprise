<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web_enterprise.EnterpriseNavBar" t-inherit="web.NavBar" t-inherit-mode="primary">
    <xpath expr="//nav" position="attributes">
        <attribute name="t-ref">this.navRef</attribute>
    </xpath>
    <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
        <a t-if="!this.isScopedApp" href="/odoo" class="o_menu_toggle border-0" t-att-class="{'hasImage': this.currentApp?.webIconData, 'hasFaIcon': this.currentApp?.webIcon}" accesskey="h" t-ref="this.menuApps" t-on-click.prevent="() => { this.ui.isSmall ? this._openAppMenuSidebar() : this.hm.toggle() }">
            <t t-if="this.ui.isSmall and !this.hm.hasHomeMenu">
                <t t-call="web.NavBar.AppsMenu.Sidebar"/>
            </t>
            <t t-else="">
                <svg xmlns="http://www.w3.org/2000/svg" class="o_menu_toggle_icon pe-none" width="14px" height="14px" viewBox="0 0 14 14">
                    <g t-foreach="[0, 5, 10]" t-as="Y" t-att-id="'o_menu_toggle_row_' + Y_index" fill="currentColor" t-key="'o_menu_toggle_row_' + Y_index">
                        <rect t-foreach="[0, 5, 10]" t-as="X" width="3" height="3" t-att-x="X" t-att-y="Y" t-key="'o_menu_toggle_cell_' + X_index"/>
                    </g>
                </svg>
                <t t-if="!this.ui.isSmall and this.currentApp">
                    <img
                        t-if="this.currentApp.webIconData"
                        t-att-src="this.currentApp.webIconData"
                        class="o_menu_brand_icon d-inline position-absolute start-0 h-100 ps-1 ms-2"
                        t-att-alt="this.currentApp.name"
                        t-ref="this.appIconRef"/>
                    <i
                        t-elif="this.currentApp.webIcon"
                        class="oi o_menu_brand_icon position-absolute start-0 h-100 ms-2"
                        t-att-data-icon="this.currentApp.webIconClass"
                        t-att-style="'color:' + this.currentApp.webIconColor"/>
                    <span t-out="this.currentApp.name" class="o_menu_brand d-flex ms-3 pe-0"/>
                </t>
            </t>
        </a>
        <a t-else="" t-att-href="this.pwa.startUrl" class="o_menu_toggle" t-ref="this.menuApps">
            <img
                t-if="this.currentApp &amp;&amp; this.currentApp.webIconData"
                t-att-src="this.currentApp.webIconData"
                class="o_menu_brand_icon d-none d-lg-inline position-absolute start-0 h-100 ps-1 ms-2"
                t-att-alt="this.currentApp.name"
                t-ref="this.appIconRef"/>

            <span
                t-if="this.currentApp"
                t-out="this.currentApp.name"
                class="o_menu_brand d-none d-md-flex ps-4 pe-0"/>
        </a>
    </xpath>
    <xpath expr="//DropdownItem[@t-out='this.currentApp.name']" position="replace"/>
</t>

<t t-name="web_enterprise.EnterpriseNavBar.SectionsMenu" t-inherit="web.NavBar.SectionsMenu" t-inherit-mode="extension">
    <xpath expr="//Dropdown/button" position="attributes">
        <attribute name="class" add="fw-normal" separator=" "/>
    </xpath>
</t>

</templates>
