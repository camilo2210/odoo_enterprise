<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('navbar-menu')]" position="inside">
            <button t-if="this.pos.config.module_pos_appointment"
                class="btn btn-outline-secondary btn-lg lh-lg"
                t-att-class="{ active: this.mainButton === 'booking' }"
                t-on-click="() => this.pos.manageBookings()" >
                <span t-if="!this.ui.isSmall">Booking</span>
                <i t-else="" class="oi oi-fw oi-filled" data-icon="calendar_today" t-att-class="{'oi-lg' : !this.ui.isSmall}"/>
            </button>
        </xpath>
    </t>

</templates>
