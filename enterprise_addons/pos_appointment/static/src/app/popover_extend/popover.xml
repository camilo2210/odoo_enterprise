<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_appointment.POSAppointmentCalendarEventPopover" t-inherit="appointment.AppointmentCalendarEventPopover" t-inherit-mode="primary">
        <xpath expr="//div[./span/t[@t-out='data.total_capacity_reserved']]" position="before">
            <div t-if="data.phone_number" class="d-flex align-items-baseline">
                <i class="oi oi-filled text-muted me-3" data-icon="phone" title="Phone"/>
                <t t-out="data.phone_number"/>
            </div>
        </xpath>
        <xpath expr="//div[./span/t[@t-out='data.total_capacity_reserved']]" position="replace">
            <div t-if="data.appointment_type_manage_capacity" class="d-flex align-items-baseline">
                <i class="oi oi-filled text-muted me-3" data-icon="restaurant" title="Waiting List Capacity"/>
                <span>
                    <t t-out="data.waiting_list_capacity"/> guests
                </span>
            </div>
        </xpath>
        <xpath expr="//div[./div[@t-out='data.description']]" position="replace">
            <div t-if="!this.isHtmlEmpty(data.notes)" class="d-flex align-items-baseline">
                <i class="oi oi-filled text-muted me-3" data-icon="sticky_note_2" title="Notes"/>
                <t t-out="data.notes"/>
            </div>
            <div t-if="data.answers" class="d-flex align-items-baseline">
                <i class="oi oi-filled text-muted me-3" data-icon="info" title="Q&amp;A answer"/>
                <t t-out="data.answers"/>
            </div>
        </xpath>
        <xpath expr="//div[./t[@t-out='data.location']]" position="replace"/>
        <xpath expr="//div[./span[@t-out='data.videocall_location']]" position="replace"/>
        <xpath expr="//button[hasclass('o_appointment_calendar_popover_edit')]" position="attributes">
            <attribute name="t-if">this.pos.accessRight.canEditBooking</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_appointment_calendar_popover_status_btn')]" position="attributes">
            <attribute name="t-if">this.pos.accessRight.canEditBooking</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_appointment_calendar_popover_delete')]" position="attributes">
            <attribute name="t-if">this.pos.accessRight.canDeleteBooking</attribute>
        </xpath>
    </t>
</templates>
