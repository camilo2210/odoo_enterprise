<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr_attendance.AttendanceGanttController" t-inherit="web_gantt.GanttController" t-inherit-mode="primary">
        <t t-if="this.showNoContentHelp" position="replace">
        </t>
        <t model="this.model" position="after">
            <t t-if="this.showNoContentHelp">
                <t t-if="this.props.info.noContentHelp">
                    <AttendanceActionHelper noContentHelp="this.props.info.noContentHelp"/>
                </t>
                <t t-else="" t-call="web.NoContentHelper"/>
            </t>
        </t>
    </t>
    <t t-name="hr_attendance.GanttRenderer.RowHeader" t-inherit="hr.HrGanttRenderer.RowHeader" t-inherit-mode="primary">
        <xpath expr="//Avatar" position="attributes">
            <attribute name="cssClass">row.employeeHasNoContract ? 'text-danger' : ''</attribute>
        </xpath>
    </t>
</odoo>
