<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_dashboard_employee" model="spreadsheet.dashboard">
        <field name="name">Employee</field>
        <field name="spreadsheet_binary_data" type="bytes" file="spreadsheet_dashboard_hr_appraisal/data/files/employee_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('hr_appraisal.model_hr_appraisal'))]"/>
        <field name="sample_dashboard_file_path">spreadsheet_dashboard_hr_appraisal/data/files/employee_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.link(ref('hr_appraisal.group_hr_appraisal_manager'))]"/>
        <field name="sequence">120</field>
        <field name="is_published">True</field>
    </record>

</odoo>
