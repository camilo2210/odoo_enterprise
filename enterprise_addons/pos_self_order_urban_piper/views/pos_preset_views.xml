<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_pos_preset_form_inherit_pos_self_order_urban_piper" model="ir.ui.view">
        <field name="name">pos.restaurant.preset.form.inherit.urbanpiper</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="pos_restaurant.view_pos_preset_form_inherit_pos_restaurant"></field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_self_order_pos_preset_form_inherit_pos_self_order_urban_piper" model="ir.ui.view">
        <field name="name">pos.self_order.preset.form.inherit.urbanpiper</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="pos_self_order.view_pos_preset_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='self_ordering']" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_self_order_pos_preset_list_inherit_pos_self_order_urban_piper" model="ir.ui.view">
        <field name="name">pos.preset.list</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_preset_tree"/>
        <field name="arch" type="xml">
            <field name="available_in_self" position="attributes">
                <attribute name="invisible">identification == 'online'</attribute>
            </field>
        </field>
    </record>
</odoo>
