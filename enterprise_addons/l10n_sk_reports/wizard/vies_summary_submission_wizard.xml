<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vies_summary_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_sk_reports.vies.summary.submission.wizard.form</field>
            <field name="model">l10n_sk_reports.vies.summary.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group id="instructions">
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your VIES Summary Statement.</span><br/>
                                    <button string="Download XML" name="print_xml" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <li>Log in to <a href="https://www.financnasprava.sk/" target="_blank">Finančná správa</a>.</li>
                            <li>Upload the XML file.</li>
                            <li>Submit the VIES Summary Statement.</li>
                        </ol>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
