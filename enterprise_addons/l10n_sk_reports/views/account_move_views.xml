<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_sk_reports</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="reversed_entry_id" readonly="1" string="Corrected Invoice" invisible="country_code != 'SK' or move_type not in ('out_refund', 'in_refund')"/>
                <field name="l10n_sk_is_bad_debt" invisible="country_code != 'SK' or move_type not in ('out_refund', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
