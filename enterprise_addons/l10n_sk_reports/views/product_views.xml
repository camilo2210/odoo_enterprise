<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_inherit_l10n_sk_reports" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n_sk_reports</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']/group[@name='reporting']" position="attributes">
                <attribute name="invisible" add="'SK' not in fiscal_country_codes" separator="and"/>
            </xpath>
        </field>
    </record>

</odoo>
