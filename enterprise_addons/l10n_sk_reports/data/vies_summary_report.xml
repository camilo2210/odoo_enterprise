<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- display ec sales list report menu item -->
        <record model="ir.ui.menu" id="account_reports.menu_action_account_report_sales">
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- Add the report variant -->
    <record id="vies_summary_report" model="account.report">
        <field name="name">VIES Summary Statement</field>
        <field name="name@sk">Súhrnný výkaz DPH</field>
        <field name="groupby">partner_id_and_sale_type</field>
        <field name="country_id" ref="base.sk"/>
        <field name="root_report_id" ref="account_reports.generic_ec_sales_report"/>
        <field name="load_more_limit" eval="80"/>
        <field name="filter_journals" eval="True"/>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_sk_vies_summary_report_handler"/>
        <field name="column_ids">
            <record id="vies_summary_report_country_code" model="account.report.column">
                <field name="name">Country Code</field>
                <field name="name@sk">Kód krajiny</field>
                <field name="expression_label">country_code</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="vies_summary_report_vat_number" model="account.report.column">
                <field name="name">VAT Number</field>
                <field name="name@sk">IČ DPH</field>
                <field name="expression_label">vat_number</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="vies_summary_report_transaction_code" model="account.report.column">
                <field name="name">Transaction Code</field>
                <field name="name@sk">Kód transakcie</field>
                <field name="expression_label">sale_type_shortcut</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="vies_summary_report_total_value" model="account.report.column">
                <field name="name">Total Value</field>
                <field name="name@sk">Hodnota dodávok</field>
                <field name="expression_label">balance</field>
                <field name="sortable" eval="True"/>
            </record>
        </field>
        <field name="line_ids">
            <record id="vies_summary_report_line" model="account.report.line">
                <field name="name">VIES Summary Statement</field>
                <field name="name@sk">Súhrnný výkaz DPH</field>
                <field name="code">SK_VIES</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="vies_summary_report_line_country_code" model="account.report.expression">
                        <field name="label">country_code</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">country_code</field>
                    </record>
                    <record id="vies_summary_report_line_vat_number" model="account.report.expression">
                        <field name="label">vat_number</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">vat_number</field>
                    </record>
                    <record id="vies_summary_report_line_transaction_code" model="account.report.expression">
                        <field name="label">sale_type_shortcut</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">sale_type_shortcut</field>
                    </record>
                    <record id="vies_summary_report_line_total_value" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
