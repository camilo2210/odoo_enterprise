<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sk_tax_return_type" model="account.return.type">
            <field name="name">Tax</field>
            <field name="report_id" ref="l10n_sk.l10n_sk_vat_report"/>
            <field name="country_id" ref="base.sk"/>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
        </record>

        <record id="sk_vat_control_statement_return_type" model="account.return.type">
            <field name="name">VAT Control Statement</field>
            <field name="report_id" ref="l10n_sk_reports.control_statement_report"/>
            <field name="country_id" ref="base.sk" />
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
            <field name="states_workflow">generic_state_review_submit</field>
        </record>

        <record id="sk_vies_summary_return_type" model="account.return.type">
            <field name="name">VIES Summary Statement</field>
            <field name="report_id" ref="l10n_sk_reports.vies_summary_report"/>
            <field name="country_id" ref="base.sk"/>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">25</field>
            <field name="states_workflow">generic_state_review_submit</field>
            <field name="auto_generate" eval="False"/>
        </record>
    </data>
</odoo>
