<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="worksheet.WorksheetPropertiesDefinitionField" t-inherit="web.PropertiesDefinitionField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_property_field_value')]/div[hasclass('w-100')]" position="replace" mode="inner">
            <div class="o_worksheet_property_type d-flex align-items-center text-muted">
                <img class="o_avatar me-2" style="--Avatar-size: 20px;"
                     t-attf-src="/web/static/src/views/fields/properties/icons/{{propertyConfiguration.type}}.png"/>
                <span t-out="this.typeLabel(propertyConfiguration.type)"/>
            </div>
        </xpath>
    </t>
</templates>
