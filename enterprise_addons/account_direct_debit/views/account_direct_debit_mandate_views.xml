<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_direct_debit_mandate_form" model="ir.ui.view">
            <field name="name">account.direct.debit.mandate.form</field>
            <field name="model">account.direct.debit.mandate</field>
            <field name="arch" type="xml">
                <form string="Customer mandate">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                        <!-- When the mandate isn't sent -->
                        <button string="Send &amp; Print" type="object" name="action_send_and_print" class="btn btn-primary" invisible="state != 'draft' or is_sent"/>
                        <button string="Validate" type="object" name="action_validate_mandate" class="btn btn-secondary" invisible="state != 'draft' or is_sent"/>

                        <!-- When the mandate is sent -->
                        <button string="Validate" type="object" name="action_validate_mandate" class="btn btn-primary" invisible="state != 'draft' or not is_sent"/>
                        <button string="Send &amp; Print" type="object" name="action_send_and_print" class="btn btn-secondary" invisible="state != 'draft' or not is_sent"/>

                        <button string="Cancel" type="object" name="action_cancel_mandate" class="btn btn-secondary" invisible="state != 'draft'"/>
                        <button string="Close" type="object" name="action_close_mandate" class="btn btn-primary" invisible="state != 'active'"/>
                        <button string="Revoke" type="object" name="action_revoke_mandate" class="btn btn-secondary"  invisible="state != 'active'"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_payments_to_collect" icon="attach_money" class="oe_stat_button" invisible="payments_to_collect_nber == 0">
                                <field name="payments_to_collect_nber" widget="statinfo" string="Collections" help="In-process and completed payments generated under this mandate."/>
                            </button>

                            <button type="object" name="action_view_paid_invoices" icon="edit_square" class="oe_stat_button" invisible="not paid_invoice_ids">
                                <field name="paid_invoices_nber" widget="statinfo" string="Invoices Paid" help="Invoices paid with this mandate."/>
                            </button>
                        </div>
                        <div class="m-0" name="alerts" invisible="not alerts">
                            <field name="alerts" class="o_field_html" widget="actionable_errors"/>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="name" readonly="state != 'draft'" groups="base.group_no_one"/>
                            </group>
                            <group>
                                <field name="mandate_type" readonly="state != 'draft'" invisible="not display_mandate_type"/>
                            </group>
                            <group/>
                            <group>
                                <field name="partner_bank_id" context="{'default_partner_id':partner_id}" readonly="state != 'draft'" placeholder="Provided by customer"/>
                                <label for="pre_notification_period"/>
                                <div>
                                    <field name="pre_notification_period" readonly="state != 'draft'" class="oe_inline"/>
                                    day(s)
                                </div>
                            </group>
                            <group>
                                <field name="start_date" string="Validity" widget="daterange" placeholder="Indefinite" readonly="state != 'draft'" options="{'end_date_field': 'end_date'}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="o_attachment_preview"/>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="account_direct_debit_mandate_list" model="ir.ui.view">
            <field name="name">account.direct.debit.mandate.list</field>
            <field name="model">account.direct.debit.mandate</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'" decoration-muted="state == 'closed'" decoration-danger="state == 'revoked'" default_order="start_date desc">
                    <field name="partner_id" readonly="state != 'draft'"/>
                    <field name="name" readonly="state != 'draft'" groups="base.group_no_one"/>
                    <field name="mandate_type"/>
                    <field name="start_date" readonly="state != 'draft'"/>
                    <field name="end_date" readonly="state == 'closed'"/>
                    <field name="pre_notification_period" readonly="state != 'draft'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state"
                           decoration-muted="state in ('closed', 'cancelled')"
                           decoration-success="state == 'active'"
                           decoration-info="state == 'draft'"
                           decoration-danger="state == 'revoked'"
                           widget="badge"/>
                </list>
            </field>
        </record>

        <record id="account_direct_debit_mandate_search" model="ir.ui.view">
            <field name="name">account.direct.debit.mandate.search</field>
            <field name="model">account.direct.debit.mandate</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="partner_bank_id"/>
                    <field name="name"/>
                    <filter string="Draft" name="mandate_draft_filter" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="mandate_active_filter" domain="[('state', '=', 'active')]"/>
                    <filter string="Closed" name="mandate_closed_filter" domain="[('state', 'in', ('closed','revoked'))]"/>
                    <separator/>
                    <filter string="Type" name="group_by_mandate_type" context="{'group_by': 'mandate_type'}"/>
                </search>
            </field>
        </record>

        <record id="account_direct_debit_mandate_action" model="ir.actions.act_window">
            <field name="name">Direct Debit Mandates</field>
            <field name="res_model">account.direct.debit.mandate</field>
            <field name="view_mode">list,form</field>
            <field name="path">direct-debit-mandates</field>
            <field name="context">{'search_default_mandate_active_filter':1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new direct debit customer mandate
                </p>
                <p>
                    A mandate represents the authorization you receive from a customer
                    to automatically collect money on their account.
                </p>
                <p>
                    Once an invoice is made in Odoo for a customer having a mandate active on the invoice date,
                    its validation will trigger its automatic payment, and you will then only have to generate a
                    direct debit file containing this operation and send it to your bank to effectively get paid.
                </p>
            </field>
        </record>

        <menuitem id="account_direct_debit_mandate_menuitem"
                  name="Direct Debit Mandates"
                  parent="account.menu_finance_receivables"
                  action="account_direct_debit_mandate_action"
                  sequence="50"/>
    </data>
</odoo>
