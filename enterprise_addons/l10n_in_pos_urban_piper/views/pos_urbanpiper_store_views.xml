<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_urbanpiper_store_form_l10n_in" model="ir.ui.view">
        <field name="name">pos.urbanpiper.store.form.l10n_in</field>
        <field name="model">pos.urbanpiper.store</field>
        <field name="inherit_id" ref="pos_urban_piper.view_pos_urbanpiper_store_form"/>
        <field name="arch" type="xml">
            <!-- 
                In India, provider-specific pricelists are not supported.
                All platforms must use a uniform price for a listed product within a store.
                Doc: https://api-docs.urbanpiper.com/downstream/api/endpoints/menu/add-update-menu#:~:text=This%20feature%20is%20available%20for%20aggregators%20outside%20India.
            -->
            <xpath expr="//field[@name='aggregator_lines']//field[@name='pricelist_id']" position="attributes">
                <attribute name="column_invisible">parent.country_code == 'IN'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
