<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="obox_offline_connect_wizard_view_form" model="ir.ui.view">
        <field name="name">obox.offline.connect.wizard.form</field>
        <field name="model">obox.offline.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="We couldn't automatically pair your Obox">
                <p>
                    Make sure your Obox is <b>powered on</b> and <b>connected to the same network</b> as this device.
                    <br/>
                    Then, close this window and retry, or fill in the details below to connect manually.
                </p>
                <group>
                    <field name="ip_address" placeholder="192.168.1.x"/>
                    <field name="serial_number" placeholder="ODO010000xx"/>
                </group>
                <footer>
                    <button name="action_connect" type="object" string="Connect" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
