<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_company_view_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_au_hr_payroll_api</field>
        <field name="model">res.company</field>
        <field name="priority" eval="51"/>
        <field name="inherit_id" ref="l10n_au.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='additional_identifiers' and @widget='additional_identifiers_button']" position="before">
                <div class="d-flex" invisible="country_code != 'AU'">
                    <span class="oi text-success" data-icon="check" title="Validation Successful" invisible="not l10n_au_abn_valid"/>
                    <button class="oe_link oe_inline p-0" type="object" name="action_check_abn" invisible="l10n_au_abn_valid">Verify ABN</button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
