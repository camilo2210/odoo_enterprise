<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.planning.whatapp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="55"/>
        <field name="inherit_id" ref="planning.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='planning']/setting" position="before">
                <setting name="planning_medium_settings" help="Send employees their schedule via:">
                    <field name="planning_medium" class="o_light_label" widget="radio" options="{'vertical': true}" required="True"/>
                    <t invisible="planning_medium != 'whatsapp'" groups="whatsapp.group_whatsapp_admin">
                        <div invisible="is_wa_template_planning_approved">
                            It seems that one or more of your whatsapp templates are not configured.
                        </div>
                        <button name="%(whatsapp_planning.action_template_configure_list_wizard)d" icon="east" type="action" string="Go to the Whatsapp Planning wizard" groups="whatsapp.group_whatsapp_admin" class="btn-link"/>
                    </t>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
