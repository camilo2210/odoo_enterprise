<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="template_configure_list_wizard" model="ir.ui.view">
        <field name="name">whatsapp.planning.template.configure.list.wizard</field>
        <field name="model">whatsapp.planning.template.configure</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    WhatsApp templates must be approved by Meta before you can use them. This process usually takes 1–2 working days.
                    <br/>
                    Select the WhatsApp account that will be used to send your employees their schedules:
                </p>
                <table class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped null">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Template</th>
                            <th>Account</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <label for="wa_template_schedule_published" class="pe-2"/>
                            </td>
                            <td>
                                <field name="wa_template_schedule_published"/>
                            </td>
                            <td>
                                <field name="wa_template_schedule_published_account"/>
                            </td>
                            <td>
                                <field name="wa_template_schedule_published_status" 
                                    decoration-success="wa_template_schedule_published_status == 'approved'" 
                                    decoration-danger="wa_template_schedule_published_status == 'rejected'"
                                    widget="badge"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label for="wa_template_open_shift_available" class="pe-2"/>
                            </td>
                            <td>
                                <field name="wa_template_open_shift_available"/>
                            </td>
                            <td>
                                <field name="wa_template_open_shift_available_account"/>
                            </td>
                            <td>
                                <field name="wa_template_open_shift_available_status" 
                                    decoration-success="wa_template_open_shift_available_status == 'approved'" 
                                    decoration-danger="wa_template_open_shift_available_status == 'rejected'"
                                    widget="badge"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label for="wa_template_assigned_shift" class="pe-2"/>
                            </td>
                            <td>
                                <field name="wa_template_assigned_shift"/>
                            </td>
                            <td>
                                <field name="wa_template_assigned_shift_account"/>
                            </td>
                            <td>
                                <field name="wa_template_assigned_shift_status" 
                                    decoration-success="wa_template_assigned_shift_status == 'approved'" 
                                    decoration-danger="wa_template_assigned_shift_status == 'rejected'"
                                    widget="badge"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label for="wa_template_shift_reassigned" class="pe-2"/>
                            </td>
                            <td>
                                <field name="wa_template_shift_reassigned"/>
                            </td>
                            <td>
                                <field name="wa_template_shift_reassigned_account"/>
                            </td>
                            <td>
                                <field name="wa_template_shift_reassigned_status" 
                                    decoration-success="wa_template_shift_reassigned_status == 'approved'" 
                                    decoration-danger="wa_template_shift_reassigned_status == 'rejected'"
                                    widget="badge"/>
                            </td>
                        </tr>

                    </tbody>
                </table>
                <footer>
                    <button name="action_approve" type="object" string="Submit for Approval"
                            class='btn-primary'/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_template_configure_list_wizard" model="ir.actions.act_window">
        <field name="name">Test</field>
        <field name="res_model">whatsapp.planning.template.configure</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="template_configure_list_wizard"/>
    </record>
</odoo>
