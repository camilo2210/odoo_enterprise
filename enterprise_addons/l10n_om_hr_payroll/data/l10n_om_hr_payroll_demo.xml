<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_company_om" model="res.partner" forcecreate="1">
        <field name="name">My Omani Company</field>
        <field name="street">23 Sultan Qaboos Street</field>
        <field name="zip">112</field>
        <field name="city">Muscat</field>
        <field name="country_id" ref="base.om"/>
        <field name="phone">+968 2412 5566</field>
        <field name="email">info@myomanicompany.om</field>
        <field name="is_company">True</field>
    </record>

    <record id="base.demo_company_om" model="res.company" forcecreate="1">
        <field name="name">My Omani Company</field>
        <field name="partner_id" ref="base.partner_company_om"/>
        <field name="country_id" ref="base.om"/>
        <field name="currency_id" ref="base.OMR"/>
        <field name="resource_calendar_id" ref="l10n_om_hr_payroll.l10n_om_resource_calendar_def_40h"/>
    </record>

    <record id="l10n_om_hr_payroll.l10n_om_resource_calendar_def_40h" model="resource.calendar">
        <field name="company_id" ref="base.demo_company_om"/>
    </record>

    <record id="l10n_om_hr_accrual_plan_paid_time_off" model="hr.leave.accrual.plan">
        <field name="company_id" ref="base.demo_company_om"/>
        <field name="work_entry_type_id" ref="hr_work_entry.om_work_entry_type_legal_leave"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_om'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_om'))]"/>
    </record>

    <record id="om_hr_job_marketing_manager" model="hr.job">
        <field name="name">Marketing Manager OM</field>
