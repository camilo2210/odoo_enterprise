<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_om_monthly_pay" model="hr.payroll.structure">
        <field name="name">Oman: Monthly Pay</field>
        <field name="country_id" ref="base.om"/>
        <field name="code">OMMONTHLY</field>
        <field name="type_id" ref="l10n_om_hr_payroll.l10n_om_employee"/>
        <field name="rule_ids" eval="[]"/>
    </record>

    <record id="l10n_om_hr_payroll.l10n_om_employee" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_om_monthly_pay"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.om_work_entry_type_attendance"/>
    </record>
</odoo>
