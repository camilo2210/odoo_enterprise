<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="sale_timesheet_enterprise.TimesheetLeaderboard" t-if="this.timesheetLeaderboardService.showLeaderboard">
        <div class="position-relative d-flex flex-column flex-sm-row flex-grow-1 justify-content-end o_timesheet_leaderboard gap-2">
            <img t-if="this.timesheetLeaderboardService.data.currentEmployee?.index === 0" class="o_timesheet_leaderboard_confetti position-absolute top-0 end-0 object-fit-cover h-100 w-100 me-n3" src="/base/static/img/onboarding_confetti.svg" alt="o_timesheet_leaderboard_confetti"/>
            <div class="ms-auto position-relative d-flex align-items-center justify-content-between py-1 gap-2" t-on-click="this.openLeaderboardPopup" role="button">
                <t t-if="this.timesheetLeaderboardService.data.leaderboard?.length">
                    <t t-foreach="this.timesheetLeaderboardService.data.leaderboard.slice(0, this.avatarDisplayLimit)" t-as="employee" t-key="employee_index">
                        <Many2OneAvatarRankField rank="employee_index + 1" id="employee.id" size="'button'"/>
                    </t>
                    <t t-if="this.timesheetLeaderboardService.data.currentEmployee?.index + 1 &gt; this.avatarDisplayLimit">
                        <span class="fs-2">···</span>
                        <Many2OneAvatarRankField rank="this.timesheetLeaderboardService.data.currentEmployee.index + 1" id="this.timesheetLeaderboardService.data.currentEmployee.id" size="'button'"/>
                    </t>
                </t>
                <t t-else="">
                    <div class="px-1" t-foreach="[1, 2, 3].slice(0, this.avatarDisplayLimit)" t-as="rank" t-key="rank">
                        <Many2OneAvatarRankField rank="rank"/>
                    </div>
                </t>
            </div>
            <span class="d-flex align-items-center text-muted" t-if="!this.uiService.isSmall and this.props.displayEarnYourRank">
                Record timesheets to earn your rank!
            </span>
        </div>
    </t>
</templates>
