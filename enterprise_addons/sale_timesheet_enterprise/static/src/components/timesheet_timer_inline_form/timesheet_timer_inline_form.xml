<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_timesheet_enterprise.TimesheetTimerInlineForm" t-inherit="timesheet_grid.TimesheetTimerInlineForm" t-inherit-mode="extension">
        <div name="unit_amount_field_container" position="attributes">
            <attribute name="class" remove="o_wrap_input_full_width" separator=" "/>
            <attribute name="t-att-class">{
                'o_wrap_input_full_width': !this.displayIsBillable(data.record),
                'o_wrap_input_half_width': this.uiService.isSmall and this.displayIsBillable(data.record),
            }</attribute>
        </div>
        <div name="unit_amount_field_container" position="after">
            <t t-if="this.displayIsBillable(data.record)">
                <div class="o_cell o_wrap_label d-flex align-items-center text-break text-900">
                    <label class="o_form_label">
                        Billable
                    </label>
                </div>
                <div class="o_cell o_no_box o_wrap_input d-flex align-items-center">
                    <Field name="'is_billable'"
                        fieldInfo="this.activeFields.is_billable"
                        record="data.record"
                    />
                </div>
            </t>
        </div>
    </t>
</templates>
