<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="sale_timesheet_enterprise.TimesheetLeaderboardDialog">
        <Dialog size="this.xl" footer="false" header="true" t-on-keyup.stop="this.onKeyUp">
            <t t-set-slot="header">
                <div class="d-flex align-items-center justify-content-between flex w-100">
                    <button class="btn btn-secondary dropdown-toggle fs-5" t-out="this.getTitle(this.state.type)" type="button" id="type" data-bs-toggle="dropdown" aria-expanded="false"/>
                    <ul class="dropdown-menu" aria-labelledby="type">
                        <li class="dropdown-item" t-on-click="() => this.changeType('billing_rate')" t-out="this.getTitle('billing_rate')"/>
                        <li class="dropdown-item" t-on-click="() => this.changeType('total_time')" t-out="this.getTitle('total_time')"/>
                    </ul>
                    <div t-on-click="this.props.close" type="button" class="btn-close" aria-label="Close"/>
                </div>
            </t>
            <div class="container px-0">
                <div class="row">
                    <div class="col">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-3 fw-bolder text-center" t-out="this.currentFormattedDate"/>
                            <div class="btn-group">
                                <button class="btn btn-secondary" t-on-click="this.goLastMonth">
                                    <i class="oi" data-icon="chevron_backward"/>
                                </button>
                                <button class="btn btn-secondary" t-on-click="this.goCurrentMonth">
                                    This month
                                </button>
                                <button class="btn btn-secondary" t-on-click="this.goNextMonth">
                                    <i class="oi" data-icon="chevron_forward"/>
                                </button>
                            </div>
                        </div>
                        <div class="row mx-0 mt-3 mb-2 py-3 gap-3 gap-sm-0 rounded bg-100">
                            <t t-if="this.state.leaderboard.length &gt; 0">
                                <t t-foreach="this.state.leaderboard.slice(0, 3)" t-as="employee" t-key="employee_index">
                                    <div class="col-12 col-sm-4 mx-sm-auto">
                                        <Many2OneAvatarRankField
                                            size="'medium'"
                                            rank="employee_index + 1"
                                            id="employee.id"
                                        />
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="text-center fs-4 fw-bolder mt-1 o_employee_name" t-out="employee.name"/>
                                            <span class="small text-center">
                                                <t t-if="this.state.type === 'billing_rate'" t-out="this.getBillingRateText(this.state.leaderboard[employee_index])"/>
                                                <t t-else="" t-out="this.getTotalTimeText(this.state.leaderboard[employee_index])"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="[1, 2, 3]" t-as="employee" t-key="employee">
                                    <div class="col-12 col-sm-4 mx-sm-auto">
                                        <Many2OneAvatarRankField
                                            size="'medium'"
                                            rank="employee"
                                        />
                                    </div>
                                </t>
                            </t>
                        </div>
                        <div t-attf-class="o_leaderboard_modal_table {{this.state.current_employee and this.state.current_employee.index &gt; 9 ? 'o_table_height_extra' : '' }} px-1" t-if="this.state.leaderboard.length > 2">
                            <table class="table table-borderless table-striped table-sm mb-0 overflow-auto">
                                <tbody class="align-middle o_table_height_extra">
                                    <tr t-foreach="this.state.leaderboard.slice(3, this.displayLimit)" t-as="employee" t-key="employee_index" t-attf-class="{{this.state.current_employee and employee.id === this.state.current_employee.id ? 'fw-bolder' : '' }}">
                                        <Many2OneAvatarRankField
                                            size="'small'"
                                            rank="employee_index + 4"
                                            id="employee.id"
                                        />
                                        <td class="o_employee_name" t-out="employee.name"/>
                                        <td class="text-end small">
                                            <t t-if="this.state.type === 'billing_rate'" t-out="this.getBillingRateText(this.state.leaderboard[employee_index + 3])"/>
                                            <t t-else="" t-out="this.getTotalTimeText(this.state.leaderboard[employee_index + 3])"/>
                                        </td>
                                    </tr>
                                    <t t-if="this.state.current_employee and this.state.current_employee.index &gt; 9 and !this.state.showAll">
                                        <tr>
                                            <td colspan="4" class="text-start text-muted">
                                                <span class="ps-1">···</span>
                                            </td>
                                        </tr>
                                        <tr t-attf-class="{{ 'employee.id == state.currentEmployee.id' ? 'fw-bolder' : '' }}">
                                            <Many2OneAvatarRankField
                                                    rank="this.state.current_employee.index + 1"
                                                    id="this.state.current_employee.id"
                                            />
                                            <td t-out="this.state.current_employee.name"/>
                                            <td class="text-end small">
                                                <t t-if="this.state.type === 'billing_rate'" t-out="this.getBillingRateText(this.state.current_employee)"/>
                                                <t t-else="" t-out="this.getTotalTimeText(this.state.current_employee)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <span t-if="this.state.leaderboard.length &gt; 9" class="btn btn-secondary w-100 my-2 mb-lg-0 mt-lg-2" t-on-click="() => this.state.showAll = !this.state.showAll">
                            <t t-if="this.state.showAll">Show less</t>
                            <t t-else="">Show more</t>
                        </span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="o_timesheet_leaderboard_tip h-100 d-flex flex-column justify-content-center align-items-center p-4 rounded bg-gradient">
                            <span class="text-uppercase text-muted fw-bolder">Tip of the day</span>
                            <span class="pt-4 fs-2 text-break text-center fst-italic" t-out="this.tip"/>
                        </div>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
