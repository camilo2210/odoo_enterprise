<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="sale_timesheet_enterprise.MyTimesheetsKpiLeaderboardKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <TimesheetKpiLeaderboardHeader/>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="class" add="h-auto" separator=" "/>
            <attribute name="style" add="min-height: 0;" separator=" "/>
        </xpath>
    </t>

</templates>
