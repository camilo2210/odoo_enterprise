<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="sale_timesheet_enterprise.MyTimesheetsKpiLeaderboardGridRenderer" t-inherit="web_grid.Renderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_grid_renderer')]" position="before">
            <TimesheetKpiLeaderboardHeader date="this.props.model.navigationInfo.periodStart"/>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_renderer')]" position="attributes">
            <attribute name="class" add="h-auto" separator=" "/>
        </xpath>
    </t>

</templates>
