<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.esg_hr_fleet</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="esg.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='esg_report_setting_container']" position="before">
                    <block title="Employee Commuting Emission" name="esg_hr_setting_container">
                        <setting id="weekly_days_at_office" string="Weekly Office Attendance" help="Average number of days per week employees commute to the office.">
                            <field name="weekly_days_at_office"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
