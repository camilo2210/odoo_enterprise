<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="documents_document_view_kanban_mobile" model="ir.ui.view">
        <field name="name">documents.document.kanban.mobile</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <div t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="create_date" class="fst-italic d-block"/>
                    </div>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sign_import_from_documents_view_form" model="ir.ui.view">
        <field name="name">sign.import.documents.view.form</field>
        <field name="model">sign.import.documents</field>
        <field name="arch" type="xml">
            <form string="Select a Document to Import and Sign">
                <group>
                    <field name="selected_document" string="Select a Document" widget="many2one" domain="[('mimetype', '=', 'application/pdf')]" options="{'no_create': True, 'no_create_edit': True}" context="{'kanban_view_ref': 'documents_sign.documents_document_view_kanban_mobile'}"/>
                </group>
                <footer>
                    <button string="Import and Sign" type="object" class="btn-primary" name="action_import_and_create"/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
