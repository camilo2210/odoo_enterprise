<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.website</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="20"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_website_create_new']" position="after">
            <button
                name="website_generator.action_open_website_import_form"
                type="action"
                class="btn btn-secondary rounded-2">
                <i class="oi me-1" data-icon="download" aria-hidden="true"/>Import Website
            </button>
        </xpath>
    </field>
</record>
</odoo>
