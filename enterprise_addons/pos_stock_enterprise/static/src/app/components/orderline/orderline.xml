<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock_enterprise.Orderline" t-inherit="pos_enterprise.Orderline" t-inherit-mode="extension">
        <div t-if="this.preparation_line.attribute_value_ids.length > 0" position="after">
            <ul t-if="this.packLotLines?.length" style="font-size: 91%;">
                <li t-foreach="this.packLotLines" t-as="lot_name" t-key="lot_name_index" class="o_pdis_lot_serial_number ms-3 text-muted" t-out="lot_name"/>
            </ul>
        </div>
    </t>
</templates>
