<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_us_account.tax_report" model="account.report">
        <field name="custom_handler_model_id" ref="model_l10n_us_tax_report_handler"/>
        <field name="filter_unfold_all" eval="True"/>
    </record>
    <record id="l10n_us_account.column_net" model="account.report.column">
        <field name="sequence">10</field>
    </record>

    <record id="l10n_us_tax_report_exempt_column" model="account.report.column">
        <field name="name">Exempt</field>
        <field name="expression_label">exempt</field>
        <field name="report_id" ref="l10n_us_account.tax_report"/>
        <field name="figure_type">monetary</field>
        <field name="sequence">20</field>
    </record>

    <record id="l10n_us_tax_report_non_taxable_column" model="account.report.column">
        <field name="name">Non-Taxable</field>
        <field name="expression_label">non_taxable</field>
        <field name="report_id" ref="l10n_us_account.tax_report"/>
        <field name="figure_type">monetary</field>
        <field name="sequence">25</field>
    </record>

    <record id="l10n_us_tax_report_taxable_column" model="account.report.column">
        <field name="name">Taxable</field>
        <field name="expression_label">taxable</field>
        <field name="report_id" ref="l10n_us_account.tax_report"/>
        <field name="figure_type">monetary</field>
        <field name="sequence">30</field>
    </record>

    <record id="l10n_us_tax_report_rate_column" model="account.report.column">
        <field name="name">Tax Rate</field>
        <field name="expression_label">rate</field>
        <field name="report_id" ref="l10n_us_account.tax_report"/>
        <field name="figure_type">percentage</field>
        <field name="sequence">50</field>
    </record>

    <record id="l10n_us_account.column_tax" model="account.report.column">
        <field name="sequence">60</field>
    </record>
</odoo>
