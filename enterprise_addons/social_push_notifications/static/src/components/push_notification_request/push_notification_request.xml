<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="social_push_notifications.PushNotificationRequest">
        <div class="o_social_push_notification_request position-fixed top-0 start-0 z-1 d-flex bg-white border rounded shadow gap-2 m-3 p-2">
            <div class="flex-shrink-0">
                <img t-att-src="this.props.config.icon || '/mail/static/src/img/odoobot_transparent.webp'" class="h-auto" alt="Notification Request Icon"/>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex">
                    <h6 class="flex-grow-1">
                        <t t-if="this.props.config.title" t-out="this.props.config.title"/>
                        <t t-else="">Want to discover new versions?</t>
                    </h6>
                    <i class="oi cursor-pointer" data-icon="close" t-on-click="this.props.close"/>
                </div>
                <p class="text-muted">
                    <t t-if="this.props.config.body" t-out="this.props.config.body"/>
                    <t t-else="">Enable push notifications to be notified about new features.</t>
                </p>
                <div class="d-flex justify-content-end gap-1">
                    <button class="btn btn-light" t-on-click="this.props.onDenyPushNotifications">Deny</button>
                    <button class="btn btn-primary" t-on-click="this.props.onAllowPushNotifications">Allow</button>
                </div>
            </div>
        </div>
    </t>
</templates>
