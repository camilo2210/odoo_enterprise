<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_inherit_quality_control" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.quality.control</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_see_quality_rate" type="object" class="oe_stat_button"
                    icon="check" groups="quality.group_quality_user"
                    invisible="quality_check_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_rate" digits="[16, 0]"/>%</span>
                        <span class="o_stat_text">Quality Rate</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
