<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mod347_manual_partner_data_tree" model="ir.ui.view">
            <field name="name">l10n_es_reports.aeat.boe.mod347.manual.partner.data.list</field>
            <field name="model">l10n_es_reports.mod347.manual.partner.data</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="partner_id"/>
                    <field name="perceived_amount"/>
                    <field name="operation_class"/>
                    <field name="operation_key"/>
                </list>
            </field>
        </record>

        <record id="mod111_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod111.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod111.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group>
                            <field name="declaration_type"/>
                            <field name="complementary_declaration"/>
                            <field name="partner_bank_id"/>
                            <field name="previous_report_number" invisible="not complementary_declaration"/>
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your Withholdings Declaration (Modelo 111).</span><br/>
                                    <button string="Download File (Modelo 111)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod115_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod115.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod115.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group>
                            <field name="declaration_type"/>
                            <field name="partner_bank_id"/>
                            <field name="complementary_declaration"/>
                            <field name="previous_report_number" invisible="not complementary_declaration"/>
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your Rent Withholdings Declaration (Modelo 115).</span><br/>
                                    <button string="Download File (Modelo 115)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod130_submissionwizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod130.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod130.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group>
                            <field name="taxpayer_id"/>
                            <field name="taxpayer_last_name"/>
                            <field name="taxpayer_first_name"/>
                            <field name="declaration_type"/>
                            <field name="partner_bank_id"/>
                            <field name="complementary_declaration"/>
                            <field name="previous_report_number" invisible="not complementary_declaration"/>
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your IRPF Installment Payment form (Modelo 130).</span><br/>
                                    <button string="Download File (Modelo 130)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod303_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod303.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod303.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group>
                            <field name="declaration_type"/>
                            <field name="partner_bank_id"/>
                            <field name="complementary_declaration"/>
                            <field name="monthly_return"/>
                            <field name="previous_report_number" invisible="not complementary_declaration"/>
                            <field name="using_sii"/>
                            <field name="exempted_from_mod_390" invisible="not exempted_from_mod_390_available"/>
                        </group>
                        <group invisible="not complementary_declaration">
                            <label for="rectification_direct_debit" class="text-700"/>
                            <field name="rectification_direct_debit" nolabel="1"/>
                            <label for="rectification_motive_rectifications" class="text-700"/>
                            <field name="rectification_motive_rectifications" nolabel="1"/>
                            <field name="rectification_motive_discrepancy_adm_crit" />
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your Quarterly VAT Declaration (Modelo 303).</span><br/>
                                    <button string="Download File (Modelo 303)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod347_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod347.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod347.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group>
                            <field name="contact_person_name"/>
                            <field name="contact_person_phone" required="True"/>
                        </group>
                        <group>
                            <field name="complementary_declaration"/>
                            <field name="substitutive_declaration"/>
                            <field name="previous_report_number"/>
                        </group>
                    </group>
                    <group>
                        <field name="cash_basis_mod347_data"/>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your Annual Operations Declaration (Modelo 347).</span><br/>
                                    <button string="Download File (Modelo 347)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod349_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod349.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod349.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group id="export_options">
                        <group>
                            <field name="contact_person_name"/>
                            <field name="contact_person_phone"/>
                            <field name="complementary_declaration"/>
                        </group>
                        <group>
                            <field name="substitutive_declaration"/>
                            <field name="previous_report_number"/>
                            <field name="trimester_2months_report" invisible="not is_period_quarterly"/>
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your EC Sales List (Modelo 349).</span><br/>
                                    <button string="Download XML (Modelo 349)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>

        <record id="mod390_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_es_reports.mod390.submission.wizard.form</field>
            <field name="model">l10n_es_reports.mod390.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <field name="physical_person_name"/>
                        <field name="monthly_return"/>
                    </group>
                    <separator string="Principal activity"/>
                    <group>
                        <group>
                            <field name="principal_activity" required="True"/>
                        </group>
                        <group>
                            <field name="principal_iae_epigrafe"/>
                        </group>
                        <group>
                            <field name="principal_code_activity" required="True"/>
                        </group>
                    </group>
                    <separator string="Judicial person"/>
                    <group>
                        <group>
                            <field name="judicial_person_name"/>
                        </group>
                        <group>
                            <field name="judicial_person_nif"/>
                        </group>
                        <group>
                            <field name="judicial_person_procuration_date"/>
                        </group>
                        <group>
                            <field name="judicial_person_notary"/>
                        </group>
                        <group>
                            <field name="group_number" invisible="not is_in_tax_unit"/>
                        </group>
                    </group>
                    <separator string="Special Regimen"/>
                    <group>
                        <group>
                            <field name="special_regime_applicable_163"/>
                        </group>
                        <group>
                            <field name="special_cash_basis"/>
                        </group>
                    </group>
                    <separator string="Substitute declaration"/>
                    <group>
                        <group>
                            <field name="is_substitute_declaration"/>
                        </group>
                        <group>
                            <field name="is_substitute_decl_by_rectif_of_quotas" invisible="not is_substitute_declaration"/>
                        </group>
                        <group>
                            <field name="previous_decl_number" invisible="not is_substitute_declaration"/>
                        </group>
                    </group>
                    <group id="instructions">
                        <separator string="Submission Instructions"/>
                        <ol colspan="2">
                            <li>
                                <div class="d-inline-block align-top">
                                    <span>Download your Annual VAT Summary (Modelo 390).</span><br/>
                                    <button string="Download File (Modelo 390)" name="export_boe" type="object" class="btn-secondary"/>
                                </div>
                            </li>
                            <field name="submission_instructions"/>
                        </ol>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
