                    </record>
                </field>
            </record>
            <record id="es_profit_and_loss_pymes_line_sum_b" model="account.report.line">
                <field name="name">B) FINANCIAL RESULTS (13 + 14 + 15 + 16 + 17 + 18)</field>
                <field name="name@es">B) RESULTADO FINANCIERO (13 + 14 + 15 + 16 + 17 + 18)</field>
