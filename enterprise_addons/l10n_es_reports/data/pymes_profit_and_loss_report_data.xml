                        <field name="name@ca_ES">15. Variació del valor raonable en instruments financers</field>
                        <field name="code">es_profit_and_loss_pymes_line_15</field>
                        <field name="expression_ids">
                            <record id="es_profit_and_loss_pymes_line_15_balance" model="account.report.expression">
                                <field name="label">balance</field>
