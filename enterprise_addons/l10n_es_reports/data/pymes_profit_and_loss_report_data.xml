                                <field name="formula">-670 - 671 - 672 - 690 - 691 - 692 - 770 - 771 - 772 - 790 - 791 - 792</field>
                            </record>
                        </field>
                    </record>
                    <record id="es_profit_and_loss_pymes_line_12" model="account.report.line">
