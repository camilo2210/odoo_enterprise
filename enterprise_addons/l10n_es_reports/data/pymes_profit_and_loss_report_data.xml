                        <field name="name">14. Finance expenses</field>
                        <field name="name@es">14. Gastos financieros</field>
                        <field name="name@ca_ES">14. Despeses financeres</field>
                        <field name="code">es_profit_and_loss_pymes_line_14</field>
                        <field name="expression_ids">
                            <record id="es_profit_and_loss_pymes_line_14_balance" model="account.report.expression">
