<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="financial_report_es_profit_and_loss_pymes" model="account.report">
        <field name="name">Profit and Loss (SMEs)</field>
        <field name="name@es">Pérdidas y Ganancias (PYMEs)</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="groupby">account_id</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="False"/>
        <field name="country_id" ref="base.es"/>
        <field name="availability_condition">coa</field>
        <field name="chart_template">es_pymes</field>
        <field name="filter_multi_company">selector</field>
        <field name="column_ids">
            <record id="financial_report_es_profit_and_loss_pymes_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="name@es">Saldo</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
