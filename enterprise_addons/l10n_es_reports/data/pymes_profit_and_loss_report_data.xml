                    <record id="es_profit_and_loss_pymes_line_sum_c_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">es_profit_and_loss_pymes_sum_a.balance + es_profit_and_loss_pymes_sum_b.balance</field>
