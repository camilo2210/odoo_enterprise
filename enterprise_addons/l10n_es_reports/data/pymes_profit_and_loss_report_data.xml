                        <field name="engine">aggregation</field>
                        <field name="formula">es_profit_and_loss_pymes_line_13.balance + es_profit_and_loss_pymes_line_14.balance + es_profit_and_loss_pymes_line_15.balance + es_profit_and_loss_pymes_line_16.balance + es_profit_and_loss_pymes_line_17.balance + es_profit_and_loss_pymes_line_18.balance</field>
