<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_tr_employee_salary" model="hr.payroll.structure">
        <field name="name">Türkiye: Monthly Pay</field>
        <field name="code">TRMONTHLY</field>
        <field name="country_id" ref="base.tr"/>
        <field name="type_id" ref="l10n_tr_hr_payroll.structure_type_employee_tr"/>
        <field name="rule_ids" eval="[]"/>
        <field name="ytd_computation" eval="True"/>
    </record>

    <record id="l10n_tr_hr_payroll.structure_type_employee_tr" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="hr_payroll_structure_tr_employee_salary"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.tr_work_entry_type_attendance"/>
    </record>

    <record id="l10n_tr_advance_pay" model="hr.payroll.structure">
        <field name="name">Türkiye: Advance Pay</field>
        <field name="code">TRADV</field>
        <field name="country_id" ref="base.tr"/>
        <field name="type_id" ref="l10n_tr_hr_payroll.structure_type_employee_tr"/>
        <field name="rule_ids" eval="[]"/>
        <field name="use_worked_day_lines" eval="False"/>
        <field name="payslip_name">Salary Advance</field>
    </record>

    <record id="hr_payroll_structure_type_self_employed_tr" model="hr.payroll.structure">
        <field name="name">Türkiye: Self-Employed Pay</field>
        <field name="code">TRMONTHLYSE</field>
        <field name="country_id" ref="base.tr"/>
        <field name="type_id" ref="l10n_tr_hr_payroll.structure_type_self_employed_tr"/>
        <field name="rule_ids" eval="[]"/>
        <field name="ytd_computation" eval="True"/>
    </record>

    <record id="l10n_tr_hr_payroll.structure_type_self_employed_tr" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="hr_payroll_structure_type_self_employed_tr"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.tr_work_entry_type_attendance"/>
    </record>
</odoo>
