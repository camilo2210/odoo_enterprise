<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_tr_sgk_hiring_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.tr.sgk.hiring.wizard.view.form</field>
        <field name="model">l10n.tr.sgk.hiring.wizard</field>
        <field name="arch" type="xml">
            <form string="SGK Report">
                <sheet>
                    <group>
                        <div>
                            <label for="is_transferred"/>
                            <field name="is_transferred" nolabel="1" class="px-2"/>
                        </div>
                    </group>
                    <group invisible="not is_transferred">
                        <div>
                            <label for="former_sgk_number"/>
                            <field name="former_sgk_number" nolabel="1" class="px-2 oe_inline"/>
                        </div>
                    </group>
                    <group name="employee_selection_group">
                        <field default_focus="1" name="employee_ids" widget="many2many_avatar_employee" options="{'no_create': True}"/>
                        <field name="xml_file" readonly="1" filename="xml_filename" widget="binary" invisible="not xml_file" class="oe_inline"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" type="object" string="Generate" class="btn-primary" invisible="xml_file"/>
                    <button name="action_generate_report" type="object" string="Regenerate" invisible="not xml_file"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_tr_sgk_hiring_notice_wizard" model="ir.actions.act_window">
        <field name="name">SGK Hiring Notice</field>
        <field name="res_model">l10n.tr.sgk.hiring.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_tr_hr_payroll.l10n_tr_sgk_hiring_wizard_view_form"/>
    </record>

</odoo>
