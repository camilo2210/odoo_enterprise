<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="social.StreamPostComment" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_social_comment_likes_total')]" position="after">
            <span t-if="this.originalPost.media_type.raw_value === 'facebook'"
                t-foreach="this.facebookReactions || []"
                t-as="reaction"
                t-key="reaction[0]"
                class="o_social_likes_count badge rounded-pill bg-white py-1 ms-1">
                <t t-out="reaction[0]"/>
                <t t-out="reaction[1]"/>
            </span>
        </xpath>
    </t>

    <t t-inherit="social.StreamPostCommentsOriginalPost" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_social_original_post_author_image')]" position="inside">
            <img t-if="this.originalPost.facebook_author_id.raw_value" t-attf-src="https://graph.facebook.com/v17.0/{{ this.originalPost.facebook_author_id.raw_value }}/picture" alt="Author Image" class="rounded"/>
        </xpath>
        <xpath expr="//div[hasclass('o_social_comments_modal_original_post_content')]" position="inside">
            <div class="o_social_original_post_facebook_stats d-flex justify-content-around"
                t-if="this.originalPost.media_type.raw_value === 'facebook'">
                <div class="o_social_facebook_likes d-flex align-items-center flex-wrap border px-1"
                     t-att-class="{'o_social_facebook_user_likes': this.originalPost.facebook_user_likes.raw_value}"
                     t-on-click="() => this.facebookProps.onFacebookPostLike()">
                    <t t-if="this.originalPost.facebook_likes_count.raw_value !== 0">
                        <t t-foreach="this.facebookReactions || []" t-as="reaction" t-key="reaction[0]">
                            <div class="border px-1" t-att-class="'o_social_emoji_' + reaction[2]">
                                <b t-out="reaction[0]"/>
                                <b class="o_social_likes_count mx-1" t-out="reaction[1]"/>
                            </div>
                        </t>
                    </t>
                    <span t-else="" class="oi" data-icon="thumb_up" title="Like"/>
                </div>
                <div class="d-flex flex-grow-1 justify-content-end flex-wrap px-2 text-muted">
                    <div t-if="this.originalPost.facebook_shares_count.raw_value" title="Share count">
                        <i class="oi me-1" data-icon="share"/>
                        <t t-out="this.originalPost.facebook_shares_count.value"/>
                    </div>
                    <div t-if="this.originalPost.facebook_reach.raw_value" title="View count" class="ps-2">
                        <i class="oi me-1" data-icon="visibility"/>
                        <t t-out="this.originalPost.facebook_reach.value"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
