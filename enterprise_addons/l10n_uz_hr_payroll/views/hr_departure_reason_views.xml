<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_departure_reason_view_list_uz" model="ir.ui.view">
        <field name="name">hr.departure.reason.view.list.uz</field>
        <field name="model">hr.departure.reason</field>
        <field name="inherit_id" ref="hr.hr_departure_reason_view_list"/>
        <field name="arch" type="xml">
            <field name="country_code" position="after">
                <field name="l10n_uz_is_severance_paid" optional="hide" invisible="country_code != 'UZ'"/>
            </field>
        </field>
    </record>

    <record id="hr_departure_reason_view_form_uz" model="ir.ui.view">
        <field name="name">hr.departure.reason.view.form.uz</field>
        <field name="model">hr.departure.reason</field>
        <field name="inherit_id" ref="hr.hr_departure_reason_view_form"/>
        <field name="arch" type="xml">
            <field name="country_code" position="after">
                <field name="l10n_uz_is_severance_paid" invisible="country_code != 'UZ'"/>
            </field>
        </field>
    </record>
</odoo>
