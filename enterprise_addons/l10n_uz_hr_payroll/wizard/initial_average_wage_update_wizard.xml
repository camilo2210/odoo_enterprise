<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_uz_wage_update_wizard_form" model="ir.ui.view">
        <field name="name">l10n.uz.average.monthly.wage.update.wizard.form</field>
        <field name="model">l10n.uz.average.monthly.wage.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Initial Average Monthly Wage">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning: </strong> 
                        Changing this baseline alters annual labor leave and average wage calculations for all future payslips until 12 months of payslips accumulate.
                        Once payslips are validated using this value, it cannot be changed retroactively.
                    </div>
                    <group>
                        <field name="version_id" invisible="1"/> <!-- Needed for the currency field -->
                        <field name="currency_id" invisible="1"/> <!-- Needed for monetary widget formatting on wage fields -->
                        <field name="current_initial_wage"/>
                        <field name="new_initial_wage"/>
                        <field name="reason" placeholder="e.g., Included December 2025 performance bonus..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm &amp; Update" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
