<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Set up demo company -->
    <record id="base.partner_demo_company_uz" model="res.partner" forcecreate="1">
        <field name="name">My Uzbek Company</field>
        <field name="street">Amir Temur Avenue 108</field>
        <field name="zip">100084</field>
        <field name="city">Tashkent</field>
        <field name="country_id" ref="base.uz"/>
        <field name="phone">+998 71 200 00 00</field>
        <field name="email">info@myuzbekcompany.uz</field>
        <field name="is_company">True</field>
    </record>

    <record id="base.demo_company_uz" model="res.company" forcecreate="1">
        <field name="name">My Uzbek Company</field>
        <field name="partner_id" ref="base.partner_demo_company_uz"/>
        <field name="currency_id" ref="base.UZS"/>
        <field name="street">Amir Temur Avenue 108</field>
        <field name="zip">100084</field>
        <field name="city">Tashkent</field>
        <field name="country_id" ref="base.uz"/>
    </record>

    <record id="base.demo_company_uz" model="res.company" forcecreate="1">
        <field name="resource_calendar_id" ref="l10n_uz_hr_payroll.resource_calendar_def_40h"/>
    </record>

    <record id="res_partner_uz_work_address" model="res.partner">
        <field name="name">Tashkent Main Office</field>
        <field name="street">Amir Temur Avenue 108</field>
        <field name="city">Tashkent</field>
        <field name="country_id" ref="base.uz"/>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <!-- Create users -->
    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_uz'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_uz'))]"/>
    </record>

    <record id="uz_hr_job_marketing_manager" model="hr.job">
        <field name="name">Marketing Manager</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <record id="uz_hr_job_accounting_manager" model="hr.job">
        <field name="name">Accounting Manager</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <record id="uz_hr_department_marketing" model="hr.department">
        <field name="name">Marketing</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <record id="uz_hr_department_administration" model="hr.department">
        <field name="name">Admin</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <!-- Employee Partners -->
    <record id="res_partner_sardor" model="res.partner">
        <field name="name">Sardor Yusupov</field>
        <field name="street">Yakkasaroy District, Kichik Halqa Yoli 14</field>
        <field name="city">Tashkent</field>
        <field name="zip">100089</field>
        <field name="country_id" ref="base.uz"/>
        <field name="phone">+998 90 153 42 90</field>
        <field name="email">sardor.yusupov@example.uz</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <record id="res_partner_feruza" model="res.partner">
        <field name="name">Feruza Abdullayeva</field>
        <field name="street">Mirobod District, Nukus Street 22</field>
        <field name="city">Tashkent</field>
        <field name="zip">100015</field>
        <field name="country_id" ref="base.uz"/>
        <field name="phone">+998 90 481 05 11</field>
        <field name="email">feruza.abdullayeva@example.uz</field>
        <field name="company_id" ref="base.demo_company_uz"/>
    </record>

    <!-- Employees -->
    <record id="hr_employee_sardor" model="hr.employee">
        <field name="name" model="res.partner" eval="obj(ref('res_partner_sardor')).name"/>
        <field name="work_phone">+998 71 200 00 10</field>
        <field name="work_email">sardor.yusupov@myuzbekcompany.uz</field>
        <field name="work_contact_id" ref="res_partner_sardor"/>
        <field name="address_id" ref="res_partner_uz_work_address"/>
        <field name="company_id" ref="base.demo_company_uz"/>
        <field name="tz">Asia/Tashkent</field>
        <field name="country_id" ref="base.uz"/>
        <field name="sex">male</field>
        <field name="birthday" eval="datetime(1989, 5, 14).date()"/>
        <field name="place_of_birth">Tashkent</field>
        <field name="country_of_birth" ref="base.uz"/>
        <field name="job_id" ref="uz_hr_job_marketing_manager"/>
        <field name="department_id" ref="uz_hr_department_marketing"/>
        <field name="structure_type_id" ref="l10n_uz_hr_payroll.l10n_uz_employee_payroll_structure_type"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage_type">monthly</field>
        <field name="wage">18000000</field>
        <field name="hr_responsible_id" ref="base.user_admin"/>
        <field name="resource_calendar_id" ref="l10n_uz_hr_payroll.resource_calendar_def_40h"/>
        <field name="contract_date_start" eval="datetime(2020, 12, 21).date()"/>
    </record>

    <record id="hr_employee_feruza" model="hr.employee">
        <field name="name" model="res.partner" eval="obj(ref('res_partner_feruza')).name"/>
        <field name="work_phone">+998 71 200 00 20</field>
        <field name="work_email">feruza.abdullayeva@myuzbekcompany.uz</field>
        <field name="work_contact_id" ref="res_partner_feruza"/>
        <field name="address_id" ref="res_partner_uz_work_address"/>
        <field name="company_id" ref="base.demo_company_uz"/>
        <field name="tz">Asia/Tashkent</field>
        <field name="country_id" ref="base.uz"/>
        <field name="sex">female</field>
        <field name="birthday" eval="datetime(1992, 8, 29).date()"/>
        <field name="place_of_birth">Tashkent</field>
        <field name="country_of_birth" ref="base.uz"/>
        <field name="job_id" ref="uz_hr_job_accounting_manager"/>
        <field name="department_id" ref="uz_hr_department_administration"/>
        <field name="structure_type_id" ref="l10n_uz_hr_payroll.l10n_uz_employee_payroll_structure_type"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage_type">monthly</field>
        <field name="wage">16000000</field>
        <field name="hr_responsible_id" ref="base.user_admin"/>
        <field name="resource_calendar_id" ref="l10n_uz_hr_payroll.resource_calendar_def_40h"/>
        <field name="contract_date_start" eval="datetime(2022, 2, 25).date()"/>
    </record>

    <!-- Leave Allocations -->
    <record id="hr_leave_allocation_sardor" model="hr.leave.allocation">
        <field name="name">Annual Leave Allocation for Sardor Yusupov</field>
        <field name="employee_id" ref="hr_employee_sardor"/>
        <field name="work_entry_type_id" ref="hr_work_entry.l10n_uz_work_entry_type_annual_labor_leave"/>
        <field name="number_of_days" eval="21"/>
        <field name="date_from" eval="time.strftime('%Y-01-01')"/>
        <field name="date_to" eval="time.strftime('%Y-12-31')"/>
        <field name="state">confirm</field>
    </record>

    <record id="hr_leave_allocation_feruza" model="hr.leave.allocation">
        <field name="name">Annual Leave Allocation for Feruza Abdullayeva</field>
        <field name="employee_id" ref="hr_employee_feruza"/>
        <field name="work_entry_type_id" ref="hr_work_entry.l10n_uz_work_entry_type_annual_labor_leave"/>
        <field name="number_of_days" eval="27"/>
        <field name="date_from" eval="time.strftime('%Y-01-01')"/>
        <field name="date_to" eval="time.strftime('%Y-12-31')"/>
        <field name="state">confirm</field>
    </record>

    <function model="hr.leave.allocation" name="action_approve">
        <value model="hr.leave.allocation" eval="[ref('hr_leave_allocation_sardor'), ref('hr_leave_allocation_feruza')]"/>
    </function>

    <!-- Leaves -->
    <record id="hr_leave_sardor_annual" model="hr.leave">
        <field name="employee_id" ref="hr_employee_sardor"/>
        <field name="work_entry_type_id" ref="hr_work_entry.l10n_uz_work_entry_type_annual_labor_leave"/>
        <field name="request_date_from" eval="time.strftime('%Y-%m-10')"/>
        <field name="request_date_to" eval="time.strftime('%Y-%m-16')"/>
        <field name="state">confirm</field>
    </record>

    <record id="hr_leave_feruza_annual" model="hr.leave">
        <field name="employee_id" ref="hr_employee_feruza"/>
        <field name="work_entry_type_id" ref="hr_work_entry.l10n_uz_work_entry_type_annual_labor_leave"/>
        <field name="request_date_from" eval="time.strftime('%Y-%m-05')"/>
        <field name="request_date_to" eval="time.strftime('%Y-%m-15')"/>
        <field name="state">confirm</field>
    </record>

    <function model="hr.leave" name="action_approve">
        <value model="hr.leave" eval="[ref('hr_leave_sardor_annual'), ref('hr_leave_feruza_annual')]"/>
    </function>

    <!-- Payruns-->
    <record id="hr_payslip_run_uz_previous" model="hr.payslip.run">
        <field name="name" eval="'Uz Payrun ' + (DateTime.today() - relativedelta(months=1, day=1)).strftime('%m %Y')"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(months=1, day=31)).strftime('%Y-%m-%d')"/>
        <field name="company_id" ref="base.demo_company_uz"/>
        <field name="version_ids" model="hr.employee" eval="[Command.set(obj([ref('hr_employee_sardor'), ref('hr_employee_feruza')]).version_id.ids)]"/>
        <field name="structure_id" ref="l10n_uz_hr_payroll.l10n_uz_monthly_pay_structure"/>
    </record>

    <record id="hr_payslip_run_uz_current" model="hr.payslip.run">
        <field name="name" eval="'Uz Payrun ' + DateTime.today().strftime('%m %Y')"/>
        <field name="date_start" eval="(DateTime.today() + relativedelta(day=1)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(day=31)).strftime('%Y-%m-%d')"/>
        <field name="company_id" ref="base.demo_company_uz"/>
        <field name="version_ids" model="hr.employee" eval="[Command.set(obj([ref('hr_employee_sardor'), ref('hr_employee_feruza')]).version_id.ids)]"/>
        <field name="structure_id" ref="l10n_uz_hr_payroll.l10n_uz_monthly_pay_structure"/>
    </record>

    <function model="hr.payslip.run" name="_generate_payslips">
        <value model="hr.payslip.run" eval="ref('hr_payslip_run_uz_previous')"/>
    </function>

    <function model="hr.payslip.run" name="_generate_payslips">
        <value model="hr.payslip.run" eval="ref('hr_payslip_run_uz_current')"/>
    </function>

    <function model="hr.payslip.run" name="action_validate">
        <value model="hr.payslip.run" eval="[ref('hr_payslip_run_uz_previous')]"/>
    </function>
</odoo>
