<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Departure reasons for Uzbekistan -->
    <!-- The reasons that qualify the employee to receieve severance can be found in Article 168 and 173 of the Labor Code of Uzbekistan -->
    <!-- https://lex.uz/en/docs/6257291#6261954 -->
    <record id="l10n_uz_departure_business_reasons" model="hr.departure.reason">
        <field name="name">No-fault business reasons (employer-initiated)</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">True</field>
    </record>

    <record id="l10n_uz_departure_circumstances_beyond_control" model="hr.departure.reason">
        <field name="name">Circumstances beyond either party's control</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">True</field>
    </record>

    <record id="l10n_uz_departure_employee_declines_change" model="hr.departure.reason">
        <field name="name">Employee declines a change the employer initiated</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">True</field>
    </record>

    <record id="l10n_uz_departure_employee_fault" model="hr.departure.reason">
        <field name="name">Employee's own fault</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">False</field>
    </record>

    <record id="l10n_uz_departure_employer_incapacity" model="hr.departure.reason">
        <field name="name">Employer-side incapacity</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">False</field>
    </record>

    <record id="l10n_uz_departure_resignation" model="hr.departure.reason">
        <field name="name">Resignation</field>
        <field name="country_id" ref="base.uz"/>
        <field name="l10n_uz_is_severance_paid">False</field>
    </record>
</odoo>
