<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uz_monthly_pay_structure" model="hr.payroll.structure">
        <field name="name">Uzbekistan: Monthly Pay</field>
        <field name="country_id" ref="base.uz"/>
        <field name="code">UZMONTHLY</field>
        <field name="type_id" ref="l10n_uz_hr_payroll.l10n_uz_employee_payroll_structure_type"/>
        <field name="rule_ids" eval="[]"/>
    </record>

    <record id="l10n_uz_hr_payroll.l10n_uz_employee_payroll_structure_type" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_uz_monthly_pay_structure"/>
        <field name="default_work_entry_type_id" ref="hr_work_entry.uz_work_entry_type_attendance"/>
    </record>
</odoo>
