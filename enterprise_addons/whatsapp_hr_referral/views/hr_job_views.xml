<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_hr_job_employee_referral_kanban_inherit_referral_whatsapp">
        <field name="name">hr.job.employee.referral.kanban.inherit.referral.whatsapp</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_referral.view_hr_job_employee_referral_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('o_hr_referral_send_mail')]/.." position="after">
                <li>
                    <a class="dropdown-item" name="action_open_whatsapp_composer" type="object" role="button">
                        <i class="oi oi-lg oi-fw me-2 text-center" data-icon="oi_whatsapp" role="img" aria-label="Send by WhatsApp"/>
                        Send by WhatsApp
                    </a>
                </li>
            </xpath>
        </field>
    </record>
</odoo>
