<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_iot_six.pos_six_balance_receipt">
            <html id="pos-receipt">
                <head>
                    <meta charset="UTF-8"></meta>  <!--  Needed for wkhtmltoimage to render UTF-8 characters properly -->
                    <t t-call="point_of_sale.pos_order_receipt_style" />
                </head>
                <div class="text-center" style="font-size: 32px;">
                    <t t-foreach="lines" t-as="line">
                        <t t-esc="line"/>
                        <br t-if="not line_last"/>
                    </t>
                </div>
            </html>
        </template>
    </data>
</odoo>
