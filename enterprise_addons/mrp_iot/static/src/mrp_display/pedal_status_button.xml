<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp_iot.PedalStatusButton">
        <button class="btn w-100 border-end border-bottom"
                t-att-class="{ 'btn-primary o_active': this.props.pedalConnected, 'btn-warning': !this.props.pedalConnected }"
                data-tooltip="Pedal Status" aria-label="Pedal Status" t-on-click.stop="this.props.takeOwnership">
            <i class="oi" data-icon="assignment" />
        </button>
    </t>

</templates>
