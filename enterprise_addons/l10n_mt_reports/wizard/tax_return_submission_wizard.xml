<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mt_tax_return_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_mt_reports.tax.return.submission.wizard.form</field>
            <field name="model">l10n_mt_reports.tax.return.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download your Tax return report.</span><br/>
                                        <button string="Download PDF" name="print_pdf" type="object" class="btn-secondary mb-1"/>
                                    </div>
                                </li>
                                <li>Log in to the  <a href="https://cfr.gov.mt" target="_blank">Commissioner for Revenue (CfR)</a> online portal</li>
                                <li>Use your <b>e-ID credentials</b> or <b>CfR login</b> to access the portal.</li>
                                <li>Select the applicable <b>VAT Return form </b>(quarterly/monthly, depending on your registration).</li>
                                <li>Fill in the VAT Form with the Tax report generated in Odoo.</li>
                                <li>Validate and Submit the Form on the portal.</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
