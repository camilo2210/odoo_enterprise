<odoo>
    <data>
        <record id="view_l10n_bg_saft_file_attachment_error_wizard_form" model="ir.ui.view">
            <field name="name">l10n_bg_saft.file.attachment.error.wizard.form</field>
            <field name="model">l10n_bg_saft.file.attachment.error.wizard</field>
            <field name="arch" type="xml">
                <form string="File Attachment Errors">
                    <div>
                        <field name="actionable_errors" class="o_field_html w-100" widget="actionable_errors"/>
                    </div>
                    <footer>
                        <button string="Proceed Anyway"
                                name="button_proceed_with_errors"
                                type="object"
                                class="btn btn-primary"
                                close="1"
                                data-hotkey="d"/>
                        <button string="Close"
                                class="btn btn-secondary"
                                special="cancel"
                                data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
