<odoo>
    <record id="product_uom_form_inherit_l10n_bg_saft" model="ir.ui.view">
        <field name="name">uom.uom.form.inherit.l10n.bg.saft</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form"/>
        <field name="arch" type="xml">
            <group name="uom_details" position="after">
                <group name="l10n_bg_saft_uom_details">
                    <label for="l10n_bg_saft_uom_conversion_factor" string="Quantity (BG SAF-T)" />
                    <div class="o_row oe_inline">
                        <field
                            name="l10n_bg_saft_uom_conversion_factor"
                            class="oe_inline" style="max-width: 80px;"
                            readonly="(context.get('product_id') or context.get('product_ids')) and id" digits="[12, 5]"
                            help="Unit of Measure equivalent in the Bulgarian SAF-T report"
                        />
                        <field
                            name="l10n_bg_saft_uom_code"
                            placeholder="BG SAF-T Reference Unit Code"
                            class="oe_inline"
                            readonly="(context.get('product_id') or context.get('product_ids')) and id"
                        />
                    </div>
                    <field
                        name="l10n_bg_saft_uom_description"
                        placeholder="Reference Unit Description"
                        readonly="(context.get('product_id') or context.get('product_ids')) and id"
                    />
                </group>
            </group>
        </field>
    </record>

    <record id="product_uom_tree_inherit_l10n_bg_saft" model="ir.ui.view">
        <field name="name">uom.uom.list.inherit.l10n.bg.saft</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_list"/>
        <field name="arch" type="xml">
            <field name="relative_uom_id" position="after">
                <field
                    name="l10n_bg_saft_uom_conversion_factor"
                    string="BG SAF-T Conversion factor"
                    invisible="l10n_bg_saft_uom_conversion_factor == 1"
                    optional="hide"
                />
                <field name="l10n_bg_saft_uom_code" string="Bg SAF-T Code" optional="hide"/>
                <field name="l10n_bg_saft_uom_description" string="Bulgarian SAF-T Description" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
