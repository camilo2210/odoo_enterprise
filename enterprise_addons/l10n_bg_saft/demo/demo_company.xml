<odoo>
    <record id="base.partner_demo_company_bg" model="res.partner">
        <field name="vat">BG123123123</field>
        <field name="additional_identifiers" eval="{'BG_CN': '1234321'}"/>
    </record>
    <record id="base.demo_company_bg" model="res.company">
        <field name="l10n_bg_saft_tax_accounting_basis">A</field>
        <field name="l10n_bg_saft_ownership_structure">1</field>
        <field name="l10n_bg_saft_tax_entity_type">Company</field>
    </record>

    <record id="base.partner_demo_company_bg_contact2" model="res.partner" forcecreate="1">
        <field name="name">BG Partner Name</field>
        <field name="country_id" ref="base.bg" />
        <field name="phone">12345654321</field>
        <field name="email">bg_partner_name@game.odoo.com</field>
        <field name="function">CEO</field>
        <field name="is_company" eval="False" />
        <field name="parent_id" ref="base.partner_demo_company_bg" />
    </record>

    <record id="product.consu_delivery_01" model="product.product">
        <field name="default_code">IR10000</field>
    </record>
    <record id="product.product_product_2" model="product.product">
        <field name="default_code">IR20000</field>
    </record>
    <record id="account_move_1" model="account.move">
        <field name="partner_id" ref="base.res_partner_1" />
        <field name="user_id" eval="False" />
    </record>
    <record id="demo_invoice_1" model="account.move" context="{'allowed_company_ids': [ref('base.demo_company_bg')]}">
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="move_type">out_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m')+'-01'"/>
        <field name="invoice_line_ids" eval="[
            (0, 0, {
                'product_id': ref('product.consu_delivery_01'),
                'price_unit': 12.0,
                'quantity': 100,
                'tax_ids': [(6, 0, [
                    ref('account.%s_l10n_bg_sale_vat_20' % ref('base.demo_company_bg')),
                ])],
            })
        ]"/>
    </record>
    <record id="demo_bill_1" model="account.move" context="{'allowed_company_ids': [ref('base.demo_company_bg')]}">
        <field name="partner_id" ref="base.res_partner_3"/>
        <field name="move_type">in_invoice</field>
        <field name="invoice_date" eval="time.strftime('%Y-%m')+'-01'"/>
        <field name="invoice_line_ids" eval="[
            (0, 0, {
                'product_id': ref('product.product_product_2'),
                'price_unit': 301.0,
                'quantity': 11,
                'tax_ids': [(6, 0, [
                    ref('account.%s_l10n_bg_purchase_vat_20_ftc' % ref('base.demo_company_bg')),
                ])],
            })
        ]"/>
    </record>

    <function model="account.move" name="action_post">
        <value eval="[
            ref('demo_invoice_1'),
            ref('demo_bill_1'),
        ]"/>
    </function>

</odoo>
