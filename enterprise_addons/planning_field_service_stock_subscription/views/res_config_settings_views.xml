<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.planning_field_service_stock_subscription</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="planning.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@name='allow_customer_report_setting']" position="after">
                <setting name="allow_maintenance_contract_setting" invisible="not group_field_service_allow_equipment"
                    help="Track whether customer equipment is covered by a maintenance contract via subscriptions">
                    <field name="group_field_service_allow_maintenance_contract" string="Maintenance Contracts"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
