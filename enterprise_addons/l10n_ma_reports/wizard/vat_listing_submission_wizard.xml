<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vat_listing_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_ma_reports.vat.listing.submission.wizard.form</field>
            <field name="model">l10n_ma_reports.vat.listing.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <div role="alert" invisible="not xml_generation_errors">
                        <field name="xml_generation_errors" widget="actionable_errors" class="w-100"/>
                    </div>
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download the VAT statement</span><br/>
                                        <button string="Download XML" name="print_xml" type="object" class="btn-secondary" invisible="has_critical_errors"/>
                                        <button string="Download XML" class="btn-secondary" invisible="not has_critical_errors" disabled="" />
                                    </div>
                                </li>
                                <li>Log in to the DGI's professional space and access the <a href="https://tva.tax.gov.ma/tva/#/login" target="_blank">SIMPL-TVA</a></li>
                                <li>Upload the XML file</li>
                                <li>Validate it</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
