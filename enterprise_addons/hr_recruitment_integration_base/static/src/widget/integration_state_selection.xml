<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_recruitment_integration_base.IntegrationStateSelection">
        <t t-if="this.props.ribbon">
            <div class="ribbon ribbon-top-right">
                <span t-att-class="this.ribbonClassNames">
                    <t t-out="this.title"/>
                </span>
            </div>
        </t>
        <t t-else="">
            <div t-att-title="this.title">
                <i t-att-class="this.imgClassNames" data-icon="circle"/>
            </div>
        </t>
    </t>

</templates>
