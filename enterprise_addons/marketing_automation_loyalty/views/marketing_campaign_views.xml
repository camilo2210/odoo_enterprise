<odoo>
    <record id="marketing_campaign_view_form" model="ir.ui.view">
        <field name="name">marketing.automation.loyalty.campaign.view.form</field>
        <field name="model">marketing.campaign</field>
        <field name="inherit_id" ref="marketing_automation.marketing_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='marketing_activity_ids']/list" position="inside">
                <field name="loyalty_program_id"/>
                <field name="loyalty_mail_template_id"/>
            </xpath>
        </field>
    </record>
</odoo>
