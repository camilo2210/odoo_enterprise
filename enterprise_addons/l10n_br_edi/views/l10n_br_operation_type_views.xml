<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_br_operation_type_form_inherit" model="ir.ui.view">
            <field name="name">l10n_br.operation.type.form.inherit</field>
            <field name="model">l10n_br.operation.type</field>
            <field name="inherit_id" ref="l10n_br_avatax.l10n_br_operation_type_form"/>
            <field name="arch" type="xml">
                <field name="active" position="after">
                    <field name="l10n_br_cfop_code"/>
                </field>
                <group position="inside">
                    <field name="has_inbound_cbs_ibs_credit"/>
                    <field name="is_used_movable_good"/>
                    <field name="credit_classification"/>
                    <field name="is_donation"/>
                    <field name="l10n_br_customs_regime_id"/>
                    <field name="l10n_br_transaction_usage"/>
                    <field name="l10n_br_service_operation_indicator"/>
                </group>
                <field name="l10n_br_use_type" position="after">
                    <field name="l10n_br_taxable_is"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page string="Taxes Settings" name="cst_taxes">
                        <field name="operation_tax_override_ids" nolabel="1" >
                            <list editable="bottom">
                                <field name="tax_id"/>
                                <field name="cst_code"/>
                                <field name="c_class_trib"/>
                                <field name="benefit_code"/>
                                <field name="l10n_br_avatax_code"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
