<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_department_rdbe" model="hr.department">
        <field name="name">RD BE</field>
        <field name="company_id" ref="base.demo_company_be"/>
    </record>

    <record id="job_developer_be" model="hr.job">
        <field name="name">Experienced Developer (BE)</field>
        <field name="department_id" ref="hr_department_rdbe"/>
        <field name="no_of_recruitment">5</field>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="description">
            We are looking for an experienced developer to join our Web team in Belgium.
            Someone who can snap out of coding and perform analysis or meet clients to explain the technical
            possibilities that can meet their needs.
        </field>
        <field name="company_id" ref="base.demo_company_be"/>
    </record>

    <record id="l10n_be_hr_payroll.contract_template_be_cdi_experienced_developer" model="hr.version">
        <field name="job_id" ref="job_developer_be"/>
        <field name="wage">2650</field>
        <field name="has_new_car" eval="False"/>
        <field name="new_car_model_id" ref="fleet.model_corolla_ts"/>
        <field name="ip_wage_rate">0.25</field>
        <field name="hr_responsible_id" ref="base.user_demo"/>
        <field name="sign_template_id" ref="hr_contract_salary.sign_template_cdi_developer"/>
        <field name="contract_update_template_id" ref="hr_contract_salary.sign_template_cdi_developer"/>
    </record>

    <record id="job_developer_be" model="hr.job">
        <field name="contract_template_id" ref="l10n_be_hr_payroll.contract_template_be_cdi_experienced_developer"/>
    </record>

    <record id="employee_max" model="hr.employee">
        <field name="name">Max Durand</field>
        <field name="job_id" ref="job_developer_be"/>
        <field name="structure_type_id" ref="hr.structure_type_employee_cp200"/>
        <field name="country_id" ref="base.be"/>
        <field name="company_id" ref="base.demo_company_be"/>
        <field name="image_1920" type="bytes" file="hr_contract_salary/static/img/hr_employee_max_durand.webp"/>
        <field name="structure_type_id" ref="hr.structure_type_employee_cp200"/>
        <field name="niss">03062411377</field>
        <field name="structure_type_id" ref="hr.structure_type_employee_cp200"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="l10n_be_dimona_category">oth</field>
        <field name="meal_voucher_amount">8.0</field>
        <field name="l10n_be_joint_committee_id" ref="l10n_be_hr_payroll.l10n_be_joint_committee_200"/>
    </record>

    <record id="res_partner_laurie_poiret" model="res.partner">
        <field name="name">Laurie Poiret</field>
        <field name="street">58 rue des Wallons</field>
        <field name="city">Louvain-la-Neuve</field>
        <field name="zip">1348</field>
        <field name="country_id" ref="base.be"/>
        <field name="phone">+0032476543210</field>
        <field name="email">laurie.poiret@example.com</field>
        <field name="company_id" ref="base.demo_company_be"/>
    </record>

    <record id="user_laurie_poiret" model="res.users">
        <field name="partner_id" ref="l10n_be_hr_contract_salary.res_partner_laurie_poiret"/>
        <field name="login">laurie.poiret@example.com</field>
        <field name="password">lauriepoiret</field>
        <field name="signature" type="html"><div>L. Poiret</div></field>
        <field name="company_ids" eval="[(4, ref('base.demo_company_be'))]"/>
        <field name="company_id" ref="base.demo_company_be"/>
        <field name="group_ids" eval="[(6,0,[ref('base.group_user')])]"/>
        <field name="image_1920" type="bytes" file="hr_contract_salary/static/img/hr_employee_laurie_poiret.webp"/>
    </record>

    <record id="res_partner_laurie_poiret_work_address" model="res.partner">
        <field name="name">Belgian Offices</field>
        <field name="street">85 rue des Flamands</field>
        <field name="city">Louvain</field>
        <field name="zip">8431</field>
        <field name="country_id" ref="base.be"/>
        <field name="company_id" ref="base.demo_company_be"/>
    </record>

    <record id="res_partner_bank_account_laurie_poiret" model="res.partner.bank">
        <field name="account_number">BE10561132778404</field>
        <field name="bank_name">ING</field>
        <field name="bank_bic">BBRUBEBB</field>
        <field name="partner_id" ref="l10n_be_hr_contract_salary.res_partner_laurie_poiret"/>
        <field name="company_id" ref="base.demo_company_be"/>
        <field name="allow_out_payment" eval="True"/>
    </record>

    <record id="fleet.model_corolla_ts" model="fleet.vehicle.model" context="{'allowed_company_ids': [ref('base.demo_company_be')]}">
        <field name="can_be_requested" eval="True"/>
        <field name="default_car_value">18000</field>
        <field name="default_co2">88</field>
        <field name="default_fuel_type">diesel</field>
        <field name="default_recurring_cost_amount_depreciated">450.00</field>
    </record>

    <record id="fleet_vehicle_model_category_family_car" model="fleet.vehicle.model.category">
        <field name="name">Small Family Car</field>
    </record>

    <record id="fleet.model_golf_8" model="fleet.vehicle.model">
        <field name="category_id" ref="l10n_be_hr_contract_salary.fleet_vehicle_model_category_family_car"/>
    </record>

    <record id="fleet_vehicle_golf_8_laurie_poiret" model="fleet.vehicle">
        <field name="model_id" ref="fleet.model_golf_8"/>
        <field name="license_plate">1-JFC-095</field>
        <field name="acquisition_date" eval="time.strftime('2020-01-01')"/>
        <field name="co2">88</field>
        <field name="car_value">38000</field>
        <field name="company_id" ref="base.demo_company_be"/>
        <field name="transmission">manual</field>
    </record>

    <record id="fleet_vehicle_log_contract_golf_8_laurie_poiret" model="fleet.vehicle.log.contract">
        <field name="recurring_cost_amount_depreciated">450.0</field>
        <field name="state">open</field>
        <field name="vehicle_id" ref="fleet_vehicle_golf_8_laurie_poiret"/>
    </record>

    <record id="fleet_vehicle_brand_eddy_merckx" model="fleet.vehicle.model.brand">
        <field name="name">Eddy Merckx</field>
        <field name="image_128" type="bytes" file="l10n_be_hr_contract_salary/static/img/brand-eddy-merckx.jpg"/>
    </record>

    <record id="fleet_vehicle_model_san_remo" model="fleet.vehicle.model" context="{'allowed_company_ids': [ref('base.demo_company_be')]}">
        <field name="name">SanRemo76</field>
        <field name="brand_id" ref="fleet_vehicle_brand_eddy_merckx"/>
        <field name="vehicle_type">bike</field>
        <field name="can_be_requested" eval="True"/>
        <field name="default_car_value">1000</field>
        <field name="default_recurring_cost_amount_depreciated">25</field>
    </record>

    <record id="fleet_vehicle_bike_laurie_poiret" model="fleet.vehicle">
        <field name="model_id" ref="fleet_vehicle_model_san_remo"/>
        <field name="car_value">1000</field>
        <field name="company_id" ref="base.demo_company_be"/>
    </record>

    <record id="hr_employee_laurie_poiret" model="hr.employee">
        <field name="name">Laurie Poiret (lap)</field>
        <field name="work_contact_id" ref="res_partner_laurie_poiret"/>
        <field name="marital">single</field>
        <field name="private_street">58 rue des Wallons</field>
        <field name="private_city">Louvain-la-Neuve</field>
        <field name="private_zip">1348</field>
        <field name="private_country_id" ref="base.be"/>
        <field name="private_phone">+0032476543210</field>
        <field name="private_email">laurie.poiret@example.com</field>
        <field name="address_id" ref="l10n_be_hr_contract_salary.res_partner_laurie_poiret_work_address"/>
        <field name="emergency_contact">Marc Poiret</field>
        <field name="emergency_phone">+0032498765432</field>
        <field name="distance_home_work">75</field>
        <field name="place_of_birth">Brussels</field>
        <field name="country_of_birth" ref="base.be"/>
        <field name="certificate">master</field>
        <field name="study_field">Civil Engineering</field>
        <field name="parent_id" ref="l10n_be_hr_contract_salary.employee_max"/>
        <field name="country_id" ref="base.be"/>
        <field name="niss">91072845880</field>
        <field name="bank_account_ids" eval="[(4, ref('l10n_be_hr_contract_salary.res_partner_bank_account_laurie_poiret'))]"/>
        <field name="image_1920" type="bytes" file="hr_contract_salary/static/img/hr_employee_laurie_poiret.webp"/>
        <field name="company_id" ref="base.demo_company_be"/>
        <field name="user_id" ref="l10n_be_hr_contract_salary.user_laurie_poiret"/>
        <field name="wage">2500</field>
        <field name="commission_on_target">0.0</field>
        <field name="transport_mode_car" eval="True"/>
        <field name="has_new_car" eval="False"/>
        <field name="car_id" ref="fleet_vehicle_golf_8_laurie_poiret"/>
        <field name="transport_mode_bike" eval="False"/>
        <field name="bike_id" ref="fleet_vehicle_bike_laurie_poiret"/>
        <field name="ip_wage_rate">0.25</field>
        <field name="hr_responsible_id" ref="base.user_demo"/>
        <field name="job_id" ref="job_developer_be"/>
        <field name="structure_type_id" ref="hr.structure_type_employee_cp200"/>
        <field name="contract_template_id" ref="l10n_be_hr_payroll.contract_template_be_cdi_experienced_developer"/>
        <field name="department_id" ref="hr_department_rdbe"/>
        <field name="sign_template_id" ref="hr_contract_salary.sign_template_cdi_developer"/>
        <field name="contract_update_template_id" ref="hr_contract_salary.sign_template_cdi_developer"/>
        <field name="date_version" eval="(DateTime.today() + relativedelta(years=-2, month=1, day=1))"/>
        <field name="contract_date_start" eval="(DateTime.today() + relativedelta(years=-2, month=1, day=1))"/>
        <field name="contract_date_end" eval="(DateTime.today() + relativedelta(years=-1, month=1, day=1, days=-2))"/>
        <field name="resource_calendar_id" model="resource.calendar" eval="obj().env.ref('base.demo_company_be').resource_calendar_id"/>
        <field name="rd_percentage">1.0</field>
        <field name="structure_type_id" ref="hr.structure_type_employee_cp200"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="l10n_be_dimona_category">oth</field>
        <field name="l10n_be_salary_scale_id" ref="l10n_be_hr_payroll.cp200_a"/>
        <field name="meal_voucher_amount">8.0</field>
        <field name="l10n_be_joint_committee_id" ref="l10n_be_hr_payroll.l10n_be_joint_committee_200"/>
    </record>

    <function name="create_version" model="hr.employee" context="{'allowed_company_ids': [ref('base.demo_company_be')]}">
        <value eval="[ref('l10n_be_hr_contract_salary.hr_employee_laurie_poiret')]"/>
        <value eval="{
            'date_version': DateTime.today() + relativedelta(years=-1, month=1, day=1, days=-1),
            'contract_date_start': DateTime.today() + relativedelta(years=-1, month=1, day=1, days=-1),
            'contract_date_end': False,
            'wage': 2650.00,
        }"/>
    </function>

    <record id="base.partner_demo" model="res.partner">
        <field name="phone">+0032 81 00 10</field>
    </record>

    <function model="l10n.be.joint.committee" name="write">
        <value eval="[ref('l10n_be_hr_payroll.l10n_be_joint_committee_200')]"/>
        <value eval="{'active': True}"/>
    </function>
</odoo>
