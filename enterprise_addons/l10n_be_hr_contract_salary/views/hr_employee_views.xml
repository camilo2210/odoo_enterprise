<?xml version="1.0"?>
<odoo>

    <record id="hr_employee_view_form_inherit_contract_salary" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.contract.salary</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_contract_salary.hr_contract_salary_view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(hr_contract_salary.action_hr_salary_simulator)d']" position="attributes">
                <attribute name="invisible">country_code == 'BE' and departure_date</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_inherit_be_payroll" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.be.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="l10n_be_hr_payroll.hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="benefits" position="inside">
                <label for="holidays"/>
                <div class="o_row">
                    <field name="holidays" class="o_hr_narrow_field"/>
                    <span>days / year</span>
                </div>
            </group>
        </field>
    </record>
</odoo>
