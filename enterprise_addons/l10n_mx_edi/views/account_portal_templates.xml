<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the b2b fields from the address form when the
         RFC is collected through the localisation fields required to invoice
         instead. -->
    <template id="portal_address_form_fields" inherit_id="portal.address_form_fields">
        <t name="b2b_fields" position="attributes">
            <attribute name="t-if">not l10n_mx_hide_b2b_fields</attribute>
        </t>
    </template>

    <template id="portal_invoice_required_fields_form"
              inherit_id="account.portal_invoice_required_fields_form">
        <xpath expr="//t[@t-if=&quot;required_field.ttype == 'selection'&quot;]" position="after">
            <t t-elif="required_field.ttype == 'char' and l10n_mx_hide_b2b_fields">
                <label class="col-form-label" t-att-for="field_prefix + required_field.name">
                    <t t-out="required_field.field_description"/>
                </label>
                <input type="text" class="form-control"
                       t-att-name="field_prefix + required_field.name"
                       t-att-value="default_value" required="required"/>
            </t>
        </xpath>
    </template>
</odoo>
