<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_mx_edi.BankRecSelectCreateDialog" t-inherit="account_accountant.BankRecSelectCreateDialog" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_select_button')]" position="after">
            <button class="btn btn-primary o_factoring_button"
                t-if="this.canUseFactoring"
                t-att-disabled="!this.state.resIds.length"
                t-on-click="this.onSelectAndDistribute"
            >
                Select &amp; Distribute
            </button>
        </xpath>
    </t>
</templates>
