<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <record id="l10n_sa_monthly_benefit" model="hr.contract.salary.benefit.type">
        <field name="name">Monthly Benefit in Kind</field>
        <field name="sequence">5</field>
    </record>

    <record id="l10n_sa_yearly_benefit" model="hr.contract.salary.benefit.type">
        <field name="name">Yearly Benefit in Kind</field>
        <field name="periodicity">yearly</field>
        <field name="sequence">5</field>
    </record>

    <record id="l10n_sa_housing_allowance_amount" model="hr.contract.salary.benefit">
        <field name="name">Housing Allowance</field>
        <field name="show_name">True</field>
        <field name="res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_sa_housing_allowance')])"/>
        <field name="cost_res_field_id" model="ir.model.fields" eval="obj().search([('model', '=', 'hr.version'), ('name', '=', 'l10n_sa_housing_allowance')])"/>
        <field name="sequence">5</field>
        <field name="benefit_type_id" ref="l10n_sa_monthly_benefit"/>
        <field name="structure_type_id" ref="l10n_sa_hr_payroll.ksa_employee_payroll_structure_type"/>
        <field name="display_type">always</field>
    </record>

