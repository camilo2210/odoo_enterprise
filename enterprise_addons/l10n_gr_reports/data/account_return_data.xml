<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gr_tax_return_type" model="account.return.type">
            <field name="name">Tax</field>
            <field name="report_id" ref="l10n_gr.tax_report"/>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="country_id" ref="base.gr" />
        </record>

        <record id="gr_ec_sales_list_return_type" model="account.return.type">
            <field name="name">EC Sales List</field>
            <field name="report_id" ref="account_reports.generic_ec_sales_report"/>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">26</field>
            <field name="country_id" ref="base.gr"/>
            <field name="auto_generate" eval="False"/>
        </record>
    </data>
</odoo>
