<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gr_tax_return_type_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_gr_reports.tax.return.type.submission.wizard.form</field>
            <field name="model">l10n_gr_reports.tax.return.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download your KMD PDF report</span><br/>
                                        <button string="Download PDF" name="print_pdf" type="object" class="btn-secondary"/>
                                    </div>
                                </li>
                                <li>Log in to <a href="https://www.aade.gr/mydata" target="_blank">e‑MTA</a></li>
                                <li>Taxes &gt; Value Added Tax &gt; Submit and view KMD</li>
                                <li>Upload the PDF file on the right panel and click "Continue"</li>
                                <li>Validate the VAT declaration</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
