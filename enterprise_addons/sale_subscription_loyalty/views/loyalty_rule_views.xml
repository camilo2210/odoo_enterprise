<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_loyalty_rule_view_form" model="ir.ui.view">
        <field name="name">sale.subscription.loyalty.rule.view.form</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='rule_points_group']" position="after">
                <group>
                    <separator string="Subscription" colspan="2"/>
                    <field name="recurring_invoice"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
