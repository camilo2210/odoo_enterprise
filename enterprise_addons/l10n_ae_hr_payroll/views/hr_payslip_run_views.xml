<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payrun_payslip_kanban_card_view" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.kanban.inherit.l10n.ae.hr.payroll</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payrun_payslip_kanban_card_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='total_employer_cost']]" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'AE'"/>
            </xpath>

            <xpath expr="//div[hasclass('o_payrun_metrics')]/div[.//field[@name='net_sum']]" position="before">
                <div class="d-flex flex-column align-items-start" invisible="country_code != 'AE'">
                    <div class="small fw-medium d-flex gap-2 align-items-center">
                        <i class="oi" data-icon="work"/>
                        <span>Total Cost</span>
                    </div>
                    <div class="fs-6 fw-medium">
                        <field name="l10n_ae_total_net_cost"/>
                    </div>
                </div>

                <div class="d-flex flex-column align-items-start" invisible="country_code != 'AE'">
                    <div class="small fw-medium d-flex gap-2 align-items-center">
                        <i class="oi" data-icon="payments"/>
                        <span>Total Static Allowance</span>
                    </div>
                    <div class="fs-6 fw-medium">
                        <field name="l10n_ae_total_static_allowance"/>
                    </div>
                </div>

                <div class="d-flex flex-column align-items-start" invisible="country_code != 'AE'">
                    <div class="small fw-medium d-flex gap-2 align-items-center">
                        <i class="oi" data-icon="payments"/>
                        <span>Total Variable Allowance</span>
                    </div>
                    <div class="fs-6 fw-medium">
                        <field name="l10n_ae_total_variable_allowance"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
