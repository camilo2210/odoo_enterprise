<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ae_emiratization_target_view_list" model="ir.ui.view">
        <field name="name">l10n.ae.emiratization.target.view.list</field>
        <field name="model">l10n_ae.emiratization.target</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="effective_date"/>
                <field name="target_percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="emiratization_target_action" model="ir.actions.act_window">
        <field name="name">Emiratization Targets</field>
        <field name="res_model">l10n_ae.emiratization.target</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_emiratization_target"
        name="Emiratization Targets"
        action="emiratization_target_action"
        parent="hr.menu_config_recruitment"
    />
</odoo>
