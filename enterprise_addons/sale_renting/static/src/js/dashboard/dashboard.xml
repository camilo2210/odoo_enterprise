<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="sale_renting.Dashboard">
        <div name="dashboard" class="o_dashboard d-flex flex-wrap align-items-center justify-content-between position-sticky z-1 start-0 h-auto w-100 p-3 pt-1 gap-2">
            <t t-foreach="this.dashboardCardGroups" t-as="group" t-key="group.key">
                <div class="d-flex flex-wrap gap-2 flex-grow-1 flex-md-grow-0">
                    <t t-foreach="group.cards" t-as="card" t-key="card.label">
                        <button
                            t-att-class="this.getCardClass(card)"
                            t-att-title="card.label"
                            t-on-click="() => this.onCardClick(card.filter)"
                        >
                            <span class="o_dashboard_card_data fs-4 fw-bolder lh-sm d-block">
                                <t t-out="card.count ?? 0"/>
                            </span>
                            <span class="d-block" t-out="card.label"/>
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
