<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <menuitem
        id="rental_menu_root"
        name="Rental"
        web_icon="sale_renting,static/description/icon.png"
        groups="sales_team.group_sale_salesman"
        sequence="45">

        <menuitem id="rental_order_menu"
            name="Orders"
            sequence="2">

            <menuitem id="rental_orders_all"
                name="Orders"
                action="rental_order_action"
                sequence="1"/>

            <menuitem id="menu_orders_customers"
                name="Customers"
                action="account.res_partner_action_customer"
                sequence="2"/>

        </menuitem>

        <menuitem id="menu_rental_schedule"
            name="Schedule"
            action="action_rental_order_schedule"
            sequence="3"/>

        <menuitem id="menu_catalog"
            name="Products"
            sequence="4">

            <menuitem id="menu_catalog_products"
                name="Products"
                action="rental_product_template_action"
                sequence="10"/>
            <menuitem id="menu_product_attributes"
                name="Attributes"
                action="product.attribute_action"
                sequence="20"
                groups="product.group_product_variant"/>
            <menuitem id="menu_product_categories"
                action="product.product_category_action_form"
                sequence="30"/>
            <menuitem id="menu_catalog_pricelists"
                name="Pricelists"
                action="product.product_pricelist_action2"
                groups="product.group_product_pricelist"
                sequence="40"/>

        </menuitem>

        <menuitem id="menu_rental_reporting"
            name="Reporting"
            action="action_rental_report"
            groups="sales_team.group_sale_manager"
            sequence="6"/>

        <menuitem id="menu_rental_config"
            name="Configuration"
            groups="sales_team.group_sale_manager"
            sequence="10">

            <menuitem id="menu_rental_settings"
                name="Settings"
                action="action_rental_config_settings"
                groups="base.group_system"
                sequence="10"/>

        </menuitem>
    </menuitem>
</odoo>
