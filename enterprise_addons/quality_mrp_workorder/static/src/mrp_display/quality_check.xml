<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mrp_workorder.QualityCheck" t-inherit-mode="extension">
        <xpath expr="//button[@t-if='this.hasInstruction']" position="after">
            <button t-if="this.type === 'passfail' &amp;&amp; !this.isComplete" t-on-click.stop="this.failCheck" class="o_btn_icon btn"
                    t-att-barcode_trigger="this.isActive ? 'FAIL' : false"
                    t-attf-class="{{this.isActive ? 'btn-danger' : 'btn-outline-secondary'}}">
                <i class="oi" data-icon="close" role="img"/>
            </button>
        </xpath>
        <xpath expr="//span[@t-out='this.showQty']" position="attributes">
            <attribute name="t-att-class">this.passFailTypes.includes(this.type) ? (this.passed ? 'text-success' : 'text-danger') : ''</attribute>
        </xpath>
    </t>
</templates>
