<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form" model="ir.ui.view">
        <field name="name">project.task.view.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_subtasks']" position="before">
                <button
                    class="oe_stat_button"
                    name="action_get_project_forecast_by_user"
                    type="object"
                    icon="clear_all"
                    context="{'default_task_id': id, 'default_project_id': project_id}"
                    invisible="not scheduled_datetime or is_template or has_project_template"
                    groups="planning.group_planning_user"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Scheduled</span>
                        <span class="o_stat_value">
                            <field name="scheduled_datetime" nolabel="1"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
