<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.l10n_sa_hr_payroll_gosi</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="l10n_sa_hr_payroll.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block id="saudi_payroll_wps_settings" position="after">
                    <block title="GOSI Integration" id="saudi_payroll_gosi_settings" invisible="company_country_code != 'SA'">
                        <span class="text-700">
                            An integration with the National Organization for Social Insurance<br/>
                            to retrieve the contraption percentages for employees.
                        </span>
                        <setting>
                            <label for="l10n_sa_gosi_registration_number" string="Registration Number" class="col-lg-3"/>
                            <field name="l10n_sa_gosi_registration_number"/>
                        </setting>
                        <setting>
                            <label for="l10n_sa_gosi_api_key" class="col-lg-3" string="API Key"/>
                            <field name="l10n_sa_gosi_api_key" password="True"/>
                        </setting>
                        <setting>
                            <label for="l10n_sa_gosi_client_id" class="col-lg-3" string="Client ID"/>
                            <field name="l10n_sa_gosi_client_id" password="True"/>
                        </setting>
                        <setting>
                            <label for="l10n_sa_gosi_client_secret" class="col-lg-3" string="Client Secret"/>
                            <field name="l10n_sa_gosi_client_secret" password="True"/>
                        </setting>
                        <setting>
                            <label for="l10n_sa_gosi_dpop_private_key_value" class="col-lg-3" string="DPoP Key"/>
                            <field name="l10n_sa_gosi_dpop_private_key_value" class="overflow-auto" style="max-height: 200px;"/>
                        </setting>
                        <setting>
                            <label groups="base.group_no_one" for="l10n_sa_gosi_api_mode" class="col-lg-3" string="API Mode"/>
                            <field groups="base.group_no_one" name="l10n_sa_gosi_api_mode"/>
                        </setting>
                        <button name="action_l10n_sa_gosi_test_connection" invisible="not l10n_sa_gosi_api_is_available" type="object" class="btn btn-primary smaller mt-2 float-start w-25 ms-5">Test Connection</button>
                    </block>
                </block>
            </field>
        </record>
    </data>
</odoo>
