<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_view_form" model="ir.ui.view">
            <field name="name">hr.employee.view.form.inherit.l10n_sa_hr_payroll_gosi</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
            <field name="arch" type="xml">
                <field name="l10n_sa_employee_code" position="after">
                    <span colspan="2" invisible="not l10n_sa_gosi_last_request_failed" class="text-danger fw-bold">Oops, The entered Iqama number is not valid. Please make sure to provide a valid one.</span>
                </field>
            </field>
        </record>
    </data>
</odoo>
