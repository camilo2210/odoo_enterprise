<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_loan_line_list_view_inherited" model="ir.ui.view">
            <field name="name">account.loan.line.list.inherited</field>
            <field name="model">account.loan.line</field>
            <field name="inherit_id" ref="account_loans.account_loan_line_list_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='long_term_theoretical_balance']" position="after">
                    <field name="mid_term_theoretical_balance" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
