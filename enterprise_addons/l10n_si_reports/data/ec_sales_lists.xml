<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- display ec sales list report menu item -->
        <record model="ir.ui.menu" id="account_reports.menu_action_account_report_sales">
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- Add the report variant -->
    <record id="l10n_si_ec_sales_report" model="account.report">
        <field name="name">EC Sales List</field>
        <field name="country_id" ref="base.si"/>
        <field name="root_report_id" ref="account_reports.generic_ec_sales_report"/>
        <field name="groupby">partner_id</field>
        <field name="load_more_limit" eval="80"/>
        <field name="search_bar" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_si_ec_sales_report_handler"/>
        <field name="column_ids">
            <record id="account_financial_report_ec_sales_country" model="account.report.column">
                <field name="name">Country Code</field>
                <field name="expression_label">country_code</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_vat" model="account.report.column">
                <field name="name">VAT Number</field>
                <field name="expression_label">vat_number</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_total_amount_A3" model="account.report.column">
                <field name="name">Total Amount - A3</field>
                <field name="expression_label">goods</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_total_amount_A4" model="account.report.column">
                <field name="name">Total Amount - A4</field>
                <field name="expression_label">goods_42_63</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_total_amount_A5" model="account.report.column">
                <field name="name">Total Amount - A5</field>
                <field name="expression_label">triangular</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_total_amount_A6" model="account.report.column">
                <field name="name">Total Amount - A6</field>
                <field name="expression_label">services</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_financial_report_ec_sales_total_amount_A7" model="account.report.column">
                <field name="name">Total Amount - A7</field>
                <field name="expression_label">goods_stocks</field>
                <field name="sortable" eval="True"/>
            </record>
        </field>
        <field name="line_ids">
            <record id="si_ec_sales_report_line" model="account.report.line">
                <field name="name">EC Sales Report</field>
                <field name="code">SI_EC</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="si_ec_sales_report_line_country_code" model="account.report.expression">
                        <field name="label">country_code</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">country_code</field>
                    </record>
                    <record id="si_ec_sales_report_line_vat_number" model="account.report.expression">
                        <field name="label">vat_number</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">vat_number</field>
                    </record>
                    <record id="dk_ec_sales_report_line_goods" model="account.report.expression">
                        <field name="label">goods</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">goods</field>
                    </record>
                    <record id="si_ec_sales_report_line_goods_42_63" model="account.report.expression">
                        <field name="label">goods_42_63</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">goods_42_63</field>
                    </record>
                    <record id="si_ec_sales_report_line_triangular" model="account.report.expression">
                        <field name="label">triangular</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">triangular</field>
                    </record>
                    <record id="si_ec_sales_report_line_services" model="account.report.expression">
                        <field name="label">services</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">services</field>
                    </record>
                    <record id="si_ec_sales_report_line_goods_stocks" model="account.report.expression">
                        <field name="label">goods_stocks</field>
                        <field name="engine">custom</field>
                        <field name="auditable">True</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">goods_stocks</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
