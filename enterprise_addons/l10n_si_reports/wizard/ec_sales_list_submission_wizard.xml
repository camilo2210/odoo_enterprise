<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ec_sales_list_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_si_reports.ec.sales.list.submission.wizard.form</field>
            <field name="model">l10n_si_reports.ec.sales.list.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group id="instructions">
                            <ol colspan="2">
                                <li>
                                    <div class="d-inline-block align-top">
                                        <span>Download your EC Sales List (RP-O form).</span><br/>
                                        <button string='Download XML (RP-O)' name="print_rpo_return" type="object" class="btn-secondary"/>
                                    </div>
                                </li>
                                <li>Log in to the Slovenian tax portal: <a href="https://edavki.durs.si/" target="_blank">eDavki</a>.</li>
                                <li>Navigate to the section for submitting the Recapitulative Statement (Obrazec RP-O).</li>
                                <li>Upload the generated XML file.</li>
                                <li>Review the data and submit the report using your digital certificate.</li>
                            </ol>
                        </group>
                    </group>
                </field>
            </field>
        </record>
    </data>
</odoo>
