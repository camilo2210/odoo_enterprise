<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="planning_shift_ics_description_inherit" inherit_id="planning.planning_shift_ics_description">
        <xpath expr="//t[@name='name']" position="before">
            <xpath expr="//t[@name='role']" position="after">
                <t t-if="shift['partner']">
                    <t t-if="is_google_url"><b>Customer:</b></t>
                    <t t-else="">Customer:</t>
                    <t t-out="shift['partner']"/>
                </t>
                <t t-if="shift['partner_phone']">
                    <t t-if="is_google_url"><b>Phone:</b></t>
                    <t t-else="">Phone:</t>
                    <t t-out="shift['partner_phone']"/>
                </t>
            </xpath>
        </xpath>
    </template>
</odoo>
