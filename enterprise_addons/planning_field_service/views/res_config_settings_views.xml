<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.planning_field_service</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="planning.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@name='module_planning_field_service_worksheet']" position="after">
                <setting name="field_service_confirmation_email"
                    company_dependent="1"
                    help="Send a confirmation email to the customer when a shift is published">
                    <field name="field_service_confirmation_email"/>
                    <div class="mt16" invisible="not field_service_confirmation_email">
                        <label for="field_service_confirmation_mail_template_id" class="o_light_label mr8"/>
                        <field name="field_service_confirmation_mail_template_id" string="Email Template" required="field_service_confirmation_email" class="oe_inline" context="{'default_model': 'planning.slot'}"/>
                    </div>
                </setting>
            </xpath>
            <xpath expr="//field[@name='group_field_service_allow_customer_ratings']" position="after">
                <div class="mt16" invisible="not group_field_service_allow_customer_ratings">
                    <label for="rating_shift_request_mail_template_id" class="o_light_label mr8"/>
                    <field name="rating_shift_request_mail_template_id" string="Email Template" required="group_field_service_allow_customer_ratings" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
