#. module: planning_field_service
#: model:mail.template,body_html:planning_field_service.rating_shift_request_email_template
msgid ""
"<t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"            <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"            <t t-set=\"date_start\" t-"
"value=\"format_datetime(object.start_datetime, dt_format='MMM d', "
"tz=partner.tz, lang_code=partner.lang)\"/>\n"
"            <t t-set=\"date_end\" t-"
"value=\"format_datetime(object.end_datetime, dt_format='MMM d', "
"tz=partner.tz, lang_code=partner.lang)\"/>\n"
"            <div>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" "
"style=\"width:100%; margin:0;\">\n"
"                    <tbody>\n"
"                        <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                            Hello <t t-out=\"partner.name or ''\">Brandon "
"Freeman</t>,<br/><br/>\n"
"                            Please take a moment to rate your experience "
"with the field service intervention on <t t-out=\"date_end or date_start or "
"''\">Nov 25</t>.\n"
"                        </td></tr>\n"
"                        <tr><td style=\"text-align: center;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" "
"cellspacing=\"0\" style=\"width:100%; margin: 32px 0px 32px 0px; display: "
"inline-table;\">\n"
"                                <tr><td style=\"font-size: 14px; text-"
"align:center;\">\n"
"                                    <strong>How satisfied were you with the "
"intervention?</strong><br/>\n"
"                                    <span style=\"text-color: "
"#888888\">(click one of the smileys below to let us know)</span>\n"
"                                </td></tr>\n"
"                                <tr><td style=\"font-size: 14px;\">\n"
"                                    <table style=\"width:100%;text-"
"align:center;margin-top:2rem;\">\n"
"                                        <tr>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/5\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Happy\" "
"src=\"/rating/static/src/img/rating_5.png\" title=\"Happy\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/3\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Neutral\" "
"src=\"/rating/static/src/img/rating_3.png\" title=\"Neutral\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/1\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Unhappy\" "
"src=\"/rating/static/src/img/rating_1.png\" title=\"Unhappy\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td></tr>\n"
"                        <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                            We appreciate your feedback. It helps us "
"continuously improve.\n"
"                        </td></tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""
"<t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"            <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"            <t t-set=\"date_start\" t-"
"value=\"format_datetime(object.start_datetime, dt_format='MMM d', "
"tz=partner.tz, lang_code=partner.lang)\"/>\n"
"            <t t-set=\"date_end\" t-"
"value=\"format_datetime(object.end_datetime, dt_format='MMM d', "
"tz=partner.tz, lang_code=partner.lang)\"/>\n"
"            <div>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" "
"style=\"width:100%; margin:0;\">\n"
"                    <tbody>\n"
"                        <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                            <t t-out=\"partner.name or ''\">Brandon Freeman</"
"t>様<br/><br/>\n"
"                            いつもお世話になっております。<t t-"
"out=\"date_end or date_start or ''\">11月25日</t>のフィールドサービス作業(訪"
"問対応)について、弊社サービスの評価にご協力ください。\n"
"                        </td></tr>\n"
"                        <tr><td style=\"text-align: center;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" "
"cellspacing=\"0\" style=\"width:100%; margin: 32px 0px 32px 0px; display: "
"inline-table;\">\n"
"                                <tr><td style=\"font-size: 14px; text-"
"align:center;\">\n"
"                                    <strong>今回の対応にどの程度ご満足いただ"
"けましたか?</strong><br/>\n"
"                                    <span style=\"text-color: #888888\">(以下"
"のアイコンのいずれかをクリックしてください)</span>\n"
"                                </td></tr>\n"
"                                <tr><td style=\"font-size: 14px;\">\n"
"                                    <table style=\"width:100%;text-"
"align:center;margin-top:2rem;\">\n"
"                                        <tr>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/5\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Happy\" "
"src=\"/rating/static/src/img/rating_5.png\" title=\"満足\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/3\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Neutral\" "
"src=\"/rating/static/src/img/rating_3.png\" title=\"普通\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                            <td>\n"
"                                                <a t-attf-href=\"/rate/"
"{{ access_token }}/1\" t-att-class=\"'pe-none' if "
"object._rating_get_operator() else ''\">\n"
"                                                    <img alt=\"Unhappy\" "
"src=\"/rating/static/src/img/rating_1.png\" title=\"不満\"/>\n"
"                                                </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td></tr>\n"
"                        <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                            ご意見をお寄せいただきありがとうございます。継続"
"的な改善に役立ててまいりますので、何卒よろしくおねがいいたします。\n"
"                        </td></tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "

