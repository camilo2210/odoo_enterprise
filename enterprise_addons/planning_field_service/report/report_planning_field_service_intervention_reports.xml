<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="intervention_report" model="ir.actions.report">
            <field name="name">Field Service Report</field>
            <field name="model">planning.slot</field>
            <field name="group_ids" eval="[Command.link(ref('planning.group_field_service_allow_customer_report'))]"/>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">planning_field_service.worksheet_custom</field>
            <field name="print_report_name">object._get_report_base_filename()</field>
            <field name="binding_model_id" ref="planning.model_planning_slot"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
