<?xml version ="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="planning_field_service.LiveMapRenderer" t-inherit="web_map.MapRenderer">
        <xpath expr="//div[hasclass('o-map-renderer--container')]" position="before">
            <div t-if="this.debugMode.isActive() and this.isDemoDataActive.value" class="d-flex flex-column flex-grow-1 alert alert-info alert-dismissible bottom-0 text-center position-absolute o-map-renderer--alert mx-2 p-2">
                <b class="mb-1">
                    <i class="oi me-1" data-icon="bug_report"/>
                    <small>Debug</small>
                </b>
                <button type="button" class="btn btn-sm btn-add btn-success px-2 py-2 small" t-on-click="() => this.generateSampleData()">
                    Generate Sample Data
                </button>
            </div>
        </xpath>
    </t>

    <t t-name="planning_field_service.LiveMapRenderer.PinListContainer" t-inherit="web_map.MapRenderer.PinListContainer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o-map-renderer--pin-list-container')]" position="attributes">
            <attribute name="class" add="d-flex flex-column" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o-map-renderer--pin-list-search')]" position="after">
            <t t-if="!this.props.model.data.records.length">
                <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center px-3">
                    <span class="text-muted fw-bold">
                        <p>Track technicians’ locations and shifts in progress.</p>
                        <p>Privacy first: Location is recorded only after sign-in and with your permission.</p>
                    </span>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o-map-renderer--pin-list-group-header')]//button" position="before">
            <button class="btn p-1" t-att-data-tooltip="this.userLocationTooltip" t-if="renderer.isResourceLocated(groupId)" t-on-click.stop="() => renderer.focusOnUserPin(groupId)">
                <i class="oi oi-lg" data-icon="my_location"/>
            </button>
        </xpath>
    </t>

    <t t-name="planning_field_service.userMarkerPopup">
        <div class="d-flex align-items-stretch">
            <img t-attf-src="/web/image/resource.resource/#{this.id}/avatar_128"
                 class="rounded-start" style="margin: -1px;" height="100"
            />
            <div class="px-3 d-flex flex-column justify-content-center gap-1">
                <div class="mt-2 fs-5" style="font-weight: bold;">
                    <t t-out="this.display_name"/>
                </div>
                <div>
                    <t t-foreach="this.address" t-as="line" t-key="line_index">
                        <t t-out="line"/><br/>
                    </t>
                </div>
                <div class="text-muted mb-2">
                    <t t-out="this.relative_time"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="planning_field_service.userMarker">
        <div class="o_map_marker">
            <div class="o_map_marker_content">
                <img t-attf-src="/web/image/resource.resource/#{this.id}/avatar_128"
                     class="w-100 h-100 object-fit-cover rounded"
                     onerror="this.src='/web/static/img/placeholder.png'"
                />
            </div>
        </div>
    </t>

</templates>
