<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="planning_field_service.GanttRenderer.Pill" t-inherit="web_gantt.GanttRenderer.Pill">
        <xpath expr="//div[hasclass('o_gantt_pill_buffer_content')]" position="attributes">
            <attribute name="t-on-mouseover">(ev) => this.onBufferMouseEnter(ev, pill)</attribute>
            <attribute name="t-on-mouseout">this.onBufferMouseLeave</attribute>
        </xpath>
    </t>

    <t t-name="planning_field_service.PlanningGanttBufferPopover">
        <div class="o_gantt_buffer_popover p-3" style="min-width: 180px;">
            <div class="text-center border-bottom mb-2 pb-1">
                <strong>Travel time</strong>
            </div>
            <div class="d-flex justify-content-between gap-4 mb-1">
                <span class="text-muted">Depart at</span>
                <span class="fw-semibold" t-out="this.props.departTime"/>
            </div>
            <div class="d-flex justify-content-between gap-4 mb-1">
                <span class="text-muted">Duration</span>
                <span class="fw-semibold" t-out="this.props.travelTime"/>
            </div>
            <div class="d-flex justify-content-between gap-4">
                <span class="text-muted">Distance</span>
                <span class="fw-semibold" t-out="this.props.travelDistance"/>
            </div>
        </div>
    </t>

</templates>
