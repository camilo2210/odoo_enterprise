<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="planning.PlanningGanttView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_gantt_button_auto_plan')]" position="attributes">
            <attribute name="t-if" add="this.displayAutoPlanButton" separator=" and "/>
        </xpath>
        <xpath expr="//DropdownItem[@onSelected='this.autoPlan.bind(this)']" position="attributes">
            <attribute name="t-if">this.displayAutoPlanButton</attribute>
        </xpath>
    </t>

</templates>
