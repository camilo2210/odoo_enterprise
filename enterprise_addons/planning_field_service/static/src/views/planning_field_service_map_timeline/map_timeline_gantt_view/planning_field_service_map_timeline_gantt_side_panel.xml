<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="planning_field_service.MapTimelineGanttSidePanel.Panel" t-inherit="web.GanttSidePanel.Panel">
        <xpath expr="//h5" position="attributes">
            <attribute name="class">my-2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_event_to_schedule_draggable')]" position="attributes">
            <attribute name="t-on-mouseenter">() => this.onEventHover(event.id, true)</attribute>
            <attribute name="t-on-mouseleave">() => this.onEventHover(event.id, false)</attribute>
            <attribute name="t-att-class">{ o_map_timeline_side_panel_hover: this.highlightedRecordIds().has(event.id) }</attribute>
        </xpath>
    </t>

</templates>
