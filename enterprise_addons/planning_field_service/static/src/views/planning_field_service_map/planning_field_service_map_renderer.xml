<?xml version ="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="planning_field_service.routingPopup" t-inherit="web_map.routingPopup" t-inherit-mode="primary">
        <xpath expr="//span" position="before">
            <t t-if="resourceId">
                <t t-if="isResourceMaterial">
                    <div class="o_planning_resource_avatar me-2 d-inline-flex align-items-center justify-content-center flex-shrink-0"
                         t-attf-style="background-color: {{ resourceColor }};"
                    >
                        <i class="oi" data-icon="build"/>
                    </div>
                </t>
                <t t-else="">
                    <img t-attf-src="/web/image/resource.resource/#{resourceId}/avatar_128"
                         class="o_planning_resource_avatar me-2"
                         onerror="this.src='/web/static/img/placeholder.png'"
                    />
                </t>
            </t>
        </xpath>
    </t>

</templates>
