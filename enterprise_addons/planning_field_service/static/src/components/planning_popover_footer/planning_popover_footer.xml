<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="planning.PlanningPopoverFooterButtons.Common" t-inherit-mode="extension">
        <xpath expr="//button[@t-if='this.props.onUnschedule']" position="before">
            <button t-if="this.props.onNavigate" class="btn btn-sm btn-secondary" t-on-click="() => this.onFooterBtnClicked(this.props.onNavigate)">
                Navigate
            </button>
            <button t-if="this.props.onStart" class="btn btn-sm btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.props.onStart())">
                Start
            </button>
            <button t-if="this.props.onComplete" class="btn btn-sm btn-secondary" t-on-click="() => this.footer.onFooterBtnClicked(() => this.props.onComplete())">
                Complete
            </button>
        </xpath>
    </t>
</templates>
