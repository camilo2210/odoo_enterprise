<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_be_hr_payroll_account.onssPaymentWarning">
        <Dialog size="'md'" title.translate="ONSS Payment">
            <div class="o_form_view">
                <div class="d-flex justify-content-between w-50">
                    <label class="o_form_label">ONSS Cotisation</label><t t-out="this.OnssBalance + ' €'"/>
                </div>
                <div class="d-flex justify-content-between w-50">
                    <label class="o_form_label">Provisions Paid</label><t t-out="'- ' + this.paidAmount + ' €'"/>
                </div>
                <div class="d-flex justify-content-between w-50">
                    <label class="o_form_label">Balance to Pay</label><t t-out="'= ' + (this.OnssBalance - this.paidAmount).toFixed(2) + ' €'"/>
                </div>
                <br/>
                To pay on account <t t-out="this.OnssBankAccountNumber"/> of the NSSO, <br/>
                before the end of the month to avoid late fees and a 7% late interests.
                <br/><br/>
                <span class="text-muted">
                    Note: to register your NSSO provisions, create bills using the account 454000 ONSS.
                </span>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.actionMarkDone">Mark done</button>
                <button class="btn btn-secondary" t-on-click="this.actionInitiatePayment">Initiate Payment</button>
                <button class="btn btn-secondary" t-on-click="this.actionViewOnssBalance">ONSS Balance</button>
            </t>
        </Dialog>
    </t>
</templates>
