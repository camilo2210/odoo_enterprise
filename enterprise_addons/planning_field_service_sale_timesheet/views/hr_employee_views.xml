<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.planning_field_service_sale_timesheet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="planning.hr_employee_view_form_inherit"/>
        <field name="arch" type="xml">
            <field name="default_planning_role_id" position="after">
                <field name="timesheet_product_id"
                    placeholder="Default Service"
                    context="{
                        'default_type': 'service',
                        'default_service_policy': 'delivered_timesheet',
                        'form_view_ref': 'sale_project.product_product_form_view_inherit_sale_project',
                    }"
                />
            </field>
        </field>
    </record>
</odoo>
