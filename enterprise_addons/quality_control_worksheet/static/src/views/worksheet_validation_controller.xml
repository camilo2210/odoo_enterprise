<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="quality_control_worksheet.WorksheetValidationController" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-buttons']" position="replace">
            <t t-set-slot="control-panel-buttons">
                <t t-if="this.showValidateDiscardButton()">
                    <button type="button" class="btn btn-primary o_form_button_save" data-hotkey="s" t-on-click.stop="this.validate">
                        Validate
                    </button>
                </t>
                <t t-if="this.showPreviousButton()">
                    <button class="btn btn-secondary form_button_previous" t-on-click="this.previous">Previous</button>
                </t>
                <t t-if="this.showNextButton()">
                    <button class="btn btn-secondary form_button_next" t-on-click="this.next">Next</button>
                </t>
                <t t-if="this.showValidateDiscardButton()">
                    <button type="button" class="btn btn-secondary o_form_button_cancel" data-hotkey="j" t-on-click.stop="this.discard">
                        Discard
                    </button>
                </t>
            </t>
        </xpath>
    </t>
</templates>
