<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="timer.ToggleButton">
        <button type="button"
                t-on-click.stop.prevent="this.onClick"
                t-attf-class="px-3 py-1 border border-0 rounded-1 text-center {{this.buttonClass}}"
                t-att-title="this.title" t-att-aria-label="this.title">
            <i t-att-class="this.iconClass" t-att-data-icon="this.icon" t-att-title="this.title"/>
        </button>
    </t>

</templates>
