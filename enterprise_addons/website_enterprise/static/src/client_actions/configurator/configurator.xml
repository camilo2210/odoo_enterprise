<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="website_enterprise.Configurator.DescriptionScreen" t-inherit="website.Configurator.DescriptionScreen" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('container')]" position="inside">
        <div class="mb-4 text-muted o_configurator_show_fast" t-if="this.showWebsiteGeneratorButton">
            Or <a href="#" t-on-click="this.goToWebsiteGeneratorRequest">import your website</a>
        </div>
    </xpath>
</t>

</templates>
