<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="soda_import_wizard_view_form" model="ir.ui.view">
        <field name="name">soda.import.wizard.view.form</field>
        <field name="model">soda.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import">
                <notebook>
                    <page name="Account mapping">
                        <div class="alert alert-info" role="alert">
                            The accounts in the file will be mapped to the accounts listed below.
                            Any modification you make to these mappings will be saved as the default selection for all future imports.
                            Accounts that are not mapped, or whose mapping cannot be found, will automatically use the Suspense Account (499000).
                        </div>
                        <field name="soda_account_mapping_ids" string="Account Mapping" nolabel="1">
                            <list editable="bottom">
                                <field name="display_name" string="Account" readonly="1"/>
                                <field name="account_id" required="0"/>
                                <field name="company_id" column_invisible="True"/>
                                <button name="action_unlink" title="Delete" icon="delete" icon_class="oi-filled" type="object" invisible="parent.soda_files"/>
                            </list>
                        </field>
                    </page>
                    <page name="Analytic mapping" invisible="not soda_show_analytic">
                        <div class="alert alert-info" role="alert">
                            The department values in the file will be mapped to the following analytic accounts.
                            Any changes you make to these mappings will be saved as the default for subsequent imports.
                            If a department is not explicitly mapped, no analytic account will be assigned.
                        </div>
                        <field name="soda_analytic_mapping_ids" string="Analytic Mapping" nolabel="1">
                            <list editable="bottom">
                                <field name="department"/>
                                <field name="analytic_account_id"/>
                                <field name="company_id" column_invisible="True"/>
                                <button name="action_unlink" title="Delete" icon="delete" icon_class="oi-filled" type="object" invisible="parent.soda_files"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Save" type="object"
                        name="action_save_and_import" class="btn-primary"
                        data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
