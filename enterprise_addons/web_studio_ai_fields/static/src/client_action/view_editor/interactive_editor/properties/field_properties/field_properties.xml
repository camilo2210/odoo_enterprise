<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-inherit="web_studio.ViewEditor.InteractiveEditorProperties.Field" t-inherit-mode="extension">
        <xpath expr="//Property[contains(@name, 'help')]" position="after">
            <t t-if="this.aiSupported()">
                <div class="o_web_studio_property clearfix o_web_studio_sidebar_checkbox d-flex align-items-center" name="ai_field_parameters">
                    <CheckBox
                        id="'AI'"
                        name="'AI'"
                        value="this.hasAi()"
                        onChange="(value) => this.onChangeAi(value)"
                    >
                        <span><img src="/ai/static/description/icon.png" class="me-1" style="height: 1.5em;"/>Autofill</span>
                    </CheckBox>
                    <a t-if="this.hasAi()" t-on-click.prevent.stop="this.onSystemPromptClick" role="button" href="#" class="btn btn-link ms-auto o_web_studio_attrs">
                        <span t-if="this.hasPrompt()">Edit prompt</span>
                        <span t-else="">Set prompt</span>
                    </a>
                </div>
            </t>
        </xpath>
    </t>
</templates>
