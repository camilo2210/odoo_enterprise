<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_menu_obox" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.obox_pos_self_order_android</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_self_order.res_config_settings_view_form_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='self_ordering_section']/setting[1]" position="inside">
                <div class="content-group row mt-3" invisible="pos_self_ordering_mode != 'kiosk'">
                    <label for="pos_self_ordering_obox_id" class="col-lg-4 " string="Launch on Obox"/>
                    <field name="pos_self_ordering_obox_id" options="{'no_create': True}" placeholder="no Obox"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
