<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="frontdesk.Frontdesk">
        <div t-att-class="this.state.currentComponent.name === 'WelcomePage' ? '' : 'container-fluid p-0'" class="o_frontdesk_wrap d-flex">
            <WelcomePage t-if="this.state.currentComponent.name == 'WelcomePage'" t-props="this.frontdeskProps"/>
            <div t-elif="['VisitorForm', 'HostPage'].includes(this.state.currentComponent.name)" class="row g-0 flex-column flex-lg-row w-100">
                <div class="d-flex flex-column gap-4 p-3 p-md-4">
                    <Navbar t-props="this.navBarProps"/>
                    <t t-component="this.state.currentComponent" t-props="this.frontdeskProps"/>
                </div>
            </div>
            <div t-else="" class="row g-0 flex-column flex-lg-row w-100">
                <!-- Hide sidebar when empty or equal to "<p><br></p>" -->
                <div class="d-flex flex-column gap-5 justify-content-lg-center vh-100 p-3 p-md-4" t-att-class="this.station.description and !this.isHtmlEmpty(this.station.description) ? 'col col-lg-8' : ''">
                    <t t-component="this.state.currentComponent" t-props="this.frontdeskProps"/>
                </div>
                <div t-if="this.station.description and !this.isHtmlEmpty(this.station.description)" class="col-lg-4 position-relative flex-fill">
                    <div class="position-relative position-lg-absolute d-lg-flex justify-content-center align-items-center top-0 bottom-0 w-100 h-100 p-3 p-md-4 overflow-auto" t-att-class="this.station.theme === 'light' ? 'border bg-100' : 'bg-800'">
                        <div class="text-break" t-out="this.station.description"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
