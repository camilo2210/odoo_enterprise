<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="frontdesk.RegisterPage">
        <div class="text-center">
            <i class="oi oi-3x oi-filled d-block mb-3 text-success" data-icon="check_circle" role="presentation"/>
            <h1 class="display-6 mb-0">You have been registered!</h1>
            <div class="mt-2 text-break opacity-75" t-if="this.props.hostData">
                <t t-out="this.props.hostData.hostName"/>
                will get back to you.
            </div>
        </div>
        <div t-if="!this.props.isMobile" class="col-lg-6 d-grid mx-lg-auto">
            <button class="btn" t-att-class="this.props.theme === 'light' ? 'bg-200' : 'bg-700'" t-on-click="this.props.onClose">Close</button>
        </div>
    </t>
</templates>
