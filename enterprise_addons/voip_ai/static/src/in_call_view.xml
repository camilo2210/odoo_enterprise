<?xml version="1.0"?>
<templates>
    <t t-inherit="voip.InCallView-default" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-voip-InCallView-statusWrapper')]" position="inside">
            <t t-if="this.voip.transcriptionEnabled">
                <span class="o-voip-InCallStatus text-danger" title="This call will be transcribed when it's done">
                    <span class="smaller">Transcribing...</span>
                </span>
            </t>
        </xpath>
    </t>
</templates>
