msgid ""
"%(host_names)s must have a valid work phone with a country code to receive "
"visitor arrival notifications via WhatsApp."
msgstr ""
"%(host_names)s precisa ter um telefone comercial válido com código de país "
"para receber notificações de chegada de visitantes pelo WhatsApp."

