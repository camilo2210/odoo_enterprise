<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="frontdesk_frontdesk_view_list_inherit" model="ir.ui.view">
        <field name="name">frontdesk.frontdesk.view.list.inherit</field>
        <field name="model">frontdesk.frontdesk</field>
        <field name="inherit_id" ref="frontdesk.frontdesk_frontdesk_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notify_email']" position="after">
                <field name="notify_whatsapp" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="frontdesk_frontdesk_view_form" model="ir.ui.view">
        <field name="name">frontdesk.frontdesk.view.form.inherit</field>
        <field name="model">frontdesk.frontdesk</field>
        <field name="inherit_id" ref="frontdesk.frontdesk_frontdesk_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='host_notifications_setting']" position="inside">
                <div class="o_form_group mt16">
                    <div class="o_form_field o_inline">
                        <field name="notify_whatsapp"/>
                        <label for="notify_whatsapp">Notify by WhatsApp</label>
                        <field name="whatsapp_template_id" class="oe_inline" invisible="not notify_whatsapp" required="notify_whatsapp"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
