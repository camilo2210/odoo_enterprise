    <record id="l10n_lt_employees_salary_taxable_amount_disabled" model="hr.salary.rule">
        <field name="category_ids" eval="[(6, 0, [ref('l10n_lt_hr_payroll.hr_salary_rule_category_taxable_disabled')])]"/>
        <field name="name">Taxable Amount Disabled Deduction</field>
        <field name="code">TAXABLEAMOUNTDISABLED</field>
        <field name="sequence">107</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(version.l10n_lt_working_capacity)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = 0
if version.l10n_lt_working_capacity == '0_25':
    result = -payslip._rule_parameter('l10n_lt_tax_exempt_0_25')
elif version.l10n_lt_working_capacity == '30_55':
    result = -payslip._rule_parameter('l10n_lt_tax_exempt_30_55')
        </field>
        <field name="appears_on_payslip">never</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_lt_hr_payroll.hr_payroll_structure_lt_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.lt"/>
    </record>

    <record id="l10n_lt_employees_salary_taxable_amount" model="hr.salary.rule">
        <field name="category_ids" eval="[(6, 0, [ref('l10n_lt_hr_payroll.hr_salary_rule_category_taxable_amount')])]"/>
        <field name="name">Taxable Amount</field>
        <field name="code">TAXABLEAMOUNT</field>
        <field name="sequence">108</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
taxable_amount = categories['GROSS']
if not payslip.employee_id.is_non_resident:
    low = payslip._rule_parameter('l10n_lt_tax_exempt_low')
    high = payslip._rule_parameter('l10n_lt_tax_exempt_high')
    basic = payslip._rule_parameter('l10n_lt_tax_exempt_basic')
    rate = payslip._rule_parameter('l10n_lt_tax_exempt_rate')
if taxable_amount &lt;= low:
    taxable_amount -= basic
elif taxable_amount &lt;= high:
    taxable_amount -= basic - rate * (taxable_amount - low)

taxable_amount -= categories['TAXABLEDISABLED']

result = max(taxable_amount, 0)
        </field>
        <field name="appears_on_payslip">never</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_lt_hr_payroll.hr_payroll_structure_lt_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.lt"/>
    </record>

