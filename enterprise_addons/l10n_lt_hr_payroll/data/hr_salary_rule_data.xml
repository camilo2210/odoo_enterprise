        <field name="sequence">109</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = sum(payslip.worked_days_line_ids.filtered(lambda wd: wd.code == '013.00').mapped('amount'))
        </field>
        <field name="appears_on_payslip">never</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_lt_hr_payroll.hr_payroll_structure_lt_employee_salary'),
