<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="equity_portal_entry" model="portal.entry">
        <field name="name">Equity</field>
        <field name="description">See your shares and transactions</field>
        <field name="url">/my/equity</field>
        <field name="image" type="bytes" file="equity/static/src/img/equity.svg"/>
        <field name="placeholder_count">transaction_count</field>
        <field name="category">service_category</field>
        <field name="sequence" eval="70"/>
    </record>
</odoo>
