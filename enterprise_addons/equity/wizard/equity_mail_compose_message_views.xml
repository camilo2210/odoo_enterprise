<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="equity_mail_compose_message_form">
            <field name="name">equity.mail.compose.message.form</field>
            <field name="model">equity.mail.compose.message</field>
            <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="arch" type="xml">
                <form string="Compose Email" class="pt-0 pb-0 o_mail_composer_form" js_class="mail_composer_form" disable_autofocus="1">
                    <group>
                        <field name="res_ids" invisible="1"/> <!-- Needed for mail_composer_form -->
                        <field name="model" invisible="1"/> <!-- Needed for mail_composer_form -->
                        <field name="email_from"/>
                        <field name="partner_ids" widget="many2many_tags_email" required="True"/>
                        <field name="subject" placeholder="e.g. Welcome to MyCompany!" required="True"/>
                    </group>
                    <field name="equity_button"/>
                    <field name="body" widget="html_composer_message" class="oe-bordered-editor"
                    placeholder="Write your message here..." readonly="not can_edit_body" force_save="1"/>
                    <footer>
                        <button string="Send" name="action_send_mail" type="object" class="btn-primary o_mail_send" data-hotkey="q" invisible="not partner_ids_all_have_email"/>
                        <button class="btn-secondary w-auto" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo> 
