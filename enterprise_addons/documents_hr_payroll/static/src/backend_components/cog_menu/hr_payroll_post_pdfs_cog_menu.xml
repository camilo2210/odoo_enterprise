<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_payroll.PostPdfsCogMenu">
        <span t-if="this.generatedRecords()" t-on-mouseenter="this.highlightGeneratedRecords" t-on-mouseleave="this.unhighlightGeneratedRecords">
            <DropdownItem onSelected.bind="this.postPdfs">
                <i class="oi oi-fw oi-filled" data-icon="send"/> Post PDFs
            </DropdownItem>
        </span>
    </t>
</templates>
