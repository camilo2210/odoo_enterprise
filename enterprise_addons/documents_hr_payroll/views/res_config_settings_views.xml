<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.documents.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="documents_hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('documents_hr_group')]" position="after">
                <div class="row mt16">
                    <label class="o_form_label col-lg-3" for="documents_hr_payroll_group_id" string="Payroll Access Group"/>
                    <field name="documents_hr_payroll_group_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
