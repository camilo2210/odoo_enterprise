<?xml version="1.0"?>
<odoo>
    <record id="hr_payslip_send_mail_view_form" model="ir.ui.view">
        <field name="model">hr.payslip.send.mail</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="employee_ids" readonly="True" widget="many2many_tags_avatar"/>
                </group>
                <group>
                    <field name="custom_comment" class="oe-bordered-editor"
                        widget="html_mail"
                        placeholder="Write your custom message here..."
                        force_save="1"/>
                </group>
                <notebook>
                    <page string="Preview">
                        <field name="body_html" nolabel="1" class="oe-bordered-editor"
                        widget="html_mail" readonly="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_send" string="Send Payslips" type="object" class="btn-primary" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
