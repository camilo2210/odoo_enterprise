<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_ro_d300_submission_wizard_form" model="ir.ui.view">
            <field name="name">l10n_ro.d300.submission.wizard.form</field>
            <field name="model">l10n_ro.d300.submission.wizard</field>
            <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <field name="instructions" position="replace">
                    <group>
                        <group string="Declarant Data">
                            <field name="l10n_ro_declarant_name" required="True"/>
                            <field name="l10n_ro_declarant_surname" required="True"/>
                            <field name="l10n_ro_declarant_role" required="True"/>
                            <field name="l10n_ro_bank_name" required="True"/>
                            <field name="l10n_ro_bank_account" required="True"/>
                        </group>
                        <group string="Configuration">
                            <field name="l10n_ro_fiscal_address"/>
                            <field name="l10n_ro_caen_code" required="True"/>
                            <field name="l10n_ro_return_period"/>
                            <field name="l10n_ro_pro_rata"/>
                            <field name="l10n_ro_request_refund"/>
                        </group>
                    </group>
                    <group>
                        <group string="Exceptional Cases">
                            <field name="l10n_ro_filed_by_representative"/>
                            <field name="l10n_ro_simplified_internal"/>
                        </group>
                        <group string="Special Reverse Charge">
                            <field name="l10n_ro_sale_cereals"/>
                            <field name="l10n_ro_sale_mobile_phones"/>
                            <field name="l10n_ro_sale_integrated_circuits"/>
                            <field name="l10n_ro_sale_consoles_tablets_laptops"/>
                            <field name="l10n_ro_post_audit_filing"/>
                        </group>
                    </group>
                    <ol colspan="2">
                        <separator string="Submission Instructions"/>
                        <li>
                            <div class="d-inline-block align-top">
                                <span>Download D300 VAT declaration</span><br/>
                                <button string='Download XML' name="print_xml" type="object" class="btn-secondary"/>
                            </div>
                        </li>
                        <li>Download the <a href="https://static.anaf.ro/static/10/Anaf/Declaratii_R/300.html" target="_blank">last D300 PDF</a> and use "Import XML"</li>
                        <li>Login to <a href="https://www.e-guvernare.ro" target="_blank">e-guvernare portal</a></li>
                        <li>Upload the file in the section "Depunere declarații ANAF" (ANAF Declaration Submission)</li>
                    </ol>
                </field>
            </field>
        </record>
    </data>
</odoo>
