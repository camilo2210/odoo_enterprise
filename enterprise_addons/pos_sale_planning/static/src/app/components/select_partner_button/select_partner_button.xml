<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="attributes">
            <attribute name="t-att-disabled">this.pos.getOrder().hasResourcePayment or !this.pos.accessRight.disablePartner</attribute>
        </xpath>
    </t>
</templates>
