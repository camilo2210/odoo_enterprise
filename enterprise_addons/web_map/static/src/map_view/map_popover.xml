<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_map.MapPopover">
        <CardPopover t-props="this.cardPopoverProps">
            <t t-set-slot="footer">
                <t t-call="{{ this.constructor.defaultFooterButtonsTemplate }}"/>
            </t>
        </CardPopover>
    </t>

    <t t-name="web_map.MapPopover.DefaultFooterButtons" t-inherit="web.CardPopover.DefaultFooterButtons" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o_open_record_btn')]" position="after">
            <a t-if="this.props.url" class="btn btn-primary" role="button" t-att-href="this.props.url" target="_blank">
                Navigate to
            </a>
        </xpath>
    </t>

</templates>
