<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_th.tax_report" model="account.report">
        <field name="custom_handler_model_id" ref="model_l10n_th_tax_report_handler"/>
    </record>

    <record id="tax_report_pnd3" model="account.report">
        <field name="name">PND 3</field>
        <field name="name@th">ภ.ง.ด. 3</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="country_id" ref="base.th"/>
        <field name="availability_condition">country</field>
        <field name="custom_handler_model_id" ref="model_l10n_th_pnd3_report_handler"/>
        <field name="column_ids">
            <record id="tax_report_pnd3_column_balance" model="account.report.column">
                <field name="name">Tax ID</field>
                <field name="name@th">เลขประจำตัวผู้เสียภาษี</field>
                <field name="expression_label">tax_id</field>
                <field name="figure_type">string</field>
            </record>
            <record id="tax_report_pnd3_column_payment_date" model="account.report.column">
                <field name="name">Payment Date</field>
                <field name="name@th">วันที่</field>
                <field name="expression_label">payment_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="tax_report_pnd3_column_withholding_base" model="account.report.column">
                <field name="name">Withholding Base</field>
                <field name="name@th">จำนวนเงินที่จ่าย</field>
                <field name="expression_label">withholding_base</field>
            </record>
            <record id="tax_report_pnd3_column_tax_rate" model="account.report.column">
                <field name="name">Tax Rate</field>
                <field name="name@th">อัตราภาษี</field>
                <field name="expression_label">tax_rate</field>
                <field name="figure_type">float</field>
            </record>
            <record id="tax_report_pnd3_column_withholding_amount" model="account.report.column">
                <field name="name">Withholding Amount</field>
                <field name="name@th">ภาษีที่หัก</field>
                <field name="expression_label">withholding_amount</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="tax_report_pnd3_line" model="account.report.line">
                <field name="name">Withholding Tax</field>
                <field name="name@th">ภาษีหัก ณ ที่จ่าย</field>
                <field name="hierarchy_level">0</field>
                <field name="foldability">always_unfolded</field>
                <field name="groupby">move_id,l10n_th_income_tax_type</field>
                <field name="expression_ids">
                    <record id="tax_report_pnd3_tax_id" model="account.report.expression">
                        <field name="label">tax_id</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_pnd3</field>
                        <field name="subformula">tax_id</field>
                    </record>
                    <record id="tax_report_pnd3_payment_date" model="account.report.expression">
                        <field name="label">payment_date</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_pnd3</field>
                        <field name="subformula">payment_date</field>
                    </record>
                    <record id="tax_report_pnd3_withholding_base" model="account.report.expression">
                        <field name="label">withholding_base</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_pnd3</field>
                        <field name="subformula">withholding_base</field>
                    </record>
                    <record id="tax_report_pnd3_tax_rate" model="account.report.expression">
                        <field name="label">tax_rate</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_pnd3</field>
                        <field name="subformula">tax_rate</field>
                    </record>
                    <record id="tax_report_pnd3_withholding_amount" model="account.report.expression">
                        <field name="label">withholding_amount</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_pnd3</field>
                        <field name="subformula">withholding_amount</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

