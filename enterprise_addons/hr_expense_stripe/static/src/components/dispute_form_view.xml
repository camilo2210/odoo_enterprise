<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hr.expense.stripe.disputeFormView.buttons">
        <t t-if="!this.isSubmitted &amp;&amp; this.canEdit">
            <button class="btn btn-primary o_dispute_submit" t-on-click="this.submit" t-att-disabled="!this.canSubmit">
                Submit
            </button>
            <button class="btn btn-secondary" t-on-click="this.saveForLater">
                Save for later
            </button>
            <button class="btn btn-secondary" t-on-click="this.discard">
                Discard
            </button>
        </t>
        <t t-else="">
            <button class="btn btn-primary" t-on-click="this.discard">
                Close
            </button>
        </t>
    </t>
</templates>
