<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_check_wizard_inherit_obox" model="ir.ui.view">
        <field name="name">quality_check_wizard_inherit_obox</field>
        <field name="model">quality.check.wizard</field>
        <field name="inherit_id" ref="quality_control.view_quality_check_wizard"/>
        <field name="arch" type="xml">
            <field name="test_type" position="after">
                <field name="obox_device_identifier" invisible="1"/>
                <!-- `identifier` is used in obox{_picture,measure} widgets -->
                <field name="obox_ip" invisible="1"/>
                <!-- `obox_ip` is used in obox{_picture,measure} widgets -->
            </field>
            <xpath expr="//footer/button[@name='do_pass']" position="before">
                <widget name="obox_picture" btn_name="Take Picture" invisible="test_type != 'picture' or not obox_ip"/>
            </xpath>
            <xpath expr="//footer/button[@name='do_measure']" position="before">
                <widget name="obox_measure" btn_name="Get Measurement" invisible="test_type != 'measure' or not obox_ip"/>
            </xpath>
        </field>
    </record>
</odoo>
