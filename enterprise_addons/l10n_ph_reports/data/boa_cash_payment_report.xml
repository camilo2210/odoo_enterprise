<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boa_cash_receipt_report" model="account.report">
        <field name="name">Cash Receipts Journal</field>
        <field name="country_id" ref="base.ph"/>
        <!-- Fake variant, it's just for grouping under BoA -->
        <field name="root_report_id" ref="l10n_ph_reports.boa_general_journal_report"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_ph_boa_cash_receipt_report_handler"/>
        <field name="column_ids">
            <record id="boa_cash_receipt_report_date" model="account.report.column">
                <field name="name">Date</field>
                <field name="expression_label">date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="boa_cash_receipt_report_account_code" model="account.report.column">
                <field name="name">Account Code</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_account_name" model="account.report.column">
                <field name="name">Account Name</field>
                <field name="expression_label">account_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_partner" model="account.report.column">
                <field name="name">Partner</field>
                <field name="expression_label">partner_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_taxpayer_id" model="account.report.column">
                <field name="name">Taxpayer ID Number</field>
                <field name="expression_label">partner_vat</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_address" model="account.report.column">
                <field name="name">Address</field>
                <field name="expression_label">partner_address</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_ref" model="account.report.column">
                <field name="name">Reference</field>
                <field name="expression_label">reference</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_cash_receipt_report_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_cash_receipt_report_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>

