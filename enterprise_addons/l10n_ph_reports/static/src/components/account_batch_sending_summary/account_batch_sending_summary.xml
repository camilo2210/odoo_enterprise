<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="account.BatchSendingSummary" t-inherit-mode="extension">
        <xpath expr="//li" position="replace">
            <t t-if="Object.values(this.data).every((entry) => entry.noun)">
                <li t-foreach="this.data" t-as="summary_entry" t-key="summary_entry">
                    <t t-out="summary_entry_value.count"/> <t t-out="summary_entry_value.noun"/> <t t-out="summary_entry_value.label"/>
                    <t t-if="summary_entry_value.extra" t-out="summary_entry_value.extra"/>
                </li>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </t>

</templates>
