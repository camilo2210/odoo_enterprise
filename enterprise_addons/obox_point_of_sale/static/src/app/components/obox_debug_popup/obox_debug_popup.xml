<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="obox_point_of_sale.OboxDebugPopup">
        <Dialog title.translate="Obox debugging" footer="false" size="'md'" bodyClass="">
            <div t-out="this.response()" />
            <div class="alert alert-danger" t-if="!this.obox" role="alert">
                <strong>Obox not found!</strong> Please make sure Obox is properly configured and connected.
            </div>
            <div class="d-flex gap-2 py-3">
                <button class="btn btn-primary flex-grow-1" t-on-click="this.testPing" t-att-disabled="this.loading() or !this.obox">
                    Test Ping
                </button>
                <button class="btn btn-primary flex-grow-1" t-on-click="this.testPrint" t-att-disabled="this.loading() or !this.obox">
                    Test Print
                </button>
                <button class="btn btn-secondary btn-sm  w-25 pe-none">
                    <i class="oi" data-icon="schedule" aria-hidden="true" /> <t t-out="this.timing().toFixed(2)" />
                </button>
            </div>
        </Dialog>
    </t>
</templates>
