<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_urban_piper.DebugWidget" t-inherit="point_of_sale.DebugWidget" t-inherit-mode="extension">
        <xpath expr="//div[@data-tooltip='Export PoS data']" position="before">
            <div data-tooltip="Obox Debug" data-tooltip-delay="0">
                <button class="btn btn-secondary btn-sm text-nowrap" t-on-click="this.openOboxDebugPopup">
                    <i class="oi" data-icon="bug_report" aria-hidden="true" /> Obox Debug
                </button>
            </div>
        </xpath>
    </t>
</templates>
