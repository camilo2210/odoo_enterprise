<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="obox_queue_view_list_inherit" model="ir.ui.view">
        <field name="name">obox.queue.list.inherit</field>
        <field name="model">obox.queue</field>
        <field name="inherit_id" ref="obox.obox_queue_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='action_type']" position="after">
                <field name="pos_order_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="obox_queue_view_form_inherit" model="ir.ui.view">
        <field name="name">obox.queue.form.inherit</field>
        <field name="model">obox.queue</field>
        <field name="inherit_id" ref="obox.obox_queue_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payload_length']" position="after">
                <field name="pos_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
