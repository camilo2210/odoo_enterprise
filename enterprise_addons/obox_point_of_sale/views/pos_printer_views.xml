<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_obox_pos_printer_form" model="ir.ui.view">
        <field name="name">obox.pos.printer.form.view</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <field name="printer_type" position="after">
                <field name="obox_device_id" invisible="printer_type != 'obox'" placeholder="None" required="printer_type == 'obox'" options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
            <field name="printer_type" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="use_lna" position="attributes">
                <attribute name="invisible" add="printer_type == 'obox'" separator=" or "/>
            </field>
        </field>
    </record>
    <record id="view_obox_pos_printer_list" model="ir.ui.view">
        <field name="name">obox.pos.printer.list.view</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer"/>
        <field name="arch" type="xml">
            <field name="use_type" position="after">
                <field name="obox_device_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
        </field>
    </record>
</odoo>
