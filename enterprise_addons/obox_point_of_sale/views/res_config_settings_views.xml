<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_view_form_inherit_obox_pos" model="ir.ui.view">
        <field name="name">res.config.form.inherit.obox.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='customer_display']" position="after">
                <setting string="Obox" help="Connect devices using an Obox">
                    <div class="content-group">
                        <div class="row" name="row_scale">
                            <label string="Electronic Scale" for="pos_obox_scale_id" class="col-lg-5 o_light_label"/>
                            <field name="pos_obox_scale_id" placeholder="none"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
