<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.account.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="product_accounts" position="after">
                <setting id="sale_accrual_accounts" string="Sale Accruals:"
                         title="Accounts used by the inventory valuation report to accrue the value of goods delivered but not invoiced yet, or invoiced but not delivered yet.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="account_invoices_to_issue_id" class="col-lg-5 o_light_label" string="Invoices to be Issued"/>
                            <field name="account_invoices_to_issue_id" decoration-muted="not account_invoices_to_issue_active"/>
                        </div>
                        <div class="row mt8">
                            <label for="account_invoiced_not_delivered_id" class="col-lg-5 o_light_label" string="Invoiced Not Delivered"/>
                            <field name="account_invoiced_not_delivered_id" decoration-muted="not account_invoiced_not_delivered_active"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
