<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.account.accountant</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_accrual_moves" type="object"
                        class="oe_stat_button" icon="book"
                        invisible="not accrual_move_count"
                        groups="base.group_no_one">
                    <field name="accrual_move_count" widget="statinfo" string="Accrual Entries"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
