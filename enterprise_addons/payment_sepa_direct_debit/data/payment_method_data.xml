<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_sepa_direct_debit" model="payment.method">
        <field name="name">SEPA Direct Debit</field>
        <field name="code">sepa_direct_debit</field>
        <field name="provider_id" ref="payment.payment_provider_sepa_direct_debit"/>
        <field name="image" type="bytes" file="payment/static/img/sepa.png"/>
        <field name="support_tokenization">True</field>
        <field
            name="supported_country_ids"
            eval="[Command.set([
                        ref('base.at'),
                        ref('base.be'),
                        ref('base.bg'),
                        ref('base.ch'),
                        ref('base.cy'),
                        ref('base.cz'),
                        ref('base.de'),
                        ref('base.ee'),
                        ref('base.es'),
                        ref('base.fi'),
                        ref('base.fr'),
                        ref('base.gr'),
                        ref('base.hr'),
                        ref('base.hu'),
                        ref('base.ie'),
                        ref('base.is'),
                        ref('base.it'),
                        ref('base.lt'),
                        ref('base.lu'),
                        ref('base.lv'),
                        ref('base.mt'),
                        ref('base.nl'),
                        ref('base.no'),
                        ref('base.pt'),
                        ref('base.ro'),
                        ref('base.se'),
                        ref('base.si'),
                        ref('base.sk'),
                        ref('base.uk'),
                ])]"
        />
        <field name="supported_currency_ids" eval="[Command.set([ref('base.EUR')])]"/>
    </record>

</odoo>
