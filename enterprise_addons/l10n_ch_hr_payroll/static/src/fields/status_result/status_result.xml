<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_ch_hr_payroll.StatusResultWidgetTemplate">
        <div class="o_swissdec_widget">
            <t t-set="response_state" t-value="this.responseState"/>
            <t t-if="response_state">
                <SwissdecNotification t-if="response_state.Warning" type="'warning'" notifications="response_state.Warning.Notification"/>
                <SwissdecNotification t-if="response_state.Info" type="'info'" notifications="response_state.Info.Notification"/>
            </t>
            <t t-elif="this.errorResponse">
                <t t-call="l10n_ch_hr_payroll.SwissdecError" swissdec_error="this.errorResponse"/>
            </t>
        </div>
    </t>
</templates>
