<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_ch_hr_payroll.SwissdecNotification">
        <t t-set="swissdec_notifications" t-value="this.notifications"/>
        <div t-if="swissdec_notifications.length" class="alert o_swissdec_alert" t-att-class="this.alert.className" role="alert">
            <i class="oi oi-fw" t-att-class="this.alert.iconClass" t-att-data-icon="this.alert.icon" aria-hidden="true"/>
            <div class="o_swissdec_alert_content">
                <div class="fw-bold">
                    <t t-if="this.props.type === 'error'">Errors</t>
                    <t t-elif="this.props.type === 'warning'">Warnings</t>
                    <t t-else="">Information</t>
                </div>
                <ul class="list-unstyled mb-0">
                    <li t-foreach="swissdec_notifications" t-as="notification" t-key="notification_index" class="mt-1">
                        <div class="text-break text-prewrap" t-out="notification.description"/>
                        <div class="small opacity-75">
                            <span t-if="notification.code" class="me-3">Code: <t t-out="notification.code"/></span>
                            <span t-if="notification.qualityLevel">Quality Level: <t t-out="notification.qualityLevel"/></span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </t>
</templates>
