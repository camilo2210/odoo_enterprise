            <field name="name">Employees Without Residence Municipality</field>
            <field name="country_id" ref="base.ch"/>
            <field name="evaluation_code">
employees = self.env['hr.employee'].search([
    ('l10n_ch_canton', '!=', 'EX'),
    ('company_id', 'in', self.env.companies.ids),
])

employees_without_valid_municipality = employees.filtered(
    lambda e: not e.l10n_ch_municipality
    or not e.l10n_ch_municipality.isdigit()
)

if employees_without_valid_municipality:
    warning_records = employees_without_valid_municipality
            </field>
