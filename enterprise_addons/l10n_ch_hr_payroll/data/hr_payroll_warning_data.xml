        <record id="hr_payroll_warning_monthly_snapshot_warning" model="hr.payroll.warning">
            <field name="name">Monthly Snapshot Warning</field>
            <field name="description">Warnings related to monthly snapshot validation errors.</field>
            <field name="country_id" ref="base.ch"/>
            <field name="warning_color_class">warning</field>
            <field name="display_on_dashboard" eval="False"/>
            <field name="display_on_model" eval="True"/>
            <field name="model_id" ref="l10n_ch_hr_payroll.model_hr_payslip"/>
            <field name="warning_type">python</field>
            <field name="evaluation_code">
ch_companies = self.env.companies.filtered(lambda c: c.country_id.code == 'CH')
payslips = self.env['hr.payslip'].search([
    ('id', 'in', active_ids),
    ('company_id', 'in', ch_companies.ids),
    ('l10n_ch_monthly_snapshot', '!=', False),
])
warning_records = self.env['hr.payslip']
warning_details = defaultdict(list)
for payslip in payslips:
    warnings = payslip.l10n_ch_monthly_snapshot.validation_errors
    if not warnings:
        continue
    warning_records |= payslip
    for warning in warnings.values():
        warning_details[payslip].append({**warning, 'level': 'warning'})
            </field>
