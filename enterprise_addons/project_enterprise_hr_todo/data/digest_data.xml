<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="digest_tip_project_todo_1" model="digest.tip">
            <field name="name">Tip: Create to-dos by email</field>
            <field name="sequence">1000</field>
            <field name="group_id" ref="base.group_user"/>
            <field name="tip_description" type="html">
                <div>
                    <t t-set="alias_domain" t-value="object.env.company.alias_domain_id"/>
                    <p class="tip_title"><b>Tip: Create to-dos by email</b></p>
                    <t t-if="alias_domain">
                        <t t-set="alias_email" t-value="'to-do@%s' % alias_domain.name"/>
                        <p class="tip_content">Send an email to <a t-attf-href="mailto:{{alias_email}}"><t t-out="alias_email"/></a> to create a to-do for yourself.
                        Want to include others? Add their email addresses to the <b>To</b> field — they'll be added as assignees.</p>
                    </t>
                    <t t-else="">
                        <p class="tip_content">Send an email to your To-Do alias to create a to-do for yourself.
                        Want to include others? Add their email addresses to the <b>To</b> field — they'll be added as assignees.</p>
                    </t>
                    <img src="https://download.odoocdn.com/digests/project_todo/static/src/img/create_to_dos_email.png" width="540" class="illustration_border"/>
                </div>
            </field>
        </record>
    </data>
</odoo>
