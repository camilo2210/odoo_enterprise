<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vat_eu_report" model="account.report">
        <field name="name">EC Sales and Purchase List (VAT-UE)</field>
        <field name="country_id" ref="base.pl"/>
        <field name="root_report_id" ref="account_reports.generic_ec_sales_report"/>
        <field name="custom_handler_model_id" ref="model_l10n_pl_vat_eu_report_handler"/>
        <field name="column_ids">
            <record id="vat_eu_country" model="account.report.column">
                <field name="name">Country Code</field>
                <field name="expression_label">country_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_eu_vat_number" model="account.report.column">
                <field name="name">VAT Number</field>
                <field name="expression_label">vat_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vat_eu_goods" model="account.report.column">
                <field name="name">Supplies of Goods</field>
                <field name="expression_label">goods</field>
            </record>
            <record id="vat_eu_triangular_sales" model="account.report.column">
                <field name="name">Triangular Supplies</field>
                <field name="expression_label">triangular</field>
            </record>
            <record id="vat_eu_services" model="account.report.column">
                <field name="name">Supplies of Services</field>
                <field name="expression_label">services</field>
            </record>
            <record id="vat_eu_acquisitions" model="account.report.column">
                <field name="name">Acquisitions of Goods</field>
                <field name="expression_label">acquisitions</field>
            </record>
            <record id="vat_eu_triangular_acquisitions" model="account.report.column">
                <field name="name">Triangular Acquisitions</field>
                <field name="expression_label">triangular_acquisitions</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="vat_eu_report_line" model="account.report.line">
                <field name="name">EC Sales and Purchase List</field>
                <field name="code">PL_VAT_UE</field>
                <field name="groupby">partner_id</field>
                <field name="foldability">always_unfolded</field>
                <field name="expression_ids">
                    <record id="vat_eu_report_line_country_code" model="account.report.expression">
                        <field name="label">country_code</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">country_code</field>
                    </record>
                    <record id="vat_eu_report_line_vat_number" model="account.report.expression">
                        <field name="label">vat_number</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">vat_number</field>
                    </record>
                    <record id="vat_eu_report_line_goods" model="account.report.expression">
                        <field name="label">goods</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">goods</field>
                    </record>
                    <record id="vat_eu_report_line_triangular" model="account.report.expression">
                        <field name="label">triangular</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">triangular</field>
                    </record>
                    <record id="vat_eu_report_line_services" model="account.report.expression">
                        <field name="label">services</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">services</field>
                    </record>
                    <record id="vat_eu_report_line_acquisitions" model="account.report.expression">
                        <field name="label">acquisitions</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">acquisitions</field>
                    </record>
                    <record id="vat_eu_report_line_triangular_acquisitions" model="account.report.expression">
                        <field name="label">triangular_acquisitions</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_engine_ec_sales_report</field>
                        <field name="subformula">triangular_acquisitions</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
