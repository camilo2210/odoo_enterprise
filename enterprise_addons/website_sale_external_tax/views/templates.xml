<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="order_tax_lines" inherit_id="website_sale.order_tax_lines">
        <tr name="o_order_total_taxes" position="attributes">
            <attribute name="t-att-style">'display: none;' if not on_payment_step and website_sale_order.is_tax_computed_externally else ''</attribute>
        </tr>
    </template>
    <template id="total" inherit_id="website_sale.total">
        <tr name="o_order_total" position="attributes">
            <attribute name="t-att-style">'display: none;' if not on_payment_step and website_sale_order.is_tax_computed_externally else ''</attribute>
        </tr>
        <tr name="o_order_total_untaxed" position="attributes">
            <attribute
                name="t-if"
                add="(not on_payment_step and website_sale_order.is_tax_computed_externally)"
                separator="or"
            />
        </tr>
    </template>
</odoo>
