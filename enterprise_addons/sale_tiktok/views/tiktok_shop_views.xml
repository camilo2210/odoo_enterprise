<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_tiktok_shop_list" model="ir.actions.act_window">
        <field name="name">TikTok Shops</field>
        <field name="res_model">tiktok.shop</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tiktok_shop_list" model="ir.ui.view">
        <field name="name">tiktok.shop.list</field>
        <field name="model">tiktok.shop</field>
        <field name="arch" type="xml">
            <list string="TikTok Shops" create="false">
                <header>
                    <button
                        name="%(action_tiktok_shop_create_wizard)d"
                        string="Connect New Shop"
                        type="action"
                        class="btn-primary"
                        display="always"
                    />
                </header>
                <field name="name"/>
                <field name="tiktok_shop_ref" groups="base.group_no_one"/>
                <field name="country_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_orders_sync_date"/>
            </list>
        </field>
    </record>

    <record id="tiktok_shop_form" model="ir.ui.view">
        <field name="name">tiktok.shop.form</field>
        <field name="model">tiktok.shop</field>
        <field name="arch" type="xml">
            <form string="TikTok Shop" create="false">
                <div
                    class="alert alert-danger text-center mt-3"
                    role="alert"
                    invisible="not context.get('tiktok_shop_authorization_error')"
                >
                    <strong>Authorization Failed: </strong>
                    An unexpected error occurred during authorization. Please try again.
                </div>
                <header>
                    <button
                        name="action_open_auth_link"
                        string="Re-authorize Shop"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_sync_orders"
                        string="Sync Orders"
                        type="object"
                        class="btn-secondary"
                        invisible="not active or not access_token"
                    />
                    <button
                        name="action_sync_inventory"
                        string="Sync Inventory"
                        type="object"
                        class="btn-secondary"
                        groups="base.group_no_one"
                        invisible="not active or not synchronize_inventory or not access_token"
                    />
                    <button
                        name="action_sync_product_catalog"
                        string="Sync Catalog"
                        type="object"
                        class="btn-secondary"
                        invisible="not active or not access_token"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="attach_money"
                            invisible="not id"
                        >
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button
                            name="action_view_tiktok_items"
                            type="object"
                            class="oe_stat_button"
                            icon="deployed_code"
                            invisible="not id"
                        >
                            <field name="tiktok_item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>
                    <div class="oe_title" id="title">
                        <label for="name" string="Shop Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Indonesian Shop"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shop Information">
                            <field name="tiktok_shop_ref"/>
                            <field name="company_id"/>
                            <field name="country_id" options="{'no_open': True}"/>
                        </group>
                        <group string="Synchronization Information">
                            <field name="last_orders_sync_date"/>
                            <field name="last_product_catalog_sync_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shop Settings">
                            <group>
                                <group string="Order Synchronization">
                                    <field name="user_id"/>
                                    <field name="team_id"/>
                                </group>
                                <group string="Inventory Synchronization">
                                    <field name="synchronize_inventory"/>
                                    <field name="fbs_warehouse_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Credentials" groups="base.group_no_one">
                            <group>
                                <group string="App Credentials">
                                    <field name="app_key" readonly="True"/>
                                    <field name="app_secret" readonly="True" password="True"/>
                                    <field name="service_extern_id" readonly="True"/>
                                </group>
                                <group string="Shop Tokens">
                                    <field name="access_token"/>
                                    <field name="access_token_expire_datetime"/>
                                    <field name="refresh_token"/>
                                    <field name="refresh_token_expire_datetime"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tiktok_shop_search" model="ir.ui.view">
        <field name="name">tiktok.shop.search</field>
        <field name="model">tiktok.shop</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Shop"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_tiktok_shop_authorization_error" model="ir.actions.act_window">
        <field name="name">TikTok Shop Authorization Error</field>
        <field name="res_model">tiktok.shop</field>
        <field name="view_mode">form</field>
        <field name="context">{'tiktok_shop_authorization_error': True}</field>
    </record>

</odoo>
