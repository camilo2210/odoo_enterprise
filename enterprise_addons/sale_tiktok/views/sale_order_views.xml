<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_order_list" model="ir.ui.view">
        <field name="name">tiktok.shop.order.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="tiktok_order_ref" optional="hide"/>
                <field name="tiktok_shop_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">tiktok.shop.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-warning text-center"
                    role="alert"
                    invisible="not tiktok_order_ref or tiktok_delivery_status != 'manual'"
                >
                    This order contains unsupported TikTok Shop delivery status.
                    Please process the order manually on TikTok Shop.
                </div>
            </sheet>
            <t groups="sale.group_auto_done_setting" position="after">
                <t groups="!sale.group_auto_done_setting">
                    <button
                        name="action_lock"
                        type="object"
                        string="Lock"
                        help="If the sale is locked, you can not modify it anymore. However, you will still be able to invoice or deliver."
                        invisible="locked or state != 'sale' or not tiktok_order_ref"
                        groups="sales_team.group_sale_manager"
                    />
                </t>
            </t>
            <group name="order_details" position="inside">
                <field name="tiktok_order_ref" invisible="not tiktok_order_ref"/>
                <field name="tiktok_shop_id" invisible="not tiktok_shop_id"/>
            </group>
        </field>
    </record>

    <record id="sale_order_search" model="ir.ui.view">
        <field name="name">tiktok.order.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="tiktok_order_ref"/>
                <group>
                    <filter
                        string="TikTok Shop"
                        name="group_by_tiktok_shop_id"
                        context="{'group_by': 'tiktok_shop_id'}"
                    />
                </group>
            </field>
        </field>
    </record>

</odoo>
