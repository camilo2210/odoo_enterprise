<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tiktok_picking_ship_wizard_form" model="ir.ui.view">
        <field name="name">tiktok.picking.ship.wizard.form</field>
        <field name="model">tiktok.picking.ship.wizard</field>
        <field name="arch" type="xml">
            <form string="Ship TikTok Orders">
                <div class="alert alert-info" role="alert">
                    The collection period is optional. Leave empty to follow courier pickup schedule.
                </div>
                <group>
                    <field
                        name="pickup_start"
                        string="Collection Period"
                        widget="daterange"
                        options="{'end_date_field': 'pickup_end', 'always_range': '1'}"/>
                </group>
                <footer>
                    <button string="Ship Order" name="action_ship_order" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
