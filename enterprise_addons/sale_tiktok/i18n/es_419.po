#. module: sale_tiktok
#: model:ir.module.module,description:base.module_sale_tiktok
msgid ""
"\n"
"Import your TikTok Shop orders in Odoo and synchronize deliveries\n"
"=================================================================\n"
"\n"
"Key Features\n"
"------------\n"
"* Import orders from multiple shops\n"
"* Orders are matched with Odoo products based on their internal reference\n"
"  (SKU in TikTok Shop)\n"
"* Support for Fulfillment by Seller (FBS)\n"
msgstr ""

#. module: sale_tiktok
#. odoo-python
#: code:addons/sale_tiktok/wizard/tiktok_shop_create_wizard.py:0
msgid "(Pending Authorization)"
msgstr "(Autorización pendiente)"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.order_sync_failure
msgid ""
"<div>\n"
"                <p>\n"
"                    The synchronization of the TikTok Shop order with "
"reference\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    encountered an error and was not completed.\n"
"                </p>\n"
"                <p>\n"
"                    Unless the order is canceled in TikTok Shop, no other "
"synchronization will be attempted.\n"
"                </p>\n"
"                <p>\n"
"                    To schedule a new synchronization attempt, proceed as "
"follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the TikTok Shop on which the "
"order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>\n"
"                            Set a date for <em>Last Order Synchronization "
"Date</em> that is before the last status update of the order.\n"
"                        </li>\n"
"                        <li>Save the changes and click on the <em>SYNC "
"ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    If the problem persists, contact\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</"
"a>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    La sincronización de la orden de TikTok Shop con la "
"referencia\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    tiene un error y no fue posible completarla.\n"
"                </p>\n"
"                <p>\n"
"                    A menos que canceles la orden en TikTok Shop, el sistema "
"no intentará sincronizarla de nuevo.\n"
"                </p>\n"
"                <p>\n"
"                    Para programar un nuevo intento de sincronización, sigue "
"estos pasos:\n"
"                    </p><ol>\n"
"                        <li>Ve a las herramientas para desarrolladores.</li>"
"\n"
"                        <li>Abre el formulario de la tienda de TikTok Shop "
"donde se realizó la orden.</li>\n"
"                        <li>Ve a la pestaña de Seguimiento de órdenes.</li>\n"
"                        <li>\n"
"                            Define una fecha en <em>Fecha de la última "
"sincronización de órdenes</em> anterior a la última actualización de estado "
"de la orden.\n"
"                        </li>\n"
"                        <li>Guarda los cambios y haz clic en el botón <em>"
"SINCRONIZAR ÓRDENES</em>.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    Si el problema continúa, contacta al\n"
"                    <a href=\"https://www.odoo.com/help/\">equipo de soporte "
"de Odoo</a>.\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_form
msgid ""
"<strong>Authorization Failed: </strong>\n"
"                    An unexpected error occurred during authorization. "
"Please try again."
msgstr ""
"<strong>Error de autorización:</strong>\n"
"                Ocurrió un error inesperado durante la autorización. "
"Inténtalo de nuevo."

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or "
"use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/"
">\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>Dónde encontrar tus credenciales API:</strong><br/>\n"
"                1. Ve al TikTok Shop Partner Center.<br/>\n"
"                2. Ve a Aplicaciones &amp; Servicio → Crear nueva aplicación "
"o usa una aplicación existente.<br/>\n"
"                3. Otorga a la aplicación permisos para acceder a los datos "
"de tu tienda.<br/>\n"
"                4. Obtén tu ID de servicio, clave de aplicación y secreto de "
"aplicación.<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the "
"synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/"
"\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    La sincronización del inventario de TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    tuvo algunos errores y no fue posible realizarla.\n"
"                </p>\n"
"                <p>Estos son los errores que envió TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Referencia interna del producto</th>\n"
"                            <th>Mensaje</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    Ocurrió un error desconocido durante la "
"sincronización con TikTok Shop.\n"
"                                    Revisa de forma manual si la cantidad "
"disponible del producto es correcta.\n"
"                                    Si el problema continúa, contacta al\n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"equipo de soporte de Odoo</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

