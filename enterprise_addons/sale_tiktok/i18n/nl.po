#. module: sale_tiktok
#: model:ir.module.module,description:base.module_sale_tiktok
msgid ""
"\n"
"Import your TikTok Shop orders in Odoo and synchronize deliveries\n"
"=================================================================\n"
"\n"
"Key Features\n"
"------------\n"
"* Import orders from multiple shops\n"
"* Orders are matched with Odoo products based on their internal reference\n"
"  (SKU in TikTok Shop)\n"
"* Support for Fulfillment by Seller (FBS)\n"
msgstr ""

#. module: sale_tiktok
#. odoo-python
#: code:addons/sale_tiktok/wizard/tiktok_shop_create_wizard.py:0
msgid "(Pending Authorization)"
msgstr "(In afwachting van autorisatie)"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.order_sync_failure
msgid ""
"<div>\n"
"                <p>\n"
"                    The synchronization of the TikTok Shop order with "
"reference\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    encountered an error and was not completed.\n"
"                </p>\n"
"                <p>\n"
"                    Unless the order is canceled in TikTok Shop, no other "
"synchronization will be attempted.\n"
"                </p>\n"
"                <p>\n"
"                    To schedule a new synchronization attempt, proceed as "
"follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the TikTok Shop on which the "
"order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>\n"
"                            Set a date for <em>Last Order Synchronization "
"Date</em> that is before the last status update of the order.\n"
"                        </li>\n"
"                        <li>Save the changes and click on the <em>SYNC "
"ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    If the problem persists, contact\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</"
"a>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    De synchronisatie van de TikTok Shop-bestelling met "
"referentie\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    heeft een fout opgeleverd en is niet voltooid.\n"
"                </p>\n"
"                <p>\n"
"                    Tenzij de bestelling in TikTok Shop wordt geannuleerd, "
"wordt er geen nieuwe synchronisatiepoging ondernomen.\n"
"                </p>\n"
"                <p>\n"
"                    Ga als volgt te werk om een nieuwe synchronisatiepoging "
"te ondernemen:\n"
"                    </p><ol>\n"
"                        <li>Ga naar de Ontwikkelaarstools.</li>\n"
"                        <li>Open het formulier van de TikTok Shop waarop de "
"bestelling is geplaatst.</li>\n"
"                        <li>Ga naar het tabblad Orderopvolging.</li>\n"
"                        <li>\n"
"                            Stel een datum in bij <em>Laatste datum "
"ordersynchronisatie</em> die vroeger is dan de laaste statuswijziging van de "
"bestelling.\n"
"                        </li>\n"
"                        <li>Sla de wijzigingen op en klik op de knop <em>"
"Orders synchroniseren</em>.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    Als het probleem zicht blijft voordoen, neem dan contact "
"op met\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</a>"
".\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_form
msgid ""
"<strong>Authorization Failed: </strong>\n"
"                    An unexpected error occurred during authorization. "
"Please try again."
msgstr ""
"<strong>Autorisatie mislukt: </strong>\n"
"Er is een onverwachte fout opgetreden tijdens de autorisatie. Probeer het "
"opnieuw."

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or "
"use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/"
">\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>Zo vind je je API-inloggegevens:</strong><br/>\n"
"                    1. Ga naar het TikTok Shop Partner Center<br/>\n"
"                    2. Ga naar Apps &amp; Service → Maak een nieuwe app aan "
"of gebruik een bestaande app<br/>\n"
"                    3. Verleen de app toegang tot je shopgegevens<br/>\n"
"                    4. Haal je Service-ID, app-sleutel en app-geheim op<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the "
"synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/"
"\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    De voorraadsynchronisatie voor TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    heeft enkele fouten opgeleverd en is niet voltooid.\n"
"                </p>\n"
"                <p>Dit zijn de fouten die de TikTok Shop heeft "
"gerapporteerd:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Interne productreferentie(s)</th>\n"
"                            <th>Bericht</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"/>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"/>\n"
"                                <t t-else=\"\">\n"
"                                    Er is een onbekende fout opgetreden "
"tijdens de synchronisatie met TikTok Shop.\n"
"                                    Je zult helaas handmatig moeten "
"controleren of de beschikbare voorraad voor het product klopt.\n"
"                                    Als het probleem zich blijft voordoen, "
"neem dan contact op met\n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

