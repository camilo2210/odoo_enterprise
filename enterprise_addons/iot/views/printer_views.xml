<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="printer_view_list_inherit_iot" model="ir.ui.view">
        <field name="name">printer.view.list.inherit.iot</field>
        <field name="model">printer.printer</field>
        <field name="inherit_id" ref="printer.printer_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='type']" position="after">
                <field name="iot_device_id" optional="1"/>
            </xpath>
            <xpath expr="//field[@name='ip_address']" position="attributes">
                <attribute name="required">type != 'iot'</attribute>
            </xpath>
        </field>
    </record>

    <record id="printer_view_form_inherit_iot" model="ir.ui.view">
        <field name="name">printer.view.form.inherit.iot</field>
        <field name="model">printer.printer</field>
        <field name="inherit_id" ref="printer.printer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="iot_device_id" required="type == 'iot'" invisible="type != 'iot'" domain="[('type', '=', 'printer')]"/>
            </xpath>
            <xpath expr="//field[@name='ip_address']" position="attributes">
                <attribute name="invisible">type == 'iot'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
