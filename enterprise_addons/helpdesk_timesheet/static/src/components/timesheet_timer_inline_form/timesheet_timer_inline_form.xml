<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="helpdesk_timesheet.TimesheetTimerInlineForm" t-inherit="timesheet_grid.TimesheetTimerInlineForm" t-inherit-mode="extension">
        <div name="task_id_label_container" position="attributes">
            <attribute name="t-if">this.isFieldVisible(this.activeFields.task_id, data.record)</attribute>
        </div>
        <div name="task_field" position="attributes">
            <attribute name="t-if">this.isFieldVisible(this.activeFields.task_id, data.record)</attribute>
        </div>
        <div name="task_field" position="after">
            <div class="o_cell o_wrap_label text-break text-900"
                t-if="this.isFieldVisible(this.activeFields.helpdesk_ticket_id, data.record)"
            >
                <label class="o_form_label d-md-none">
                    Ticket Name
                </label>
            </div>
            <div class="o_cell o_wrap_input o_wrap_input_full_width mb-2 mb-sm-0"
                t-if="this.isFieldVisible(this.activeFields.helpdesk_ticket_id, data.record)"
            >
                <Field name="'helpdesk_ticket_id'"
                    fieldInfo="this.activeFields.helpdesk_ticket_id"
                    record="data.record"
                    class="'w-100'"
                />
            </div>
        </div>
    </t>
</templates>
