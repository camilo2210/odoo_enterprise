<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tw_tax_return_type" model="account.return.type">
            <field name="name">Bi-monthly Tax Return Filing</field>
            <field name="report_id" ref="l10n_tw.l10n_tw_tax_report_401" />
            <field name="country_id" ref="base.tw" />
            <field name="default_deadline_periodicity">2_months</field>
            <field name="states_workflow">generic_state_tax_report</field>
        </record>

        <record id="tw_404_tax_return_type" model="account.return.type">
            <field name="name">Bi-monthly Non-VAT Tax Return Filing</field>
            <field name="report_id" ref="l10n_tw.l10n_tw_tax_report_404" />
            <field name="country_id" ref="base.tw" />
            <field name="default_deadline_periodicity">2_months</field>
            <field name="states_workflow">generic_state_tax_report</field>
        </record>

        <!-- The 403 covers both the VAT and the non-VAT amounts, which the 401 and the 404
             already settle, so it is not generated to avoid closing them twice. -->
        <record id="tw_403_tax_return_type" model="account.return.type">
            <field name="name">Bi-monthly Mixed Tax Return Filing</field>
            <field name="report_id" ref="l10n_tw.l10n_tw_tax_report_403" />
            <field name="country_id" ref="base.tw" />
            <field name="default_deadline_periodicity">2_months</field>
            <field name="states_workflow">generic_state_tax_report</field>
            <field name="auto_generate" eval="False"/>
        </record>
    </data>
</odoo>
