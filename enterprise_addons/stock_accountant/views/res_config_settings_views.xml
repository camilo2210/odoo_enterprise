<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_accountant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='account_stock_valuation_accounts']/div[hasclass('content-group')]" position="inside">
                <div class="text-muted pt-2">
                    Other accounts can be defined on "Inventory Loss" and "Production" on dedicated <button
                        type="object" name="action_stock_open_valued_locations"
                        class="btn btn-link p-0 align-baseline">locations</button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
