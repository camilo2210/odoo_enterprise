<odoo>
    <record id="marketing_campaign_view_form_trigger" model="ir.ui.view">
        <field name="name">marketing.campaign.view.form.trigger.inherit.website</field>
        <field name="inherit_id" ref="marketing_automation.marketing_campaign_view_form_trigger"/>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mailing_list_ids']" position="before">
                <field name="website_page_ids" widget="many2many_tags" invisible="enroll_type != 'action' or enroll_action_type != 'page_visit'"/>
            </xpath>
        </field>
    </record>
</odoo>
