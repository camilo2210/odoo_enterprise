<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.loan.extract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="account_ocr_settings_moves" position="inside">
                <setting invisible="not module_account_loan_extract" company_dependent="1" class="order-4">
                    <field name="extract_loan_digitalization_mode" class="text-nowrap o_light_label" widget="radio" required="True"/>
                </setting>
            </div>
        </field>
    </record>
</odoo>
