        <record id="mail_template_payment_reminder_before_due" model="mail.template">
            <field name="name">Payment Reminder before due date</field>
            <field name="model_id" ref="account.model_res_partner"/>
            <field name="email_from">{{ object._get_followup_responsible().email_formatted }}</field>
            <field name="partner_to" eval="False"/>
            <field name="subject">{{ (object.company_id or object._get_followup_responsible().company_id).name }} Payment Reminder</field>
            <field name="description">Send a payment reminder before the due date to customer</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.name or ''">Brandon Freeman</t>,
                        <br /><br />
                        This is a kind reminder that you have outstanding invoices with a total amount of
                        <b>
                            <t t-if="object.followup_single_currency_id">
                                <t t-out="format_amount(object.total_due_currency_followup, object.followup_single_currency_id) or ''">$ 143,750.00</t>
                            </t>
                            <t t-else="">
                                <t t-out="format_amount(object.total_due_followup, object.currency_id) or ''"/>
                            </t>
                        </b>
                        from <t t-out="object.company_id.name or ''">YourCompany</t> which will be due in the coming days.
                        <br /><br />
                        We wanted to send this over just to help you keep your accounts up to date.
                        <br />
                        If you've already sent the payment, please feel free to ignore this email and thank you!
                        <br />
