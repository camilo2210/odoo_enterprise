<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.followup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting id="automatic_invoice_reminder" help ="Send reminders for invoices and customer statement" company_dependent="1">
                    <field name="automatic_invoice_reminder"/>
                    <button name="action_open_invoice_reminders" icon="east" type="object" string="Manage your automatic reminders" class="btn-link" invisible="not automatic_invoice_reminder"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
