<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stock_return_picking" model="ir.actions.act_window">
        <field name="name">Return</field>
        <field name="res_model">stock.return.picking.helpdesk</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_stock_return_picking_form" model="ir.ui.view">
        <field name="name">Return</field>
        <field name="model">stock.return.picking.helpdesk</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sale_order_id" options="{'no_create': True}"/>
                    <field name="picking_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_return_picking" string="Return" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
