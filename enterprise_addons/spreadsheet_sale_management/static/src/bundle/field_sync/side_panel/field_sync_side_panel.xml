<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_sale_management.FieldSyncSidePanel">
        <Section title.translate="Cell to sync">
            <SelectionInput
                ranges="[this.fieldSyncPositionString]"
                hasSingleRange="true"
                required="true"
                onSelectionChanged.bind="this.onRangeChanged"
                onSelectionConfirmed.bind="this.onRangeConfirmed"
            />
        </Section>
        <Section title.translate="Record to sync (position)">
            <input
                class="o_input o-required mt-3"
                t-ref="this.positionInputRef"
                type="number"
                min="1"
                t-on-change="this.updateRecordPosition"
                t-on-focusout="this.updateRecordPosition"
                title="Position of the record in the list"
            />

        </Section>
        <Section title.translate="Field to sync">
            <ModelFieldSelector
                resModel="'sale.order.line'"
                readonly="false"
                allowEmpty="false"
                followRelation="false"
                isDebugMode="this.debugMode.isActive()"
                filter.bind="this.filterField"
                path="this.fieldSync.fieldName"
                update.bind="this.updateField"
            />
        </Section>
        <div class="o-sidePanelButtons">
            <span t-if="this.state.updateSuccessful" class="p-2 text-primary">
                <i class="oi" data-icon="check"/>
                Saved
            </span>
      </div>
    </div>

</templates>
