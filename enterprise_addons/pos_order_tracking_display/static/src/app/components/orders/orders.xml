<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_order_tracking_display.Orders">
        <div t-attf-class="container-fluid {{ this.props.class }}">
            <div class="mb-2 fs-6 fw-bolder" t-out="this.props.categoryName" />
            <div class="row row-cols-2 row-cols-lg-3 g-3">
                <div class="col" t-foreach="this.props.orders" t-as="order" t-key="order">
                    <div t-attf-class="o_tracking_display_number p-2 rounded {{ this.props.ready ? 'text-bg-success' : 'text-bg-700' }} fs-6 fw-bolder lh-sm text-break text-center" t-out="order" />
                </div>
            </div>
        </div>
    </t>
</templates>
