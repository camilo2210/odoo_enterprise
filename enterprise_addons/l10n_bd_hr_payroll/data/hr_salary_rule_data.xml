    <record id="l10n_bd_income_tax_disabled_dependent_deduction" model="hr.salary.rule">
        <field name="category_ids" eval="[(6, 0, [ref('l10n_bd_hr_payroll.rule_category_disabled_dependent_deduction')])]"/>
        <field name="name">Disabled Dependent Deduction</field>
        <field name="code">DISABLEDDEDUCTION</field>
        <field name="sequence">114</field>
        <field name="condition_select">property_input</field>
        <field name="input_name">Number of disabled dependent</field>
        <field name="input_usage_employee" eval="True"/>
        <field name="input_section" ref="hr_payroll.default_salary_rule_section"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if employee.private_country_id.code != 'BD' and employee.country_id.code != 'BD':
    result = 0
# If bangladeshi or residing in Bangladesh
else:
    result = payslip._rule_parameter('l10n_bd_per_disabled_dependent_yearly_exempt') * (inputs['DISABLEDDEDUCTION'].amount if 'DISABLEDDEDUCTION' in inputs else 0.0)
        </field>
        <field name="appears_on_payslip">never</field>
        <field name="input_usage_payslip" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
        <field name="struct_ids" eval="[(6, 0, [
