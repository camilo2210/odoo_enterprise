        <field name="input_usage_employee" eval="True"/>
        <field name="input_section" ref="hr_payroll.default_salary_rule_section"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if employee.private_country_id.code != 'BD' and employee.country_id.code != 'BD':
    result = 0
# If bangladeshi or residing in Bangladesh
else:
    result = payslip._rule_parameter('l10n_bd_gazetted_fighter_yearly_exempt')
        </field>
