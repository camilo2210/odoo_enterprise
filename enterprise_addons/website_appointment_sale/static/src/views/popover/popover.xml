<templates xml:space="preserve">
    <t t-name="website_appointment_sale.AppointmentCalendarEventPopover" t-inherit="appointment.AppointmentCalendarEventPopover" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('popover-body')]" position="inside">
            <div t-if="data.show_create_so_btn"
                class="d-flex align-items-center text-warning mt-2"
                groups="sales_team.group_sale_salesman">
                <i class="oi me-1" data-icon="info"/>
                This appointment is not linked to any sale order.
            </div>
        </xpath>
    </t>
</templates>
