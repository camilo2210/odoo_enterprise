<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="appointments_cards" inherit_id="website_appointment.appointment_card_body">
    <xpath expr="//div[hasclass('o_wappointment_card_infos')]" position="inside">
        <div t-if="appointment.has_payment_step and appointment.product_id" class="d-flex gap-1 align-items-center small text-muted">
            <i class="oi oi-fw lh-base" data-icon="credit_card" role="presentation"/>
            <strong t-out="appointment.product_lst_price"
                t-options="{'widget': 'monetary', 'display_currency': appointment.product_currency_id}"/>
        </div>
    </xpath>
</template>

<template id="appointment_picture_item" inherit_id="website_appointment.appointment_picture_item">
    <xpath expr="//div[hasclass('o_appointment_card_location')]" position="after">
        <div t-if="appointment.has_payment_step and appointment.product_id" class="badge text-bg-primary">
            <strong t-out="appointment.product_lst_price"
                t-options="{'widget': 'monetary', 'display_currency': appointment.product_currency_id}"/>
        </div>
    </xpath>
</template>

</odoo>
