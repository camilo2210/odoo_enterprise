<?xml version="1.0"?>
<odoo>
<data>
    <record id="im_livechat_channel_view_form" model="ir.ui.view">
        <field name="name">im_livechat.channel.view.form.inherit.ai_social</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_away_message']" position="after">
                <group>
                    <field name="ai_social_livechat_agent_id" invisible="not social_account_ids"
                        placeholder="Connect an AI Agent..."/>
                    <field name="ai_social_livechat_enabled_condition"
                        invisible="not social_account_ids or not ai_social_livechat_agent_id"/>
                </group>
            </xpath>
        </field>
    </record>
</data>
</odoo>
