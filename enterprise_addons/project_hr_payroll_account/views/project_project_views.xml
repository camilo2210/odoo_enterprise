<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_view_form_inherit_project_hr_payroll_account" model="ir.ui.view">
        <field name="name">project.view.form.inherit.project.hr.payroll.account</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_project_contracts" icon="book"
                    groups="hr_payroll.group_hr_payroll_user" invisible="contracts_count == 0">
                    <field string="Contracts" name="contracts_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
