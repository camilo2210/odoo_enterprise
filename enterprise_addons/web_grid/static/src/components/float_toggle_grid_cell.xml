<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="web_grid.FloatToggleGridCell" t-inherit="web_grid.Cell">
        <xpath expr="//input" position="replace">
            <button t-if="this.props.editMode"
                    class="o_field_float_toggle"
                    t-on-click="this.onChange"
                    t-on-keydown="this.onKeyDown"
                    t-ref="this.buttonRef"
            >
                <t t-out="this.formattedValue()" />
            </button>
        </xpath>
    </t>
</templates>
