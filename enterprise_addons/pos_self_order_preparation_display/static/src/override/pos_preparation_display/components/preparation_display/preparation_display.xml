<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order_preparation_display.PrepDisplay" t-inherit="pos_enterprise.PrepDisplay" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('burger-menu')]//div" position="inside">
            <span t-if="this.filterSelected>0" class="openMenu badge right text-bg-info rounded-pill" t-out="this.filterSelected"/>
            <span t-if="this.outOfPaperListFiltered.length>0" class="openMenu badge left text-bg-danger rounded-pill" t-out="this.outOfPaperListFiltered.length"/>
        </xpath>
        <xpath expr="//li[hasclass('recall-button')]" position="before">
            <t t-foreach="this.outOfPaperListFiltered" t-as="configPaperStatus" t-key="configPaperStatus">
                <li class="menu-item navbar-button" t-on-click="() => this.paperNotificationClick(configPaperStatus)">
                    <a class="dropdown-item py-2 text-wrap text-danger">
                        <span t-out="configPaperStatus.name"/> out of paper
                    </a>
                </li>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('top-buttons')]" position="before">
            <section t-if="this.outOfPaperListFiltered.length>0" class="d-flex gap-2 me-3 align-items-center">
                <button t-if="!this.state.isAlertMenu" class="menu btn btn-light d-flex align-items-center position-relative p-2 rounded shadow-none" t-on-click="this.openAlertMenu">
                    <div class="d-flex px-1">
                        <i class="oi oi-lg" data-icon="warning" aria-hidden="true"></i>
                        <span class="d-none d-lg-inline-block px-2">Alert</span>
                        <span t-if="this.outOfPaperListFiltered.length>0" class="openMenu badge right text-bg-danger rounded-pill" t-out="this.outOfPaperListFiltered.length"/>
                    </div>
                </button>
                <button t-else="" class="menu btn btn-light d-flex align-items-center position-relative p-2 rounded shadow-none" t-on-click="this.closeAlertMenu">
                    <div class="position-relative px-1">
                        <i class="oi oi-lg" data-icon="warning" aria-hidden="true"></i>
                        <span class="d-none d-lg-inline-block px-2">Alert</span>
                    </div>
                    <ul class="dropdown-menu sub-menu position-absolute d-flex flex-column align-items-stretch w-100 bg-white shadow-lg z-1">
                        <t t-foreach="this.outOfPaperListFiltered" t-as="configPaperStatus" t-key="configPaperStatus">
                            <li class="menu-item navbar-button" t-on-click="() => this.paperNotificationClick(configPaperStatus)">
                                <a class="dropdown-item py-2 text-wrap text-danger">
                                    <span t-out="configPaperStatus.name"/> out of paper
                                </a>
                            </li>
                        </t>
                    </ul>
                </button>
            </section>
        </xpath>
    </t>
</templates>
