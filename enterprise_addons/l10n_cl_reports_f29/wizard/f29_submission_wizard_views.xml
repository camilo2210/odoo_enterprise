<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_f29_return_submission_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl_reports_f29.return.submission.wizard.form</field>
        <field name="model">l10n_cl_reports_f29.return.submission.wizard</field>
        <field name="inherit_id" ref="account_reports.return_submission_wizard_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='instructions']" position="after">
                <button name="print_pdf" string="Download F29 Report" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
