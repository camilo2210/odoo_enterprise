<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quant_action_locate" model="ir.actions.act_window">
        <field name="name">Stock Locations</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,kanban</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('stock.view_stock_quant_tree')}),
            Command.create({'view_mode': 'kanban', 'view_id': ref('stock_barcode.stock_quant_barcode_kanban_2')}),
        ]"/>
        <field name="context">{
            'search_default_internal_loc': 1,
        }</field>
    </record>
</odoo>
