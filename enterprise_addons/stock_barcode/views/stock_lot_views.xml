<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_lot_view_kanban" model="ir.ui.view">
        <field name="name">stock.lot.view.kanban</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" draggable="0">
                <templates>
                    <t t-name="card">
                        <field name="product_id" class="fw-bold"/>
                        <field name="location_id" groups="stock.group_stock_multi_locations"/>
                        <field name="name"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
