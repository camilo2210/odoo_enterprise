<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="stock_barcode.ExtraProductDialog" t-inherit="web.ConfirmationDialog" t-inherit-mode="primary">
        <xpath expr="//p" position="replace">
            <div class="o_barcode_extra_product_dialog">
                <p t-out="this.props.body" class="fw-bold"/>

                <t t-foreach="this.props.products.keys()" t-as="product" t-key="product">
                    <t t-set="productData" t-value="this.props.products.get(product)"/>
                    <div class="row mx-3" t-att-data-barcode="productData.params[0].fieldsParams.product_id.barcode">
                        <CheckBox className="'w-100'" value="productData.confirmed" onChange="() => this.onCheckboxChange(productData)">
                            <span class="col-9">
                                <t t-out="productData.name"/>
                            </span>
                            <span class="col-3 text-end">
                                <t t-out="productData.qty"/>
                                <t t-if="this.displayUOM" t-out="' ' + productData.uomName"/>
                            </span>
                        </CheckBox>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
