<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_barcode.BackorderDialog">
        <Dialog title.translate="Incomplete Transfer" size="'md'" fullscreen="false" contentClass="'o_barcode_backorder_dialog'">
            <div class="container">
                <div class="text-muted mb-2">
                    <t t-out="this.description"/>
                </div>
                <div class="o_barcode_backorder_column_titles d-none d-sm-flex row mb-1 pb-1 border-bottom text-capitalize">
                    <h5 class="col-4">Product</h5>
                    <h5 class="col-4">Done / To do</h5>
                    <h5 class="col-2 text-end"><t t-out="this.titleLabel"/></h5>
                </div>
                <t t-foreach="this.props.uncompletedLines" t-as="line" t-key="line.id">
                    <div class="o_barcode_backorder_product_row row mb-sm-1 py-1 p-sm-0">
                        <div class="col-sm-4" name="product" t-out="line.product_id.display_name"/>
                        <div class="col-sm-4">
                            <span class="d-sm-none me-1">Done:</span>
                            <span t-attf-class="text-{{line.qty_done ? 'warning' : 'danger'}}">
                                <span name="qty-done" t-out="line.qty_done"/> /
                                <span name="reserved-qty" t-out="line.reserved_uom_qty"/>
                                <span t-if="this.props.displayUoM" name="uom" class="ms-1" t-out="line.uom_id.name"/>
                            </span>
                        </div>
                        <div class="col-sm-2 text-sm-end">
                            <span class="d-sm-none me-1" t-out="this.titleLabel + ':'"/>
                            <span t-att-class="this.isNever ? 'text-danger' : ''">
                                <span name="backorder-qty" t-out="line.reserved_uom_qty - line.qty_done"/>
                                <span t-if="this.props.displayUoM" name="uom" class="ms-1" t-out="line.uom_id.name"/>
                            </span>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button t-if="!this.isNever"
                        class="btn btn-primary"
                        t-on-click="() => this._onBackorder(true)"
                        t-out="this.createLabel"/>
                <button t-if="this.mode !== 'always'"
                        t-attf-class="btn btn-{{ this.isAsk ? 'danger' : 'primary' }}"
                        t-on-click="() => this._onBackorder(false)"
                        t-out="this.noBackorderLabel"/>
                <button class="btn btn-secondary" t-on-click="this.props.close" t-out="this.discardLabel"/>
            </t>
        </Dialog>
    </t>
</templates>
