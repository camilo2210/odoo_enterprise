<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_barcode.PackageLineComponent">
        <div t-on-click="this.select" t-att-data-package="this.packageDataAttribute"
            class="o_barcode_line list-group-item d-flex flex-row flex-nowrap py-3"
            t-att-style="this.line.colorLine !== undefined ? 'border-color: hsla(' + this.line.colorLine + ', 80%, 50%, 0.6);' : ''"
            t-attf-class="{{this.componentClasses}}">
            <div class="o_barcode_line_details flex-grow-1 flex-column flex-nowrap">
                <div class="d-flex justify-content-between align-items-center">
                    <div name="package">
                        <i class="oi oi-fw" data-icon="archive"/>
                        <span class="package" t-out="this.packageLabel"/>
                        <i class="oi mx-1" data-icon="east"/>
                        <span class="result-package" t-out="this.resultPackageLabel"/>
                    </div>
                    <div>
                        <button t-if="this.isSelected"
                                t-on-click.stop="this.unpack"
                                barcode_trigger="UPCK"
                                class="o_line_button o_unpack btn btn-secondary ms-2">
                                <span class="oi oi-stack">
                                    <i class="oi oi-lg oi-stack-1x" data-icon="oi_dropbox" role="img"/>
                                    <i class="oi oi-stack-1x" data-icon="arrow_upward" role="img"/>
                                </span>
                            Unpack
                        </button>
                        <button t-on-click="this.openPackage"
                                class="o_line_button o_package_content btn btn-secondary ms-2">
                            <i class="oi oi-lg" data-icon="oi_dropbox"/>
                        </button>
                    </div>
                </div>
                <t t-call="stock_barcode.LineQuantity"/>
                <t t-call="stock_barcode.LineOwner"/>
                <t t-call="stock_barcode.LineDestinationLocation"/>
            </div>
        </div>
    </t>

</templates>
