<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="stock_barcode.barcode_generate_snln_dialog">
        <Dialog title="this.title" contentClass="'o_stock_barcode_confirm_quant_dialog'" size="'md'" fullscreen="false">
            <div class="o_form_view o_form_nosheet">
                <div class="container">
                    <div class="row mb-2">
                        <div class="col-3" >
                            <div class="form-check" t-on-click="() => this.generationMode.set('only_one')">
                                <input id="mode_one" class="form-check-input" type="radio" name="pay_group" value="only_one" t-model="this.generationMode"/>
                                <label class="o_form_label" for="mode_auto" >Only One</label>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-check" t-on-click="() => this.generationMode.set('all')">
                                <input id="mode_all" class="form-check-input" type="radio" name="generationMode" value="all" t-model="this.generationMode"/>
                                <label class="o_form_label" for="mode_auto" >All</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-4">
                            <label class="o_form_label" for="next_serial_0">
                                <t t-if="this.isLotTracking &amp;&amp; this.generationMode() === 'only_one'">Lot Number</t>
                                <t t-if="this.isLotTracking &amp;&amp; this.generationMode() === 'all'">First Lot Number</t>
                                <t t-if="!this.isLotTracking &amp;&amp; this.generationMode() === 'only_one'">Serial Number</t>
                                <t t-if="!this.isLotTracking &amp;&amp; this.generationMode() === 'all'">First Serial Number</t>
                            </label>
                        </div>
                        <div class="col-8">
                            <div name="next_serial" class="o_field_widget o_field_char">
                                <input class="o_input" t-ref="this.nextSerial" id="next_serial_0" type="text" placeholder="e.g. LOT-PR-00012"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="this.isLotTracking" class="row mb-2">
                        <div class="col-4">
                            <label class="o_form_label" for="total_received_0">Quantity Received</label>
                        </div>
                        <div class="col-8">
                            <div name="total_received" class="o_field_widget o_field_integer">
                                <input inputmode="numeric" t-ref="this.totalReceived" class="o_input" id="total_received_0" type="number"/>
                            </div>
                            <span t-if="this.displayUOM" t-out="this.props.line.product_id.uom_id.display_name"/>
                        </div>
                    </div>

                    <div class="row mb-2" t-att-class="{ 'd-none': this.generationMode() === 'only_one' }">
                        <div class="col-4">
                            <label class="o_form_label" for="next_serial_count_0">
                                <t t-if="this.isLotTracking">Quantity per Lot</t>
                                <t t-else="">Number of SN</t>
                            </label>
                        </div>
                        <div class="col-8">
                            <div name="next_serial_count" class="o_field_widget o_field_integer">
                                <input inputmode="numeric" t-ref="this.nextSerialCount" class="o_input" id="next_serial_count_0" type="number"
                                    t-on-keydown="(ev) => !this.isLotTracking and ev.key === '.' and ev.preventDefault()"/>
                            </div>
                            <span t-if="this.isLotTracking &amp;&amp; this.displayUOM" t-out="this.props.line.product_id.uom_id.display_name"/>
                        </div>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="o_confirm btn btn-primary" t-on-click="this._onValidate">Validate</button>
                <button class="o_cancel btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>