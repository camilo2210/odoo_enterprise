<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ai_agentic.AiAgentSystemPromptEditor">
        <div class="o_ai_agent_system_prompt_editor d-flex flex-column h-100 pt-2">
            <textarea
                t-if="this.isEditing()"
                t-ref="this.textareaRef"
                class="flex-grow-1 w-100 h-100 p-0 border-0 bg-transparent overflow-y-auto text-break"
                t-att-placeholder="this.props.placeholder"
                t-on-blur="this.stopEditing"
            />
            <div
                t-else=""
                class="o_ai_agent_system_prompt_editor_preview flex-grow-1 w-100 overflow-y-auto text-break"
                t-on-click="this.startEditing"
            >
                <span t-if="this.isEmpty" class="text-muted text-prewrap" t-out="this.props.placeholder"/>
                <t t-else="" t-out="this.props.record.data.system_prompt_rendered"/>
            </div>
        </div>
    </t>

</templates>
