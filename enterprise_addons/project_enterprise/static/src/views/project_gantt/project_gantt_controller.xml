<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_enterprise.ProjectGanttView.Buttons" t-inherit="web_gantt.GanttView.Buttons" t-inherit-mode="primary">
        <button class="o_gantt_button_add btn btn-primary" position="replace">
            <ProjectTemplateDropdown t-if="this.model.metaData.canCreate and !this.env.inDialog"
                onCreate="() => this.onNewClicked()"
                newButtonClasses="'o_gantt_button_add btn btn-primary'"
                hotkey="this.r"
                context="this.props.context"
                getAdditionalContext.bind="this.getAdditionalContext"
            /> 
        </button>
    </t>
</templates>
