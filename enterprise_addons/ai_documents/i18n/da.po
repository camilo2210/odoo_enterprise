#. module: ai_documents
#: model:ir.actions.server,ai_tool_description:ai_documents.ir_actions_server_rename_file
msgid ""
"Rules:\n"
"1. ORIGIN: APP (Odoo's apps, modules, models/Other), UP (User Upload), EM "
"(Email), PE (Peppol). Use document messages to know document source.\n"
"2. DATE: Date of document creation on our system (YYYYMMDD, if day missing, "
"default to 01).\n"
"3. SENDER: Creator name. Strip spaces/illegal chars (use CamelCase).\n"
"4. DOCTYPE: VBL(VendorBill), INV(Invoice), CRN(CreditNote), TAX(Tax/"
"FinReport), RCP(Receipt), CV(Resume), CON(Contract), IDV(ID/Visa), "
"INS(Insurance), FIN(Fine), MISC(Other).       \n"
"        "
msgstr ""
"Regler:\n"
"1. OPRINDELSE: APP (Odoos apps, moduler, modeller/andet), UP (brugerupload), "
"EM (e-mail), PE (Peppol). Brug dokumentmeddelelser til at identificere "
"dokumentets kilde.\n"
"2. DATO: Dato for dokumentets oprettelse i vores system (ÅÅÅÅMMDD; hvis "
"dagen mangler, brug 01 som standard).\n"
"3. AFSENDER: Opretters navn. Fjern mellemrum og ugyldige tegn (brug "
"CamelCase).\n"
"4. DOKUMENTTYPE: VBL (leverandørregning), INV (faktura), CRN (kreditnota), "
"TAX (skat/finansrapport), RCP (kvittering), CV (CV), CON (kontrakt), IDV (ID/"
"visum), INS (forsikring), FIN (bøde), MISC (andet).       \n"
"        "

