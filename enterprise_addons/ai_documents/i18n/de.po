#. module: ai_documents
#: model:ir.actions.server,ai_tool_description:ai_documents.ir_actions_server_rename_file
msgid ""
"Rules:\n"
"1. ORIGIN: APP (Odoo's apps, modules, models/Other), UP (User Upload), EM "
"(Email), PE (Peppol). Use document messages to know document source.\n"
"2. DATE: Date of document creation on our system (YYYYMMDD, if day missing, "
"default to 01).\n"
"3. SENDER: Creator name. Strip spaces/illegal chars (use CamelCase).\n"
"4. DOCTYPE: VBL(VendorBill), INV(Invoice), CRN(CreditNote), TAX(Tax/"
"FinReport), RCP(Receipt), CV(Resume), CON(Contract), IDV(ID/Visa), "
"INS(Insurance), FIN(Fine), MISC(Other).       \n"
"        "
msgstr ""
"Regeln:\n"
"1. HERKUNFT: APP (Odoo-Apps, Module, Modelle/Sonstiges), UP (Benutzer-Upload)"
", EM (E-Mail), PE (Peppol). Verwenden Sie Dokumentmeldungen, um die Herkunft "
"des Dokuments zu ermitteln.\n"
"2. DATUM: Datum der Dokumenterstellung in unserem System (JJJJMMTT; falls "
"der Tag fehlt, Standardwert 01).\n"
"3. ABSENDER: Name des Erstellers. Leerzeichen und unzulässige Zeichen "
"entfernen (CamelCase verwenden).\n"
"4. DOKUMENTTYP: VBL (Lieferantenrechnung), INV (Rechnung), CRN (Gutschrift), "
"TAX (Steuer-/Finanzbericht), RCP (Beleg), CV (Lebenslauf), CON (Vertrag), "
"IDV (Ausweis/Visum), INS (Versicherung), FIN (Bußgeld), MISC (Sonstiges)"
".       \n"
"        "

