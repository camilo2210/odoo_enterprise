<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="fal_pdf_export_filters" inherit_id="account_reports.pdf_export_filters">
            <xpath expr="//t[@name='aml_ir_filters']" position="after">
                <t t-if="'asset_states' in options">
                    <div class="row">
                        <t t-set="selected_states" t-value="[s['name'] for s in options['asset_states'] if s.get('selected')]"/>
                        <div class="col-12">
                            Asset Status:
                            <t t-if="not selected_states">
                                <span class="o_text_muted"> (None) </span>
                            </t>
                            <t t-elif="len(selected_states) == len(options['asset_states'])">All</t>
                            <t t-else="">
                                <t t-out="', '.join(selected_states)"/>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-if="'asset_models' in options">
                    <div class="row">
                        <t t-set="selected_model_names" t-value="[m['name'] for m in options['asset_models'] if m.get('selected')]"/>
                        <div class="col-12">
                            Asset Class:
                            <t t-if="not selected_model_names">
                                <span class="o_text_muted"> (None) </span>
                            </t>
                            <t t-else="">
                                <t t-out="', '.join(selected_model_names)"/>
                            </t>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
