<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boa_fal_report" model="account.report">
        <field name="name">Fixed Assets Listing</field>
        <field name="country_id" ref="base.ph"/>
        <!-- Fake variant, it's just for grouping under BoA -->
       <field name="root_report_id" ref="l10n_ph_reports.boa_general_journal_report"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_multi_company">tax_units</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_show_draft" eval="True"/>  
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_hide_0_lines" eval="False"/>
        <field name="load_more_limit" eval="80"/>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_l10n_ph_boa_fal_report_handler"/>
        <field name="column_ids">
            <record id="boa_fal_report_fa_code" model="account.report.column">
                <field name="name">FA Code</field>
                <field name="expression_label">fa_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_fal_report_asset_type" model="account.report.column">
                <field name="name">Asset Type</field>
                <field name="expression_label">asset_type</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_fal_report_purchase_date" model="account.report.column">
                <field name="name">Purchase Date</field>
                <field name="expression_label">purchase_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="boa_fal_report_purchase_price" model="account.report.column">
                <field name="name">Purchase Price</field>
                <field name="expression_label">purchase_price</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_fal_report_depreciation_start_date" model="account.report.column">
                <field name="name">Depr. Start Date</field>
                <field name="expression_label">depreciation_start_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="boa_fal_report_accumulated_depreciation" model="account.report.column">
                <field name="name">Accum. Depr. (Total)</field>
                <field name="expression_label">accumulated_depreciation</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="boa_fal_report_useful_life" model="account.report.column">
                <field name="name">Useful Life</field>
                <field name="expression_label">useful_life</field>
                <field name="figure_type">string</field>
            </record>
            <record id="boa_fal_report_residual_value" model="account.report.column">
                <field name="name">Residual Value</field>
                <field name="expression_label">residual_value</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
