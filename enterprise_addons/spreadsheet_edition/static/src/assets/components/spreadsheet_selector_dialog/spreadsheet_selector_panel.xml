<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="spreadsheet_edition.SpreadsheetSelectorPanel"
       >
        <div class="o-sp-dialog-cp">
            <div class="o-sp-searchview align-items-center d-flex">
                <input type="text"
                    class="o-sp-searchview-input o_input form-control"
                    placeholder="Search..."
                    t-on-input="this.onSearchInput"/>
                <i class="o-sp-searchview-icon oi"
                    data-icon="search"
                    role="img"
                    aria-label="Search..."
                    title="Search..."></i>
            </div>
            <div class="o-spreadsheet-selector-pager">
                <Pager offset="this.state.pagerProps.offset"
                    limit="this.state.pagerProps.limit"
                    total="this.state.pagerProps.total"
                    onUpdate.bind="this.onUpdatePager"
                    isEditable="false" />
            </div>
        </div>
		<SpreadsheetSelectorGrid
            spreadsheets="this.state.spreadsheets"
            onSpreadsheetSelected.bind="this._selectItem"
            onSpreadsheetDblClicked.bind="this.props.onSpreadsheetDblClicked"
            getThumbnailURL="this.getThumbnailURL"
            selectedSpreadsheetId="this.state.selectedSpreadsheetId"
            displayBlank="this.props.displayBlank"
            blankCardLabel="this.blankCardLabel"
        />
    </t>

</templates>
