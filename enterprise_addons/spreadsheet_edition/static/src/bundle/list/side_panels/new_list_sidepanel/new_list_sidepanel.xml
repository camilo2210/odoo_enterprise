<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div
        t-name="spreadsheet_edition.NewListSidePanel"
        class="h-100 overflow-hidden d-flex justify-content-between flex-column o_new_list_side_panel">
        <div class="h-100 position-relative overflow-x-hidden overflow-y-auto">
            <Section title.translate="Model">
                <ModelSelector value="this.state.model?.label" onModelSelected.bind="this.onModelSelected" autofocus="true"/>
            </Section>
            <Section>
                <div class="o-sidePanelButtons">
                    <button class="o-button" t-on-click="() => this.props.onCloseSidePanel()">
                        Discard
                    </button>
                    <button class="o-button primary" t-on-click="this.save" t-att-disabled="!this.isSaveAllowed">
                        Save
                    </button>
                </div>
            </Section>
        </div>
    </div>
</templates>
