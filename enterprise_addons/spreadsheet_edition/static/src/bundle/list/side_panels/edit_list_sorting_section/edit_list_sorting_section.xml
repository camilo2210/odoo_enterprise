<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="spreadsheet_edition.EditListSortingSection">
        <Section class="'o-section'">
            <t t-set-slot="title">
                <div class="d-flex justify-content-between align-items-center">
                    Sorting
                    <AddDimensionButton
                        onFieldPicked.bind="this.onAddSortingRule"
                        fields="this.getAllowedFields()"
                    />
                </div>
            </t>
            <div t-ref="this.mainRef">
                <t t-foreach="this.props.orderBy" t-as="rule" t-key="rule_index">
                    <t t-set="field" t-value="this.props.fields[rule.name]"/>
                    <div
                        class="d-flex border rounded py-1 px-2 d-flex flex-column shadow-sm pivot-dimension mt-1"
                        t-att-class="{'pivot-dimension-invalid': !field}"
                        t-att-data-id="rule.name"
                        t-att-style="this.dnd.itemsStyle[rule.name]"
                        t-on-pointerdown="(ev) => this.startDragAndDrop(rule, ev)">
                        <div class="d-flex flex-row justify-content-between align-items-center o_sorting_rule_column">
                            <span t-if="field" class="o-fw-bold" t-out="field.string"/>
                            <t t-else="">
                                <span class="o-fw-bold me-auto" t-out="rule.name"/>
                                <span class="text-danger me-1">
                                    <t t-call="o-spreadsheet-Icon.TRIANGLE_EXCLAMATION"/>
                                </span>
                            </t>
                            <i class="btn oi oi-filled pe-0 o-delete-rule o-button-icon" data-icon="delete" t-on-click="(ev) => this.onDeleteSortingRule(rule_index)"/>
                        </div>
                        <div class="d-flex">
                            <div class="d-flex py-1 px-2 w-100 small">
                                <div class="pivot-dim-operator-label">Order</div>
                                <Select
                                    class="'o-select-order'"
                                    selectedValue="(!!rule.asc).toString()"
                                    values="this.sortingOptions"
                                    onChange="() => this.toggleAscending(rule_index)"
                                />
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Section>
    </t>
</templates>
