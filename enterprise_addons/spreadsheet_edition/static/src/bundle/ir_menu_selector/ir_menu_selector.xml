<?xml version="1.0" encoding="utf-8"?>
<templates>
  <t t-name="spreadsheet_edition.IrMenuSelector">
      <div class="o-ir-menu-selector" t-ref="this.menuSelectorRef" t-att-class="this.props.class">
        <Many2XAutocomplete t-props="this.many2XAutocompleteProps"/>
      </div>
  </t>

    <t t-name="spreadsheet_edition.IrMenuSelectorDialog">
      <Dialog title.translate="Select an Odoo menu to link in your spreadsheet" size="'sm'">
        <IrMenuSelector
          menuId="this.selectedMenu.id"
          onValueChanged.bind="this._onValueChanged"
          autoFocus="true"
        />
        <t t-set-slot="footer">
          <button class="btn btn-primary o-confirm" t-on-click.stop="this._onConfirm" t-att-disabled="!this.selectedMenu.id">
            Confirm
          </button>
          <button class="btn btn-secondary o-cancel" t-on-click.stop="this.props.close">Discard</button>
        </t>
      </Dialog>
    </t>
</templates>
