<?xml version="1.0" encoding="utf-8"?>
<templates>

<div t-name="spreadsheet_edition.CellThreadPopover"
    t-key="this.props.threadId"
    t-on-focusin="() => this.onFocused()"
    class="o-thread-popover">
    <t t-if="this.state.thread.id">
        <div t-att-class="{'o-thread-highlight': !this.props.isInteractive}">
            <CellThread threadId="this.state.thread.id" t-key="this.state.thread.localId" edit="this.props.isInteractive" />
        </div>
    </t>
    <t t-else="1">
        <div class="o-thread-start-composer">
            <SpreadsheetCommentComposer
                placeholder.translate="Add a comment..."
                composer="this.state.thread.composer"
                type="'note'"
                showFullComposer="false"
                onPostCallback.bind="this.insertNewThread"
                autofocus="1"
            />
        </div>
    </t>
    <div t-if="this.props.isInteractive" class="o-thread-highlight">
        <button
            class="p-2 btn text-primary pointer-event"
            t-on-click="() => this.showAllComments()">Open all comments</button>
    </div>
</div>

</templates>
