<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t
        t-name="spreadsheet_edition.OdooPivotLayoutConfigurator"
        t-inherit="o-spreadsheet-PivotLayoutConfigurator">
        <xpath expr="//AddDimensionButton" position="replace">
            <SidepanelModelFieldSelector
                resModel="this.props.definition.model"
                isDebugMode="this.debugMode.isActive()"
                readonly="false"
                filter.bind="this.filterField"
                update.bind="this.addColumnDimension"/>
        </xpath>
        <xpath expr="//AddDimensionButton" position="replace">
            <SidepanelModelFieldSelector
                resModel="this.props.definition.model"
                isDebugMode="this.debugMode.isActive()"
                readonly="false"
                filter.bind="this.filterField"
                update.bind="this.addRowDimension"
            />
        </xpath>
    </t>
</templates>
