<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="spreadsheet_edition.SpreadsheetNavbar" t-inherit="web_enterprise.EnterpriseNavBar" t-inherit-mode="primary">
        <xpath expr="//img[hasclass('o_menu_brand_icon')]" position="replace">
            <img
                t-if="!this.ui.isSmall"
                src="/spreadsheet/static/description/icon.svg"
                class="o_menu_brand_icon d-inline position-absolute start-0 h-100 ps-1 ms-2"
                alt="Spreadsheet"
                t-ref="this.appIconRef"/>
        </xpath>

        <xpath expr="//span[hasclass('o_menu_brand')]" position="attributes">
            <attribute name="t-out"/>
        </xpath>
        <xpath expr="//span[hasclass('o_menu_brand')]" position="inside">
            Spreadsheet
        </xpath>

        <xpath expr="//div[hasclass('o_navbar_breadcrumbs')]" position="replace">
            <div class="d-flex align-items-center flex-fill" t-att-class="{'o_navbar_breadcrumbs': this.ui.isSmall}">
                <t t-if="this.ui.isSmall">
                    <button class="o_back_button btn btn-link d-print-none px-1 py-0" t-on-click.prevent="this.onBreadcrumbClicked">
                        <i class="oi oi-fw" data-icon="west"/>
                    </button>
                </t>
                <t t-else="">
                    <div t-if="this.breadcrumbs.length > 1" class="btn btn-link o-sp-breadcrumb fw-normal" t-on-click="this.onBreadcrumbClicked" t-out="this.breadcrumbTitle"/>
                </t>
                <SpreadsheetName name="this.props.spreadsheetName" isReadonly="this.props.isReadonly" onSpreadsheetNameChanged="this.props.onSpreadsheetNameChanged" />
                <t t-call-slot="navbar-additional-actions"/>
                <SpreadsheetSyncStatus t-if="!this.props.isReadonly" model="this.props.model"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='web.NavBar.SectionsMenu']" position="replace"/>
    </t>
</templates>
