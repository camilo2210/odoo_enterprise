<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet_edition.SidePanelDomain">
        <Section class="'o-section'" title.translate="Domain">
            <DomainSelector resModel="this.props.resModel" domain="this.getStringifiedDomain()"/>
            <div class="btn btn-link o_edit_domain" t-on-click="this.openDomainEdition">
                <i class="oi me-1" data-icon="east"/>Edit domain
            </div>
        </Section>
    </t>
</templates>
