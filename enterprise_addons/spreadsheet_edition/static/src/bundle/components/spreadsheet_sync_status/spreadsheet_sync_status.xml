<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.SpreadsheetSyncStatus" class="o_spreadsheet_sync_status text-muted fst-italic d-flex align-items-baseline gap-1">
        <t t-if="this.isSynced">
            <i class="oi" data-icon="check" /> Saved
        </t>
        <t t-else="">
            <i class="oi oi-spin" data-icon="autorenew" /> Saving
        </t>
    </div>
</templates>
