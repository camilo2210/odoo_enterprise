<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="spreadsheet_edition.RestoreVersionConfirmationDialog">
        <Dialog size="'md'" title="this.props.title" modalRef="this.modalRef">
            <t t-out="this.props.body" />
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-danger" t-on-click="this._confirm">
                    Yes, restore
                </button>
                <button class="btn btn-secondary" t-on-click="this._makeACopy">
                    Make a copy instead
                </button>
                <button class="btn btn-secondary" t-on-click="this._cancel">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
