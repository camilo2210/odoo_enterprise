<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.SpreadsheetName"
        t-attf-style="max-width: {{this.state.inputSize}}px"
        class="o_sp_name d-flex flex-grow-1">
        <input type="text" title="Rename"
            t-ref="this.speadsheetNameInputRef"
            t-att-value="this.state.name"
            t-on-focus="this._onFocus"
            t-att-placeholder="this.placeholder"
            t-on-input="this._onInput"
            t-att-class="this.isUntitled() ? 'o-sp-untitled' : ''"
            class="o_input"
            t-on-change="this._onNameChanged"
            t-att-disabled="this.props.isReadonly" />
    </div>
</templates>
