<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet_edition.RelatedFiltersSection">
        <SidePanelCollapsible isInitiallyCollapsed="true" title="this.collapsibleTitle">
            <t t-set-slot="titleButton">
                <div class="py-2 pe-1">
                <SidepanelModelFieldSelector
                    path=""
                    resModel="this.props.resModel"
                    isDebugMode="this.debugMode.isActive()"
                    readonly="false"
                    filter.bind="this.filterField"
                    sort.bind="this.sortFields"
                    update.bind="this.openGlobalFilterSidePanel"
                />
                </div>
            </t>
            <t t-set-slot="content">
                <RelatedFilters t-props="this.props"/>
            </t>
        </SidePanelCollapsible>
    </t>
</templates>
