<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.SelectionFilterEditorSidePanel" class="o_spreadsheet_filter_editor_side_panel" data-id="selection-filter-panel">
        <Section title.translate="Label">
            <TextInput
                placeholder="this.store.labelPlaceholder"
                class="'o_global_filter_label' + (this.store.missingLabelError ? ' o_field_invalid' : '')"
                value="this.store.filter.label"
                onChange.bind="this.setLabel"
                autofocus="true"
            />
        </Section>
        <t t-if="this.store.isValid">
            <Section title.translate="Selection field" class="'o-selection-model-field'">
                <div class="o-section-subtitle">Model</div>
                <ModelSelector
                    value="this.store.selectionModelLabel"
                    onModelSelected.bind="this.store.onSelectionModelSelected"
                />
                <t t-if="this.store.filter.resModel">
                    <div class="o-section-subtitle">Field</div>
                    <ModelFieldSelector
                        path="this.store.filter.selectionField"
                        resModel="this.store.filter.resModel"
                        readonly="false"
                        allowEmpty="false"
                        isDebugMode="this.debugMode.isActive()"
                        update.bind="this.store.onSelectionFieldSelected"
                        filter.bind="this.filterSelectionsFields"
                    />
                </t>
            </Section>
            <Section title.translate="Filter value" t-if="this.store.filter.resModel and this.store.filter.selectionField">
                <div class="o-section-subtitle">Default value</div>
                <GlobalFilterInput
                    filter="this.store.filter"
                    setGlobalFilterValue.bind="this.updateDefaultValue"
                    updateOperator.bind="this.updateOperator"
                    globalFilterValue="this.store.filter.defaultValue"
                />
            </Section>
            <t t-if="this.store.shouldDisplayFieldMatching">
                <SidePanelCollapsible isInitiallyCollapsed="!this.store.isNew" title.translate="Field matching">
                    <t t-set-slot="content">
                        <Section class="'pt-0'">
                            <FilterEditorFieldMatching
                                fieldMatchings="this.store.fieldsMatching"
                                selectField.bind="this.store.updateFieldMatching"
                                filterModelFieldSelectorField="this.store.filterModelFieldSelectorField"
                            />
                        </Section>
                    </t>
                </SidePanelCollapsible>
            </t>
        </t>
        <Section t-else="1">
            <ValidationMessages messages="[this.invalidModel]" msgType="'error'"/>
        </Section>
        <GlobalFilterFooter t-props="this.footerProps"/>
    </div>
</templates>
