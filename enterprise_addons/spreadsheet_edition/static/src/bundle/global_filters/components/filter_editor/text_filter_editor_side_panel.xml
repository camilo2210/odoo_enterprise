<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.TextFilterEditorSidePanel" class="o_spreadsheet_filter_editor_side_panel" data-id="text-filter-panel">
        <Section title.translate="Label">
            <TextInput
                placeholder="this.store.labelPlaceholder"
                class="'o_global_filter_label' + (this.store.missingLabelError ? ' o_field_invalid' : '')"
                value="this.store.filter.label"
                onChange.bind="this.setLabel"
                autofocus="true"
            />
        </Section>
        <t t-if="this.store.isValid">
            <Section title.translate="Filter value">
                <div class="o-section-subtitle">Default value</div>
                <GlobalFilterInput
                    filter="this.store.filter"
                    setGlobalFilterValue.bind="this.updateDefaultValue"
                    updateOperator.bind="this.updateOperator"
                    globalFilterValue="this.store.filter.defaultValue"
                    rangesOfAllowedValues="this.store.filter.rangesOfAllowedValues ?? []"
                />
                <div class="o-section-subtitle mt-4">Possible values</div>
                <Checkbox
                    className="'restrict_to_range mb-1'"
                    label.translate="Restrict values to ranges"
                    onChange.bind="this.toggleRangeRestriction"
                    value="this.state.rangeRestriction"
                />
                <SelectionInput
                    t-if="this.state.rangeRestriction"
                    ranges="this.store.rangesForSelectionInput"
                    required="true"
                    onSelectionChanged.bind="this.onRangeChanged"
                    onSelectionConfirmed.bind="this.onRangeConfirmed"
                />
            </Section>
            <t t-if="this.store.shouldDisplayFieldMatching">
                <SidePanelCollapsible isInitiallyCollapsed="!this.store.isNew" title.translate="Field matching">
                    <t t-set-slot="content">
                        <Section class="'pt-0'">
                            <FilterEditorFieldMatching
                                fieldMatchings="this.store.fieldsMatching"
                                selectField.bind="this.store.updateFieldMatching"
                                filterModelFieldSelectorField="this.store.filterModelFieldSelectorField"
                            />
                        </Section>
                    </t>
                </SidePanelCollapsible>
            </t>
        </t>
        <Section t-else="1">
            <ValidationMessages messages="[this.invalidModel]" msgType="'error'"/>
        </Section>
        <GlobalFilterFooter t-props="this.footerProps"/>
    </div>
</templates>
