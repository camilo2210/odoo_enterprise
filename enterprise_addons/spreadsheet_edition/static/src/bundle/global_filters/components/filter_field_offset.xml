<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet_edition.FilterFieldOffset" t-if="this.props.active">
        <div class="d-flex flex-row justify-content-start w-100 align-items-right">
            <span class="text-muted mt-1 w-50">Period offset</span>
            <div class="o_filter_field_offset d-flex flex-row justify-content-start w-100 align-items-center">
                <Select
                    selectedValue="this.offsetSign.toString()"
                    values="this.offsetOptions"
                    onChange.bind="this.onOffsetSignChanged"
                    title="this.title"
                />
                <div class="d-flex flex-row align-items-center" t-if="this.offsetSign">
                    <input
                    t-att-disabled="!this.props.active"
                    t-on-change="this.onOffsetSelected"
                    type="number"
                    min="1"
                    class="o_filter_offset_input o_input mx-2 w-25"
                    t-att-value="Math.abs(this.props.selectedOffset)"
                    /> Period(s)
                </div>
            </div>
        </div>
    </t>
</templates>
