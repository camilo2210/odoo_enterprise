<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet_edition.GlobalFilterInput">
        <div class="d-flex flex-column flex-grow-1 gap-1">
            <Select
                t-if="this.operators.length"
                class="'w-50'"
                selectedValue="this.globalFilterValue?.operator || this.operators[0] || ''"
                values="this.operatorOptions"
                onChange="(value) => this.props.updateOperator(value)"
            />
            <div t-on-pointerdown.stop="">
                <FilterValue filter="this.props.filter"
                    model="this.env.model"
                    setGlobalFilterValue="(_id,value) => this.props.setGlobalFilterValue(value)"
                    globalFilterValue="this.globalFilterValue"
                    rangesOfAllowedValues="this.props.rangesOfAllowedValues"/>
            </div>
        </div>
    </t>
</templates>
