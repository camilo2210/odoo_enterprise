<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pdf_export_filter_extra_options_template_inherit_l10n_ph_reports_stock" inherit_id="account_reports.pdf_export_filter_extra_options_template">
        
        <xpath expr="//div[@name='extra_filters']" position="attributes">
            <attribute name="t-if" separator=" or " add="options.get('filter_no_stock')"/>
        </xpath>

        <xpath expr="//t[@name='options']" position="before">
            <t t-if="options.get('filter_no_stock')">
                <t t-set="label_filter_no_stock">Hide Out of Stock</t>
                <t t-set="extra_options" t-value="extra_options + [label_filter_no_stock]"/>
            </t>
        </xpath>
        
    </template>

</odoo>
