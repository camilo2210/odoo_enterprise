<odoo>
    <data>
        <template id="payevent_0004_xml_report">
                <!-- <Record_Delimiter DocumentID="1.1" DocumentType="PARENT" DocumentName="PAYEVNT" RelatedDocumentID=""/> -->
                <tns:PAYEVNT xsi:schemaLocation="http://www.sbr.gov.au/ato/payevnt ato.payevnt.0004.2020.01.00.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.sbr.gov.au/ato/payevnt">
                    <tns:Rp>
                        <tns:SoftwareInformationBusinessManagementSystemId t-out="employer['SoftwareInformationBusinessManagementSystemId']"/>
                        <tns:AustralianBusinessNumberId t-out="employer['AustralianBusinessNumberId']"/>
                        <tns:WithholdingPayerNumberId t-out="employer['WithholdingPayerNumberId']" t-if="employer['WithholdingPayerNumberId']"/>
                        <tns:OrganisationDetailsOrganisationBranchC t-out="employer['OrganisationDetailsOrganisationBranchC']"/>
                        <tns:PreviousSoftwareInformationBusinessManagementSystemId t-out="employer['PreviousSoftwareInformationBusinessManagementSystemId']"/>
                        <tns:OrganisationName>
                            <tns:DetailsOrganisationalNameT t-out="employer['DetailsOrganisationalNameT']"/>
                            <tns:PersonUnstructuredNameFullNameT t-out="employer['PersonUnstructuredNameFullNameT']"/>
                        </tns:OrganisationName>
                        <tns:ElectronicContact t-if="employer['ElectronicMailAddressT']">
                            <tns:ElectronicMailAddressT t-out="employer['ElectronicMailAddressT']"/>
                            <tns:TelephoneMinimalN t-out="employer['TelephoneMinimalN']"/>
                        </tns:ElectronicContact>
                        <tns:AddressDetailsPostal t-if="employer['PostcodeT'] and employer['CountryC']">
                            <tns:PostcodeT t-out="employer['PostcodeT']"/>
                            <tns:CountryC t-out="employer['CountryC']"/>
                        </tns:AddressDetailsPostal>
                        <tns:Payroll>
                            <tns:PaymentRecordTransactionD t-out="employer['PaymentRecordTransactionD']"/>
                            <tns:InteractionRecordCt t-out="employer['InteractionRecordCt']"/>
                            <tns:MessageTimestampGenerationDt t-out="employer['MessageTimestampGenerationDt']"/>
                            <tns:InteractionTransactionId t-out="employer['InteractionTransactionId']"/>
                            <tns:AmendmentI t-out="employer['AmendmentI']"/>
                            <tns:IncomeTaxAndRemuneration t-if="stp_id.payevent_type != 'update'">
                                <tns:PayAsYouGoWithholdingTaxWithheldA t-out="employer['PayAsYouGoWithholdingTaxWithheldA']"/>
                                <tns:TotalGrossPaymentsWithholdingA t-out="employer['TotalGrossPaymentsWithholdingA']"/>
                                <tns:ChildSupportGarnisheeA t-out="employer['ChildSupportGarnisheeA']"/>
                                <tns:ChildSupportWithholdingA t-out="employer['ChildSupportWithholdingA']"/>
                            </tns:IncomeTaxAndRemuneration>
                        </tns:Payroll>
                        <tns:Declaration>
                            <tns:SignatoryIdentifierT t-out="employer['SignatoryIdentifierT']"/>
                            <tns:SignatureD t-out="employer['SignatureD']"/>
                            <tns:StatementAcceptedI t-out="employer['StatementAcceptedI']"/>
                        </tns:Declaration>
                    </tns:Rp>
                    <tns:Int t-if="intermediary">
                        <tns:AustralianBusinessNumberId t-out="intermediary['AustralianBusinessNumberId']"/>
                        <tns:TaxAgentNumberId t-out="intermediary['TaxAgentNumberId']"/>
                        <tns:PersonUnstructuredNameFullNameT t-out="intermediary['PersonUnstructuredNameFullNameT']"/>
                        <tns:ElectronicContact>
                            <tns:ElectronicMailAddressT t-out="intermediary['ElectronicMailAddressT']"/>
                            <tns:TelephoneMinimalN t-out="intermediary['TelephoneMinimalN']"/>
                        </tns:ElectronicContact>
                        <tns:Declaration>
                            <tns:SignatoryIdentifierT t-out="intermediary['SignatoryIdentifierT']"/>
                            <tns:SignatureD t-out="intermediary['SignatureD']"/>
                            <tns:StatementAcceptedI t-out="intermediary['StatementAcceptedI']"/>
                        </tns:Declaration>
                    </tns:Int>
                </tns:PAYEVNT>
        </template>
        <template id="payeventemp_0004_xml_report">
            <tns:PAYEVNTEMP	xsi:schemaLocation="http://www.sbr.gov.au/ato/payevntemp ato.payevntemp.0004.2020.01.00.xsd" xmlns:tns="http://www.sbr.gov.au/ato/payevntemp" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <tns:Payee>
                    <tns:Identifiers>
                        <tns:TaxFileNumberId t-if="employee['TaxFileNumberId']" t-out="employee['TaxFileNumberId']"/>
                        <tns:AustralianBusinessNumberId t-if="employee['AustralianBusinessNumberId']" t-out="employee['AustralianBusinessNumberId']"/>
                        <tns:EmploymentPayrollNumberId t-out="employee['EmploymentPayrollNumberId']"/>
                        <tns:PreviousPayrollIDEmploymentPayrollNumberId t-out="employee['PreviousPayrollIDEmploymentPayrollNumberId']"/>
                    </tns:Identifiers>
                    <tns:PersonNameDetails>
                        <tns:FamilyNameT t-out="employee['FamilyNameT']"/>
                        <tns:GivenNameT t-if="employee['GivenNameT']" t-out="employee['GivenNameT']"/>
                        <tns:OtherGivenNameT t-if="employee['OtherGivenNameT']" t-out="employee['OtherGivenNameT']"/>
                    </tns:PersonNameDetails>
                    <tns:PersonDemographicDetailsBirth>
                        <tns:Dm t-out="employee['Dm']"/>
                        <tns:M t-out="employee['M']"/>
                        <tns:Y t-out="employee['Y']"/>
                    </tns:PersonDemographicDetailsBirth>
                    <tns:AddressDetails>
                        <tns:Line1T t-out="employee['Line1T']"/>
                        <tns:Line2T t-out="employee['Line2T']"/>
                        <tns:LocalityNameT t-out="employee['LocalityNameT']"/>
                        <tns:StateOrTerritoryC t-out="employee['StateOrTerritoryC']"/>
                        <tns:PostcodeT t-out="employee['PostcodeT']"/>
                        <tns:CountryC t-out="employee['CountryC']"/>
                    </tns:AddressDetails>
                    <tns:ElectronicContact>
                        <tns:ElectronicMailAddressT t-out="employee['ElectronicMailAddressT']"/>
                        <tns:TelephoneMinimalN t-out="employee['TelephoneMinimalN']"/>
                    </tns:ElectronicContact>
                    <tns:EmployerConditions>
                        <tns:EmploymentStartD t-out="employee['EmploymentStartD']"/>
                        <tns:EmploymentEndD t-out="employee['EmploymentEndD']"/>
                        <tns:PaymentBasisC t-out="employee['PaymentBasisC']"/>
                        <tns:CessationTypeC t-out="employee['CessationTypeC']"/>
                        <tns:TaxTreatmentC t-out="employee['TaxTreatmentC']"/>
                        <tns:TaxOffsetClaimTotalA t-out="employee['TaxOffsetClaimTotalA']"/>
                    </tns:EmployerConditions>
                    <tns:PayrollPeriod>
                        <tns:StartD t-out="employee['StartD']"/>
                        <tns:EndD t-out="employee['EndD']"/>
                        <tns:RemunerationPayrollEventFinalI t-out="employee['RemunerationPayrollEventFinalI']"/>
                        <tns:RemunerationCollection>
                        <t t-foreach="employee['Remuneration']" t-as="Remuneration">
                            <tns:Remuneration>
                                <tns:IncomeStreamTypeC t-out="Remuneration['IncomeStreamTypeC']"/>
                                <tns:AddressDetailsCountryC t-out="Remuneration['AddressDetailsCountryC']"/>
                                <tns:IncomeTaxPayAsYouGoWithholdingTaxWithheldA t-out="Remuneration['IncomeTaxPayAsYouGoWithholdingTaxWithheldA']"/>
                                <tns:IncomeTaxForeignWithholdingA t-if="Remuneration['IncomeTaxForeignWithholdingA']" t-out="Remuneration['IncomeTaxForeignWithholdingA']"/>
                                <tns:IndividualNonBusinessExemptForeignEmploymentIncomeA
                                    t-if="Remuneration['IndividualNonBusinessExemptForeignEmploymentIncomeA']"
                                    t-out="Remuneration['IndividualNonBusinessExemptForeignEmploymentIncomeA']"/>
                                <tns:GrossA t-out="Remuneration['GrossA']"/>
                                <tns:PaidLeaveCollection t-if="Remuneration['PaidLeaveCollection']">
                                <t t-foreach="Remuneration['PaidLeaveCollection']" t-as="leave">
                                    <tns:PaidLeave>
                                        <tns:TypeC t-out="leave['TypeC']"/>
                                        <tns:PaymentA t-out="leave['PaymentA']"/>
                                    </tns:PaidLeave>
                                </t>
                                </tns:PaidLeaveCollection>
                                <tns:AllowanceCollection t-if="Remuneration['AllowanceCollection']">
                                <t t-foreach="Remuneration['AllowanceCollection']" t-as="Allowance">
                                    <tns:Allowance>
                                        <tns:TypeC t-out="Allowance['TypeC']"/>
                                        <tns:OtherAllowanceTypeDe t-out="Allowance['OtherAllowanceTypeDe']" t-if="Allowance['OtherAllowanceTypeDe']"/>
                                        <tns:EmploymentAllowancesA t-out="Allowance['EmploymentAllowancesA']"/>
                                    </tns:Allowance>
                                </t>
                                </tns:AllowanceCollection>
                                <tns:OvertimePaymentA t-if="Remuneration['OvertimePaymentA']" t-out="Remuneration['OvertimePaymentA']"/>
                                <tns:GrossBonusesAndCommissionsA t-if="Remuneration['GrossBonusesAndCommissionsA']" t-out="Remuneration['GrossBonusesAndCommissionsA']"/>
                                <tns:GrossDirectorsFeesA t-out="Remuneration['GrossDirectorsFeesA']" t-if="Remuneration['GrossDirectorsFeesA']"/>
                                <tns:IndividualNonBusinessCommunityDevelopmentEmploymentProjectA t-out="Remuneration['IndividualNonBusinessCommunityDevelopmentEmploymentProjectA']"/>
                                <tns:SalarySacrificeCollection t-if="Remuneration['SalarySacrificeCollection']">
                                <t t-foreach="Remuneration['SalarySacrificeCollection']" t-as="Sacrifice">
                                    <tns:SalarySacrifice>
                                        <tns:TypeC t-out="Sacrifice['TypeC']"/>
                                        <tns:PaymentA t-out="Sacrifice['PaymentA']"/>
                                    </tns:SalarySacrifice>
                                </t>
                                </tns:SalarySacrificeCollection>
                                <tns:LumpSumCollection t-if="Remuneration['LumpSumCollection']">
                                <t t-foreach="Remuneration['LumpSumCollection']" t-as="LumpSum">
                                    <tns:LumpSum>
                                        <tns:TypeC t-out="LumpSum['TypeC']"/>
                                        <tns:FinancialY t-out="LumpSum['FinancialY']" t-if="'FinancialY' in LumpSum"/>
                                        <tns:PaymentsA t-out="LumpSum['PaymentsA']"/>
                                    </tns:LumpSum>
                                </t>
                                </tns:LumpSumCollection>
                                <!-- TODO -->
                                <tns:EmploymentTerminationPaymentCollection t-if="Remuneration['EmploymentTerminationPaymentCollection']">
                                <t t-foreach="Remuneration['EmploymentTerminationPaymentCollection']" t-as="Termination">
                                    <tns:EmploymentTerminationPayment>
                                        <tns:IncomeTaxPayAsYouGoWithholdingTypeC t-out="Termination['IncomeTaxPayAsYouGoWithholdingTypeC']"/>
                                        <tns:IncomeD t-out="Termination['IncomeD']"/>
                                        <tns:IncomeTaxFreeA t-out="Termination['IncomeTaxFreeA']"/>
                                        <tns:IncomeTaxableA t-out="Termination['IncomeTaxableA']"/>
                                        <tns:IncomePayAsYouGoWithholdingA t-out="Termination['IncomePayAsYouGoWithholdingA']"/>
                                    </tns:EmploymentTerminationPayment>
                                </t>
                                </tns:EmploymentTerminationPaymentCollection>
                            </tns:Remuneration>
                        </t>
                        </tns:RemunerationCollection>
                        <tns:DeductionCollection t-if="employee['Deduction']">
                            <t t-foreach="employee['Deduction']" t-as="deduction">
                                <tns:Deduction>
                                    <tns:RemunerationTypeC t-out="deduction['RemunerationTypeC']"/>
                                    <tns:RemunerationA t-out="deduction['RemunerationA']"/>
                                </tns:Deduction>
                            </t>
                        </tns:DeductionCollection>
                        <!-- TODO ( Super reporting is voluntarily reported in stp, can be done last ) -->
                        <tns:SuperannuationContributionCollection t-if="employee['SuperannuationContributionCollection']">
                            <t t-foreach="employee['SuperannuationContributionCollection']" t-as="super">
                                <tns:SuperannuationContribution>
                                    <tns:EntitlementTypeC t-out="super['EntitlementTypeC']"/>
                                    <tns:EmployerContributionsYearToDateA t-out="super['EmployerContributionsYearToDateA']"/>
                                </tns:SuperannuationContribution>
                            </t>
                        </tns:SuperannuationContributionCollection>
                        <!-- TODO ( Fringe benefits reporting is voluntarily reported in stp, can be done last ) -->
                        <tns:IncomeFringeBenefitsReportableCollection t-if="employee['IncomeFringeBenefitsReportableCollection']">
                            <t t-foreach="employee['IncomeFringeBenefitsReportableCollection']" t-as="benefit">
                                <tns:IncomeFringeBenefitsReportable>
                                    <tns:FringeBenefitsReportableExemptionC t-out="benefit['FringeBenefitsReportableExemptionC']"/>
                                    <tns:A t-out="benefit['A']"/>
                                </tns:IncomeFringeBenefitsReportable>
                            </t>
                        </tns:IncomeFringeBenefitsReportableCollection>
                    </tns:PayrollPeriod>
                </tns:Payee>
            </tns:PAYEVNTEMP>
        </template>
    </data>
</odoo>
