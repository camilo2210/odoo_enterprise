<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <record id="hr_payroll_warning_pending_stp" model="hr.payroll.warning">
            <field name="name">STP Reports awaiting submission</field>
            <field name="country_id" ref="base.au"/>
            <field name="button_name">Review Reports</field>
            <field name="warning_type">domain</field>
            <field name="model_id" ref="l10n_au_hr_payroll_account.model_l10n_au_stp"/>
            <field name="warning_domain">[('state', '!=', 'sent')]</field>
        </record>

        <record id="hr_payroll_warning_previous_bms" model="hr.payroll.warning">
            <field name="name">Setup Previous BMS Info and YTD Values</field>
            <field name="country_id" ref="base.au"/>
            <field name="button_name">Review</field>
            <field name="warning_type">domain</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="warning_domain">[('l10n_au_bms_id', '=', False)]</field>
            <field name="button_action" ref="l10n_au_hr_payroll_account.action_open_transfer_previous_payroll"/>
        </record>
    </data>

</odoo>
