<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_debit_note_form_view_inherit_l10n_do_edi" model="ir.ui.view">
        <field name="name">account.debit.note.form.view.inherit.l10n_do_edi</field>
        <field name="model">account.debit.note</field>
        <field name="inherit_id" ref="account_debit_note.view_account_debit_note"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="l10n_do_edi_modification_code"
                       required="l10n_latam_use_documents and country_code == 'DO'"
                       invisible="not l10n_latam_use_documents or country_code != 'DO'"/>
            </xpath>
        </field>
    </record>
</odoo>
