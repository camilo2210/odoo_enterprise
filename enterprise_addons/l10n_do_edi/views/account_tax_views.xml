<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_tax_form_view_inherit_l10n_do_edi" model="ir.ui.view">
        <field name="name">account.tax.form.view.inherit.l10n_do_edi</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_group_id']" position="after">
                <field name="l10n_do_edi_invoicing_indicator" required="type_tax_use == 'sale' and country_code == 'DO'" invisible="type_tax_use != 'sale' or country_code != 'DO'"/>
                <field name="l10n_do_edi_additional_tax_code" required="l10n_do_edi_invoicing_indicator == '7' and country_code == 'DO'" invisible="l10n_do_edi_invoicing_indicator != '7' or country_code != 'DO'"/>
            </xpath>
        </field>
    </record>
</odoo>
