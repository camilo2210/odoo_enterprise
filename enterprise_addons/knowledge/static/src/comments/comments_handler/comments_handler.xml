<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="knowledge.KnowledgeCommentsHandler"
        class="o_knowledge_comments_handler position-absolute top-0 start-100 d-print-none">
        <t t-if="this.commentsState.displayMode === 'handler'">
            <t t-set="threadTops" t-value="this.threadTops"/>
            <t t-foreach="this.props.commentBeaconManager.sortedThreadIds" t-as="threadId" t-key="threadId">
                <KnowledgeCommentsThread threadId="threadId" top="threadTops[threadId]" horizontalDimensions="this.state.threadDimensions.horizontal" threadHeights="this.threadHeights"/>
            </t>
        </t>
    </div>
</templates>
