<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="knowledge.KnowledgeTableOfContentPanel">
        <t t-if="this.panelState.isDisplayed('toc')">
            <div class="knowledge_toc_panel py-2 border rounded-3 bg-view">
                <t t-if="this.headings.length">
                    <t t-foreach="this.headings" t-as="heading" t-key="heading_index">
                        <a href="#" contenteditable="false"
                            t-on-click.prevent="() => this.onTocLinkClick(heading)"
                            class="o_no_link_popover o_toc_row py-1 px-2 d-block text-reset">
                            <span t-attf-class="#{'o_toc_link_depth_' + heading.depth}">
                                <t t-out="heading.name"/>
                            </span>
                        </a>
                    </t>
                </t>
                <t t-elif="!this.tocState.tocManager?.structure.isNew">
                    <p class="o_view_nocontent_smiling_face"/>
                    <h5 class="text-center">No Title found</h5>
                    <p class="mb-0 text-center">
                        Use the /heading command to insert your first title.<br/>
                        The Table of Contents will appear here.
                    </p>
                </t>
            </div>
        </t>
    </t>
</templates>
