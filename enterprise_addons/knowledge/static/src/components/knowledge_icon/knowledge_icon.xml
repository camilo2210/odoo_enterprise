<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="knowledge.KnowledgeIcon">
        <t t-if="this.icon">
            <p t-if="this.props.readonly" t-attf-class="o_article_emoji cursor-default m-0 #{this.props.iconClasses ? this.props.iconClasses : ''}" t-out="this.icon"/>
            <a t-else="" t-ref="this.iconRef" role="button" t-out="this.icon" t-attf-class="o_article_emoji #{this.props.iconClasses ? this.props.iconClasses : ''}"/>
        </t>

        <t t-elif="this.useFallbackFaIcon">
            <p t-if="this.props.readonly" t-attf-class="m-0 #{this.props.iconClasses ? this.props.iconClasses : ''}">
                <i class="oi oi-fw text-muted" data-icon="description"/>
            </p>
            <a t-else="" t-ref="this.iconRef" role="button" t-attf-class="#{this.props.iconClasses ? this.props.iconClasses : ''}">
                <i class="oi oi-fw text-muted" data-icon="description"/>
            </a>
        </t>

        <a t-elif="this.props.allowRandomIconSelection" role="button" t-on-click="this.selectRandomIcon" title="Add a random icon" class="text-muted opacity-75 opacity-100-hover">
            <i class="oi oi-fw" data-icon="add_circle"/>
        </a>
    </t>
</templates>
