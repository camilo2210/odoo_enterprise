<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="knowledge.SidePanel">
        <div t-att-class="{'o_knowledge_side_panel_open': this.panelState.isSidePanelOpen()}" t-on-click="this.closeSidePanel"/>
        <div class="o_scroll_view_lg d-flex flex-column px-2 ps-md-0 pe-md-3 border border-transparent ms-n2 bg-100">
            <div t-if="this.panelState.isSidePanelOpen()" class="d-flex justify-content-between align-items-center py-2 p-md-2 mb-2">
                <h4 class="mb-0" t-out="this.sidePanelTitle"/>
                <SidePanelToolbar t-props="this.props"/>
            </div>
            <div class="overflow-y-auto overflow-x-hidden flex-grow-1">
                <t t-if="this.panelState.isSidePanelOpen()">
                    <KnowledgeTableOfContentPanel />
                    <KnowledgeArticleChatter t-props="this.props" />
                    <KnowledgeCommentsPanel />
                </t>
                <KnowledgeArticleProperties t-if="this.isInternalUser" t-props="this.props" />
            </div>
        </div>
    </t>
</templates>
