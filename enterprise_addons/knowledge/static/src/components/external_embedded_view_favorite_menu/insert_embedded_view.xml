<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="knowledge.InsertEmbeddedViewMenu">
        <Dropdown>
            <button class="o_knowledge_icon_search opacity-trigger-hover">
                <t t-call="Knowledge.KnowledgeIcon"/>
                Knowledge
            </button>
            <t t-set-slot="content">
                <DropdownItem onSelected.bind="this.onInsertEmbeddedViewInArticle" closingMode="'none'">
                    <i class="oi oi-fw me-1" data-icon="toolbar"/>Insert view in article
                </DropdownItem>
                <DropdownItem onSelected.bind="this.onInsertViewLinkInArticle" closingMode="'none'" >
                    <i class="oi oi-fw me-1" data-icon="link"/>Insert link in article
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
