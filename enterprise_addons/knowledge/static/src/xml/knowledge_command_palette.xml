<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="knowledge.KnowledgeCommandTemplate">
        <div class="o_command_default px-4 py-2">
            <div class="o_command_palette_box_header d-flex align-items-center">
                <span class="pe-2">
                    <t t-if="this.props.icon_string" t-out="this.props.icon_string"/>
                    <i t-else="" class="oi oi-fw text-muted" data-icon="description"/>
                </span>
                <span class="pe-2 text-ellipsis">
                    <t t-call-slot="name"/>
                </span>
                <i t-if="this.props.isFavorite" class="oi oi-filled o_favorite pe-2 position-static" data-icon="star"/>
                <span t-if="this.props.subjectName" class="text-muted small pe-2">—</span>
                <span t-if="this.props.subjectName" t-out="this.props.subjectText" class="o_command_name text-ellipsis text-muted small"/>
                <span class="ms-auto flex-shrink-0">
                    <t t-call-slot="focusMessage"/>
                </span>
            </div>
            <div t-if="this.props.headline"
                t-out="this.props.headline"
                class="border rounded text-muted my-2 p-2 text-break"/>
        </div>
    </t>

    <t t-name="knowledge.Knowledge404CommandTemplate">
        <div class="o_command_hotkey px-4">
            <span>
                No Article found.
                <span class="text-primary">
                    Create "<u t-out="this.props.articleName" />"
                </span>
            </span>
        </div>
    </t>

    <t t-name="knowledge.KnowledgeExtraCommandTemplate">
        <div class="o_command_hotkey px-4">
            <span>
                <i class="oi pe-2" data-icon="open_with"/>
                <t t-if="this.props.name" t-out="this.props.name"/>
                <t t-else="">Untitled</t>
            </span>
            <span class="d-none d-sm-inline">
                <t t-foreach="this.getKeysToPress(this.props)" t-as="key" t-key="key_index">
                    <kbd t-out="key" />
                    <span t-if="!key_last"> + </span>
                </t>
            </span>
        </div>
    </t>

    <t t-inherit="web.CommandPalette" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_command_palette_search')]/input" position="after">
            <a t-if="this.state.namespace === '$'" role="button" class="btn btn-dark disabled py-0 rounded-pill">
                Hidden
            </a>
        </xpath>
    </t>
</templates>
