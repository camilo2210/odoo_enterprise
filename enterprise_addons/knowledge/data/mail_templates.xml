<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <template id="knowledge_article_mail_invite">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding: 0; border-collapse:separate;">
    <tr><td valign="top">
        <div style="margin: 0px; padding: 0px; font-size: 13px;">
            <p style="margin: 0px; padding: 0px; font-size: 13px;">
                <t t-if="record.name">
                    <t t-out="user.name or ''"/> invited you to <t t-if="permission == 'write'">EDIT</t><t t-if="permission == 'read'">READ</t> the article <t t-out="record.name"/>.<br/>
                </t>
                <t t-else="">
                    <t t-out="user.name or ''"/> invited you to access an article.<br/>
                </t>
                <div t-if="message" t-out="message" class="text-muted"/>
            </p>
        </div>
    </td></tr>
</table>
    </template>

        <template id="knowledge_article_trash_notification">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding: 0; border-collapse:separate;">
    <tr><td valign="top">
        <div style="margin: 0px; padding: 0px; font-size: 13px;">
            <p>Dear <t t-out="recipient.name"/>,</p>
            <p t-if="len(articles) > 0">
                <t t-foreach="articles" t-as="article">
                    <a style="text-decoration: none; color: #111827; border-radius: 3px; border: 1px solid #e7e9ed; padding: 3px 8px;"
                        t-att-href="article.article_url"
                        t-out="article.display_name"/>
                    <t t-if="not article_last and len(articles) > 1">,</t>
                </t>
                <t t-if="len(child_articles) == 0">
                    has been moved to Trash.
                </t>
                <t t-if="len(child_articles) > 0">
                    and the following child <t t-if="len(child_articles) > 1">articles</t><t t-else="">article</t> have been moved to Trash:
                </t>
            </p>
            <p t-else="">
                <t t-if="len(child_articles) > 1">The following articles have been moved to Trash:</t>
                <t t-else="">The following article has been moved to Trash:</t>
            </p>
            <ul t-if="child_articles">
                <li t-foreach="child_articles" t-as="article" style="margin: 10px 0;">
                    <a style="text-decoration: none; color: #111827; border-radius: 3px; border: 1px solid #e7e9ed; padding: 3px 8px;"
                        t-att-href="article.article_url"
                        t-out="article.display_name"/>
                </li>
            </ul>
            <t t-if="(len(articles) + len(child_articles)) == 1">
                <p>Unless restored, <strong>this article will be permanently deleted in <t t-out="days_until_deletion"/> <t t-if="days_until_deletion > 1">days</t><t t-else="">day</t></strong>.</p>
                <p>If this was a mistake, you can recover it from the <a href="/web#action=knowledge.knowledge_article_action_trashed">Trash</a> at any time before then.</p>
            </t>
            <t t-else="">
                <p>Unless restored, <strong>these articles will be permanently deleted in <t t-out="days_until_deletion"/> <t t-if="days_until_deletion > 1">days</t><t t-else="">day</t></strong>.</p>
                <p>If this was a mistake, you can recover them from the <a href="/web#action=knowledge.knowledge_article_action_trashed">Trash</a> at any time before then.</p>
            </t>
        </div>
    </td></tr>
</table>
    </template>

</data>
</odoo>
