<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning.model_planning_slot" model="ir.model">
        <field name="website_form_access">True</field>
        <field name="website_form_label">Create a Shift</field>
        <field name="website_form_key">create_shift</field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>planning.slot</value>
        <value eval="['name', 'role_id', 'priority']"/>
    </function>
</odoo>
