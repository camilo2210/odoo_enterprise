<?xml version="1.0"?>
<odoo>
    <record id="view_hr_job_employee_referral_kanban" model="ir.ui.view">
        <field name="name">hr.job.employee.referral.kanban</field>
        <field name="model">hr.job</field>
        <field name="arch" type="xml">
            <kanban create="false" can_open="0" class="o_kanban_referral_job" js_class="referral_kanban">
                <field name="website_url"/>
                <templates>
                    <t t-name="card" class="px-3">
                        <div class="flex d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-4"/>
                            <div class="d-flex align-items-center flex-grow-0 mt-1">
                                <img src="/hr_referral/static/src/img/points.svg" class="me-2" height="20px" alt="Points icon"/>
                                <span class="text-nowrap"><field name="max_points"/> Points</span>
                            </div>
                        </div>
                        <main>
                            <div>
                                <div class="mt-2 h6 flex-grow-1">
                                    <field name="no_of_recruitment" invisible="not no_of_recruitment"/>
                                    <t t-if="record.no_of_recruitment.raw_value > 1">
                                        Open Positions
                                    </t>
                                    <t t-elif="record.no_of_recruitment.raw_value == 1">
                                        Open Position
                                    </t>
                                </div>
                            </div>
                            <field name="description" class="text-muted pb-2 mt-2"/>
                            <div class="d-flex flex-column mt-auto">
                                <div class="d-flex gap-1">
                                    <!-- Job Page button -->
                                    <a name="action_share_external"
                                        type="object"
                                        role="button"
                                        class="btn btn-secondary flex-fill d-flex align-items-center justify-content-center gap-2">
                                        <i class="oi oi-lg"
                                            data-icon="public"
                                            role="img"
                                            aria-label="Job Page"/>
                                        <span title='More info'>Job Page</span>
                                    </a>
                                    <!-- Send Actions Dropdown -->
                                    <div class="btn-group flex-fill" role="group">
                                        <button type="button"
                                            class="btn btn-secondary dropdown-toggle d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="oi oi-lg oi-filled" data-icon="send" role="img"
                                                aria-label="Send"/>
                                            <span>Send</span>
                                        </button>
                                        <ul class="dropdown-menu" role="menu">
                                            <li>
                                                <a class="dropdown-item o_hr_referral_send_mail"
                                                    name="%(hr_referral_send_mail_action)d"
                                                    type="action" role="button">
                                                    <i class="oi oi-lg oi-fw oi-filled me-2 text-center" data-icon="mail" role="img"
                                                        aria-label="Send by Email"/>
                                                    Send by Email </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                    name="%(hr_referral_send_sms_action)d"
                                                    type="action" role="button">
                                                    <i class="oi oi-lg oi-fw me-2 text-center" data-icon="smartphone" role="img"
                                                        aria-label="Send by SMS"/>
                                                    Send by SMS </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <!-- Share Actions Dropdown -->
                                    <div class="btn-group flex-fill" role="group">
                                        <button type="button"
                                            class="btn btn-secondary dropdown-toggle d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                            <i class="oi oi-lg" data-icon="family_history" role="img"
                                                aria-label="Share"/>
                                            <span>Share</span>
                                        </button>
                                        <ul class="dropdown-menu" role="menu">
                                            <li>
                                                <a
                                                    class="dropdown-item d-flex align-items-center justify-content-between"
                                                    name="action_share_external" type="object"
                                                    context="{'default_channel': 'facebook'}"
                                                    role="button">
                                                    <span class="d-flex align-items-center">
                                                        <i class="oi oi-lg oi-fw me-2 text-center"
                                                            data-icon="oi_facebook"
                                                            role="img"
                                                            aria-label="Share on Facebook"/>
                                                        Share on Facebook </span>
                                                    <span class="text-primary ms-2">
                                                        <t t-if="record.facebook_clicks &gt; 0">
                                                            <field name="facebook_clicks"/> click(s)
                                                        </t>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a
                                                    class="dropdown-item d-flex align-items-center justify-content-between"
                                                    name="action_share_external" type="object"
                                                    context="{'default_channel': 'linkedin'}"
                                                    role="button">
                                                    <span class="d-flex align-items-center">
                                                        <i class="oi oi-lg oi-fw me-2 text-center"
                                                            data-icon="oi_linkedin"
                                                            role="img"
                                                            aria-label="Share on LinkedIn"/>
                                                        Share on LinkedIn </span>
                                                    <span class="text-primary ms-2">
                                                        <t t-if="record.linkedin_clicks &gt; 0">
                                                            <field name="linkedin_clicks" /> click(s)
                                                        </t>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a
                                                    class="dropdown-item d-flex align-items-center justify-content-between"
                                                    name="action_share_external" type="object"
                                                    context="{'default_channel': 'twitter'}"
                                                    role="button">
                                                    <span class="d-flex align-items-center">
                                                        <i class="oi oi-lg oi-fw me-2 text-center" data-icon="oi_x"
                                                            role="img" aria-label="Share on X"/>
                                                        Share on X</span>
                                                    <span class="text-primary ms-2">
                                                        <t t-if="record.twitter_clicks &gt; 0">
                                                            <field name="twitter_clicks" /> click(s)
                                                        </t>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <field name="id"
                                                    widget="CopyClipboardReferralButton"
                                                    class="dropdown-item"/>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_job_kanban_inherit_referral" model="ir.ui.view">
        <field name="name">hr.job.kanban.referral</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='menu_new_applications']" position="after">
                <div role="menuitem" groups="hr_recruitment.group_hr_recruitment_manager">
                    <a name="action_referral_campaign" type="object" title="Referral Campaign">Referral Campaign</a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_job_filter_referral" model="ir.ui.view">
        <field name="name">hr.referral.job.search</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="website_hr_recruitment.hr_job_search_view_inherit"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='published']" position="replace"/>
            <xpath expr="//separator[@name='published_separator']" position="replace"/>
            <xpath expr="//filter[@name='groupby_published']" position="replace"/>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_hr_job_employee_referral">
        <field name="name">Job Positions</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="hr_referral.view_hr_job_employee_referral_kanban"/>
        <field name="search_view_id" ref="hr_referral.view_job_filter_referral"/>
        <field name="domain">[('is_published', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_referral_job_kanban">
                No job positions are available to share.
            </p>
        </field>
    </record>

    <record id="hr_job_form_inherit_hr_referral" model="ir.ui.view">
        <field name="name">hr.job.view.form.inherit</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="priority">201</field>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_referral_campaign"
                    string="Promote"
                    type="object"
                    class="btn btn-secondary"
                    groups="hr_recruitment.group_hr_recruitment_user"
                    invisible="not website_published"
                />
            </header>
        </field>
    </record>

    <menuitem
        parent="menu_hr_referral_recruitment_configuration"
        id="menu_hr_referral_job_configuration"
        action="hr.action_hr_job"
        groups="hr_referral.group_hr_referral_manager"
        sequence="2"/>
</odoo>
