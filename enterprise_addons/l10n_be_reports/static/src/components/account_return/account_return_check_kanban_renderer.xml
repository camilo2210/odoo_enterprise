<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="l10n_be_reports.account_return_check_kanban_renderer_isoc" t-inherit="account_reports.account_return_check_kanban_renderer" t-inherit-mode="primary">
        <div id="account_return_check_cards" position="before">
            <t t-if="this.shouldShowIsocView() &amp;&amp; this.isocPaymentFormState.record">
                <div class="o_form_view o_return_inline_form">
                    <FormRenderer
                        archInfo="this.isocPaymentFormState.archInfo"
                        Compiler="this.isocPaymentFormState.Compiler"
                        record="this.isocPaymentFormState.record"
                        readonly="this.isSubviewReadonly()"
                    />
                </div>
            </t>
        </div>
    </t>
</templates>
