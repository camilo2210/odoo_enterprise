<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bank_journals_list" model="ir.ui.view">
        <field name="name">bank.journal.list</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <list string="Bank Journals">
                <field name="name"/>
                <field name="code"/>
                <field name="journal_group_id" readonly="1" optional="hide"/>
                <field name="currency_id" groups="base.group_multi_currency" optional="hide"/>
                <field name="default_account_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_reconciliation_report" string="Open Reconciliation Report" type="object"/>
            </list>
        </field>
    </record>

    <record id="action_account_journal_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Bank Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="l10n_be_reports.view_bank_journals_list"/>
        <field name="domain">[('type', '=', 'bank')]</field>
        <field name="context">{'default_type': 'bank'}</field>
    </record>

</odoo>
