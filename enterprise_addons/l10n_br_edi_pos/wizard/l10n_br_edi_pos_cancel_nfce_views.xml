<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_br_edi_pos_cancel_nfce_form" model="ir.ui.view">
        <field name="name">l10n_br_edi_pos.cancel.nfce.form</field>
        <field name="model">l10n_br_edi_pos.cancel.nfce</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="reason"/>
                    </group>
                </group>

                <footer>
                    <button string="Cancel NFC-e"
                            data-hotkey="c"
                            name="action_cancel"
                            type="object"
                            class="btn btn-primary">
                    </button>
                    <button string="Discard"
                            data-hotkey="x"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
