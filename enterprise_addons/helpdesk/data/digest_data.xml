<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="digest.digest_digest_default" model="digest.digest" forcecreate="False">
            <field name="kpi_helpdesk_tickets_closed">True</field>
        </record>
    </data>

    <data>
        <record id="digest_tip_helpdesk_0" model="digest.tip">
            <field name="name">Tip: Create tickets from incoming emails</field>
            <field name="sequence">1800</field>
            <field name="group_id" ref="helpdesk.group_helpdesk_manager" />
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Create tickets from incoming emails</b></p>
                <p class="tip_content">Emails sent to your Helpdesk Team's email address automatically create tickets in your pipeline.</p>
                <img src="https://download.odoocdn.com/digests/helpdesk/static/src/img/create_tickets_emails.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>

        <record id="digest_tip_helpdesk_1" model="digest.tip">
            <field name="name">Tip: Identify bottlenecks at a glance</field>
            <field name="sequence">2200</field>
            <field name="group_id" ref="helpdesk.group_helpdesk_user"/>
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Identify bottlenecks at a glance</b></p>
                <p class="tip_content">Check the stage tracker on tickets to quickly spot bottlenecks in your helpdesk workflow.</p>
                <img src="https://download.odoocdn.com/digests/helpdesk/static/src/img/ticket_stage_bottlenecks.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>

        <record id="digest_tip_helpdesk_2" model="digest.tip">
            <field name="name">Tip: Team-Specific Fields</field>
            <field name="sequence">2600</field>
            <field name="group_id" ref="helpdesk.group_helpdesk_manager"/>
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Team-Specific Fields</b></p>
                <p class="tip_content">Add team-specific property fields to tickets to better customize your helpdesk management process.</p>
                <img src="https://download.odoocdn.com/digests/helpdesk/static/src/img/helpdesk_fields.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>

        <record id="digest_tip_helpdesk_3" model="digest.tip">
            <field name="name">Tip: Filter your tickets with one click</field>
            <field name="sequence">3000</field>
            <field name="group_id" ref="helpdesk.group_helpdesk_user"/>
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Filter your tickets with one click</b></p>
                <p class="tip_content">Click the Kanban progress bar to quickly filter tickets by status within the current stage.</p>
                <img src="https://download.odoocdn.com/digests/helpdesk/static/src/img/ticket_filter.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>

        <record id="digest_tip_helpdesk_4" model="digest.tip">
            <field name="name">Tip: Don't let stalled tickets slip under the radar</field>
            <field name="sequence">3400</field>
            <field name="group_id" ref="helpdesk.group_helpdesk_user"/>
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title"><b>Tip: Don't let stalled tickets slip under the radar</b></p>
                <p class="tip_content">Quickly identify tickets that have been stuck in the same stage for too long instead of progressing.</p>
                <img src="https://download.odoocdn.com/digests/helpdesk/static/src/img/stalled-tickets.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>
    </data>
</odoo>
