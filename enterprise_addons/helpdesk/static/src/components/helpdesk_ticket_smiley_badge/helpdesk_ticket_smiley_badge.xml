<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="helpdesk.SmileyBadge" owl="1">
        <i t-if="this.props.record.data[this.props.name] == 'top'" class="oi oi-fw oi-lg" data-icon="sentiment_satisfied" t-att-class="this.badgeClass"/>
        <i t-elif="this.props.record.data[this.props.name] == 'ok'" class="oi oi-fw oi-lg" data-icon="sentiment_neutral" t-att-class="this.badgeClass"/>
        <i t-else="" class="oi oi-fw oi-lg" data-icon="sentiment_sad" t-att-class="this.badgeClass"/>
    </t>

</templates>
