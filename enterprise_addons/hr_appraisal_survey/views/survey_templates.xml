<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="survey_fill_form_start" inherit_id="survey.survey_fill_form_start">
            <xpath expr="//h1[hasclass('o_survey_main_title')]" position="replace">
                <h1 class="o_survey_main_title h2 mb-2">
                    <t t-out="survey.title"/>
                    <t t-if="survey.survey_type == 'appraisal' and answer.appraisal_id.display_name">
                        for <t t-out="answer.appraisal_id.display_name"/>
                    </t>
                </h1>
            </xpath>
        </template>
    </data>
</odoo>
