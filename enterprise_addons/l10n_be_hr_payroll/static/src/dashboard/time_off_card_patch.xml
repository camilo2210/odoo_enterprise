<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="hr_holidays.TimeOffCardPopover" t-inherit-mode="extension">
        <xpath expr="//li[contains(., 'Available:')]" position="after">
            <li t-if="this.bePayrollProps.l10n_be_hoursRemaining !== undefined" class="text-muted text-end">
                <t t-out="this.bePayrollProps.l10n_be_hoursRemaining"/> hours
            </li>
        </xpath>
        <xpath expr="//div[hasclass('o_time_off_card_popover_warning')]" position="inside">
            <span class="d-inline-block m-0 mb-3" t-if="this.bePayrollProps.l10n_be_negativeBalanceWarning">
                <i class="oi" data-icon="warning"/> <t t-out="this.bePayrollProps.l10n_be_negativeBalanceWarning"/>
            </span>
        </xpath>
    </t>
</templates>
