<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_be_hr_payroll.GenerateDropdown">
        <Dropdown disabled="this.isDisabled" t-if="this.isVisible" menuClass="'dropdown-menu-end'" bottomSheet="false">
            <button type="button" class="o-dropdown-caret d-inline-flex align-items-center"
                t-att-disabled="this.isDisabled"
                t-att-class="{
                    'btn': true,
                    'btn-secondary': this.isSecondary,
                    'btn-primary': !this.isSecondary,
                }">
                Generate
            </button>
            <t t-set-slot="content">
                <DropdownItem
                    tag="'button'"
                    attrs="{ type: 'button', disabled: this.isDisabled }"
                    onSelected="() => this.onAction('action_generate_pdf')">
                    PDF
                </DropdownItem>
                <DropdownItem
                    tag="'button'"
                    attrs="{ type: 'button', disabled: this.isDisabled }"
                    onSelected="() => this.onAction('action_generate_xml')">
                    XML
                </DropdownItem>
                <DropdownItem
                    tag="'button'"
                    attrs="{ type: 'button', disabled: this.isDisabled }"
                    onSelected="() => this.onAction('action_generate_xls')">
                    XLSX
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
