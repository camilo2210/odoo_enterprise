<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <div t-name="l10n_be_hr_payroll.PayslipsInternalLinkComponent">
        <t t-if="this.props?.payslipsYear === 'n'" >
            <button class="btn btn-link p-0 pb-1" t-on-click="this.openNPayslips">
                <t t-out="this.props.record.data.l10n_be_payslip_n_description"/>
            </button>
        </t>
        <t t-else="">
            <button class="btn btn-link p-0 pb-1" t-on-click="this.openN1Payslips">
                <t t-out="this.props.record.data.l10n_be_payslip_n1_description"/>
            </button>
        </t>
    </div>
</templates>
