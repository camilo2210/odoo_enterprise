<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_be_hr_payroll.report27xWarningDialog">
        <Dialog size="'md'" title.translate="Withholding taxes">
            <div>
                To submit your Withholding taxes, download the XML and upload it to the
                <a href="https://finances.belgium.be/fr/E-services/FinProf" target="_blank">finprof</a> portal. 
                <br/><br/>
                Once done, proceed to the payment and mark as done.
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.actionDownloadXml">Download XML</button>
                <button class="btn btn-secondary" t-on-click="this.actionMarkDone">Mark done</button>
                <button class="btn btn-secondary" t-on-click="this.actionViewReport">View Report</button>
            </t>
        </Dialog>
    </t>
</templates>
