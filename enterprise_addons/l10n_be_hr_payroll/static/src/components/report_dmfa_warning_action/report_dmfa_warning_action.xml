<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_be_hr_payroll.reportDmfaWarningDialog">
        <Dialog size="'md'" title.translate="DMFA">
            <div class="alert alert-warning p-2" role="alert">
                <span>Tip: </span>
                <button class="btn btn-link p-0" t-on-click="this.actionOpenPayrollSettings">Set your certificate</button>
                <span> to automate DMFA and DIMONA submission</span>
            </div>
            <div>
                To submit your DMFA manually: <br/>
                <ol>
                    <li>Open the <a href="https://www.socialsecurity.be/site_fr/employer/applics/dmfa/index.htm" target="_blank">SocialSecuirity</a> portal</li>
                    <li>View the DMFA Report and fill in the data in SocialSecurity</li>
                    <li>When done, click the "Mark Done" button</li>
                </ol>
            </div>
            <t t-set-slot="footer">
                <button t-if="this.hasCertificate" class="btn btn-primary" t-on-click="this.actionSubmit">Submit</button>
                <button t-att-class="'btn ' + (this.hasCertificate ? 'btn-secondary' : 'btn-primary')" t-on-click="this.actionViewReport">View Report</button>
                <button class="btn btn-secondary" t-on-click="this.actionMarkDone">Mark done</button>
            </t>
        </Dialog>
    </t>
</templates>
