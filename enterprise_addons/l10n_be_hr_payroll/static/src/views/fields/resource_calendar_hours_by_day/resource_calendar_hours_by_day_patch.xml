<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="resource.CalendarHoursByDay" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_resource_calendar_hours_cell')]" position="attributes">
            <attribute name="class" add="d-flex flex-column" separator=" "/>
        </xpath>
        <xpath expr="//span[hasclass('o_resource_calendar_hours_cell')]/t" position="replace">
            <span t-if="day.hours" t-out="day.hours"/>
            <span t-if="day.wrmHours" t-att-class="day.wrmColorClass" t-out="day.wrmHours"/>
            <t t-if="day.noHours">-</t>
        </xpath>
    </t>
</templates>
