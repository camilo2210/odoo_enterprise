<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="hr_holidays.LeaveStatsComponent" t-inherit-mode="extension">
        <xpath expr="//p[@t-if='record_leave.raw_remaining_leaves &gt; 0']" position="replace" mode="inner">
            (<t t-out="record_leave.remaining_leaves" class="mx-1"/>
            <t t-if="record_leave.unit_of_measure == 'day'"> days</t> <t t-if="record_leave.l10n_be_hoursRemaining !== undefined"> or <t t-out="record_leave.l10n_be_hoursRemaining"/>h</t> remaining)
        </xpath>
    </t>
</templates>
