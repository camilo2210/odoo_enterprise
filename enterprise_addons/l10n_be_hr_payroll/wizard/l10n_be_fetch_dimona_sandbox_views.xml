<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_fetch_dimona_sandbox_view_form" model="ir.ui.view">
        <field name="name">l10n.be.fetch.dimona.sandbox.form</field>
        <field name="model">l10n.be.fetch.dimona.sandbox</field>
        <field name="arch" type="xml">
            <form string="Create Dimona Declaration from JSON">
                <group>
                    <field name="company_id"/>
                </group>
                <separator string="Bulk Declarations (JSON)"/>
                <field name="bulk_declarations_json" widget="ace" options="{'lineNumbers': true, 'lang': 'json'}" nolabel="1"/>
                <footer>
                    <button name="action_create_declaration" string="Create Declaration" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="l10n_be_fetch_dimona_sandbox_action" model="ir.actions.act_window" >
        <field name="name">Fetch Declarations (Sandbox)</field>
        <field name="res_model">l10n.be.fetch.dimona.sandbox</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
