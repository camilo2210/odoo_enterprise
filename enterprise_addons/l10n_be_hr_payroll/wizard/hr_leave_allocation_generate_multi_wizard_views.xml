<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_allocation_generate_multi_wizard_view_form_inherit_l10n_be_hr_payroll" model="ir.ui.view">
        <field name="name">hr.leave.allocation.generate.multi.wizard.view.form.inherit</field>
        <field name="model">hr.leave.allocation.generate.multi.wizard</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_generate_multi_wizard_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="employee_ids" position="before">
                <div class="alert alert-info" role="alert" colspan="2">
                    The number of days allocated will be automatically computed based on each employee's working schedule
                </div>
            </field>
            <xpath expr="//div[@name='duration_display']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="accrual_plan_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
