<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_worker_code_view_form" model="ir.ui.view">
        <field name="name">l10n.be.worker.code.form</field>
        <field name="model">l10n.be.worker.code</field>
        <field name="arch" type="xml">
            <form string="Worker Code">
                <sheet>
                    <group>
                        <group>
                            <field name="name" widget="text"/>
                            <field name="egov3_code"/>
                            <field name="dmfa_code"/>
                            <field name="joint_committee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_be_worker_code_view_tree" model="ir.ui.view">
        <field name="name">l10n.be.worker.code.tree</field>
        <field name="model">l10n.be.worker.code</field>
        <field name="arch" type="xml">
            <list string="Worker Codes">
                <field name="dmfa_code"/>
                <field name="name"/>
                <field name="joint_committee_ids" widget="many2many_tags"/>
                <field name="egov3_code" groups="base.group_no_one"/>
            </list>
        </field>
    </record>

    <record id="l10n_be_worker_code_view_search" model="ir.ui.view">
        <field name="name">l10n.be.worker.code.search</field>
        <field name="model">l10n.be.worker.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('egov3_code', 'ilike', self)]"/>
                <field name="dmfa_code"/>
            </search>
        </field>
    </record>

    <record id="l10n_be_worker_code_action" model="ir.actions.act_window">
        <field name="name">Worker Codes</field>
        <field name="res_model">l10n.be.worker.code</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_l10n_be_worker_code"
        name="Worker Codes"
        action="l10n_be_worker_code_action"
        parent="menu_l10n_be_hr_payroll_configuration"
        sequence="505"/>
</odoo>
