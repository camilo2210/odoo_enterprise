<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="priority" eval="25"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="js_class">l10n_be_fleet_form</attribute>
            </form>
            <group name="fiscality_group" position="attributes">
                <attribute name="invisible" add="country_code != 'BE'" separator="and"/>
            </group>
            <group name="fiscality_first_group" position="inside">
                <label for="atn" invisible="country_code != 'BE' or vehicle_type != 'car'"/>
                <div class="o_row o_hr_narrow_field" invisible="country_code != 'BE' or vehicle_type != 'car'">
                    <field name="atn" widget="monetary"/>
                    <span> / year</span>
                </div>
                <label for="co2_fee" invisible="country_code != 'BE' or vehicle_type != 'car'"/>
                <div class="o_row o_hr_narrow_field" invisible="country_code != 'BE' or vehicle_type != 'car'">
                    <field name="co2_fee" widget="monetary"/>
                    <span> / month</span>
                </div>
                <label for="tax_deduction" invisible="country_code != 'BE'"/>
                <div col="1" class="o_hr_narrow_field o_row" name="tax_deduction_div">
                    <field name="tax_deduction" widget="percentage" invisible="country_code != 'BE'"/>
                </div>
            </group>
            <xpath expr="//field[@name='residual_value']" position="after">
                <label for="total_depreciated_cost" invisible="country_code != 'BE'"/>
                <div class="o_row o_hr_narrow_field" invisible="country_code != 'BE'">
                    <field name="total_depreciated_cost" nolabel="1" widget="monetary"/>
                    <span>/ month</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="mobility_card" readonly="1" invisible="country_code != 'BE'"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_log_contract_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.contract.form</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">
            <field name="date" position="before">
                <field name="recurring_cost_amount_depreciated" widget="monetary" class="w-25"/>
            </field>
        </field>
    </record>

    <record id="fleet_vehicle_model_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form.be.payroll</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="inherit_id" ref="hr_payroll_fleet.fleet_vehicle_model_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//group[@name='salary_group']" position="inside">
            <field name="current_country_code" invisible="1"/>
            <label for="co2_fee" invisible="current_country_code != 'BE' or vehicle_type != 'car'"/>
            <div class="o_row o_hr_narrow_field" invisible="current_country_code != 'BE' or vehicle_type != 'car'">
                <field name="co2_fee" nolabel="1"/>
                <span>/ month</span>
            </div>
            <label for="default_recurring_cost_amount_depreciated" invisible="current_country_code != 'BE'"/>
            <div class="o_row o_hr_narrow_field" invisible="current_country_code != 'BE'">
                <field name="default_recurring_cost_amount_depreciated" nolabel="1"/>
                <span>/ month</span>
            </div>
            <label for="default_total_depreciated_cost" invisible="current_country_code != 'BE'"/>
            <div class="o_row o_hr_narrow_field" invisible="current_country_code != 'BE'">
                <field name="default_total_depreciated_cost" nolabel="1"/>
                <span>/ month</span>
            </div>
            <label for="default_atn" invisible="vehicle_type != 'car' or current_country_code != 'BE'"/>
            <div class="o_row o_hr_narrow_field" invisible="vehicle_type != 'car' or current_country_code != 'BE'">
                <field name="default_atn" nolabel="1"/>
                <span>/ year</span>
            </div>
            </xpath>
            <xpath expr="//div[@name='horsepower_row']" position="after">
                <field name="tax_deduction" widget="percentage" invisible="current_country_code != 'BE'"/>
            </xpath>
            <xpath expr="//field[@name='co2_standard']" position="before">
                <field name="is_false_hybrid" invisible="current_country_code != 'BE' or default_fuel_type not in ['plug_in_hybrid_diesel', 'plug_in_hybrid_gasoline', 'full_hybrid']"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="mobility_card"/>
            </xpath>
        </field>
    </record>

</odoo>
