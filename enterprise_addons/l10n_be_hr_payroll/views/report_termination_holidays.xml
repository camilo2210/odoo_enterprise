            <table class="fs-4 table table-sm table-bordered border-dark">
                <thead>
                    <tr>
                        <td class="py-0 text-center">
                            Start date Occupancy line
                        </td>
                        <td class="py-0 text-center">
                            End date Occupancy line
                        </td>
                        <td class="py-0 text-center">
                            Q/S
                        </td>
                        <td class="py-0 text-center">
                            Number of days/week of work schedule
                        </td>
                        <td t-if="not is_worker" class="py-0 text-center">
                            Legal holidays
                        </td>
                        <td t-if="not is_worker" class="py-0 text-center">
                            Additional (European) holidays
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.employee_id.get_l10n_be_holiday_attest_occupations(o.date_to.year)" t-as="occupation">
                        <tr>
                            <td class="py-0 text-center text-nowrap" t-out="occupation['date_start']" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/>
                            <td class="py-0 text-center text-nowrap" t-out="occupation['date_end']" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/>
                            <td class="py-0 text-center">
                                <t t-out="occupation['hours_per_week']"/>/<t t-out="occupation['reference_hours_per_week']"/>
                            </td>
                            <td class="py-0 text-center">
                                <t t-out="occupation['days_per_week']"/>/<t t-out="round((occupation['reference_hours_per_week'] * occupation['days_per_week']) / occupation['hours_per_week'], 2) if occupation['hours_per_week'] else occupation['days_per_week']"/>
                            </td>
                            <td t-if="not is_worker" class="py-0 text-center" t-out="occupation['paid_leaves']"/>
                            <td t-if="not is_worker" class="py-0 text-center" t-out="occupation['european_leaves']"/>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-if="not is_worker">
            <!-- Amounts' Table -->
            <strong class="fw-bold fs-4">Amounts</strong>
            <table class="fs-4 table table-sm table-bordered border-dark">
                <thead>
                    <tr>
                        <td class="py-0 text-center" style="width: 30%;">
                            Type of holiday pay
                        </td>
                        <td class="py-0 text-center">
                            Total number of vacation days still to be taken
                        </td>
                        <td class="py-0 text-center">
                            Total entitlement to vacation days
                        </td>
                        <td class="py-0 text-center">
                            Base of the holiday pay for leaving
                        </td>
                        <td class="py-0 text-center">
                            Percentage of holiday pay upon leaving
                        </td>
                        <td class="py-0 text-center">
                            Amount of holiday pay upon leaving
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="py-0" style="width: 30%;">
                            Simple holiday allowance
                        </td>
                        <td class="py-0 text-center" t-out="o._get_input_line_amount('ALLOCATION') - o._get_input_line_amount('TIME_OFF_TAKEN')"/>
                        <td class="py-0 text-center" t-out="o._get_input_line_amount('ALLOCATION') or 0"/>
                        <td class="py-0 text-center" t-out="o._get_input_line_amount('GROSS_REF')"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        <td class="py-0 text-center">7,67 %</td>
                        <td class="py-0 text-center" t-out="o.line_ids.filtered(lambda line: line.code == 'PAY_SIMPLE').total"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </tr>
                    <tr>
                        <td class="py-0" style="width: 30%;">
                            Simple holiday pay without ONSS
                        </td>
                        <td class="py-0 text-center"/>
                        <td class="py-0 text-center"/>
                        <td class="py-0 text-center"/>
                        <td class="py-0 text-center">7,67 %</td>
                        <td class="py-0 text-center"/>
                    </tr>
                    <tr>
                        <td class="py-0" style="width: 30%;">
                            Double holiday pay
                        </td>
                        <td class="bg-dark"/>
                        <td class="bg-dark"/>
                        <td class="py-0 text-center" t-out="o._get_input_line_amount('GROSS_REF')"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        <td class="py-0 text-center">6,80 %</td>
                        <td class="py-0 text-center" t-out="o.line_ids.filtered(lambda line: line.code == 'PAY DOUBLE').total"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </tr>
                    <tr>
                        <td class="py-0" style="width: 30%;">
                            Supplementary double holiday pay
                        </td>
                        <td class="bg-dark"/>
                        <td class="bg-dark"/>
                        <td class="py-0 text-center" t-out="o._get_input_line_amount('GROSS_REF')"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        <td class="py-0 text-center">0,87 %</td>
                        <td class="py-0 text-center" t-out="o.line_ids.filtered(lambda line: line.code == 'PAY DOUBLE COMPLEMENTARY').total"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </tr>
                </tbody>
            </table>
            </t>

            <!-- Signature -->
            <div class="d-flex align-items-center fs-3">
                <div class="d-flex me-3" style="min-width: 50%;">
                    <div class="text-nowrap fw-bold me-1">Prepared and delivered to:</div>
                    <t t-set="address_parts" t-value="[part for part in [
                        o.employee_id.address_id.street,
                        o.employee_id.address_id.street2,
                        o.employee_id.address_id.city,
                        o.employee_id.address_id.zip,
                        o.employee_id.address_id.city_id.name if o.employee_id.address_id.city_id else '',
                        o.employee_id.address_id.state_id.name if o.employee_id.address_id.state_id else '',
                        o.employee_id.address_id.country_id.name if o.employee_id.address_id.country_id else '',
                    ] if part]"/>
                    <span t-out="', '.join(address_parts)" class="text-nowrap"/>
                </div>
                <div class="d-flex">
                    <div class="fw-bold me-1">On:</div>
                    <span t-field="o.compute_date"/>
                </div>
            </div>
            <div class="fs-3">
                Employer’s signature or authorized representative:
            </div>
        </div>

    </t>
</template>

<template id="report_termination_holidays_n1_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_holidays_n1"/>
        </t>
    </t>
</template>
</odoo>
