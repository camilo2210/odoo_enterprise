                                o.employee_id.private_city,
                                o.employee_id.private_state_id.name if o.employee_id.private_state_id else '',
                                o.employee_id.private_zip,
                                o.employee_id.private_country_id.name if o.employee_id.private_country_id else '',
                            ] if part]"/>
                            <span t-out="', '.join(contact_parts)"/>
                        </span>
                    </div>
                </dl>
            </section>

            <h6 class="fs-3 mb-3">This is a vacation certificate relating to employment in the sector
                <span t-if="o.payroll_config_id.l10n_be_sector" t-field="o.payroll_config_id.l10n_be_sector"/>
                <span t-else="">private/public</span>
            </h6>

            <h2 class="fs-1 mb-0 fw-bold">Please forward this to the employer where you are taking your vacation in  <span t-out="o.date_to.year"/></h2>
            <h2 class="fs-3 mb-3">Based on this certificate, the employer will determine your entitlement to vacation time and deduct the amounts mentioned from your vacation pay.</h2>

            <!-- N-1 year postponed vacation days -->
            <strong class="fw-bold fs-4">postponed vacation days</strong>
            <table class="fs-4 table table-sm table-bordered border-dark">
                <thead>
                    <tr>
                        <td class="py-0 text-center">
                            Vacation year
                        </td>
                        <td class="py-0 text-center">
                            Q/S december
                        </td>
                        <td class="py-0 text-center">
                            Work schedule
                        </td>
                        <td t-if="not is_worker" class="py-0 text-center">
                            Balance of accrued vacation days<div>remaining days / quota to be taken</div>
                        </td>
                        <td class="py-0 text-center">
                            due date
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="version_n2" t-value="o.employee_id._get_version(o.date_to.replace(year=o.date_to.year - 2, month=12, day=31))"/>
                    <tr t-if="o._get_input_line_amount('PPTO2')">
                        <td class="py-0 text-center" t-out="o.date_to.year - 2"/>
                        <td class="py-0 text-center">
                            <t t-out="version_n2.resource_calendar_id.hours_per_week"/> / <t t-out="version_n2._get_reference_calendar().hours_per_week"/>
                        </td>
                        <td class="py-0 text-center" t-out="version_n2.resource_calendar_id.days_per_week"/>
                        <td t-if="not is_worker" class="py-0 text-center">
                            <t t-out="o._get_input_line_amount('PPTO2')"/> / <t t-out="o._get_input_line_amount('TPPTO2')"/>
                        </td>
                        <td class="py-0 text-center" t-out="o.date_to.year"/>
                    </tr>
                    <t t-set="version_n1" t-value="o.employee_id._get_version(o.date_to.replace(year=o.date_to.year - 1, month=12, day=31))"/>
                    <tr t-if="o._get_input_line_amount('PPTO1')">
                        <td class="py-0 text-center" t-out="o.date_to.year - 1"/>
                        <td class="py-0 text-center">
                            <t t-out="version_n1.resource_calendar_id.hours_per_week"/> / <t t-out="version_n1._get_reference_calendar().hours_per_week"/>
