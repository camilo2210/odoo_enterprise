<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_281_xx_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_be.281_xx.declaration.view.list</field>
        <field name="model">hr.payroll.employee.declaration</field>
        <field name="arch" type="xml">
            <list editable="bottom" js_class="employee_declaration_list" create="0" delete="0">
                <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}" readonly="pdf_file" widget="many2one_avatar_employee"/>
                <field name="pdf_file" readonly="1" filename="pdf_filename" widget="binary"/>
                <field name="state" widget="badge" column_invisible="parent.state != 'done'"
                       decoration-warning="state in ['pdf_to_generate', 'pdf_to_post']"
                       decoration-success="state == 'pdf_generated'"
                       decoration-primary="state == 'pdf_posted'"
                       decoration-danger="state == 'error'"/>
                <field name="declaration_error" optional="hide"/>
                <button name="action_print_pdf" type="object" string="Print"
                        invisible="parent.state == 'done'"/>
            </list>
        </field>
    </record>
</odoo>
