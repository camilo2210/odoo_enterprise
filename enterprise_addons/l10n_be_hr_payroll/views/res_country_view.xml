<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_country_tree_l10n_be_hr_payroll" model="ir.ui.view">
            <field name="name">res.country.view.tree.l10n.be.hr.payroll</field>
            <field name="model">res.country</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="base.view_country_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="l10n_be_nis_code"/>
                </xpath>
            </field>
        </record>

        <record id="action_res_country_tree_l10n_be" model="ir.actions.act_window">
            <field name="name">NIS Codes - Countries</field>
            <field name="res_model">res.country</field>
            <field name="view_mode">list,form</field>
            <field name="help">
                No Countries yet.
            </field>
        </record>

        <record id="action_res_country_tree_l10n_be_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_country_tree_l10n_be_hr_payroll"/>
            <field name="act_window_id" ref="action_res_country_tree_l10n_be"/>
        </record>

        <menuitem id="menu_res_country_l10n_be"
            action="action_res_country_tree_l10n_be"
            parent="menu_l10n_be_hr_payroll_configuration"
            sequence="2001"/>
    </data>
</odoo>