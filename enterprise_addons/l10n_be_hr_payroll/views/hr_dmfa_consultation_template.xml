<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
   <template id="dmfa_consultation_xml_report">
      <DmfAConsultationRequest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" t-att="{'xsi:noNamespaceSchemaLocation': 'DmfAConsultationRequest_' + schema_year_quarter + '.xsd'}">
         <Form>
            <Identification>DMFAREQ</Identification>
            <FormCreationDate t-out="datetime.date.today()"/>
            <FormCreationHour t-out="datetime.datetime.now().strftime('%H:%M:%S.000')"/>
            <AttestationStatus>0</AttestationStatus>
            <TypeForm>RE</TypeForm>
            
            <EmployerDeclarationId>
                  <Quarter t-out="quarter_repr"/>
                  <NOSSRegistrationNbr t-out="onss_registration_number"/>
                  <Trusteeship>0</Trusteeship>
                  <CompanyID t-out="l10n_be_company_number"/>
                  <AnomalySubmission>1</AnomalySubmission>
                  <t t-foreach="natural_persons" t-as="person">
                     <t t-call="l10n_be_hr_payroll.NaturalPerson"/>
                  </t>
            </EmployerDeclarationId>
         </Form>
      </DmfAConsultationRequest>
   </template>
</data>
</odoo>
