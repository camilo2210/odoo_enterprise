<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_nace_code_view_form" model="ir.ui.view">
        <field name="name">l10n.be.nace.code.form</field>
        <field name="model">l10n.be.nace.code</field>
        <field name="arch" type="xml">
            <form string="Nace Code">
                <sheet>
                    <group>
                        <group>
                            <field name="name" widget="text"/>
                            <field name="egov3_code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_be_nace_code_view_tree" model="ir.ui.view">
        <field name="name">l10n.be.nace.code.tree</field>
        <field name="model">l10n.be.nace.code</field>
        <field name="arch" type="xml">
            <list string="Nace Codes">
                <field name="egov3_code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="l10n_be_nace_code_view_search" model="ir.ui.view">
        <field name="name">l10n.be.nace.code.search</field>
        <field name="model">l10n.be.nace.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('egov3_code', 'ilike', self)]"/>
                <field name="egov3_code"/>
            </search>
        </field>
    </record>

    <record id="l10n_be_nace_code_action" model="ir.actions.act_window">
        <field name="name">Nace Codes</field>
        <field name="res_model">l10n.be.nace.code</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_l10n_be_nace_code"
        name="Nace Codes"
        action="l10n_be_nace_code_action"
        parent="menu_l10n_be_hr_payroll_configuration"
        sequence="505"/>
</odoo>
