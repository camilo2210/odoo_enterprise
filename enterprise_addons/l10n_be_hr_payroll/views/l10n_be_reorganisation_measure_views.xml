<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_reorganisation_measure_view_form" model="ir.ui.view">
        <field name="name">l10n.be.reorganisation.measure.form</field>
        <field name="model">l10n.be.reorganisation.measure</field>
        <field name="arch" type="xml">
            <form string="Reorganisation Measure">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="egov3_code"/>
                        </group>
                        <group>
                            <field name="dmfa_code"/>
                            <field name="description" widget="text"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_be_reorganisation_measure_view_tree" model="ir.ui.view">
        <field name="name">l10n.be.reorganisation.measure.tree</field>
        <field name="model">l10n.be.reorganisation.measure</field>
        <field name="arch" type="xml">
            <list string="Reorganisation Measures" editable="top">
                <field name="egov3_code" optional="hidden"/>
                <field name="dmfa_code" optional="hidden"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="l10n_be_reorganisation_measure_view_search" model="ir.ui.view">
        <field name="name">l10n.be.reorganisation.measure.search</field>
        <field name="model">l10n.be.reorganisation.measure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('description', 'ilike', self), ('egov3_code', 'ilike', self)]"/>
                <field name="dmfa_code" string="Code" filter_domain="['|', ('dmfa_code', 'ilike', self), ('egov3_code', 'ilike', self)]"/>
                <group>
                    <filter string="eGov-3.0" name="group_by_egov3_code" domain="[]" context="{'group_by': 'egov3_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_be_reorganisation_measure_action" model="ir.actions.act_window">
        <field name="name">Reorganisation Measures</field>
        <field name="res_model">l10n.be.reorganisation.measure</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_l10n_be_reorganisation_measure"
        name="Reorganisation Measures"
        action="l10n_be_reorganisation_measure_action"
        parent="menu_l10n_be_hr_payroll_configuration"
        sequence="510"/>
</odoo>
