<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_be_hr_payroll_hr_salary_attachment_view_form" model="ir.ui.view">
        <field name="name">hr.salary.attachment.form.l10n.be.hr.payroll</field>
        <field name="model">hr.salary.attachment</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_attachment_view_form"/>
        <field name="arch" type="xml">
            <separator name="seized_amount" position="after">
                <field name="l10n_be_dependent_children_attachment" string="Number of Children" invisible="not is_seized"/>
            </separator> 
        </field>
    </record>
</odoo>
