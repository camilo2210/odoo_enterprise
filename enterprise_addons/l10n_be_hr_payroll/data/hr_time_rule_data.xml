<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- night premium pay for CP302 (hotel industry): any attendance in 00:00-05:00 window -->
    <record id="l10n_be_time_rule_night_cp302" model="hr.time.rule">
        <field name="name">Night Premium Pay (CP302)</field>
        <field name="country_id" ref="base.be"/>
        <field name="employee_domain">[('l10n_be_joint_committee_id.egov3_code', '=', '302')]</field>
        <field name="working_hours_mode">day</field>
        <field name="timing_start">0</field>
        <field name="timing_stop">5</field>
        <field name="work_entry_type_id" ref="hr_work_entry.be_work_entry_type_attendance"/>
        <field name="condition_work_entry_type_ids" eval="[(4, ref('hr_work_entry.be_work_entry_type_attendance'))]"/>
        <field name="premium_pay_category_ids" eval="[(4, ref('l10n_be_hr_payroll.PREMIUM_PAY_NIGHT'))]"/>
    </record>

    <!-- sunday premium pay for all BE employees: any attendance on sunday -->
    <record id="l10n_be_time_rule_sunday" model="hr.time.rule">
        <field name="name">Sunday Premium Pay</field>
        <field name="country_id" ref="base.be"/>
        <field name="working_hours_mode">day</field>
        <field name="timing_start">0</field>
        <field name="timing_stop">24</field>
        <field name="apply_monday" eval="False"/>
        <field name="apply_tuesday" eval="False"/>
        <field name="apply_wednesday" eval="False"/>
        <field name="apply_thursday" eval="False"/>
        <field name="apply_friday" eval="False"/>
        <field name="apply_saturday" eval="False"/>
        <field name="apply_sunday" eval="True"/>
        <field name="apply_on_public_holidays" eval="False"/>
        <field name="work_entry_type_id" ref="hr_work_entry.be_work_entry_type_attendance"/>
        <field name="condition_work_entry_type_ids" eval="[(4, ref('hr_work_entry.be_work_entry_type_attendance'))]"/>
        <field name="premium_pay_category_ids" eval="[(4, ref('l10n_be_hr_payroll.PREMIUM_PAY_SUN'))]"/>
    </record>

</data>
</odoo>
