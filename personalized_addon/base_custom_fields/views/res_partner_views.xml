<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_compliance" model="ir.ui.view">
        <field name="name">res.partner.form.compliance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- ✅ XPath más robusto: inserta al final del notebook completo -->
            <xpath expr="//notebook" position="inside">
                <page string="Compliance y DD" name="compliance_due_diligence">

                    <group string="Consultas y Autorizaciones">
                        <group>
                            <field name="autoriza_consulta_centrales"/>
                            <field name="autoriza_reporte_centrales"/>
                        </group>
                        <group>
                            <field name="consulta_bienes_registro"/>
                            <field name="consulta_vehiculos_transito"/>
                        </group>
                    </group>

                    <group string="Due Diligence">
                        <group>
                            <field name="due_diligence"/>
                            <field
                                name="due_diligence_date"
                                required="due_diligence"
                                invisible="not due_diligence"
                                readonly="not due_diligence"
                            />
                        </group>
                    </group>

                    <div invisible="not due_diligence">
                        <button
                            name="action_reset_due_diligence"
                            string="Reiniciar Due Diligence"
                            type="object"
                            class="btn-secondary"
                            confirm="¿Desea reiniciar el proceso de Due Diligence para este contacto?"
                        />
                    </div>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
