<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- account.payment.register — Register Payment wizard            -->
    <!-- Add analytic_distribution widget to the wizard form           -->
    <!-- ============================================================ -->
    <record id="view_account_payment_register_form_analytic" model="ir.ui.view">
        <field name="name">account.payment.register.form.analytic.enforcement</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">

            <!-- Add analytic_distribution after the journal_id field
                 in the payment registration wizard -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>

        </field>
    </record>

</odoo>
