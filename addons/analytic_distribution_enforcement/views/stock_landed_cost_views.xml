<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- stock.landed.cost — Landed Cost form                          -->
    <!-- Add analytic_distribution to cost lines                       -->
    <!-- ============================================================ -->
    <record id="view_stock_landed_cost_form_analytic" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.analytic.enforcement</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">

            <!-- Add analytic_distribution to the cost_lines list,
                 after the price_unit field -->
            <xpath expr="//field[@name='cost_lines']//field[@name='price_unit']"
                   position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>
