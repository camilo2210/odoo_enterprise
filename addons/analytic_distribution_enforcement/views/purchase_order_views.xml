<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- purchase.order — Purchase Order form                          -->
    <!-- Make analytic_distribution visible by default on order lines   -->
    <!-- ============================================================ -->
    <record id="view_purchase_order_form_analytic_enforcement" model="ir.ui.view">
        <field name="name">purchase.order.form.analytic.enforcement</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Make analytic_distribution column visible by default
                 on the order lines list -->
            <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']"
                   position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

        </field>
    </record>

</odoo>
