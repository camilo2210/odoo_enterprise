<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- stock.picking — Picking form                                  -->
    <!-- Add analytic_distribution widget at the header level          -->
    <!-- ============================================================ -->
    <record id="view_picking_form_analytic_enforcement" model="ir.ui.view">
        <field name="name">stock.picking.form.analytic.enforcement</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Add analytic_distribution in the header group,
                 after the scheduled_date field -->
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>

            <!-- Add analytic_distribution to stock move lines inside
                 the operations tab -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']"
                   position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>
